  "abstract": "This submission introduces a novel dual-branch architecture to model inter-neuron dependencies in a computationally tractable way. One branch computes per-neuron temporal features using a 1D CNN, similar to the previous SOTA model. A second, parallel branch computes a global context vector by aggregating the activity of all neurons. This context vector is then fused with the per-neuron features before the final forecast. This approach hypothesizes that conditioning individual neuron predictions on the overall brain state will lead to a more accurate and context-aware model.",
  "submitted_tick": 21,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nfrom jax import random\n\nNUM_NEURONS = 71721\nINPUT_HORIZON = 4\nOUTPUT_HORIZON = 32\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'embedding_dim': 8,\n        'cnn_features': 32,\n        'cnn_kernel_size': 2,\n        'mlp_hidden_size': 64,\n        'dropout_rate': 0.1,\n        'context_vector_dim': 16,\n        'global_encoder_hidden_dim': 32\n    }\n\nclass DualBranchModel(nn.Module):\n    embedding_dim: int\n    cnn_features: int\n    cnn_kernel_size: int\n    mlp_hidden_size: int\n    dropout_rate: float\n    context_vector_dim: int\n    global_encoder_hidden_dim: int\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size, _, _ = x.shape\n\n        # --- Branch 1: Per-Neuron Feature Extractor ---\n        # (This is similar to the previous SOTA model)\n        neuron_indices = jnp.arange(NUM_NEURONS)\n        embeddings = nn.Embed(num_embeddings=NUM_NEURONS, features=self.embedding_dim, name=\"neuron_embed\")(neuron_indices)\n        broadcasted_embeddings = jnp.broadcast_to(embeddings, (batch_size, NUM_NEURONS, self.embedding_dim))\n        \n        x_transposed = jnp.transpose(x, (0, 2, 1))\n        x_reshaped = jnp.expand_dims(x_transposed, axis=-1)\n        \n        broadcasted_embeddings_seq = jnp.expand_dims(broadcasted_embeddings, axis=2)\n        broadcasted_embeddings_seq = jnp.broadcast_to(broadcasted_embeddings_seq, (batch_size, NUM_NEURONS, INPUT_HORIZON, self.embedding_dim))\n        \n        combined_input = jnp.concatenate([x_reshaped, broadcasted_embeddings_seq], axis=-1)\n        cnn_input = jnp.reshape(combined_input, (batch_size * NUM_NEURONS, INPUT_HORIZON, 1 + self.embedding_dim))\n        \n        local_features = nn.Conv(features=self.cnn_features, kernel_size=(self.cnn_kernel_size,))(cnn_input)\n        local_features = nn.relu(local_features)\n        local_features = local_features.reshape((local_features.shape[0], -1))\n\n        # --- Branch 2: Global Context Encoder ---\n        # Aggregate across all neurons: (batch, 4, 71721) -> (batch, 4)\n        global_activity_summary = jnp.mean(x, axis=2)\n        \n        # Encode the summary into a context vector\n        global_context = nn.Dense(self.global_encoder_hidden_dim, name=\"global_encoder_1\")(global_activity_summary)\n        global_context = nn.relu(global_context)\n        global_context = nn.Dense(self.context_vector_dim, name=\"global_encoder_2\")(global_context)\n        global_context = global_context.reshape((batch_size, -1)) # Flatten context features\n\n        # --- Fusion and Prediction Head ---\n        # Broadcast global context to match per-neuron features\n        # From (batch, context_dim) to (batch * num_neurons, context_dim)\n        expanded_context = jnp.repeat(global_context, NUM_NEURONS, axis=0)\n        \n        # Concatenate local and global features\n        fused_features = jnp.concatenate([local_features, expanded_context], axis=-1)\n\n        # Final MLP prediction head\n        y = nn.Dense(self.mlp_hidden_size)(fused_features)\n        y = nn.BatchNorm(use_running_average=not training)(y)\n        y = nn.relu(y)\n        y = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(y)\n        \n        output = nn.Dense(OUTPUT_HORIZON)(y)\n\n        # Reshape to final format\n        output = jnp.reshape(output, (batch_size, NUM_NEURONS, OUTPUT_HORIZON))\n        output = jnp.transpose(output, (0, 2, 1))\n        \n        return output\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = DualBranchModel(\n            embedding_dim=hparams.get('embedding_dim'),\n            cnn_features=hparams.get('cnn_features'),\n            cnn_kernel_size=hparams.get('cnn_kernel_size'),\n            mlp_hidden_size=hparams.get('mlp_hidden_size'),\n            dropout_rate=hparams.get('dropout_rate'),\n            context_vector_dim=hparams.get('context_vector_dim'),\n            global_encoder_hidden_dim=hparams.get('global_encoder_hidden_dim')\n        )\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        return self.model.init({'params': rng_params, 'dropout': rng_dropout}, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable:\n            return self.model.apply(params, x, training=training, mutable=mutable, rngs=rngs)\n        return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n",
