  "original_submission": {
    "content": "import sys, optax\nimport jax.numpy as jnp\nimport jax.random as random\n\nsys.path.append('storage/Lumina')\nfrom minimal_factorized_mlp import create_network, export_stats # My custom module\n\n# Constants from original submission\nBASE_SEED = 42\nBATCH_SIZE = 8\n\ndef _define_hyperparameters():\n    \"\"\"\n    Define hyperparameters for the Minimal Factorized MLP with learnable gamma,\n    matching Lumina I's ID 455.\n    \"\"\"\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,\n        'proj_rank': 32,\n        'gamma_start': 0.25, # For initialization of learnable gamma\n        'gamma_end': 0.99,   # For initialization of learnable gamma\n        'learn_gamma': True  # Learnable gamma ramp applied\n    }\n\ndef compute_loss(predictions, targets, params, x):\n    # Use default MAE loss as the Minimal Factorized MLP had no curvature loss\n    return jnp.mean(jnp.abs(predictions - targets))\n\ndef create_optimizer(learning_rate: float = 0.001):\n    # Use default Adam optimizer as the Minimal Factorized MLP had no gradient clipping\n    return optax.adam(learning_rate=learning_rate)\n\ndef complete(params, opt_state, trial_data):\n    hparams_dict = _define_hyperparameters()\n    export_stats(params, trial_data, hparams_dict) # Now exports gamma_raw\n\n# The create_network and ModelWrapper from minimal_factorized_mlp.py handle network creation\n",
