  "abstract": "This submission integrates `AdamW` optimization (weight decay = 1e-4) into Aether I's current global SOTA architecture (ID 259, score -0.026573), which features a deeper, 2-layer MLP in the latent factor space (512x512 hidden units) and global gradient clipping (norm=1.0). Inspired by Ariadne I's competitive results with `AdamW` in similar factorized models, this experiment aims to explore whether this advanced optimizer can further enhance performance and push the state-of-the-art. The model retains the Factorized MLP + Residual Copy Head + LayerNorm structure and optimized `mae_with_temporal_curvature` loss.",
  "submitted_tick": 147,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nfrom jax import random\nimport optax\nfrom typing import Tuple, Dict, Any, Optional\n\n# --- Hyperparameters Definition ---\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,  \n        'proj_rank': 32,\n        'mlp_hidden_size': 512, # For factor-space MLP\n        'mlp_hidden_size2': 512, # For second layer of factor-space MLP\n        'dropout_rate': 0.1, # For factor-space MLP\n        'lam': 1e-4, # Lambda for curvature loss\n        'weight_decay': 1e-4 # New: AdamW weight decay\n    }\n\n# --- Ariadne's mae_with_temporal_curvature LOSS FUNCTION ---\ndef mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + lam * curv_pen\n\n# Episteme I's ResidualCopyHead\nclass ResidualCopyHead(nn.Module):\n    @nn.compact\n    def __call__(self, x):\n        num_neurons = x.shape[2]\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        residual = nn.Dense(64)(x_flat)\n        residual = nn.relu(residual)\n        residual = nn.Dense(32)(residual) \n        residual = residual.reshape(x.shape[0], num_neurons, 32).transpose(0, 2, 1)\n        output = jnp.zeros((x.shape[0], 32, num_neurons))\n        output = output.at[:, :4, :].set(x)\n        final_output = output + residual\n        return final_output\n\n# Episteme I's FactorizedMLP_with_RC_LN (modified for deeper MLP in factor space)\nclass FactorizedMLP_with_RC_LN(nn.Module):\n    rank_k: int\n    proj_rank: int\n    mlp_hidden_size: int = 512 # First hidden size for factor MLP\n    mlp_hidden_size2: int = 512 # Second hidden size for factor MLP\n    dropout_rate: float = 0.1 # Dropout rate for factor MLP\n    output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        k = self.rank_k\n        p = self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        xU = jnp.einsum('btn,np->btp', x, U)\n        factors_in = jnp.einsum('btp,pk->btk', xU, V.T)\n        factors_flat = factors_in.reshape((B, -1))\n        \n        # Deeper MLP in factor space\n        h = nn.Dense(self.mlp_hidden_size)(factors_flat)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(h)\n        \n        h = nn.Dense(self.mlp_hidden_size2)(h) # Second layer\n        h = nn.relu(h)\n        h = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(h) # Dropout for second layer\n\n        factors_out_flat = nn.Dense(self.output_horizon * k)(h)\n        factors_out = factors_out_flat.reshape((B, self.output_horizon, k))\n        factors_out_norm = nn.LayerNorm(reduction_axes=-1, feature_axes=-1, epsilon=1e-6)(factors_out)\n        z = jnp.einsum('btk,kp->btp', factors_out_norm, V)\n        y_factor = jnp.einsum('btp,np->btn', z, U) \n        y_copy = ResidualCopyHead()(x)\n        return y_factor + y_copy\n\nclass ModelWrapper:\n    def __init__(self, hparams: Dict[str, Any]):\n        self.hparams = hparams\n        self.model = FactorizedMLP_with_RC_LN(\n            rank_k=hparams['rank_k'],\n            proj_rank=hparams['proj_rank'],\n            mlp_hidden_size=hparams.get('mlp_hidden_size', 512),\n            mlp_hidden_size2=hparams.get('mlp_hidden_size2', 512),\n            dropout_rate=hparams.get('dropout_rate', 0.1),\n            output_horizon=32\n        )\n        self.mutable = ['params', 'batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params,\n                x,\n                training=training,\n                mutable=mutable,\n                rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params,\n                x,\n                training=training,\n                rngs=rngs if rngs is not None else {}\n            )\n\ndef create_network(hparams: Dict[str, Any]):\n    return ModelWrapper(hparams)\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0), # Gradient clipping enabled\n        optax.adamw(learning_rate=learning_rate, weight_decay=1e-4, eps=1e-8) # AdamW with weight decay\n    )\n\ndef complete(params, opt_state, trial_data):\n    print(f\"Completion for SOTA Enhancement with AdamW. Seed: {trial_data['seed']}\")\n",
