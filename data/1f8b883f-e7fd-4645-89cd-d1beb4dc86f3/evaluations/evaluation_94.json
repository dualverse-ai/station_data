  "abstract": "This submission enhances the Contextual ConvNeuronEmbeddingMLP by integrating a 1D convolutional layer within the `ContextExtractor`. This temporal convolution processes global mean-pooled input features across the time dimension, allowing the `condition_context_vector` to capture richer temporal dynamics when inferring experimental conditions for more effective FiLM modulation.",
  "submitted_tick": 50,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport jax.numpy as jnp\nimport optax\nimport flax.linen as nn\nfrom jax import random\nfrom typing import Any, Dict\n\n# Import default loss and optimizer from system storage to maintain consistency\nimport sys\nsys.path.append('storage/system')\nfrom defaults import default_compute_loss, default_create_optimizer\n\n# Constants from Research Task\nNUM_NEURONS = 71721\nINPUT_HORIZON = 4\nOUTPUT_HORIZON = 32\n\nclass ContextExtractor(nn.Module):\n    \"\"\"\n    Sub-network to extract a global context vector from the input,\n    now enhanced with a temporal 1D convolutional layer.\n    \"\"\"\n    context_dim: int\n    hidden_context_dim: int\n    temporal_conv_features: int # New parameter for temporal convolution\n    temporal_kernel_size: int   # New parameter for temporal convolution\n\n    @nn.compact\n    def __call__(self, x):\n        # Input x shape: (batch_size, INPUT_HORIZON, NUM_NEURONS)\n        # Global mean pooling across neurons to get (batch_size, INPUT_HORIZON)\n        global_temporal_features = jnp.mean(x, axis=-1)\n\n        # Reshape for 1D convolution over the time dimension: (batch_size, INPUT_HORIZON, 1)\n        x = global_temporal_features[:, :, None]\n        \n        # Apply 1D temporal convolution\n        x = nn.Conv(\n            features=self.temporal_conv_features,\n            kernel_size=(self.temporal_kernel_size,),\n            padding='VALID' # Use VALID padding to reduce dimensionality if needed\n        )(x)\n        # Output shape: (batch_size, INPUT_HORIZON - temporal_kernel_size + 1, temporal_conv_features)\n        \n        # Flatten the output to (batch_size, flat_features_size)\n        flat_temporal_features = x.reshape(x.shape[0], -1)\n        \n        # Use a small MLP to process global and temporal features into a context vector\n        x = nn.Dense(self.hidden_context_dim)(flat_temporal_features)\n        x = nn.relu(x)\n        context_vector = nn.Dense(self.context_dim)(x)\n        return context_vector # Shape: (batch_size, context_dim)\n\n\nclass ContextualConvNeuronEmbeddingMLP(nn.Module):\n    \"\"\"\n    Shared-neuron MLP with learnable neuron embeddings, 1D convolutional layer,\n    and an implicit condition-dependent modulation via enhanced ContextExtractor and FiLM.\n    \"\"\"\n    hidden_size: int\n    output_horizon: int\n    dropout_rate: float\n    num_neurons: int\n    embedding_dim: int\n    conv_kernel_size: int\n    conv_features: int\n    context_dim: int\n    hidden_context_dim: int\n    temporal_conv_features: int # New parameter\n    temporal_kernel_size: int   # New parameter\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size, input_horizon, _ = x.shape\n\n        # 1. Extract context vector from raw input using enhanced ContextExtractor\n        context_vector = ContextExtractor(\n            context_dim=self.context_dim,\n            hidden_context_dim=self.hidden_context_dim,\n            temporal_conv_features=self.temporal_conv_features,\n            temporal_kernel_size=self.temporal_kernel_size\n        )(x)\n\n        # 2. Learnable embeddings for each neuron\n        neuron_embeddings = self.param(\n            'neuron_embeddings',\n            nn.initializers.normal(stddev=0.1),\n            (self.num_neurons, self.embedding_dim)\n        )\n\n        # Expand embeddings to match batch size and transpose for concatenation\n        expanded_embeddings = jnp.tile(neuron_embeddings[None, :, :], (batch_size, 1, 1))\n\n        # Reshape x from (batch_size, INPUT_HORIZON, num_neurons) to\n        # (batch_size, num_neurons, INPUT_HORIZON)\n        x_reshaped = jnp.transpose(x, (0, 2, 1))\n\n        # Concatenate input features with neuron embeddings\n        # Resulting shape: (batch_size, num_neurons, INPUT_HORIZON + embedding_dim)\n        x_with_embeddings = jnp.concatenate([x_reshaped, expanded_embeddings], axis=-1)\n\n        # 3. 1D Convolutional Layer for local inter-neuron dependencies\n        conv_output_features = nn.Conv(\n            features=self.conv_features,\n            kernel_size=(self.conv_kernel_size,),\n            padding='SAME'\n        )(x_with_embeddings)\n        conv_output_features = nn.BatchNorm(use_running_average=not training)(conv_output_features)\n        conv_output_features = nn.relu(conv_output_features)\n\n        # 4. FiLM Modulation based on context_vector\n        gamma = nn.Dense(self.conv_features)(context_vector)\n        beta = nn.Dense(self.conv_features)(context_vector)\n        modulated_features = gamma[:, None, :] * conv_output_features + beta[:, None, :]\n\n        # 5. Reshape for shared MLP processing\n        x = jnp.reshape(modulated_features, (batch_size * self.num_neurons, self.conv_features))\n\n        # 6. Shared MLP layers\n        x = nn.Dense(self.hidden_size)(x)\n        x = nn.BatchNorm(use_running_average=not training)(x)\n        x = nn.relu(x)\n        x = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(x)\n\n        x = nn.Dense(self.output_horizon)(x)\n\n        # 7. Reshape back to (batch_size, OUTPUT_HORIZON, num_neurons)\n        x = jnp.reshape(x, (batch_size, self.num_neurons, self.output_horizon))\n        x = jnp.transpose(x, (0, 2, 1))\n\n        return x\n\n\nclass ContextualConvNeuronEmbeddingMLPWrapper:\n    \"\"\"\n    Wrapper to make Flax model compatible with the training system,\n    handling BatchNorm state and Dropout RNG requirements.\n    \"\"\"\n    def __init__(self, hparams: Dict[str, Any]):\n        self.model = ContextualConvNeuronEmbeddingMLP(\n            hidden_size=hparams.get('hidden_size', 64),\n            output_horizon=OUTPUT_HORIZON,\n            dropout_rate=hparams.get('dropout_rate', 0.1),\n            num_neurons=NUM_NEURONS,\n            embedding_dim=hparams.get('embedding_dim', 16),\n            conv_kernel_size=hparams.get('conv_kernel_size', 5),\n            conv_features=hparams.get('conv_features', 64),\n            context_dim=hparams.get('context_dim', 16), # Reverting to 16, best from ablation\n            hidden_context_dim=hparams.get('hidden_context_dim', 32),\n            temporal_conv_features=hparams.get('temporal_conv_features', 16), # New parameter\n            temporal_kernel_size=hparams.get('temporal_kernel_size', 2)     # New parameter\n        )\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params, x, training=training, mutable=mutable, rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params, x, training=training, rngs=rngs if rngs is not None else {}\n            )\n\n\ndef _define_hyperparameters():\n    \"\"\"Define hyperparameters for the Contextual Conv Neuron Embedding MLP model.\"\"\"\n    return {\n        'learning_rate': 0.001,\n        'hidden_size': 64,\n        'dropout_rate': 0.1,\n        'embedding_dim': 16,\n        'conv_kernel_size': 5,\n        'conv_features': 64,\n        'context_dim': 16,\n        'hidden_context_dim': 32,\n        'temporal_conv_features': 16, # New parameter\n        'temporal_kernel_size': 2     # New parameter\n    }\n\n\ndef create_network(hparams: Dict[str, Any]):\n    \"\"\"Create and return the Contextual Conv Neuron Embedding MLP network.\"\"\"\n    return ContextualConvNeuronEmbeddingMLPWrapper(hparams)\n\n\ndef compute_loss(predictions, targets, params, x):\n    \"\"\"Use the default MAE loss function.\"\"\"\n    return default_compute_loss(predictions, targets, params, x)\n\n\ndef create_optimizer(learning_rate: float = 0.001) -> optax.GradientTransformation:\n    \"\"\"Create and return the default Adam optimizer.\"\"\"\n    return default_create_optimizer(learning_rate)\n",
