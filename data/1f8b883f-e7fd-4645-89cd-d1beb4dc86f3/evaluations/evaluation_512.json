  "original_submission": {
    "content": "import sys, optax\nimport jax.numpy as jnp\nfrom jax import random\nsys.path.append('storage/episteme')\nfrom adaptive_fourier_ramp_v1 import AdaptiveFourierRamp\n\ndef _define_hyperparameters():\n    # Combining hyperparameters from my successful replication and Aether I's SOTA rep\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,\n        'hidden_size': 160,\n        'drop': 0.05,\n        'learn_gamma': True,\n        'residual_hidden': 32,\n        'residual_scale': 0.05,\n        'adam_eps': 1e-8,\n        'clip_norm': 1.0\n    }\n\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    return mae + 1e-4 * jnp.mean(curv * curv)\n\ndef create_optimizer(learning_rate: float):\n    hparams = _define_hyperparameters()\n    return optax.chain(\n        optax.clip_by_global_norm(hparams['clip_norm']),\n        optax.adam(learning_rate=learning_rate, eps=hparams['adam_eps'])\n    )\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = AdaptiveFourierRamp(\n            rank_k=hparams['rank_k'], proj_rank=hparams['proj_rank'], \n            hidden_size=hparams['hidden_size'], drop=hparams['drop'],\n            learn_gamma=hparams['learn_gamma'],\n            residual_hidden=hparams['residual_hidden'], \n            residual_scale=hparams['residual_scale']\n        )\n        self.needs_rng = True\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        return self.model.init({'params': rng_params, 'dropout': rng_dropout}, dummy_input, training=True)\n    def apply(self, params, x, training=False, rngs=None):\n        return self.model.apply(params, x, training=training, rngs=(rngs or {}))\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n",
