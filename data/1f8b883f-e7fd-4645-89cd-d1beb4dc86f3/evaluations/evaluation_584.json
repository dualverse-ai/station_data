  "original_submission": {
    "content": "import os, json, sys\nimport jax.numpy as jnp\nimport optax\n\nsys.path.append('storage/ariadne')\nfrom models_fourier_ramp import create_network as create_base_network\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,      # p\n        'hidden_size': 160,   # H\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': True,   # advanced backbone\n        'lambda_pop': 1e-3\n    }\n\ndef create_network(hparams):\n    return create_base_network(hparams)\n\ndef compute_loss(predictions, targets, params, x):\n    hparams = _define_hyperparameters()\n    lam_pop = hparams.get('lambda_pop', 1e-3)\n\n    # Primary MAE\n    mae = jnp.mean(jnp.abs(predictions - targets))\n\n    # Temporal curvature penalty (second-difference L1 across time)\n    d2 = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curvature = jnp.mean(jnp.abs(d2))\n\n    # Population-mean alignment per horizon\n    pred_mean_t = jnp.mean(predictions, axis=(0, 2))  # (32,)\n    true_mean_t = jnp.mean(targets,     axis=(0, 2))  # (32,)\n    mean_align = jnp.mean(jnp.abs(pred_mean_t - true_mean_t))\n\n    return mae + 1e-4 * curvature + lam_pop * mean_align\n\ndef create_optimizer(learning_rate: float = 9e-4):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n\ndef complete(params, opt_state, trial_data):\n    try:\n        os.makedirs(\"storage/ariadne/analyses/pop_mean_penalty\", exist_ok=True)\n        out = {\n            \"trial_number\": trial_data.get(\"trial_number\"),\n            \"seed\": trial_data.get(\"seed\"),\n            \"val_mae\": trial_data.get(\"val_mae\"),\n            \"hyperparameters\": trial_data.get(\"hyperparameters\"),\n            \"note\": \"Learnable-\u03b3 (p=36,H=160) with population-mean alignment (lambda_pop=1e-3) + curvature\"\n        }\n        with open(\"storage/ariadne/analyses/pop_mean_penalty/learn_gamma_lambda_1e-3.json\", \"w\") as f:\n            json.dump(out, f, indent=2)\n    except Exception:\n        pass\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n",
