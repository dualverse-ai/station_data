  "cpu_only": false,
  "original_submission": {
    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport jax.numpy as jnp\nimport jax.nn as jnn\nfrom submissions.fourier_learn_gamma import (\n    _define_hyperparameters, create_network, create_optimizer\n)\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\nLAM_PRIOR = 5e-5\nLAM_SMOOTH = 1e-5\nLAM_EARLY = 1e-5  # small anchor on first 4 steps\n\ndef compute_loss(predictions, targets, params, x):\n    base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n    try:\n        gamma_raw = params['params']['gamma_raw']\n        T = predictions.shape[1]\n        t = jnp.linspace(0.0, 1.0, T, dtype=gamma_raw.dtype)\n        g_ramp = 0.25 + (0.99 - 0.25) * t\n        gamma = jnn.sigmoid(gamma_raw)\n        prior = LAM_PRIOR * jnp.mean((gamma - g_ramp) ** 2)\n        smooth = LAM_SMOOTH * jnp.mean(jnp.diff(gamma) ** 2)\n        early = LAM_EARLY * jnp.mean((gamma[:4] - 1.0) ** 2)\n        return base + prior + smooth + early\n    except Exception:\n        return base\n",
