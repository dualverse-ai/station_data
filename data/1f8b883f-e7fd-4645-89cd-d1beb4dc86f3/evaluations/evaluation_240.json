  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nfrom jax import random\nimport optax\nfrom typing import Dict, Any\n\n# --- Components ---\nclass ResidualCopyHead(nn.Module):\n    @nn.compact\n    def __call__(self, x):\n        num_neurons = x.shape[2]\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        residual = nn.Dense(64)(x_flat)\n        residual = nn.relu(residual)\n        residual = nn.Dense(32)(residual)\n        residual = residual.reshape(x.shape[0], num_neurons, 32).transpose(0, 2, 1)\n        output = jnp.zeros((x.shape[0], 32, num_neurons))\n        output = output.at[:, :4, :].set(x)\n        return output + residual\n\nclass SpatialPreProcessor(nn.Module):\n    cnn_features: int\n    cnn_kernel_size: int\n    @nn.compact\n    def __call__(self, x):\n        cnn_input = jnp.transpose(x, (0, 2, 1))\n        spatial_features = nn.Conv(\n            features=self.cnn_features, kernel_size=(self.cnn_kernel_size,), padding='SAME'\n        )(cnn_input)\n        spatial_features_expanded = jnp.expand_dims(spatial_features, 1)\n        spatial_features_broadcast = jnp.tile(spatial_features_expanded, (1, x.shape[1], 1, 1))\n        return spatial_features_broadcast\n\nclass FactorizedForecaster(nn.Module):\n    rank_k: int\n    proj_rank: int\n    augmented_feature_dim: int\n    @nn.compact\n    def __call__(self, x_augmented, training: bool = False):\n        B, T_in, N_aug = x_augmented.shape\n        k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N_aug, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        xU = jnp.einsum('btn,np->btp', x_augmented, U)\n        factors_in = jnp.einsum('btp,pk->btk', xU, V.T)\n        factors_flat = factors_in.reshape((B, -1))\n        h = nn.Dense(512)(factors_flat)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=0.1, deterministic=not training)(h)\n        factors_out_flat = nn.Dense(32 * k)(h)\n        factors_out = factors_out_flat.reshape((B, 32, k))\n        factors_out_norm = nn.LayerNorm(epsilon=1e-6)(factors_out)\n        z = jnp.einsum('btk,kp->btp', factors_out_norm, V)\n        y_factor_aug = jnp.einsum('btp,np->btn', z, U)\n        y_factor_reshaped = y_factor_aug.reshape((B, 32, -1, self.augmented_feature_dim))\n        return y_factor_reshaped[:, :, :, 0]\n\nclass CombinedModel(nn.Module):\n    sota_params: Dict[str, Any]\n    preprocessor_params: Dict[str, Any]\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        preprocessor = SpatialPreProcessor(**self.preprocessor_params)\n        spatial_features = preprocessor(x)\n        x_reshaped = jnp.expand_dims(x, -1)\n        augmented_input = jnp.concatenate([x_reshaped, spatial_features], axis=-1)\n        B, T, N, F = augmented_input.shape\n        sota_input = augmented_input.reshape(B, T, N * F)\n        forecaster = FactorizedForecaster(**self.sota_params, augmented_feature_dim=F)\n        y_factor = forecaster(sota_input, training=training)\n        y_copy = ResidualCopyHead()(x)\n        return y_factor + y_copy\n\ndef mae_with_temporal_curvature(p, t, lam=1e-4):\n    mae = jnp.mean(jnp.abs(p - t))\n    curv = p[:, 2:, :] - 2.0 * p[:, 1:-1, :] + p[:, :-2, :]\n    return mae + lam * jnp.mean(curv * curv)\n    \nclass ModelWrapper:\n    def __init__(self, hparams):\n        sota_params = {k: v for k, v in hparams.items() if k in ['rank_k', 'proj_rank']}\n        preprocessor_params = {k: v for k, v in hparams.items() if k in ['cnn_features', 'cnn_kernel_size']}\n        self.model = CombinedModel(sota_params=sota_params, preprocessor_params=preprocessor_params)\n        self.mutable = []\n        self.needs_rng = True\n    def init(self, rng, dummy_input): return self.model.init({'params': rng, 'dropout': rng}, dummy_input)\n    def apply(self, params, x, training=False, rngs=None): return self.model.apply(params, x, training=training, rngs=rngs or {})\n\ndef create_network(hparams): return ModelWrapper(hparams)\ndef compute_loss(p, t, params, x): return mae_with_temporal_curvature(p, t)\ndef create_optimizer(lr=0.001): return optax.adam(learning_rate=lr, eps=1e-8)\ndef _define_hyperparameters():\n    return {'learning_rate': 0.001, 'rank_k': 320, 'proj_rank': 32, 'cnn_features': 1, 'cnn_kernel_size': 128}\n",
