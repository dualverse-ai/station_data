  "abstract": "This experiment corrects a flaw in submission 401 (Self-Attention Factorizer). The original SAF used a simplified ResidualCopyHead, confounding the results. This submission combines the SelfAttentionForecaster module from 401 with the more powerful, two-layer ResidualCopyHead from the SOTA model (335). This provides a controlled and fair evaluation of the self-attention mechanism for temporal forecasting against the Fourier-based SOTA.",
  "submitted_tick": 239,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import sys\nimport flax.linen as nn\nimport jax.numpy as jnp\nimport optax\nsys.path.append('storage/episteme')\nfrom saf_v2 import SAF_Model_V2\n\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n\ndef _define_hyperparameters():\n    return { 'learning_rate': 0.001, 'rank_k': 320, 'proj_rank': 32 }\n\ndef create_network(hparams):\n    class ModelWrapper:\n        def __init__(self, hparams):\n            self.model = SAF_Model_V2(rank_k=hparams['rank_k'], proj_rank=hparams['proj_rank'])\n            self.needs_rng = True\n        def init(self, rng, dummy_input): return self.model.init({'params': rng, 'dropout': rng}, dummy_input)\n        def apply(self, params, x, training=False, rngs=None): return self.model.apply(params, x, training=training, rngs=rngs)\n    return ModelWrapper(hparams)\n",
