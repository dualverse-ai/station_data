  "original_submission": {
    "content": "import flax.linen as nn\nimport jax\nimport jax.numpy as jnp\nimport optax\nfrom jax import random\nfrom typing import Tuple, Dict, Any, Optional\nimport os, json # Added for rankgate analysis export\n\n# --- Hyperparameters Definition ---\ndef _define_hyperparameters():\n    return { \n        'learning_rate': 0.001, \n        'rank_k': 320, \n        'proj_rank_max': 48, # Maximum projection rank\n        'lam_gate': 3e-5 # Tuned Lambda for L1 sparsity on gates (NEW)\n    }\n\n# --- Ariadne's mae_with_temporal_curvature LOSS FUNCTION ---\ndef mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + lam * curv_pen\n\n# --- Ariadne's _logit function for gate initialization ---\ndef _logit(p):\n    p = jnp.clip(p, 1e-6, 1 - 1e-6)\n    return jnp.log(p) - jnp.log(1 - p)\n\n# Episteme's ResidualCopyHead (from storage/episteme/fourier_forecaster_v2_ln.py)\nclass ResidualCopyHead(nn.Module):\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        num_neurons = x.shape[2]\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        residual = nn.Dense(64)(x_flat); residual = nn.relu(residual)\n        residual = nn.Dropout(rate=0.1)(residual, deterministic=not training)\n        residual = nn.Dense(32)(residual)\n        residual = residual.reshape(x.shape[0], num_neurons, 32).transpose(0, 2, 1)\n        output = jnp.zeros((x.shape[0], 32, num_neurons)); output = output.at[:, :4, :].set(x)\n        return output + residual\n\n# Aether I's SAP-FourierForecasterLN (integrated SAP)\nclass SAP_FourierForecasterLN(nn.Module):\n    rank_k: int\n    proj_rank_max: int # Maximum projection rank\n    num_neurons: int = 71721\n    output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        k, Pmax = self.rank_k, self.proj_rank_max\n        \n        # Low-rank loadings (U_raw and V_raw, before scaling)\n        U_raw = self.param('U', nn.initializers.lecun_normal(), (N, Pmax))\n        V_raw = self.param('V', nn.initializers.lecun_normal(), (k, Pmax))\n        \n        # Normalize U_raw columns first\n        U_unscaled = U_raw / (jnp.linalg.norm(U_raw, axis=0, keepdims=True) + 1e-6)\n\n        # Rank gates over columns p\n        gate_raw = self.param('gate_raw', nn.initializers.zeros, (Pmax,))\n        s = nn.sigmoid(gate_raw) # (Pmax,)\n\n        # Scale U and V with sqrt(s) so effective loading is L = sum_p s_p U_p V_p^T\n        scale = jnp.sqrt(s + 1e-8) # Add epsilon to avoid sqrt(0)\n        U_g = U_unscaled * scale[None, :] # (N,Pmax)\n        V_g = V_raw * scale[None, :]       # (k,Pmax)\n\n        # --- Fourier Branch ---\n        x_fft = jnp.fft.rfft(x, axis=1) # RFFT on temporal dimension\n        x_fft_transposed = jnp.transpose(x_fft, (0, 2, 1)) # (B, N, T_in_freq)\n        \n        # Project into factor space in frequency domain using U_g and V_g\n        factors_in_fft = jnp.einsum('bni,np->bip', x_fft_transposed, U_g) @ V_g.T # (B, T_in_freq, k)\n        \n        # Flatten real and imaginary parts for MLP\n        factors_in_flat = jnp.concatenate([factors_in_fft.real, factors_in_fft.imag], axis=-1).reshape(B, -1)\n        \n        # Deeper MLP in flattened factor-frequency space (H=512x2 from previous SOTA)\n        h = nn.Dense(512)(factors_in_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=0.1)(h, deterministic=not training)\n        h = nn.Dense(512)(h); h = nn.relu(h)\n        h = nn.Dropout(rate=0.1)(h, deterministic=not training)\n        \n        num_out_freqs = self.output_horizon // 2 + 1\n        factors_out_flat = nn.Dense(num_out_freqs * k * 2)(h) # Output 2*k for real/imag\n        \n        # Reshape and split into real and imaginary parts\n        factors_out_real, factors_out_imag = jnp.split(factors_out_flat.reshape(B, num_out_freqs, k, 2), 2, axis=-1)\n        factors_out_fft_raw = (factors_out_real + 1j * factors_out_imag).squeeze(-1) # Reconstruct complex\n\n        # Add LayerNorm in the frequency domain (separately for real and imag)\n        norm_real = nn.LayerNorm()(factors_out_fft_raw.real)\n        norm_imag = nn.LayerNorm()(factors_out_fft_raw.imag)\n        factors_out_fft_norm = norm_real + 1j * norm_imag\n\n        # Decode from frequency-domain factors back to neuron space using V_g and U_g\n        y_fft = (factors_out_fft_norm @ V_g) @ U_g.T # (B, T_out_freq, N)\n        y_fourier = jnp.fft.irfft(y_fft, n=self.output_horizon, axis=1) # IFFT to time domain\n\n        # --- Time Branch ---\n        y_copy = ResidualCopyHead()(x, training=training)\n        \n        return y_fourier + y_copy\n\n# --- Submission API ---\nclass ModelWrapper:\n    def __init__(self, hparams: Dict[str, Any]):\n        self.hparams = hparams\n        self.model = SAP_FourierForecasterLN(\n            rank_k=hparams['rank_k'], \n            proj_rank_max=hparams['proj_rank_max']\n        )\n        self.needs_rng = True # For dropout in ResidualCopyHead and MLP\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params,\n                x,\n                training=training,\n                mutable=mutable,\n                rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params,\n                x,\n                training=training,\n                rngs=rngs if rngs is not None else {}\n            )\n\ndef create_network(hparams: Dict[str, Any]):\n    return ModelWrapper(hparams)\n\n# --- L1 Loss on Gates ---\ndef _l1_on_gates(params):\n    try:\n        g = params['params']['gate_raw']\n    except KeyError:\n        g = params.get('gate_raw', None)\n    if g is None:\n        return 0.0\n    s = nn.sigmoid(g)\n    return jnp.sum(jnp.abs(s))\n\ndef compute_loss(predictions, targets, params, x):\n    base_loss = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n    l1_gate_loss = _l1_on_gates(params)\n    return base_loss + _define_hyperparameters()['lam_gate'] * l1_gate_loss\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0), # Uses gradient clipping\n        optax.adam(learning_rate=learning_rate)\n    )\n\n# --- Utility to extract gates for analysis (from Ariadne I's code) ---\ndef extract_gates(params):\n    try:\n        g = params['params']['gate_raw']\n        return jnp.asarray(nn.sigmoid(g))\n    except KeyError:\n        return None\n\ndef export_rankgate_analysis(params, trial_data, out_dir):\n    s = extract_gates(params)\n    if s is None:\n        print(\"Warning: 'gate_raw' parameter not found for rankgate analysis export.\")\n        return\n    eff_rank_tau = 0.10 # Threshold for effective rank calculation\n    eff_rank = int((s > eff_rank_tau).sum())\n    stats = {\n        'trial_number': int(trial_data.get('trial_number', -1)),\n        'seed': int(trial_data.get('seed', -1)),\n        'val_mae': float(trial_data.get('val_mae', -1.0)),\n        'hyperparameters': trial_data.get('hyperparameters', {}),\n        'gate_mean': float(s.mean()),\n        'gate_min': float(s.min()),\n        'gate_max': float(s.max()),\n        'eff_rank_tau': eff_rank_tau,\n        'eff_rank': eff_rank,\n        'gates_sorted_desc': [float(v) for v in jnp.sort(s)[::-1]]\n    }\n    os.makedirs(out_dir, exist_ok=True)\n    with open(os.path.join(out_dir, f\"sap_fourier_trial_{stats['trial_number']}_seed_{stats['seed']}.json\"), 'w') as f:\n        json.dump(stats, f, indent=2)\n\ndef complete(params, opt_state, trial_data):\n    print(f\"Completion for SAP-Fourier Forecaster. Seed: {trial_data['seed']}\")\n    # Export rank gate analysis for this run\n    out_dir = \"storage/aether/analyses/sap_fourier_rankgate\"\n    export_rankgate_analysis(params, trial_data, out_dir)\n",
