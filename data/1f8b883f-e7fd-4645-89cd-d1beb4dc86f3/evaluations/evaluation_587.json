  "abstract": "This is the synthesis experiment (Step 5) of the Stagnation Protocol. It combines my most promising novel idea\u2014Hypernetwork-Generated Biases (ID 578)\u2014with an advanced baseline, my NCS-MLP v2 architecture (ID 551). This new model, NCS-MLP v3, uses learnable neuron embeddings to condition the shared MLP in two ways simultaneously: FiLM layers modulate the activations, and hypernetworks generate the biases. This tests for synergy between these two distinct dynamic conditioning mechanisms.",
  "submitted_tick": 325,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport flax.linen as nn\nimport jax.numpy as jnp\nimport optax\nfrom jax import random\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001, 'embedding_dim': 32, 'hidden_size': 128,\n        'num_neurons': 71721, 'adam_eps': 1e-8, 'context_hidden': 64,\n        'gating_scale': 0.1, 'shift_scale': 0.02\n    }\n\nclass FiLMGenerator(nn.Module):\n    hidden_dim: int\n    @nn.compact\n    def __call__(self, embedding):\n        film_params = nn.Dense(2 * self.hidden_dim)(embedding)\n        gamma, beta = jnp.split(film_params, 2, axis=-1); return gamma + 1.0, beta\n\nclass HyperBias(nn.Module):\n    output_dim: int\n    @nn.compact\n    def __call__(self, x):\n        h = nn.Dense(32)(x); h = nn.relu(h); return nn.Dense(self.output_dim)(h)\n\nclass NCS_MLP_v3(nn.Module):\n    embedding_dim: int; hidden_size: int; num_neurons: int\n    context_hidden: int; gating_scale: float; shift_scale: float\n    output_horizon: int = 32\n    @nn.compact\n    def __call__(self, x: jnp.ndarray) -> jnp.ndarray:\n        B, T_in, N = x.shape\n        neuron_indices = jnp.arange(self.num_neurons)\n        neuron_embeddings = nn.Embed(num_embeddings=self.num_neurons, features=self.embedding_dim)(neuron_indices)\n        tiled_embeddings = jnp.tile(neuron_embeddings, (B, 1))\n        x_flat = x.transpose((0, 2, 1)).reshape(B * N, T_in)\n        \n        # Block 1: FiLM + Hypernetwork Bias\n        bias1 = HyperBias(self.hidden_size, name=\"hyper_bias_1\")(tiled_embeddings)\n        h = nn.Dense(self.hidden_size, use_bias=False)(x_flat) + bias1\n        h = nn.relu(h)\n        gamma1, beta1 = FiLMGenerator(self.hidden_size, name=\"film_gen_1\")(tiled_embeddings)\n        h = gamma1 * h + beta1\n        \n        # Block 2: FiLM + Hypernetwork Bias\n        bias2 = HyperBias(self.hidden_size, name=\"hyper_bias_2\")(tiled_embeddings)\n        h = nn.Dense(self.hidden_size, use_bias=False)(h) + bias2\n        h = nn.relu(h)\n        gamma2, beta2 = FiLMGenerator(self.hidden_size, name=\"film_gen_2\")(tiled_embeddings)\n        h = gamma2 * h + beta2\n        \n        y_base_flat = nn.Dense(self.output_horizon)(h)\n        y_base = y_base_flat.reshape(B, N, self.output_horizon)\n        \n        # Population Context Gate\n        x_mean = x.mean(axis=-1); x_std = x.std(axis=-1) + 1e-6\n        context = jnp.concatenate([x_mean, x_std], axis=-1)\n        ch = nn.Dense(self.context_hidden)(context); ch = nn.gelu(ch)\n        ch = nn.Dense(self.context_hidden)(ch); ch = nn.gelu(ch)\n        g_raw = nn.Dense(self.output_horizon)(ch)\n        s_raw = nn.Dense(self.output_horizon)(ch)\n        g = 1.0 + self.gating_scale * jnp.tanh(g_raw)\n        s = self.shift_scale * jnp.tanh(s_raw)\n        y = y_base * g[:, None, :] + s[:, None, :]\n        output = y.transpose((0, 2, 1))\n        return output\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = NCS_MLP_v3(**{k: hparams[k] for k in _define_hyperparameters() if k in ['embedding_dim', 'hidden_size', 'num_neurons', 'context_hidden', 'gating_scale', 'shift_scale']})\n        self.needs_rng = True # Though no dropout, safer to keep if other stochastic ops are added.\n    def init(self, rng_key, dummy_input): return self.model.init(rng_key, dummy_input)\n    def apply(self, params, x, training=False, rngs=None): return self.model.apply(params, x)\n\ndef create_network(hparams): return ModelWrapper(hparams)\ndef compute_loss(predictions, targets, params, x): return jnp.mean(jnp.abs(predictions - targets))\ndef create_optimizer(learning_rate: float):\n    return optax.adam(learning_rate=learning_rate, eps=_define_hyperparameters()['adam_eps'])\n",
