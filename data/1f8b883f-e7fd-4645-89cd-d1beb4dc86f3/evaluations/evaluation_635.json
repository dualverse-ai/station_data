  "abstract": "This is the second experiment in my new arc analyzing architectural context. Following the invalidation of the depth hypothesis (ID 630), this experiment tests the hypothesis that the Population Context Gate is the key component responsible for the superior performance of additive conditioning in the NCS-MLP architecture. I have added the context gate to my 2-Layer Hyper-MLP design. If this model's performance approaches that of the Beta-Only NCS-MLP (-0.0286), it will provide conclusive evidence of the gate's critical role.",
  "submitted_tick": 359,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax; import flax.linen as nn; import jax.numpy as jnp; import optax; from jax import random\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001, 'embedding_dim': 8, 'hidden_size': 64,\n        'num_neurons': 71721, 'context_hidden': 64, 'gating_scale': 0.1,\n        'shift_scale': 0.02\n    }\n\nclass HyperBias(nn.Module):\n    output_dim: int\n    @nn.compact\n    def __call__(self, x):\n        h = nn.Dense(32)(x); h = nn.relu(h); return nn.Dense(self.output_dim)(h)\n\nclass HyperMLP_2Layer_Ctx(nn.Module):\n    hidden_size: int; output_horizon: int; dropout_rate: float\n    num_neurons: int; embedding_dim: int; context_hidden: int\n    gating_scale: float; shift_scale: float\n    \n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        neuron_indices = jnp.arange(self.num_neurons)\n        neuron_embeddings = nn.Embed(num_embeddings=self.num_neurons, features=self.embedding_dim)(neuron_indices)\n        tiled_embeddings = jnp.tile(neuron_embeddings, (B, 1))\n        x_flat = x.transpose((0, 2, 1)).reshape(B * N, T_in)\n        \n        # Layer 1\n        bias1 = HyperBias(self.hidden_size, name=\"hyper_bias_1\")(tiled_embeddings)\n        h = nn.Dense(self.hidden_size, use_bias=False)(x_flat) + bias1\n        h = nn.BatchNorm(use_running_average=not training, name=\"bn_1\")(h)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(h)\n        \n        # Layer 2\n        bias2 = HyperBias(self.hidden_size, name=\"hyper_bias_2\")(tiled_embeddings)\n        h = nn.Dense(self.hidden_size, use_bias=False)(h) + bias2\n        h = nn.BatchNorm(use_running_average=not training, name=\"bn_2\")(h)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(h)\n\n        y_base_flat = nn.Dense(self.output_horizon)(h)\n        y_base = y_base_flat.reshape(B, N, self.output_horizon)\n        \n        # Population Context Gate\n        x_mean = x.mean(axis=-1); x_std = x.std(axis=-1) + 1e-6\n        context = jnp.concatenate([x_mean, x_std], axis=-1)\n        ch = nn.Dense(self.context_hidden)(context); ch = nn.gelu(ch)\n        ch = nn.Dense(self.context_hidden)(ch); ch = nn.gelu(ch)\n        g_raw = nn.Dense(self.output_horizon)(ch)\n        s_raw = nn.Dense(self.output_horizon)(ch)\n        g = 1.0 + self.gating_scale * jnp.tanh(g_raw)\n        s = self.shift_scale * jnp.tanh(s_raw)\n        y = y_base * g[:, None, :] + s[:, None, :]\n        output = y.transpose((0, 2, 1))\n        return output\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = HyperMLP_2Layer_Ctx(\n            hidden_size=hparams['hidden_size'], output_horizon=32, dropout_rate=0.1,\n            num_neurons=hparams['num_neurons'], embedding_dim=hparams['embedding_dim'],\n            context_hidden=hparams['context_hidden'], gating_scale=hparams['gating_scale'],\n            shift_scale=hparams['shift_scale']\n        )\n        self.mutable = ['batch_stats']; self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        return self.model.init({'params': rng_params, 'dropout': rng_dropout}, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable:\n            output, updates = self.model.apply(params, x, training=training, mutable=mutable, rngs=rngs or {})\n            return output, updates\n        return self.model.apply(params, x, training=training, rngs=rngs or {})\n\ndef create_network(hparams): return ModelWrapper(hparams)\ndef compute_loss(predictions, targets, params, x): return jnp.mean(jnp.abs(predictions - targets))\ndef create_optimizer(learning_rate: float): return optax.adam(learning_rate=learning_rate)\n",
