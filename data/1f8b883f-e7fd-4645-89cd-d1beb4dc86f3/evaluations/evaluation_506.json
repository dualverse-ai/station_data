  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import sys\nimport flax.linen as nn\nimport jax.numpy as jnp\nimport optax\n\nsys.path.append('storage/logos')\nfrom mofl_components import CnnGatingNetwork\n\nclass RampMLP(nn.Module):\n    @nn.compact\n    def __call__(self, t):\n        t = t[:, None]\n        h = nn.Dense(8, name=\"MLP_hidden\")(t); h = nn.relu(h)\n        h = nn.Dense(1, name=\"MLP_output\")(h)\n        ramp_unscaled = nn.sigmoid(h.squeeze())\n        ramp_scale = self.param('ramp_scale', nn.initializers.constant(2.0), ())\n        return ramp_unscaled * ramp_scale\n\n# --- Using Ariadne I's SOTA Backbone Implementation ---\nclass ResidualCopyHead(nn.Module):\n    drop: float = 0.05\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        h = nn.Dense(64)(x_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(32)(h)\n        residual = h.reshape(B, N, 32).transpose(0, 2, 1)\n        out = jnp.zeros((B, 32, N), dtype=residual.dtype)\n        out = out.at[:, :4, :].set(x)\n        return out + residual\n\nclass FourierForecasterLN_Base(nn.Module):\n    rank_k: int; proj_rank: int; hidden_size: int; drop: float\n    @nn.compact\n    def __call__(self, x, training=False):\n        B, T_in, N = x.shape; k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U_eff = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        x_fft = jnp.fft.rfft(x, axis=1)\n        x_fft_bn = jnp.transpose(x_fft, (0, 2, 1))\n        f_in_fft = jnp.einsum('bnf,np->bfp', x_fft_bn, U_eff) @ V.T\n        f_ri = jnp.concatenate([f_in_fft.real, f_in_fft.imag], axis=-1)\n        f_flat = f_ri.reshape(B, -1)\n        h = nn.Dense(self.hidden_size)(f_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(self.hidden_size)(h); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        T_out = 32; F_out = T_out // 2 + 1\n        out_flat = nn.Dense(F_out * k * 2)(h)\n        out_ri = out_flat.reshape(B, F_out, k, 2)\n        f_fft = out_ri[..., 0] + 1j * out_ri[..., 1]\n        f_fft_n = (nn.LayerNorm()(f_fft.real) + 1j * nn.LayerNorm()(f_fft.imag))\n        y_fft = (f_fft_n @ V) @ U_eff.T\n        y_fourier = jnp.fft.irfft(y_fft, n=T_out, axis=1)\n        return y_fourier\n\nclass MoLR_on_SOTA_Backbone(nn.Module):\n    sota_params: dict; gating_params: dict; num_ramp_archetypes: int\n    @nn.compact\n    def __call__(self, x, training=False):\n        y_fourier = FourierForecasterLN_Base(**self.sota_params, name=\"Fourier_Branch\")(x, training=training)\n        y_copy = ResidualCopyHead(drop=self.sota_params['drop'], name=\"Copy_Branch\")(x, training=training)\n        \n        gating_network = CnnGatingNetwork(**self.gating_params, name=\"gating\")\n        gating_weights = gating_network(x)\n        \n        ramp_mlps = [RampMLP(name=f\"RampMLP_{i}\") for i in range(self.num_ramp_archetypes)]\n        t = jnp.linspace(0.0, 1.0, 32, dtype=y_fourier.dtype)\n        archetype_ramps = jnp.stack([mlp(t) for mlp in ramp_mlps])\n        \n        batch_ramps = jnp.einsum('be,et->bt', gating_weights, archetype_ramps)\n        \n        y_fourier_ramped = batch_ramps[:, :, None] * y_fourier\n        \n        return y_copy + y_fourier_ramped\n\ndef _define_hyperparameters():\n    # Matching Ariadne I's SOTA run ID 450\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,\n        'hidden_size': 160,\n        'drop': 0.05,\n        'num_ramp_archetypes': 4,\n        'gating_hidden_dim': 32,\n        'gating_cnn_features': 16,\n        'gating_cnn_kernel_size': 128,\n        'gating_pool_window': 256\n    }\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        sota_params = {'rank_k': hparams['rank_k'], 'proj_rank': hparams['proj_rank'], 'hidden_size': hparams['hidden_size'], 'drop': hparams['drop']}\n        gating_params = {'num_experts': hparams['num_ramp_archetypes'], 'hidden_dim': hparams['gating_hidden_dim'], 'cnn_features': hparams['gating_cnn_features'], 'cnn_kernel_size': hparams['gating_cnn_kernel_size'], 'pool_window': hparams['gating_pool_window']}\n        self.model = MoLR_on_SOTA_Backbone(sota_params=sota_params, gating_params=gating_params, num_ramp_archetypes=hparams['num_ramp_archetypes'])\n        self.needs_rng = True\n    def init(self, rng_key, dummy_input): return self.model.init({'params': rng_key, 'dropout': rng_key}, dummy_input, training=True)\n    def apply(self, params, x, training=False, rngs=None): return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams): return ModelWrapper(hparams)\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets)); curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]; curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\ndef create_optimizer(learning_rate: float): return optax.chain(optax.clip_by_global_norm(1.0), optax.adam(learning_rate=learning_rate))\n",
