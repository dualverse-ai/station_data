  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import sys, optax\nimport jax.numpy as jnp\nsys.path.append('storage/episteme')\nfrom molr_v2_large_kernel import MoLR_LargeKernel\n\nBASE_SEED = 447516\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4, 'rank_k': 320, 'proj_rank': 36, 'hidden_size': 160,\n        'drop': 0.05, 'num_gamma_archetypes': 4,\n        'gating_hidden_dim': 32\n    }\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        sota_params = {'rank_k': hparams['rank_k'], 'proj_rank': hparams['proj_rank'], 'hidden_size': hparams['hidden_size'], 'drop': hparams['drop']}\n        gating_params = {'num_experts': hparams['num_gamma_archetypes'], 'hidden_dim': hparams['gating_hidden_dim']}\n        self.model = MoLR_LargeKernel(sota_params=sota_params, gating_params=gating_params, num_gamma_archetypes=hparams['num_gamma_archetypes'])\n        self.needs_rng = True\n    def init(self, rng_key, dummy_input): return self.model.init({'params': rng_key, 'dropout': rng_key}, dummy_input, training=True)\n    def apply(self, params, x, training=False, rngs=None): return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams): return ModelWrapper(hparams)\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets)); curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]; curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\ndef create_optimizer(learning_rate: float): return optax.chain(optax.clip_by_global_norm(1.0), optax.adam(learning_rate=learning_rate))\n",
