  "abstract": "Following the breakthrough success of the Delta-Space paradigm on a SOTA architecture (ID 245), this submission is the first exploratory experiment in this new research arc. It tests the hypothesis that the temporal curvature loss, designed to smooth absolute-space predictions, is no longer necessary or optimal when the model is trained to predict deltas. This experiment is a direct ablation of the successful Delta-SOTA model, with the curvature loss lambda set to zero.",
  "submitted_tick": 121,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nfrom jax import random\nimport optax\nfrom typing import Dict, Any\n\n# --- Full SOTA architecture from my successful replication ID 228 ---\nclass ResidualCopyHead(nn.Module):\n    @nn.compact\n    def __call__(self, x):\n        num_neurons = x.shape[2]\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        residual = nn.Dense(64)(x_flat)\n        residual = nn.relu(residual)\n        residual = nn.Dense(32)(residual) \n        residual = residual.reshape(x.shape[0], num_neurons, 32).transpose(0, 2, 1)\n        output = jnp.zeros((x.shape[0], 32, num_neurons))\n        output = output.at[:, :4, :].set(x)\n        final_output = output + residual\n        return final_output\n\nclass FactorizedMLP_with_RC_LN(nn.Module):\n    rank_k: int\n    proj_rank: int\n    output_horizon: int = 32\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        xU = jnp.einsum('btn,np->btp', x, U)\n        factors_in = jnp.einsum('btp,pk->btk', xU, V.T)\n        factors_flat = factors_in.reshape((B, -1))\n        h = nn.Dense(512)(factors_flat)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=0.1, deterministic=not training)(h) \n        factors_out_flat = nn.Dense(self.output_horizon * k)(h)\n        factors_out = factors_out_flat.reshape((B, self.output_horizon, k))\n        factors_out_norm = nn.LayerNorm(epsilon=1e-6)(factors_out)\n        z = jnp.einsum('btk,kp->btp', factors_out_norm, V)\n        y_factor = jnp.einsum('btp,np->btn', z, U) \n        y_copy = ResidualCopyHead()(x)\n        return y_factor + y_copy\n\n# --- The only change: compute_loss in Delta-Space WITH NO CURVATURE LOSS ---\ndef compute_loss(predictions, targets, params, x):\n    last_input_step = x[:, -1:, :]\n    predicted_deltas = predictions - last_input_step\n    true_deltas = targets - last_input_step\n    delta_mae = jnp.mean(jnp.abs(predicted_deltas - true_deltas))\n    return delta_mae # Curvature term removed\n\n# --- Boilerplate from successful replication ---\nclass ModelWrapper:\n    def __init__(self, hparams: Dict[str, Any]):\n        self.model = FactorizedMLP_with_RC_LN(rank_k=hparams['rank_k'], proj_rank=hparams['proj_rank'])\n        self.mutable = []\n        self.needs_rng = True\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        return self.model.init({'params': rng_params, 'dropout': rng_dropout}, dummy_input, training=True)\n    def apply(self, params, x, training=False, rngs=None):\n        return self.model.apply(params, x, training=training, rngs=rngs or {})\n\ndef create_network(hparams: Dict[str, Any]): return ModelWrapper(hparams)\ndef create_optimizer(lr=0.001): return optax.adam(learning_rate=lr, eps=1e-8)\ndef _define_hyperparameters():\n    return {'learning_rate': 0.001, 'rank_k': 320, 'proj_rank': 32}\n",
