  "original_submission": {
    "content": "import sys, os, json\nsys.path.append('storage/ariadne')\n\nimport optax\nfrom models_mlp_global import create_network, _define_hyperparameters as _def_base, BASE_SEED, BATCH_SIZE\nfrom losses import mae_with_temporal_curvature\n\ndef _define_hyperparameters():\n    # Best known config in this line\n    hp = _def_base()\n    # ensure dropout=0.10 and proj_rank=32 in case defaults differ\n    hp['dropout_rate'] = 0.10\n    hp['proj_rank'] = 32\n    return hp\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adamw(learning_rate=learning_rate, weight_decay=1e-4, eps=1e-8)\n    )\n\n# --- Export helpers ---\ndef _find_param(tree, key):\n    if isinstance(tree, dict):\n        if key in tree:\n            return tree[key]\n        for v in tree.values():\n            out = _find_param(v, key)\n            if out is not None:\n                return out\n    return None\n\ndef _u_stats(U):\n    import jax.numpy as jnp\n    u_col_norms = jnp.linalg.norm(U, axis=0)\n    Gu = U.T @ U\n    du = jnp.sqrt(jnp.clip(jnp.diag(Gu), 1e-12))\n    Gu_norm = Gu / (du[:, None] * du[None, :])\n    off_diag = jnp.abs(Gu_norm - jnp.eye(Gu_norm.shape[0], dtype=Gu_norm.dtype))\n    return {\n        \"u_col_norms_mean\": float(jnp.mean(u_col_norms)),\n        \"u_col_norms_std\": float(jnp.std(u_col_norms)),\n        \"u_coherence_max\": float(jnp.max(off_diag)),\n        \"u_coherence_mean\": float(jnp.mean(off_diag)),\n        \"p\": int(U.shape[1]),\n        \"N\": int(U.shape[0]),\n    }\n\ndef complete(params, opt_state, trial_data):\n    # Save U stats and trial metadata\n    out_dir = os.path.join(\"storage\", \"ariadne\", \"analyses\", \"mlp_best_wd1e4\", f\"trial_{trial_data.get('trial_number','NA')}\")\n    os.makedirs(out_dir, exist_ok=True)\n\n    U = _find_param(params, 'U')\n    rec = {\n        \"val_mae\": float(trial_data.get(\"val_mae\", -1.0)),\n        \"seed\": int(trial_data.get(\"seed\", -1)),\n        \"trial_number\": int(trial_data.get(\"trial_number\", -1)),\n        \"hyperparameters\": trial_data.get(\"hyperparameters\", {}),\n    }\n    if U is not None:\n        try:\n            stats = _u_stats(U)\n            rec[\"u_stats\"] = stats\n        except Exception as e:\n            rec[\"u_stats_error\"] = str(e)\n\n    with open(os.path.join(out_dir, \"summary.json\"), \"w\") as f:\n        json.dump(rec, f, indent=2)\n",
