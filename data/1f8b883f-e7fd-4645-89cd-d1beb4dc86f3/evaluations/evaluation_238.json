  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\n\nclass ResidualCopyHead(nn.Module):\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        num_neurons = x.shape[2]\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        residual = nn.Dense(64)(x_flat)\n        residual = nn.relu(residual)\n        residual = nn.Dropout(rate=0.1)(residual, deterministic=not training)\n        residual = nn.Dense(32)(residual)\n        residual = residual.reshape(x.shape[0], num_neurons, 32).transpose(0, 2, 1)\n        output = jnp.zeros((x.shape[0], 32, num_neurons))\n        output = output.at[:, :4, :].set(x)\n        return output + residual\n\nclass FactorizedMLP_with_RC_LN(nn.Module):\n    rank_k: int\n    proj_rank: int\n    num_neurons: int = 71721\n    \n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        k, p = self.rank_k, self.proj_rank\n\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        \n        # NEW: Add U-Normalization\n        U_eff = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        \n        factors_in = jnp.einsum('btn,np->btp', x, U_eff) @ V.T\n        \n        factors_flat = factors_in.reshape((B, -1))\n        h = nn.Dense(512)(factors_flat)\n        h = nn.relu(h)\n        # Add dropout to MLP as in my SOTA\n        h = nn.Dropout(rate=0.1)(h, deterministic=not training)\n        factors_out_flat = nn.Dense(32 * k)(h)\n        factors_out = factors_out_flat.reshape((B, 32, k))\n\n        # NEW: Add LayerNorm\n        factors_out_norm = nn.LayerNorm()(factors_out)\n\n        y_factor = (factors_out_norm @ V) @ U_eff.T\n        \n        y_copy = ResidualCopyHead()(x, training=training)\n        \n        return y_factor + y_copy\n\ndef _define_hyperparameters():\n    return { 'learning_rate': 0.001, 'rank_k': 320, 'proj_rank': 32 }\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = FactorizedMLP_with_RC_LN(rank_k=hparams['rank_k'], proj_rank=hparams['proj_rank'])\n        self.needs_rng = True # For dropout in both RC and MLP\n\n    def init(self, rng_key, dummy_input):\n        return self.model.init({'params': rng_key, 'dropout': rng_key}, dummy_input)\n\n    def apply(self, params, x, training=False, rngs=None):\n        return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n",
