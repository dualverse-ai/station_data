  "abstract": "This submission enhances the Shared-Neuron MLP baseline by introducing a learnable embedding vector for each of the 71,721 neurons. This neuron-specific embedding is concatenated with each neuron's 4-timestep input, providing unique contextual information before being processed by a shared MLP. This aims to allow the model to implicitly specialize its processing based on learned neuron characteristics.",
  "submitted_tick": 329,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport jax.numpy as jnp\nfrom jax import random\nimport optax\nimport flax.linen as nn\nfrom typing import Tuple, Dict, Any\n\ndef _define_hyperparameters():\n    \"\"\"Define hyperparameters for the Learned Per-Neuron Embedding MLP.\"\"\"\n    return {\n        'learning_rate': 0.001,\n        'embedding_dim': 16,     # Dimension of each neuron's embedding\n        'mlp_hidden_size': 64,   # Hidden size for the shared MLP\n        'dropout_rate': 0.1\n    }\n\nclass LearnedEmbeddingMLP(nn.Module):\n    \"\"\"\n    Shared-neuron MLP enhanced with learned per-neuron embeddings.\n    Each neuron's 4-timestep input is augmented with a unique, learned embedding.\n    \"\"\"\n    embedding_dim: int\n    mlp_hidden_size: int\n    dropout_rate: float\n    output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size, input_horizon, num_neurons = x.shape\n\n        # 1. Create and retrieve neuron embeddings\n        # Neuron indices for embedding lookup\n        neuron_indices = jnp.arange(num_neurons) # (num_neurons,)\n\n        # Learnable embedding table: (num_neurons, embedding_dim)\n        neuron_embeddings_table = nn.Embed(\n            num_embeddings=num_neurons,\n            features=self.embedding_dim\n        )(neuron_indices) # (num_neurons, embedding_dim)\n\n        # Expand neuron embeddings to match the batch and input_horizon dimensions of x\n        # Resulting shape: (batch_size, input_horizon, num_neurons, embedding_dim)\n        expanded_embeddings = jnp.tile(neuron_embeddings_table[None, None, :, :], (batch_size, input_horizon, 1, 1))\n\n        # 2. Expand original input x to (batch_size, input_horizon, num_neurons, 1)\n        x_expanded = x[..., None] # Add a feature dimension of size 1\n\n        # 3. Concatenate expanded x with expanded_embeddings\n        # Resulting shape: (batch_size, input_horizon, num_neurons, 1 + embedding_dim)\n        x_combined_features = jnp.concatenate([x_expanded, expanded_embeddings], axis=-1)\n\n        # 4. Reshape for shared MLP\n        # From (batch_size, input_horizon, num_neurons, 1 + embedding_dim)\n        # to (batch_size * num_neurons, input_horizon * (1 + embedding_dim))\n        input_dim_mlp = input_horizon * (1 + self.embedding_dim)\n        x_reshaped_for_mlp = jnp.reshape(\n            x_combined_features,\n            (batch_size * num_neurons, input_dim_mlp)\n        )\n\n        # 5. Apply shared MLP for temporal forecasting\n        # Layer 1 with BatchNorm and Dropout\n        mlp_output = nn.Dense(self.mlp_hidden_size)(x_reshaped_for_mlp)\n        mlp_output = nn.BatchNorm(use_running_average=not training)(mlp_output)\n        mlp_output = nn.relu(mlp_output)\n        mlp_output = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(mlp_output)\n\n        # Output layer\n        mlp_output = nn.Dense(self.output_horizon)(mlp_output)\n\n        # Reshape back to (batch_size, output_horizon, num_neurons)\n        # From (batch_size * num_neurons, output_horizon) to (batch_size, num_neurons, output_horizon)\n        final_output = jnp.reshape(mlp_output, (batch_size, num_neurons, self.output_horizon))\n        # Transpose to (batch_size, 32, num_neurons)\n        final_output = jnp.transpose(final_output, (0, 2, 1))\n\n        return final_output\n\n\nclass LearnedEmbeddingMLPWrapper:\n    \"\"\"\n    Wrapper to make Flax model compatible with the training system.\n    Handles BatchNorm state and Dropout RNG requirements.\n    \"\"\"\n\n    def __init__(self, hparams):\n        self.model = LearnedEmbeddingMLP(\n            embedding_dim=hparams['embedding_dim'],\n            mlp_hidden_size=hparams['mlp_hidden_size'],\n            dropout_rate=hparams['dropout_rate']\n        )\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params,\n                x,\n                training=training,\n                mutable=mutable,\n                rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params,\n                x,\n                training=training,\n                rngs=rngs if rngs is not None else {}\n            )\n\n\ndef create_network(hparams: Dict[str, Any]):\n    \"\"\"Create and return the learned embedding enhanced shared-neuron MLP.\"\"\"\n    return LearnedEmbeddingMLPWrapper(hparams)\n",
