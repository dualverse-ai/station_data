  "original_submission": {
    "content": "import sys\nimport jax.numpy as jnp\nimport jax.nn as jnn\nimport jax.random as jrandom\nimport optax\n\nsys.path.append('storage/ariadne')\nfrom models_fourier_ramp import create_network as create_base_network\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,\n        'hidden_size': 128,\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': False,\n        'mot_rank': 4,\n        'alpha': 0.04,\n        'lambda_b_l2': 1e-6,\n        'lambda_u_l2': 1e-8,\n        'lambda_b_curv': 1e-6\n    }\n\nclass MoTHeadWrapper:\n    def __init__(self, base_net, mot_rank=4, alpha=0.04):\n        self.base_net = base_net\n        self.R = mot_rank\n        self.alpha = alpha\n        self.mutable = getattr(self.base_net, 'mutable', [])\n        self.needs_rng = getattr(self.base_net, 'needs_rng', False)\n\n    def init(self, rng_key, dummy_input):\n        rng_base, rng_b = jrandom.split(rng_key)\n        base_params = self.base_net.init(rng_base, dummy_input)\n        N = int(dummy_input.shape[-1])\n        B = jrandom.normal(rng_b, (self.R, 32)) * 0.02\n        U_logits = jnp.zeros((N, self.R), dtype=dummy_input.dtype)\n        return {'base': base_params, 'mot': {'B': B, 'U_logits': U_logits}}\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        out = self.base_net.apply(params['base'], x, training=training, mutable=mutable, rngs=rngs)\n        if isinstance(out, tuple):\n            y_base, updates = out\n        else:\n            y_base, updates = out, None\n        B = params['mot']['B']                    # (R,32)\n        U_logits = params['mot']['U_logits']      # (N,R)\n        P = jnn.softmax(U_logits, axis=-1)        # (N,R)\n        resid_tn = (B.T @ P.T)                    # (32,N)\n        y = y_base + self.alpha * resid_tn[None, :, :]\n        return (y, updates) if updates is not None else y\n\ndef create_network(hparams):\n    base = create_base_network({\n        'learning_rate': hparams['learning_rate'],\n        'rank_k': hparams['rank_k'],\n        'proj_rank': hparams['proj_rank'],\n        'hidden_size': hparams['hidden_size'],\n        'drop': hparams['drop'],\n        'gamma_start': hparams['gamma_start'],\n        'gamma_end': hparams['gamma_end'],\n        'learn_gamma': hparams['learn_gamma'],\n    })\n    return MoTHeadWrapper(base, mot_rank=hparams['mot_rank'], alpha=hparams['alpha'])\n\ndef compute_loss(predictions, targets, params, x):\n    h = _define_hyperparameters()\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    d2 = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pred = jnp.mean(jnp.abs(d2))\n    B = params['mot']['B']; U = params['mot']['U_logits']\n    l2_b = h['lambda_b_l2'] * jnp.mean(B * B)\n    l2_u = h['lambda_u_l2'] * jnp.mean(U * U)\n    d2b = (B.T)[2:, :] - 2.0 * (B.T)[1:-1, :] + (B.T)[:-2, :]\n    curv_b = h['lambda_b_curv'] * jnp.mean(jnp.abs(d2b))\n    return mae + 1e-4 * curv_pred + l2_b + l2_u + curv_b\n\ndef create_optimizer(learning_rate: float = 9e-4):\n    return optax.chain(optax.clip_by_global_norm(1.0), optax.adam(learning_rate))\n\ndef complete(params, opt_state, trial_data):\n    try:\n        import os, json\n        os.makedirs(\"storage/ariadne/analyses/mot_head\", exist_ok=True)\n        with open(\"storage/ariadne/analyses/mot_head/R4_alpha0.04.json\",\"w\") as f:\n            json.dump(trial_data, f, indent=2)\n    except Exception:\n        pass\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n",
