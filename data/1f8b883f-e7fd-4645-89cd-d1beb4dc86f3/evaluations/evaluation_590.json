  "abstract": "This is a required fifth experiment to support a future publication on the Hypernetwork-Generated Biases architecture. My previous run (ID 578) with `embedding_dim=16` was successful. This experiment is a direct ablation, reducing the `embedding_dim` to 8. This tests the sensitivity of the hypernetwork's performance to the capacity of its neuron embeddings and provides a crucial data point for my Stagnation Protocol report.",
  "submitted_tick": 327,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax; import flax.linen as nn; import jax.numpy as jnp; import optax; from jax import random\ndef _define_hyperparameters():\n    return {'learning_rate': 0.001, 'embedding_dim': 8, 'hidden_size': 64, 'num_neurons': 71721}\nclass HyperBias(nn.Module):\n    output_dim: int\n    @nn.compact\n    def __call__(self, x):\n        h = nn.Dense(32)(x); h = nn.relu(h); return nn.Dense(self.output_dim)(h)\nclass HyperMLP(nn.Module):\n    hidden_size: int; output_horizon: int; dropout_rate: float; num_neurons: int; embedding_dim: int\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        neuron_indices = jnp.arange(self.num_neurons)\n        neuron_embeddings = nn.Embed(num_embeddings=self.num_neurons, features=self.embedding_dim)(neuron_indices)\n        tiled_embeddings = jnp.tile(neuron_embeddings, (B, 1))\n        x_flat = x.transpose((0, 2, 1)).reshape(B * N, T_in)\n        bias1 = HyperBias(self.hidden_size, name=\"hyper_bias_1\")(tiled_embeddings)\n        h = nn.Dense(self.hidden_size, use_bias=False)(x_flat) + bias1\n        h = nn.BatchNorm(use_running_average=not training)(h)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(h)\n        output_flat = nn.Dense(self.output_horizon)(h)\n        output = output_flat.reshape(B, N, self.output_horizon).transpose((0, 2, 1))\n        return output\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = HyperMLP(hidden_size=hparams['hidden_size'], output_horizon=32, dropout_rate=0.1, num_neurons=hparams['num_neurons'], embedding_dim=hparams['embedding_dim'])\n        self.mutable = ['batch_stats']; self.needs_rng = True\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        return self.model.init({'params': rng_params, 'dropout': rng_dropout}, dummy_input, training=True)\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable:\n            output, updates = self.model.apply(params, x, training=training, mutable=mutable, rngs=rngs or {})\n            return output, updates\n        return self.model.apply(params, x, training=training, rngs=rngs or {})\ndef create_network(hparams): return ModelWrapper(hparams)\ndef compute_loss(predictions, targets, params, x): return jnp.mean(jnp.abs(predictions - targets))\ndef create_optimizer(learning_rate: float): return optax.adam(learning_rate=learning_rate)\n",
