  "abstract": "We extend the shared-MLP baseline by adding lightweight per-neuron embeddings and a batchwise population-context module that produces horizon-wise scale/shift gates. Per-neuron embeddings capture heterogeneity without breaking weight sharing, while the context gate provides input-adaptive temporal scaling beyond static \u03b3[t]. The model remains lightweight (embed_dim=8, H=160) and uses Adam with gradient clipping. Loss is MAE.",
  "submitted_tick": 299,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport jax.numpy as jnp\nfrom flax import linen as nn\nimport optax\n\nN_NEURONS = 71721\n\n# ---------------------------\n# Hyperparameters\n# ---------------------------\ndef _define_hyperparameters():\n    return {\n        \"learning_rate\": 9e-4,\n        \"hidden_size\": 160,\n        \"embed_dim\": 8,\n        \"context_hidden\": 64,\n        \"gating_scale\": 0.10,  # limits adaptive temporal scaling amplitude\n        \"shift_scale\": 0.02    # limits adaptive temporal shift amplitude\n    }\n\nclass NCSForecaster(nn.Module):\n    hidden_size: int = 160\n    embed_dim: int = 8\n    context_hidden: int = 64\n    gating_scale: float = 0.10\n    shift_scale: float = 0.02\n\n    def setup(self):\n        # Per-neuron learnable embeddings (captures neuron-specific dynamics)\n        self.neuron_embed = self.param(\n            \"neuron_embed\",\n            nn.initializers.normal(stddev=0.02),\n            (N_NEURONS, self.embed_dim),\n        )\n        # Per-neuron predictor (shared across neurons, conditioned on neuron_embed)\n        self.ln = nn.LayerNorm()  # normalize along feature axis\n        self.dense1 = nn.Dense(self.hidden_size)\n        self.dense2 = nn.Dense(32)\n\n        # Population-context module: aggregates across neurons, outputs horizon-wise gates\n        self.ctx_dense1 = nn.Dense(self.context_hidden)\n        self.ctx_dense2 = nn.Dense(self.context_hidden)\n        self.ctx_gate = nn.Dense(32)   # scale per horizon\n        self.ctx_shift = nn.Dense(32)  # shift per horizon\n\n    def __call__(self, x, training: bool = False):\n        # x: (batch, 4, N_NEURONS); output: (batch, 32, N_NEURONS)\n        B, T, N = x.shape\n        assert T == 4 and N == N_NEURONS, \"Input must be (batch, 4, 71721)\"\n\n        # Per-neuron path\n        xn = jnp.swapaxes(x, 1, 2)  # (B, N, 4)\n        # Broadcast embeddings across batch\n        E = jnp.broadcast_to(self.neuron_embed[None, :, :], (B, N, self.embed_dim))\n        feats = jnp.concatenate([xn, E], axis=-1)  # (B, N, 4 + embed_dim)\n        feats = self.ln(feats)  # normalize features per neuron\n\n        feats2d = feats.reshape(-1, feats.shape[-1])  # (B*N, 4+E)\n        h = nn.gelu(self.dense1(feats2d))\n        y_base = self.dense2(h).reshape(B, N, 32)     # (B, N, 32)\n\n        # Population context (cheap cross-neuron info) -> temporal gates\n        x_mean = x.mean(axis=-1)                  # (B, 4)\n        x_std = x.std(axis=-1) + 1e-6             # (B, 4)\n        context = jnp.concatenate([x_mean, x_std], axis=-1)  # (B, 8)\n\n        ch = nn.gelu(self.ctx_dense1(context))\n        ch = nn.gelu(self.ctx_dense2(ch))\n        g_raw = self.ctx_gate(ch)    # (B, 32)\n        s_raw = self.ctx_shift(ch)   # (B, 32)\n\n        # Bounded gates to preserve stability and avoid degenerate scaling\n        g = 1.0 + self.gating_scale * jnp.tanh(g_raw)  # (B, 32)\n        s = self.shift_scale * jnp.tanh(s_raw)         # (B, 32)\n\n        y = y_base * g[:, None, :] + s[:, None, :]     # (B, N, 32)\n        y = jnp.swapaxes(y, 1, 2)                      # (B, 32, N)\n        return y\n\nclass ModelWrapper:\n    def __init__(self, hidden_size=160, embed_dim=8, context_hidden=64, gating_scale=0.10, shift_scale=0.02):\n        self.model = NCSForecaster(\n            hidden_size=hidden_size,\n            embed_dim=embed_dim,\n            context_hidden=context_hidden,\n            gating_scale=gating_scale,\n            shift_scale=shift_scale,\n        )\n        # No BatchNorm/Dropout; no mutable state or RNG required\n        self.mutable = []\n        self.needs_rng = False\n\n    def init(self, rng_key, dummy_input):\n        variables = self.model.init(rng_key, dummy_input, training=True)\n        return variables[\"params\"]\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply({\"params\": params}, x, training=training)\n\ndef create_network(hparams):\n    return ModelWrapper(\n        hidden_size=hparams.get(\"hidden_size\", 160),\n        embed_dim=hparams.get(\"embed_dim\", 8),\n        context_hidden=hparams.get(\"context_hidden\", 64),\n        gating_scale=hparams.get(\"gating_scale\", 0.10),\n        shift_scale=hparams.get(\"shift_scale\", 0.02),\n    )\n\ndef compute_loss(predictions, targets, params, x):\n    # Default MAE; keeping objective aligned with evaluation metric\n    return jnp.mean(jnp.abs(predictions - targets))\n\ndef create_optimizer(learning_rate: float = 9e-4):\n    # Gradient clipping + Adam\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate),\n    )\n\n# Reproducibility and batching\nBASE_SEED = 3407\nBATCH_SIZE = 8\n",
