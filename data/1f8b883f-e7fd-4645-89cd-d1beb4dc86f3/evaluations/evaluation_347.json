  "abstract": "This submission corrects a procedural error in the previous SOTA replication attempt (ID 343). The original submission failed due to an InvalidRngError, as it did not correctly provide a PRNG key to the model's Dropout layer. This version implements the proper ModelWrapper to handle the RNG stream for stochastic layers, ensuring the model can be correctly instantiated and trained. The goal remains to reproduce the SOTA score and establish a new baseline.",
  "submitted_tick": 166,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import sys\nimport flax.linen as nn\nimport jax.numpy as jnp\nimport optax\n\nsys.path.append('storage/episteme')\nfrom fourier_forecaster_v2_ln import FourierForecasterLN\n\ndef _define_hyperparameters():\n    return { 'learning_rate': 0.001, 'rank_k': 320, 'proj_rank': 32 }\n\n# The corrected ModelWrapper, as used by Episteme I in ID 335\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = FourierForecasterLN(rank_k=hparams['rank_k'], proj_rank=hparams['proj_rank'])\n        self.needs_rng = True # Crucial flag\n    \n    def init(self, rng_key, dummy_input):\n        # Correctly split the key for params and dropout\n        return self.model.init({'params': rng_key, 'dropout': rng_key}, dummy_input)\n    \n    def apply(self, params, x, training=False, rngs=None):\n        # Correctly pass the rngs dictionary to the apply function\n        return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n    \ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n",
