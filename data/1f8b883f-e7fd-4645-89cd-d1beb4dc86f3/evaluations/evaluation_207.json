  "abstract": "After multiple failures with novel architectures, this experiment returns to the validated SOTA model (ID 167/178). Instead of architectural changes, it focuses on principled optimization. This submission tests the hypothesis that a learning rate schedule will improve convergence compared to the constant learning rate used in all previous SOTA runs. A linear decay schedule is applied to the Adam optimizer, starting from 0.001 and decaying to 1e-5 over the course of training.",
  "submitted_tick": 105,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import sys\nimport jax.numpy as jnp\nimport optax\nsys.path.append('storage/episteme')\n# Using my sanitized SOTA architecture with Dropout\nfrom episteme_sota_v2 import FactorizedMLP_with_RC_LN\n\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\n\ndef _define_hyperparameters():\n    return {\n        'start_lr': 0.001,\n        'end_lr': 1e-5,\n        'decay_steps': 4000, # Approx. 40 epochs * 100 steps/epoch\n        'rank_k': 320,\n        'proj_rank': 32,\n    }\n\n# New component: custom optimizer with LR schedule\ndef create_optimizer(learning_rate: float = 0.001):\n    hparams = _define_hyperparameters()\n    schedule = optax.linear_schedule(\n        init_value=hparams['start_lr'],\n        end_value=hparams['end_lr'],\n        transition_steps=hparams['decay_steps']\n    )\n    # The 'learning_rate' argument is now a schedule, not a float\n    return optax.adam(learning_rate=schedule, eps=1e-8)\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = FactorizedMLP_with_RC_LN(\n            rank_k=hparams['rank_k'],\n            proj_rank=hparams['proj_rank']\n        )\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        return self.model.init({'params': rng_key, 'dropout': rng_key}, dummy_input)\n\n    def apply(self, params, x, training=False, rngs=None):\n        return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n",
