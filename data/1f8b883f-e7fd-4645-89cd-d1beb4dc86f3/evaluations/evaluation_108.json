  "abstract": "This submission is a second attempt at a low-rank factorization model, learning from the failure of ID 97. The naive MLP in the latent space is replaced with a more powerful 1D CNN to better capture temporal dynamics. This model serves as a necessary stepping stone. The hypothesis is that a more capable temporal model in the latent space is required to make this architecture viable, before attempting to integrate more complex ideas like Mixture of Experts.",
  "submitted_tick": 57,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\n\nNUM_NEURONS = 71721\nINPUT_HORIZON = 4\nOUTPUT_HORIZON = 32\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'latent_dim': 320,\n        'cnn_features': 256,\n        'cnn_kernel_size': 2,\n        'mlp_hidden_dim': 512,\n    }\n\nclass LatentDynamicsModel(nn.Module):\n    latent_dim: int\n    cnn_features: int\n    cnn_kernel_size: int\n    mlp_hidden_dim: int\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        # x shape: (batch, 4, 71721)\n        \n        # Encoder: Project from neuron space to latent space\n        latent_x = nn.Dense(features=self.latent_dim, name=\"encoder\")(x)\n\n        # Dynamics Model: Use a 1D CNN in the latent space\n        # Input to CNN needs to be (batch, seq_len, features)\n        # current latent_x is (batch, 4, 320), which is correct\n        y = nn.Conv(features=self.cnn_features, kernel_size=(self.cnn_kernel_size,))(latent_x)\n        y = nn.relu(y)\n        \n        # Flatten and project to the future latent sequence\n        y = y.reshape((y.shape[0], -1))\n        y = nn.Dense(features=self.mlp_hidden_dim)(y)\n        y = nn.relu(y)\n        latent_y_flat = nn.Dense(features=OUTPUT_HORIZON * self.latent_dim)(y)\n        latent_y = latent_y_flat.reshape((-1, OUTPUT_HORIZON, self.latent_dim))\n\n        # Decoder: Project from latent space back to neuron space\n        output = nn.Dense(features=NUM_NEURONS, name=\"decoder\")(latent_y)\n        \n        return output\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = LatentDynamicsModel(\n            latent_dim=hparams.get('latent_dim'),\n            cnn_features=hparams.get('cnn_features'),\n            cnn_kernel_size=hparams.get('cnn_kernel_size'),\n            mlp_hidden_dim=hparams.get('mlp_hidden_dim')\n        )\n        self.mutable = []\n        self.needs_rng = False\n\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x)\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n",
