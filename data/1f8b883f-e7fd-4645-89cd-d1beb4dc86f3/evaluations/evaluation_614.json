  "original_submission": {
    "content": "import sys\nimport jax\nimport jax.numpy as jnp\nimport jax.nn as jnn\nimport jax.random as jrandom\nimport optax\n\nsys.path.append('storage/ariadne')\nfrom models_fourier_ramp import create_network as create_base_network\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,\n        'hidden_size': 160,\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': False,\n        'mot_rank': 4,\n        'alpha': 0.06,\n        'ctx_hidden': 64,\n        'lambda_b_curv': 1e-6,\n        'lambda_u_l2': 1e-8,\n        'lambda_mlp_l2': 1e-7\n    }\n\nclass DynamicMoTWrapper:\n    def __init__(self, base_net, mot_rank=4, alpha=0.06, ctx_hidden=64):\n        self.base_net = base_net\n        self.R = mot_rank\n        self.alpha = alpha\n        self.Hc = ctx_hidden\n        self.mutable = getattr(self.base_net, 'mutable', [])\n        self.needs_rng = getattr(self.base_net, 'needs_rng', False)\n\n    def init(self, rng_key, dummy_input):\n        rng_base, rng_w1, rng_w2, rng_u = jrandom.split(rng_key, 4)\n        base_params = self.base_net.init(rng_base, dummy_input)\n        N = int(dummy_input.shape[-1])\n        W1 = jrandom.normal(rng_w1, (8, self.Hc)) * 0.02\n        b1 = jnp.zeros((self.Hc,), dtype=dummy_input.dtype)\n        W2 = jrandom.normal(rng_w2, (self.Hc, self.R * 32)) * 0.02\n        b2 = jnp.zeros((self.R * 32,), dtype=dummy_input.dtype)\n        U_logits = jnp.zeros((N, self.R), dtype=dummy_input.dtype)\n        return {'base': base_params, 'mot_dyn': {'W1': W1, 'b1': b1, 'W2': W2, 'b2': b2, 'U_logits': U_logits}}\n\n    def _make_basis(self, params_dyn, x):\n        x_mean = x.mean(axis=-1); x_std = x.std(axis=-1) + 1e-6\n        ctx = jnp.concatenate([x_mean, x_std], axis=-1)  # (B,8)\n        h = jnn.gelu(ctx @ params_dyn['W1'] + params_dyn['b1'])\n        B_raw = h @ params_dyn['W2'] + params_dyn['b2']\n        return jnp.tanh(B_raw).reshape(x.shape[0], self.R, 32)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        out = self.base_net.apply(params['base'], x, training=training, mutable=mutable, rngs=rngs)\n        if isinstance(out, tuple):\n            y_base, updates = out\n        else:\n            y_base, updates = out, None\n        dyn = params['mot_dyn']\n        B = self._make_basis(dyn, x)               # (B,R,32)\n        P = jnn.softmax(dyn['U_logits'], axis=-1)  # (N,R)\n        Bt = jnp.swapaxes(B, 1, 2)                 # (B,32,R)\n        resid = jnp.matmul(Bt, jnp.swapaxes(P, 0, 1))  # (B,32,N)\n        y = y_base + self.alpha * resid\n        return (y, updates) if updates is not None else y\n\ndef create_network(hparams):\n    base = create_base_network({\n        'learning_rate': hparams['learning_rate'],\n        'rank_k': hparams['rank_k'],\n        'proj_rank': hparams['proj_rank'],\n        'hidden_size': hparams['hidden_size'],\n        'drop': hparams['drop'],\n        'gamma_start': hparams['gamma_start'],\n        'gamma_end': hparams['gamma_end'],\n        'learn_gamma': hparams['learn_gamma'],\n    })\n    return DynamicMoTWrapper(base, mot_rank=hparams['mot_rank'], alpha=hparams['alpha'], ctx_hidden=hparams['ctx_hidden'])\n\ndef compute_loss(predictions, targets, params, x):\n    h = _define_hyperparameters()\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    d2 = predictions[:, 2:, :] - 2*predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pred = jnp.mean(jnp.abs(d2))\n    dyn = params['mot_dyn']\n    l2_u = h['lambda_u_l2'] * jnp.mean(dyn['U_logits'] * dyn['U_logits'])\n    l2_mlp = h['lambda_mlp_l2'] * (jnp.mean(dyn['W1']*dyn['W1']) + jnp.mean(dyn['W2']*dyn['W2']))\n    # Basis smoothness term\n    x_mean = x.mean(-1); x_std = x.std(-1) + 1e-6\n    ctx = jnp.concatenate([x_mean, x_std], -1)\n    h1 = jnn.gelu(ctx @ dyn['W1'] + dyn['b1'])\n    B = jnp.tanh(h1 @ dyn['W2'] + dyn['b2']).reshape(x.shape[0], h['mot_rank'], 32)\n    Bt = jnp.swapaxes(B, 1, 2)\n    d2b = Bt[:, 2:, :] - 2.0 * Bt[:, 1:-1, :] + Bt[:, :-2, :]\n    curv_b = h['lambda_b_curv'] * jnp.mean(jnp.abs(d2b))\n    return mae + 1e-4 * curv_pred + l2_u + l2_mlp + curv_b\n\ndef create_optimizer(learning_rate: float = 9e-4):\n    return optax.chain(optax.clip_by_global_norm(1.0), optax.adam(learning_rate))\n\ndef complete(params, opt_state, trial_data):\n    try:\n        import os, json\n        os.makedirs(\"storage/ariadne/analyses/mot_head_dynamic\", exist_ok=True)\n        with open(\"storage/ariadne/analyses/mot_head_dynamic/H160_R4_a0.06.json\", \"w\") as f:\n            json.dump(trial_data, f, indent=2)\n    except Exception:\n        pass\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n",
