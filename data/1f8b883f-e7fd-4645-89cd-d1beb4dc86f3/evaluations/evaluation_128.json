  "original_submission": {
    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport jax\nimport jax.numpy as jnp\nimport flax.linen as nn\nimport optax\n\nfrom models import ResidualCopyHead\nfrom losses import mae_with_temporal_curvature\n\ndef _logit(p):\n    p = jnp.clip(p, 1e-6, 1 - 1e-6)\n    return jnp.log(p) - jnp.log(1 - p)\n\nclass Osc2CtxAdaptiveFactorizedL_LN(nn.Module):\n    rank_k: int = 320\n    proj_rank: int = 32\n    hidden_size: int = 96\n    output_horizon: int = 32\n    normalize_u: bool = True\n    a_max: float = 0.993\n    gamma_start: float = 0.25\n    gamma_end: float = 0.99\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        k = self.rank_k\n        p = self.proj_rank\n        T = self.output_horizon\n\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        if self.normalize_u:\n            U = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n\n        xU = jnp.einsum('btn,np->btp', x, U)\n        factors_in = jnp.einsum('btp,kp->btk', xU, V)\n\n        f_flat = factors_in.reshape(B * k, T_in)\n        f0 = nn.Dense(1)(f_flat).reshape(B, k)\n        f1 = nn.Dense(1)(f_flat).reshape(B, k)\n\n        r_raw = self.param('r_raw', nn.initializers.zeros, (k,))\n        w_raw = self.param('w_raw', nn.initializers.zeros, (k,))\n        r = self.a_max * nn.sigmoid(r_raw)\n        w = jnp.pi * nn.sigmoid(w_raw)\n        a = r * jnp.cos(w)\n        b = r * r\n\n        def step(carry, _):\n            y_prev, y_prev2 = carry\n            y_t = 2.0 * a[None, :] * y_prev - b[None, :] * y_prev2\n            return (y_t, y_prev), y_t\n\n        carry_init = (f1, f0)\n        _, ys2 = jax.lax.scan(step, carry_init, xs=None, length=T - 2)\n        y0 = f0[None, :, :]\n        y1 = f1[None, :, :]\n        f_ssm = jnp.concatenate([y0, y1, ys2], axis=0).transpose(1, 0, 2)\n\n        h = nn.Dense(self.hidden_size)(f_flat); h = nn.gelu(h)\n        f_inc = nn.Dense(T)(h).reshape(B, k, T).transpose(0, 2, 1)\n        f_out = f_ssm + f_inc\n\n        c = jnp.mean(factors_in, axis=1)\n        def alpha_init(key, shape, dtype=jnp.float32):\n            TT, K = shape\n            t = jnp.linspace(0.0, 1.0, TT, dtype=dtype)\n            base = 0.5 + 0.35 * t\n            base = jnp.tile(base[:, None], (1, K))\n            return _logit(base).astype(dtype)\n        alpha = self.param('s_alpha', alpha_init, (T, k))\n        beta = self.param('s_beta', nn.initializers.zeros, (k,))\n        logits = alpha[None, :, :] + (beta[None, None, :] * c[:, None, :])\n        S = nn.sigmoid(logits)\n        f_out = f_out * S\n\n        # Flax API: reduction_axes\n        f_out = nn.LayerNorm(reduction_axes=-1, use_bias=False, use_scale=True)(f_out)\n\n        z = jnp.einsum('btk,kp->btp', f_out, V)\n        y_factor = jnp.einsum('btp,np->btn', z, U)\n\n        def gamma_sched_init(key, shape, dtype=jnp.float32):\n            t = jnp.linspace(0.0, 1.0, shape[0], dtype=dtype)\n            g = self.gamma_start + (self.gamma_end - self.gamma_start) * t\n            return _logit(g).astype(dtype)\n        gamma_raw = self.param('gamma_raw', gamma_sched_init, (T,))\n        gamma = nn.sigmoid(gamma_raw)[None, :, None]\n        y_factor = gamma * y_factor\n\n        y_copy = ResidualCopyHead(output_horizon=T)(x)\n        return y_copy + y_factor\n\nBASE_SEED = 42\nBATCH_SIZE = 8\nV_ORTHO_LAM = 1e-5\nU_ORTHO_LAM = 5e-7  # tiny; applied to normalized U used in forward\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,\n        'proj_rank': 32,\n        'hidden_size': 96,\n        'normalize_u': True,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'a_max': 0.993\n    }\n\nclass Wrapper:\n    def __init__(self, **kwargs):\n        self.model = Osc2CtxAdaptiveFactorizedL_LN(**kwargs)\n        self.needs_rng = False\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x, training=training)\n\ndef create_network(hparams):\n    return Wrapper(\n        rank_k=int(hparams.get('rank_k', 320)),\n        proj_rank=int(hparams.get('proj_rank', 32)),\n        hidden_size=int(hparams.get('hidden_size', 96)),\n        normalize_u=bool(hparams.get('normalize_u', True)),\n        gamma_start=float(hparams.get('gamma_start', 0.25)),\n        gamma_end=float(hparams.get('gamma_end', 0.99)),\n        a_max=float(hparams.get('a_max', 0.993))\n    )\n\ndef _get_from_tree(tree, key):\n    try:\n        if key in tree:\n            return tree[key]\n    except Exception:\n        pass\n    if isinstance(tree, dict) and 'params' in tree:\n        return _get_from_tree(tree['params'], key)\n    raise KeyError(f\"{key} not found\")\n\ndef compute_loss(predictions, targets, params, x):\n    base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n    # V penalty\n    try:\n        V = _get_from_tree(params, 'V')\n        GV = V.T @ V\n        IV = jnp.eye(GV.shape[0], dtype=GV.dtype)\n        v_ortho = jnp.sum((GV - IV) ** 2)\n    except Exception:\n        v_ortho = 0.0\n    # U penalty on normalized U (as used in forward)\n    try:\n        U = _get_from_tree(params, 'U')\n        U_norm = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        GU = U_norm.T @ U_norm\n        IU = jnp.eye(GU.shape[0], dtype=GU.dtype)\n        u_ortho = jnp.sum((GU - IU) ** 2)\n    except Exception:\n        u_ortho = 0.0\n    return base + V_ORTHO_LAM * v_ortho + U_ORTHO_LAM * u_ortho\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate, eps=1e-8)\n    )\n",
