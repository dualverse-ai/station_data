  "cpu_only": false,
  "original_submission": {
    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport jax\nimport jax.numpy as jnp\nimport flax.linen as nn\nimport optax\nfrom models import ResidualCopyHead\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n\ndef _logit(p):\n    p = jnp.clip(p, 1e-6, 1 - 1e-6)\n    return jnp.log(p) - jnp.log(1 - p)\n\nclass Osc2FactorizedNoInc(nn.Module):\n    rank_k: int = 256\n    proj_rank: int = 32\n    output_horizon: int = 32\n    normalize_u: bool = True\n    a_max: float = 0.995\n    gamma_start: float = 0.25\n    gamma_end: float = 0.98\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        # x: (B,4,N)\n        B, T_in, N = x.shape\n        k = self.rank_k\n        p = self.proj_rank\n\n        # Factorized loadings\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        if self.normalize_u:\n            U = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n\n        # Input to factor space via factorized L\n        xU = jnp.einsum('btn,np->btp', x, U)            # (B,4,p)\n        factors_in = jnp.einsum('btp,pk->btk', xU, V.T) # (B,4,k)\n\n        # Initial states per factor from inputs\n        f_flat = factors_in.reshape(B * k, T_in)        # (B*k,4)\n        f0 = nn.Dense(1, use_bias=True)(f_flat).reshape(B, k)  # (B,k)\n        f1 = nn.Dense(1, use_bias=True)(f_flat).reshape(B, k)  # (B,k)\n\n        # Oscillatory parameters\n        r_raw = self.param('r_raw', nn.initializers.zeros, (k,))\n        w_raw = self.param('w_raw', nn.initializers.zeros, (k,))\n        r = self.a_max * nn.sigmoid(r_raw)\n        w = jnp.pi * nn.sigmoid(w_raw)\n        a = r * jnp.cos(w)\n        b = r * r\n\n        # 2nd-order recurrence\n        def step(carry, _):\n            y_prev, y_prev2 = carry\n            y_t = 2.0 * a[None, :] * y_prev - b[None, :] * y_prev2\n            return (y_t, y_prev), y_t\n\n        T = self.output_horizon\n        carry_init = (f1, f0)\n        _, ys2 = jax.lax.scan(step, carry_init, xs=None, length=T - 2)  # (T-2,B,k)\n        y0 = f0[None, :, :]\n        y1 = f1[None, :, :]\n        f_out = jnp.concatenate([y0, y1, ys2], axis=0).transpose(1, 0, 2)  # (B,T,k)\n\n        # Input-adaptive per-factor temporal gate S[b,t,k]\n        c = jnp.mean(factors_in, axis=1)  # (B,k)\n        def alpha_init(key, shape, dtype=jnp.float32):\n            TT, K = shape\n            t = jnp.linspace(0.0, 1.0, TT, dtype=dtype)\n            base = 0.5 + 0.35 * t\n            base = jnp.tile(base[:, None], (1, K))\n            return _logit(base).astype(dtype)\n        alpha = self.param('s_alpha', alpha_init, (T, k))\n        beta = self.param('s_beta', nn.initializers.zeros, (k,))\n        logits = alpha[None, :, :] + (beta[None, None, :] * c[:, None, :])\n        S = nn.sigmoid(logits)\n        f_out = f_out * S  # (B,T,k)\n\n        # Project back to neurons using factorized L: (B,T,k)->(B,T,p)->(B,T,N)\n        z = jnp.einsum('btk,kp->btp', f_out, V)\n        y_factor = jnp.einsum('btp,np->btn', z, U)\n\n        # Horizon-wise gamma\n        def gamma_sched_init(key, shape, dtype=jnp.float32):\n            t = jnp.linspace(0.0, 1.0, shape[0], dtype=dtype)\n            g = self.gamma_start + (self.gamma_end - self.gamma_start) * t\n            return _logit(g).astype(dtype)\n        gamma_raw = self.param('gamma_raw', gamma_sched_init, (T,))\n        gamma = nn.sigmoid(gamma_raw)[None, :, None]\n        y_factor = gamma * y_factor\n\n        # Residual copy head\n        y_copy = ResidualCopyHead(output_horizon=T)(x)\n\n        return y_copy + y_factor\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 256,\n        'proj_rank': 32,\n        'normalize_u': True,\n        'gamma_start': 0.25,\n        'gamma_end': 0.98\n    }\n\nclass Wrapper:\n    def __init__(self, rank_k=256, proj_rank=32, normalize_u=True, gamma_start=0.25, gamma_end=0.98):\n        self.model = Osc2FactorizedNoInc(\n            rank_k=rank_k,\n            proj_rank=proj_rank,\n            normalize_u=normalize_u,\n            gamma_start=gamma_start,\n            gamma_end=gamma_end\n        )\n        self.needs_rng = False\n\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x, training=training)\n\ndef create_network(hparams):\n    return Wrapper(\n        rank_k=int(hparams.get('rank_k', 256)),\n        proj_rank=int(hparams.get('proj_rank', 32)),\n        normalize_u=bool(hparams.get('normalize_u', True)),\n        gamma_start=float(hparams.get('gamma_start', 0.25)),\n        gamma_end=float(hparams.get('gamma_end', 0.98))\n    )\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate, eps=1e-8)\n    )\n",
