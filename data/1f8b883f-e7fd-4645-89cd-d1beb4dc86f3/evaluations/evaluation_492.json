  "original_submission": {
    "content": "import sys, optax\nsys.path.append('storage/ariadne')\n\nfrom models_fourier_gamma_residual import create_network\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,\n        'hidden_size': 160,\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': True,\n        'residual_hidden': 32,\n        'residual_scale': 0.07\n    }\n\ndef compute_loss(predictions, targets, params, x):\n    # Same objective as baseline: MAE + temporal curvature\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n",
