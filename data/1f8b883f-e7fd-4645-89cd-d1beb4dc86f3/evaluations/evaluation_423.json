  "cpu_only": false,
  "original_submission": {
    "content": "import flax.linen as nn\nimport jax\nimport jax.numpy as jnp\nimport optax\n\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\n\nclass ResidualCopyHead(nn.Module):\n    @nn.compact\n    def __call__(self, x):\n        num_neurons = x.shape[2]\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        residual = nn.Dense(32)(x_flat)\n        return residual.reshape(x.shape[0], num_neurons, 32).transpose(0, 2, 1)\n\nclass DeltaFourierForecaster(nn.Module):\n    rank_k: int\n    proj_rank: int\n    \n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U_eff = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        factors_in = jnp.einsum('btn,np->btp', x, U_eff) @ V.T\n        \n        fft_in = jnp.fft.rfft(factors_in, axis=1)\n        fft_weights = self.param('fft_weights', nn.initializers.ones, (fft_in.shape[1],), jnp.complex64)\n        fft_out = fft_in * fft_weights[None, :, None]\n        factors_out_fourier = jnp.fft.irfft(fft_out, n=32, axis=1)\n        delta_y_fourier = (nn.LayerNorm()(factors_out_fourier) @ V) @ U_eff.T\n        \n        delta_y_copy = ResidualCopyHead()(x)\n        \n        # The model outputs deltas\n        delta_y_hat = delta_y_fourier + delta_y_copy\n\n        # Integrate deltas to get final prediction\n        y_hat = jnp.cumsum(delta_y_hat, axis=1) + x[:, -1:, :]\n        \n        return y_hat\n\ndef _define_hyperparameters():\n    return { 'learning_rate': 0.001, 'rank_k': 320, 'proj_rank': 32 }\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(optax.clip_by_global_norm(1.0), optax.adam(learning_rate=learning_rate))\n\ndef create_network(hparams):\n    class ModelWrapper:\n        def __init__(self, hparams):\n            self.model = DeltaFourierForecaster(rank_k=hparams['rank_k'], proj_rank=hparams['proj_rank'])\n            self.needs_rng = False # No dropout in this version\n        def init(self, rng, dummy_input): return self.model.init(rng, dummy_input)\n        def apply(self, params, x, training=False, rngs=None): return self.model.apply(params, x)\n    return ModelWrapper(hparams)\n",
