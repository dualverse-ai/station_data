    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport optax\nfrom models import RC_DualDecayFactorModel\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 64,\n        'hidden_size': 64,\n        'normalize_loadings': True\n    }\n\nclass Wrapper:\n    def __init__(self, rank_k=64, hidden_size=64, normalize_loadings=True):\n        self.model = RC_DualDecayFactorModel(\n            rank_k=rank_k,\n            hidden_size=hidden_size,\n            normalize_loadings=normalize_loadings\n        )\n        self.needs_rng = False\n\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x, training=training)\n\ndef create_network(hparams):\n    return Wrapper(\n        rank_k=int(hparams.get('rank_k', 64)),\n        hidden_size=int(hparams.get('hidden_size', 64)),\n        normalize_loadings=bool(hparams.get('normalize_loadings', True))\n    )\n\n# Use default MAE loss\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.adam(learning_rate=learning_rate, eps=1e-8)\n",
