  "original_submission": {
    "content": "import jax.numpy as jnp\nimport flax.linen as nn\nimport optax\nfrom jax import random\n\nclass ResidualCopyHead(nn.Module):\n    drop: float = 0.05\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        h = nn.Dense(64)(x_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(32)(h)\n        residual = h.reshape(B, N, 32).transpose(0, 2, 1)\n        out = jnp.zeros((B, 32, N)); out = out.at[:, :4, :].set(x)\n        return out + residual\n\nclass FourierForecasterLN_RFFT(nn.Module):\n    rank_k: int = 320\n    proj_rank: int = 36\n    drop: float = 0.05\n    output_horizon: int = 32\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U_eff = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n\n        x_fft = jnp.fft.rfft(x, axis=1)\n        x_fft_bn = jnp.transpose(x_fft, (0, 2, 1))            # (B, N, T_in_freq)\n        factors_in_fft = jnp.einsum('bni,np->bip', x_fft_bn, U_eff) @ V.T\n        f_flat = jnp.concatenate([factors_in_fft.real, factors_in_fft.imag], axis=-1).reshape(B, -1)\n\n        h = nn.Dense(512)(f_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(512)(h); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n\n        T_out = self.output_horizon\n        T_out_freq = T_out // 2 + 1\n        out_flat = nn.Dense(T_out_freq * k * 2)(h)\n        out_ri = out_flat.reshape(B, T_out_freq, k, 2)\n        out_real, out_imag = out_ri[..., 0], out_ri[..., 1]\n        f_fft = out_real + 1j * out_imag\n\n        norm_real = nn.LayerNorm()(f_fft.real)\n        norm_imag = nn.LayerNorm()(f_fft.imag)\n        f_fft_n = norm_real + 1j * norm_imag\n\n        y_fft = (f_fft_n @ V) @ U_eff.T\n        y_fourier = jnp.fft.irfft(y_fft, n=T_out, axis=1)\n\n        y_copy = ResidualCopyHead(drop=self.drop)(x, training=training)\n        return y_fourier + y_copy\n\ndef _define_hyperparameters():\n    return {'learning_rate': 9e-4, 'rank_k': 320, 'proj_rank': 36, 'drop': 0.05}\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.hparams = hparams\n        self.model = FourierForecasterLN_RFFT(\n            rank_k=hparams['rank_k'],\n            proj_rank=hparams['proj_rank'],\n            drop=hparams.get('drop', 0.05)\n        )\n        self.needs_rng = True\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        return self.model.init({'params': rng_params, 'dropout': rng_dropout}, dummy_input, training=True)\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x, training=training, rngs=rngs if rngs is not None else {})\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    return mae + 1e-4 * jnp.mean(curv * curv)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n",
