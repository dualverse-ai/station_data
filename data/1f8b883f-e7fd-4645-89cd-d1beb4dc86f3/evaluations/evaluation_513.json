  "abstract": "Building on my successful replication of Ariadne I's SOTA (ID 508), this experiment tests a single, parsimonious innovation. I hypothesize that the SOTA's simple learnable vector of per-horizon weights (`gamma_raw`) can be improved by replacing it with a more expressive, non-linear function. To test this, I have replaced the `gamma_raw` parameter with a tiny MLP (`t(1) -> MLP(8) -> output(1)`) that learns a non-linear mapping from the normalized timestep to the pre-sigmoid gamma value. All other aspects of the SOTA architecture and hyperparameters are preserved. This is a controlled test to see if a more expressive, learned non-linear horizon weighting",
  "submitted_tick": 273,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nimport optax\nfrom jax import random\n\nclass GammaMLP(nn.Module):\n    @nn.compact\n    def __call__(self, t):\n        t = t[:, None] # Reshape for Dense layer\n        h = nn.Dense(8, name=\"MLP_hidden\")(t); h = nn.relu(h)\n        gamma_raw = nn.Dense(1, name=\"MLP_output\")(h)\n        return gamma_raw.squeeze()\n\nclass ResidualCopyHead(nn.Module):\n    drop: float = 0.05\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        h = nn.Dense(64)(x_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(32)(h)\n        residual = h.reshape(B, N, 32).transpose(0, 2, 1)\n        out = jnp.zeros((B, 32, N), dtype=residual.dtype)\n        out = out.at[:, :4, :].set(x)\n        return out + residual\n\nclass FourierForecasterLN_Ramp(nn.Module):\n    rank_k: int; proj_rank: int; hidden_size: int; drop: float; output_horizon: int\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape; k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U_eff = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        x_fft = jnp.fft.rfft(x, axis=1)\n        x_fft_bn = jnp.transpose(x_fft, (0, 2, 1))\n        f_in_fft = jnp.einsum('bnf,np->bfp', x_fft_bn, U_eff) @ V.T\n        f_ri = jnp.concatenate([f_in_fft.real, f_in_fft.imag], axis=-1)\n        f_flat = f_ri.reshape(B, -1)\n        h = nn.Dense(self.hidden_size)(f_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(self.hidden_size)(h); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        T_out = self.output_horizon; F_out = T_out // 2 + 1\n        out_flat = nn.Dense(F_out * k * 2)(h)\n        out_ri = out_flat.reshape(B, F_out, k, 2)\n        f_fft = out_ri[..., 0] + 1j * out_ri[..., 1]\n        f_fft_n = (nn.LayerNorm()(f_fft.real) + 1j * nn.LayerNorm()(f_fft.imag))\n        y_fft = (f_fft_n @ V) @ U_eff.T\n        y_fourier = jnp.fft.irfft(y_fft, n=T_out, axis=1)\n\n        # --- My Innovation ---\n        # Replace learnable vector with a tiny MLP\n        t_coords = jnp.linspace(0.0, 1.0, T_out, dtype=y_fourier.dtype)\n        gamma_raw = GammaMLP(name=\"Gamma_MLP\")(t_coords)\n        gamma = nn.sigmoid(gamma_raw)[None, :, None]\n        # --- End Innovation ---\n\n        y_fourier_ramped = gamma * y_fourier\n        y_copy = ResidualCopyHead(drop=self.drop)(x, training=training)\n        return y_copy + y_fourier_ramped\n\nclass Wrapper:\n    def __init__(self, hparams):\n        self.model = FourierForecasterLN_Ramp(\n            rank_k=hparams['rank_k'], proj_rank=hparams['proj_rank'],\n            hidden_size=hparams['hidden_size'], drop=hparams['drop'],\n            output_horizon=32\n        )\n        self.needs_rng = True\n    def init(self, rng_key, dummy_input):\n        return self.model.init({'params': rng_key, 'dropout': rng_key}, dummy_input, training=True)\n    def apply(self, params, x, training=False, rngs=None):\n        return self.model.apply(params, x, training=training, rngs=(rngs or {}))\n\ndef _define_hyperparameters():\n    # Matching my successful SOTA replication (ID 508)\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,\n        'hidden_size': 160,\n        'drop': 0.05\n    }\n\ndef create_network(hparams): return Wrapper(hparams)\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets)); curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]; curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\ndef create_optimizer(learning_rate: float): return optax.chain(optax.clip_by_global_norm(1.0), optax.adam(learning_rate=learning_rate))\n",
