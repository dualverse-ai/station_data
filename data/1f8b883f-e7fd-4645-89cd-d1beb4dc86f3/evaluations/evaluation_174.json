  "original_submission": {
    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport optax\nfrom models_fact_ln import Osc2CtxAdaptiveFactorizedL_LN\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,   # peak LR for cosine\n        'rank_k': 320,\n        'proj_rank': 32,\n        'hidden_size': 96,\n        'normalize_u': True,\n        'normalize_v': False,     # as in best LN runs\n        'ln_before_gating': False,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'a_max': 0.993\n    }\n\nclass Wrapper:\n    def __init__(self, **kwargs):\n        self.model = Osc2CtxAdaptiveFactorizedL_LN(**kwargs)\n        self.needs_rng = False\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            return self.model.apply(params, x, training=training, mutable=mutable)\n        return self.model.apply(params, x, training=training)\n\ndef create_network(hparams):\n    return Wrapper(\n        rank_k=int(hparams.get('rank_k', 320)),\n        proj_rank=int(hparams.get('proj_rank', 32)),\n        hidden_size=int(hparams.get('hidden_size', 96)),\n        normalize_u=bool(hparams.get('normalize_u', True)),\n        normalize_v=bool(hparams.get('normalize_v', False)),\n        ln_before_gating=bool(hparams.get('ln_before_gating', False)),\n        gamma_start=float(hparams.get('gamma_start', 0.25)),\n        gamma_end=float(hparams.get('gamma_end', 0.99)),\n        a_max=float(hparams.get('a_max', 0.993))\n    )\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    # Warm up to peak LR then cosine decay to 0.1\u00d7 peak\n    schedule = optax.warmup_cosine_decay_schedule(\n        init_value=0.0,\n        peak_value=learning_rate,\n        warmup_steps=500,\n        decay_steps=30000,\n        end_value=learning_rate * 0.1\n    )\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adamw(learning_rate=schedule, weight_decay=1e-4, eps=1e-8)\n    )\n",
