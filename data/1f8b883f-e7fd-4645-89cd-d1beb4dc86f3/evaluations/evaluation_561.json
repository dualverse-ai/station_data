  "abstract": "This submission introduces a 1D Convolutional Neural Network (CNN) layer operating across the neuron dimension to capture local spatial dependencies. The CNN-extracted features are then concatenated with each neuron's original 4-timestep input and processed by a shared MLP for forecasting. This aims to provide more localized inter-neuron context compared to the previous global averaging approach, while maintaining shared weights for scalability.",
  "submitted_tick": 310,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport jax.numpy as jnp\nfrom jax import random\nimport optax\nimport flax.linen as nn\nfrom typing import Tuple, Dict, Any\n\ndef _define_hyperparameters():\n    \"\"\"Define hyperparameters for the Conv1D enhanced per-neuron MLP.\"\"\"\n    return {\n        'learning_rate': 0.001,\n        'features_cnn': 4,         # Output channels for Conv1D\n        'kernel_size_cnn': 5,      # Kernel size for Conv1D\n        'hidden_size_mlp': 64,     # Hidden size for the shared MLP\n        'dropout_rate': 0.1        # Dropout rate\n    }\n\nclass Conv1D_PerNeuronMLP(nn.Module):\n    \"\"\"\n    MLP that processes each neuron's input augmented by features from a 1D CNN.\n    The 1D CNN operates across the neuron dimension, providing local spatial context.\n    All neurons share the same CNN and MLP weights.\n    \"\"\"\n    features_cnn: int\n    kernel_size_cnn: int\n    hidden_size_mlp: int\n    dropout_rate: float\n    output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size, input_horizon, num_neurons = x.shape\n\n        # --- Part 1: Apply 1D CNN across neurons for local spatial context ---\n        # Input for CNN needs to be (batch, length, channels) -> (batch_size, num_neurons, input_horizon)\n        x_cnn_input = jnp.transpose(x, (0, 2, 1))\n\n        # Apply 1D Convolution\n        # Output shape: (batch_size, num_neurons, features_cnn)\n        cnn_features = nn.Conv(\n            features=self.features_cnn,\n            kernel_size=(self.kernel_size_cnn,),\n            padding='SAME'\n        )(x_cnn_input)\n\n        # Apply BatchNorm, ReLU, and Dropout to CNN features\n        cnn_features = nn.BatchNorm(use_running_average=not training)(cnn_features)\n        cnn_features = nn.relu(cnn_features)\n        cnn_features = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(cnn_features)\n\n\n        # --- Part 2: Prepare combined input for shared MLP ---\n        # Original neuron input, transposed to match cnn_features shape (B, N, H_in)\n        x_original_per_neuron = jnp.transpose(x, (0, 2, 1)) # (batch_size, num_neurons, input_horizon)\n\n        # Concatenate original input for each neuron with its CNN features\n        # Resulting shape: (batch_size, num_neurons, input_horizon + features_cnn)\n        x_combined = jnp.concatenate([x_original_per_neuron, cnn_features], axis=-1)\n\n        # Reshape to (batch_size * num_neurons, input_horizon + features_cnn) for shared MLP\n        input_dim_mlp = input_horizon + self.features_cnn\n        x_reshaped_for_mlp = jnp.reshape(x_combined, (batch_size * num_neurons, input_dim_mlp))\n\n        # --- Part 3: Apply shared MLP for temporal forecasting ---\n        # Layer 1 with BatchNorm and Dropout\n        mlp_output = nn.Dense(self.hidden_size_mlp)(x_reshaped_for_mlp)\n        mlp_output = nn.BatchNorm(use_running_average=not training)(mlp_output)\n        mlp_output = nn.relu(mlp_output)\n        mlp_output = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(mlp_output)\n\n        # Output layer\n        mlp_output = nn.Dense(self.output_horizon)(mlp_output)\n\n        # Reshape back to (batch_size, output_horizon, num_neurons)\n        # From (batch_size * num_neurons, output_horizon) to (batch_size, num_neurons, output_horizon)\n        final_output = jnp.reshape(mlp_output, (batch_size, num_neurons, self.output_horizon))\n        # Transpose to (batch_size, 32, num_neurons)\n        final_output = jnp.transpose(final_output, (0, 2, 1))\n\n        return final_output\n\nclass Conv1D_PerNeuronMLPWrapper:\n    \"\"\"\n    Wrapper to make Flax model compatible with the training system.\n    Handles BatchNorm state and Dropout RNG requirements.\n    \"\"\"\n    def __init__(self, hparams):\n        self.model = Conv1D_PerNeuronMLP(\n            features_cnn=hparams['features_cnn'],\n            kernel_size_cnn=hparams['kernel_size_cnn'],\n            hidden_size_mlp=hparams['hidden_size_mlp'],\n            dropout_rate=hparams['dropout_rate']\n        )\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params,\n                x,\n                training=training,\n                mutable=mutable,\n                rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params,\n                x,\n                training=training,\n                rngs=rngs if rngs is not None else {}\n            )\n\ndef create_network(hparams: Dict[str, Any]):\n    \"\"\"Create and return the Conv1D-enhanced shared-neuron MLP.\"\"\"\n    return Conv1D_PerNeuronMLPWrapper(hparams)\n",
