  "cpu_only": false,
  "original_submission": {
    "content": "import sys, os, json\nsys.path.append('storage/ariadne')\n\nimport numpy as np\nimport jax.numpy as jnp\nimport optax\n\nfrom models_fact_ln import Osc2CtxAdaptiveFactorizedL_LN\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\nV_ORTHO_LAM = 1e-5  # ||V^T V - I||_F^2\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,\n        'proj_rank': 32,\n        'hidden_size': 96,\n        'normalize_u': True,\n        'normalize_v': False,\n        'ln_before_gating': False,  # LN after gating (best)\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'a_max': 0.993\n    }\n\nclass Wrapper:\n    def __init__(self, **kwargs):\n        self.model = Osc2CtxAdaptiveFactorizedL_LN(**kwargs)\n        self.needs_rng = False\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x, training=training)\n\ndef create_network(hparams):\n    return Wrapper(\n        rank_k=int(hparams.get('rank_k', 320)),\n        proj_rank=int(hparams.get('proj_rank', 32)),\n        hidden_size=int(hparams.get('hidden_size', 96)),\n        normalize_u=bool(hparams.get('normalize_u', True)),\n        normalize_v=bool(hparams.get('normalize_v', False)),\n        ln_before_gating=bool(hparams.get('ln_before_gating', False)),\n        gamma_start=float(hparams.get('gamma_start', 0.25)),\n        gamma_end=float(hparams.get('gamma_end', 0.99)),\n        a_max=float(hparams.get('a_max', 0.993))\n    )\n\ndef _get_V_from_params(params):\n    try:\n        return params['params']['V']\n    except Exception:\n        # Try shallow dict\n        return params.get('V', None)\n\ndef compute_loss(predictions, targets, params, x):\n    base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n    V = _get_V_from_params(params)\n    if V is None:\n        return base\n    G = jnp.matmul(V.T, V)\n    I = jnp.eye(G.shape[0], dtype=G.dtype)\n    v_ortho = jnp.sum((G - I) ** 2)\n    return base + V_ORTHO_LAM * v_ortho\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate, eps=1e-8)\n    )\n\ndef _np(x):\n    return np.array(x)\n\ndef complete(params, opt_state, trial_data):\n    # Export stats for qualitative analysis\n    try:\n        p = params['params'] if isinstance(params, dict) and 'params' in params else params\n        U = _np(p.get('U')) if isinstance(p, dict) and 'U' in p else None\n        V = _np(p.get('V')) if isinstance(p, dict) and 'V' in p else None\n        gamma_raw = _np(p.get('gamma_raw')) if 'gamma_raw' in p else None\n        s_alpha = _np(p.get('s_alpha')) if 's_alpha' in p else None\n        s_beta  = _np(p.get('s_beta')) if 's_beta' in p else None\n\n        out_dir = f\"storage/ariadne/analyses/ln_best_a0993_H96_export/trial_{trial_data.get('trial_number','?')}_seed_{trial_data.get('seed','?')}\"\n        os.makedirs(out_dir, exist_ok=True)\n\n        meta = {\n            'val_mae': float(trial_data.get('val_mae', np.nan)),\n            'hyperparameters': trial_data.get('hyperparameters', {}),\n            'seed': trial_data.get('seed', None),\n            'trial_number': trial_data.get('trial_number', None),\n        }\n\n        if V is not None:\n            Gv = V.T @ V\n            I = np.eye(Gv.shape[0], dtype=Gv.dtype)\n            v_ortho_fro2 = float(np.sum((Gv - I) ** 2))\n            meta['V_shape'] = list(V.shape)\n            meta['V_colnorm_mean'] = float(np.mean(np.linalg.norm(V, axis=0)))\n            meta['V_colnorm_std'] = float(np.std(np.linalg.norm(V, axis=0)))\n            meta['V_ortho_fro2'] = v_ortho_fro2\n            np.savez_compressed(os.path.join(out_dir, \"V.npz\"), V=V)\n\n        if U is not None:\n            norms = np.linalg.norm(U, axis=0, keepdims=True) + 1e-6\n            Uhat = U / norms\n            Gu = Uhat.T @ Uhat\n            np.fill_diagonal(Gu, 0.0)\n            u_coh_max = float(np.max(np.abs(Gu)))\n            meta['U_shape'] = list(U.shape)\n            meta['U_colnorm_mean'] = float(np.mean(norms))\n            meta['U_colnorm_std'] = float(np.std(norms))\n            meta['U_coherence_max'] = u_coh_max\n            # Do not save full U by default to keep size modest\n\n        if gamma_raw is not None:\n            gamma = 1.0 / (1.0 + np.exp(-gamma_raw))\n            np.savez_compressed(os.path.join(out_dir, \"gamma.npz\"), gamma=gamma)\n            meta['gamma_min'] = float(np.min(gamma))\n            meta['gamma_max'] = float(np.max(gamma))\n            meta['gamma_mean'] = float(np.mean(gamma))\n\n        if s_alpha is not None:\n            np.savez_compressed(os.path.join(out_dir, \"s_alpha.npz\"), s_alpha=s_alpha)\n            meta['s_alpha_mean'] = float(np.mean(s_alpha))\n            meta['s_alpha_std'] = float(np.std(s_alpha))\n        if s_beta is not None:\n            np.savez_compressed(os.path.join(out_dir, \"s_beta.npz\"), s_beta=s_beta)\n            meta['s_beta_mean'] = float(np.mean(s_beta))\n            meta['s_beta_std'] = float(np.std(s_beta))\n\n        with open(os.path.join(out_dir, \"meta.json\"), \"w\") as f:\n            json.dump(meta, f, indent=2)\n        print(f\"[EXPORT] Wrote analysis to {out_dir}\")\n    except Exception as e:\n        print(f\"[EXPORT ERROR] {e}\")\n",
