  "abstract": "This experiment provides the final, symmetrical piece of evidence for my analysis of conditioning mechanisms. Following the success of the \"Gamma-Only\" model (ID 605), this experiment tests a \"Beta-Only\" version of the NCS-MLP v2. The `gamma` (scale) component is ablated, and conditioning is performed using only the additive `beta` shift. I hypothesize this model will perform poorly, likely no better than the baseline, providing conclusive evidence that the `beta` shift is not the primary driver of performance.",
  "submitted_tick": 350,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax; import flax.linen as nn; import jax.numpy as jnp; import optax; from jax import random\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001, 'embedding_dim': 32, 'hidden_size': 128,\n        'num_neurons': 71721, 'adam_eps': 1e-8, 'context_hidden': 64,\n        'gating_scale': 0.1, 'shift_scale': 0.02\n    }\n\nclass FiLMGenerator(nn.Module):\n    hidden_dim: int\n    @nn.compact\n    def __call__(self, embedding):\n        film_params = nn.Dense(2 * self.hidden_dim)(embedding)\n        gamma, beta = jnp.split(film_params, 2, axis=-1); return gamma + 1.0, beta\n\nclass NCS_MLP_Beta_Only(nn.Module):\n    embedding_dim: int; hidden_size: int; num_neurons: int\n    context_hidden: int; gating_scale: float; shift_scale: float\n    output_horizon: int = 32\n    @nn.compact\n    def __call__(self, x: jnp.ndarray) -> jnp.ndarray:\n        B, T_in, N = x.shape\n        neuron_indices = jnp.arange(self.num_neurons)\n        neuron_embeddings = nn.Embed(num_embeddings=self.num_neurons, features=self.embedding_dim)(neuron_indices)\n        tiled_embeddings = jnp.tile(neuron_embeddings, (B, 1))\n        x_flat = x.transpose((0, 2, 1)).reshape(B * N, T_in)\n        \n        # Block 1: Beta-Only FiLM\n        h = nn.Dense(self.hidden_size)(x_flat)\n        h = nn.relu(h)\n        _gamma1, beta1 = FiLMGenerator(self.hidden_size, name=\"film_gen_1\")(tiled_embeddings) # gamma is ignored\n        h = h + beta1\n        \n        # Block 2: Beta-Only FiLM\n        h = nn.Dense(self.hidden_size)(h)\n        h = nn.relu(h)\n        _gamma2, beta2 = FiLMGenerator(self.hidden_size, name=\"film_gen_2\")(tiled_embeddings) # gamma is ignored\n        h = h + beta2\n        \n        y_base_flat = nn.Dense(self.output_horizon)(h)\n        y_base = y_base_flat.reshape(B, N, self.output_horizon)\n        \n        # Population Context Gate\n        x_mean = x.mean(axis=-1); x_std = x.std(axis=-1) + 1e-6\n        context = jnp.concatenate([x_mean, x_std], axis=-1)\n        ch = nn.Dense(self.context_hidden)(context); ch = nn.gelu(ch)\n        ch = nn.Dense(self.context_hidden)(ch); ch = nn.gelu(ch)\n        g_raw = nn.Dense(self.output_horizon)(ch)\n        s_raw = nn.Dense(self.output_horizon)(ch)\n        g = 1.0 + self.gating_scale * jnp.tanh(g_raw)\n        s = self.shift_scale * jnp.tanh(s_raw)\n        y = y_base * g[:, None, :] + s[:, None, :]\n        output = y.transpose((0, 2, 1))\n        return output\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = NCS_MLP_Beta_Only(**{k: hparams[k] for k in _define_hyperparameters() if k in ['embedding_dim', 'hidden_size', 'num_neurons', 'context_hidden', 'gating_scale', 'shift_scale']})\n    def init(self, rng_key, dummy_input): return self.model.init(rng_key, dummy_input)\n    def apply(self, params, x, training=False, rngs=None): return self.model.apply(params, x)\n\ndef create_network(hparams): return ModelWrapper(hparams)\ndef compute_loss(predictions, targets, params, x): return jnp.mean(jnp.abs(predictions - targets))\ndef create_optimizer(learning_rate: float):\n    return optax.adam(learning_rate=learning_rate, eps=_define_hyperparameters()['adam_eps'])\n",
