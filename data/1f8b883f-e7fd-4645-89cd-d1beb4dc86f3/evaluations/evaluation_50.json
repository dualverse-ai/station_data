  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nfrom jax import random\n\nNUM_NEURONS = 71721\nINPUT_HORIZON = 4\nOUTPUT_HORIZON = 32\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'embedding_dim': 8,\n        'mlp_hidden_size': 64,\n        'dropout_rate': 0.1,\n        'num_experts': 8,\n        'gating_hidden_dim': 32,\n    }\n\nclass MlpExpert(nn.Module):\n    embedding_dim: int\n    mlp_hidden_size: int\n    dropout_rate: float\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size = x.shape[0]\n        \n        # Simplified MLP Expert based on ID 2\n        neuron_indices = jnp.arange(NUM_NEURONS)\n        embeddings = nn.Embed(num_embeddings=NUM_NEURONS, features=self.embedding_dim, name=\"neuron_embed\")(neuron_indices)\n        broadcasted_embeddings = jnp.broadcast_to(embeddings, (batch_size, NUM_NEURONS, self.embedding_dim))\n        \n        x_transposed = jnp.transpose(x, (0, 2, 1))\n        combined_input = jnp.concatenate([x_transposed, broadcasted_embeddings], axis=-1)\n        \n        mlp_input = jnp.reshape(combined_input, (batch_size * NUM_NEURONS, INPUT_HORIZON + self.embedding_dim))\n\n        y = nn.Dense(self.mlp_hidden_size)(mlp_input)\n        y = nn.BatchNorm(use_running_average=not training)(y)\n        y = nn.relu(y)\n        y = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(y)\n        \n        output = nn.Dense(OUTPUT_HORIZON)(y)\n        \n        output = jnp.reshape(output, (batch_size, NUM_NEURONS, OUTPUT_HORIZON))\n        output = jnp.transpose(output, (0, 2, 1))\n        return output\n\nclass GatingNetwork(nn.Module):\n    num_experts: int\n    hidden_dim: int\n\n    @nn.compact\n    def __call__(self, x):\n        gater_input = jnp.mean(x, axis=2)\n        gater_input = gater_input.reshape((gater_input.shape[0], -1))\n        \n        y = nn.Dense(features=self.hidden_dim)(gater_input)\n        y = nn.relu(y)\n        logits = nn.Dense(features=self.num_experts)(y)\n        return nn.softmax(logits, axis=-1)\n\nclass MoEModel(nn.Module):\n    num_experts: int\n    expert_params: dict\n    gating_params: dict\n    \n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        experts = nn.vmap(\n            MlpExpert,\n            in_axes=None, out_axes=1,\n            variable_axes={'params': 0, 'batch_stats': 0},\n            split_rngs={'params': True, 'dropout': True},\n            axis_size=self.num_experts\n        )(**self.expert_params, name=\"experts\")\n        \n        gating_network = GatingNetwork(**self.gating_params, name=\"gating\")\n        gating_weights = gating_network(x)\n        \n        expert_outputs = experts(x, training=training)\n        \n        gating_weights = jnp.expand_dims(jnp.expand_dims(gating_weights, -1), -1)\n        \n        weighted_outputs = expert_outputs * gating_weights\n        final_output = jnp.sum(weighted_outputs, axis=1)\n        \n        return final_output\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.hparams = hparams\n        expert_params = {\n            'embedding_dim': hparams.get('embedding_dim'),\n            'mlp_hidden_size': hparams.get('mlp_hidden_size'),\n            'dropout_rate': hparams.get('dropout_rate'),\n        }\n        gating_params = {\n            'num_experts': hparams.get('num_experts'),\n            'hidden_dim': hparams.get('gating_hidden_dim'),\n        }\n        self.model = MoEModel(\n            num_experts=hparams.get('num_experts'),\n            expert_params=expert_params,\n            gating_params=gating_params\n        )\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        return self.model.init({'params': rng_params, 'dropout': rng_dropout}, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable:\n            return self.model.apply(params, x, training=training, mutable=mutable, rngs=rngs)\n        return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n",
