  "abstract": "This submission refines the successful two-layer Deeper Shared-Neuron MLP by increasing the hidden layer size from 64 to 128 neurons per layer. This aims to provide more capacity per layer to capture complex non-linear relationships, building on previous findings that increased capacity is beneficial. BatchNorm and Dropout are retained, and other hyperparameters are consistent for direct comparison.",
  "submitted_tick": 339,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport jax.numpy as jnp\nfrom jax import random\nimport optax\nimport flax.linen as nn\nfrom typing import Tuple, Dict, Any, Sequence\n\ndef _define_hyperparameters():\n    \"\"\"Define hyperparameters for the wider, deeper shared MLP.\"\"\"\n    return {\n        'learning_rate': 0.001,\n        'hidden_sizes': [128, 128], # Two hidden layers, each with 128 neurons\n        'dropout_rate': 0.1\n    }\n\nclass DeeperSharedNeuronMLP(nn.Module):\n    \"\"\"\n    Deeper and wider shared-neuron MLP with multiple hidden layers, BatchNorm and Dropout.\n    Processes the last 4 activation values through a shared MLP for all neurons.\n    \"\"\"\n    hidden_sizes: Sequence[int]\n    dropout_rate: float\n    output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size, input_horizon, num_neurons = x.shape\n\n        # Reshape to process all neurons together\n        # From (batch_size, 4, num_neurons) to (batch_size * num_neurons, 4)\n        x = jnp.transpose(x, (0, 2, 1))  # (batch_size, num_neurons, 4)\n        x = jnp.reshape(x, (batch_size * num_neurons, input_horizon))\n\n        # Apply multiple hidden layers\n        for i, hidden_size in enumerate(self.hidden_sizes):\n            x = nn.Dense(hidden_size)(x)\n            x = nn.BatchNorm(use_running_average=not training)(x)\n            x = nn.relu(x)\n            x = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(x)\n\n        # Output layer\n        x = nn.Dense(self.output_horizon)(x)\n\n        # Reshape back to (batch_size, output_horizon, num_neurons)\n        x = jnp.reshape(x, (batch_size, num_neurons, self.output_horizon))\n        x = jnp.transpose(x, (0, 2, 1))  # (batch_size, 32, num_neurons)\n\n        return x\n\n\nclass DeeperMLPWrapper:\n    \"\"\"\n    Wrapper to make Flax model compatible with the training system.\n    Handles BatchNorm state and Dropout RNG requirements.\n    \"\"\"\n\n    def __init__(self, hparams):\n        self.model = DeeperSharedNeuronMLP(\n            hidden_sizes=hparams['hidden_sizes'],\n            dropout_rate=hparams['dropout_rate']\n        )\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        \"\"\"Initialize parameters with BatchNorm stats.\"\"\"\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        \"\"\"Apply network with proper handling of BatchNorm and Dropout.\"\"\"\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params,\n                x,\n                training=training,\n                mutable=mutable,\n                rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params,\n                x,\n                training=training,\n                rngs=rngs if rngs is not None else {}\n            )\n\n\ndef create_network(hparams: Dict[str, Any]):\n    \"\"\"Create and return the deeper and wider shared-neuron MLP.\"\"\"\n    return DeeperMLPWrapper(hparams)\n",
