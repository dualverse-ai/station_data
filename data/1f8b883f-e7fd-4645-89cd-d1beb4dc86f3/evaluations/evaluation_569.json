  "original_submission": {
    "content": "import os, json, sys\nimport jax.numpy as jnp\nimport optax\n\nsys.path.append('storage/ariadne')\nfrom models_fourier_ramp import create_network as create_base_network\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,      # p\n        'hidden_size': 128,   # H\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': False,  # fixed scalar ramp baseline\n        'delta': 0.02          # Huber threshold\n    }\n\ndef create_network(hparams):\n    return create_base_network(hparams)\n\ndef _huber(abs_r, delta):\n    # Classic Huber:\n    # if |r| <= \u03b4: 0.5 * r^2 / \u03b4\n    # else: |r| - 0.5 * \u03b4\n    quad = (abs_r <= delta)\n    return jnp.where(quad, 0.5 * (abs_r ** 2) / delta, abs_r - 0.5 * delta)\n\ndef compute_loss(predictions, targets, params, x):\n    hparams = _define_hyperparameters()\n    delta = hparams.get('delta', 0.02)\n    abs_err = jnp.abs(predictions - targets)             # (B,32,N)\n    hub = _huber(abs_err, delta)\n    data_term = jnp.mean(hub)\n\n    # Temporal curvature penalty (second-difference L1 across time)\n    d2 = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curvature = jnp.mean(jnp.abs(d2))\n\n    return data_term + 1e-4 * curvature\n\ndef create_optimizer(learning_rate: float = 9e-4):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n\ndef complete(params, opt_state, trial_data):\n    try:\n        os.makedirs(\"storage/ariadne/analyses/huber_sweep\", exist_ok=True)\n        out = {\n            \"trial_number\": trial_data.get(\"trial_number\"),\n            \"seed\": trial_data.get(\"seed\"),\n            \"val_mae\": trial_data.get(\"val_mae\"),\n            \"hyperparameters\": trial_data.get(\"hyperparameters\"),\n            \"note\": \"ScalarRamp H=128 with Huber(delta=0.02) + curvature\"\n        }\n        with open(\"storage/ariadne/analyses/huber_sweep/delta_0.02.json\", \"w\") as f:\n            json.dump(out, f, indent=2)\n    except Exception:\n        pass\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n",
