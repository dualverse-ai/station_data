    "content": "import sys, optax\nsys.path.append('storage/ariadne')\n\nfrom models_fourier_ramp import create_network, export_stats\nfrom losses import mae_with_temporal_curvature\n\n# New base seed for robustness; system will run BASE_SEED + {0,1,2}\nBASE_SEED = 3407\nBATCH_SIZE = 8\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,\n        'hidden_size': 160,\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': True\n    }\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n\ndef complete(params, opt_state, trial_data):\n    # Save \u03b3[t] and per-condition step-MAE stats for analysis\n    export_stats(params, trial_data, _define_hyperparameters(),\n                 out_dir=\"storage/ariadne/analyses/fourier_learn_gamma_seed3407\")\n",
