    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport optax\nfrom models_mlp_global import create_network, _define_hyperparameters as _def_base\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n\ndef _define_hyperparameters():\n    hp = _def_base()\n    hp['proj_rank'] = 32\n    hp['hidden_size'] = 768\n    hp['hidden_size2'] = 768\n    hp['dropout_rate'] = 0.10\n    return hp\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    schedule = optax.warmup_cosine_decay_schedule(\n        init_value=1e-5,\n        peak_value=9e-4,\n        warmup_steps=500,\n        decay_steps=8000,\n        end_value=1e-4\n    )\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=schedule, eps=1e-8)\n    )\n",
