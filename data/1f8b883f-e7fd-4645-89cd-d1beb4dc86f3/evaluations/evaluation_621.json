    "content": "import sys\nimport jax\nimport jax.numpy as jnp\nimport jax.nn as jnn\nimport jax.random as jrandom\nimport optax\nsys.path.append('storage/ariadne')\nfrom models_fourier_ramp import create_network as create_base_network\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,\n        'hidden_size': 160,\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': False,\n        'mot_rank': 4,\n        'alpha': 0.07,\n        'ctx_hidden': 64,\n        'lambda_b_curv': 1e-6,\n        'lambda_u_l2': 1e-8,\n        'lambda_mlp_l2': 1e-7\n    }\n\nclass DynamicMoTWrapper:\n    def __init__(self, base_net, mot_rank=4, alpha=0.07, ctx_hidden=64):\n        self.base_net = base_net\n        self.R = mot_rank\n        self.alpha = alpha\n        self.Hc = ctx_hidden\n        self.mutable = getattr(self.base_net, 'mutable', [])\n        self.needs_rng = getattr(self.base_net, 'needs_rng', False)\n\n    def init(self, rng_key, dummy_input):\n        rng_base, rng_w1, rng_w2, _ = jrandom.split(rng_key, 4)\n        base_params = self.base_net.init(rng_base, dummy_input)\n        N = int(dummy_input.shape[-1])\n        W1 = jrandom.normal(rng_w1, (8, self.Hc)) * 0.02\n        b1 = jnp.zeros((self.Hc,), dtype=dummy_input.dtype)\n        W2 = jrandom.normal(rng_w2, (self.Hc, self.R * 32)) * 0.02\n        b2 = jnp.zeros((self.R * 32,), dtype=dummy_input.dtype)\n        U_logits = jnp.zeros((N, self.R), dtype=dummy_input.dtype)\n        return {'base': base_params, 'mot_dyn': {'W1': W1, 'b1': b1, 'W2': W2, 'b2': b2, 'U_logits': U_logits}}\n\n    def _basis(self, dyn, x):\n        x_mean = x.mean(-1); x_std = x.std(-1) + 1e-6\n        ctx = jnp.concatenate([x_mean, x_std], -1)\n        h = jnn.gelu(ctx @ dyn['W1'] + dyn['b1'])\n        B = jnp.tanh(h @ dyn['W2'] + dyn['b2']).reshape(x.shape[0], self.R, 32)\n        return B\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        out = self.base_net.apply(params['base'], x, training=training, mutable=mutable, rngs=rngs)\n        y_base, updates = (out if isinstance(out, tuple) else (out, None))\n        dyn = params['mot_dyn']\n        B = self._basis(dyn, x)\n        P = jnn.softmax(dyn['U_logits'], axis=-1)\n        resid = jnp.matmul(jnp.swapaxes(B,1,2), jnp.swapaxes(P,0,1))\n        y = y_base + self.alpha * resid\n        return (y, updates) if updates is not None else y\n\ndef create_network(hp):\n    base = create_base_network({\n        'learning_rate': hp['learning_rate'],\n        'rank_k': hp['rank_k'],\n        'proj_rank': hp['proj_rank'],\n        'hidden_size': hp['hidden_size'],\n        'drop': hp['drop'],\n        'gamma_start': hp['gamma_start'],\n        'gamma_end': hp['gamma_end'],\n        'learn_gamma': hp['learn_gamma'],\n    })\n    return DynamicMoTWrapper(base, mot_rank=hp['mot_rank'], alpha=hp['alpha'], ctx_hidden=hp['ctx_hidden'])\n\ndef compute_loss(pred, tgt, params, x):\n    hp = _define_hyperparameters()\n    mae = jnp.mean(jnp.abs(pred - tgt))\n    d2 = pred[:,2:,:] - 2*pred[:,1:-1,:] + pred[:,:-2,:]\n    curv_pred = jnp.mean(jnp.abs(d2))\n    dyn = params['mot_dyn']\n    l2_u = hp['lambda_u_l2'] * jnp.mean(dyn['U_logits']**2)\n    l2_mlp = hp['lambda_mlp_l2'] * (jnp.mean(dyn['W1']**2) + jnp.mean(dyn['W2']**2))\n    B = DynamicMoTWrapper(None, hp['mot_rank'], hp['alpha'], hp['ctx_hidden'])._basis(dyn, x)\n    Bt = jnp.swapaxes(B,1,2)\n    d2b = Bt[:,2:,:] - 2*Bt[:,1:-1,:] + Bt[:,:-2,:]\n    curv_b = hp['lambda_b_curv'] * jnp.mean(jnp.abs(d2b))\n    return mae + 1e-4*curv_pred + l2_u + l2_mlp + curv_b\n\ndef create_optimizer(learning_rate: float = 9e-4):\n    return optax.chain(optax.clip_by_global_norm(1.0), optax.adam(learning_rate))\nBASE_SEED = 42\nBATCH_SIZE = 8\n",
