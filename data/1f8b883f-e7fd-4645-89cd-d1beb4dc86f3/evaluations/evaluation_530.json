  "abstract": "This is the fifth experiment in my systematic ablation of the SOTA. Having concluded my investigation of the input-adaptive gate, I now turn to the main Fourier backbone. This experiment tests the `drop` (dropout) rate, a key regularization parameter. I hypothesize that stronger regularization may improve generalization. I am increasing the dropout from 0.05 to 0.10 throughout the model (Fourier backbone and Residual Copy Head). All other hyperparameters are held constant for a controlled comparison against the SOTA baseline.",
  "submitted_tick": 288,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport flax.linen as nn\nimport jax.numpy as jnp\nimport optax\nfrom jax import random\n\n# Using the exact SOTA components\nclass ResidualCopyHead(nn.Module):\n    drop: float = 0.05\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        h = nn.Dense(64)(x_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(32)(h)\n        residual = h.reshape(B, N, 32).transpose(0, 2, 1)\n        out = jnp.zeros((B, 32, N), dtype=residual.dtype); out = out.at[:, :4, :].set(x)\n        return out + residual\n\nclass FourierForecasterLN_Ramp(nn.Module):\n    rank_k: int; proj_rank: int; hidden_size: int; drop: float\n    output_horizon: int = 32; learn_gamma: bool = True\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape; k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U_eff = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        x_fft = jnp.fft.rfft(x, axis=1)\n        x_fft_bn = jnp.transpose(x_fft, (0, 2, 1))\n        f_in_fft = jnp.einsum('bnf,np->bfp', x_fft_bn, U_eff) @ V.T\n        f_ri = jnp.concatenate([f_in_fft.real, f_in_fft.imag], axis=-1)\n        f_flat = f_ri.reshape(B, -1)\n        h = nn.Dense(self.hidden_size)(f_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(self.hidden_size)(h); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        T_out = self.output_horizon; F_out = T_out // 2 + 1\n        out_flat = nn.Dense(F_out * k * 2)(h)\n        out_ri = out_flat.reshape(B, F_out, k, 2)\n        f_fft = out_ri[..., 0] + 1j * out_ri[..., 1]\n        f_fft_n = (nn.LayerNorm()(f_fft.real) + 1j * nn.LayerNorm()(f_fft.imag))\n        y_fft = (f_fft_n @ V) @ U_eff.T\n        y_fourier = jnp.fft.irfft(y_fft, n=T_out, axis=1)\n        gamma_raw = self.param('gamma_raw', nn.initializers.zeros, (T_out,))\n        gamma = nn.sigmoid(gamma_raw)[None, :, None]\n        y_fourier = gamma * y_fourier\n        y_copy = ResidualCopyHead(drop=self.drop)(x, training=training)\n        return y_fourier + y_copy\n\nclass SotaWrapperWithAblation(nn.Module):\n    rank_k: int; proj_rank: int; hidden_size: int; drop: float\n    residual_hidden: int; residual_scale: float\n    @nn.compact\n    def __call__(self, x, training=False):\n        base_network = FourierForecasterLN_Ramp(\n            rank_k=self.rank_k, proj_rank=self.proj_rank, hidden_size=self.hidden_size, drop=self.drop,\n            name=\"base_model\"\n        )\n        y_base = base_network(x, training=training)\n        mu = jnp.mean(x, axis=-1); sigma = jnp.std(x, axis=-1)\n        feats = jnp.concatenate([mu, sigma], axis=-1)\n        h = nn.Dense(self.residual_hidden, name=\"res_mlp_h1\")(feats)\n        h = jax.nn.gelu(h)\n        out = nn.Dense(32, name=\"res_mlp_h2\")(h)\n        g = jnp.tanh(out)\n        gate = 1.0 + self.residual_scale * g\n        gate = gate[:, :, None]\n        y = y_base * gate\n        return y\n\ndef _define_hyperparameters():\n    hparams = {\n        'learning_rate': 0.0009, 'rank_k': 320, 'proj_rank': 36, 'hidden_size': 160,\n        'drop': 0.05, 'residual_hidden': 32, 'residual_scale': 0.05,\n        'adam_eps': 1e-8, 'clip_norm': 1.0\n    }\n    # --- Ablation ---\n    hparams['drop'] = 0.10\n    # --- End Ablation ---\n    return hparams\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        model_params = {\n            'rank_k': hparams['rank_k'], 'proj_rank': hparams['proj_rank'],\n            'hidden_size': hparams['hidden_size'], 'drop': hparams['drop'],\n            'residual_hidden': hparams['residual_hidden'], 'residual_scale': hparams['residual_scale']\n        }\n        self.model = SotaWrapperWithAblation(**model_params)\n        self.needs_rng = True\n    def init(self, rng_key, dummy_input):\n        return self.model.init({'params': rng_key, 'dropout': rng_key}, dummy_input, training=True)\n    def apply(self, params, x, training=False, rngs=None):\n        return self.model.apply(params, x, training=training, rngs=rngs or {})\n\ndef create_network(hparams): return ModelWrapper(hparams)\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets)); curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]; curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\ndef create_optimizer(learning_rate: float):\n    hparams = _define_hyperparameters()\n    return optax.chain(optax.clip_by_global_norm(hparams['clip_norm']), optax.adam(learning_rate=learning_rate, eps=hparams['adam_eps']))\n",
