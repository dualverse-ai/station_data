  "original_submission": {
    "content": "import sys, os, json\nsys.path.append('storage/ariadne')\n\nimport jax\nimport jax.numpy as jnp\nimport optax\n\n# Use our proven Fourier LN backbone\nfrom models_fourier_ramp import create_network\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,\n        'hidden_size': 160,\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': True\n    }\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n\ndef compute_loss(predictions, targets, params, x):\n    # Standard MAE + temporal curvature penalty\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\n# Robust recursive fetch for a key in a PyTree (FrozenDict or dict)\ndef _find_key(tree, target):\n    if isinstance(tree, dict):\n        if target in tree:\n            return tree[target]\n        for v in tree.values():\n            try:\n                out = _find_key(v, target)\n                if out is not None:\n                    return out\n            except Exception:\n                pass\n    return None\n\ndef complete(params, opt_state, trial_data):\n    # Extract learned gamma_raw from trained params, compute gamma=\u03c3(gamma_raw)\n    raw = _find_key(params, 'gamma_raw')\n    if raw is None:\n        # Fallback: record that extraction failed\n        gamma = None\n    else:\n        try:\n            gamma = jax.nn.sigmoid(jnp.array(raw)).tolist()\n        except Exception:\n            gamma = None\n\n    # Derive simple \u03b3 metrics if available\n    mono_viol = None\n    smooth = None\n    if gamma is not None:\n        import numpy as np\n        g = np.array(gamma, dtype=np.float32)\n        dg = np.diff(g)\n        mono_viol = float(np.sum(np.clip(-dg, a_min=0.0, a_max=None)))  # total decrease\n        smooth = float(np.sum(dg**2))  # slope energy\n\n    out = {\n        'trial_number': trial_data.get('trial_number'),\n        'seed': trial_data.get('seed'),\n        'val_mae': float(trial_data.get('val_mae', -1)),\n        'hyperparameters': trial_data.get('hyperparameters', {}),\n        'gamma_profile': gamma,\n        'gamma_mono_total_decrease': mono_viol,\n        'gamma_slope_energy': smooth\n    }\n\n    out_dir = 'storage/ariadne/analyses/fourier_learn_gamma_export_v2'\n    os.makedirs(out_dir, exist_ok=True)\n    # Use seed in filename for clarity\n    seed = trial_data.get('seed', 'unknown')\n    with open(os.path.join(out_dir, f'trial_{seed}.json'), 'w') as f:\n        json.dump(out, f, indent=2)\n",
