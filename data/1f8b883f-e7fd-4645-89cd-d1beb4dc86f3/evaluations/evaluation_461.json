  "original_submission": {
    "content": "import flax.linen as nn\nimport jax\nimport jax.numpy as jnp\nfrom jax import random\nimport optax\n\n# Controlled replication: Fixing the seed to match the original experiment (ID 285)\nBASE_SEED = 336997\n\nNUM_NEURONS = 71721\nINPUT_HORIZON = 4\nOUTPUT_HORIZON = 32\n\nclass CnnGatingNetwork(nn.Module):\n    num_experts: int\n    @nn.compact\n    def __call__(self, x):\n        gater_input = jnp.transpose(x, (0, 2, 1))\n        y = nn.Conv(features=16, kernel_size=(128,))(gater_input)\n        y = nn.relu(y)\n        y = nn.max_pool(y, window_shape=(256,), strides=(256,))\n        y = y.reshape((y.shape[0], -1))\n        y = nn.Dense(features=32)(y)\n        y = nn.relu(y)\n        logits = nn.Dense(features=self.num_experts)(y)\n        return nn.softmax(logits, axis=-1)\n\ndef mae_with_temporal_curvature(predictions, targets, lam=1e-4):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + lam * curv_pen\n\nclass ResidualCopyHead(nn.Module):\n    @nn.compact\n    def __call__(self, x):\n        num_neurons = x.shape[2]\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        residual = nn.Dense(64)(x_flat)\n        residual = nn.relu(residual)\n        residual = nn.Dense(32)(residual)\n        residual = residual.reshape(x.shape[0], num_neurons, 32).transpose(0, 2, 1)\n        output = jnp.zeros((x.shape[0], 32, num_neurons))\n        output = output.at[:, :4, :].set(x)\n        final_output = output + residual\n        return final_output\n\nclass MoFL_Model(nn.Module):\n    num_experts: int\n    rank_k: int\n    proj_rank: int\n    mlp_hidden_size: int\n    dropout_rate: float\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        k, p = self.rank_k, self.proj_rank\n        E = self.num_experts\n\n        gating_network = CnnGatingNetwork(num_experts=E, name=\"gating\")\n        gate_weights = gating_network(x)\n\n        U_experts = self.param('U_experts', nn.initializers.lecun_normal(), (E, N, p))\n        V_experts = self.param('V_experts', nn.initializers.lecun_normal(), (E, k, p))\n\n        U_batch = jnp.einsum('be,enp->bnp', gate_weights, U_experts)\n        V_batch = jnp.einsum('be,ekp->bkp', gate_weights, V_experts)\n\n        U_batch = U_batch / (jnp.linalg.norm(U_batch, axis=1, keepdims=True) + 1e-6)\n\n        xU = jnp.einsum('btn,bnp->btp', x, U_batch)\n        factors_in = jnp.einsum('btp,bkp->btk', xU, V_batch)\n\n        factors_flat = factors_in.reshape((B, -1))\n        h = nn.Dense(self.mlp_hidden_size)(factors_flat)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(h)\n        h = nn.Dense(self.mlp_hidden_size)(h)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(h)\n\n        factors_out_flat = nn.Dense(OUTPUT_HORIZON * k)(h)\n        factors_out = factors_out_flat.reshape((B, OUTPUT_HORIZON, k))\n        factors_out_norm = nn.LayerNorm()(factors_out)\n\n        z = jnp.einsum('btk,bkp->btp', factors_out_norm, V_batch)\n        y_factor = jnp.einsum('btp,bnp->btn', z, U_batch)\n\n        y_copy = ResidualCopyHead()(x)\n        return y_factor + y_copy\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = MoFL_Model(**hparams)\n        self.needs_rng = True\n    def init(self, rng_key, dummy_input):\n        rngs = {'params': rng_key, 'dropout': rng_key}\n        return self.model.init(rngs, dummy_input, training=True)\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if rngs and 'dropout' in rngs and rngs['dropout'] is not None:\n            return self.model.apply(params, x, training=training, rngs={'dropout': rngs['dropout']})\n        else:\n            return self.model.apply(params, x, training=training)\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001, 'weight_decay': 1e-4, 'gradient_clip': 1.0,\n        'num_experts': 4, 'rank_k': 320, 'proj_rank': 32,\n        'mlp_hidden_size': 512, 'dropout_rate': 0.1,\n    }\n\ndef create_network(hparams):\n    model_params = {k: hparams.get(k) for k in ['num_experts', 'rank_k', 'proj_rank', 'mlp_hidden_size', 'dropout_rate']}\n    return ModelWrapper(hparams=model_params)\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets)\ndef create_optimizer(learning_rate: float = 0.001):\n    hparams = _define_hyperparameters()\n    return optax.chain(\n        optax.clip_by_global_norm(hparams.get('gradient_clip')),\n        optax.adamw(learning_rate=learning_rate, weight_decay=hparams.get('weight_decay'))\n    )\n",
