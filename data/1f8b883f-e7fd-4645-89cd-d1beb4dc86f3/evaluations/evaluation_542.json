  "abstract": "This experiment tests a novel synthesis of the verified SOTA architecture with my Mixture of Learned Ramps (MoLR) innovation. My previous systematic ablation has confirmed the SOTA's robustness. This submission tests the hypothesis that replacing the SOTA's static `learnable gamma` heuristic with a dynamic, sample-specific temporal shaping mechanism will improve performance. The MoLR module uses a spatial CNN gater to create a unique temporal ramp for each sample, which is then applied to the SOTA's powerful Fourier backbone. All other SOTA components and hyperparameters are kept identical for a controlled comparison.",
  "submitted_tick": 300,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport flax.linen as nn\nimport jax.numpy as jnp\nimport optax\nfrom jax import random\nfrom typing import List\n\n# --- MoLR Components (My Innovation) ---\nclass RampMLP(nn.Module):\n    @nn.compact\n    def __call__(self, x):\n        x = nn.Dense(8, name=\"dense1\")(x)\n        x = nn.relu(x)\n        x = nn.Dense(1, name=\"dense2\")(x)\n        return nn.sigmoid(x)\n\nclass CnnGatingNetwork(nn.Module):\n    num_gamma_archetypes: int\n    gating_hidden_dim: int = 32\n    gating_cnn_features: int = 16\n    gating_cnn_kernel_size: int = 128\n    gating_pool_window: int = 256\n    @nn.compact\n    def __call__(self, x):\n        x = x.transpose((0, 2, 1))\n        x = nn.Conv(features=self.gating_cnn_features, kernel_size=(self.gating_cnn_kernel_size,))(x)\n        x = nn.relu(x)\n        x = nn.max_pool(x, window_shape=(self.gating_pool_window,), strides=(self.gating_pool_window,))\n        x = x.reshape((x.shape[0], -1))\n        x = nn.Dense(self.gating_hidden_dim)(x)\n        x = nn.relu(x)\n        gating_weights = nn.Dense(self.num_gamma_archetypes)(x)\n        return nn.softmax(gating_weights, axis=-1)\n\n# --- SOTA Components (Modified) ---\nclass ResidualCopyHead(nn.Module):\n    drop: float\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape; x_flat = x.transpose(0, 2, 1).reshape(-1, T_in)\n        h = nn.Dense(64)(x_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(32)(h)\n        residual = h.reshape(B, N, 32).transpose(0, 2, 1)\n        out = jnp.zeros((B, 32, N), dtype=residual.dtype); out = out.at[:, :4, :].set(x)\n        return out + residual\n\nclass FourierForecasterLN_Ramp_Modified(nn.Module):\n    rank_k: int; proj_rank: int; hidden_size: int; drop: float\n    output_horizon: int = 32\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape; k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U_eff = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        x_fft = jnp.fft.rfft(x, axis=1)\n        x_fft_bn = jnp.transpose(x_fft, (0, 2, 1))\n        f_in_fft = jnp.einsum('bnf,np->bfp', x_fft_bn, U_eff) @ V.T\n        f_ri = jnp.concatenate([f_in_fft.real, f_in_fft.imag], axis=-1)\n        f_flat = f_ri.reshape(B, -1)\n        h = nn.Dense(self.hidden_size)(f_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(self.hidden_size)(h); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        T_out = self.output_horizon; F_out = T_out // 2 + 1\n        out_flat = nn.Dense(F_out * k * 2)(h)\n        out_ri = out_flat.reshape(B, F_out, k, 2)\n        f_fft = out_ri[..., 0] + 1j * out_ri[..., 1]\n        f_fft_n = (nn.LayerNorm()(f_fft.real) + 1j * nn.LayerNorm()(f_fft.imag))\n        y_fft = (f_fft_n @ V) @ U_eff.T\n        y_fourier = jnp.fft.irfft(y_fft, n=T_out, axis=1)\n        # REMOVED STATIC GAMMA\n        y_copy = ResidualCopyHead(drop=self.drop)(x, training=training)\n        return y_fourier, y_copy\n\n# --- Synthesized Model ---\nclass SotaMoLR(nn.Module):\n    rank_k: int; proj_rank: int; hidden_size: int; drop: float\n    residual_hidden: int; residual_scale: float\n    num_gamma_archetypes: int = 4\n    gating_hidden_dim: int = 32\n    @nn.compact\n    def __call__(self, x, training=False):\n        # 1. Generate sample-specific ramps with MoLR module\n        gating_weights = CnnGatingNetwork(\n            num_gamma_archetypes=self.num_gamma_archetypes,\n            gating_hidden_dim=self.gating_hidden_dim,\n            name=\"CnnGater\"\n        )(x)\n        timesteps = jnp.linspace(0, 1, 32).reshape(-1, 1)\n        ramp_mlps = [RampMLP(name=f\"RampMLP_{i}\") for i in range(self.num_gamma_archetypes)]\n        archetype_ramps_list = [mlp(timesteps) for mlp in ramp_mlps]\n        archetype_ramps = jnp.concatenate(archetype_ramps_list, axis=1).T\n        learnable_scalar = self.param('ramp_scalar', nn.initializers.constant(2.0), (1,))\n        batch_ramps = jnp.einsum('be,et->bt', gating_weights, archetype_ramps) * learnable_scalar\n        batch_ramps = batch_ramps[:, :, None]\n\n        # 2. Get backbone outputs (without static gamma)\n        base_network = FourierForecasterLN_Ramp_Modified(\n            rank_k=self.rank_k, proj_rank=self.proj_rank, hidden_size=self.hidden_size, drop=self.drop,\n            name=\"base_model\"\n        )\n        y_fourier, y_copy = base_network(x, training=training)\n        \n        # 3. Apply dynamic ramps and combine branches\n        y_base = batch_ramps * y_fourier + y_copy\n\n        # 4. Apply SOTA's final input-adaptive gate\n        mu = jnp.mean(x, axis=-1); sigma = jnp.std(x, axis=-1)\n        feats = jnp.concatenate([mu, sigma], axis=-1)\n        h = nn.Dense(self.residual_hidden, name=\"res_mlp_h1\")(feats)\n        h = jax.nn.gelu(h)\n        out = nn.Dense(32, name=\"res_mlp_h2\")(h)\n        g = jnp.tanh(out)\n        gate = 1.0 + self.residual_scale * g\n        y = y_base * gate[:, :, None]\n        return y\n\ndef _define_hyperparameters():\n    # Using exact SOTA HParams\n    return {\n        'learning_rate': 0.0009, 'rank_k': 320, 'proj_rank': 36, 'hidden_size': 160,\n        'drop': 0.05, 'residual_hidden': 32, 'residual_scale': 0.05,\n        'adam_eps': 1e-8, 'clip_norm': 1.0, 'gating_hidden_dim': 32\n    }\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = SotaMoLR(**{k: hparams[k] for k in [\n            'rank_k', 'proj_rank', 'hidden_size', 'drop',\n            'residual_hidden', 'residual_scale', 'gating_hidden_dim'\n        ]})\n        self.needs_rng = True\n    def init(self, rng_key, dummy_input):\n        return self.model.init({'params': rng_key, 'dropout': rng_key}, dummy_input, training=True)\n    def apply(self, params, x, training=False, rngs=None):\n        return self.model.apply(params, x, training=training, rngs=rngs or {})\n\ndef create_network(hparams): return ModelWrapper(hparams)\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets)); curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]; curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\ndef create_optimizer(learning_rate: float):\n    hparams = _define_hyperparameters()\n    return optax.chain(optax.clip_by_global_norm(hparams['clip_norm']), optax.adam(learning_rate=learning_rate, eps=hparams['adam_eps']))\n",
