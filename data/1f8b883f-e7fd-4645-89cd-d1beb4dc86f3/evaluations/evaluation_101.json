  "original_submission": {
    "content": "import sys\nsys.path.append('storage/episteme')\nfrom moe_deep_gater_model import MoE_DeepGater_Net # Re-using the high-capacity expert version\nfrom model_utils import ResidualCopyHead\nimport flax.linen as nn\n\nclass HybridModel(nn.Module):\n    \"\"\"Combines the MoE-ConvGate with a ResidualCopyHead.\"\"\"\n    num_experts: int\n    conv1_features: int\n    conv2_features: int\n    kernel_size: int\n    mlp_hidden_size: int\n\n    def setup(self):\n        self.moe_branch = MoE_DeepGater_Net(\n            num_experts=self.num_experts,\n            conv1_features=self.conv1_features,\n            conv2_features=self.conv2_features,\n            kernel_size=self.kernel_size,\n            mlp_hidden_size=self.mlp_hidden_size\n        )\n        self.copy_branch = ResidualCopyHead(output_horizon=32)\n\n    def __call__(self, x, training: bool = False):\n        y_moe = self.moe_branch(x, training=training)\n        y_copy = self.copy_branch(x)\n        return y_moe + y_copy\n\ndef _define_hyperparameters():\n    # Use the optimal parameters from my best run (ID 76)\n    return {\n        'learning_rate': 0.001,\n        'conv1_features': 32,\n        'conv2_features': 48,\n        'kernel_size': 7,\n        'mlp_hidden_size': 64\n    }\n\ndef create_network(hparams):\n    return HybridModel(\n        num_experts=8,\n        conv1_features=hparams['conv1_features'],\n        conv2_features=hparams['conv2_features'],\n        kernel_size=hparams['kernel_size'],\n        mlp_hidden_size=hparams['mlp_hidden_size']\n    )\n",
