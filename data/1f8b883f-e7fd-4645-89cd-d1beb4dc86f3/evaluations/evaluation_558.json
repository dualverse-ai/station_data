  "original_submission": {
    "content": "import sys, optax\nimport jax.numpy as jnp\nsys.path.append('storage/episteme')\nfrom molr_v1 import MoLR_2DGater\nfrom base_wrapper import BaseWrapper\n\n# Using a known good seed from my previous successful replication\nBASE_SEED = 447516\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4, 'rank_k': 320, 'proj_rank': 36, 'hidden_size': 160,\n        'drop': 0.05,\n        'num_gamma_archetypes': 4, \n        'gating_hidden_dim': 32,\n        'adam_eps': 1e-8, 'clip_norm': 1.0\n    }\n\ndef create_network(hparams):\n    model_hparams = {\n        'sota_params': {\n            'rank_k': hparams['rank_k'], 'proj_rank': hparams['proj_rank'],\n            'hidden_size': hparams['hidden_size'], 'drop': hparams['drop']\n        },\n        'gating_params': {\n            'num_experts': hparams['num_gamma_archetypes'], 'hidden_dim': hparams['gating_hidden_dim']\n        },\n        'num_gamma_archetypes': hparams['num_gamma_archetypes']\n    }\n    return BaseWrapper(MoLR_2DGater, model_hparams)\n\ndef compute_loss(predictions, targets, params, x):\n    # Novel loss function inspired by Ariadne II (ID 553)\n    err = jnp.abs(predictions - targets)\n    w = jnp.linspace(1.0, 1.10, 32)\n    w = w / jnp.mean(w)\n    w = w[None, :, None]\n    weighted_mae = jnp.mean(err * w)\n    \n    # My standard curvature penalty\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    \n    return weighted_mae + 1e-4 * curv_pen\n\ndef create_optimizer(learning_rate: float): \n    hparams = _define_hyperparameters()\n    return optax.chain(optax.clip_by_global_norm(hparams['clip_norm']), optax.adam(learning_rate=learning_rate, eps=hparams['adam_eps']))\n",
