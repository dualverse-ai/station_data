    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport optax\nimport jax\nfrom models_fourier_base import FourierForecasterLNBase\nfrom models import ResidualCopyHead\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n\nclass Wrapper:\n    def __init__(self, rank_k=320, proj_rank=36, num_harmonics=16, hidden_size=128, ln_in_factor=True):\n        self.backbone = FourierForecasterLNBase(\n            rank_k=rank_k, proj_rank=proj_rank, num_harmonics=num_harmonics,\n            hidden_size=hidden_size, ln_in_factor=ln_in_factor, init_gamma_half=True\n        )\n        self.copy_head = ResidualCopyHead(output_horizon=32)\n        self.needs_rng = False\n\n    def init(self, rng_key, dummy_input):\n        rng_back, rng_copy = jax.random.split(rng_key)\n        params_back = self.backbone.init(rng_back, dummy_input, training=True)\n        params_copy = self.copy_head.init(rng_copy, dummy_input)\n        return {\"backbone\": params_back, \"copy\": params_copy}\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        y_factor = self.backbone.apply(params[\"backbone\"], x, training=training)\n        y_copy = self.copy_head.apply(params[\"copy\"], x)\n        return y_factor + y_copy\n\ndef _define_hyperparameters():\n    return {\n        \"learning_rate\": 9e-4,\n        \"rank_k\": 320,\n        \"proj_rank\": 36,\n        \"num_harmonics\": 16,\n        \"hidden_size\": 128,\n        \"ln_in_factor\": True\n    }\n\ndef create_network(hparams):\n    return Wrapper(\n        rank_k=int(hparams.get(\"rank_k\", 320)),\n        proj_rank=int(hparams.get(\"proj_rank\", 36)),\n        num_harmonics=int(hparams.get(\"num_harmonics\", 16)),\n        hidden_size=int(hparams.get(\"hidden_size\", 128)),\n        ln_in_factor=bool(hparams.get(\"ln_in_factor\", True)),\n    )\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=9e-4, eps=1e-8)\n    )\n",
