  "original_submission": {
    "content": "import sys, os, json\nsys.path.append('storage/ariadne')\n\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport optax\n\nfrom models_fourier_gamma_residual import create_network\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,\n        'hidden_size': 160,\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': True,\n        'residual_hidden': 32,\n        'residual_scale': 0.05  # smaller than \u00b17% test\n    }\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n\n# Utilities mirrored from earlier exports\ndef _find_key(tree, target):\n    if isinstance(tree, dict):\n        if target in tree:\n            return tree[target]\n        for v in tree.values():\n            res = _find_key(v, target)\n            if res is not None:\n                return res\n    return None\n\ndef _per_condition_step_mae(network, params, bs=4):\n    val_path = 'storage/system/data/val_data.npy'\n    lab_path = 'storage/system/data/val_condition_labels.npy'\n    Xv = np.load(val_path)             # (T,N)\n    Lv = np.load(lab_path).astype(int) # (T,)\n    T, N = Xv.shape\n    in_h, out_h = 4, 32\n    n_win = T - in_h - out_h + 1\n    if n_win <= 0:\n        return None\n    C = int(Lv.max() + 1)\n    sums = np.zeros((C, out_h), dtype=np.float64)\n    cnts = np.zeros((C, out_h), dtype=np.int64)\n    overall_sum = np.zeros((out_h,), dtype=np.float64)\n    overall_cnt = 0\n    for i0 in range(0, n_win, bs):\n        b = min(bs, n_win - i0)\n        xb = np.stack([Xv[i:i+in_h, :] for i in range(i0, i0 + b)], axis=0).astype(np.float32)\n        yb = np.stack([Xv[i+in_h:i+in_h+out_h, :] for i in range(i0, i0 + b)], axis=0).astype(np.float32)\n        preds = network.apply(params, xb, training=False)  # (b,32,N)\n        err = np.abs(np.array(preds) - yb).mean(axis=2)    # (b,32)\n        overall_sum += err.sum(axis=0); overall_cnt += b\n        for bi in range(b):\n            t0 = i0 + bi\n            step_labels = Lv[t0+in_h:t0+in_h+out_h]\n            for s in range(out_h):\n                c = int(step_labels[s])\n                sums[c, s] += float(err[bi, s]); cnts[c, s] += 1\n    with np.errstate(divide='ignore', invalid='ignore'):\n        means = np.where(cnts > 0, sums / np.maximum(cnts, 1), np.nan)\n    overall = overall_sum / max(overall_cnt, 1)\n    return {'step_mae_overall': overall.astype(np.float32).tolist(),\n            'step_mae_by_condition': means.astype(np.float32).tolist(),\n            'counts_by_condition': cnts.tolist()}\n\ndef _residual_gate_stats(params, bs=4):\n    \"\"\"Estimate residual gate magnitude and late-horizon emphasis over validation windows.\"\"\"\n    # Access residual params\n    res = _find_key(params, 'res')\n    if res is None:\n        return None\n    W1 = np.array(res['W1']); b1 = np.array(res['b1'])\n    W2 = np.array(res['W2']); b2 = np.array(res['b2'])\n    # Load val\n    Xv = np.load('storage/system/data/val_data.npy')  # (T,N)\n    T, N = Xv.shape; in_h, out_h = 4, 32\n    n_win = T - in_h - out_h + 1\n    if n_win <= 0:\n        return None\n    abs_sum = np.zeros((out_h,), dtype=np.float64)\n    mean_sum = np.zeros((out_h,), dtype=np.float64)\n    cnt = 0\n    # Quick pass\n    for i0 in range(0, n_win, bs):\n        b = min(bs, n_win - i0)\n        xb = np.stack([Xv[i:i+in_h, :] for i in range(i0, i0 + b)], axis=0).astype(np.float32)  # (b,4,N)\n        mu = xb.mean(axis=-1)    # (b,4)\n        sigma = xb.std(axis=-1)  # (b,4)\n        feats = np.concatenate([mu, sigma], axis=-1)  # (b,8)\n        h = np.matmul(feats, W1) + b1  # (b,H)\n        h = np.tanh(0.5 * h)  # cheap GELU-ish; exact GELU not critical for stats\n        out = np.matmul(h, W2) + b2     # (b,32)\n        g = np.tanh(out)                # in [-1,1]\n        abs_sum += np.abs(g).sum(axis=0)\n        mean_sum += g.sum(axis=0)\n        cnt += b\n    return {\n        'gate_abs_mean_by_step': (abs_sum / max(cnt, 1)).astype(np.float32).tolist(),\n        'gate_mean_by_step': (mean_sum / max(cnt, 1)).astype(np.float32).tolist(),\n        'windows': int(cnt)\n    }\n\ndef complete(params, opt_state, trial_data):\n    hparams = trial_data.get('hyperparameters', {})\n    network = create_network(hparams)\n    per_cond = _per_condition_step_mae(network, params, bs=4)\n    gate_stats = _residual_gate_stats(params, bs=8)\n    out = {\n        'trial_number': int(trial_data.get('trial_number', -1)),\n        'seed': int(trial_data.get('seed', -1)),\n        'val_mae': float(trial_data.get('val_mae', -1.0)),\n        'hyperparameters': hparams,\n        'residual_gate_stats': gate_stats,\n        'per_condition': per_cond\n    }\n    out_dir = 'storage/ariadne/analyses/fourier_gamma_residual_poc'\n    os.makedirs(out_dir, exist_ok=True)\n    seed = trial_data.get('seed', 'unknown')\n    with open(os.path.join(out_dir, f'trial_{seed}.json'), 'w') as f:\n        json.dump(out, f, indent=2)\n",
