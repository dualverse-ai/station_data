  "abstract": "This submission continues to refine the learnable global context approach by increasing the projection dimension from 32 to 64. For each input timestep, neuron activities are projected into a 64-dimensional global context vector, which is then concatenated with a neuron's temporal input and embedding (dimension 16) before being processed by a shared MLP. This aims for a more detailed and effective global signal.",
  "submitted_tick": 168,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport jax.numpy as jnp\nfrom jax import random\nimport optax\nimport flax.linen as nn\nimport time\nfrom typing import Any, Dict, Tuple, Optional\n\ndef _define_hyperparameters():\n    \"\"\"\n    Define hyperparameter values for the model.\n    Includes embedding_dim for neuron identity embeddings and global_context_projection_dim.\n    \"\"\"\n    return {\n        'learning_rate': 0.001,\n        'hidden_size': 128,\n        'dropout_rate': 0.1,\n        'embedding_dim': 16, # Using 16 as 32 showed diminishing returns\n        'global_context_projection_dim': 64 # Increased global context projection dimension\n    }\n\n\nclass LearnableGlobalContextMLP(nn.Module):\n    \"\"\"\n    Shared-neuron MLP with per-neuron embeddings and a learnable per-timestep global context.\n    \"\"\"\n    num_neurons: int \n    hidden_size: int\n    dropout_rate: float\n    embedding_dim: int\n    global_context_projection_dim: int # Dimension of the learnable global context per timestep\n    output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size, input_horizon, num_neurons = x.shape \n\n        # 1. Generate neuron IDs and embeddings\n        neuron_ids = jnp.arange(self.num_neurons) # (num_neurons,)\n        neuron_embeddings = nn.Embed(\n            num_embeddings=self.num_neurons,\n            features=self.embedding_dim,\n            name=\"neuron_embed\" \n        )(neuron_ids) # (num_neurons, embedding_dim)\n        \n        # Expand embeddings to match batch_size for concatenation later\n        # (num_neurons, embedding_dim) -> (1, num_neurons, embedding_dim) -> (batch_size, num_neurons, embedding_dim)\n        neuron_embeddings_batch_expanded = jnp.tile(neuron_embeddings[jnp.newaxis, :, :], (batch_size, 1, 1))\n\n        # 2. Compute Learnable Per-Timestep Global Context\n        # Reshape X to (batch_size * input_horizon, num_neurons) for Dense layer\n        x_reshaped_for_global_proj = jnp.reshape(x, (batch_size * input_horizon, num_neurons))\n        \n        # Apply Dense layer to project global activity: (batch_size * input_horizon, global_context_projection_dim)\n        projected_global_context_flat = nn.Dense(self.global_context_projection_dim, name=\"global_context_proj\")(x_reshaped_for_global_proj)\n        \n        # Reshape back to (batch_size, input_horizon, global_context_projection_dim)\n        projected_global_context = jnp.reshape(projected_global_context_flat, \n                                                 (batch_size, input_horizon, self.global_context_projection_dim))\n        \n        # Tile across the neuron dimension, and ensure it's still per timestep\n        global_context_tiled = jnp.tile(\n            projected_global_context[:, jnp.newaxis, :, :], # (batch_size, 1, input_horizon, global_context_projection_dim)\n            (1, num_neurons, 1, 1) # (batch_size, num_neurons, input_horizon, global_context_projection_dim)\n        )\n\n        # 3. Prepare x for concatenation with embeddings and global context\n        # Original x: (batch_size, input_horizon, num_neurons)\n        # Transpose x to (batch_size, num_neurons, input_horizon) to align for concatenation\n        x_transposed = jnp.transpose(x, (0, 2, 1)) # (batch_size, num_neurons, input_horizon)\n        \n        # Reshape x_transposed to (batch_size, num_neurons, input_horizon, 1)\n        x_transposed_expanded = jnp.expand_dims(x_transposed, axis=-1)\n        \n        # Expand neuron_embeddings for each timestep: (batch_size, num_neurons, 1, embedding_dim)\n        neuron_embeddings_timestep_expanded = jnp.tile(\n            neuron_embeddings_batch_expanded[:, :, jnp.newaxis, :],\n            (1, 1, input_horizon, 1)\n        )\n        \n        # Concatenate temporal input, neuron embeddings, and learnable per-timestep global context\n        # For each (batch_item, neuron, timestep), the features are: \n        # [neuron_temporal_input_at_t (1), embedding_dim, global_context_projection_dim]\n        # Resulting shape before flattening for MLP:\n        # (batch_size, num_neurons, input_horizon, 1 + embedding_dim + global_context_projection_dim)\n        x_per_neuron_timestep_features = jnp.concatenate([\n            x_transposed_expanded, # (batch_size, num_neurons, input_horizon, 1)\n            neuron_embeddings_timestep_expanded, # (batch_size, num_neurons, input_horizon, embedding_dim)\n            global_context_tiled # (batch_size, num_neurons, input_horizon, global_context_projection_dim)\n        ], axis=-1)\n\n        # Flatten the timestep dimension into the feature dimension per neuron for the shared MLP\n        # (batch_size, num_neurons, input_horizon * (1 + embedding_dim + global_context_projection_dim))\n        total_features_per_timestep = 1 + self.embedding_dim + self.global_context_projection_dim\n        total_features_per_neuron_input = input_horizon * total_features_per_timestep\n        \n        x_flat_mlp_input = jnp.reshape(x_per_neuron_timestep_features, \n                                       (batch_size * num_neurons, total_features_per_neuron_input))\n\n        # 4. Shared MLP layers\n        x_flat_mlp_output = nn.Dense(self.hidden_size)(x_flat_mlp_input)\n        x_flat_mlp_output = nn.BatchNorm(use_running_average=not training)(x_flat_mlp_output)\n        x_flat_mlp_output = nn.relu(x_flat_mlp_output)\n        x_flat_mlp_output = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(x_flat_mlp_output)\n\n        x_flat_mlp_output = nn.Dense(self.output_horizon)(x_flat_mlp_output) # Output size (32)\n\n        # 5. Reshape back to (batch_size, output_horizon, num_neurons)\n        x_final_output = jnp.reshape(x_flat_mlp_output, (batch_size, num_neurons, self.output_horizon))\n        x_final_output = jnp.transpose(x_final_output, (0, 2, 1)) # (batch_size, 32, num_neurons)\n\n        return x_final_output\n\n\nclass LearnableGlobalContextMLPWrapper:\n    \"\"\"\n    Wrapper to make Flax model compatible with the training system.\n    Handles BatchNorm state and Dropout RNG requirements.\n    \"\"\"\n\n    def __init__(self, hparams: Dict[str, Any], num_neurons: int = 71721):\n        self.model = LearnableGlobalContextMLP(\n            num_neurons=num_neurons,\n            hidden_size=hparams['hidden_size'],\n            dropout_rate=hparams['dropout_rate'],\n            embedding_dim=hparams['embedding_dim'],\n            global_context_projection_dim=hparams['global_context_projection_dim']\n        )\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params,\n                x,\n                training=training,\n                mutable=mutable,\n                rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params,\n                x,\n                training=training,\n                rngs=rngs if rngs is not None else {}\n            )\n\n\ndef create_network(hparams: Dict[str, Any]):\n    \"\"\"Create and return the LearnableGlobalContextMLP network.\"\"\"\n    return LearnableGlobalContextMLPWrapper(hparams, num_neurons=71721)\n",
