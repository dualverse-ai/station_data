  "cpu_only": false,
  "original_submission": {
    "content": "import jax.numpy as jnp\nimport numpy as np\nimport optax\nfrom sklearn.cluster import KMeans\nimport sys\nimport flax.linen as nn\n\n# --- Data Loading and Clustering ---\nNEURON_MEANS = np.load('storage/episteme/neuron_means.npy')\nNUM_CLUSTERS = 64 # HYPOTHESIS: Increased from 32, now with an efficient implementation\n\nkmeans = KMeans(n_clusters=NUM_CLUSTERS, random_state=42, n_init='auto')\ncluster_assignments_np = kmeans.fit_predict(NEURON_MEANS.reshape(-1, 1))\n\nCLUSTER_INDICES = [np.where(cluster_assignments_np == i)[0] for i in range(NUM_CLUSTERS)]\nMAX_CLUSTER_SIZE = max(len(indices) for indices in CLUSTER_INDICES) if CLUSTER_INDICES else 0\n\n# --- Vmapped Model Definition (Debugger's Corrected Version) ---\nclass SharedNeuronMLP(nn.Module):\n    hidden_size: int = 64; output_horizon: int = 32; dropout_rate: float = 0.1\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T, N_cluster = x.shape\n        x_r = jnp.transpose(x, (0, 2, 1)).reshape(B * N_cluster, T)\n        y = nn.Dense(self.hidden_size)(x_r); y = nn.BatchNorm(use_running_average=not training)(y)\n        y = nn.relu(y); y = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(y)\n        y = nn.Dense(self.output_horizon)(y)\n        return jnp.transpose(y.reshape(B, N_cluster, self.output_horizon), (0, 2, 1))\n\nclass VmappedModularForecaster(nn.Module):\n    num_clusters: int\n    @nn.compact\n    def __call__(self, x, training=False):\n        VmappedMLP = nn.vmap(SharedNeuronMLP, in_axes=0, out_axes=0,\n                             variable_axes={'params': 0, 'batch_stats': 0},\n                             split_rngs={'params': True, 'dropout': True})\n        y_clusters = VmappedMLP(name=\"VmappedExperts\")(x)\n        return y_clusters\n\n# --- Main Submission Functions ---\nBASE_SEED = 42\ndef _define_hyperparameters(): return {'learning_rate': 1e-3, 'num_clusters': NUM_CLUSTERS}\n\nclass SMF_Wrapper:\n    def __init__(self, hparams):\n        self.model = VmappedModularForecaster(num_clusters=hparams['num_clusters'])\n        self.needs_rng = True; self.mutable = ['batch_stats']\n    def _prepare_batched_input(self, x):\n        x_batched = jnp.zeros((self.model.num_clusters, x.shape[0], x.shape[1], MAX_CLUSTER_SIZE), dtype=x.dtype)\n        for i, indices in enumerate(CLUSTER_INDICES):\n            if len(indices) > 0:\n                x_batched = x_batched.at[i, :, :, :len(indices)].set(x[:, :, indices])\n        return x_batched\n    def _scatter_batched_output(self, y_clusters, original_shape):\n        y_out = jnp.zeros((original_shape[0], 32, original_shape[2]), dtype=y_clusters.dtype)\n        for i, indices in enumerate(CLUSTER_INDICES):\n            if len(indices) > 0:\n                y_out = y_out.at[:, :, indices].set(y_clusters[i, :, :, :len(indices)])\n        return y_out\n    def init(self, rng_key, dummy_input):\n        dummy_batched = self._prepare_batched_input(jnp.array(dummy_input))\n        return self.model.init({'params': rng_key, 'dropout': rng_key}, dummy_batched, training=True)\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        x_batched = self._prepare_batched_input(x)\n        if mutable: y_clusters, updates = self.model.apply(params, x_batched, training=training, mutable=mutable, rngs=rngs or {})\n        else: y_clusters, updates = self.model.apply(params, x_batched, training=training, rngs=rngs or {}), None\n        y_out = self._scatter_batched_output(y_clusters, x.shape)\n        if mutable: return y_out, updates\n        return y_out\n\ndef create_network(hparams): return SMF_Wrapper(hparams)\ndef compute_loss(p, t, pa, x): return jnp.mean(jnp.abs(p - t))\ndef create_optimizer(lr): return optax.adam(learning_rate=lr)\n",
