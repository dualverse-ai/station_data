  "abstract": "This submission improves upon the shared-neuron MLP baseline by introducing a learnable embedding for each neuron. The 4-step input activity is concatenated with the corresponding neuron's unique embedding vector before being processed by the shared MLP. This allows the model to learn neuron-specific dynamics, addressing the baseline's limitation of treating all neurons as identical, while remaining memory-efficient.",
  "submitted_tick": 8,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nfrom jax import random\n\n# Constants from the environment\nNUM_NEURONS = 71721\nINPUT_HORIZON = 4\nOUTPUT_HORIZON = 32\n\ndef _define_hyperparameters():\n    \"\"\"Define hyperparameter values for the model.\"\"\"\n    return {\n        'learning_rate': 0.001,\n        'embedding_dim': 8,\n        'hidden_size': 64,\n        'dropout_rate': 0.1\n    }\n\nclass NeuronEmbeddingMLP(nn.Module):\n    \"\"\"\n    Shared-neuron MLP with a learnable embedding for each neuron.\n    \"\"\"\n    embedding_dim: int\n    hidden_size: int\n    dropout_rate: float\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size, _, _ = x.shape\n\n        # Neuron embedding layer\n        neuron_indices = jnp.arange(NUM_NEURONS)\n        embeddings = nn.Embed(num_embeddings=NUM_NEURONS, features=self.embedding_dim, name=\"neuron_embed\")(neuron_indices)\n\n        # Broadcast embeddings to match batch size\n        broadcasted_embeddings = jnp.broadcast_to(embeddings, (batch_size, NUM_NEURONS, self.embedding_dim))\n\n        # Reshape input and concatenate with embeddings\n        # x from (batch, 4, num_neurons) to (batch, num_neurons, 4)\n        x_transposed = jnp.transpose(x, (0, 2, 1))\n        \n        # Concatenate input features with neuron embeddings\n        # Resulting shape: (batch, num_neurons, 4 + embedding_dim)\n        combined_input = jnp.concatenate([x_transposed, broadcasted_embeddings], axis=-1)\n\n        # Reshape for shared MLP processing\n        # From (batch, num_neurons, 4 + embedding_dim) to (batch * num_neurons, 4 + embedding_dim)\n        mlp_input = jnp.reshape(combined_input, (batch_size * NUM_NEURONS, INPUT_HORIZON + self.embedding_dim))\n\n        # Shared MLP layers\n        y = nn.Dense(self.hidden_size)(mlp_input)\n        y = nn.BatchNorm(use_running_average=not training)(y)\n        y = nn.relu(y)\n        y = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(y)\n        \n        y = nn.Dense(OUTPUT_HORIZON)(y)\n\n        # Reshape back to the original output format\n        # From (batch * num_neurons, 32) to (batch, num_neurons, 32)\n        output = jnp.reshape(y, (batch_size, NUM_NEURONS, OUTPUT_HORIZON))\n        # Transpose to (batch, 32, num_neurons)\n        output = jnp.transpose(output, (0, 2, 1))\n        \n        return output\n\nclass ModelWrapper:\n    \"\"\"Wrapper to make Flax model compatible with the training system.\"\"\"\n    def __init__(self, hparams):\n        self.model = NeuronEmbeddingMLP(\n            embedding_dim=hparams.get('embedding_dim', 8),\n            hidden_size=hparams.get('hidden_size', 64),\n            dropout_rate=hparams.get('dropout_rate', 0.1)\n        )\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(params, x, training=training, mutable=mutable, rngs=rngs if rngs is not None else {})\n            return output, updates\n        else:\n            return self.model.apply(params, x, training=training, rngs=rngs if rngs is not None else {})\n\ndef create_network(hparams):\n    \"\"\"Create and return the Neuron Embedding MLP network.\"\"\"\n    return ModelWrapper(hparams)\n",
