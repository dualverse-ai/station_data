  "cpu_only": false,
  "original_submission": {
    "content": "import sys\nimport flax.linen as nn\nimport jax.numpy as jnp\nimport optax\n\n# Controlled experiment: Fixing the seed to match the SOTA run\nBASE_SEED = 447516\n\n# --- Start of New Gating Module ---\nclass CnnGatingNetwork2D(nn.Module):\n    num_experts: int\n    hidden_dim: int\n    @nn.compact\n    def __call__(self, x):\n        # Input x shape: (B, T_in=4, N=71721)\n        # Add a channel dimension for 2D convolution\n        gater_input = x[:, None, :, :] # (B, 1, 4, N)\n        y = nn.Conv(features=16, kernel_size=(2, 64), strides=(1, 64))(gater_input)\n        y = nn.relu(y)\n        y = y.reshape((y.shape[0], -1)) # Flatten\n        y = nn.Dense(features=self.hidden_dim)(y)\n        y = nn.relu(y)\n        logits = nn.Dense(features=self.num_experts)(y)\n        return nn.softmax(logits, axis=-1)\n# --- End of New Gating Module ---\n\nclass RampMLP(nn.Module):\n    @nn.compact\n    def __call__(self, t):\n        t = t[:, None]\n        h = nn.Dense(8, name=\"MLP_hidden\")(t)\n        h = nn.relu(h)\n        h = nn.Dense(1, name=\"MLP_output\")(h)\n        ramp_unscaled = nn.sigmoid(h.squeeze())\n        ramp_scale = self.param('ramp_scale', nn.initializers.constant(2.0), ())\n        return ramp_unscaled * ramp_scale\n\nclass ResidualCopyHead(nn.Module):\n    drop: float\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, _, N = x.shape\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        h = nn.Dense(64)(x_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(32)(h)\n        residual = h.reshape(B, N, 32).transpose(0, 2, 1)\n        out = jnp.zeros((B, 32, N), dtype=residual.dtype)\n        out = out.at[:, :4, :].set(x)\n        return out + residual\n\nclass FourierBackbone(nn.Module):\n    rank_k: int; proj_rank: int; hidden_size: int; drop: float\n    @nn.compact\n    def __call__(self, x, training=False):\n        B, _, N = x.shape; k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U_eff = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        x_fft = jnp.fft.rfft(x, axis=1)\n        x_fft_bn = jnp.transpose(x_fft, (0, 2, 1))\n        f_in_fft = jnp.einsum('bnf,np->bfp', x_fft_bn, U_eff) @ V.T\n        f_ri = jnp.concatenate([f_in_fft.real, f_in_fft.imag], axis=-1)\n        f_flat = f_ri.reshape(B, -1)\n        h = nn.Dense(self.hidden_size)(f_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(self.hidden_size)(h); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        out_flat = nn.Dense((32 // 2 + 1) * k * 2)(h)\n        out_ri = out_flat.reshape(B, 32 // 2 + 1, k, 2)\n        f_fft = out_ri[..., 0] + 1j * out_ri[..., 1]\n        f_fft_n = (nn.LayerNorm()(f_fft.real) + 1j * nn.LayerNorm()(f_fft.imag))\n        y_fft = (f_fft_n @ V) @ U_eff.T\n        y_fourier = jnp.fft.irfft(y_fft, n=32, axis=1)\n        return y_fourier\n        \nclass MoLR_2DGater(nn.Module):\n    sota_params: dict; gating_params: dict; num_gamma_archetypes: int\n    @nn.compact\n    def __call__(self, x, training=False):\n        y_fourier = FourierBackbone(**self.sota_params, name=\"Fourier_Branch\")(x, training=training)\n        y_copy = ResidualCopyHead(drop=self.sota_params['drop'], name=\"Copy_Branch\")(x, training=training)\n        gating_network = CnnGatingNetwork2D(**self.gating_params, name=\"gating\")\n        gating_weights = gating_network(x)\n        ramp_mlps = [RampMLP(name=f\"RampMLP_{i}\") for i in range(self.num_gamma_archetypes)]\n        t = jnp.linspace(0.0, 1.0, 32, dtype=y_fourier.dtype)\n        archetype_ramps = jnp.stack([mlp(t) for mlp in ramp_mlps])\n        batch_ramps = jnp.einsum('be,et->bt', gating_weights, archetype_ramps)\n        final_output = y_copy + y_fourier * batch_ramps[:, :, None]\n        return final_output\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4, 'rank_k': 320, 'proj_rank': 36, 'hidden_size': 160,\n        'drop': 0.05, 'num_gamma_archetypes': 4,\n        'gating_hidden_dim': 32\n    }\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        sota_params = {'rank_k': hparams['rank_k'], 'proj_rank': hparams['proj_rank'], 'hidden_size': hparams['hidden_size'], 'drop': hparams['drop']}\n        gating_params = {'num_experts': hparams['num_gamma_archetypes'], 'hidden_dim': hparams['gating_hidden_dim']}\n        self.model = MoLR_2DGater(sota_params=sota_params, gating_params=gating_params, num_gamma_archetypes=hparams['num_gamma_archetypes'])\n        self.needs_rng = True\n    def init(self, rng_key, dummy_input): return self.model.init({'params': rng_key, 'dropout': rng_key}, dummy_input, training=True)\n    def apply(self, params, x, training=False, rngs=None): return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams): return ModelWrapper(hparams)\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets)); curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]; curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\ndef create_optimizer(learning_rate: float): return optax.chain(optax.clip_by_global_norm(1.0), optax.adam(learning_rate=learning_rate))\n",
