  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nimport optax\nfrom jax import random\n\nclass ResidualCopyHead(nn.Module):\n    drop: float = 0.05\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        h = nn.Dense(64)(x_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(32)(h)\n        residual = h.reshape(B, N, 32).transpose(0, 2, 1)\n        out = jnp.zeros((B, 32, N), dtype=residual.dtype)\n        out = out.at[:, :4, :].set(x)\n        return out + residual\n\nclass FourierForecasterLN_Ramp(nn.Module):\n    rank_k: int; proj_rank: int; hidden_size: int; drop: float; output_horizon: int; learn_gamma: bool\n    gamma_start: float = 0.25 # Default, not used if learn_gamma=True\n    gamma_end: float = 0.99   # Default, not used if learn_gamma=True\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape; k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U_eff = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        x_fft = jnp.fft.rfft(x, axis=1)\n        x_fft_bn = jnp.transpose(x_fft, (0, 2, 1))\n        f_in_fft = jnp.einsum('bnf,np->bfp', x_fft_bn, U_eff) @ V.T\n        f_ri = jnp.concatenate([f_in_fft.real, f_in_fft.imag], axis=-1)\n        f_flat = f_ri.reshape(B, -1)\n        h = nn.Dense(self.hidden_size)(f_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(self.hidden_size)(h); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        T_out = self.output_horizon; F_out = T_out // 2 + 1\n        out_flat = nn.Dense(F_out * k * 2)(h)\n        out_ri = out_flat.reshape(B, F_out, k, 2)\n        f_fft = out_ri[..., 0] + 1j * out_ri[..., 1]\n        f_fft_n = (nn.LayerNorm()(f_fft.real) + 1j * nn.LayerNorm()(f_fft.imag))\n        y_fft = (f_fft_n @ V) @ U_eff.T\n        y_fourier = jnp.fft.irfft(y_fft, n=T_out, axis=1)\n        if self.learn_gamma:\n            gamma_raw = self.param('gamma_raw', nn.initializers.zeros, (T_out,))\n            gamma = nn.sigmoid(gamma_raw)[None, :, None]\n        else: # Fallback to fixed ramp\n            t = jnp.linspace(0.0, 1.0, T_out, dtype=y_fourier.dtype)\n            g = self.gamma_start + (self.gamma_end - self.gamma_start) * t\n            gamma = g[None, :, None]\n        y_fourier_ramped = gamma * y_fourier\n        y_copy = ResidualCopyHead(drop=self.drop)(x, training=training)\n        return y_copy + y_fourier_ramped\n\nclass Wrapper:\n    def __init__(self, hparams):\n        self.model = FourierForecasterLN_Ramp(\n            rank_k=hparams['rank_k'], proj_rank=hparams['proj_rank'],\n            hidden_size=hparams['hidden_size'], drop=hparams['drop'],\n            output_horizon=32, learn_gamma=hparams['learn_gamma']\n        )\n        self.needs_rng = True\n    def init(self, rng_key, dummy_input):\n        return self.model.init({'params': rng_key, 'dropout': rng_key}, dummy_input, training=True)\n    def apply(self, params, x, training=False, rngs=None):\n        return self.model.apply(params, x, training=training, rngs=(rngs or {}))\n\ndef _define_hyperparameters():\n    # Matching Ariadne I's SOTA run ID 450\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,\n        'hidden_size': 160,\n        'drop': 0.05,\n        'learn_gamma': True\n    }\n\ndef create_network(hparams): return Wrapper(hparams)\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets)); curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]; curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\ndef create_optimizer(learning_rate: float): return optax.chain(optax.clip_by_global_norm(1.0), optax.adam(learning_rate=learning_rate))\n",
