  "original_submission": {
    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport optax\nimport jax.numpy as jnp\nfrom models_mol import Osc2CtxFLoadMoL\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\nV_ORTHO_LAM = 1e-5  # ||V^T V - I||_F^2\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,\n        'proj_rank': 32,\n        'num_loadings': 2,\n        'hidden_size': 96,\n        'normalize_u': True,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99\n    }\n\nclass Wrapper:\n    def __init__(self, rank_k=320, proj_rank=32, num_loadings=2, hidden_size=96, normalize_u=True, gamma_start=0.25, gamma_end=0.99):\n        self.model = Osc2CtxFLoadMoL(\n            rank_k=rank_k,\n            proj_rank=proj_rank,\n            num_loadings=num_loadings,\n            hidden_size=hidden_size,\n            normalize_u=normalize_u,\n            gamma_start=gamma_start,\n            gamma_end=gamma_end\n        )\n        self.needs_rng = False\n\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x, training=training)\n\ndef create_network(hparams):\n    return Wrapper(\n        rank_k=int(hparams.get('rank_k', 320)),\n        proj_rank=int(hparams.get('proj_rank', 32)),\n        num_loadings=int(hparams.get('num_loadings', 2)),\n        hidden_size=int(hparams.get('hidden_size', 96)),\n        normalize_u=bool(hparams.get('normalize_u', True)),\n        gamma_start=float(hparams.get('gamma_start', 0.25)),\n        gamma_end=float(hparams.get('gamma_end', 0.99))\n    )\n\ndef compute_loss(predictions, targets, params, x):\n    # Base MAE + temporal curvature\n    base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n    # V orthogonality penalty: ||V^T V - I||_F^2\n    V = params['params']['V']\n    G = V.T @ V\n    I = jnp.eye(G.shape[0], dtype=G.dtype)\n    ortho = jnp.sum((G - I) ** 2)\n    return base + V_ORTHO_LAM * ortho\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate, eps=1e-8)\n    )\n",
