  "abstract": "This submission extends the Shared-Neuron MLP baseline by incorporating both learnable static neuron embeddings and per-neuron, per-timestep biases. Each of the 71,721 neurons is assigned a unique embedding vector (dimension 8), which is concatenated to the neural activity input features for the shared MLP. This allows the model to learn neuron-specific characteristics, thereby moving beyond the assumption of identical neurons, while still leveraging shared weights for temporal processing. Per-neuron output biases are retained from the previous successful submission for further customization.",
  "submitted_tick": 13,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport jax.numpy as jnp\nimport flax.linen as nn\nfrom jax import random\nimport optax\nfrom typing import Tuple, Dict, Any, Optional\n\n# Replicate SharedNeuronMLP from defaults.py as it's not directly importable\n# Modified to take input_dim as an argument, to accommodate neuron embeddings\nclass SharedNeuronMLP(nn.Module):\n    input_dim: int # Now variable due to embeddings\n    hidden_size: int = 64\n    output_horizon: int = 32\n    dropout_rate: float = 0.1\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        # x shape will be (batch_size * num_neurons, input_dim)\n        # where input_dim = original input_horizon + neuron_embedding_dim\n\n        # Shared MLP: input_dim -> hidden (64) -> output (32)\n        x = nn.Dense(self.hidden_size)(x)\n        x = nn.BatchNorm(use_running_average=not training)(x)\n        x = nn.relu(x)\n        x = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(x)\n\n        x = nn.Dense(self.output_horizon)(x)\n        return x\n\nclass SharedMLPWithEmbeddingsAndBias(nn.Module):\n    \"\"\"\n    Wraps SharedNeuronMLP, adds learnable per-neuron embeddings, and per-neuron, per-timestep bias.\n    \"\"\"\n    # All fields without defaults first\n    mlp_hidden_size: int\n    mlp_dropout_rate: float\n    num_neurons: int\n    input_horizon: int # Original input horizon (4)\n    neuron_embedding_dim: int\n    # Fields with defaults last\n    mlp_output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x_neural_activity, training: bool = False):\n        # x_neural_activity shape: (batch_size, input_horizon, num_neurons)\n        batch_size, current_input_horizon, _ = x_neural_activity.shape\n\n        # 1. Learnable Neuron Embeddings\n        neuron_embeddings = self.param(\n            'neuron_embeddings',\n            nn.initializers.uniform(scale=1.0 / jnp.sqrt(self.neuron_embedding_dim)), # Heuristic init\n            (self.num_neurons, self.neuron_embedding_dim)\n        )\n\n        # Prepare original neural activity input\n        # From (batch_size, input_horizon, num_neurons) to (batch_size, num_neurons, input_horizon)\n        x_neural_activity_transposed = jnp.transpose(x_neural_activity, (0, 2, 1))\n        # Reshape to (batch_size * num_neurons, input_horizon)\n        x_flat = jnp.reshape(x_neural_activity_transposed,\n                             (batch_size * self.num_neurons, self.input_horizon))\n\n        # Replicate neuron embeddings for each item in the batch\n        # (batch_size * num_neurons, neuron_embedding_dim)\n        replicated_neuron_embeddings = jnp.tile(neuron_embeddings, (batch_size, 1))\n\n        # Concatenate neural activity and neuron embeddings\n        # Resulting shape: (batch_size * num_neurons, input_horizon + neuron_embedding_dim)\n        combined_input_to_mlp = jnp.concatenate([x_flat, replicated_neuron_embeddings], axis=-1)\n\n        # 2. Apply the core shared MLP\n        # The input_dim for this MLP is now input_horizon + neuron_embedding_dim\n        mlp_output_flat = SharedNeuronMLP(\n            input_dim=self.input_horizon + self.neuron_embedding_dim,\n            hidden_size=self.mlp_hidden_size,\n            output_horizon=self.mlp_output_horizon,\n            dropout_rate=self.mlp_dropout_rate,\n            name='base_mlp'\n        )(combined_input_to_mlp, training=training)\n\n        # Reshape MLP output back to (batch_size, num_neurons, output_horizon)\n        mlp_output_reshaped = jnp.reshape(mlp_output_flat,\n                                         (batch_size, self.num_neurons, self.mlp_output_horizon))\n        # Transpose to (batch_size, output_horizon, num_neurons)\n        mlp_output = jnp.transpose(mlp_output_reshaped, (0, 2, 1))\n\n        # 3. Add neuron-specific biases (from previous submission)\n        neuron_biases = self.param(\n            'per_neuron_biases',\n            nn.initializers.zeros,\n            (1, self.mlp_output_horizon, self.num_neurons)\n        )\n\n        return mlp_output + neuron_biases\n\nclass FullModelWrapper:\n    \"\"\"\n    Wrapper to make Flax model compatible with the training system,\n    including neuron embeddings and biases.\n    \"\"\"\n    def __init__(self, hparams: Dict[str, Any]):\n        self.hparams = hparams\n        self.model = None\n        self.num_neurons = None\n        self.input_horizon = 4 # Fixed by task spec\n\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        # dummy_input shape: (batch_size, input_horizon, num_neurons)\n        self.num_neurons = dummy_input.shape[2]\n\n        self.model = SharedMLPWithEmbeddingsAndBias(\n            mlp_hidden_size=self.hparams.get('hidden_size', 64),\n            mlp_dropout_rate=self.hparams.get('dropout_rate', 0.1),\n            num_neurons=self.num_neurons,\n            input_horizon=self.input_horizon,\n            neuron_embedding_dim=self.hparams.get('neuron_embedding_dim', 8)\n        )\n\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params,\n                x,\n                training=training,\n                mutable=mutable,\n                rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params,\n                x,\n                training=training,\n                rngs=rngs if rngs is not None else {}\n            )\n\ndef _define_hyperparameters():\n    \"\"\"Define default hyperparameters for the model.\"\"\"\n    return {\n        'learning_rate': 0.001,\n        'hidden_size': 64,\n        'dropout_rate': 0.1,\n        'neuron_embedding_dim': 8 # New hyperparameter for neuron embedding size\n    }\n\ndef create_network(hparams: Dict[str, Any]):\n    \"\"\"Create and return the network with neuron embeddings and biases.\"\"\"\n    return FullModelWrapper(hparams)\n\n# No need to override compute_loss, create_optimizer, or complete as defaults are suitable.\n",
