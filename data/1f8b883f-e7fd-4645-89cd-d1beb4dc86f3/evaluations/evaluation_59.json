  "abstract": "This submission improves the SOTA MoE-MLP model (ID 50) by enhancing its gating mechanism. The original simple-mean gater is replaced with a 1D CNN that convolves across the neuron dimension. This allows the gater to recognize local spatial patterns of neural activity, inspired by insights from agent Episteme I. The hypothesis is that a spatially-aware gater will make more effective expert-routing decisions, leading to a new SOTA score.",
  "submitted_tick": 35,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nfrom jax import random\n\nNUM_NEURONS = 71721\nINPUT_HORIZON = 4\nOUTPUT_HORIZON = 32\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'embedding_dim': 8,\n        'mlp_hidden_size': 64,\n        'dropout_rate': 0.1,\n        'num_experts': 8,\n        'gating_hidden_dim': 32,\n        'gating_cnn_features': 16,\n        'gating_cnn_kernel_size': 128,\n        'gating_pool_window': 256,\n    }\n\nclass MlpExpert(nn.Module):\n    embedding_dim: int\n    mlp_hidden_size: int\n    dropout_rate: float\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        # Identical to the expert in ID 50\n        batch_size = x.shape[0]\n        neuron_indices = jnp.arange(NUM_NEURONS)\n        embeddings = nn.Embed(num_embeddings=NUM_NEURONS, features=self.embedding_dim, name=\"neuron_embed\")(neuron_indices)\n        broadcasted_embeddings = jnp.broadcast_to(embeddings, (batch_size, NUM_NEURONS, self.embedding_dim))\n        x_transposed = jnp.transpose(x, (0, 2, 1))\n        combined_input = jnp.concatenate([x_transposed, broadcasted_embeddings], axis=-1)\n        mlp_input = jnp.reshape(combined_input, (batch_size * NUM_NEURONS, INPUT_HORIZON + self.embedding_dim))\n        y = nn.Dense(self.mlp_hidden_size)(mlp_input)\n        y = nn.BatchNorm(use_running_average=not training)(y)\n        y = nn.relu(y)\n        y = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(y)\n        output = nn.Dense(OUTPUT_HORIZON)(y)\n        output = jnp.reshape(output, (batch_size, NUM_NEURONS, OUTPUT_HORIZON))\n        output = jnp.transpose(output, (0, 2, 1))\n        return output\n\nclass CnnGatingNetwork(nn.Module):\n    num_experts: int\n    hidden_dim: int\n    cnn_features: int\n    cnn_kernel_size: int\n    pool_window: int\n\n    @nn.compact\n    def __call__(self, x):\n        # x shape: (batch, 4, 71721)\n        # Transpose for convolution across neurons: (batch, 71721, 4)\n        gater_input = jnp.transpose(x, (0, 2, 1))\n        \n        # 1D CNN to learn spatial patterns\n        y = nn.Conv(features=self.cnn_features, kernel_size=(self.cnn_kernel_size,))(gater_input)\n        y = nn.relu(y)\n        \n        # Max pooling to downsample\n        y = nn.max_pool(y, window_shape=(self.pool_window,), strides=(self.pool_window,))\n        \n        # Flatten and pass to MLP\n        y = y.reshape((y.shape[0], -1))\n        y = nn.Dense(features=self.hidden_dim)(y)\n        y = nn.relu(y)\n        logits = nn.Dense(features=self.num_experts)(y)\n        return nn.softmax(logits, axis=-1)\n\nclass MoEModel(nn.Module):\n    num_experts: int\n    expert_params: dict\n    gating_params: dict\n    \n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        experts = nn.vmap(\n            MlpExpert, in_axes=None, out_axes=1,\n            variable_axes={'params': 0, 'batch_stats': 0},\n            split_rngs={'params': True, 'dropout': True},\n            axis_size=self.num_experts\n        )(**self.expert_params, name=\"experts\")\n        \n        gating_network = CnnGatingNetwork(**self.gating_params, name=\"gating\")\n        gating_weights = gating_network(x)\n        \n        expert_outputs = experts(x, training=training)\n        \n        gating_weights_reshaped = jnp.expand_dims(jnp.expand_dims(gating_weights, -1), -1)\n        \n        final_output = jnp.sum(expert_outputs * gating_weights_reshaped, axis=1)\n        return final_output\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.hparams = hparams\n        expert_params = {\n            'embedding_dim': hparams.get('embedding_dim'),\n            'mlp_hidden_size': hparams.get('mlp_hidden_size'),\n            'dropout_rate': hparams.get('dropout_rate'),\n        }\n        gating_params = {\n            'num_experts': hparams.get('num_experts'),\n            'hidden_dim': hparams.get('gating_hidden_dim'),\n            'cnn_features': hparams.get('gating_cnn_features'),\n            'cnn_kernel_size': hparams.get('gating_cnn_kernel_size'),\n            'pool_window': hparams.get('gating_pool_window'),\n        }\n        self.model = MoEModel(num_experts=hparams.get('num_experts'), expert_params=expert_params, gating_params=gating_params)\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        return self.model.init({'params': rng_params, 'dropout': rng_dropout}, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable:\n            return self.model.apply(params, x, training=training, mutable=mutable, rngs=rngs)\n        return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n",
