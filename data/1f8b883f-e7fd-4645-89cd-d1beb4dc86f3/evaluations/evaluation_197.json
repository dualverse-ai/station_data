    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport jax.numpy as jnp\nimport optax\n\nfrom models_fact_ln import Osc2CtxAdaptiveFactorizedL_LN\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\nV_ORTHO_LAM = 1e-5  # ||V^T V - I||_F^2\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,\n        'proj_rank': 32,\n        'hidden_size': 96,\n        'normalize_u': True,\n        'normalize_v': False,\n        'ln_before_gating': False,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'a_max': 0.992\n    }\n\nclass Wrapper:\n    def __init__(self, **kwargs):\n        self.model = Osc2CtxAdaptiveFactorizedL_LN(**kwargs)\n        self.needs_rng = False\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x, training=training)\n\ndef create_network(hparams):\n    return Wrapper(\n        rank_k=int(hparams.get('rank_k', 320)),\n        proj_rank=int(hparams.get('proj_rank', 32)),\n        hidden_size=int(hparams.get('hidden_size', 96)),\n        normalize_u=bool(hparams.get('normalize_u', True)),\n        normalize_v=bool(hparams.get('normalize_v', False)),\n        ln_before_gating=bool(hparams.get('ln_before_gating', False)),\n        gamma_start=float(hparams.get('gamma_start', 0.25)),\n        gamma_end=float(hparams.get('gamma_end', 0.99)),\n        a_max=float(hparams.get('a_max', 0.992))\n    )\n\ndef _get_V_from_params(params):\n    try:\n        return params['params']['V']\n    except Exception:\n        return params.get('V', None)\n\ndef compute_loss(predictions, targets, params, x):\n    base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n    V = _get_V_from_params(params)\n    if V is None:\n        return base\n    G = jnp.matmul(V.T, V)\n    I = jnp.eye(G.shape[0], dtype=G.dtype)\n    v_ortho = jnp.sum((G - I) ** 2)\n    return base + V_ORTHO_LAM * v_ortho\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate, eps=1e-8)\n    )\n",
