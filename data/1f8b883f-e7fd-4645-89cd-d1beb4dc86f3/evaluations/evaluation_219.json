  "original_submission": {
    "content": "import sys\nimport flax.linen as nn\nimport jax.numpy as jnp\n\n# This is the full SOTA model from my successful replication ID 157\n# to ensure no external dependencies.\nclass ResidualCopyHead(nn.Module):\n    output_horizon: int\n    @nn.compact\n    def __call__(self, x):\n        return jnp.tile(x[:, -1:, :], (1, self.output_horizon, 1))\n\nNUM_NEURONS = 71721\nOUTPUT_HORIZON = 32\n\nclass FactorizedMlpRc(nn.Module):\n    latent_dim: int\n    proj_rank: int\n    mlp_hidden_dim: int\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        U = self.param('U', nn.initializers.lecun_normal(), (NUM_NEURONS, self.proj_rank))\n        V = self.param('V', nn.initializers.lecun_normal(), (self.latent_dim, self.proj_rank))\n        \n        factors_in = jnp.einsum('btn,np->btp', x, U)\n        factors_in = jnp.einsum('btp,kp->btk', factors_in, V)\n\n        batch_size = x.shape[0]\n        factors_flat = factors_in.reshape((batch_size, -1))\n        \n        y = nn.Dense(features=self.mlp_hidden_dim)(factors_flat)\n        y = nn.relu(y)\n        factors_out_flat = nn.Dense(features=OUTPUT_HORIZON * self.latent_dim)(y)\n        factors_out = factors_out_flat.reshape((batch_size, OUTPUT_HORIZON, self.latent_dim))\n\n        factors_out_norm = nn.LayerNorm(reduction_axes=-1, feature_axes=-1)(factors_out)\n        \n        y_factor_p = jnp.einsum('btk,kp->btp', factors_out_norm, V)\n        y_factor = jnp.einsum('btp,np->btn', y_factor_p, U)\n\n        y_copy = ResidualCopyHead(output_horizon=OUTPUT_HORIZON)(x)\n        \n        return y_factor + y_copy\n\n# The key innovation from Episteme's ID 213\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    first_deriv_sq = (predictions[:, 1:, :] - predictions[:, :-1, :])**2\n    curv_pen = jnp.mean(first_deriv_sq)\n    return mae + 1e-4 * curv_pen\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'latent_dim': 320,\n        'proj_rank': 32,\n        'mlp_hidden_dim': 512,\n    }\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        model_hparams = {k: v for k, v in hparams.items() if k != 'learning_rate'}\n        self.model = FactorizedMlpRc(**model_hparams)\n        self.mutable = []\n        self.needs_rng = False\n\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x)\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n",
