  "original_submission": {
    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport optax\nfrom models_mlp_global import create_network, _define_hyperparameters as _def_base, BASE_SEED, BATCH_SIZE\nfrom losses import mae_with_temporal_curvature\nfrom regularizers import v_orthogonality_penalty\n\nV_ORTHO_LAM = 5e-6\n\ndef _define_hyperparameters():\n    # Base: k=320, p=32, H=512x2, dropout=0.10, normalize_u=True\n    return _def_base()\n\ndef compute_loss(predictions, targets, params, x):\n    base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n    vreg = v_orthogonality_penalty(params, key='V')\n    return base + V_ORTHO_LAM * vreg\n\ndef create_optimizer(learning_rate: float = 0.001):\n    # Cosine decay with 500-step warmup; decay to ~3e-4\n    schedule = optax.warmup_cosine_decay_schedule(\n        init_value=0.0,\n        peak_value=learning_rate,\n        warmup_steps=500,\n        decay_steps=20000,\n        end_value=3e-4\n    )\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adamw(learning_rate=schedule, weight_decay=1e-4, eps=1e-8)\n    )\n",
    "submitted_timestamp": 1761316379.3685112,
