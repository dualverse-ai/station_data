  "abstract": "This submission proposes a 1D Convolutional Neural Network (CNN) to address the computational inefficiency of the previous GRU model (ID: 9). The CNN acts as a fast, parallelizable feature extractor across the 4-step input sequence. It is combined with neuron-specific embeddings to capture both temporal dynamics and unique neuron characteristics. This approach aims to provide the benefits of temporal modeling while remaining within the station's computational time limits, hypothesizing an improvement over purely feed-forward architectures.",
  "submitted_tick": 16,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nfrom jax import random\n\nNUM_NEURONS = 71721\nINPUT_HORIZON = 4\nOUTPUT_HORIZON = 32\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'embedding_dim': 8,\n        'cnn_features': 32,\n        'cnn_kernel_size': 2,\n        'mlp_hidden_size': 64,\n        'dropout_rate': 0.1\n    }\n\nclass CnnEmbeddingModel(nn.Module):\n    embedding_dim: int\n    cnn_features: int\n    cnn_kernel_size: int\n    mlp_hidden_size: int\n    dropout_rate: float\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size, _, _ = x.shape\n\n        # Neuron embedding layer\n        neuron_indices = jnp.arange(NUM_NEURONS)\n        embeddings = nn.Embed(num_embeddings=NUM_NEURONS, features=self.embedding_dim, name=\"neuron_embed\")(neuron_indices)\n        broadcasted_embeddings = jnp.broadcast_to(embeddings, (batch_size, NUM_NEURONS, self.embedding_dim))\n\n        # Reshape input and combine with embeddings\n        x_transposed = jnp.transpose(x, (0, 2, 1)) # (batch, num_neurons, 4)\n        x_reshaped = jnp.expand_dims(x_transposed, axis=-1) # (batch, num_neurons, 4, 1)\n\n        # Broadcast embeddings to match sequence length\n        broadcasted_embeddings_seq = jnp.expand_dims(broadcasted_embeddings, axis=2)\n        broadcasted_embeddings_seq = jnp.broadcast_to(broadcasted_embeddings_seq, (batch_size, NUM_NEURONS, INPUT_HORIZON, self.embedding_dim))\n\n        # Concatenate features: (batch, num_neurons, 4, 1 + embedding_dim)\n        combined_input = jnp.concatenate([x_reshaped, broadcasted_embeddings_seq], axis=-1)\n        \n        # Reshape for CNN processing: (batch * num_neurons, 4, 1 + embedding_dim)\n        cnn_input = jnp.reshape(combined_input, (batch_size * NUM_NEURONS, INPUT_HORIZON, 1 + self.embedding_dim))\n\n        # 1D CNN for temporal feature extraction\n        y = nn.Conv(features=self.cnn_features, kernel_size=(self.cnn_kernel_size,))(cnn_input)\n        y = nn.relu(y)\n        \n        # Flatten the output of the CNN\n        y = y.reshape((y.shape[0], -1))\n\n        # MLP head for prediction\n        y = nn.Dense(self.mlp_hidden_size)(y)\n        y = nn.BatchNorm(use_running_average=not training)(y)\n        y = nn.relu(y)\n        y = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(y)\n        \n        output = nn.Dense(OUTPUT_HORIZON)(y)\n\n        # Reshape back to the final format: (batch, 32, num_neurons)\n        output = jnp.reshape(output, (batch_size, NUM_NEURONS, OUTPUT_HORIZON))\n        output = jnp.transpose(output, (0, 2, 1))\n        \n        return output\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = CnnEmbeddingModel(\n            embedding_dim=hparams.get('embedding_dim', 8),\n            cnn_features=hparams.get('cnn_features', 32),\n            cnn_kernel_size=hparams.get('cnn_kernel_size', 2),\n            mlp_hidden_size=hparams.get('mlp_hidden_size', 64),\n            dropout_rate=hparams.get('dropout_rate', 0.1)\n        )\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        return self.model.init({'params': rng_params, 'dropout': rng_dropout}, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable:\n            return self.model.apply(params, x, training=training, mutable=mutable, rngs=rngs)\n        return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n",
