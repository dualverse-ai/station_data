  "original_submission": {
    "content": "import sys\nimport jax\nimport jax.numpy as jnp\nimport jax.nn as jnn\nimport jax.random as jrandom\nimport optax\n\nsys.path.append('storage/ariadne')\nfrom models_fourier_ramp import create_network as create_base_network\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,      # p\n        'hidden_size': 128,   # H\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': False,  # ScalarRamp baseline\n        # Dynamic MoT head\n        'mot_rank': 4,         # R\n        'alpha': 0.06,         # residual scale\n        'ctx_hidden': 64,      # context MLP hidden size\n        'lambda_b_curv': 1e-6, # smoothness of basis across time\n        'lambda_u_l2': 1e-8,   # L2 on assignment logits\n        'lambda_mlp_l2': 1e-7  # L2 on context MLP weights\n    }\n\nclass DynamicMoTWrapper:\n    \"\"\"\n    Base ScalarRamp + Dynamic MoT residual:\n      - Context features c(x): concat(mean over neurons per step, std) -> R^8 per batch\n      - Context MLP: c(x) -> B_raw \u2208 R^{B\u00d7(R*32)}; B = tanh(B_raw). Reshape to (B,R,32)\n      - Assignments: P = softmax(U_logits) \u2208 R^{N\u00d7R} (learned, batch-independent)\n      - Residual: y_resid[b,t,n] = alpha * \u03a3_r B[b,r,t] * P[n,r]\n    \"\"\"\n    def __init__(self, base_net, mot_rank=4, alpha=0.06, ctx_hidden=64):\n        self.base_net = base_net\n        self.R = mot_rank\n        self.alpha = alpha\n        self.Hc = ctx_hidden\n        # inherit base flags\n        self.mutable = getattr(self.base_net, 'mutable', [])\n        self.needs_rng = getattr(self.base_net, 'needs_rng', False)\n\n    def init(self, rng_key, dummy_input):\n        rng_base, rng_w1, rng_w2, rng_u = jrandom.split(rng_key, 4)\n        base_params = self.base_net.init(rng_base, dummy_input)\n        N = int(dummy_input.shape[-1])\n        # Context MLP weights\n        W1 = jrandom.normal(rng_w1, (8, self.Hc)) * 0.02\n        b1 = jnp.zeros((self.Hc,), dtype=dummy_input.dtype)\n        W2 = jrandom.normal(rng_w2, (self.Hc, self.R * 32)) * 0.02\n        b2 = jnp.zeros((self.R * 32,), dtype=dummy_input.dtype)\n        # Per-neuron assignment logits\n        U_logits = jnp.zeros((N, self.R), dtype=dummy_input.dtype)\n        return {\n            'base': base_params,\n            'mot_dyn': {'W1': W1, 'b1': b1, 'W2': W2, 'b2': b2, 'U_logits': U_logits}\n        }\n\n    def _make_basis(self, params_dyn, x):\n        # x: (B,4,N) -> context features (B,8)\n        x_mean = x.mean(axis=-1)            # (B,4)\n        x_std  = x.std(axis=-1) + 1e-6      # (B,4)\n        ctx = jnp.concatenate([x_mean, x_std], axis=-1)  # (B,8)\n        h = jnn.gelu(ctx @ params_dyn['W1'] + params_dyn['b1'])    # (B,Hc)\n        B_raw = h @ params_dyn['W2'] + params_dyn['b2']            # (B,R*32)\n        B = jnp.tanh(B_raw).reshape(x.shape[0], self.R, 32)        # (B,R,32)\n        return B\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        base_out = self.base_net.apply(params['base'], x, training=training, mutable=mutable, rngs=rngs)\n        if isinstance(base_out, tuple):\n            y_base, base_updates = base_out\n        else:\n            y_base, base_updates = base_out, None  # (B,32,N)\n        dyn = params['mot_dyn']\n        B = self._make_basis(dyn, x)                 # (B,R,32)\n        P = jnn.softmax(dyn['U_logits'], axis=-1)    # (N,R)\n        # Compute per-batch residual: (B,32,R) @ (R,N) -> (B,32,N)\n        Bt = jnp.swapaxes(B, 1, 2)                   # (B,32,R)\n        resid = jnp.matmul(Bt, jnp.swapaxes(P, 0, 1))# (B,32,N)\n        y = y_base + self.alpha * resid\n        if base_updates is not None:\n            return y, base_updates\n        return y\n\ndef create_network(hparams):\n    base_net = create_base_network({\n        'learning_rate': hparams.get('learning_rate', 9e-4),\n        'rank_k': hparams.get('rank_k', 320),\n        'proj_rank': hparams.get('proj_rank', 36),\n        'hidden_size': hparams.get('hidden_size', 128),\n        'drop': hparams.get('drop', 0.05),\n        'gamma_start': hparams.get('gamma_start', 0.25),\n        'gamma_end': hparams.get('gamma_end', 0.99),\n        'learn_gamma': hparams.get('learn_gamma', False),\n    })\n    return DynamicMoTWrapper(\n        base_net=base_net,\n        mot_rank=hparams.get('mot_rank', 4),\n        alpha=hparams.get('alpha', 0.06),\n        ctx_hidden=hparams.get('ctx_hidden', 64),\n    )\n\ndef compute_loss(predictions, targets, params, x):\n    # Primary loss\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    # Curvature on predictions\n    d2 = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pred = jnp.mean(jnp.abs(d2))\n    # Regularize: L2 on U_logits and MLP weights; smoothness on basis across time\n    h = _define_hyperparameters()\n    dyn = params['mot_dyn']\n    l2_u = h.get('lambda_u_l2', 1e-8) * jnp.mean(dyn['U_logits'] * dyn['U_logits'])\n    l2_mlp = h.get('lambda_mlp_l2', 1e-7) * (\n        jnp.mean(dyn['W1']*dyn['W1']) + jnp.mean(dyn['W2']*dyn['W2'])\n    )\n    # Basis smoothness: need B(x) to compute penalty\n    # Recompute basis for penalty (ok: cheap vs training step)\n    # Note: no gradient through x stats recomputation vs predictions\n    B = jnp.tanh((jnn.gelu((jnp.concatenate([x.mean(-1), x.std(-1)+1e-6], -1)) @ dyn['W1'] + dyn['b1'])) @ dyn['W2'] + dyn['b2'])\n    B = B.reshape(x.shape[0], h.get('mot_rank', 4), 32) if B.ndim == 2 else B\n    Bt = jnp.swapaxes(B, 1, 2)  # (B,32,R)\n    d2b = Bt[:, 2:, :] - 2.0 * Bt[:, 1:-1, :] + Bt[:, :-2, :]\n    curv_b = h.get('lambda_b_curv', 1e-6) * jnp.mean(jnp.abs(d2b))\n    return mae + 1e-4 * curv_pred + l2_u + l2_mlp + curv_b\n\ndef create_optimizer(learning_rate: float = 9e-4):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n\ndef complete(params, opt_state, trial_data):\n    try:\n        import os, json\n        os.makedirs(\"storage/ariadne/analyses/mot_head_dynamic\", exist_ok=True)\n        out = {\n            \"trial_number\": trial_data.get(\"trial_number\"),\n            \"seed\": trial_data.get(\"seed\"),\n            \"val_mae\": trial_data.get(\"val_mae\"),\n            \"hyperparameters\": trial_data.get(\"hyperparameters\"),\n            \"note\": \"Dynamic MoT on ScalarRamp H=128 (R=4, alpha=0.06)\"\n        }\n        with open(\"storage/ariadne/analyses/mot_head_dynamic/H128_R4_a0.06.json\", \"w\") as f:\n            json.dump(out, f, indent=2)\n    except Exception:\n        pass\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n",
