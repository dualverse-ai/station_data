  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport jax.numpy as jnp\nimport optax\nimport flax.linen as nn\nfrom jax import random\nfrom typing import Any, Dict\n\n# Import default loss and optimizer from system storage to maintain consistency\nimport sys\nsys.path.append('storage/system')\nfrom defaults import default_compute_loss, default_create_optimizer\n\n# Constants from Research Task\nNUM_NEURONS = 71721\nINPUT_HORIZON = 4\nOUTPUT_HORIZON = 32\n\nclass NeuronEmbeddingMLP(nn.Module):\n    \"\"\"\n    Shared-neuron MLP with learnable neuron embeddings.\n    Each neuron's input is augmented with its unique learned embedding.\n    \"\"\"\n    hidden_size: int\n    output_horizon: int\n    dropout_rate: float\n    num_neurons: int\n    embedding_dim: int\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size, input_horizon, _ = x.shape\n\n        # Learnable embeddings for each neuron\n        # Shape: (num_neurons, embedding_dim)\n        neuron_embeddings = self.param(\n            'neuron_embeddings',\n            nn.initializers.normal(stddev=0.1), \n            (self.num_neurons, self.embedding_dim)\n        )\n        \n        # Expand embeddings to match batch size and transpose for concatenation\n        # (num_neurons, embedding_dim) -> (batch_size, num_neurons, embedding_dim)\n        expanded_embeddings = jnp.tile(neuron_embeddings[None, :, :], (batch_size, 1, 1))\n        \n        # Reshape x from (batch_size, INPUT_HORIZON, num_neurons) to \n        # (batch_size, num_neurons, INPUT_HORIZON)\n        x_reshaped = jnp.transpose(x, (0, 2, 1)) \n        \n        # Concatenate input features with neuron embeddings\n        # Resulting shape: (batch_size, num_neurons, INPUT_HORIZON + embedding_dim)\n        x_with_embeddings = jnp.concatenate([x_reshaped, expanded_embeddings], axis=-1)\n        \n        # Reshape for shared MLP processing\n        # (batch_size * num_neurons, INPUT_HORIZON + embedding_dim)\n        x = jnp.reshape(x_with_embeddings, \n                        (batch_size * self.num_neurons, input_horizon + self.embedding_dim))\n\n        # Shared MLP layers\n        x = nn.Dense(self.hidden_size)(x)\n        x = nn.BatchNorm(use_running_average=not training)(x)\n        x = nn.relu(x)\n        x = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(x)\n\n        x = nn.Dense(self.output_horizon)(x)\n\n        # Reshape back to (batch_size, OUTPUT_HORIZON, num_neurons)\n        # Original shape: (batch_size * num_neurons, OUTPUT_HORIZON)\n        # Reshape to (batch_size, num_neurons, OUTPUT_HORIZON)\n        x = jnp.reshape(x, (batch_size, self.num_neurons, self.output_horizon))\n        # Transpose back to (batch_size, OUTPUT_HORIZON, num_neurons)\n        x = jnp.transpose(x, (0, 2, 1)) \n\n        return x\n\n\nclass NeuronEmbeddingMLPWrapper:\n    \"\"\"\n    Wrapper to make Flax model compatible with the training system,\n    handling BatchNorm state and Dropout RNG requirements.\n    \"\"\"\n    def __init__(self, hparams: Dict[str, Any]):\n        self.model = NeuronEmbeddingMLP(\n            hidden_size=hparams.get('hidden_size', 64),\n            output_horizon=OUTPUT_HORIZON, \n            dropout_rate=hparams.get('dropout_rate', 0.1),\n            num_neurons=NUM_NEURONS, \n            embedding_dim=hparams.get('embedding_dim', 4) # Modified: embedding_dim = 4\n        )\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        # Split keys for params and dropout\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            # Training mode with mutable batch_stats\n            output, updates = self.model.apply(\n                params, x, training=training, mutable=mutable, rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            # Inference mode\n            return self.model.apply(\n                params, x, training=training, rngs=rngs if rngs is not None else {}\n            )\n\n\ndef _define_hyperparameters():\n    \"\"\"Define hyperparameters for the Neuron Embedding MLP model.\"\"\"\n    return {\n        'learning_rate': 0.001,\n        'hidden_size': 64, # Matches default baseline\n        'dropout_rate': 0.1, # Matches default baseline\n        'embedding_dim': 4 # Modified for ablation study\n    }\n\n\ndef create_network(hparams: Dict[str, Any]):\n    \"\"\"Create and return the Neuron Embedding MLP network.\"\"\"\n    return NeuronEmbeddingMLPWrapper(hparams)\n\n\ndef compute_loss(predictions, targets, params, x):\n    \"\"\"Use the default MAE loss function.\"\"\"\n    return default_compute_loss(predictions, targets, params, x)\n\n\ndef create_optimizer(learning_rate: float = 0.001) -> optax.GradientTransformation:\n    \"\"\"Create and return the default Adam optimizer.\"\"\"\n    return default_create_optimizer(learning_rate)\n",
