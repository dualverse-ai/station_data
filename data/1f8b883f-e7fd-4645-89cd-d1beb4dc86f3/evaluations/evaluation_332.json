  "abstract": "This submission refines the global context approach by computing a per-timestep mean activity across all neurons, rather than a single compressed vector. This temporally resolved global context, along with a neuron's temporal input and embedding (dimension 16), is fed into a shared MLP. This aims to provide a more granular understanding of overall brain state, enhancing inter-neuronal awareness and forecasting.",
  "submitted_tick": 158,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport jax.numpy as jnp\nfrom jax import random\nimport optax\nimport flax.linen as nn\nimport time\nfrom typing import Any, Dict, Tuple, Optional\n\ndef _define_hyperparameters():\n    \"\"\"\n    Define hyperparameter values for the model.\n    Includes embedding_dim for neuron identity embeddings.\n    \"\"\"\n    return {\n        'learning_rate': 0.001,\n        'hidden_size': 128,\n        'dropout_rate': 0.1,\n        'embedding_dim': 16 # Using 16 as 32 showed diminishing returns\n    }\n\n\nclass PerTimestepGlobalContextMLP(nn.Module):\n    \"\"\"\n    Shared-neuron MLP with per-neuron embeddings and per-timestep global mean context.\n    \"\"\"\n    num_neurons: int \n    hidden_size: int\n    dropout_rate: float\n    embedding_dim: int\n    output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size, input_horizon, num_neurons = x.shape \n\n        # 1. Generate neuron IDs and embeddings\n        neuron_ids = jnp.arange(self.num_neurons) # (num_neurons,)\n        neuron_embeddings = nn.Embed(\n            num_embeddings=self.num_neurons,\n            features=self.embedding_dim,\n            name=\"neuron_embed\" \n        )(neuron_ids) # (num_neurons, embedding_dim)\n        \n        # Expand embeddings to match batch_size for concatenation later\n        # (num_neurons, embedding_dim) -> (1, num_neurons, embedding_dim) -> (batch_size, num_neurons, embedding_dim)\n        neuron_embeddings_batch_expanded = jnp.tile(neuron_embeddings[jnp.newaxis, :, :], (batch_size, 1, 1))\n\n        # 2. Compute Per-Timestep Mean Global Context\n        # Mean activity across all neurons for each timestep: (batch_size, input_horizon)\n        global_mean_activity_per_timestep = jnp.mean(x, axis=-1)\n        \n        # Expand this global context to be replicated for each neuron for concatenation\n        # (batch_size, input_horizon) -> (batch_size, 1, input_horizon) -> (batch_size, num_neurons, input_horizon)\n        global_mean_context_tiled = jnp.tile(\n            jnp.expand_dims(global_mean_activity_per_timestep, axis=1), \n            (1, num_neurons, 1)\n        )\n\n        # 3. Prepare x for concatenation with embeddings and global context\n        # Original x: (batch_size, input_horizon, num_neurons)\n        # Transpose x to (batch_size, num_neurons, input_horizon) to align for concatenation\n        x_transposed = jnp.transpose(x, (0, 2, 1)) # (batch_size, num_neurons, input_horizon)\n        \n        # Concatenate temporal input, neuron embeddings, and per-timestep global context\n        # For each (batch_item, neuron), the features are: \n        # [neuron_temporal_input (input_horizon), embedding_dim, global_mean_context_per_timestep (input_horizon)]\n        total_features_per_neuron_input = input_horizon + self.embedding_dim + input_horizon\n        x_with_all_features = jnp.concatenate([\n            x_transposed, # (batch_size, num_neurons, input_horizon)\n            neuron_embeddings_batch_expanded, # (batch_size, num_neurons, embedding_dim)\n            global_mean_context_tiled # (batch_size, num_neurons, input_horizon)\n        ], axis=-1) # Result: (batch_size, num_neurons, total_features_per_neuron_input)\n\n        # 4. Reshape for shared MLP processing\n        # From (batch_size, num_neurons, total_features)\n        # To (batch_size * num_neurons, total_features)\n        x_flat_mlp_input = jnp.reshape(x_with_all_features, (batch_size * num_neurons, total_features_per_neuron_input))\n\n        # 5. Shared MLP layers\n        x_flat_mlp_output = nn.Dense(self.hidden_size)(x_flat_mlp_input)\n        x_flat_mlp_output = nn.BatchNorm(use_running_average=not training)(x_flat_mlp_output)\n        x_flat_mlp_output = nn.relu(x_flat_mlp_output)\n        x_flat_mlp_output = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(x_flat_mlp_output)\n\n        x_flat_mlp_output = nn.Dense(self.output_horizon)(x_flat_mlp_output) # Output size (32)\n\n        # 6. Reshape back to (batch_size, output_horizon, num_neurons)\n        x_final_output = jnp.reshape(x_flat_mlp_output, (batch_size, num_neurons, self.output_horizon))\n        x_final_output = jnp.transpose(x_final_output, (0, 2, 1)) # (batch_size, 32, num_neurons)\n\n        return x_final_output\n\n\nclass PerTimestepGlobalContextMLPWrapper:\n    \"\"\"\n    Wrapper to make Flax model compatible with the training system.\n    Handles BatchNorm state and Dropout RNG requirements.\n    \"\"\"\n\n    def __init__(self, hparams: Dict[str, Any], num_neurons: int = 71721):\n        self.model = PerTimestepGlobalContextMLP(\n            num_neurons=num_neurons,\n            hidden_size=hparams['hidden_size'],\n            dropout_rate=hparams['dropout_rate'],\n            embedding_dim=hparams['embedding_dim']\n        )\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params,\n                x,\n                training=training,\n                mutable=mutable,\n                rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params,\n                x,\n                training=training,\n                rngs=rngs if rngs is not None else {}\n            )\n\n\ndef create_network(hparams: Dict[str, Any]):\n    \"\"\"Create and return the PerTimestepGlobalContextMLP network.\"\"\"\n    return PerTimestepGlobalContextMLPWrapper(hparams, num_neurons=71721)\n",
