  "cpu_only": false,
  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nfrom jax import random\n\nNUM_NEURONS = 71721\nOUTPUT_HORIZON = 32\n\nclass MlpExpert(nn.Module):\n    embedding_dim: int\n    hidden_size: int\n    dropout_rate: float\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size = x.shape[0]\n        neuron_indices = jnp.arange(NUM_NEURONS)\n        embeddings = nn.Embed(num_embeddings=NUM_NEURONS, features=self.embedding_dim, name=\"neuron_embed\")(neuron_indices)\n        broadcasted_embeddings = jnp.broadcast_to(embeddings, (batch_size, NUM_NEURONS, self.embedding_dim))\n        \n        x_last_step = jnp.transpose(x[:, -1:, :], (0, 2, 1))\n        combined_input = jnp.concatenate([x_last_step, broadcasted_embeddings], axis=-1)\n        \n        y = jnp.reshape(combined_input, (-1, 1 + self.embedding_dim))\n        y = nn.Dense(self.hidden_size)(y)\n        y = nn.BatchNorm(use_running_average=not training)(y)\n        y = nn.relu(y)\n        y = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(y)\n        output = nn.Dense(OUTPUT_HORIZON)(y)\n        \n        output = jnp.reshape(output, (batch_size, NUM_NEURONS, OUTPUT_HORIZON))\n        output = jnp.transpose(output, (0, 2, 1))\n        return output\n\nclass SimpleGatingNetwork(nn.Module):\n    num_experts: int\n    hidden_dim: int\n\n    @nn.compact\n    def __call__(self, x):\n        # Compute a global summary by averaging over time and neurons\n        gater_input = jnp.mean(x, axis=(1, 2)) # Shape: (batch_size,)\n        # *** BUG FIX HERE ***\n        # Reshape to (batch_size, 1) to make it a 2D tensor for the Dense layer\n        gater_input = gater_input.reshape((-1, 1))\n        \n        y = nn.Dense(features=self.hidden_dim)(gater_input)\n        y = nn.relu(y)\n        logits = nn.Dense(features=self.num_experts)(y)\n        return nn.softmax(logits, axis=-1)\n\nclass MoEModel(nn.Module):\n    num_experts: int\n    expert_params: dict\n    gating_params: dict\n    \n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        experts = nn.vmap(\n            MlpExpert, in_axes=None, out_axes=1,\n            variable_axes={'params': 0, 'batch_stats': 0},\n            split_rngs={'params': True, 'dropout': True},\n            axis_size=self.num_experts\n        )(**self.expert_params, name=\"experts\")\n        \n        gating_network = SimpleGatingNetwork(**self.gating_params, name=\"gating\")\n        gating_weights = gating_network(x)\n        expert_outputs = experts(x, training=training)\n        \n        gating_weights_reshaped = jnp.expand_dims(jnp.expand_dims(gating_weights, -1), -1)\n        final_output = jnp.sum(expert_outputs * gating_weights_reshaped, axis=1)\n        return final_output\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'embedding_dim': 8,\n        'hidden_size': 128,\n        'dropout_rate': 0.1,\n        'num_experts': 4,\n        'gating_hidden_dim': 32,\n    }\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        expert_params = {k: v for k, v in hparams.items() if k in ['embedding_dim', 'hidden_size', 'dropout_rate']}\n        gating_params = {k: v for k, v in hparams.items() if k in ['num_experts']}\n        gating_params['hidden_dim'] = hparams.get('gating_hidden_dim')\n        self.model = MoEModel(num_experts=hparams.get('num_experts'), expert_params=expert_params, gating_params=gating_params)\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        return self.model.init({'params': rng_params, 'dropout': rng_dropout}, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable:\n            return self.model.apply(params, x, training=training, mutable=mutable, rngs=rngs)\n        return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n",
