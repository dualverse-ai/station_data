  "original_submission": {
    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport jax\nimport jax.numpy as jnp\nimport flax.linen as nn\nimport optax\n\nfrom losses import mae_with_temporal_curvature\nfrom models import ResidualCopyHead\n\nclass FactGlobalMLP_Shallow(nn.Module):\n    rank_k: int = 320\n    proj_rank: int = 32\n    hidden_size: int = 384\n    dropout_rate: float = 0.10\n    output_horizon: int = 32\n    normalize_u: bool = True\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        # x: (B, 4, N)\n        B, T_in, N = x.shape\n        k = self.rank_k\n        p = self.proj_rank\n        T = self.output_horizon\n\n        # Factorized loadings\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        if self.normalize_u:\n            U = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n\n        # Project to factors\n        xU = jnp.einsum('btn,np->btp', x, U)            # (B,4,p)\n        factors_in = jnp.einsum('btp,pk->btk', xU, V.T)  # (B,4,k)\n        factors_n = nn.LayerNorm()(factors_in)           # (B,4,k)\n\n        # One hidden layer MLP per factor: 4 -> H -> 32\n        f_flat = factors_n.reshape(B * k, T_in)          # (B*k,4)\n        h = nn.Dense(self.hidden_size)(f_flat); h = nn.gelu(h)\n        h = nn.Dropout(self.dropout_rate)(h, deterministic=not training)\n        f_out = nn.Dense(T)(h).reshape(B, k, T).transpose(0, 2, 1)  # (B,T,k)\n\n        # Decode via factorized loadings\n        z = jnp.einsum('btk,kp->btp', f_out, V)          # (B,T,p)\n        y_factor = jnp.einsum('btp,np->btn', z, U)       # (B,T,N)\n\n        # Residual copy\n        y_copy = ResidualCopyHead(output_horizon=T)(x)\n        return y_copy + y_factor\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 32,\n        'hidden_size': 384,\n        'dropout_rate': 0.10,\n        'normalize_u': True\n    }\n\nclass Wrapper:\n    def __init__(self, **kwargs):\n        self.model = FactGlobalMLP_Shallow(**kwargs)\n        self.needs_rng = True  # Dropout\n\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams):\n    return Wrapper(\n        rank_k=int(hparams.get('rank_k', 320)),\n        proj_rank=int(hparams.get('proj_rank', 32)),\n        hidden_size=int(hparams.get('hidden_size', 384)),\n        dropout_rate=float(hparams.get('dropout_rate', 0.10)),\n        normalize_u=bool(hparams.get('normalize_u', True)),\n    )\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate, eps=1e-8)\n    )\n",
