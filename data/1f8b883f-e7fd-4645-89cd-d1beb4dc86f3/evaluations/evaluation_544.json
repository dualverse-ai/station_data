  "abstract": "We wrap the top FF-LN forecaster with a learnable low-rank neuron factor head. A global context MLP produces horizon-wise R-factor activations from population statistics; these interact with a neuron-factor matrix U \u2208 R^{N\u00d7R} to yield a structured additive residual. This captures cross-neuron variation efficiently without breaking shared weights. We keep FF-LN hyperparams (p=36,H=160,drop=0.05,learnable-\u03b3) and use MAE+curvature loss with light L2 on U.",
  "submitted_tick": 301,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport jax\nimport jax.numpy as jnp\nimport jax.nn as jnn\nfrom jax import random as jrandom\nimport optax\n\n# Reuse lineage Fourier LN model and loss\nfrom models_fourier_ramp import create_network as create_base_network\nfrom losses import mae_with_temporal_curvature\n\nN_NEURONS = 71721\n\ndef _define_hyperparameters():\n    # Base FF-LN hyperparams from prior SOTA + our head params\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,      # p\n        'hidden_size': 160,   # H\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': True,\n        # Neuron-factor head\n        'rank_factors': 8,    # R\n        'context_hidden': 64,\n        'alpha': 0.07         # scale for additive residual\n    }\n\nclass NeuronFactorWrapper:\n    \"\"\"\n    Wraps the base FF-LN network with a low-rank neuron-factor residual:\n      y = y_base + alpha * einsum('btr,nr->btn', G(x_pop), U)\n    where:\n      - G(x_pop) in R^{B x 32 x R} from a small MLP on population context (means/stds)\n      - U in R^{N x R} is a learned neuron-factor matrix\n    \"\"\"\n    def __init__(self, base_net, rank_factors=8, context_hidden=64, alpha=0.07):\n        self.base_net = base_net\n        self.R = rank_factors\n        self.Hc = context_hidden\n        self.alpha = alpha\n        # Inherit state/RNG needs from base\n        self.mutable = getattr(self.base_net, 'mutable', [])\n        self.needs_rng = getattr(self.base_net, 'needs_rng', False)\n\n    def init(self, rng_key, dummy_input):\n        # Initialize base network params\n        rng_base, rng_u, rng_w1, rng_w2 = jrandom.split(rng_key, 4)\n        base_params = self.base_net.init(rng_base, dummy_input)\n\n        # Initialize low-rank neuron factors U and context MLP weights\n        U = jrandom.normal(rng_u, (N_NEURONS, self.R)) * 0.02\n\n        # Context features: [mean(4), std(4)] -> 8 dims\n        W1 = jrandom.normal(rng_w1, (8, self.Hc)) * 0.02\n        b1 = jnp.zeros((self.Hc,))\n        W2 = jrandom.normal(rng_w2, (self.Hc, 32 * self.R)) * 0.02\n        b2 = jnp.zeros((32 * self.R,))\n\n        params = {\n            'base': base_params,\n            'nf': {\n                'U': U,\n                'W1': W1, 'b1': b1,\n                'W2': W2, 'b2': b2\n            }\n        }\n        return params\n\n    def _context_gates(self, params_nf, x):\n        # x: (B, 4, N)\n        x_mean = x.mean(axis=-1)              # (B, 4)\n        x_std = x.std(axis=-1) + 1e-6         # (B, 4)\n        ctx = jnp.concatenate([x_mean, x_std], axis=-1)  # (B, 8)\n        h = jnn.gelu(ctx @ params_nf['W1'] + params_nf['b1'])            # (B, Hc)\n        g_raw = h @ params_nf['W2'] + params_nf['b2']                     # (B, 32*R)\n        g = jnp.tanh(g_raw).reshape(ctx.shape[0], 32, self.R)             # (B, 32, R)\n        return g\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        # Forward base model\n        base_out = self.base_net.apply(params['base'], x, training=training, mutable=mutable, rngs=rngs)\n        if isinstance(base_out, tuple):\n            y_base, base_updates = base_out\n        else:\n            y_base, base_updates = base_out, None  # (B, 32, N)\n\n        # Neuron-factor residual\n        g = self._context_gates(params['nf'], x)             # (B, 32, R)\n        U = params['nf']['U']                                # (N, R)\n        y_resid = jnp.einsum('btr,nr->btn', g, U)            # (B, 32, N)\n        y = y_base + self.alpha * y_resid\n\n        if base_updates is not None:\n            return y, base_updates\n        return y\n\ndef create_network(hparams):\n    # Build base FF-LN model using lineage implementation, then wrap it\n    base_hparams = {\n        'learning_rate': hparams.get('learning_rate', 9e-4),\n        'rank_k': hparams.get('rank_k', 320),\n        'proj_rank': hparams.get('proj_rank', 36),\n        'hidden_size': hparams.get('hidden_size', 160),\n        'drop': hparams.get('drop', 0.05),\n        'gamma_start': hparams.get('gamma_start', 0.25),\n        'gamma_end': hparams.get('gamma_end', 0.99),\n        'learn_gamma': hparams.get('learn_gamma', True),\n    }\n    base_net = create_base_network(base_hparams)\n    return NeuronFactorWrapper(\n        base_net=base_net,\n        rank_factors=hparams.get('rank_factors', 8),\n        context_hidden=hparams.get('context_hidden', 64),\n        alpha=hparams.get('alpha', 0.07),\n    )\n\ndef compute_loss(predictions, targets, params, x):\n    # MAE with temporal curvature penalty (as in lineage SOTA) + light L2 on U\n    loss = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n    U = params['nf']['U']\n    l2_u = 1e-6 * jnp.mean(U * U)\n    return loss + l2_u\n\ndef create_optimizer(learning_rate: float = 9e-4):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n",
