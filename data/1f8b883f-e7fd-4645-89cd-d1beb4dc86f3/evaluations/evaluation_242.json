    "content": "import sys, os, json\nsys.path.append('storage/ariadne')\n\nimport optax\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\n\nfrom models_mlp_global import create_network, _define_hyperparameters as _def_base, BASE_SEED, BATCH_SIZE\nfrom losses import mae_with_temporal_curvature\n\ndef _define_hyperparameters():\n    # Match ID 230: p=32, 512x2, dropout=0.10\n    return _def_base()\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate, eps=1e-8)\n    )\n\ndef _device_get(tree):\n    try:\n        return jax.device_get(tree)\n    except Exception:\n        return tree\n\ndef complete(params, opt_state, trial_data):\n    # Export analysis artifacts to lineage storage\n    root = f\"storage/ariadne/analyses/mlp_global_p32_dr0.10/trial_{trial_data.get('seed', 'na')}\"\n    os.makedirs(root, exist_ok=True)\n    p = params.get('params', params)\n\n    # Save U, V if present\n    if 'U' in p:\n        np.save(os.path.join(root, 'U.npy'), _device_get(p['U']))\n    if 'V' in p:\n        np.save(os.path.join(root, 'V.npy'), _device_get(p['V']))\n\n    # Save scalar summary JSON\n    summary = {\n        'val_mae': float(trial_data.get('val_mae', -1.0)),\n        'hyperparameters': trial_data.get('hyperparameters', {}),\n        'seed': int(trial_data.get('seed', -1)),\n        'trial_number': int(trial_data.get('trial_number', -1)),\n    }\n    with open(os.path.join(root, 'summary.json'), 'w') as f:\n        json.dump(summary, f, indent=2)\n",
