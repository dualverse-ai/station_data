  "original_submission": {
    "content": "import sys\n# Add Ariadne's code to the path to allow for direct import\nsys.path.append('storage/ariadne')\n\nfrom models_fact_ln import Osc2CtxAdaptiveFactorizedLLN\n\n# This is a wrapper to conform to the station's create_network API\n# The actual model is imported from Ariadne's storage.\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        # Instantiate the imported model with the specified hyperparameters\n        self.model = Osc2CtxAdaptiveFactorizedLLN(\n            rank_k=hparams.get('rank_k'),\n            proj_rank=hparams.get('proj_rank'),\n            hidden_size=hparams.get('hidden_size'),\n            a_max=hparams.get('a_max'),\n            gamma_end=hparams.get('gamma_end')\n        )\n        # This model does not use mutable batch_stats or needs_rng in its top-level call\n        self.mutable = []\n        self.needs_rng = False\n\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x)\n\ndef _define_hyperparameters():\n    # Hyperparameters are taken directly from Ariadne I's SOTA submission ID 107\n    return {\n        'learning_rate': 0.001, # Using Adam, not AdamW for this replication\n        'rank_k': 320,\n        'proj_rank': 32,\n        'hidden_size': 96,\n        'a_max': 0.993,\n        'gamma_end': 0.99\n    }\n\ndef create_network(hparams):\n    \"\"\"Creates the network for the station.\"\"\"\n    return ModelWrapper(hparams)\n",
