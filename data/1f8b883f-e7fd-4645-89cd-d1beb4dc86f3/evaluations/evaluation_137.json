  "original_submission": {
    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport jax\nimport jax.numpy as jnp\nimport optax\n\nfrom models_fact_ln import Osc2CtxAdaptiveFactorizedL_LN\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\nV_ORTHO_LAM = 1e-5\nU_ORTHO_LAM = 1e-6\nGAMMA_PRIOR_LAM = 5e-6\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,\n        'proj_rank': 32,\n        'hidden_size': 96,\n        'normalize_u': True,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'a_max': 0.993\n    }\n\nclass Wrapper:\n    def __init__(self, **kwargs):\n        self.model = Osc2CtxAdaptiveFactorizedL_LN(**kwargs)\n        self.needs_rng = False\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x, training=training)\n\ndef create_network(hparams):\n    return Wrapper(\n        rank_k=int(hparams.get('rank_k', 320)),\n        proj_rank=int(hparams.get('proj_rank', 32)),\n        hidden_size=int(hparams.get('hidden_size', 96)),\n        normalize_u=bool(hparams.get('normalize_u', True)),\n        gamma_start=float(hparams.get('gamma_start', 0.25)),\n        gamma_end=float(hparams.get('gamma_end', 0.99)),\n        a_max=float(hparams.get('a_max', 0.993))\n    )\n\ndef _get_from_tree(tree, key):\n    try:\n        if key in tree:\n            return tree[key]\n    except Exception:\n        pass\n    if isinstance(tree, dict) and 'params' in tree:\n        return _get_from_tree(tree['params'], key)\n    try:\n        return _get_from_tree(dict(tree), key)\n    except Exception:\n        raise KeyError(f\"{key} not found\")\n\ndef _col_norm(x, axis):\n    return jnp.linalg.norm(x, axis=axis, keepdims=True) + 1e-6\n\ndef compute_loss(predictions, targets, params, x):\n    base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n    # V orthonormal penalty on normalized columns\n    try:\n        V = _get_from_tree(params, 'V')\n        Vn = V / _col_norm(V, axis=0)\n        GV = Vn.T @ Vn\n        IV = jnp.eye(GV.shape[0], dtype=GV.dtype)\n        v_ortho = jnp.sum((GV - IV) ** 2)\n    except Exception:\n        v_ortho = 0.0\n    # U orthonormal penalty on normalized columns\n    try:\n        U = _get_from_tree(params, 'U')\n        Un = U / _col_norm(U, axis=0)\n        GU = Un.T @ Un\n        IU = jnp.eye(GU.shape[0], dtype=GU.dtype)\n        u_ortho = jnp.sum((GU - IU) ** 2)\n    except Exception:\n        u_ortho = 0.0\n    # \u03b3 prior\n    try:\n        gamma_raw = _get_from_tree(params, 'gamma_raw')\n        gamma = jax.nn.sigmoid(gamma_raw)\n        T = gamma.shape[0]\n        t = jnp.linspace(0.0, 1.0, T, dtype=gamma.dtype)\n        sched = 0.25 + (0.99 - 0.25) * t\n        g_prior = jnp.sum((gamma - sched) ** 2)\n    except Exception:\n        g_prior = 0.0\n    return base + V_ORTHO_LAM * v_ortho + U_ORTHO_LAM * u_ortho + GAMMA_PRIOR_LAM * g_prior\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate, eps=1e-8)\n    )\n",
