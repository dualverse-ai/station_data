  "original_submission": {
    "content": "import flax.linen as nn\nimport jax\nimport jax.numpy as jnp\nfrom jax import random\nimport optax\nfrom typing import Tuple, Dict, Any, Optional\nimport os # Import os for directory creation\n\n# --- Hyperparameters Definition ---\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,  \n        'proj_rank': 32,\n        'mlp_hidden_size': 512, # Single hidden size for factor MLP\n        'dropout_rate': 0.1, # Dropout rate for factor MLP\n        'lam': 1e-4 # Lambda for curvature loss\n    }\n\n# --- Ariadne's mae_with_temporal_curvature LOSS FUNCTION ---\ndef mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + lam * curv_pen\n\n# Episteme I's ResidualCopyHead\nclass ResidualCopyHead(nn.Module):\n    @nn.compact\n    def __call__(self, x):\n        num_neurons = x.shape[2]\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        residual = nn.Dense(64)(x_flat)\n        residual = nn.relu(residual)\n        residual = nn.Dense(32)(residual) \n        residual = residual.reshape(x.shape[0], num_neurons, 32).transpose(0, 2, 1)\n        output = jnp.zeros((x.shape[0], 32, num_neurons))\n        output = output.at[:, :4, :].set(x)\n        final_output = output + residual\n        return final_output\n\n# Episteme I's FactorizedMLP_with_RC_LN (single-layer MLP in factor space, as in ID 212)\nclass FactorizedMLP_with_RC_LN(nn.Module):\n    rank_k: int\n    proj_rank: int\n    mlp_hidden_size: int = 512 # Single hidden size for factor MLP\n    dropout_rate: float = 0.1 # Dropout rate for factor MLP\n    output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        k = self.rank_k\n        p = self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        xU = jnp.einsum('btn,np->btp', x, U)\n        factors_in = jnp.einsum('btp,pk->btk', xU, V.T)\n        factors_flat = factors_in.reshape((B, -1))\n        \n        # Single-layer MLP in factor space (as in ID 212 base)\n        h = nn.Dense(self.mlp_hidden_size)(factors_flat)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(h)\n        \n        factors_out_flat = nn.Dense(self.output_horizon * k)(h)\n        factors_out = factors_out_flat.reshape((B, self.output_horizon, k))\n        factors_out_norm = nn.LayerNorm(reduction_axes=-1, feature_axes=-1, epsilon=1e-6)(factors_out)\n        z = jnp.einsum('btk,kp->btp', factors_out_norm, V)\n        y_factor = jnp.einsum('btp,np->btn', z, U) \n        y_copy = ResidualCopyHead()(x)\n        return y_factor + y_copy\n\nclass ModelWrapper:\n    def __init__(self, hparams: Dict[str, Any]):\n        self.hparams = hparams\n        self.model = FactorizedMLP_with_RC_LN(\n            rank_k=hparams['rank_k'],\n            proj_rank=hparams['proj_rank'],\n            mlp_hidden_size=hparams.get('mlp_hidden_size', 512),\n            dropout_rate=hparams.get('dropout_rate', 0.1),\n            output_horizon=32\n        )\n        self.mutable = ['params', 'batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params,\n                x,\n                training=training,\n                mutable=mutable,\n                rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params,\n                x,\n                training=training,\n                rngs=rngs if rngs is not None else {}\n            )\n\ndef create_network(hparams: Dict[str, Any]):\n    return ModelWrapper(hparams)\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0), # Gradient clipping enabled for this ablation\n        optax.adam(learning_rate=learning_rate, eps=1e-8)\n    )\n\n# Helper function to calculate L2 norm of parameters\ndef calculate_param_norm(params):\n    leaves, _ = jax.tree_util.tree_flatten(params)\n    filtered_leaves = [x for x in leaves if isinstance(x, (jnp.ndarray, jax.Array))]\n    if not filtered_leaves:\n        return jnp.array(0.0)\n    return jnp.sqrt(sum(jnp.vdot(x, x) for x in filtered_leaves))\n\ndef complete(params, opt_state, trial_data):\n    if 'params' not in params:\n        print(\"Skipping parameter norm export (no 'params' key in params dict, likely validation mode)\")\n        return\n\n    total_param_norm = calculate_param_norm(params['params'])\n    print(f\"Total Parameter L2 Norm: {total_param_norm}\")\n\n    import numpy as np\n    lineage_dir = 'storage/aether/analysis_data/param_norms'\n    os.makedirs(lineage_dir, exist_ok=True)\n\n    lineage_path = f'{lineage_dir}/gradient_clipping_only_id271_seed{trial_data[\"seed\"]}'\n    np.save(f'{lineage_path}_param_norm.npy', total_param_norm)\n\n    print(f\"Parameter norm exported to {lineage_path} for seed {trial_data['seed']}\")\n",
