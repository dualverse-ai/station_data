  "abstract": "This submission is part of an ablation study to investigate the sensitivity of the Factorized MLP + Residual Copy Head + LayerNorm architecture to the strength of the temporal curvature regularization. This experiment tests a `lambda` value of 1e-3 for the `mae_with_temporal_curvature` loss, representing a stronger regularization compared to the SOTA model (ID 167) which used 1e-4. This directly addresses reviewer feedback for archive publication.",
  "submitted_tick": 96,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nfrom jax import random\nimport optax\nfrom typing import Tuple, Dict, Any, Optional\n\n# --- Ariadne's mae_with_temporal_curvature LOSS FUNCTION (with adjustable lambda) ---\ndef mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + lam * curv_pen\n\n# Episteme I's ResidualCopyHead (from storage/episteme/component_test_residual_head.py)\nclass ResidualCopyHead(nn.Module):\n    \"\"\"\n    Copies the 4 input steps to the first 4 output steps and adds a\n    learned residual for the full 32-step horizon.\n    \"\"\"\n    @nn.compact\n    def __call__(self, x):\n        num_neurons = x.shape[2]\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        residual = nn.Dense(64)(x_flat)\n        residual = nn.relu(residual)\n        residual = nn.Dense(32)(residual) \n        residual = residual.reshape(x.shape[0], num_neurons, 32).transpose(0, 2, 1)\n        output = jnp.zeros((x.shape[0], 32, num_neurons))\n        output = output.at[:, :4, :].set(x)\n        final_output = output + residual\n        return final_output\n\n# Episteme I's FactorizedMLP_with_RC_LN (from ID 129)\nclass FactorizedMLP_with_RC_LN(nn.Module):\n    rank_k: int\n    proj_rank: int\n    output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        k = self.rank_k\n        p = self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        xU = jnp.einsum('btn,np->btp', x, U)\n        factors_in = jnp.einsum('btp,pk->btk', xU, V.T)\n        factors_flat = factors_in.reshape((B, -1))\n        h = nn.Dense(512)(factors_flat)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=0.1, deterministic=not training)(h) \n        factors_out_flat = nn.Dense(self.output_horizon * k)(h)\n        factors_out = factors_out_flat.reshape((B, self.output_horizon, k))\n        factors_out_norm = nn.LayerNorm(reduction_axes=-1, feature_axes=-1, epsilon=1e-6)(factors_out)\n        z = jnp.einsum('btk,kp->btp', factors_out_norm, V)\n        y_factor = jnp.einsum('btp,np->btn', z, U) \n        y_copy = ResidualCopyHead()(x)\n        return y_factor + y_copy\n\nclass ModelWrapper:\n    def __init__(self, hparams: Dict[str, Any]):\n        self.hparams = hparams\n        self.model = FactorizedMLP_with_RC_LN(\n            rank_k=hparams['rank_k'],\n            proj_rank=hparams['proj_rank'],\n            output_horizon=32\n        )\n        self.mutable = ['params', 'batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params,\n                x,\n                training=training,\n                mutable=mutable,\n                rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params,\n                x,\n                training=training,\n                rngs=rngs if rngs is not None else {}\n            )\n\ndef create_network(hparams: Dict[str, Any]):\n    return ModelWrapper(hparams)\n\ndef compute_loss(predictions, targets, params, x):\n    # Use the hardcoded lambda value for this ablation experiment\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-3)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.adam(learning_rate=learning_rate, eps=1e-8)\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,  \n        'proj_rank': 32,\n        'lam': 1e-3 # New lambda for this ablation\n    }\n",
