  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nimport optax\nfrom jax import random\nfrom typing import Tuple, Dict, Any, Optional\n\n# --- Hyperparameters Definition ---\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.0009, # Ariadne's lr\n        'rank_k': 320,\n        'proj_rank': 36,\n        'mlp_hidden_size': 160, # NEW: Ariadne's H=160x2\n        'mlp_hidden_size2': 160, # NEW: Ariadne's H=160x2\n        'dropout_rate': 0.05 # NEW: Ariadne's dropout=0.05\n    }\n\n# --- Ariadne's mae_with_temporal_curvature LOSS FUNCTION ---\ndef mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + lam * curv_pen\n\n# Episteme's ResidualCopyHead\nclass ResidualCopyHead(nn.Module):\n    dropout_rate: float\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        num_neurons = x.shape[2]\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        residual = nn.Dense(64)(x_flat); residual = nn.relu(residual)\n        residual = nn.Dropout(rate=self.dropout_rate)(residual, deterministic=not training)\n        residual = nn.Dense(32)(residual)\n        residual = residual.reshape(x.shape[0], num_neurons, 32).transpose(0, 2, 1)\n        output = jnp.zeros((x.shape[0], 32, num_neurons)); output = output.at[:, :4, :].set(x)\n        return output + residual\n\n# Episteme's FourierForecasterLN\nclass FourierForecasterLN(nn.Module):\n    rank_k: int\n    proj_rank: int\n    dropout_rate: float\n    mlp_hidden_size: int # Passed from hparams\n    mlp_hidden_size2: int # Passed from hparams\n    num_neurons: int = 71721\n    output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U_eff = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n\n        # --- Fourier Branch ---\n        x_fft = jnp.fft.rfft(x, axis=1)\n        x_fft_transposed = jnp.transpose(x_fft, (0, 2, 1))\n        \n        factors_in_fft = jnp.einsum('bni,np->bip', x_fft_transposed, U_eff) @ V.T\n        \n        factors_in_flat = jnp.concatenate([factors_in_fft.real, factors_in_fft.imag], axis=-1).reshape(B, -1)\n        \n        # Deeper MLP in flattened factor-frequency space with tuned hidden sizes\n        h = nn.Dense(self.mlp_hidden_size)(factors_in_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=not training)\n        h = nn.Dense(self.mlp_hidden_size2)(h); h = nn.relu(h)\n        h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=not training)\n        \n        num_out_freqs = self.output_horizon // 2 + 1\n        factors_out_flat = nn.Dense(num_out_freqs * k * 2)(h)\n        \n        factors_out_real, factors_out_imag = jnp.split(factors_out_flat.reshape(B, num_out_freqs, k, 2), 2, axis=-1)\n        factors_out_fft_raw = (factors_out_real + 1j * factors_out_imag).squeeze(-1)\n\n        norm_real = nn.LayerNorm()(factors_out_fft_raw.real)\n        norm_imag = nn.LayerNorm()(factors_out_fft_raw.imag)\n        factors_out_fft_norm = norm_real + 1j * norm_imag\n\n        y_fft = (factors_out_fft_norm @ V) @ U_eff.T\n        y_fourier = jnp.fft.irfft(y_fft, n=self.output_horizon, axis=1)\n\n        # --- Time Branch ---\n        y_copy = ResidualCopyHead(dropout_rate=self.dropout_rate)(x, training=training)\n        \n        return y_fourier + y_copy\n\n# --- Submission API ---\nclass ModelWrapper:\n    def __init__(self, hparams: Dict[str, Any]):\n        self.hparams = hparams\n        self.model = FourierForecasterLN(\n            rank_k=hparams['rank_k'], \n            proj_rank=hparams['proj_rank'],\n            dropout_rate=hparams['dropout_rate'],\n            mlp_hidden_size=hparams['mlp_hidden_size'], # Pass hidden sizes\n            mlp_hidden_size2=hparams['mlp_hidden_size2'] # Pass hidden sizes\n        )\n        self.needs_rng = True # For dropout\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params,\n                x,\n                training=training,\n                mutable=mutable,\n                rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params,\n                x,\n                training=training,\n                rngs=rngs if rngs is not None else {}\n            )\n\ndef create_network(hparams: Dict[str, Any]):\n    return ModelWrapper(hparams)\n\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n\ndef complete(params, opt_state, trial_data):\n    print(f\"Completion for Ariadne I's SOTA Replication. Seed: {trial_data['seed']}\")\n",
