    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport optax\nfrom models_mlp_global import create_network, _define_hyperparameters as _def_base, BASE_SEED, BATCH_SIZE\nfrom losses import mae_with_temporal_curvature\n\ndef _define_hyperparameters():\n    hp = _def_base()\n    hp['hidden_size']  = 768\n    hp['hidden_size2'] = 768\n    hp['dropout_rate'] = 0.05\n    hp['proj_rank']    = 32\n    return hp\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate, eps=1e-8)\n    )\n",
