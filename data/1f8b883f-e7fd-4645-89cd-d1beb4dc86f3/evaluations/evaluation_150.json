  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nfrom jax import random\n\nNUM_NEURONS = 71721\nINPUT_HORIZON = 4\nOUTPUT_HORIZON = 32\n\n# Using my proven, computationally efficient MoE-MLP architecture from ID 65\n# The innovation is in the custom loss and the corrected forward pass\n\nclass MlpExpert(nn.Module):\n    embedding_dim: int\n    hidden_size: int\n    dropout_rate: float\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size = x.shape[0]\n        neuron_indices = jnp.arange(NUM_NEURONS)\n        embeddings = nn.Embed(num_embeddings=NUM_NEURONS, features=self.embedding_dim, name=\"neuron_embed\")(neuron_indices)\n        broadcasted_embeddings = jnp.broadcast_to(embeddings, (batch_size, NUM_NEURONS, self.embedding_dim))\n        \n        x_last_step = jnp.transpose(x[:, -1:, :], (0, 2, 1))\n        combined_input = jnp.concatenate([x_last_step, broadcasted_embeddings], axis=-1)\n        \n        y = jnp.reshape(combined_input, (-1, 1 + self.embedding_dim))\n        y = nn.Dense(self.hidden_size)(y)\n        y = nn.BatchNorm(use_running_average=not training)(y)\n        y = nn.relu(y)\n        y = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(y)\n        output_deltas = nn.Dense(OUTPUT_HORIZON)(y)\n        \n        output_deltas = jnp.reshape(output_deltas, (batch_size, NUM_NEURONS, OUTPUT_HORIZON))\n        output_deltas = jnp.transpose(output_deltas, (0, 2, 1))\n        return output_deltas\n\nclass CnnGatingNetwork(nn.Module):\n    num_experts: int\n    hidden_dim: int\n    cnn_features: int\n    cnn_kernel_size: int\n    pool_window: int\n\n    @nn.compact\n    def __call__(self, x):\n        gater_input = jnp.transpose(x, (0, 2, 1))\n        y = nn.Conv(features=self.cnn_features, kernel_size=(self.cnn_kernel_size,))(gater_input)\n        y = nn.relu(y)\n        y = nn.max_pool(y, window_shape=(self.pool_window,), strides=(self.pool_window,))\n        y = y.reshape((y.shape[0], -1))\n        y = nn.Dense(features=self.hidden_dim)(y)\n        y = nn.relu(y)\n        logits = nn.Dense(features=self.num_experts)(y)\n        return nn.softmax(logits, axis=-1)\n\nclass MoEModel(nn.Module):\n    num_experts: int\n    expert_params: dict\n    gating_params: dict\n    \n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        experts = nn.vmap(\n            MlpExpert, in_axes=None, out_axes=1,\n            variable_axes={'params': 0, 'batch_stats': 0},\n            split_rngs={'params': True, 'dropout': True},\n            axis_size=self.num_experts\n        )(**self.expert_params, name=\"experts\")\n        \n        gating_network = CnnGatingNetwork(**self.gating_params, name=\"gating\")\n        gating_weights = gating_network(x)\n        expert_outputs = experts(x, training=training) # These are deltas\n        \n        gating_weights_reshaped = jnp.expand_dims(jnp.expand_dims(gating_weights, -1), -1)\n        final_deltas = jnp.sum(expert_outputs * gating_weights_reshaped, axis=1)\n        return final_deltas\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'embedding_dim': 8,\n        'hidden_size': 128,\n        'dropout_rate': 0.1,\n        'num_experts': 4,\n        'gating_hidden_dim': 32,\n        'gating_cnn_features': 16,\n        'gating_cnn_kernel_size': 128,\n        'gating_pool_window': 256,\n    }\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        expert_params = {\n            'embedding_dim': hparams.get('embedding_dim'),\n            'hidden_size': hparams.get('hidden_size'),\n            'dropout_rate': hparams.get('dropout_rate'),\n        }\n        gating_params = {\n            'num_experts': hparams.get('num_experts'),\n            'hidden_dim': hparams.get('gating_hidden_dim'),\n            'cnn_features': hparams.get('gating_cnn_features'),\n            'cnn_kernel_size': hparams.get('gating_cnn_kernel_size'),\n            'pool_window': hparams.get('gating_pool_window'),\n        }\n        self.model = MoEModel(num_experts=hparams.get('num_experts'), expert_params=expert_params, gating_params=gating_params)\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        return self.model.init({'params': rng_params, 'dropout': rng_dropout}, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        # *** BUG FIX IS HERE ***\n        last_input_step = x[:, -1:, :] # Shape (batch, 1, num_neurons)\n        \n        if mutable:\n            predicted_deltas, updates = self.model.apply(params, x, training=training, mutable=mutable, rngs=rngs)\n            final_prediction = last_input_step + predicted_deltas\n            return final_prediction, updates\n        \n        predicted_deltas = self.model.apply(params, x, training=training, rngs=rngs)\n        final_prediction = last_input_step + predicted_deltas\n        return final_prediction\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n\n# Custom loss function to train on deltas\ndef compute_loss(predictions, targets, params, x):\n    # `predictions` are the FINAL absolute predictions from the corrected `apply` function\n    # We must re-calculate the predicted deltas for the loss function\n    last_input_step = x[:, -1:, :]\n    predicted_deltas = predictions - last_input_step\n    \n    # We calculate the true deltas from the targets\n    true_deltas = targets - last_input_step\n\n    # The loss is the MAE between the deltas\n    return jnp.mean(jnp.abs(predicted_deltas - true_deltas))\n",
