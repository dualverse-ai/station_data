  "cpu_only": false,
  "original_submission": {
    "content": "import flax.linen as nn\nimport jax\nimport jax.numpy as jnp\nfrom jax import random\nimport optax\n\nNUM_NEURONS = 71721\nINPUT_HORIZON = 4\nOUTPUT_HORIZON = 32\n\n# NEW: Simple MLP Gating Network for Latent Space\nclass LatentGatingNetwork(nn.Module):\n    num_experts: int\n    @nn.compact\n    def __call__(self, factors_in): # Takes latent factors as input\n        # factors_in shape: (B, T_in, k)\n        B, T_in, k = factors_in.shape\n        gater_input = factors_in.reshape((B, -1)) # Flatten\n        y = nn.Dense(features=128, name=\"gater_hidden\")(gater_input)\n        y = nn.relu(y)\n        logits = nn.Dense(features=self.num_experts, name=\"gater_out\")(y)\n        return nn.softmax(logits, axis=-1)\n\ndef mae_with_temporal_curvature(predictions, targets, lam=1e-4):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + lam * curv_pen\n\nclass ResidualCopyHead(nn.Module):\n    @nn.compact\n    def __call__(self, x):\n        # ... (code is unchanged, omitting for brevity)\n        num_neurons = x.shape[2]\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        residual = nn.Dense(64)(x_flat)\n        residual = nn.relu(residual)\n        residual = nn.Dense(32)(residual)\n        residual = residual.reshape(x.shape[0], num_neurons, 32).transpose(0, 2, 1)\n        output = jnp.zeros((x.shape[0], 32, num_neurons))\n        output = output.at[:, :4, :].set(x)\n        final_output = output + residual\n        return final_output\n\nclass LatentGated_MoFL_Model(nn.Module):\n    num_experts: int\n    rank_k: int\n    proj_rank: int\n    mlp_hidden_size: int\n    dropout_rate: float\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        k, p, E = self.rank_k, self.proj_rank, self.num_experts\n\n        # --- SOTA Backbone (up to factors_in) ---\n        U_experts = self.param('U_experts', nn.initializers.lecun_normal(), (E, N, p))\n        V_experts = self.param('V_experts', nn.initializers.lecun_normal(), (E, k, p))\n        \n        # --- Gating on Latent Space ---\n        # First, we need a preliminary projection to get factors_in for the gater\n        # Let's use the average of the expert matrices for this single projection\n        U_mean = jnp.mean(U_experts, axis=0)\n        V_mean = jnp.mean(V_experts, axis=0)\n        U_mean_norm = U_mean / (jnp.linalg.norm(U_mean, axis=0, keepdims=True) + 1e-6)\n        \n        xU_mean = jnp.einsum('btn,np->btp', x, U_mean_norm)\n        factors_in = jnp.einsum('btp,kp->btk', xU_mean, V_mean) # V is (k,p), so V.T is (p,k). Or direct bkp->btk\n        \n        gating_network = LatentGatingNetwork(num_experts=E, name=\"gating\")\n        gate_weights = gating_network(factors_in) # (B, E)\n\n        # --- Mixture of Loadings (as before) ---\n        U_batch = jnp.einsum('be,enp->bnp', gate_weights, U_experts)\n        V_batch = jnp.einsum('be,ekp->bkp', gate_weights, V_experts)\n        U_batch = U_batch / (jnp.linalg.norm(U_batch, axis=1, keepdims=True) + 1e-6)\n\n        # --- Rest of SOTA Backbone ---\n        # Re-project with the mixed matrices to get the final factors_in for the forecaster\n        xU = jnp.einsum('btn,bnp->btp', x, U_batch)\n        final_factors_in = jnp.einsum('btp,bkp->btk', xU, V_batch)\n        \n        factors_flat = final_factors_in.reshape((B, -1))\n        h = nn.Dense(self.mlp_hidden_size)(factors_flat)\n        h = nn.relu(h)\n        # ... (rest of MLP is unchanged, omitting for brevity)\n        h = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(h)\n        h = nn.Dense(self.mlp_hidden_size)(h)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(h)\n        factors_out_flat = nn.Dense(OUTPUT_HORIZON * k)(h)\n        factors_out = factors_out_flat.reshape((B, OUTPUT_HORIZON, k))\n        factors_out_norm = nn.LayerNorm()(factors_out)\n        \n        z = jnp.einsum('btk,bkp->btp', factors_out_norm, V_batch)\n        y_factor = jnp.einsum('btp,bnp->btn', z, U_batch)\n        \n        y_copy = ResidualCopyHead()(x)\n        return y_factor + y_copy\n\n# ... (Wrapper, hyperparams, etc. are the same as MoFL, omitting for brevity)\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = LatentGated_MoFL_Model(**hparams)\n        self.needs_rng = True\n    def init(self, rng_key, dummy_input):\n        rngs = {'params': rng_key, 'dropout': rng_key}\n        return self.model.init(rngs, dummy_input, training=True)\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if rngs and 'dropout' in rngs and rngs['dropout'] is not None:\n            return self.model.apply(params, x, training=training, rngs={'dropout': rngs['dropout']})\n        else:\n            return self.model.apply(params, x, training=training)\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001, 'weight_decay': 1e-4, 'gradient_clip': 1.0,\n        'num_experts': 4, 'rank_k': 320, 'proj_rank': 32,\n        'mlp_hidden_size': 512, 'dropout_rate': 0.1,\n    }\n\ndef create_network(hparams):\n    model_params = {k: hparams.get(k) for k in ['num_experts', 'rank_k', 'proj_rank', 'mlp_hidden_size', 'dropout_rate']}\n    return ModelWrapper(hparams=model_params)\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    hparams = _define_hyperparameters()\n    return optax.chain(\n        optax.clip_by_global_norm(hparams.get('gradient_clip')),\n        optax.adamw(learning_rate=learning_rate, weight_decay=hparams.get('weight_decay'))\n    )\n",
