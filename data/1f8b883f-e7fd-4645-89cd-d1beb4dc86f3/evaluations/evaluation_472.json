    "content": "import sys, optax\nsys.path.append('storage/ariadne')\n\nimport jax\nimport jax.numpy as jnp\n\nfrom models_fourier_ramp import create_network, export_stats\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n\nLAM_CURV = 1e-4\nLAM_MONO = 1e-5    # penalize decreases in gamma\nLAM_SMOOTH = 5e-6  # penalize large step-to-step changes\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,\n        'hidden_size': 160,\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': True\n    }\n\n# Robust param fetch (handles nested PyTrees)\ndef _get_param(tree, key):\n    if isinstance(tree, dict):\n        if key in tree:\n            return tree[key]\n        for v in tree.values():\n            try:\n                out = _get_param(v, key)\n                if out is not None:\n                    return out\n            except Exception:\n                pass\n    return None\n\ndef compute_loss(predictions, targets, params, x):\n    base = mae_with_temporal_curvature(predictions, targets, params, x, lam=LAM_CURV)\n    raw = _get_param(params, 'gamma_raw')\n    if raw is None:\n        return base\n    gamma = jax.nn.sigmoid(raw)  # shape (T,)\n    # Monotonicity: penalize decreases (gamma[t] < gamma[t-1])\n    dg = gamma[1:] - gamma[:-1]\n    mono_pen = jnp.sum(jnp.square(jnp.clip(-dg, a_min=0.0)))\n    # Smoothness: penalize large slopes\n    smooth_pen = jnp.sum(jnp.square(dg))\n    return base + LAM_MONO * mono_pen + LAM_SMOOTH * smooth_pen\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n\ndef complete(params, opt_state, trial_data):\n    export_stats(params, trial_data, _define_hyperparameters(), out_dir=\"storage/ariadne/analyses/fourier_learn_gamma_priors/mono_smooth_l1e5_s5e6\")\n",
