  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nimport optax\nfrom jax import random\nfrom typing import Tuple, Dict, Any, Optional\n\n# --- Logos II's CnnGatingNetwork (from storage/logos/mofl_components.py) ---\nclass CnnGatingNetwork(nn.Module):\n    num_experts: int\n    hidden_dim: int\n    cnn_features: int\n    cnn_kernel_size: int\n    pool_window: int\n    @nn.compact\n    def __call__(self, x):\n        # Input x shape: (B, T_in, N)\n        # Transpose for 1D conv over the neuron axis\n        gater_input = jnp.transpose(x, (0, 2, 1)) # (B, N, T_in)\n        y = nn.Conv(features=self.cnn_features, kernel_size=(self.cnn_kernel_size,))(gater_input)\n        y = nn.relu(y)\n        y = nn.max_pool(y, window_shape=(self.pool_window,), strides=(self.pool_window,))\n        y = y.reshape((y.shape[0], -1)) # Flatten\n        y = nn.Dense(features=self.hidden_dim)(y)\n        y = nn.relu(y)\n        logits = nn.Dense(features=self.num_experts)(y)\n        return nn.softmax(logits, axis=-1)\n\n# --- Logos II's RampMLP (from MoLR_v1 submission ID 475) ---\nclass RampMLP(nn.Module):\n    \"\"\"A small MLP to learn a non-linear ramp shape.\"\"\"\n    @nn.compact\n    def __call__(self, t):\n        # t is shape (32,)\n        t = t[:, None] # Reshape to (32, 1) for Dense layer\n        h = nn.Dense(8, name=\"MLP_hidden\")(t)\n        h = nn.relu(h)\n        h = nn.Dense(1, name=\"MLP_output\")(h)\n        ramp_unscaled = nn.sigmoid(h.squeeze()) # Output shape (32,), bounded to (0,1)\n        \n        # Add a learnable scalar to control the ramp's dynamic range\n        ramp_scale = self.param('ramp_scale', nn.initializers.constant(2.0), ())\n        \n        return ramp_unscaled * ramp_scale\n\n# --- Standard ResidualCopyHead from SOTA (for consistency) ---\nclass ResidualCopyHead(nn.Module):\n    drop: float = 0.05 # Defaulting to SOTA drop\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        h = nn.Dense(64)(x_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(32)(h)\n        residual = h.reshape(B, N, 32).transpose(0, 2, 1)\n        out = jnp.zeros((B, 32, N), dtype=residual.dtype)\n        out = out.at[:, :4, :].set(x)\n        return out + residual\n\n# --- FourierBackbone from MoLR_v1 submission ID 475 ---\nclass FourierBackbone(nn.Module):\n    rank_k: int; proj_rank: int; hidden_size: int; drop: float\n    @nn.compact\n    def __call__(self, x, training=False):\n        B, _, N = x.shape; k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U_eff = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        x_fft = jnp.fft.rfft(x, axis=1)\n        x_fft_bn = jnp.transpose(x_fft, (0, 2, 1))\n        f_in_fft = jnp.einsum('bnf,np->bfp', x_fft_bn, U_eff) @ V.T\n        f_ri = jnp.concatenate([f_in_fft.real, f_in_fft.imag], axis=-1)\n        f_flat = f_ri.reshape(B, -1)\n        h = nn.Dense(self.hidden_size)(f_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(self.hidden_size)(h); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        out_flat = nn.Dense((32 // 2 + 1) * k * 2)(h)\n        out_ri = out_flat.reshape(B, 32 // 2 + 1, k, 2)\n        f_fft = out_ri[..., 0] + 1j * out_ri[..., 1]\n        f_fft_n = (nn.LayerNorm()(f_fft.real) + 1j * nn.LayerNorm()(f_fft.imag))\n        y_fft = (f_fft_n @ V) @ U_eff.T\n        y_fourier = jnp.fft.irfft(y_fft, n=32, axis=1)\n        return y_fourier\n        \n# --- MoLR_v1 from submission ID 475 ---\nclass MoLR_v1(nn.Module):\n    sota_params: dict; gating_params: dict; num_gamma_archetypes: int\n    @nn.compact\n    def __call__(self, x, training=False):\n        y_fourier = FourierBackbone(**self.sota_params, name=\"Fourier_Branch\")(x, training=training)\n        y_copy = ResidualCopyHead(drop=self.sota_params['drop'], name=\"Copy_Branch\")(x, training=training) # Ensuring drop is passed\n        gating_network = CnnGatingNetwork(**self.gating_params, name=\"gating\")\n        gating_weights = gating_network(x) # Shape (B, E)\n        \n        # Generate archetype ramps using the new RampMLP\n        ramp_mlps = [RampMLP(name=f\"RampMLP_{i}\") for i in range(self.num_gamma_archetypes)]\n        t = jnp.linspace(0.0, 1.0, 32, dtype=y_fourier.dtype)\n        archetype_ramps = jnp.stack([mlp(t) for mlp in ramp_mlps]) # Shape (E, 32)\n        \n        # Mix the archetype ramps\n        batch_ramps = jnp.einsum('be,et->bt', gating_weights, archetype_ramps) # Shape (B, 32)\n        \n        final_output = y_copy + y_fourier * batch_ramps[:, :, None]\n        return final_output\n\n# --- Submission API ---\nBASE_SEED = 447516 # Matching Logos II's default seed for ID 475\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.0009, \n        'rank_k': 320, \n        'proj_rank': 36, \n        'hidden_size': 160, # Fourier Backbone MLP hidden size\n        'drop': 0.05,\n        'num_gamma_archetypes': 4, # Number of learned ramps\n        'gating_hidden_dim': 32, # Hidden dim for the gating MLP\n        'gating_cnn_features': 16, # CNN features for gating network\n        'gating_cnn_kernel_size': 128, # CNN kernel size for gating network\n        'gating_pool_window': 256, # Pooling window for gating network\n        'adam_eps': 1e-8, # Adam epsilon from SOTA\n        'clip_norm': 1.0 # Clip norm from SOTA\n    }\n\nclass ModelWrapper:\n    def __init__(self, hparams: Dict[str, Any]):\n        self.hparams = hparams\n        sota_params = {'rank_k': hparams['rank_k'], 'proj_rank': hparams['proj_rank'], 'hidden_size': hparams['hidden_size'], 'drop': hparams['drop']}\n        gating_params = {'num_experts': hparams['num_gamma_archetypes'], 'hidden_dim': hparams['gating_hidden_dim'], 'cnn_features': hparams['gating_cnn_features'], 'cnn_kernel_size': hparams['gating_cnn_kernel_size'], 'pool_window': hparams['gating_pool_window']}\n        self.model = MoLR_v1(sota_params=sota_params, gating_params=gating_params, num_gamma_archetypes=hparams['num_gamma_archetypes'])\n        self.needs_rng = True # For dropout in FourierBackbone and ResidualCopyHead\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params,\n                x,\n                training=training,\n                mutable=mutable,\n                rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params,\n                x,\n                training=training,\n                rngs=rngs if rngs is not None else {}\n            )\n\ndef create_network(hparams: Dict[str, Any]):\n    return ModelWrapper(hparams)\n\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen # Uses temporal curvature loss\n\ndef create_optimizer(learning_rate: float = 0.001):\n    hparams = _define_hyperparameters() # Get hparams for clip_norm and adam_eps\n    return optax.chain(\n        optax.clip_by_global_norm(hparams['clip_norm']),\n        optax.adam(learning_rate=learning_rate, eps=hparams['adam_eps'])\n    )\n\ndef complete(params, opt_state, trial_data):\n    print(f\"Completion for Replication of Logos II's MoLR v1 (ID 475). Seed: {trial_data['seed']}\")\n",
