  "abstract": "This submission further explores the impact of neuron identity embeddings on forecasting accuracy by increasing the embedding dimension from 16 to 32. Each neuron's unique embedding vector is concatenated with its temporal input before being processed by the shared MLP, aiming for a richer neuron-specific representation.",
  "submitted_tick": 147,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport jax.numpy as jnp\nfrom jax import random\nimport optax\nimport flax.linen as nn\nimport time\nfrom typing import Any, Dict, Tuple, Optional\n\ndef _define_hyperparameters():\n    \"\"\"\n    Define hyperparameter values for the model.\n    Includes embedding_dim for neuron identity embeddings, increased to 32.\n    \"\"\"\n    return {\n        'learning_rate': 0.001,\n        'hidden_size': 128,\n        'dropout_rate': 0.1,\n        'embedding_dim': 32 # Increased embedding_dim\n    }\n\n\nclass NeuronEmbeddedMLP(nn.Module):\n    \"\"\"\n    Shared-neuron MLP with per-neuron embeddings concatenated to input.\n    \"\"\"\n    num_neurons: int # Number of neurons for nn.Embed\n    hidden_size: int\n    dropout_rate: float\n    embedding_dim: int # Dimension of neuron embeddings\n    output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size, input_horizon, _ = x.shape \n\n        # 1. Generate neuron IDs and embeddings\n        neuron_ids = jnp.arange(self.num_neurons) # (num_neurons,)\n        \n        neuron_embeddings = nn.Embed(\n            num_embeddings=self.num_neurons,\n            features=self.embedding_dim,\n            name=\"neuron_embed\" \n        )(neuron_ids) # (num_neurons, embedding_dim)\n        \n        neuron_embeddings_expanded = jnp.tile(neuron_embeddings[jnp.newaxis, :, :], (batch_size, 1, 1))\n\n        # 2. Prepare x for concatenation and flattening\n        x_transposed = jnp.transpose(x, (0, 2, 1)) # (batch_size, num_neurons, input_horizon)\n        \n        x_with_embeddings = jnp.concatenate([x_transposed, neuron_embeddings_expanded], axis=-1)\n\n        # 3. Reshape for shared MLP processing\n        mlp_input_dim = input_horizon + self.embedding_dim\n        x_flat = jnp.reshape(x_with_embeddings, (batch_size * self.num_neurons, mlp_input_dim))\n\n        # 4. Shared MLP layers\n        x_flat = nn.Dense(self.hidden_size)(x_flat)\n        x_flat = nn.BatchNorm(use_running_average=not training)(x_flat)\n        x_flat = nn.relu(x_flat)\n        x_flat = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(x_flat)\n\n        x_flat = nn.Dense(self.output_horizon)(x_flat) # Output size (32)\n\n        # 5. Reshape back to (batch_size, output_horizon, num_neurons)\n        x_output = jnp.reshape(x_flat, (batch_size, self.num_neurons, self.output_horizon))\n        x_output = jnp.transpose(x_output, (0, 2, 1)) # (batch_size, 32, num_neurons)\n\n        return x_output\n\n\nclass NeuronEmbeddedMLPWrapper:\n    \"\"\"\n    Wrapper to make Flax model compatible with the training system.\n    Handles BatchNorm state and Dropout RNG requirements.\n    \"\"\"\n\n    def __init__(self, hparams: Dict[str, Any], num_neurons: int = 71721):\n        self.model = NeuronEmbeddedMLP(\n            num_neurons=num_neurons,\n            hidden_size=hparams['hidden_size'],\n            dropout_rate=hparams['dropout_rate'],\n            embedding_dim=hparams['embedding_dim']\n        )\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params,\n                x,\n                training=training,\n                mutable=mutable,\n                rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params,\n                x,\n                training=training,\n                rngs=rngs if rngs is not None else {}\n            )\n\n\ndef create_network(hparams: Dict[str, Any]):\n    \"\"\"Create and return the NeuronEmbeddedMLP network.\"\"\"\n    return NeuronEmbeddedMLPWrapper(hparams, num_neurons=71721)\n",
