  "original_submission": {
    "content": "import sys, os, json\nsys.path.append('storage/ariadne')\n\nimport jax\nimport jax.numpy as jnp\nimport flax.linen as nn\nimport optax\n\nfrom models import ResidualCopyHead\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n\nclass FourierSAPModel(nn.Module):\n    rank_k: int = 320\n    proj_rank_max: int = 40\n    num_harmonics: int = 16\n    hidden_size: int = 128\n    gamma_start: float = 0.25\n    gamma_end: float = 0.99\n    gate_temp: float = 1.0\n    ln_in_factor: bool = True\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        T_out = 32\n        k = self.rank_k\n        p = self.proj_rank_max\n        M = self.num_harmonics\n\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        gates_raw = self.param('gates_raw', nn.initializers.zeros, (p,))\n        g = nn.sigmoid(gates_raw / self.gate_temp)\n\n        xU = jnp.einsum('btn,np->btp', x, U)\n        xU_g = xU * g[None, None, :]\n        factors_in = jnp.einsum('btp,pk->btk', xU_g, V.T)  # (B,4,k)\n\n        c = jnp.mean(factors_in, axis=1)  # (B,k)\n\n        freq_raw = self.param('freq_raw', nn.initializers.zeros, (k, M))\n        w = jnp.pi * nn.sigmoid(freq_raw)\n        t = jnp.arange(1, T_out + 1, dtype=x.dtype)[:, None, None]\n        cos = jnp.cos(t * w[None, :, :])\n        sin = jnp.sin(t * w[None, :, :])\n        phi = jnp.concatenate([cos, sin], axis=2)  # (T,k,2M)\n\n        h = nn.Dense(self.hidden_size)(c[..., None]); h = nn.gelu(h)\n        A = nn.Dense(2 * M)(h)  # (B,k,2M)\n\n        f_harm = jnp.einsum('bkd,tkd->btk', A, phi)  # (B,T,k)\n        if self.ln_in_factor:\n            f_harm = nn.LayerNorm(epsilon=1e-6)(f_harm)\n\n        gamma_raw = self.param('gamma_raw', nn.initializers.zeros, (T_out,))\n        # initialize gamma to linear ramp from 0.25 to 0.99\n        if self.is_mutable_collection('params'):\n            pass  # no special init hook; relying on zeros -> sigmoid(0)=0.5; curvature/loss learns it\n        gamma = nn.sigmoid(gamma_raw)[None, :, None]\n        f_out = gamma * f_harm\n\n        Vg = V * g[None, :]\n        z = jnp.einsum('btk,kp->btp', f_out, Vg)\n        y_factor = jnp.einsum('btp,np->btn', z, U)\n\n        y_copy = ResidualCopyHead(output_horizon=T_out)(x)\n        return y_copy + y_factor\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank_max': 40,\n        'num_harmonics': 16,\n        'hidden_size': 128,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'gate_temp': 1.0,\n        'ln_in_factor': True,\n        'l1_gate': 1.2e-5,\n        'ent_gate': 8.0e-6\n    }\n\nclass Wrapper:\n    def __init__(self, **kwargs):\n        self.model = FourierSAPModel(**kwargs)\n        self.needs_rng = False\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x, training=training)\n\ndef create_network(hparams):\n    return Wrapper(\n        rank_k=int(hparams.get('rank_k', 320)),\n        proj_rank_max=int(hparams.get('proj_rank_max', 40)),\n        num_harmonics=int(hparams.get('num_harmonics', 16)),\n        hidden_size=int(hparams.get('hidden_size', 128)),\n        gamma_start=float(hparams.get('gamma_start', 0.25)),\n        gamma_end=float(hparams.get('gamma_end', 0.99)),\n        gate_temp=float(hparams.get('gate_temp', 1.0)),\n        ln_in_factor=bool(hparams.get('ln_in_factor', True)),\n    )\n\ndef _get_gates(params, gate_temp=1.0):\n    try:\n        gates_raw = params['params']['gates_raw']\n    except Exception:\n        gates_raw = None\n    if gates_raw is None:\n        return None\n    return jax.nn.sigmoid(gates_raw / gate_temp)\n\ndef compute_loss(predictions, targets, params, x):\n    base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n    l1_gate = 1.2e-5\n    ent_gate = 8.0e-6\n    g = _get_gates(params, gate_temp=1.0)\n    if g is None:\n        return base\n    eps = 1e-6\n    ent = g * jnp.log(g + eps) + (1.0 - g) * jnp.log(1.0 - g + eps)\n    return base + l1_gate * jnp.mean(g) + ent_gate * jnp.mean(ent)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    lr = 9e-4\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=lr, eps=1e-8)\n    )\n\ndef complete(params, opt_state, trial_data):\n    g = _get_gates(params, gate_temp=1.0)\n    if g is None:\n        return\n    g_np = jax.device_get(g)\n    stats = {\n        \"gate_mean\": float(g_np.mean()),\n        \"r_eff@0.1\": int((g_np >= 0.1).sum()),\n        \"r_eff@0.2\": int((g_np >= 0.2).sum()),\n        \"r_eff@0.4\": int((g_np >= 0.4).sum()),\n        \"proj_rank_max\": int(g_np.shape[0]),\n        \"val_mae\": float(trial_data.get(\"val_mae\", -1.0)),\n        \"seed\": int(trial_data.get(\"seed\", -1)),\n        \"trial_number\": int(trial_data.get(\"trial_number\", -1)),\n    }\n    out_dir = f\"storage/ariadne/analyses/sap_fourier/P{g_np.shape[0]}/trial_{trial_data.get('seed','x')}\"\n    os.makedirs(out_dir, exist_ok=True)\n    with open(os.path.join(out_dir, \"gate_stats.json\"), \"w\") as f:\n        json.dump(stats, f, indent=2)\n",
