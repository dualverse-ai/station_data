  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import sys\nimport flax.linen as nn\nimport jax.numpy as jnp\nimport optax\n\n# Using my SOTA-tuned Fourier Forecaster as the base\n# I will copy the code and insert the new encoder.\n\nNUM_NEURONS = 71721\nINPUT_HORIZON = 4\nOUTPUT_HORIZON = 32\n\ndef _logit(p): p = jnp.clip(p, 1e-6, 1 - 1e-6); return jnp.log(p) - jnp.log(1 - p)\n\nclass ResidualCopyHead(nn.Module):\n    output_horizon: int = 32\n    @nn.compact\n    def __call__(self, x):\n        x_m1, x_m2, x_m3 = x[:, -1, :], x[:, -2, :], x[:, -3, :]\n        d1, d2 = x_m1 - x_m2, x_m1 - 2.0 * x_m2 + x_m3\n        def c0_init(key, shape, dtype=jnp.float32):\n            t = jnp.arange(shape[0], dtype=dtype); return _logit(0.2 + 0.7 * jnp.exp(-t / 8.0)).astype(dtype)\n        c0_raw = self.param('c0_raw', c0_init, (self.output_horizon,)); c1_raw = self.param('c1_raw', nn.initializers.zeros, (self.output_horizon,)); c2_raw = self.param('c2_raw', nn.initializers.zeros, (self.output_horizon,))\n        c0, c1, c2 = nn.sigmoid(c0_raw), 0.5 * nn.tanh(c1_raw), 0.25 * nn.tanh(c2_raw)\n        return c0[None, :, None] * x_m1[:, None, :] + c1[None, :, None] * d1[:, None, :] + c2[None, :, None] * d2[:, None, :]\n\nclass TemporalCNNEncoder(nn.Module):\n    @nn.compact\n    def __call__(self, x):\n        # x: (B, 4, N) -> Transpose for convolution over time\n        x_t = jnp.transpose(x, (0, 2, 1)) # (B, N, 4)\n        # Reshape for Conv layer\n        x_conv = x_t.reshape(-1, INPUT_HORIZON, 1) # (B*N, 4, 1)\n        # Apply temporal convolution\n        y = nn.Conv(features=8, kernel_size=(2,), padding='VALID')(x_conv)\n        y = nn.relu(y)\n        # Flatten the temporal features\n        y = y.reshape(x.shape[0], NUM_NEURONS, -1) # (B, N, features)\n        # Transpose back to (B, features, N) to match original x shape for einsum\n        y = jnp.transpose(y, (0, 2, 1))\n        return y\n\nclass FactorizedMLP(nn.Module):\n    rank_k: int; proj_rank: int\n    @nn.compact\n    def __call__(self, x, training=False):\n        B, _, N = x.shape; k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p)); V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        \n        # The input to the projection is now the output of the CNN encoder\n        xU = jnp.einsum('btn,np->btp', x, U); factors_in = jnp.einsum('btp,pk->btk', xU, V.T)\n        \n        factors_flat = factors_in.reshape((B, -1))\n        h = nn.Dense(512)(factors_flat)\n        h = nn.Dropout(rate=0.1)(h, deterministic=not training); h = nn.relu(h)\n        factors_out_flat = nn.Dense(OUTPUT_HORIZON * k)(h)\n        factors_out = factors_out_flat.reshape((B, OUTPUT_HORIZON, k))\n        return factors_out\n\nclass EnhancedEncoderFourier(nn.Module):\n    rank_k: int; proj_rank: int\n    @nn.compact\n    def __call__(self, x, training=False):\n        # --- NEW ENCODER ---\n        encoded_x = TemporalCNNEncoder(name=\"TemporalCNNEncoder\")(x)\n        # --- END NEW ENCODER ---\n        \n        factors = FactorizedMLP(rank_k=self.rank_k, proj_rank=self.proj_rank, name=\"backbone\")(encoded_x, training=training)\n        \n        factors_freq = jnp.fft.rfft(factors, axis=1)\n        freq_weights = self.param('freq_weights', nn.initializers.ones, factors_freq.shape[1:], jnp.complex64)\n        y_fourier_freq = factors_freq * freq_weights[None, ...]; y_fourier = jnp.fft.irfft(y_fourier_freq, axis=1)\n        y_fourier = nn.LayerNorm()(y_fourier)\n        proj_head = self.param('proj_head', nn.initializers.lecun_normal(), (self.rank_k, NUM_NEURONS))\n        y_fourier = jnp.einsum('btk,kn->btn', y_fourier, proj_head)\n        y_copy = ResidualCopyHead(output_horizon=OUTPUT_HORIZON)(x)\n        return y_fourier + y_copy\n\ndef _define_hyperparameters():\n    return { 'learning_rate': 0.001, 'rank_k': 320, 'proj_rank': 36 }\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = EnhancedEncoderFourier(rank_k=hparams['rank_k'], proj_rank=hparams['proj_rank'])\n        self.needs_rng = True\n    def init(self, rng_key, dummy_input): return self.model.init({'params': rng_key, 'dropout': rng_key}, dummy_input)\n    def apply(self, params, x, training=False, rngs=None): return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams): return ModelWrapper(hparams)\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets)); curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]; curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\ndef create_optimizer(learning_rate: float): return optax.chain(optax.clip_by_global_norm(1.0), optax.adam(learning_rate=learning_rate))\n",
