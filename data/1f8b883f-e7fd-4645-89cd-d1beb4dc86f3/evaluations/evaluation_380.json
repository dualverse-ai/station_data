  "original_submission": {
    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport jax\nimport jax.numpy as jnp\nimport flax.linen as nn\nimport optax\n\nfrom models import ResidualCopyHead\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n\nclass FourierForecasterLNV3Deep(nn.Module):\n    rank_k: int = 320\n    proj_rank: int = 36\n    num_harmonics: int = 16\n    hidden_size: int = 256\n    gamma_start: float = 0.25\n    gamma_end: float = 0.99\n    ln_in_factor: bool = True\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        T_out = 32\n        k = self.rank_k\n        p = self.proj_rank\n        M = self.num_harmonics\n\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))   # (N,p)\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))   # (k,p)\n\n        xU = jnp.einsum('btn,np->btp', x, U)                         # (B,4,p)\n        factors_in = jnp.einsum('btp,pk->btk', xU, V.T)               # (B,4,k)\n\n        f_flat = jnp.transpose(factors_in, (0, 2, 1)).reshape(B * k, T_in)  # (B*k,4)\n        h = nn.Dense(self.hidden_size)(f_flat); h = nn.gelu(h)\n        h = nn.Dense(self.hidden_size)(h); h = nn.gelu(h)\n        A = nn.Dense(2 * M)(h).reshape(B, k, 2 * M)                         # (B,k,2M)\n        b_const = nn.Dense(1)(h).reshape(B, k, 1)                            # (B,k,1)\n\n        freq_raw = self.param('freq_raw', nn.initializers.zeros, (k, M))     # (k,M)\n        w = jnp.pi * nn.sigmoid(freq_raw)\n        t = jnp.arange(1, T_out + 1, dtype=x.dtype)[:, None, None]\n        cos = jnp.cos(t * w[None, :, :])\n        sin = jnp.sin(t * w[None, :, :])\n        phi = jnp.concatenate([cos, sin], axis=2)                            # (T,k,2M)\n\n        f_harm = jnp.einsum('bkd,tkd->btk', A, phi)                          # (B,T,k)\n        f_const = jnp.broadcast_to(b_const[:, None, :, 0], f_harm.shape)     # (B,T,k)\n        f_lat = f_harm + f_const\n\n        if self.ln_in_factor:\n            f_lat = nn.LayerNorm(epsilon=1e-6)(f_lat)\n\n        def gamma_sched_init(key, shape, dtype=jnp.float32):\n            tt = jnp.linspace(0.0, 1.0, shape[0], dtype=dtype)\n            g_sched = self.gamma_start + (self.gamma_end - self.gamma_start) * tt\n            return jnp.log(g_sched) - jnp.log(1.0 - g_sched)\n        gamma_raw = self.param('gamma_raw', gamma_sched_init, (T_out,))\n        gamma = nn.sigmoid(gamma_raw)[None, :, None]\n        f_out = gamma * f_lat\n\n        z = jnp.einsum('btk,kp->btp', f_out, V)\n        y_factor = jnp.einsum('btp,np->btn', z, U)\n\n        y_copy = ResidualCopyHead(output_horizon=T_out)(x)\n        return y_copy + y_factor\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,\n        'num_harmonics': 16,\n        'hidden_size': 256,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'ln_in_factor': True\n    }\n\nclass Wrapper:\n    def __init__(self, **kwargs):\n        self.model = FourierForecasterLNV3Deep(**kwargs)\n        self.needs_rng = False\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x, training=training)\n\ndef create_network(hparams):\n    return Wrapper(\n        rank_k=int(hparams.get('rank_k', 320)),\n        proj_rank=int(hparams.get('proj_rank', 36)),\n        num_harmonics=int(hparams.get('num_harmonics', 16)),\n        hidden_size=int(hparams.get('hidden_size', 256)),\n        gamma_start=float(hparams.get('gamma_start', 0.25)),\n        gamma_end=float(hparams.get('gamma_end', 0.99)),\n        ln_in_factor=bool(hparams.get('ln_in_factor', True)),\n    )\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    lr = 9e-4\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=lr, eps=1e-8)\n    )\n",
