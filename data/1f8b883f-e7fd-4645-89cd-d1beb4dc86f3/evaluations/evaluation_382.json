  "original_submission": {
    "content": "import sys\nimport flax.linen as nn\nimport jax.numpy as jnp\nimport optax\n\nsys.path.append('storage/episteme')\nfrom fourier_forecaster_v2_ln import FourierForecasterLN\n\n# --- BUGFIX ---\n# Load the variance data ONCE at the script level, outside of any function.\n# This makes it a global constant that can be read by the pure JAX functions.\ntry:\n    NEURON_VARIANCES = jnp.load('storage/logos/neuron_variances.npy')\n    # Normalize weights here to avoid doing it inside the loss function\n    NEURON_VARIANCES_WEIGHTS = 1.0 / (NEURON_VARIANCES + 1e-8)\n    NEURON_VARIANCES_WEIGHTS = NEURON_VARIANCES_WEIGHTS / jnp.mean(NEURON_VARIANCES_WEIGHTS)\nexcept FileNotFoundError:\n    NEURON_VARIANCES_WEIGHTS = None\n# --- END BUGFIX ---\n\ndef _define_hyperparameters():\n    return { 'learning_rate': 0.001, 'rank_k': 320, 'proj_rank': 36, 'curvature_strength': 1e-4 }\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = FourierForecasterLN(rank_k=hparams['rank_k'], proj_rank=hparams['proj_rank'])\n        self.needs_rng = True\n    def init(self, rng_key, dummy_input):\n        return self.model.init({'params': rng_key, 'dropout': rng_key}, dummy_input)\n    def apply(self, params, x, training=False, rngs=None):\n        return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n    \ndef compute_loss(predictions, targets, params, x):\n    hparams = _define_hyperparameters()\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    \n    # Spatially-Adaptive Curvature Penalty\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    \n    if NEURON_VARIANCES_WEIGHTS is not None:\n        # Apply the pre-computed, pre-normalized weights\n        weighted_curv_pen = jnp.mean(NEURON_VARIANCES_WEIGHTS[None, None, :] * (curv * curv))\n    else:\n        # Fallback to uniform penalty if loading failed\n        weighted_curv_pen = jnp.mean(curv * curv)\n    \n    return mae + hparams['curvature_strength'] * weighted_curv_pen\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n",
