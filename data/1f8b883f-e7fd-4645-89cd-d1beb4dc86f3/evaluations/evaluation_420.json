  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import sys\nimport flax.linen as nn\nimport jax.numpy as jnp\nimport jax.random as random \nimport optax\n\n# Note: The FourierForecasterLuminaV2 is modified to remove the embedding for this specific experiment\n# and only integrate the global context. The debugger will handle copying if needed.\n\n# The original ResidualCopyHead remains unchanged for this experiment\nclass ResidualCopyHead(nn.Module):\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        num_neurons = x.shape[2]\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        residual = nn.Dense(64)(x_flat); residual = nn.relu(residual)\n        residual = nn.Dropout(rate=0.1)(residual, deterministic=not training)\n        residual = nn.Dense(32)(residual)\n        residual = residual.reshape(x.shape[0], num_neurons, 32).transpose(0, 2, 1)\n        output = jnp.zeros((x.shape[0], 32, num_neurons)); output = output.at[:, :4, :].set(x)\n        return output + residual\n\nclass FourierForecasterLuminaV2(nn.Module):\n    rank_k: int\n    proj_rank: int\n    # embedding_dim: int # Removed for this experiment\n    global_context_projection_dim: int\n    num_neurons: int = 71721\n    output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape; k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U_eff = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n\n        # --- Fourier Branch ---\n        x_fft = jnp.fft.rfft(x, axis=1) # (B, T_freq, N)\n        x_fft_transposed = jnp.transpose(x_fft, (0, 2, 1)) # (B, N, T_freq)\n\n        # Project input FFT factors into latent space (bip)\n        factors_in_fft = jnp.einsum('bni,np->bip', x_fft_transposed, U_eff) @ V.T # (B, T_freq, k)\n\n        # Flatten factors for MLP input\n        factors_in_flat = jnp.concatenate([factors_in_fft.real, factors_in_fft.imag], axis=-1) # (B, T_freq, k*2)\n        # Reshape to (B, T_freq * k * 2)\n        factors_in_flat = jnp.reshape(factors_in_flat, (B, -1))\n        \n        # --- Integrate Lumina's Custom Global Context here ---\n        # Compute a *single* batch-wise global context from initial `x` (B, T_in, N)\n        x_flat_for_global_context_batch = jnp.reshape(x, (B, T_in * N))\n        global_context_batch = nn.Dense(self.global_context_projection_dim, name=\"global_context_batch_fourier\")(x_flat_for_global_context_batch) # (B, global_context_projection_dim)\n\n        # Concatenate this with factors_in_flat before the deep MLP\n        # factors_in_flat: (B, T_freq * k * 2)\n        # global_context_batch: (B, global_context_projection_dim)\n        combined_mlp_input = jnp.concatenate([factors_in_flat, global_context_batch], axis=-1)\n\n        # Deep MLP processes combined_mlp_input\n        h = nn.Dense(512)(combined_mlp_input); h = nn.relu(h)\n        h = nn.Dropout(rate=0.1)(h, deterministic=not training)\n        h = nn.Dense(512)(h); h = nn.relu(h)\n        h = nn.Dropout(rate=0.1)(h, deterministic=not training)\n        \n        num_out_freqs = self.output_horizon // 2 + 1\n        factors_out_flat = nn.Dense(num_out_freqs * k * 2)(h)\n        \n        factors_out_real, factors_out_imag = jnp.split(factors_out_flat.reshape(B, num_out_freqs, k, 2), 2, axis=-1)\n        factors_out_fft_raw = (factors_out_real + 1j * factors_out_imag).squeeze(-1)\n\n        norm_real = nn.LayerNorm()(factors_out_fft_raw.real)\n        norm_imag = nn.LayerNorm()(factors_out_fft_raw.imag)\n        factors_out_fft_norm = norm_real + 1j * norm_imag\n\n        y_fft = (factors_out_fft_norm @ V) @ U_eff.T\n        y_fourier = jnp.fft.irfft(y_fft, n=self.output_horizon, axis=1)\n\n        # --- Time Branch (Original ResidualCopyHead) ---\n        y_copy = ResidualCopyHead()(x, training=training)\n        \n        return y_fourier + y_copy\n\n\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n\ndef _define_hyperparameters():\n    \"\"\"\n    Define hyperparameters for the enhanced Fourier Forecaster.\n    Uses SOTA rank_k, proj_rank, and Lumina's optimal global context dim.\n    \"\"\"\n    return { \n        'learning_rate': 0.001, \n        'rank_k': 320, \n        'proj_rank': 36, # Optimal proj_rank from Aether I (ID 400)\n        'global_context_projection_dim': 32 # Lumina I's optimal\n    }\n\nclass ModelWrapper:\n    \"\"\"\n    Wrapper for FourierForecasterLuminaV2 to be compatible with the training system.\n    \"\"\"\n    def __init__(self, hparams):\n        self.model = FourierForecasterLuminaV2(\n            rank_k=hparams['rank_k'], \n            proj_rank=hparams['proj_rank'],\n            global_context_projection_dim=hparams['global_context_projection_dim']\n        )\n        self.needs_rng = True # For Dropout in ResidualCopyHead and Fourier Branch\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        return self.model.init({'params': rng_params, 'dropout': rng_dropout}, dummy_input)\n\n    def apply(self, params, x, training=False, rngs=None):\n        return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams):\n    \"\"\"Create and return the FourierForecasterLuminaV2 network.\"\"\"\n    return ModelWrapper(hparams)\n",
