  "original_submission": {
    "content": "import jax\nimport flax.linen as nn\nimport jax.numpy as jnp\nimport optax\nfrom jax import random\nfrom typing import Tuple, Dict, Any, Optional\n\n# --- Ariadne's mae_with_temporal_curvature LOSS FUNCTION ---\ndef mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + lam * curv_pen\n\n# --- Ariadne's `ResidualCopyHead` (from her models_fourier_ramp.py) ---\nclass ResidualCopyHead(nn.Module):\n    drop: float = 0.05\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        h = nn.Dense(64)(x_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(32)(h)\n        residual = h.reshape(B, N, 32).transpose(0, 2, 1)\n        out = jnp.zeros((B, 32, N), dtype=residual.dtype)\n        out = out.at[:, :4, :].set(x)\n        return out + residual\n\n# --- Ariadne's `FourierForecasterLN_Ramp` (from her models_fourier_ramp.py, with learnable gamma) ---\nclass FourierForecasterLN_Ramp(nn.Module):\n    rank_k: int = 320\n    proj_rank: int = 36\n    hidden_size: int = 160\n    drop: float = 0.05\n    output_horizon: int = 32\n    gamma_start: float = 0.25\n    gamma_end: float = 0.99\n    learn_gamma: bool = True\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        k, p = self.rank_k, self.proj_rank\n\n        # Factorized loadings\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U_eff = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n\n        # RFFT over time on inputs\n        x_fft = jnp.fft.rfft(x, axis=1)\n        x_fft_bn = jnp.transpose(x_fft, (0, 2, 1))\n        f_in_fft = jnp.einsum('bnf,np->bfp', x_fft_bn, U_eff) @ V.T\n\n        # Build compact feature: concat real/imag, flatten freq and factors\n        f_ri = jnp.concatenate([f_in_fft.real, f_in_fft.imag], axis=-1)\n        f_flat = f_ri.reshape(B, -1)\n\n        # Small head to map to output Fourier coefficients (H=160x2)\n        h = nn.Dense(self.hidden_size)(f_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(self.hidden_size)(h); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n\n        T_out = self.output_horizon\n        F_out = T_out // 2 + 1\n        out_flat = nn.Dense(F_out * k * 2)(h)\n        out_ri = out_flat.reshape(B, F_out, k, 2)\n        f_fft_real, f_fft_imag = out_ri[..., 0], out_ri[..., 1]\n        f_fft = f_fft_real + 1j * f_fft_imag\n\n        # LayerNorm on real/imag separately\n        f_fft_n = (\n            nn.LayerNorm()(f_fft.real) + 1j * nn.LayerNorm()(f_fft.imag)\n        )\n\n        # Decode back to neurons in frequency space\n        y_fft = (f_fft_n @ V) @ U_eff.T\n\n        # Inverse RFFT to time domain\n        y_fourier = jnp.fft.irfft(y_fft, n=T_out, axis=1)\n\n        # Scalar ramp gamma over horizon (fixed or learned)\n        if self.learn_gamma:\n            gamma_raw = self.param('gamma_raw', nn.initializers.zeros, (T_out,))\n            gamma = nn.sigmoid(gamma_raw)[None, :, None] # Learnable gamma\n        else:\n            t = jnp.linspace(0.0, 1.0, T_out, dtype=y_fourier.dtype)\n            g = self.gamma_start + (self.gamma_end - self.gamma_start) * t\n            gamma = g[None, :, None]\n\n        y_fourier = gamma * y_fourier\n\n        # Residual copy head\n        y_copy = ResidualCopyHead(drop=self.drop)(x, training=training)\n        return y_fourier + y_copy\n\n# --- Ariadne's FourierWithGammaResidualWrapper (from models_fourier_gamma_residual.py) ---\nclass FourierWithGammaResidualWrapper(nn.Module):\n    rank_k: int = 320\n    proj_rank: int = 36\n    hidden_size: int = 160\n    drop: float = 0.05\n    gamma_start: float = 0.25\n    gamma_end: float = 0.99\n    learn_gamma: bool = True\n    residual_hidden: int = 32\n    residual_scale: float = 0.025 # MODIFIED: Changed residual_scale to 0.025\n\n    @nn.compact\n    def __call__(self, x, training=False):\n        # Base Fourier LN + learnable gamma network\n        base_network = FourierForecasterLN_Ramp(\n            rank_k=self.rank_k, proj_rank=self.proj_rank, hidden_size=self.hidden_size, drop=self.drop,\n            gamma_start=self.gamma_start, gamma_end=self.gamma_end, learn_gamma=self.learn_gamma,\n            name=\"base_model\"\n        )\n        y_base = base_network(x, training=training)\n\n        # Input-adaptive residual gating MLP\n        # Input features: per-timestep mean and std over neurons -> 4*2=8 dims\n        mu = jnp.mean(x, axis=-1)            # (B,4)\n        sigma = jnp.std(x, axis=-1)          # (B,4)\n        feats = jnp.concatenate([mu, sigma], axis=-1)  # (B,8)\n\n        h = nn.Dense(self.residual_hidden, name=\"res_mlp_h1\")(feats)\n        h = jax.nn.gelu(h)\n        out = nn.Dense(32, name=\"res_mlp_h2\")(h)\n        g = jnp.tanh(out)  # in [-1,1]\n\n        # Residual modulation\n        gate = 1.0 + self.residual_scale * g                              # (B,32)\n        gate = gate[:, :, None]                                      # (B,32,1)\n        y = y_base * gate                                            # broadcast over neurons\n        return y\n\n# --- Submission API ---\nBASE_SEED = 42 # Matching Ariadne I's default seed for ID 494\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.0009,\n        'rank_k': 320,\n        'proj_rank': 36,\n        'hidden_size': 160, # Fourier Backbone MLP hidden size\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': True,\n        'residual_hidden': 32, # Hidden dim for the residual MLP\n        'residual_scale': 0.025, # MODIFIED: Scaling factor for the residual modulation\n        'adam_eps': 1e-8,\n        'clip_norm': 1.0\n    }\n\nclass ModelWrapper:\n    def __init__(self, hparams: Dict[str, Any]):\n        self.hparams = hparams\n        self.model = FourierWithGammaResidualWrapper(\n            rank_k=hparams['rank_k'], proj_rank=hparams['proj_rank'], hidden_size=hparams['hidden_size'], drop=hparams['drop'],\n            gamma_start=hparams['gamma_start'], gamma_end=hparams['gamma_end'], learn_gamma=hparams['learn_gamma'],\n            residual_hidden=hparams['residual_hidden'], residual_scale=hparams['residual_scale']\n        )\n        self.needs_rng = True # For dropout in FourierBackbone and ResidualCopyHead, and for CnnGatingNetwork\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params,\n                x,\n                training=training,\n                mutable=mutable,\n                rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params,\n                x,\n                training=training,\n                rngs=rngs if rngs is not None else {}\n            )\n\ndef create_network(hparams: Dict[str, Any]):\n    return ModelWrapper(hparams)\n\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen # Uses temporal curvature loss\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(_define_hyperparameters()['clip_norm']),\n        optax.adam(learning_rate=learning_rate, eps=_define_hyperparameters()['adam_eps'])\n    )\n\ndef complete(params, opt_state, trial_data):\n    print(f\"Completion for Precise Replication of Ariadne I's FF-LN LearnableGamma + Input-Adaptive Residual (ID 494). Seed: {trial_data['seed']}\")\n",
