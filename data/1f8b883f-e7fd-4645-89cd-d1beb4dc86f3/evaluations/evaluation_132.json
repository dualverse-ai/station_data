  "original_submission": {
    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport jax\nimport jax.numpy as jnp\nimport optax\n\nfrom models_fact_ln import Osc2CtxAdaptiveFactorizedL_LN\nfrom losses import mae_with_temporal_curvature\nfrom regularizers import gamma_prior_from_raw\n\nBASE_SEED = 42\nBATCH_SIZE = 8\nV_ORTHO_LAM = 1e-5\nGAMMA_PRIOR_LAM = 1e-6\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,\n        'proj_rank': 32,\n        'hidden_size': 96,\n        'normalize_u': True,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'a_max': 0.993\n    }\n\nclass Wrapper:\n    def __init__(self, **kwargs):\n        self.model = Osc2CtxAdaptiveFactorizedL_LN(**kwargs)\n        self.needs_rng = False\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x, training=training)\n\ndef create_network(hparams):\n    return Wrapper(\n        rank_k=int(hparams.get('rank_k', 320)),\n        proj_rank=int(hparams.get('proj_rank', 32)),\n        hidden_size=int(hparams.get('hidden_size', 96)),\n        normalize_u=bool(hparams.get('normalize_u', True)),\n        gamma_start=float(hparams.get('gamma_start', 0.25)),\n        gamma_end=float(hparams.get('gamma_end', 0.99)),\n        a_max=float(hparams.get('a_max', 0.993))\n    )\n\ndef _get_from_tree(tree, key):\n    try:\n        if key in tree:\n            return tree[key]\n    except Exception:\n        pass\n    if isinstance(tree, dict) and 'params' in tree:\n        return _get_from_tree(tree['params'], key)\n    try:\n        return _get_from_tree(dict(tree), key)\n    except Exception:\n        raise KeyError(f\"{key} not found\")\n\ndef compute_loss(predictions, targets, params, x):\n    base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n    # V-OrthoReg\n    try:\n        V = _get_from_tree(params, 'V')\n        GV = V.T @ V\n        IV = jnp.eye(GV.shape[0], dtype=GV.dtype)\n        v_ortho = jnp.sum((GV - IV) ** 2)\n    except Exception:\n        v_ortho = 0.0\n    # Tiny gamma prior toward schedule\n    try:\n        gamma_raw = _get_from_tree(params, 'gamma_raw')\n        g_prior = gamma_prior_from_raw(gamma_raw, start=0.25, end=0.99)\n    except Exception:\n        g_prior = 0.0\n    return base + V_ORTHO_LAM * v_ortho + GAMMA_PRIOR_LAM * g_prior\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate, eps=1e-8)\n    )\n",
