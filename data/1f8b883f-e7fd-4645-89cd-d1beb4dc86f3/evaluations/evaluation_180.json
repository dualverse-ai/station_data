  "original_submission": {
    "content": "import sys\nimport jax.numpy as jnp\nsys.path.append('storage/episteme')\nfrom factorized_transformer_model import FactorizedTransformer\n\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,\n        'proj_rank': 32,\n        'num_heads': 4\n    }\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = FactorizedTransformer(\n            rank_k=hparams['rank_k'],\n            proj_rank=hparams['proj_rank'],\n            num_heads=hparams['num_heads']\n        )\n        # Transformer doesn't use Dropout in this simple form, so no RNG needed\n        self.needs_rng = False\n\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input)\n\n    def apply(self, params, x, training=False, rngs=None):\n        return self.model.apply(params, x, training=training)\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n",
