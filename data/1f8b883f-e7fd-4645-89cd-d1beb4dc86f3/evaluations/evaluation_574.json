  "abstract": "Adaptive horizon weighting based on per-batch dispersion: w_t = (1\u2212\u03b1) + \u03b1\u00b7(std_t(|e|)/mean_std), stop-grad and normalized to mean 1. Tests whether emphasizing high-dispersion timesteps improves generalization on the simple ScalarRamp baseline. Keep curvature \u03bb=1e\u22124; \u03b1=0.25.",
  "submitted_tick": 319,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import os, json, sys\nimport jax\nimport jax.numpy as jnp\nimport optax\n\nsys.path.append('storage/ariadne')\nfrom models_fourier_ramp import create_network as create_base_network\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,      # p\n        'hidden_size': 128,   # H\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': False,  # fixed scalar ramp baseline\n        'alpha': 0.25          # mixing with uniform\n    }\n\ndef create_network(hparams):\n    return create_base_network(hparams)\n\ndef compute_loss(predictions, targets, params, x):\n    hparams = _define_hyperparameters()\n    alpha = hparams.get('alpha', 0.25)\n    abs_err = jnp.abs(predictions - targets)             # (B,32,N)\n\n    # Per-horizon dispersion across batch and neurons\n    std_t = jnp.std(abs_err, axis=(0, 2))                # (32,)\n    mean_std = jnp.mean(std_t) + 1e-8\n    std_norm = std_t / mean_std                          # mean \u2248 1\n    w = (1.0 - alpha) + alpha * std_norm                 # (32,)\n    w = jax.lax.stop_gradient(w)                         # no gradient through weights\n    w = w[None, :, None]                                 # (1,32,1)\n\n    weighted_mae = jnp.mean(abs_err * w)\n\n    # Temporal curvature penalty\n    d2 = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curvature = jnp.mean(jnp.abs(d2))\n\n    return weighted_mae + 1e-4 * curvature\n\ndef create_optimizer(learning_rate: float = 9e-4):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n\ndef complete(params, opt_state, trial_data):\n    try:\n        os.makedirs(\"storage/ariadne/analyses/variance_weight\", exist_ok=True)\n        out = {\n            \"trial_number\": trial_data.get(\"trial_number\"),\n            \"seed\": trial_data.get(\"seed\"),\n            \"val_mae\": trial_data.get(\"val_mae\"),\n            \"hyperparameters\": trial_data.get(\"hyperparameters\"),\n            \"note\": \"ScalarRamp H=128 with variance-weighted MAE (alpha=0.25) + curvature\"\n        }\n        with open(\"storage/ariadne/analyses/variance_weight/alpha_0.25.json\", \"w\") as f:\n            json.dump(out, f, indent=2)\n    except Exception:\n        pass\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n",
