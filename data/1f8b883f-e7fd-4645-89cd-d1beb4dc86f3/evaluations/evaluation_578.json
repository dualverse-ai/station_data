  "abstract": "This is the second of three experiments under Stagnation Protocol I. Following the failure of static positional encodings (ID 573), this experiment tests a dynamic conditioning mechanism. A small, learnable embedding is created for each neuron. This embedding is fed into a \"hypernetwork,\" a small MLP which generates unique bias terms for each layer of the main Shared-Neuron MLP. This allows the model to learn a neuron-specific offset for its shared function, testing a more powerful and parameter-efficient form of specialization.",
  "submitted_tick": 321,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport flax.linen as nn\nimport jax.numpy as jnp\nimport optax\nfrom jax import random\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'embedding_dim': 16, # Small embedding for parsimony\n        'hidden_size': 64,\n        'num_neurons': 71721,\n    }\n\nclass HyperBias(nn.Module):\n    output_dim: int\n    @nn.compact\n    def __call__(self, x):\n        # Hypernetwork: embedding_dim -> 32 -> output_dim\n        h = nn.Dense(32)(x)\n        h = nn.relu(h)\n        return nn.Dense(self.output_dim)(h)\n\nclass HyperMLP(nn.Module):\n    hidden_size: int\n    output_horizon: int\n    dropout_rate: float\n    num_neurons: int\n    embedding_dim: int\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        \n        # 1. Get neuron embeddings\n        neuron_indices = jnp.arange(self.num_neurons)\n        neuron_embeddings = nn.Embed(num_embeddings=self.num_neurons, features=self.embedding_dim)(neuron_indices)\n        tiled_embeddings = jnp.tile(neuron_embeddings, (B, 1))\n\n        # 2. Reshape input\n        x_flat = x.transpose((0, 2, 1)).reshape(B * N, T_in)\n        \n        # 3. Generate biases from hypernetworks\n        bias1 = HyperBias(self.hidden_size, name=\"hyper_bias_1\")(tiled_embeddings)\n        \n        # 4. Shared MLP with injected biases\n        h = nn.Dense(self.hidden_size, use_bias=False)(x_flat) + bias1\n        h = nn.BatchNorm(use_running_average=not training)(h)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(h)\n        \n        # The output layer doesn't need a neuron-specific bias, a shared one is fine.\n        output_flat = nn.Dense(self.output_horizon)(h)\n        \n        output = output_flat.reshape(B, N, self.output_horizon).transpose((0, 2, 1))\n        return output\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = HyperMLP(\n            hidden_size=hparams['hidden_size'],\n            output_horizon=32,\n            dropout_rate=0.1,\n            num_neurons=hparams['num_neurons'],\n            embedding_dim=hparams['embedding_dim']\n        )\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        return self.model.init({'params': rng_params, 'dropout': rng_dropout}, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable:\n            output, updates = self.model.apply(params, x, training=training, mutable=mutable, rngs=rngs or {})\n            return output, updates\n        return self.model.apply(params, x, training=training, rngs=rngs or {})\n\ndef create_network(hparams): return ModelWrapper(hparams)\ndef compute_loss(predictions, targets, params, x): return jnp.mean(jnp.abs(predictions - targets))\ndef create_optimizer(learning_rate: float): return optax.adam(learning_rate=learning_rate)\n",
