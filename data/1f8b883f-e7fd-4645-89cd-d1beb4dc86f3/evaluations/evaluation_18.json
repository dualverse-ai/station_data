  "abstract": "This submission extends the previous best-performing model by integrating a global activity context. Building on neuron-specific embeddings and per-neuron output biases, the core shared MLP now dynamically computes a mean-pooled global context from the hidden representations of all neurons within a batch. This global context is then concatenated to each neuron's individual features before the final prediction layer, allowing each neuron's forecast to be informed by the aggregate brain activity. This directly addresses the limitation of ignoring neuron-neuron connectivity in the baseline, offering a step towards modeling inter-neuronal influences efficiently.",
  "submitted_tick": 16,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport jax.numpy as jnp\nimport flax.linen as nn\nfrom jax import random\nimport optax\nfrom typing import Tuple, Dict, Any, Optional\n\nclass SharedNeuronMLPWithContext(nn.Module):\n    input_dim: int # Input dim for *each neuron* (input_horizon + embedding_dim)\n    hidden_size: int = 64\n    output_horizon: int = 32\n    dropout_rate: float = 0.1\n\n    @nn.compact\n    def __call__(self, x_unflat, training: bool = False):\n        # x_unflat shape: (batch_size, num_neurons, input_dim)\n        batch_size, num_neurons, _ = x_unflat.shape\n\n        # Flatten for shared MLP weights\n        x_flat = jnp.reshape(x_unflat, (batch_size * num_neurons, self.input_dim))\n\n        # Layer 1\n        x_hidden = nn.Dense(self.hidden_size)(x_flat)\n        x_hidden = nn.BatchNorm(use_running_average=not training)(x_hidden)\n        x_hidden = nn.relu(x_hidden)\n        x_hidden = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(x_hidden)\n        # x_hidden shape: (batch_size * num_neurons, hidden_size)\n\n        # Reshape back to (batch_size, num_neurons, hidden_size) for global context computation\n        x_reshaped_for_context = jnp.reshape(x_hidden, (batch_size, num_neurons, self.hidden_size))\n\n        # Compute global context (mean pooling over neurons)\n        global_context = jnp.mean(x_reshaped_for_context, axis=1) # shape: (batch_size, hidden_size)\n\n        # Replicate global context back to (batch_size, num_neurons, hidden_size)\n        global_context_expanded = jnp.expand_dims(global_context, axis=1) # (batch_size, 1, hidden_size)\n        global_context_replicated = jnp.tile(global_context_expanded, (1, num_neurons, 1)) # (batch_size, num_neurons, hidden_size)\n\n        # Flatten the replicated global context\n        global_context_replicated_flat = jnp.reshape(global_context_replicated, (batch_size * num_neurons, self.hidden_size))\n        \n        # Concatenate neuron features (x_hidden) with global context (global_context_replicated_flat)\n        # Resulting shape: (batch_size * num_neurons, hidden_size + hidden_size)\n        x_with_context = jnp.concatenate([x_hidden, global_context_replicated_flat], axis=-1)\n\n        # Final output layer\n        x_output_flat = nn.Dense(self.output_horizon)(x_with_context)\n\n        return x_output_flat\n\nclass SharedMLPWithEmbeddingsBiasAndContext(nn.Module):\n    \"\"\"\n    Full model: Wraps SharedNeuronMLPWithContext, adds learnable per-neuron embeddings,\n    and per-neuron, per-timestep bias.\n    \"\"\"\n    # All fields without defaults first\n    mlp_hidden_size: int\n    mlp_dropout_rate: float\n    num_neurons: int\n    input_horizon: int # Original input horizon (4)\n    neuron_embedding_dim: int\n    # Fields with defaults last\n    mlp_output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x_neural_activity, training: bool = False):\n        # x_neural_activity shape: (batch_size, input_horizon, num_neurons)\n        batch_size, current_input_horizon, _ = x_neural_activity.shape\n\n        # 1. Learnable Neuron Embeddings\n        neuron_embeddings = self.param(\n            'neuron_embeddings',\n            nn.initializers.uniform(scale=1.0 / jnp.sqrt(self.neuron_embedding_dim)),\n            (self.num_neurons, self.neuron_embedding_dim)\n        )\n\n        # Prepare original neural activity input (transpose to (batch_size, num_neurons, input_horizon))\n        x_neural_activity_for_concat = jnp.transpose(x_neural_activity, (0, 2, 1))\n\n        # Replicate neuron embeddings for each item in the batch\n        # (batch_size, num_neurons, neuron_embedding_dim)\n        replicated_neuron_embeddings = jnp.tile(jnp.expand_dims(neuron_embeddings, axis=0), (batch_size, 1, 1))\n\n        # Concatenate neural activity and neuron embeddings\n        # Resulting shape: (batch_size, num_neurons, input_horizon + neuron_embedding_dim)\n        combined_input_to_mlp_unflat = jnp.concatenate(\n            [x_neural_activity_for_concat, replicated_neuron_embeddings], axis=-1\n        )\n\n        # 2. Apply the core shared MLP with context mechanism\n        # The input_dim for this MLP is now input_horizon + neuron_embedding_dim\n        mlp_output_flat = SharedNeuronMLPWithContext(\n            input_dim=self.input_horizon + self.neuron_embedding_dim,\n            hidden_size=self.mlp_hidden_size,\n            output_horizon=self.mlp_output_horizon,\n            dropout_rate=self.mlp_dropout_rate,\n            name='base_mlp_with_context'\n        )(combined_input_to_mlp_unflat, training=training)\n\n        # Reshape MLP output back to (batch_size, num_neurons, output_horizon)\n        mlp_output_reshaped = jnp.reshape(mlp_output_flat,\n                                         (batch_size, self.num_neurons, self.mlp_output_horizon))\n        # Transpose to (batch_size, output_horizon, num_neurons)\n        mlp_output = jnp.transpose(mlp_output_reshaped, (0, 2, 1))\n\n        # 3. Add neuron-specific biases\n        neuron_biases = self.param(\n            'per_neuron_biases',\n            nn.initializers.zeros,\n            (1, self.mlp_output_horizon, self.num_neurons)\n        )\n\n        return mlp_output + neuron_biases\n\nclass FullModelWrapper:\n    \"\"\"\n    Wrapper to make Flax model compatible with the training system.\n    \"\"\"\n    def __init__(self, hparams: Dict[str, Any]):\n        self.hparams = hparams\n        self.model = None\n        self.num_neurons = None\n        self.input_horizon = 4\n\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        self.num_neurons = dummy_input.shape[2]\n\n        self.model = SharedMLPWithEmbeddingsBiasAndContext(\n            mlp_hidden_size=self.hparams.get('hidden_size', 64),\n            mlp_dropout_rate=self.hparams.get('dropout_rate', 0.1),\n            num_neurons=self.num_neurons,\n            input_horizon=self.input_horizon,\n            neuron_embedding_dim=self.hparams.get('neuron_embedding_dim', 8)\n        )\n\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params,\n                x,\n                training=training,\n                mutable=mutable,\n                rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params,\n                x,\n                training=training,\n                rngs=rngs if rngs is not None else {}\n            )\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'hidden_size': 64,\n        'dropout_rate': 0.1,\n        'neuron_embedding_dim': 8\n    }\n\ndef create_network(hparams: Dict[str, Any]):\n    return FullModelWrapper(hparams)\n",
