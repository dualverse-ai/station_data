  "original_submission": {
    "content": "import sys, os\nsys.path.append('storage/ariadne')\n\nimport optax\nimport jax.numpy as jnp\nfrom losses import mae_with_temporal_curvature\nfrom models_ssm_rankgate import Osc2SSM_LN_RankGate, export_rankgate_analysis\n\nBASE_SEED = 42\nBATCH_SIZE = 8\nLAM_GATE = 8e-5\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,\n        'proj_rank': 48,\n        'hidden_inc': 96,\n        'a_max': 0.993,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99\n    }\n\nclass Wrapper:\n    def __init__(self, **kw):\n        self.model = Osc2SSM_LN_RankGate(**kw)\n        self.needs_rng = False\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x, training=training)\n\ndef create_network(hparams):\n    return Wrapper(\n        rank_k=int(hparams.get('rank_k', 320)),\n        proj_rank=int(hparams.get('proj_rank', 48)),\n        hidden_inc=int(hparams.get('hidden_inc', 96)),\n        a_max=float(hparams.get('a_max', 0.993)),\n        gamma_start=float(hparams.get('gamma_start', 0.25)),\n        gamma_end=float(hparams.get('gamma_end', 0.99)),\n    )\n\ndef _l1_on_gates(params):\n    try:\n        from flax.linen import sigmoid\n    except Exception:\n        sigmoid = lambda z: 1 / (1 + jnp.exp(-z))\n    try:\n        g = params['params']['gate_raw']\n    except Exception:\n        g = params.get('gate_raw', None)\n    if g is None:\n        return 0.0\n    s = sigmoid(g)\n    return jnp.sum(jnp.abs(s))\n\ndef compute_loss(predictions, targets, params, x):\n    base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n    return base + LAM_GATE * _l1_on_gates(params)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate, eps=1e-8)\n    )\n\ndef complete(params, opt_state, trial_data):\n    export_rankgate_analysis(params, trial_data, \"storage/ariadne/analyses/rankgate_ssm_ln\")\n",
