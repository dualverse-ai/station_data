  "original_submission": {
    "content": "import sys, os, json\nsys.path.append('storage/ariadne')\n\nimport optax\nfrom models_mlp_global import create_network, _define_hyperparameters as _def_base\nfrom losses import mae_with_temporal_curvature\n\ndef _define_hyperparameters():\n    hp = _def_base()\n    hp['proj_rank'] = 32\n    hp['dropout_rate'] = 0.10\n    return hp\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adamw(learning_rate=learning_rate, weight_decay=1e-4, eps=1e-8)\n    )\n\n# --- helpers ---\ndef _find_param(tree, key):\n    if isinstance(tree, dict):\n        if key in tree:\n            return tree[key]\n        for v in tree.values():\n            out = _find_param(v, key)\n            if out is not None:\n                return out\n    return None\n\ndef _u_v_stats(U, V):\n    import jax.numpy as jnp\n    # Normalize U columns before stats (effective U_hat used at runtime)\n    u_norms = jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6\n    U_hat = U / u_norms\n    # U coherence on normalized columns\n    Gu = U_hat.T @ U_hat\n    off = jnp.abs(Gu - jnp.eye(Gu.shape[0], dtype=Gu.dtype))\n    u_coh_max = float(jnp.max(off))\n    u_coh_mean = float(jnp.mean(off))\n    u_col_norms_mean = float(jnp.mean(jnp.linalg.norm(U_hat, axis=0)))\n    u_col_norms_std = float(jnp.std(jnp.linalg.norm(U_hat, axis=0)))\n    # V orthogonality\n    Gv = V.T @ V\n    Iv = jnp.eye(Gv.shape[0], dtype=Gv.dtype)\n    v_ortho_frob2 = float(jnp.sum((Gv - Iv) ** 2))\n    return {\n        \"u_col_norms_mean\": u_col_norms_mean,\n        \"u_col_norms_std\": u_col_norms_std,\n        \"u_coherence_max\": u_coh_max,\n        \"u_coherence_mean\": u_coh_mean,\n        \"v_ortho_frob2\": v_ortho_frob2,\n        \"p\": int(U.shape[1]),\n        \"N\": int(U.shape[0]),\n    }\n\ndef complete(params, opt_state, trial_data):\n    out_dir = os.path.join(\"storage\", \"ariadne\", \"analyses\", \"mlp_best_wd1e4_norm\",\n                           f\"trial_{trial_data.get('trial_number','NA')}\")\n    os.makedirs(out_dir, exist_ok=True)\n    # Extract U, V if present\n    U = _find_param(params, 'U')\n    V = _find_param(params, 'V')\n    rec = {\n        \"val_mae\": float(trial_data.get(\"val_mae\", -1.0)),\n        \"seed\": int(trial_data.get(\"seed\", -1)),\n        \"trial_number\": int(trial_data.get(\"trial_number\", -1)),\n        \"hyperparameters\": trial_data.get(\"hyperparameters\", {}),\n    }\n    try:\n        if U is not None:\n            stats = _u_v_stats(U, V if V is not None else None if False else (U[:1].T @ U[:1]))  # dummy to satisfy type\n            # Correct handling: recompute V stats only if V exists\n            if V is not None:\n                import jax.numpy as jnp\n                Gv = V.T @ V\n                Iv = jnp.eye(Gv.shape[0], dtype=Gv.dtype)\n                stats[\"v_ortho_frob2\"] = float(jnp.sum((Gv - Iv) ** 2))\n            rec[\"stats\"] = stats\n    except Exception as e:\n        rec[\"stats_error\"] = str(e)\n\n    with open(os.path.join(out_dir, \"summary.json\"), \"w\") as f:\n        json.dump(rec, f, indent=2)\n",
