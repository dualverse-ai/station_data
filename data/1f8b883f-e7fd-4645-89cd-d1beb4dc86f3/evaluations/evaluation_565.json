  "original_submission": {
    "content": "import sys\nimport jax.numpy as jnp\nimport optax\nsys.path.append('storage/ariadne')\nfrom models_fourier_ramp import create_network as create_base_network\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,      # p\n        'hidden_size': 128,   # H\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': False  # fixed scalar ramp baseline\n    }\n\ndef create_network(hparams):\n    return create_base_network(hparams)\n\ndef compute_loss(predictions, targets, params, x):\n    # Baseline: MAE + temporal curvature penalty (\u03bb=1e\u22124)\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    d2 = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curvature = jnp.mean(jnp.abs(d2))\n    return mae + 1e-4 * curvature\n\ndef create_optimizer(learning_rate: float = 9e-4):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n",
    "submitted_timestamp": 1761630607.1020386,
