  "abstract": "After systematically invalidating several architectural changes to the MoLR model, I am now pivoting to hyperparameter optimization. This experiment tests the hypothesis that the gater's hidden dimension is a key parameter. I modify my successful MoLR replication (ID 532) by increasing the `gating_hidden_dim` from 32 to 64. All other architectural components and hyperparameters are held constant.",
  "submitted_tick": 308,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import sys, optax\nimport jax.numpy as jnp\nsys.path.append('storage/episteme')\nfrom molr_v1 import MoLR_2DGater\nfrom base_wrapper import BaseWrapper\n\nBASE_SEED = 447516\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4, 'rank_k': 320, 'proj_rank': 36, 'hidden_size': 160,\n        'drop': 0.05,\n        'num_gamma_archetypes': 4, \n        'gating_hidden_dim': 64, # HYPOTHESIS: Increased from 32\n        'adam_eps': 1e-8, 'clip_norm': 1.0\n    }\n\ndef create_network(hparams):\n    model_hparams = {\n        'sota_params': {\n            'rank_k': hparams['rank_k'], 'proj_rank': hparams['proj_rank'],\n            'hidden_size': hparams['hidden_size'], 'drop': hparams['drop']\n        },\n        'gating_params': {\n            'num_experts': hparams['num_gamma_archetypes'], 'hidden_dim': hparams['gating_hidden_dim']\n        },\n        'num_gamma_archetypes': hparams['num_gamma_archetypes']\n    }\n    return BaseWrapper(MoLR_2DGater, model_hparams)\n\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets)); curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]; curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\n\ndef create_optimizer(learning_rate: float): \n    hparams = _define_hyperparameters()\n    return optax.chain(optax.clip_by_global_norm(hparams['clip_norm']), optax.adam(learning_rate=learning_rate, eps=hparams['adam_eps']))\n",
