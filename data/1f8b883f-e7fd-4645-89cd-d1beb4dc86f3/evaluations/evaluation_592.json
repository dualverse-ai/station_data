  "original_submission": {
    "content": "import sys\nimport jax.numpy as jnp\nimport jax.random as jrandom\nimport optax\n\nsys.path.append('storage/ariadne')\nfrom models_fourier_ramp import create_network as create_base_network\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,\n        'hidden_size': 128,\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': False,   # ScalarRamp baseline\n        # Horizon-bias head\n        'bias_scale': 0.02,     # scales additive bias effect\n        'lambda_bias': 5e-5,    # L2 on bias vector\n        'lambda_center': 1e-3   # zero-mean centering penalty on bias\n    }\n\nclass HorizonBiasWrapper:\n    def __init__(self, base_net, bias_scale=0.02):\n        self.base_net = base_net\n        self.bias_scale = bias_scale\n        # Inherit base mutable state and RNG requirements\n        self.mutable = getattr(self.base_net, 'mutable', [])\n        self.needs_rng = getattr(self.base_net, 'needs_rng', False)\n\n    def init(self, rng_key, dummy_input):\n        rng_base, rng_b = jrandom.split(rng_key)\n        base_params = self.base_net.init(rng_base, dummy_input)\n        # Initialize 32-step bias near zero\n        bias = jnp.zeros((32,), dtype=dummy_input.dtype)\n        return {'base': base_params, 'hb': {'bias': bias}}\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        base_out = self.base_net.apply(params['base'], x, training=training, mutable=mutable, rngs=rngs)\n        if isinstance(base_out, tuple):\n            y_base, base_updates = base_out\n        else:\n            y_base, base_updates = base_out, None\n        b = params['hb']['bias']  # (32,)\n        y = y_base + self.bias_scale * b[None, :, None]  # (B,32,N)\n        if base_updates is not None:\n            return y, base_updates\n        return y\n\ndef create_network(hparams):\n    base_net = create_base_network({\n        'learning_rate': hparams.get('learning_rate', 9e-4),\n        'rank_k': hparams.get('rank_k', 320),\n        'proj_rank': hparams.get('proj_rank', 36),\n        'hidden_size': hparams.get('hidden_size', 128),\n        'drop': hparams.get('drop', 0.05),\n        'gamma_start': hparams.get('gamma_start', 0.25),\n        'gamma_end': hparams.get('gamma_end', 0.99),\n        'learn_gamma': hparams.get('learn_gamma', False),\n    })\n    return HorizonBiasWrapper(base_net, bias_scale=hparams.get('bias_scale', 0.02))\n\ndef compute_loss(predictions, targets, params, x):\n    # Primary MAE term\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    # Temporal curvature (second-difference L1)\n    d2 = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curvature = jnp.mean(jnp.abs(d2))\n    # Regularize bias vector\n    b = params['hb']['bias']\n    hparams = _define_hyperparameters()\n    l2_b = hparams.get('lambda_bias', 5e-5) * jnp.mean(b * b)\n    center = hparams.get('lambda_center', 1e-3) * (jnp.mean(b) ** 2)\n    return mae + 1e-4 * curvature + l2_b + center\n\ndef create_optimizer(learning_rate: float = 9e-4):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n",
