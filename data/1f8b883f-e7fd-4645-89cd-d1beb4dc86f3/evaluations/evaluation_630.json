  "abstract": "This is the first experiment in my new research arc analyzing architectural context. It tests the hypothesis that the superior performance of an additive shift in the NCS-MLP architecture (-0.028604) vs. a simple Hyper-MLP (-0.028804) is due to network depth. This experiment creates a 2-Layer Hyper-MLP, mirroring the depth of the NCS-MLP but without its context gate. If this model's performance approaches that of the NCS-MLP, it will validate the depth hypothesis.",
  "submitted_tick": 356,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax; import flax.linen as nn; import jax.numpy as jnp; import optax; from jax import random\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001, 'embedding_dim': 8, \n        'hidden_size': 64, 'num_neurons': 71721\n    }\n\nclass HyperBias(nn.Module):\n    output_dim: int\n    @nn.compact\n    def __call__(self, x):\n        h = nn.Dense(32)(x); h = nn.relu(h); return nn.Dense(self.output_dim)(h)\n\nclass HyperMLP_2Layer(nn.Module):\n    hidden_size: int; output_horizon: int; dropout_rate: float\n    num_neurons: int; embedding_dim: int\n    \n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        neuron_indices = jnp.arange(self.num_neurons)\n        neuron_embeddings = nn.Embed(num_embeddings=self.num_neurons, features=self.embedding_dim)(neuron_indices)\n        tiled_embeddings = jnp.tile(neuron_embeddings, (B, 1))\n        x_flat = x.transpose((0, 2, 1)).reshape(B * N, T_in)\n        \n        # Layer 1\n        bias1 = HyperBias(self.hidden_size, name=\"hyper_bias_1\")(tiled_embeddings)\n        h = nn.Dense(self.hidden_size, use_bias=False)(x_flat) + bias1\n        h = nn.BatchNorm(use_running_average=not training, name=\"bn_1\")(h)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(h)\n        \n        # Layer 2\n        bias2 = HyperBias(self.hidden_size, name=\"hyper_bias_2\")(tiled_embeddings)\n        h = nn.Dense(self.hidden_size, use_bias=False)(h) + bias2\n        h = nn.BatchNorm(use_running_average=not training, name=\"bn_2\")(h)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(h)\n\n        output_flat = nn.Dense(self.output_horizon)(h)\n        output = output_flat.reshape(B, N, self.output_horizon).transpose((0, 2, 1))\n        return output\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = HyperMLP_2Layer(\n            hidden_size=hparams['hidden_size'], output_horizon=32, dropout_rate=0.1,\n            num_neurons=hparams['num_neurons'], embedding_dim=hparams['embedding_dim']\n        )\n        self.mutable = ['batch_stats']; self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        return self.model.init({'params': rng_params, 'dropout': rng_dropout}, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable:\n            output, updates = self.model.apply(params, x, training=training, mutable=mutable, rngs=rngs or {})\n            return output, updates\n        return self.model.apply(params, x, training=training, rngs=rngs or {})\n\ndef create_network(hparams): return ModelWrapper(hparams)\ndef compute_loss(predictions, targets, params, x): return jnp.mean(jnp.abs(predictions - targets))\ndef create_optimizer(learning_rate: float): return optax.adam(learning_rate=learning_rate)\n",
