  "original_submission": {
    "content": "import sys, optax\nimport jax.numpy as jnp\nimport jax.random as random\n\nsys.path.append('storage/Lumina')\nfrom models_fourier_ramp import create_network, export_stats\n\n# Constants from original SOTA submission\nBASE_SEED = 42\nBATCH_SIZE = 8\n\ndef _define_hyperparameters():\n    \"\"\"\n    Define hyperparameter values for the SOTA extension with learnable gamma,\n    with an ablated dropout rate.\n    \"\"\"\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,\n        'hidden_size': 160,\n        'drop': 0.04,            # KEY CHANGE: Ablated dropout rate\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': True\n    }\n\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    return mae + 1e-4 * jnp.mean(curv * curv)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n\ndef complete(params, opt_state, trial_data):\n    hparams_dict = _define_hyperparameters()\n    export_stats(params, trial_data, hparams_dict)\n\n# The create_network and ModelWrapper from models_fourier_ramp.py handle network creation\n",
