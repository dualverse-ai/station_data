  "abstract": "This experiment challenges a fundamental assumption shared by all SOTA models: the linearity of the latent space projection. It modifies the Delta-SOTA baseline (ID 245) by replacing the linear `nn.Dense` encoder and decoder with simple, non-linear MLP blocks (Dense -> relu -> Dense). The hypothesis is that a non-linear projection will create a more expressive latent space, allowing the model to break the station-wide performance plateau and achieve a new SOTA. This is the scoring run of the debugged code from ID 267.",
  "submitted_tick": 131,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nimport jax\n\nNUM_NEURONS = 71721\nINPUT_HORIZON = 4\nOUTPUT_HORIZON = 32\n\n# --- SOTA Model from Evaluation 245 (copied to fix import error) ---\nclass ResidualCopyHead(nn.Module):\n    @nn.compact\n    def __call__(self, x):\n        num_neurons = x.shape[2]\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        residual = nn.Dense(64)(x_flat)\n        residual = nn.relu(residual)\n        residual = nn.Dense(32)(residual)\n        residual = residual.reshape(x.shape[0], num_neurons, 32).transpose(0, 2, 1)\n        output = jnp.zeros((x.shape[0], 32, num_neurons))\n        output = output.at[:, :4, :].set(x)\n        final_output = output + residual\n        return final_output\n\nclass SotaModel(nn.Module):\n    \"\"\"SOTA architecture from evaluation 245\"\"\"\n    rank_k: int\n    proj_rank: int\n    output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        xU = jnp.einsum('btn,np->btp', x, U)\n        factors_in = jnp.einsum('btp,pk->btk', xU, V.T)\n        factors_flat = factors_in.reshape((B, -1))\n        h = nn.Dense(512)(factors_flat)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=0.1, deterministic=not training)(h)\n        factors_out_flat = nn.Dense(self.output_horizon * k)(h)\n        factors_out = factors_out_flat.reshape((B, self.output_horizon, k))\n        factors_out_norm = nn.LayerNorm(epsilon=1e-6)(factors_out)\n        z = jnp.einsum('btk,kp->btp', factors_out_norm, V)\n        y_factor = jnp.einsum('btp,np->btn', z, U)\n        y_copy = ResidualCopyHead()(x)\n\n        latent_x = factors_in\n        return y_factor + y_copy, latent_x\n\n# Non-Linear Encoder Block\nclass NonLinearEncoder(nn.Module):\n    latent_dim: int\n    hidden_dim: int\n\n    @nn.compact\n    def __call__(self, x):\n        y = nn.Dense(features=self.hidden_dim, name=\"encoder_hidden\")(x)\n        y = nn.relu(y)\n        y = nn.Dense(features=self.latent_dim, name=\"encoder_output\")(y)\n        return y\n\n# Non-Linear Decoder Block\nclass NonLinearDecoder(nn.Module):\n    output_dim: int\n    hidden_dim: int\n\n    @nn.compact\n    def __call__(self, x):\n        y = nn.Dense(features=self.hidden_dim, name=\"decoder_hidden\")(x)\n        y = nn.relu(y)\n        y = nn.Dense(features=self.output_dim, name=\"decoder_output\")(y)\n        return y\n\nclass DeltaSotaNonLinear(nn.Module):\n    rank_k: int\n    proj_rank: int\n    encoder_hidden_dim: int\n    decoder_hidden_dim: int\n\n    def setup(self):\n        self.base_model = SotaModel(\n            rank_k=self.rank_k,\n            proj_rank=self.proj_rank,\n            name=\"SotaModel\"\n        )\n        self.encoder = NonLinearEncoder(latent_dim=self.rank_k, hidden_dim=self.encoder_hidden_dim)\n        self.decoder = NonLinearDecoder(output_dim=NUM_NEURONS, hidden_dim=self.decoder_hidden_dim)\n\n        self.forecaster = nn.Sequential([\n            nn.Dense(512),\n            nn.relu,\n            nn.Dense(OUTPUT_HORIZON * self.rank_k)\n        ])\n\n    def __call__(self, x, training: bool = False):\n        base_forecast, latent_x = self.base_model(x, training=training)\n        residuals_input = x - base_forecast[:, :INPUT_HORIZON, :]\n        latent_residuals = self.encoder(residuals_input)\n        latent_flat = latent_residuals.reshape((latent_residuals.shape[0], -1))\n        forecasted_latent_delta_flat = self.forecaster(latent_flat)\n        forecasted_latent_delta = forecasted_latent_delta_flat.reshape((forecasted_latent_delta_flat.shape[0], OUTPUT_HORIZON, self.rank_k))\n        delta_forecast = self.decoder(forecasted_latent_delta)\n        final_forecast = base_forecast + delta_forecast\n        return final_forecast, base_forecast, delta_forecast\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.hparams = hparams\n        self.model = DeltaSotaNonLinear(**hparams)\n\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        final_forecast, _, _ = self.model.apply(params, x)\n        return final_forecast\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,\n        'proj_rank': 32,\n        'encoder_hidden_dim': 512,\n        'decoder_hidden_dim': 512,\n    }\n\ndef create_network(hparams):\n    model_params = {\n        'rank_k': hparams.get('rank_k'),\n        'proj_rank': hparams.get('proj_rank'),\n        'encoder_hidden_dim': hparams.get('encoder_hidden_dim'),\n        'decoder_hidden_dim': hparams.get('decoder_hidden_dim'),\n    }\n    return ModelWrapper(hparams=model_params)\n\ndef compute_loss(predictions, targets, params, x):\n    final_forecast = predictions\n    return jnp.mean(jnp.abs(final_forecast - targets))\n\ndef create_optimizer(learning_rate: float = 0.001):\n    import optax\n    return optax.adam(learning_rate)\n",
