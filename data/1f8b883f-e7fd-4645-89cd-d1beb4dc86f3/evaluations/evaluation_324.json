  "abstract": "This submission enhances the neuron-embedded MLP by integrating a 'pooled global context.' For each input sequence, a global context vector (dimension 64) is derived from the entire brain's activity. This context, along with a neuron's temporal input and embedding (dimension 16), is fed into a shared MLP. This aims to allow each neuron's prediction to be conditioned on the overall brain state, fostering inter-neuronal awareness.",
  "submitted_tick": 153,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport jax.numpy as jnp\nfrom jax import random\nimport optax\nimport flax.linen as nn\nimport time\nfrom typing import Any, Dict, Tuple, Optional\n\ndef _define_hyperparameters():\n    \"\"\"\n    Define hyperparameter values for the model.\n    Includes embedding_dim for neuron identity embeddings and global_context_dim.\n    \"\"\"\n    return {\n        'learning_rate': 0.001,\n        'hidden_size': 128,\n        'dropout_rate': 0.1,\n        'embedding_dim': 16, # Reverting to 16, as 32 showed diminishing returns\n        'global_context_dim': 64 # New hyperparameter for global context\n    }\n\n\nclass NeuronEmbeddedGlobalContextMLP(nn.Module):\n    \"\"\"\n    Shared-neuron MLP with per-neuron embeddings and a pooled global context concatenated to input.\n    \"\"\"\n    num_neurons: int \n    hidden_size: int\n    dropout_rate: float\n    embedding_dim: int\n    global_context_dim: int # Dimension of the global context vector\n    output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size, input_horizon, num_neurons = x.shape \n\n        # 1. Generate neuron IDs and embeddings\n        neuron_ids = jnp.arange(self.num_neurons) # (num_neurons,)\n        neuron_embeddings = nn.Embed(\n            num_embeddings=self.num_neurons,\n            features=self.embedding_dim,\n            name=\"neuron_embed\" \n        )(neuron_ids) # (num_neurons, embedding_dim)\n        \n        # Expand embeddings to match batch_size for concatenation later\n        # (num_neurons, embedding_dim) -> (1, num_neurons, embedding_dim) -> (batch_size, num_neurons, embedding_dim)\n        neuron_embeddings_expanded = jnp.tile(neuron_embeddings[jnp.newaxis, :, :], (batch_size, 1, 1))\n\n        # 2. Compute Pooled Global Context for the entire input horizon\n        # Flatten input X for global context calculation: (batch_size, input_horizon * num_neurons)\n        x_flat_for_global_context = jnp.reshape(x, (batch_size, input_horizon * num_neurons))\n        \n        # Project flattened activity to global_context_dim: (batch_size, global_context_dim)\n        global_context = nn.Dense(self.global_context_dim, name=\"global_context_proj\")(x_flat_for_global_context)\n        \n        # Expand global_context to be replicated for each neuron for concatenation\n        # (batch_size, global_context_dim) -> (batch_size, 1, global_context_dim) -> (batch_size, num_neurons, global_context_dim)\n        global_context_expanded_for_neurons = jnp.tile(global_context[:, jnp.newaxis, :], (1, num_neurons, 1))\n\n        # 3. Prepare x for concatenation with embeddings and global context\n        # Original x: (batch_size, input_horizon, num_neurons)\n        # Transpose x to (batch_size, num_neurons, input_horizon)\n        x_transposed = jnp.transpose(x, (0, 2, 1)) # (batch_size, num_neurons, input_horizon)\n        \n        # Concatenate temporal input, neuron embeddings, and global context\n        # For each (batch_item, neuron), the features are: [input_horizon, embedding_dim, global_context_dim]\n        # Total features per (batch_item, neuron) = input_horizon + embedding_dim + global_context_dim\n        x_with_all_features = jnp.concatenate([\n            x_transposed,\n            neuron_embeddings_expanded,\n            global_context_expanded_for_neurons\n        ], axis=-1)\n\n        # 4. Reshape for shared MLP processing\n        # From (batch_size, num_neurons, total_features)\n        # To (batch_size * num_neurons, total_features)\n        total_features = input_horizon + self.embedding_dim + self.global_context_dim\n        x_flat_mlp_input = jnp.reshape(x_with_all_features, (batch_size * num_neurons, total_features))\n\n        # 5. Shared MLP layers\n        x_flat_mlp_output = nn.Dense(self.hidden_size)(x_flat_mlp_input)\n        x_flat_mlp_output = nn.BatchNorm(use_running_average=not training)(x_flat_mlp_output)\n        x_flat_mlp_output = nn.relu(x_flat_mlp_output)\n        x_flat_mlp_output = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(x_flat_mlp_output)\n\n        x_flat_mlp_output = nn.Dense(self.output_horizon)(x_flat_mlp_output) # Output size (32)\n\n        # 6. Reshape back to (batch_size, output_horizon, num_neurons)\n        x_final_output = jnp.reshape(x_flat_mlp_output, (batch_size, num_neurons, self.output_horizon))\n        x_final_output = jnp.transpose(x_final_output, (0, 2, 1)) # (batch_size, 32, num_neurons)\n\n        return x_final_output\n\n\nclass NeuronEmbeddedGlobalContextMLPWrapper:\n    \"\"\"\n    Wrapper to make Flax model compatible with the training system.\n    Handles BatchNorm state and Dropout RNG requirements.\n    \"\"\"\n\n    def __init__(self, hparams: Dict[str, Any], num_neurons: int = 71721):\n        self.model = NeuronEmbeddedGlobalContextMLP(\n            num_neurons=num_neurons,\n            hidden_size=hparams['hidden_size'],\n            dropout_rate=hparams['dropout_rate'],\n            embedding_dim=hparams['embedding_dim'],\n            global_context_dim=hparams['global_context_dim']\n        )\n        self.mutable = ['batch_stats']\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout},\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params,\n                x,\n                training=training,\n                mutable=mutable,\n                rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params,\n                x,\n                training=training,\n                rngs=rngs if rngs is not None else {}\n            )\n\n\ndef create_network(hparams: Dict[str, Any]):\n    \"\"\"Create and return the NeuronEmbeddedGlobalContextMLP network.\"\"\"\n    return NeuronEmbeddedGlobalContextMLPWrapper(hparams, num_neurons=71721)\n",
