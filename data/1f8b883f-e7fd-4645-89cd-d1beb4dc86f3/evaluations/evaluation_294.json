  "original_submission": {
    "content": "import flax.linen as nn\nimport jax.numpy as jnp\nfrom jax import random\nimport optax\n\nNUM_NEURONS = 71721\nINPUT_HORIZON = 4\nOUTPUT_HORIZON = 32\n\ndef mae_with_temporal_curvature(predictions, targets, lam=1e-4):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + lam * curv_pen\n\nclass ResidualCopyHead(nn.Module):\n    @nn.compact\n    def __call__(self, x):\n        num_neurons = x.shape[2]\n        x_flat = x.transpose(0, 2, 1).reshape(-1, 4)\n        residual = nn.Dense(64)(x_flat)\n        residual = nn.relu(residual)\n        residual = nn.Dense(32)(residual)\n        residual = residual.reshape(x.shape[0], num_neurons, 32).transpose(0, 2, 1)\n        output = jnp.zeros((x.shape[0], 32, num_neurons))\n        output = output.at[:, :4, :].set(x)\n        final_output = output + residual\n        return final_output\n\nclass SynthesizedSotaModel(nn.Module):\n    rank_k: int\n    proj_rank: int\n    mlp_hidden_size: int\n    dropout_rate: float\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        \n        xU = jnp.einsum('btn,np->btp', x, U)\n        factors_in = jnp.einsum('btp,pk->btk', xU, V.T)\n        factors_flat = factors_in.reshape((B, -1))\n        \n        h = nn.Dense(self.mlp_hidden_size)(factors_flat)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(h)\n        h = nn.Dense(self.mlp_hidden_size)(h)\n        h = nn.relu(h)\n        h = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(h)\n\n        factors_out_flat = nn.Dense(OUTPUT_HORIZON * k)(h)\n        factors_out = factors_out_flat.reshape((B, OUTPUT_HORIZON, k))\n        factors_out_norm = nn.LayerNorm()(factors_out)\n        \n        z = jnp.einsum('btk,kp->btp', factors_out_norm, V)\n        y_factor = jnp.einsum('btp,np->btn', z, U)\n        y_copy = ResidualCopyHead()(x)\n        return y_factor + y_copy\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = SynthesizedSotaModel(**hparams)\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        rngs = {'params': rng_key, 'dropout': rng_key}\n        return self.model.init(rngs, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if rngs and 'dropout' in rngs:\n            dropout_rng = rngs['dropout']\n            return self.model.apply(params, x, training=training, rngs={'dropout': dropout_rng})\n        else:\n            return self.model.apply(params, x, training=training)\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'weight_decay': 1e-4,\n        'gradient_clip': 1.0,\n        'rank_k': 320,\n        'proj_rank': 32,\n        'mlp_hidden_size': 512,\n        'dropout_rate': 0.1,\n    }\n\ndef create_network(hparams):\n    model_params = {\n        'rank_k': hparams.get('rank_k'),\n        'proj_rank': hparams.get('proj_rank'),\n        'mlp_hidden_size': hparams.get('mlp_hidden_size'),\n        'dropout_rate': hparams.get('dropout_rate'),\n    }\n    return ModelWrapper(hparams=model_params)\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    hparams = _define_hyperparameters()\n    return optax.chain(\n        optax.clip_by_global_norm(hparams.get('gradient_clip', 1.0)),\n        optax.adamw(learning_rate=learning_rate, weight_decay=hparams.get('weight_decay', 1e-4))\n    )\n",
