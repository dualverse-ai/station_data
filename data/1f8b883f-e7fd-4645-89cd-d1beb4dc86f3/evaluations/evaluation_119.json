  "original_submission": {
    "content": "import sys, os\nsys.path.append('storage/ariadne')\n\nimport optax\nimport jax.numpy as jnp\nfrom models_fact_ln import Osc2CtxAdaptiveFactorizedLLN\nfrom losses import mae_with_temporal_curvature\nfrom analysis_utils import save_analysis\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,\n        'proj_rank': 32,\n        'hidden_size': 96,\n        'normalize_u': True,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'a_max': 0.993\n    }\n\nclass Wrapper:\n    def __init__(self, rank_k=320, proj_rank=32, hidden_size=96, normalize_u=True, gamma_start=0.25, gamma_end=0.99, a_max=0.993):\n        self.model = Osc2CtxAdaptiveFactorizedLLN(\n            rank_k=rank_k,\n            proj_rank=proj_rank,\n            hidden_size=hidden_size,\n            normalize_u=normalize_u,\n            gamma_start=gamma_start,\n            gamma_end=gamma_end,\n            a_max=a_max\n        )\n        self.needs_rng = False\n\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x, training=training)\n\ndef create_network(hparams):\n    return Wrapper(\n        rank_k=int(hparams.get('rank_k', 320)),\n        proj_rank=int(hparams.get('proj_rank', 32)),\n        hidden_size=int(hparams.get('hidden_size', 96)),\n        normalize_u=bool(hparams.get('normalize_u', True)),\n        gamma_start=float(hparams.get('gamma_start', 0.25)),\n        gamma_end=float(hparams.get('gamma_end', 0.99)),\n        a_max=float(hparams.get('a_max', 0.993)),\n    )\n\ndef compute_loss(predictions, targets, params, x):\n    return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate, eps=1e-8)\n    )\n\ndef complete(params, opt_state, trial_data):\n    # Export compact analysis artifacts per trial\n    trial = trial_data.get('trial_number', 'na')\n    seed = trial_data.get('seed', 'na')\n    out_dir = os.path.join('storage', 'ariadne', 'analyses', 'ln_best_a0993_H96', f'trial_{trial}_seed_{seed}')\n    summary = save_analysis(params, out_dir, sample_U_rows=2048, seed=BASE_SEED)\n    print(\"Analysis saved to:\", out_dir)\n    print(\"Summary:\", summary)\n",
