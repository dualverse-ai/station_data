  "original_submission": {
    "content": "import jax\nimport jax.numpy as jnp\nimport flax.linen as nn\nimport optax\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n\ndef _define_hyperparameters():\n    \"\"\"\n    Hyperparameters for Residual Copy + Low-Rank Factor model.\n    \"\"\"\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 32,          # Increased capacity for cross-neuron structure\n        'hidden_size': 64,     # Factor MLP hidden size\n        'normalize_loadings': True\n    }\n\ndef _logit(p):\n    p = jnp.clip(p, 1e-4, 1 - 1e-4)\n    return jnp.log(p) - jnp.log(1 - p)\n\nclass ResidualCopyHead(nn.Module):\n    \"\"\"\n    AR(1)-style residual head:\n    y_copy[b, t, n] = c0[t] * x_last[b, n] + c1[t] * (x_last[b, n] - x_prev[b, n])\n    where c0[t] in [0,1], c1[t] in [-0.5, 0.5] (via tanh scaling).\n    \"\"\"\n    output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x):\n        # x: (B, 4, N)\n        B, T_in, N = x.shape\n        x_last = x[:, -1, :]          # (B, N)\n        x_prev = x[:, -2, :]          # (B, N)\n        delta = x_last - x_prev       # (B, N)\n\n        # Initialize c0 close to copy for early steps, decaying for later steps.\n        def c0_init(key, shape, dtype=jnp.float32):\n            t = jnp.arange(shape[0], dtype=dtype)\n            # Simple decay from ~0.9 at t=1 to ~0.2 by t=32\n            v = 0.2 + 0.7 * jnp.exp(-t / 8.0)\n            return _logit(v).astype(dtype)\n\n        c0_raw = self.param('c0_raw', c0_init, (self.output_horizon,))\n        c1_raw = self.param('c1_raw', nn.initializers.zeros, (self.output_horizon,))\n\n        c0 = nn.sigmoid(c0_raw)               # (32,) in [0,1]\n        c1 = 0.5 * nn.tanh(c1_raw)            # (32,) in [-0.5, 0.5]\n\n        # Broadcast over batch and neurons\n        c0_b = c0[None, :, None]              # (1, 32, 1)\n        c1_b = c1[None, :, None]              # (1, 32, 1)\n\n        y_copy = c0_b * x_last[:, None, :] + c1_b * delta[:, None, :]\n        return y_copy\n\nclass LowRankFactorForecaster(nn.Module):\n    \"\"\"\n    Low-rank cross-neuron forecaster with a residual copy head.\n    - Learn neuron loadings L in R^{N x k}\n    - Project inputs x (B, 4, N) to factors (B, 4, k)\n    - Forecast factors with a small MLP (shared across factors): 4 -> 32\n    - Project factor trajectories back to neurons and combine with residual copy head\n    \"\"\"\n    rank_k: int = 32\n    hidden_size: int = 64\n    output_horizon: int = 32\n    normalize_loadings: bool = True\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        # x: (B, 4, N)\n        B, T_in, N = x.shape\n\n        # Loadings: (N, k)\n        loadings = self.param(\n            'loadings',\n            nn.initializers.lecun_normal(),\n            (N, self.rank_k)\n        )\n        if self.normalize_loadings:\n            norm = jnp.linalg.norm(loadings, axis=0, keepdims=True) + 1e-6\n            L = loadings / norm\n        else:\n            L = loadings\n\n        # Project inputs to factors: (B, 4, k)\n        factors_in = jnp.einsum('btn,nk->btk', x, L)\n\n        # Small MLP per factor (weights shared across factors)\n        f_flat = factors_in.reshape(B * self.rank_k, T_in)   # (B*k, 4)\n        h = nn.Dense(self.hidden_size)(f_flat)\n        h = nn.gelu(h)\n        h = nn.Dense(self.output_horizon)(h)                 # (B*k, 32)\n        factors_out = h.reshape(B, self.rank_k, self.output_horizon).transpose(0, 2, 1)  # (B, 32, k)\n\n        # Optional per-horizon gating for factor strength\n        def gamma_init(key, shape, dtype=jnp.float32):\n            # Start moderate to avoid overpowering the residual copy on early steps\n            return _logit(jnp.full(shape, 0.5, dtype=dtype))\n        gamma_raw = self.param('gamma_raw', gamma_init, (self.output_horizon,))\n        gamma = nn.sigmoid(gamma_raw)[None, :, None]  # (1, 32, 1)\n\n        # Project factors back to neurons: (B, 32, k) @ (k, N) -> (B, 32, N)\n        y_factor = jnp.einsum('btk,kn->btn', factors_out, L.T)\n        y_factor = gamma * y_factor\n\n        # Residual copy head for short horizons\n        y_copy = ResidualCopyHead(output_horizon=self.output_horizon)(x)\n\n        # Combine\n        y = y_copy + y_factor\n        return y\n\nclass RCLFWrapper:\n    \"\"\"\n    Wrapper providing the required interface.\n    \"\"\"\n    def __init__(self, rank_k=32, hidden_size=64, normalize_loadings=True):\n        self.model = LowRankFactorForecaster(\n            rank_k=rank_k,\n            hidden_size=hidden_size,\n            normalize_loadings=normalize_loadings\n        )\n        self.needs_rng = False  # No Dropout/BatchNorm\n\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x, training=training)\n\ndef create_network(hparams):\n    rank_k = int(hparams.get('rank_k', 32))\n    hidden_size = int(hparams.get('hidden_size', 64))\n    normalize = bool(hparams.get('normalize_loadings', True))\n    return RCLFWrapper(rank_k=rank_k, hidden_size=hidden_size, normalize_loadings=normalize)\n\n# Use default MAE loss by not overriding compute_loss()\n\ndef create_optimizer(learning_rate: float = 0.001):\n    \"\"\"\n    Use Adam optimizer (matches system default) for stability.\n    \"\"\"\n    return optax.adam(learning_rate=learning_rate, eps=1e-8)\n",
