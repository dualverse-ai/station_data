  "original_submission": {
    "content": "import sys, json, os\nsys.path.append('storage/ariadne')\n\nimport jax.numpy as jnp\nimport optax\n\nfrom models_fact_ln import Osc2CtxAdaptiveFactorizedL_LN\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n\n# Regularization strengths\nV_ORTHO_LAM = 1e-5   # ||V^T V - I||_F^2\nU_COH_LAM   = 2e-6   # off-diagonal power of U_hat^T U_hat\nSBETA_LAM   = 1e-4   # L2 centering on s_beta\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,\n        'proj_rank': 32,\n        'hidden_size': 96,\n        'normalize_u': True,\n        'normalize_v': False,\n        'ln_before_gating': False,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'a_max': 0.993\n    }\n\nclass Wrapper:\n    def __init__(self, **kwargs):\n        self.model = Osc2CtxAdaptiveFactorizedL_LN(**kwargs)\n        self.needs_rng = False\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        return self.model.apply(params, x, training=training)\n\ndef create_network(hparams):\n    # Explicitly build our LN-SSM to avoid default fallback.\n    return Wrapper(\n        rank_k=int(hparams.get('rank_k', 320)),\n        proj_rank=int(hparams.get('proj_rank', 32)),\n        hidden_size=int(hparams.get('hidden_size', 96)),\n        normalize_u=bool(hparams.get('normalize_u', True)),\n        normalize_v=bool(hparams.get('normalize_v', False)),\n        ln_before_gating=bool(hparams.get('ln_before_gating', False)),\n        gamma_start=float(hparams.get('gamma_start', 0.25)),\n        gamma_end=float(hparams.get('gamma_end', 0.99)),\n        a_max=float(hparams.get('a_max', 0.993)),\n    )\n\ndef _get_param(tree, name):\n    if isinstance(tree, dict):\n        if 'params' in tree and isinstance(tree['params'], dict) and name in tree['params']:\n            return tree['params'][name]\n        if name in tree:\n            return tree[name]\n    return None\n\ndef compute_loss(predictions, targets, params, x):\n    base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\n    # V orthogonality penalty\n    V = _get_param(params, 'V')\n    v_pen = 0.0\n    if V is not None:\n        Gv = jnp.matmul(V.T, V)\n        I  = jnp.eye(Gv.shape[0], dtype=Gv.dtype)\n        v_pen = jnp.sum((Gv - I) ** 2)\n\n    # U coherence on normalized columns\n    U = _get_param(params, 'U')\n    ucoh_pen = 0.0\n    if U is not None:\n        norms = jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6\n        Uhat  = U / norms\n        Gu    = jnp.matmul(Uhat.T, Uhat)  # (p,p)\n        off   = Gu - jnp.diag(jnp.diag(Gu))\n        ucoh_pen = jnp.sum(off ** 2)\n\n    # s_beta centering\n    sb = _get_param(params, 's_beta')\n    sb_pen = 0.0\n    if sb is not None:\n        sb_pen = jnp.mean(sb ** 2)\n\n    return base + V_ORTHO_LAM * v_pen + U_COH_LAM * ucoh_pen + SBETA_LAM * sb_pen\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate, eps=1e-8)\n    )\n\ndef complete(params, opt_state, trial_data):\n    # Minimal export to confirm regularizers are active.\n    try:\n        p = params['params'] if isinstance(params, dict) and 'params' in params else params\n        out_dir = f\"storage/ariadne/analyses/ln_ssm_ucoh_sb_meta/trial_{trial_data.get('trial_number','?')}_seed_{trial_data.get('seed','?')}\"\n        os.makedirs(out_dir, exist_ok=True)\n        meta = {\n            'val_mae': float(trial_data.get('val_mae', 0.0)),\n            'U_COH_LAM': U_COH_LAM,\n            'SBETA_LAM': SBETA_LAM,\n            'V_ORTHO_LAM': V_ORTHO_LAM\n        }\n        for k in ['U', 'V', 's_beta']:\n            meta[f'{k}_present'] = (k in p)\n        with open(os.path.join(out_dir, 'meta.json'), 'w') as f:\n            json.dump(meta, f, indent=2)\n    except Exception as e:\n        pass\n",
