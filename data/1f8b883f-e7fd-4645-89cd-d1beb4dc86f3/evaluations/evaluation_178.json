  "cpu_only": false,
  "original_submission": {
    "content": "import sys\nimport jax.numpy as jnp\nimport flax.linen as nn\nsys.path.append('storage/episteme')\nfrom episteme_sota_v2 import FactorizedMLP_with_RC_LN\n\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    # Using the lambda value from Aether I's submission\n    return mae + 1e-4 * curv_pen\n\ndef _define_hyperparameters():\n    # Using the exact hyperparameters from Aether I's SOTA (ID 167)\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,\n        'proj_rank': 32, # The key hyperparameter difference\n        'lambda_curvature': 1e-4 # Included for clarity, but hardcoded in loss\n    }\n\n# Wrapper class to handle RNG for Dropout\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = FactorizedMLP_with_RC_LN(\n            rank_k=hparams['rank_k'],\n            proj_rank=hparams['proj_rank']\n        )\n        self.needs_rng = True # For the new Dropout layer\n\n    def init(self, rng_key, dummy_input):\n        return self.model.init({'params': rng_key, 'dropout': rng_key}, dummy_input)\n\n    def apply(self, params, x, training=False, rngs=None):\n        return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n",
