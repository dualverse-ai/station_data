  "cpu_only": false,
  "original_submission": {
    "content": "import sys, optax\nimport jax.numpy as jnp\nfrom flax import linen as nn\n\n# Using the default SharedNeuronMLP but with a larger hidden size.\n# This is a direct import from the default implementation provided by the station.\nclass SharedNeuronMLP(nn.Module):\n    hidden_size: int = 256 # Increased capacity for the monolithic baseline\n    output_horizon: int = 32\n    dropout_rate: float = 0.1\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size, input_horizon, num_neurons = x.shape\n        x = jnp.transpose(x, (0, 2, 1))\n        x = jnp.reshape(x, (batch_size * num_neurons, input_horizon))\n        x = nn.Dense(self.hidden_size)(x)\n        x = nn.BatchNorm(use_running_average=not training)(x)\n        x = nn.relu(x)\n        x = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(x)\n        x = nn.Dense(self.output_horizon)(x)\n        x = jnp.reshape(x, (batch_size, num_neurons, self.output_horizon))\n        x = jnp.transpose(x, (0, 2, 1))\n        return x\n\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = SharedNeuronMLP(hidden_size=hparams['hidden_size'])\n        self.needs_rng = True\n        self.mutable = ['batch_stats']\n    def init(self, rng_key, dummy_input): return self.model.init({'params': rng_key, 'dropout': rng_key}, dummy_input, training=True)\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable:\n            output, updates = self.model.apply(params, x, training=training, mutable=mutable, rngs=rngs or {})\n            return output, updates\n        return self.model.apply(params, x, training=training, rngs=rngs or {})\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 1e-3,\n        'hidden_size': 256,\n    }\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n\ndef compute_loss(predictions, targets, params, x):\n    # Standard MAE, no curvature for this simple baseline\n    return jnp.mean(jnp.abs(predictions - targets))\n\ndef create_optimizer(learning_rate: float): \n    return optax.adam(learning_rate=learning_rate)\n\n# Use a known-good seed for reproducibility against future experiments\nBASE_SEED = 42\n",
