  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport jax.numpy as jnp\nimport flax.linen as nn\nfrom jax import random\nimport optax\n\n# --- Loss Function (from ariadne/losses.py) ---\ndef mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4):\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pen = jnp.mean(curv * curv)\n    return mae + lam * curv_pen\n\n# --- Model Architecture (from ariadne/models_fourier_ramp.py) ---\n# BUGFIX: Using the CORRECT ResidualCopyHead from Ariadne's code\nclass ResidualCopyHead(nn.Module):\n    drop: float = 0.05\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        x_flat = x.transpose(0, 2, 1).reshape(-1, T_in)\n        h = nn.Dense(64)(x_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(32)(h)\n        residual = h.reshape(B, N, 32).transpose(0, 2, 1)\n        out = jnp.zeros((B, 32, N), dtype=residual.dtype)\n        out = out.at[:, :T_in, :].set(x) # Copy the input timesteps\n        return out + residual\n\nclass FourierForecasterLN_Ramp(nn.Module):\n    rank_k: int; proj_rank: int; hidden_size: int; drop: float;\n    output_horizon: int = 32; learn_gamma: bool = True\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        B, T_in, N = x.shape\n        k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U_eff = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        x_fft = jnp.fft.rfft(x, axis=1)\n        x_fft_bn = jnp.transpose(x_fft, (0, 2, 1))\n        f_in_fft = jnp.einsum('bnf,np->bfp', x_fft_bn, U_eff) @ V.T\n        f_ri = jnp.concatenate([f_in_fft.real, f_in_fft.imag], axis=-1)\n        f_flat = f_ri.reshape(B, -1)\n        h = nn.Dense(self.hidden_size)(f_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(self.hidden_size)(h); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        F_out = self.output_horizon // 2 + 1\n        out_flat = nn.Dense(F_out * k * 2)(h)\n        out_ri = out_flat.reshape(B, F_out, k, 2)\n        f_fft = out_ri[..., 0] + 1j * out_ri[..., 1]\n        f_fft_n = nn.LayerNorm()(f_fft.real) + 1j * nn.LayerNorm()(f_fft.imag)\n        y_fft = (f_fft_n @ V) @ U_eff.T\n        y_fourier = jnp.fft.irfft(y_fft, n=self.output_horizon, axis=1)\n        gamma_raw = self.param('gamma_raw', nn.initializers.zeros, (self.output_horizon,))\n        gamma = nn.sigmoid(gamma_raw)[None, :, None]\n        y_fourier = gamma * y_fourier\n        y_copy = ResidualCopyHead(drop=self.drop)(x, training=training)\n        return y_copy + y_fourier\n        \n# --- Main Submission Functions ---\nBASE_SEED = 42\nBATCH_SIZE = 8\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4, 'rank_k': 320, 'proj_rank': 36, 'hidden_size': 160,\n        'drop': 0.05, 'learn_gamma': True\n    }\n\nclass Wrapper:\n    def __init__(self, hparams):\n        self.model = FourierForecasterLN_Ramp(\n            rank_k=hparams['rank_k'], proj_rank=hparams['proj_rank'],\n            hidden_size=hparams['hidden_size'], drop=hparams['drop'],\n            learn_gamma=hparams['learn_gamma']\n        )\n        self.needs_rng = True\n        self.mutable = ['batch_stats'] # This model does not have batch_stats, but the wrapper supports it. Let's remove it for precision.\n        # After re-reading the code, ResidualCopyHead does not use BatchNorm, but the FourierForecasterLN_Ramp uses LayerNorm.\n        # LayerNorm state is not typically stored in 'batch_stats'. Thus, mutable is not needed. I will remove it.\n        self.mutable = []\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        return self.model.init({'params': rng_params, 'dropout': rng_dropout}, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        # Since mutable is empty, we don't need to handle the mutable path.\n        return self.model.apply(params, x, training=training, rngs=(rngs or {}))\n\ndef create_network(hparams): return Wrapper(hparams)\ndef compute_loss(p, t, pa, x): return mae_with_temporal_curvature(p, t, pa, x, lam=1e-4)\ndef create_optimizer(lr):\n    return optax.chain(optax.clip_by_global_norm(1.0), optax.adam(learning_rate=lr))\n",
