  "abstract": "Builds on the best Osc2-CTX-FLoad with factorized loadings and oscillatory SSMs. Adds copy-decay gating over horizon for the residual copy head, tiny dropout (0.03) on the increment head, and orthogonality regularization on V and U. Keeps \u03b3_end=0.99 and temporal gating; trained with MAE+curvature.",
  "submitted_tick": 46,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import sys\nsys.path.append('storage/ariadne')\n\nimport optax\nimport jax.numpy as jnp\nfrom models_fload_dg import Osc2CtxAdaptiveFactorizedLDG\nfrom losses import mae_with_temporal_curvature\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n\n# Regularization strengths\nV_ORTHO_LAM = 1e-5   # ||V^T V - I||_F^2\nU_ORTHO_LAM = 5e-6   # ||U^T U - I||_F^2\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'rank_k': 320,\n        'proj_rank': 32,\n        'hidden_size': 64,\n        'normalize_u': True,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'dropout_rate': 0.03,\n        'v_ortho_lam': V_ORTHO_LAM,\n        'u_ortho_lam': U_ORTHO_LAM\n    }\n\nclass Wrapper:\n    def __init__(self, rank_k=320, proj_rank=32, hidden_size=64, normalize_u=True, gamma_start=0.25, gamma_end=0.99, dropout_rate=0.03):\n        self.model = Osc2CtxAdaptiveFactorizedLDG(\n            rank_k=rank_k,\n            proj_rank=proj_rank,\n            hidden_size=hidden_size,\n            normalize_u=normalize_u,\n            gamma_start=gamma_start,\n            gamma_end=gamma_end,\n            dropout_rate=dropout_rate\n        )\n        # Dropout requires RNG\n        self.needs_rng = True\n\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input, training=True)\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        # Pass RNGs through for dropout\n        return self.model.apply(params, x, training=training, rngs=rngs)\n\ndef create_network(hparams):\n    return Wrapper(\n        rank_k=int(hparams.get('rank_k', 320)),\n        proj_rank=int(hparams.get('proj_rank', 32)),\n        hidden_size=int(hparams.get('hidden_size', 64)),\n        normalize_u=bool(hparams.get('normalize_u', True)),\n        gamma_start=float(hparams.get('gamma_start', 0.25)),\n        gamma_end=float(hparams.get('gamma_end', 0.99)),\n        dropout_rate=float(hparams.get('dropout_rate', 0.03))\n    )\n\ndef compute_loss(predictions, targets, params, x):\n    # Base MAE + temporal curvature penalty\n    base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n    # V orthogonality: ||V^T V - I||_F^2\n    V = params['params']['V']\n    Gv = V.T @ V\n    Iv = jnp.eye(Gv.shape[0], dtype=Gv.dtype)\n    v_ortho = jnp.sum((Gv - Iv) ** 2)\n    # U orthogonality (columns): ||U^T U - I||_F^2\n    U = params['params']['U']\n    Gu = U.T @ U\n    Iu = jnp.eye(Gu.shape[0], dtype=Gu.dtype)\n    u_ortho = jnp.sum((Gu - Iu) ** 2)\n    return base + V_ORTHO_LAM * v_ortho + U_ORTHO_LAM * u_ortho\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate, eps=1e-8)\n    )\n",
