  "abstract": "This submission marks the beginning of a new research arc, pivoting away from the Fourier-based SOTA. The Neuron-Conditional Shared MLP (NCS-MLP) is a parsimonious, time-domain architecture. It uses a single shared MLP for temporal forecasting, but its behavior is dynamically specialized for each of the 71,721 neurons using FiLM (Feature-wise Linear Modulation) layers. The modulation is conditioned on a unique, learnable embedding vector for each neuron. This tests the hypothesis that neuron-specific conditioning is a powerful and efficient alternative to complex global models.",
  "submitted_tick": 303,
  "no_debugger": false,
  "cpu_only": false,
  "original_submission": {
    "content": "import jax\nimport flax.linen as nn\nimport jax.numpy as jnp\nimport optax\nfrom jax import random\nfrom typing import Tuple\n\n# --- Hyperparameters ---\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'embedding_dim': 32,\n        'hidden_size': 128,\n        'num_neurons': 71721,\n        'adam_eps': 1e-8,\n    }\n\n# --- FiLM Components ---\nclass FiLMGenerator(nn.Module):\n    hidden_dim: int\n    @nn.compact\n    def __call__(self, embedding):\n        # Initializing bias for gamma close to 1 and beta close to 0\n        gamma_bias_init = nn.initializers.ones\n        beta_bias_init = nn.initializers.zeros\n        \n        # Dense layer to generate gamma and beta\n        # Output size is 2 * hidden_dim to be split into gamma and beta\n        film_params = nn.Dense(\n            features=2 * self.hidden_dim,\n            kernel_init=nn.initializers.xavier_uniform(),\n            bias_init=nn.initializers.normal(stddev=1e-6)\n        )(embedding)\n        \n        gamma, beta = jnp.split(film_params, 2, axis=-1)\n        \n        # Manually add biases to approximate desired initial state\n        gamma = gamma + gamma_bias_init(self.param, (self.hidden_dim,), jnp.float32)\n        beta = beta + beta_bias_init(self.param, (self.hidden_dim,), jnp.float32)\n\n        return gamma, beta\n\n# --- Main Architecture ---\nclass NCS_MLP(nn.Module):\n    embedding_dim: int\n    hidden_size: int\n    num_neurons: int\n    output_horizon: int = 32\n\n    @nn.compact\n    def __call__(self, x: jnp.ndarray) -> jnp.ndarray:\n        B, T_in, N = x.shape\n\n        # 1. Neuron Embeddings Lookup\n        neuron_indices = jnp.arange(self.num_neurons)\n        neuron_embeddings = nn.Embed(num_embeddings=self.num_neurons, features=self.embedding_dim)(neuron_indices)\n        \n        # Tile embeddings for batch processing\n        tiled_embeddings = jnp.tile(neuron_embeddings, (B, 1))\n\n        # 2. Reshape input for shared MLP\n        x_flat = x.transpose((0, 2, 1)).reshape(B * N, T_in)\n\n        # 3. Shared MLP with FiLM layers\n        # Block 1\n        h = nn.Dense(self.hidden_size)(x_flat)\n        h = nn.relu(h)\n        gamma1, beta1 = FiLMGenerator(self.hidden_size, name=\"film_gen_1\")(tiled_embeddings)\n        h = gamma1 * h + beta1\n\n        # Block 2\n        h = nn.Dense(self.hidden_size)(h)\n        h = nn.relu(h)\n        gamma2, beta2 = FiLMGenerator(self.hidden_size, name=\"film_gen_2\")(tiled_embeddings)\n        h = gamma2 * h + beta2\n\n        # 4. Output layer\n        output_flat = nn.Dense(self.output_horizon)(h)\n\n        # 5. Reshape back to target shape\n        output = output_flat.reshape(B, N, self.output_horizon).transpose((0, 2, 1))\n        \n        return output\n\n# --- System Integration Wrapper ---\nclass ModelWrapper:\n    def __init__(self, hparams):\n        self.model = NCS_MLP(\n            embedding_dim=hparams['embedding_dim'],\n            hidden_size=hparams['hidden_size'],\n            num_neurons=hparams['num_neurons']\n        )\n    def init(self, rng_key, dummy_input):\n        return self.model.init(rng_key, dummy_input)\n    def apply(self, params, x, training=False, rngs=None):\n        return self.model.apply(params, x)\n\ndef create_network(hparams):\n    return ModelWrapper(hparams)\n\ndef compute_loss(predictions, targets, params, x):\n    return jnp.mean(jnp.abs(predictions - targets))\n\ndef create_optimizer(learning_rate: float):\n    hparams = _define_hyperparameters()\n    return optax.adam(learning_rate=learning_rate, eps=hparams['adam_eps'])\n",
