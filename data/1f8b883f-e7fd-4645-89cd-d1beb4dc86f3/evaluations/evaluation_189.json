  "original_submission": {
    "content": "import jax\nimport jax.numpy as jnp\nimport optax\nimport flax.linen as nn\nfrom jax import random\nfrom typing import Any, Dict\n\n# Import default loss and optimizer from system storage to maintain consistency\nimport sys\nsys.path.append('storage/system')\nfrom defaults import default_compute_loss, default_create_optimizer\n\n# Constants from Research Task\nNUM_NEURONS = 71721\nINPUT_HORIZON = 4\nOUTPUT_HORIZON = 32\n\n# Regularization Hyperparameter (from Eval ID 163)\nV_ORTHO_LAM = 1e-5\n\ndef _logit(p): # Helper function from Ariadne's models.py (retained for consistency if needed in future)\n    p = jnp.clip(p, 1e-6, 1 - 1e-6)\n    return jnp.log(p) - jnp.log(1 - p)\n\nclass ContextExtractor(nn.Module):\n    \"\"\"\n    Sub-network to extract a global context vector from the input,\n    enhanced with a temporal 1D convolutional layer.\n    \"\"\"\n    context_dim: int\n    hidden_context_dim: int\n    temporal_conv_features: int\n    temporal_kernel_size: int\n\n    @nn.compact\n    def __call__(self, x):\n        global_temporal_features = jnp.mean(x, axis=-1)\n        x = global_temporal_features[:, :, None]\n        x = nn.Conv(\n            features=self.temporal_conv_features,\n            kernel_size=(self.temporal_kernel_size,),\n            padding='VALID'\n        )(x)\n        flat_temporal_features = x.reshape(x.shape[0], -1)\n        x = nn.Dense(self.hidden_context_dim)(flat_temporal_features)\n        x = nn.relu(x)\n        context_vector = nn.Dense(self.context_dim)(x)\n        return context_vector\n\n\nclass ContextualConvNeuronFactorizedMLP(nn.Module): # Reverted to MLP as final block\n    \"\"\"\n    Shared-neuron MLP with low-rank factorized neuron features, 1D convolutional layer,\n    and an implicit condition-dependent modulation via enhanced ContextExtractor and FiLM.\n    \"\"\"\n    hidden_size: int # Re-introduced for MLP\n    dropout_rate: float # Re-introduced for MLP\n    output_horizon: int\n    num_neurons: int\n    embedding_dim: int # This is now the output dimension of the factorization\n    proj_rank: int     # Parameter for the low-rank projection\n    normalize_u: bool  # Parameter for U matrix normalization\n    conv_kernel_size: int\n    conv_features: int\n    context_dim: int\n    hidden_context_dim: int\n    temporal_conv_features: int\n    temporal_kernel_size: int\n\n    @nn.compact\n    def __call__(self, x, training: bool = False):\n        batch_size, input_horizon, _ = x.shape\n\n        # 1. Extract context vector from raw input using enhanced ContextExtractor\n        context_vector = ContextExtractor(\n            context_dim=self.context_dim,\n            hidden_context_dim=self.hidden_context_dim,\n            temporal_conv_features=self.temporal_conv_features,\n            temporal_kernel_size=self.temporal_kernel_size\n        )(x)\n\n        # 2. Low-rank factorized neuron feature generation\n        U_factor = self.param('U_factor', nn.initializers.lecun_normal(), (self.num_neurons, self.proj_rank))\n        V_factor = self.param('V_factor', nn.initializers.lecun_normal(), (self.embedding_dim, self.proj_rank))\n        \n        if self.normalize_u:\n            U_factor = U_factor / (jnp.linalg.norm(U_factor, axis=0, keepdims=True) + 1e-6)\n\n        factorized_neuron_features = U_factor @ V_factor.T # (N, embedding_dim)\n\n        expanded_factorized_features = jnp.tile(factorized_neuron_features[None, :, :], (batch_size, 1, 1))\n\n        x_reshaped = jnp.transpose(x, (0, 2, 1))\n        x_with_features = jnp.concatenate([x_reshaped, expanded_factorized_features], axis=-1)\n\n        # 3. 1D Spatial Convolutional Layer for local inter-neuron dependencies\n        conv_output_features = nn.Conv(\n            features=self.conv_features,\n            kernel_size=(self.conv_kernel_size,),\n            padding='SAME'\n        )(x_with_features)\n        conv_output_features = nn.BatchNorm(use_running_average=not training)(conv_output_features)\n        conv_output_features = nn.relu(conv_output_features)\n\n        # 4. FiLM Modulation based on context_vector\n        gamma = nn.Dense(self.conv_features)(context_vector)\n        beta = nn.Dense(self.conv_features)(context_vector)\n        modulated_features = gamma[:, None, :] * conv_output_features + beta[:, None, :]\n\n        # 5. Reshape for shared MLP processing (RE-INSTATED)\n        x = jnp.reshape(modulated_features, (batch_size * self.num_neurons, self.conv_features))\n\n        # 6. Shared MLP layers (RE-INSTATED)\n        x = nn.Dense(self.hidden_size)(x)\n        x = nn.BatchNorm(use_running_average=not training)(x)\n        x = nn.relu(x)\n        x = nn.Dropout(rate=self.dropout_rate, deterministic=not training)(x)\n\n        x = nn.Dense(self.output_horizon)(x)\n\n        # 7. Reshape back to (batch_size, OUTPUT_HORIZON, num_neurons) (RE-INSTATED)\n        x = jnp.reshape(x, (batch_size, self.num_neurons, self.output_horizon))\n        x = jnp.transpose(x, (0, 2, 1))\n\n        return x\n\n\nclass ContextualConvNeuronFactorizedMLP_Wrapper: # Wrapper for the reverted model\n    \"\"\"\n    Wrapper for ContextualConvNeuronFactorizedMLP to integrate with training system.\n    \"\"\"\n    def __init__(self, hparams: Dict[str, Any]):\n        self.model = ContextualConvNeuronFactorizedMLP(\n            hidden_size=hparams.get('hidden_size', 64),\n            dropout_rate=hparams.get('dropout_rate', 0.1),\n            output_horizon=OUTPUT_HORIZON,\n            num_neurons=NUM_NEURONS,\n            embedding_dim=hparams.get('embedding_dim', 16),\n            proj_rank=hparams.get('proj_rank', 12),\n            normalize_u=hparams.get('normalize_u', True),\n            conv_kernel_size=hparams.get('conv_kernel_size', 5),\n            conv_features=hparams.get('conv_features', 64),\n            context_dim=hparams.get('context_dim', 16),\n            hidden_context_dim=hparams.get('hidden_context_dim', 32),\n            temporal_conv_features=hparams.get('temporal_conv_features', 16),\n            temporal_kernel_size=hparams.get('temporal_kernel_size', 2),\n        )\n        self.mutable = ['batch_stats']\n        self.needs_rng = True # Dropout is back\n\n    def init(self, rng_key, dummy_input):\n        rng_params, rng_dropout = random.split(rng_key)\n        variables = self.model.init(\n            {'params': rng_params, 'dropout': rng_dropout}, # Dropout key needed\n            dummy_input,\n            training=True\n        )\n        return variables\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        if mutable is not None:\n            output, updates = self.model.apply(\n                params, x, training=training, mutable=mutable, rngs=rngs if rngs is not None else {}\n            )\n            return output, updates\n        else:\n            return self.model.apply(\n                params, x, training=training, rngs=rngs if rngs is not None else {}\n            )\n\n\ndef _define_hyperparameters():\n    \"\"\"Define hyperparameters for the Contextual Conv Neuron Factorized MLP model.\"\"\"\n    return {\n        'learning_rate': 0.001,\n        'hidden_size': 64, # Re-introduced\n        'dropout_rate': 0.1, # Re-introduced\n        'embedding_dim': 16,\n        'proj_rank': 12,\n        'normalize_u': True,\n        'conv_kernel_size': 5,\n        'conv_features': 64,\n        'context_dim': 16,\n        'hidden_context_dim': 32,\n        'temporal_conv_features': 16,\n        'temporal_kernel_size': 2\n    }\n\n\ndef create_network(hparams: Dict[str, Any]):\n    \"\"\"Create and return the Contextual Conv Neuron Factorized MLP network.\"\"\"\n    return ContextualConvNeuronFactorizedMLP_Wrapper(hparams)\n\n\ndef compute_loss(predictions, targets, params, x):\n    \"\"\"\n    Loss function including V-orthogonality regularization.\n    \"\"\"\n    base_mae = default_compute_loss(predictions, targets, params, x)\n\n    V_factor = params['params']['V_factor']\n    G = V_factor.T @ V_factor\n    proj_rank = V_factor.shape[-1]\n    I = jnp.eye(proj_rank, dtype=G.dtype)\n    ortho_penalty = jnp.sum((G - I) ** 2)\n\n    return base_mae + V_ORTHO_LAM * ortho_penalty\n\n\ndef create_optimizer(learning_rate: float = 0.001) -> optax.GradientTransformation:\n    \"\"\"Create and return the default Adam optimizer.\"\"\"\n    return default_create_optimizer(learning_rate)\n",
