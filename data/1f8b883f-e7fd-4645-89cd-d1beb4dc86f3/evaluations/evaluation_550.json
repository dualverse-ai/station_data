  "original_submission": {
    "content": "import sys, optax\nimport jax.numpy as jnp\nimport flax.linen as nn\nsys.path.append('storage/episteme')\nfrom base_wrapper import BaseWrapper\nsys.path.append('storage/lumina')\nfrom models_fourier_ramp import FourierForecasterLN_Ramp\n\nBASE_SEED = 447516\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4, 'rank_k': 320, 'proj_rank': 36, 'hidden_size': 160,\n        'drop': 0.05,\n        'num_gamma_archetypes': 4, \n        'gating_hidden_dim': 32,\n        'adam_eps': 1e-8, 'clip_norm': 1.0\n    }\n\nclass DeeperGater_2DCNN(nn.Module):\n    num_experts: int\n    hidden_dim: int\n\n    @nn.compact\n    def __call__(self, x, training=False):\n        B, T, N = x.shape\n        p = 36 # proj_rank from the model\n        k = 5  # kernel size\n        \n        U_factor = self.param('U_factor', nn.initializers.lecun_normal(), (N, p))\n        U_norm = U_factor / (jnp.linalg.norm(U_factor, axis=0, keepdims=True) + 1e-6)\n        \n        x_proj = jnp.einsum('btn,np->btp', x, U_norm)\n        x_img = jnp.expand_dims(x_proj, -1)\n        \n        # HYPOTHESIS: Added a second Conv layer\n        h = nn.Conv(features=16, kernel_size=(k,k), padding='SAME')(x_img)\n        h = nn.relu(h)\n        h = nn.Conv(features=8, kernel_size=(k,k), padding='SAME')(h)\n        h = nn.relu(h)\n        \n        h_flat = h.reshape(B, -1)\n        h_dense = nn.Dense(self.hidden_dim)(h_flat)\n        h_dense = nn.gelu(h_dense)\n        logits = nn.Dense(self.num_experts)(h_dense)\n        return nn.softmax(logits, axis=-1)\n\n# Custom wrapper from debugger's fix in ID 546\nclass FourierWithCustomGamma(nn.Module):\n    rank_k: int; proj_rank: int; hidden_size: int; drop: float\n    @nn.compact\n    def __call__(self, x, training, custom_gamma):\n        # Inlined SOTA Fourier + Residual model, using custom_gamma\n        # This is the corrected implementation based on the debugger's provided code\n        B, T_in, N = x.shape\n        k, p = self.rank_k, self.proj_rank\n        U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n        V = self.param('V', nn.initializers.lecun_normal(), (k, p))\n        U_eff = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6)\n        x_fft = jnp.fft.rfft(x, axis=1)\n        x_fft_bn = jnp.transpose(x_fft, (0, 2, 1))\n        f_in_fft = jnp.einsum('bnf,np->bfp', x_fft_bn, U_eff) @ V.T\n        f_ri = jnp.concatenate([f_in_fft.real, f_in_fft.imag], axis=-1)\n        f_flat = f_ri.reshape(B, -1)\n        h = nn.Dense(self.hidden_size)(f_flat); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        h = nn.Dense(self.hidden_size)(h); h = nn.relu(h)\n        h = nn.Dropout(rate=self.drop)(h, deterministic=not training)\n        T_out = 32\n        F_out = T_out // 2 + 1\n        out_flat = nn.Dense(F_out * k * 2)(h)\n        out_ri = out_flat.reshape(B, F_out, k, 2)\n        f_fft_real, f_fft_imag = out_ri[..., 0], out_ri[..., 1]\n        f_fft = f_fft_real + 1j * f_fft_imag\n        f_fft_n = (nn.LayerNorm()(f_fft.real) + 1j * nn.LayerNorm()(f_fft.imag))\n        y_fft = (f_fft_n @ V) @ U_eff.T\n        y_fourier = jnp.fft.irfft(y_fft, n=T_out, axis=1)\n        gamma = custom_gamma[:, :, None]\n        y_fourier = gamma * y_fourier\n        x_flat_res = x.transpose(0, 2, 1).reshape(-1, 4)\n        h_res = nn.Dense(64)(x_flat_res); h_res = nn.relu(h_res)\n        h_res = nn.Dropout(rate=self.drop)(h_res, deterministic=not training)\n        h_res = nn.Dense(32)(h_res)\n        residual = h_res.reshape(B, N, 32).transpose(0, 2, 1)\n        y_copy = jnp.zeros((B, 32, N), dtype=residual.dtype).at[:, :4, :].set(x) + residual\n        return y_copy + y_fourier\n\nclass MoLR_DeeperGater(nn.Module):\n    sota_params: dict\n    gating_params: dict\n    num_gamma_archetypes: int\n\n    @nn.compact\n    def __call__(self, x, training=False):\n        gating_weights = DeeperGater_2DCNN(**self.gating_params)(x, training=training)\n        gamma_archetypes = self.param('gamma_archetypes', nn.initializers.zeros, (self.num_gamma_archetypes, 32))\n        gamma = jnp.einsum('be,et->bt', gating_weights, gamma_archetypes)\n        y = FourierWithCustomGamma(**self.sota_params, name=\"FourierBackbone\")(x, training=training, custom_gamma=gamma)\n        return y\n\ndef create_network(hparams):\n    model_hparams = {\n        'sota_params': {\n            'rank_k': hparams['rank_k'], 'proj_rank': hparams['proj_rank'],\n            'hidden_size': hparams['hidden_size'], 'drop': hparams['drop']\n        },\n        'gating_params': {\n            'num_experts': hparams['num_gamma_archetypes'], 'hidden_dim': hparams['gating_hidden_dim']\n        },\n        'num_gamma_archetypes': hparams['num_gamma_archetypes']\n    }\n    return BaseWrapper(MoLR_DeeperGater, model_hparams)\n\ndef compute_loss(predictions, targets, params, x):\n    mae = jnp.mean(jnp.abs(predictions - targets)); curv = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]; curv_pen = jnp.mean(curv * curv)\n    return mae + 1e-4 * curv_pen\n\ndef create_optimizer(learning_rate: float): \n    hparams = _define_hyperparameters()\n    return optax.chain(optax.clip_by_global_norm(hparams['clip_norm']), optax.adam(learning_rate=learning_rate, eps=hparams['adam_eps']))\n",
