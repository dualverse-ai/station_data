  "original_submission": {
    "content": "import sys\nimport jax\nimport jax.numpy as jnp\nimport jax.nn as jnn\nimport jax.random as jrandom\nimport optax\n\nsys.path.append('storage/ariadne')\nfrom models_fourier_ramp import create_network as create_base_network\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 9e-4,\n        'rank_k': 320,\n        'proj_rank': 36,      # p\n        'hidden_size': 128,   # H\n        'drop': 0.05,\n        'gamma_start': 0.25,\n        'gamma_end': 0.99,\n        'learn_gamma': False,  # ScalarRamp baseline\n        # MoT head hparams\n        'mot_rank': 4,         # R (small)\n        'alpha': 0.07,         # residual scale\n        'lambda_b_l2': 1e-6,   # L2 on basis B\n        'lambda_u_l2': 1e-8,   # L2 on assignment logits U\n        'lambda_b_curv': 1e-6  # smoothness of basis across time (second diff)\n    }\n\nclass MoTHeadWrapper:\n    \"\"\"\n    Wraps base Fourier LN ScalarRamp with a small Mixture-of-Timescales head:\n      - Basis B in R^{R x 32} (R small): horizon profiles shared across neurons.\n      - Per-neuron soft assignments P = softmax(U_logits) in R^{N x R}, sum-to-one.\n      - Residual y_resid[b,t,n] = alpha * sum_r B[r,t] * P[n,r] (batch-independent residual).\n    \"\"\"\n    def __init__(self, base_net, mot_rank=4, alpha=0.07):\n        self.base_net = base_net\n        self.R = mot_rank\n        self.alpha = alpha\n        # Inherit mutable/RNG requirements\n        self.mutable = getattr(self.base_net, 'mutable', [])\n        self.needs_rng = getattr(self.base_net, 'needs_rng', False)\n\n    def init(self, rng_key, dummy_input):\n        rng_base, rng_b, rng_u = jrandom.split(rng_key, 3)\n        base_params = self.base_net.init(rng_base, dummy_input)\n        # Infer N from dummy_input (B, 4, N)\n        N = int(dummy_input.shape[-1])\n        # Initialize basis near zero and per-neuron logits to zeros (uniform soft assignments)\n        B = jrandom.normal(rng_b, (self.R, 32)) * 0.02\n        U_logits = jnp.zeros((N, self.R), dtype=dummy_input.dtype)\n        return {'base': base_params, 'mot': {'B': B, 'U_logits': U_logits}}\n\n    def apply(self, params, x, training=False, mutable=None, rngs=None):\n        base_out = self.base_net.apply(params['base'], x, training=training, mutable=mutable, rngs=rngs)\n        if isinstance(base_out, tuple):\n            y_base, base_updates = base_out\n        else:\n            y_base, base_updates = base_out, None  # (B, 32, N)\n        B = params['mot']['B']                    # (R, 32)\n        U_logits = params['mot']['U_logits']      # (N, R)\n        P = jnn.softmax(U_logits, axis=-1)        # (N, R), sum-to-one\n        # Compute residual (32, N) = (32, R) @ (R, N)\n        Bt = jnp.swapaxes(B, 0, 1)                # (32, R)\n        resid_tn = jnp.matmul(Bt, jnp.swapaxes(P, 0, 1))  # (32, N)\n        y_resid = self.alpha * resid_tn[None, :, :]       # (1, 32, N) -> broadcast over batch\n        y = y_base + y_resid\n        if base_updates is not None:\n            return y, base_updates\n        return y\n\ndef create_network(hparams):\n    base_net = create_base_network({\n        'learning_rate': hparams.get('learning_rate', 9e-4),\n        'rank_k': hparams.get('rank_k', 320),\n        'proj_rank': hparams.get('proj_rank', 36),\n        'hidden_size': hparams.get('hidden_size', 128),\n        'drop': hparams.get('drop', 0.05),\n        'gamma_start': hparams.get('gamma_start', 0.25),\n        'gamma_end': hparams.get('gamma_end', 0.99),\n        'learn_gamma': hparams.get('learn_gamma', False),\n    })\n    return MoTHeadWrapper(\n        base_net=base_net,\n        mot_rank=hparams.get('mot_rank', 4),\n        alpha=hparams.get('alpha', 0.07),\n    )\n\ndef compute_loss(predictions, targets, params, x):\n    # Primary MAE\n    mae = jnp.mean(jnp.abs(predictions - targets))\n    # Temporal curvature penalty on predictions\n    d2 = predictions[:, 2:, :] - 2.0 * predictions[:, 1:-1, :] + predictions[:, :-2, :]\n    curv_pred = jnp.mean(jnp.abs(d2))\n    # Regularize basis and assignment logits (small)\n    h = _define_hyperparameters()\n    B = params['mot']['B']                  # (R, 32)\n    U_logits = params['mot']['U_logits']    # (N, R)\n    l2_b = h.get('lambda_b_l2', 1e-6) * jnp.mean(B * B)\n    l2_u = h.get('lambda_u_l2', 1e-8) * jnp.mean(U_logits * U_logits)\n    # Smoothness of basis across time (second diff over 32)\n    Bt = jnp.swapaxes(B, 0, 1)              # (32, R)\n    d2b = Bt[2:, :] - 2.0 * Bt[1:-1, :] + Bt[:-2, :]\n    curv_b = h.get('lambda_b_curv', 1e-6) * jnp.mean(jnp.abs(d2b))\n    return mae + 1e-4 * curv_pred + l2_b + l2_u + curv_b\n\ndef create_optimizer(learning_rate: float = 9e-4):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adam(learning_rate=learning_rate)\n    )\n\ndef complete(params, opt_state, trial_data):\n    # Lightweight logging of trial summary\n    try:\n        import os, json\n        os.makedirs(\"storage/ariadne/analyses/mot_head\", exist_ok=True)\n        out = {\n            \"trial_number\": trial_data.get(\"trial_number\"),\n            \"seed\": trial_data.get(\"seed\"),\n            \"val_mae\": trial_data.get(\"val_mae\"),\n            \"hyperparameters\": trial_data.get(\"hyperparameters\"),\n            \"note\": \"ScalarRamp H=128 with MoT head (R=4, alpha=0.07)\"\n        }\n        with open(\"storage/ariadne/analyses/mot_head/R4_alpha0.07.json\", \"w\") as f:\n            json.dump(out, f, indent=2)\n    except Exception:\n        pass\n\nBASE_SEED = 42\nBATCH_SIZE = 8\n",
