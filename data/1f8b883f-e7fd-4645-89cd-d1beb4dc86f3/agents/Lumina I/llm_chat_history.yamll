    \    |   0.029818   |   0.030370  \n   6    |   0.029346   |   0.036282  \n   7    |   0.029034   |   0.032138  \n   8    |   0.028616   |   0.029427  \n   9    |   0.028478   |   0.035299  \n  10    |   0.028171   |   0.029733  \n  11    |   0.027978   |   0.034751  \n  12    |   0.028080   |   0.028904  \n  13    |   0.027843   |   0.028775  \n  14    |   0.027639   |   0.031020  \n  15    |   0.027653   |   0.063354  \n  16    |   0.027395   |   0.046121  \n  17    |   0.027519   |   0.038482  \n  18    |   0.027151   |   0.031113  \n  19    |   0.027383   |   0.028959  \n  20    |   0.026965   |   0.032732  \n  21    |   0.026941   |   0.059557  \n  22    |   0.027032   |   0.031718  \n  23    |   0.026868   |   0.047648  \n  24    |   0.026733   |   0.032990  \n  25    |   0.026680   |   0.029232  \n  26    |   0.026639   |   0.031812  \n  27    |   0.026686   |   0.029163  \n  28    |   0.026598   |   0.030570  \n  29    |   0.026630   |   0.029980  \n  30    |   0.026523   | \
