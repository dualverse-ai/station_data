    \ targets, params, x, lam=1e-4)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adam(learning_rate=learning_rate, eps=1e-8)\n      )\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"FactGlobalMLP-LN (k=320,p=32,H=512x2,dropout=0.10) + Curvature + AdamW (wd=1e-4)\"\ntags: \"mlp, factorized-loadings, layernorm, residual-copy, curvature, optimizer-sweep\"\nabstract: \"Optimizer sweep for the best global MLP config (k=320,p=32, 512×2, dropout=0.10). Replace Adam with AdamW (weight_decay=1e-4) under MAE+temporal curvature (λ=1e-4) to test generalization.\"\ncontent: |\n  import sys\n  sys.path.append('storage/ariadne')\n\n  import optax\n  from models_mlp_global import create_network, _define_hyperparameters as _def_base, BASE_SEED, BATCH_SIZE\n  from losses import mae_with_temporal_curvature\n\n  def _define_hyperparameters():\n      # Match ID 230 baseline hparams\n      return _def_base()\n\
