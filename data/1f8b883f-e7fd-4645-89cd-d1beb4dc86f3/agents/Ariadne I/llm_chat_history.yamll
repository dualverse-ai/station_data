- text: "/execute_action{storage write ariadne/submissions/fourier_learn_gamma_prior_strong.py}\n```yaml\ncontent: |\n  import sys, json, os\n  sys.path.append('storage/ariadne')\n\n  import optax\n  import jax.numpy as jnp\n  import jax.nn as jnn\n  from flax.core import FrozenDict\n\n  from models_fourier_ramp import create_network as base_create_network\n  from losses import mae_with_temporal_curvature\n\n  class FourierWithLearnableGamma:\n      def __init__(self, gamma_start=0.25, gamma_end=0.99, base_hparams=None):\n          self.base = base_create_network(base_hparams or {})\n          self.gamma_start = float(gamma_start)\n          self.gamma_end = float(gamma_end)\n          self.needs_rng = getattr(self.base, 'needs_rng', True)\n\n      def init(self, rng_key, dummy_input):\n          variables = self.base.init(rng_key, dummy_input)\n          params = variables['params']\n          if hasattr(params, 'unfreeze'):\n              params = params.unfreeze()\n          else:\n \
    \             params = dict(params)\n          T_out = 32\n          t = jnp.linspace(0.0, 1.0, T_out, dtype=jnp.float32)\n          g_ramp = self.gamma_start + (self.gamma_end - self.gamma_start) * t\n          eps = 1e-6\n          g_ramp = jnp.clip(g_ramp, eps, 1 - eps)\n          gamma_raw_init = jnp.log(g_ramp) - jnp.log1p(-g_ramp)\n          params['gamma_raw'] = gamma_raw_init\n          return FrozenDict({'params': params})\n\n      def apply(self, params, x, training=False, mutable=None, rngs=None):\n          y = self.base.apply(params, x, training=training, mutable=mutable, rngs=rngs)  # (B, 32, N)\n          gamma = jnn.sigmoid(params['params']['gamma_raw'])\n          return y * gamma[None, :, None]\n\n  # Stronger priors (sweep)\n  LAM_PRIOR = 1e-4\n  LAM_SMOOTH = 2e-5\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 9e-4,\n          'rank_k': 320,\n          'proj_rank': 36,\n          'hidden_size': 160,\n          'drop': 0.05,\n      \
    \    'gamma_start': 0.25,\n          'gamma_end': 0.99\n      }\n\n  def create_network(hparams):\n      base_hp = {\n          'rank_k': int(hparams.get('rank_k', 320)),\n          'proj_rank': int(hparams.get('proj_rank', 36)),\n          'hidden_size': int(hparams.get('hidden_size', 160)),\n          'drop': float(hparams.get('drop', 0.05)),\n      }\n      return FourierWithLearnableGamma(\n          gamma_start=float(hparams.get('gamma_start', 0.25)),\n          gamma_end=float(hparams.get('gamma_end', 0.99)),\n          base_hparams=base_hp\n      )\n\n  def compute_loss(predictions, targets, params, x):\n      base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n      try:\n          gamma_raw = params['params']['gamma_raw']\n          T = predictions.shape[1]\n          t = jnp.linspace(0.0, 1.0, T, dtype=gamma_raw.dtype)\n          g_ramp = 0.25 + (0.99 - 0.25) * t\n          gamma = jnn.sigmoid(gamma_raw)\n          prior = LAM_PRIOR * jnp.mean((gamma\
    \ - g_ramp) ** 2)\n          smooth = LAM_SMOOTH * jnp.mean(jnp.diff(gamma) ** 2)\n          return base + prior + smooth\n      except Exception:\n          return base\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adam(learning_rate=learning_rate)\n      )\n\n  def complete(params, opt_state, trial_data):\n      try:\n          out_dir = \"storage/ariadne/analyses/fourier_learn_gamma_prior_strong\"\n          os.makedirs(out_dir, exist_ok=True)\n          gamma = (1.0 / (1.0 + jnp.exp(-params['params']['gamma_raw']))).tolist()\n          payload = {\n              \"gamma\": gamma,\n              \"val_mae\": float(trial_data.get(\"val_mae\", -1.0)),\n              \"hyperparameters\": trial_data.get(\"hyperparameters\", {}),\n              \"seed\": trial_data.get(\"seed\", None),\n              \"trial_number\": trial_data.get(\"trial_number\", None),\n          }\n          with open(os.path.join(out_dir,\
    \ f\"trial_{trial_data.get('trial_number','x')}.json\"), \"w\") as f:\n              json.dump(payload, f)\n      except Exception:\n          pass\n\n  BASE_SEED = 42\n  BATCH_SIZE = 8\n```\n\n/execute_action{storage write ariadne/submissions/fourier_learn_gamma_early2e5.py}\n```yaml\ncontent: |\n  import sys, json, os\n  sys.path.append('storage/ariadne')\n\n  import optax\n  import jax.numpy as jnp\n  import jax.nn as jnn\n  from flax.core import FrozenDict\n\n  from models_fourier_ramp import create_network as base_create_network\n  from losses import mae_with_temporal_curvature\n\n  class FourierWithLearnableGamma:\n      def __init__(self, gamma_start=0.25, gamma_end=0.99, base_hparams=None):\n          self.base = base_create_network(base_hparams or {})\n          self.gamma_start = float(gamma_start)\n          self.gamma_end = float(gamma_end)\n          self.needs_rng = getattr(self.base, 'needs_rng', True)\n\n      def init(self, rng_key, dummy_input):\n          variables\
    \ = self.base.init(rng_key, dummy_input)\n          params = variables['params']\n          if hasattr(params, 'unfreeze'):\n              params = params.unfreeze()\n          else:\n              params = dict(params)\n          T_out = 32\n          t = jnp.linspace(0.0, 1.0, T_out, dtype=jnp.float32)\n          g_ramp = self.gamma_start + (self.gamma_end - self.gamma_start) * t\n          eps = 1e-6\n          g_ramp = jnp.clip(g_ramp, eps, 1 - eps)\n          gamma_raw_init = jnp.log(g_ramp) - jnp.log1p(-g_ramp)\n          params['gamma_raw'] = gamma_raw_init\n          return FrozenDict({'params': params})\n\n      def apply(self, params, x, training=False, mutable=None, rngs=None):\n          y = self.base.apply(params, x, training=training, mutable=mutable, rngs=rngs)\n          gamma = jnn.sigmoid(params['params']['gamma_raw'])\n          return y * gamma[None, :, None]\n\n  # Priors + stronger early-step anchor\n  LAM_PRIOR = 5e-5\n  LAM_SMOOTH = 1e-5\n  LAM_EARLY = 2e-5  #\
    \ stronger First4 anchor than 1e-5\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 9e-4,\n          'rank_k': 320,\n          'proj_rank': 36,\n          'hidden_size': 160,\n          'drop': 0.05,\n          'gamma_start': 0.25,\n          'gamma_end': 0.99\n      }\n\n  def create_network(hparams):\n      base_hp = {\n          'rank_k': int(hparams.get('rank_k', 320)),\n          'proj_rank': int(hparams.get('proj_rank', 36)),\n          'hidden_size': int(hparams.get('hidden_size', 160)),\n          'drop': float(hparams.get('drop', 0.05)),\n      }\n      return FourierWithLearnableGamma(\n          gamma_start=float(hparams.get('gamma_start', 0.25)),\n          gamma_end=float(hparams.get('gamma_end', 0.99)),\n          base_hparams=base_hp\n      )\n\n  def compute_loss(predictions, targets, params, x):\n      base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n      try:\n          gamma_raw = params['params']['gamma_raw']\n\
    \          T = predictions.shape[1]\n          t = jnp.linspace(0.0, 1.0, T, dtype=gamma_raw.dtype)\n          g_ramp = 0.25 + (0.99 - 0.25) * t\n          gamma = jnn.sigmoid(gamma_raw)\n          prior = LAM_PRIOR * jnp.mean((gamma - g_ramp) ** 2)\n          smooth = LAM_SMOOTH * jnp.mean(jnp.diff(gamma) ** 2)\n          early = LAM_EARLY * jnp.mean((gamma[:4] - 1.0) ** 2)\n          return base + prior + smooth + early\n      except Exception:\n          return base\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adam(learning_rate=learning_rate)\n      )\n\n  def complete(params, opt_state, trial_data):\n      try:\n          out_dir = \"storage/ariadne/analyses/fourier_learn_gamma_early2e5\"\n          os.makedirs(out_dir, exist_ok=True)\n          gamma = (1.0 / (1.0 + jnp.exp(-params['params']['gamma_raw']))).tolist()\n          payload = {\n              \"gamma\": gamma,\n       \
    \       \"val_mae\": float(trial_data.get(\"val_mae\", -1.0)),\n              \"hyperparameters\": trial_data.get(\"hyperparameters\", {}),\n              \"seed\": trial_data.get(\"seed\", None),\n              \"trial_number\": trial_data.get(\"trial_number\", None),\n          }\n          with open(os.path.join(out_dir, f\"trial_{trial_data.get('trial_number','x')}.json\"), \"w\") as f:\n              json.dump(payload, f)\n      except Exception:\n          pass\n\n  BASE_SEED = 42\n  BATCH_SIZE = 8\n```\n\n/execute_action{goto private_memory}\n/execute_action{reply 1}\n```yaml\ncontent: |\n  Fourier Learnable γ plan (post-Lumina 443, −0.026125):\n  - Replication: our wrappers submitted (IDs 448: Learnableγ; 449: Learnableγ+First4 anchor). Exports γ to storage/ariadne/analyses/.\n  - Prepared next sweeps (files only; will queue after results land):\n    * fourier_learn_gamma_prior_strong.py — priors LAM_PRIOR=1e−4, LAM_SMOOTH=2e−5.\n    * fourier_learn_gamma_early2e5.py — First4\
    \ anchor LAM_EARLY=2e−5.\n  - Rationale: Lumina’s gain suggests temporal modulation matters in Fourier space. Our priors/anchors test stability and preserve RC-dominated early steps without overfitting γ.\n  - If replication matches/improves: confirm with a second run, then micro-sweep priors (1e−4/7.5e−5/5e−5) and (2e−5/1e−5/5e−6), and consider small drop tweak (0.048–0.052) at H=160.\n  - Archive note: add learnable-γ addendum once our replication completes; include γ curves, step MAEs, and comparison to fixed ramp.\n```"
