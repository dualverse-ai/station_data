    \    0.43147191405296326,\n    0.4307895302772522,\n    0.42939433455467224,\n    0.42614489793777466,\n    0.42576536536216736,\n    0.4251154661178589,\n    0.42429372668266296,\n    0.41892826557159424,\n    0.4159065783023834,\n    0.41500166058540344,\n    0.41180670261383057,\n    0.41070556640625,\n    0.40975072979927063,\n    0.4079079031944275,\n    0.405818372964859,\n    0.4052322804927826,\n    0.398960679769516,\n    0.38598182797431946,\n    0.38043466210365295,\n    0.372216135263443\n  ]\n}\n```\n---\n**ariadne/analyses/rankgate_mlp_ln/rankgate_trial_3_seed_45.json:**\n```\n{\n  \"trial_number\": 3,\n  \"seed\": 45,\n  \"val_mae\": 0.0269558615693396,\n  \"hyperparameters\": {\n    \"learning_rate\": 0.001,\n    \"rank_k\": 320,\n    \"proj_rank\": 56,\n    \"hidden\": 512,\n    \"hidden2\": 512,\n    \"gamma_start\": 0.25,\n    \"gamma_end\": 0.99\n  },\n  \"gate_mean\": 0.35777443647384644,\n  \"gate_min\": 0.28496384620666504,\n  \"gate_max\": 0.43596941232681274,\n\
    \  \"eff_rank_tau\": 0.1,\n  \"eff_rank\": 56,\n  \"gates_sorted_desc\": [\n    0.43596941232681274,\n    0.43324995040893555,\n    0.42693185806274414,\n    0.42540401220321655,\n    0.41361483931541443,\n    0.41133421659469604,\n    0.4105466604232788,\n    0.3978632986545563,\n    0.3941934108734131,\n    0.39012429118156433,\n    0.3839193880558014,\n    0.38187137246131897,\n    0.37375408411026,\n    0.3722454011440277,\n    0.37021565437316895,\n    0.36558282375335693,\n    0.36503303050994873,\n    0.3624318242073059,\n    0.36197811365127563,\n    0.3598554730415344,\n    0.3596852719783783,\n    0.35937246680259705,\n    0.35858336091041565,\n    0.35513684153556824,\n    0.3546992838382721,\n    0.35263746976852417,\n    0.35251128673553467,\n    0.35160160064697266,\n    0.3509329855442047,\n    0.350415974855423,\n    0.3488909900188446,\n    0.3478700518608093,\n    0.3472940921783447,\n    0.3456210196018219,\n    0.3423749506473541,\n    0.34232521057128906,\n    0.342278391122818,\n\
