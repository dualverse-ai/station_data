parts:
- text: "/execute_action{goto research}\n/execute_action{submit 1}\n```yaml\ntitle: \"LN-before-gating + V-normalized (k=320,p=32,H=96,a_max=0.993, γ_end=0.99)\"\ntags: \"state-space, factorized-loadings, layernorm, gating-order, normalization\"\nabstract: \"Test invariance change: LayerNorm before temporal gating and column-normalized V in forward. Base config k=320,p=32,H=96,a_max=0.993,γ_end=0.99. Loss: MAE+curvature (λ=1e-4) with tiny V-orthogonality (λ=1e-6).\"\ncontent: |\n  import sys\n  sys.path.append('storage/ariadne')\n\n  import jax\n  import jax.numpy as jnp\n  import optax\n\n  from models_fact_ln import Osc2CtxAdaptiveFactorizedL_LN\n  from losses import mae_with_temporal_curvature\n\n  BASE_SEED = 42\n  BATCH_SIZE = 8\n  V_ORTHO_LAM = 1e-6\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'rank_k': 320,\n          'proj_rank': 32,\n          'hidden_size': 96,\n          'normalize_u': True,\n          'normalize_v': True,\n\
    \          'ln_before_gating': True,\n          'gamma_start': 0.25,\n          'gamma_end': 0.99,\n          'a_max': 0.993\n      }\n\n  class Wrapper:\n      def __init__(self, **kwargs):\n          self.model = Osc2CtxAdaptiveFactorizedL_LN(**kwargs)\n          self.needs_rng = False\n      def init(self, rng_key, dummy_input):\n          return self.model.init(rng_key, dummy_input, training=True)\n      def apply(self, params, x, training=False, mutable=None, rngs=None):\n          return self.model.apply(params, x, training=training)\n\n  def create_network(hparams):\n      return Wrapper(\n          rank_k=int(hparams.get('rank_k', 320)),\n          proj_rank=int(hparams.get('proj_rank', 32)),\n          hidden_size=int(hparams.get('hidden_size', 96)),\n          normalize_u=bool(hparams.get('normalize_u', True)),\n          normalize_v=bool(hparams.get('normalize_v', True)),\n          ln_before_gating=bool(hparams.get('ln_before_gating', True)),\n          gamma_start=float(hparams.get('gamma_start',\
    \ 0.25)),\n          gamma_end=float(hparams.get('gamma_end', 0.99)),\n          a_max=float(hparams.get('a_max', 0.993))\n      )\n\n  def _get_from_tree(tree, key):\n      try:\n          if key in tree:\n              return tree[key]\n      except Exception:\n          pass\n      if isinstance(tree, dict) and 'params' in tree:\n          return _get_from_tree(tree['params'], key)\n      return _get_from_tree(dict(tree), key)\n\n  def compute_loss(predictions, targets, params, x):\n      base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n      try:\n          V = _get_from_tree(params, 'V')\n          G = V.T @ V\n          I = jnp.eye(G.shape[0], dtype=G.dtype)\n          v_ortho = jnp.sum((G - I) ** 2)\n      except Exception:\n          v_ortho = 0.0\n      return base + V_ORTHO_LAM * v_ortho\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adam(learning_rate=learning_rate,\
    \ eps=1e-8)\n      )\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"LN-before-gating + V-normalized (k=320,p=32,H=96,a_max=0.993, γ_end=0.992)\"\ntags: \"state-space, factorized-loadings, layernorm, gating-order, normalization\"\nabstract: \"Same as LN-before-gating + V-normalized but with slightly higher terminal γ_end=0.992 to test late-horizon balance under new invariances.\"\ncontent: |\n  import sys\n  sys.path.append('storage/ariadne')\n\n  import jax\n  import jax.numpy as jnp\n  import optax\n\n  from models_fact_ln import Osc2CtxAdaptiveFactorizedL_LN\n  from losses import mae_with_temporal_curvature\n\n  BASE_SEED = 42\n  BATCH_SIZE = 8\n  V_ORTHO_LAM = 1e-6\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'rank_k': 320,\n          'proj_rank': 32,\n          'hidden_size': 96,\n          'normalize_u': True,\n          'normalize_v': True,\n          'ln_before_gating': True,\n          'gamma_start': 0.25,\n         \
    \ 'gamma_end': 0.992,\n          'a_max': 0.993\n      }\n\n  class Wrapper:\n      def __init__(self, **kwargs):\n          self.model = Osc2CtxAdaptiveFactorizedL_LN(**kwargs)\n          self.needs_rng = False\n      def init(self, rng_key, dummy_input):\n          return self.model.init(rng_key, dummy_input, training=True)\n      def apply(self, params, x, training=False, mutable=None, rngs=None):\n          return self.model.apply(params, x, training=training)\n\n  def create_network(hparams):\n      return Wrapper(\n          rank_k=int(hparams.get('rank_k', 320)),\n          proj_rank=int(hparams.get('proj_rank', 32)),\n          hidden_size=int(hparams.get('hidden_size', 96)),\n          normalize_u=bool(hparams.get('normalize_u', True)),\n          normalize_v=bool(hparams.get('normalize_v', True)),\n          ln_before_gating=bool(hparams.get('ln_before_gating', True)),\n          gamma_start=float(hparams.get('gamma_start', 0.25)),\n          gamma_end=float(hparams.get('gamma_end',\
    \ 0.992)),\n          a_max=float(hparams.get('a_max', 0.993))\n      )\n\n  def _get_from_tree(tree, key):\n      try:\n          if key in tree:\n              return tree[key]\n      except Exception:\n          pass\n      if isinstance(tree, dict) and 'params' in tree:\n          return _get_from_tree(tree['params'], key)\n      return _get_from_tree(dict(tree), key)\n\n  def compute_loss(predictions, targets, params, x):\n      base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n      try:\n          V = _get_from_tree(params, 'V')\n          G = V.T @ V\n          I = jnp.eye(G.shape[0], dtype=G.dtype)\n          v_ortho = jnp.sum((G - I) ** 2)\n      except Exception:\n          v_ortho = 0.0\n      return base + V_ORTHO_LAM * v_ortho\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adam(learning_rate=learning_rate, eps=1e-8)\n      )\n```"
