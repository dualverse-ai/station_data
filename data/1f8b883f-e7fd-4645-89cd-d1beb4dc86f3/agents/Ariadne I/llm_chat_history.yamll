tick: 76
role: model
parts:
- text: "/execute_action{storage write ariadne/models_fact_ln_minrec.py}\n```yaml\ncontent: |\n  \"\"\"\n  Minimal-recurrence variants for factorized-loadings forecasters with LayerNorm.\n\n  Modes:\n    - 'diag1': first-order diagonal linear recurrence y_t = a * y_{t-1}\n    - 'none' : no explicit recurrence (increment-only; temporal structure via increment head)\n  Invariances:\n    - U and V column-normalized in forward when normalize_u/normalize_v are True\n    - LayerNorm across factor dimension; can be applied before or after gating\n\n  Components shared:\n    - Factorized loadings U ∈ R^{N×p}, V ∈ R^{k×p}\n    - Per-factor increment head mapping 4→32\n    - Input-adaptive temporal gate S[b,t,k] via s_alpha[t,k] and s_beta[k]·c[b,k]\n    - Global horizon gate gamma[t] (trainable schedule)\n    - Residual copy head to anchor short horizons\n\n  API matches Station expectations via a simple Wrapper in submissions.\n  \"\"\"\n  import jax\n  import jax.numpy as jnp\n  import flax.linen\
    \ as nn\n\n  from models import ResidualCopyHead\n\n  def _logit(p):\n      p = jnp.clip(p, 1e-6, 1 - 1e-6)\n      return jnp.log(p) - jnp.log(1 - p)\n\n  class FactorForecaster_MinRec(nn.Module):\n      # Core dims\n      rank_k: int = 320\n      proj_rank: int = 32\n      hidden_size: int = 96\n      output_horizon: int = 32\n      # Invariances\n      normalize_u: bool = True\n      normalize_v: bool = True\n      ln_before_gating: bool = True\n      # Recurrence settings\n      mode: str = 'diag1'   # 'diag1' or 'none'\n      a_max: float = 0.993\n      # Gating\n      gamma_start: float = 0.25\n      gamma_end: float = 0.99\n\n      @nn.compact\n      def __call__(self, x, training: bool = False):\n          # x: (B, 4, N)\n          B, T_in, N = x.shape\n          k = self.rank_k\n          p = self.proj_rank\n          T = self.output_horizon\n\n          # Factorized loadings\n          U = self.param('U', nn.initializers.lecun_normal(), (N, p))\n          V = self.param('V',\
    \ nn.initializers.lecun_normal(), (k, p))\n          U_used = U / (jnp.linalg.norm(U, axis=0, keepdims=True) + 1e-6) if self.normalize_u else U\n          V_used = V / (jnp.linalg.norm(V, axis=0, keepdims=True) + 1e-6) if self.normalize_v else V\n\n          # Project inputs to factor space\n          xU = jnp.einsum('btn,np->btp', x, U_used)           # (B,4,p)\n          factors_in = jnp.einsum('btp,kp->btk', xU, V_used)  # (B,4,k)\n\n          # Initial states from 4-step input\n          f_flat = factors_in.reshape(B * k, T_in)    # (B*k,4)\n          f0 = nn.Dense(1)(f_flat).reshape(B, k)      # (B,k)\n          f1 = nn.Dense(1)(f_flat).reshape(B, k)      # (B,k)\n\n          # Minimal recurrence\n          if self.mode == 'diag1':\n              # y_t = a * y_{t-1}, |a| <= a_max via tanh\n              a_raw = self.param('a_raw', nn.initializers.zeros, (k,))\n              a = self.a_max * jnp.tanh(a_raw)        # (k,)\n\n              def step(carry, _):\n                  y_prev\
    \ = carry                      # (B,k)\n                  y_t = a[None, :] * y_prev\n                  return y_t, y_t\n\n              # Start from f1\n              _, ys = jax.lax.scan(step, f1, xs=None, length=T - 1)  # (T-1,B,k)\n              y0 = f1[None, :, :]\n              f_rec = jnp.concatenate([y0, ys], axis=0).transpose(1, 0, 2)  # (B,T,k)\n          elif self.mode == 'none':\n              # No recurrence: let increment head drive; set recurrence contribution to zeros\n              f_rec = jnp.zeros((B, T, k), dtype=factors_in.dtype)\n          else:\n              raise ValueError(f\"Unknown mode: {self.mode}\")\n\n          # Per-factor increment head: (B*k,4) -> (B,T,k)\n          h = nn.Dense(self.hidden_size)(f_flat)\n          h = nn.gelu(h)\n          f_inc = nn.Dense(T)(h).reshape(B, k, T).transpose(0, 2, 1)\n\n          f_comb = f_rec + f_inc  # (B,T,k)\n\n          # Temporal gate S[b,t,k] using context c[b,k]\n          c = jnp.mean(factors_in, axis=1)  # (B,k)\n\
    \n          def alpha_init(key, shape, dtype=jnp.float32):\n              TT, K = shape\n              t = jnp.linspace(0.0, 1.0, TT, dtype=dtype)\n              base = 0.5 + 0.35 * t\n              base = jnp.tile(base[:, None], (1, K))\n              return _logit(base).astype(dtype)\n\n          alpha = self.param('s_alpha', alpha_init, (T, k))\n          beta = self.param('s_beta', nn.initializers.zeros, (k,))\n          logits = alpha[None, :, :] + (beta[None, None, :] * c[:, None, :])\n          S = nn.sigmoid(logits)  # (B,T,k)\n\n          # LayerNorm and gating order\n          if self.ln_before_gating:\n              f_norm = nn.LayerNorm(reduction_axes=-1, use_bias=False, use_scale=True)(f_comb)\n              f_out = f_norm * S\n          else:\n              f_out = f_comb * S\n              f_out = nn.LayerNorm(reduction_axes=-1, use_bias=False, use_scale=True)(f_out)\n\n          # Project back to neurons\n          z = jnp.einsum('btk,kp->btp', f_out, V_used)   # (B,T,p)\n\
    \          y_factor = jnp.einsum('btp,np->btn', z, U_used)\n\n          # Global horizon gate gamma[t]\n          def gamma_sched_init(key, shape, dtype=jnp.float32):\n              t = jnp.linspace(0.0, 1.0, shape[0], dtype=dtype)\n              g = self.gamma_start + (self.gamma_end - self.gamma_start) * t\n              return _logit(g).astype(dtype)\n          gamma_raw = self.param('gamma_raw', gamma_sched_init, (T,))\n          gamma = nn.sigmoid(gamma_raw)[None, :, None]\n          y_factor = gamma * y_factor\n\n          # Residual copy head\n          y_copy = ResidualCopyHead(output_horizon=T)(x)\n          return y_copy + y_factor\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"MinRec-Diag1: LN-before-gating + U/V-normalized (k=320,p=32,H=96,a_max=0.993, γ_end=0.99)\"\ntags: \"ablation, recurrence, factorized-loadings, layernorm, normalization\"\nabstract: \"Falsify need for oscillatory recurrence: replace with first-order diagonal y_t=a*y_{t-1}. Invariances: forward\
    \ U/V normalization, LayerNorm before gating. Base config k=320,p=32,H=96,γ_end=0.99.\"\ncontent: |\n  import sys\n  sys.path.append('storage/ariadne')\n\n  import jax\n  import jax.numpy as jnp\n  import optax\n\n  from models_fact_ln_minrec import FactorForecaster_MinRec\n  from losses import mae_with_temporal_curvature\n\n  BASE_SEED = 42\n  BATCH_SIZE = 8\n  V_ORTHO_LAM = 1e-6  # tiny tie-breaker on raw V\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'rank_k': 320,\n          'proj_rank': 32,\n          'hidden_size': 96,\n          'normalize_u': True,\n          'normalize_v': True,\n          'ln_before_gating': True,\n          'mode': 'diag1',\n          'gamma_start': 0.25,\n          'gamma_end': 0.99,\n          'a_max': 0.993\n      }\n\n  class Wrapper:\n      def __init__(self, **kwargs):\n          self.model = FactorForecaster_MinRec(**kwargs)\n          self.needs_rng = False\n      def init(self, rng_key, dummy_input):\n\
    \          return self.model.init(rng_key, dummy_input, training=True)\n      def apply(self, params, x, training=False, mutable=None, rngs=None):\n          return self.model.apply(params, x, training=training)\n\n  def create_network(hparams):\n      return Wrapper(\n          rank_k=int(hparams.get('rank_k', 320)),\n          proj_rank=int(hparams.get('proj_rank', 32)),\n          hidden_size=int(hparams.get('hidden_size', 96)),\n          normalize_u=bool(hparams.get('normalize_u', True)),\n          normalize_v=bool(hparams.get('normalize_v', True)),\n          ln_before_gating=bool(hparams.get('ln_before_gating', True)),\n          mode=str(hparams.get('mode', 'diag1')),\n          gamma_start=float(hparams.get('gamma_start', 0.25)),\n          gamma_end=float(hparams.get('gamma_end', 0.99)),\n          a_max=float(hparams.get('a_max', 0.993))\n      )\n\n  def _get_from_tree(tree, key):\n      try:\n          if key in tree:\n              return tree[key]\n      except Exception:\n\
    \          pass\n      if isinstance(tree, dict) and 'params' in tree:\n          return _get_from_tree(tree['params'], key)\n      return _get_from_tree(dict(tree), key)\n\n  def compute_loss(predictions, targets, params, x):\n      base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n      try:\n          V = _get_from_tree(params, 'V')\n          G = V.T @ V\n          I = jnp.eye(G.shape[0], dtype=G.dtype)\n          v_ortho = jnp.sum((G - I) ** 2)\n      except Exception:\n          v_ortho = 0.0\n      return base + V_ORTHO_LAM * v_ortho\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adam(learning_rate=learning_rate, eps=1e-8)\n      )\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"MinRec-None (Increment-only): LN-before-gating + U/V-normalized (k=320,p=32,H=96, γ_end=0.99)\"\ntags: \"ablation, recurrence, increment-only, factorized-loadings, layernorm,\
    \ normalization\"\nabstract: \"Falsify need for any explicit recurrence: remove recurrence entirely (increment-only). Invariances: forward U/V normalization, LN before gating. Base config k=320,p=32,H=96,γ_end=0.99.\"\ncontent: |\n  import sys\n  sys.path.append('storage/ariadne')\n\n  import jax\n  import jax.numpy as jnp\n  import optax\n\n  from models_fact_ln_minrec import FactorForecaster_MinRec\n  from losses import mae_with_temporal_curvature\n\n  BASE_SEED = 42\n  BATCH_SIZE = 8\n  V_ORTHO_LAM = 1e-6\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'rank_k': 320,\n          'proj_rank': 32,\n          'hidden_size': 96,\n          'normalize_u': True,\n          'normalize_v': True,\n          'ln_before_gating': True,\n          'mode': 'none',\n          'gamma_start': 0.25,\n          'gamma_end': 0.99\n      }\n\n  class Wrapper:\n      def __init__(self, **kwargs):\n          self.model = FactorForecaster_MinRec(**kwargs)\n\
    \          self.needs_rng = False\n      def init(self, rng_key, dummy_input):\n          return self.model.init(rng_key, dummy_input, training=True)\n      def apply(self, params, x, training=False, mutable=None, rngs=None):\n          return self.model.apply(params, x, training=training)\n\n  def create_network(hparams):\n      return Wrapper(\n          rank_k=int(hparams.get('rank_k', 320)),\n          proj_rank=int(hparams.get('proj_rank', 32)),\n          hidden_size=int(hparams.get('hidden_size', 96)),\n          normalize_u=bool(hparams.get('normalize_u', True)),\n          normalize_v=bool(hparams.get('normalize_v', True)),\n          ln_before_gating=bool(hparams.get('ln_before_gating', True)),\n          mode=str(hparams.get('mode', 'none')),\n          gamma_start=float(hparams.get('gamma_start', 0.25)),\n          gamma_end=float(hparams.get('gamma_end', 0.99))\n      )\n\n  def _get_from_tree(tree, key):\n      try:\n          if key in tree:\n              return tree[key]\n\
    \      except Exception:\n          pass\n      if isinstance(tree, dict) and 'params' in tree:\n          return _get_from_tree(tree['params'], key)\n      return _get_from_tree(dict(tree), key)\n\n  def compute_loss(predictions, targets, params, x):\n      base = mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n      try:\n          V = _get_from_tree(params, 'V')\n          G = V.T @ V\n          I = jnp.eye(G.shape[0], dtype=G.dtype)\n          v_ortho = jnp.sum((G - I) ** 2)\n      except Exception:\n          v_ortho = 0.0\n      return base + V_ORTHO_LAM * v_ortho\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adam(learning_rate=learning_rate, eps=1e-8)\n      )\n```"
