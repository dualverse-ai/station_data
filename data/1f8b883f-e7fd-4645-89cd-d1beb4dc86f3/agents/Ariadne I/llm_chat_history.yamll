- text: "/execute_action{submit 1}\n```yaml\ntitle: \"FForecaster-LN ScalarRamp (k=320,p=36,M=16,H=128): γ ramp + RC + Clip(1.0), lr=1e-3\"\ntags: \"fourier, layernorm, factorized-loadings, residual-copy, optimization\"\nabstract: \"Fourier LN baseline with scalar per-factor context, gamma[t] initialized as 0.25→0.99 ramp, residual copy head, Adam lr=1e-3, global grad clip=1.0, MAE+curvature (λ=1e-4). Exports gamma/frequency stats on complete().\"\ncontent: |\n  import sys, os, json\n  sys.path.append('storage/ariadne')\n\n  import jax\n  import jax.numpy as jnp\n  import optax\n\n  from models_fourier_ramp import FourierForecasterLNScalarRamp\n  from models import ResidualCopyHead\n  from losses import mae_with_temporal_curvature\n\n  BASE_SEED = 42\n  BATCH_SIZE = 8\n\n  class Wrapper:\n      def __init__(self, rank_k=320, proj_rank=36, num_harmonics=16, hidden_size=128,\n                   gamma_start=0.25, gamma_end=0.99, ln_in_factor=True):\n          self.backbone = FourierForecasterLNScalarRamp(\n\
    \              rank_k=rank_k, proj_rank=proj_rank, num_harmonics=num_harmonics,\n              hidden_size=hidden_size, gamma_start=gamma_start, gamma_end=gamma_end,\n              ln_in_factor=ln_in_factor\n          )\n          self.copy_head = ResidualCopyHead(output_horizon=32)\n          self.needs_rng = False\n\n      def init(self, rng_key, dummy_input):\n          rng_back, rng_copy = jax.random.split(rng_key)\n          params_back = self.backbone.init(rng_back, dummy_input, training=True)\n          params_copy = self.copy_head.init(rng_copy, dummy_input)\n          return {\"backbone\": params_back, \"copy\": params_copy}\n\n      def apply(self, params, x, training=False, mutable=None, rngs=None):\n          y_factor = self.backbone.apply(params[\"backbone\"], x, training=training)\n          y_copy = self.copy_head.apply(params[\"copy\"], x)\n          return y_factor + y_copy\n\n  def _define_hyperparameters():\n      return {\n          \"learning_rate\": 1e-3,\n    \
    \      \"rank_k\": 320,\n          \"proj_rank\": 36,\n          \"num_harmonics\": 16,\n          \"hidden_size\": 128,\n          \"gamma_start\": 0.25,\n          \"gamma_end\": 0.99,\n          \"ln_in_factor\": True\n      }\n\n  def create_network(hparams):\n      return Wrapper(\n          rank_k=int(hparams.get(\"rank_k\", 320)),\n          proj_rank=int(hparams.get(\"proj_rank\", 36)),\n          num_harmonics=int(hparams.get(\"num_harmonics\", 16)),\n          hidden_size=int(hparams.get(\"hidden_size\", 128)),\n          gamma_start=float(hparams.get(\"gamma_start\", 0.25)),\n          gamma_end=float(hparams.get(\"gamma_end\", 0.99)),\n          ln_in_factor=bool(hparams.get(\"ln_in_factor\", True))\n      )\n\n  def compute_loss(predictions, targets, params, x):\n      return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      lr = float(learning_rate)\n      return optax.chain(\n        \
    \  optax.clip_by_global_norm(1.0),\n          optax.adam(learning_rate=lr, eps=1e-8)\n      )\n\n  def complete(params, opt_state, trial_data):\n      # Export gamma and frequency stats\n      try:\n          p_back = params[\"backbone\"]\n          gamma_raw = p_back[\"params\"][\"gamma_raw\"]  # (T_out,)\n          freq_raw = p_back[\"params\"][\"freq_raw\"]    # (k,M)\n          gamma = jax.nn.sigmoid(gamma_raw)\n          w = jnp.pi * jax.nn.sigmoid(freq_raw)\n\n          g = jax.device_get(gamma)\n          w_np = jax.device_get(w)\n\n          stats = {\n              \"gamma_mean\": float(g.mean()),\n              \"gamma_start\": float(g[0]),\n              \"gamma_end\": float(g[-1]),\n              \"w_mean\": float(w_np.mean()),\n              \"w_median\": float(jnp.median(w_np)),\n              \"w_q10\": float(jnp.quantile(w_np, 0.10)),\n              \"w_q90\": float(jnp.quantile(w_np, 0.90)),\n              \"k\": int(w_np.shape[0]),\n              \"M\": int(w_np.shape[1]),\n\
    \              \"val_mae\": float(trial_data.get(\"val_mae\", -1.0)),\n              \"seed\": int(trial_data.get(\"seed\", -1)),\n              \"trial_number\": int(trial_data.get(\"trial_number\", -1)),\n          }\n          out_dir = f\"storage/ariadne/analyses/fourier_ramp/p{p_back['params']['U'].shape[1]}/trial_{trial_data.get('seed','x')}\"\n          os.makedirs(out_dir, exist_ok=True)\n          with open(os.path.join(out_dir, \"gamma_freq_stats.json\"), \"w\") as f:\n              json.dump(stats, f, indent=2)\n      except Exception as e:\n          # Best-effort export; ignore failures\n          pass\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"FForecaster-LN ScalarRamp (k=320,p=36,M=16,H=128): γ ramp + RC + Clip(1.0), lr=9e-4\"\ntags: \"fourier, layernorm, factorized-loadings, residual-copy, optimization\"\nabstract: \"Same ramp-initialized Fourier LN baseline, but with Adam lr=9e-4 (vs 1e-3) to test stability; includes residual copy, clip=1.0, MAE+curvature (λ=1e-4).\
    \ Exports gamma/frequency stats on complete().\"\ncontent: |\n  import sys, os, json\n  sys.path.append('storage/ariadne')\n\n  import jax\n  import jax.numpy as jnp\n  import optax\n\n  from models_fourier_ramp import FourierForecasterLNScalarRamp\n  from models import ResidualCopyHead\n  from losses import mae_with_temporal_curvature\n\n  BASE_SEED = 42\n  BATCH_SIZE = 8\n\n  class Wrapper:\n      def __init__(self, rank_k=320, proj_rank=36, num_harmonics=16, hidden_size=128,\n                   gamma_start=0.25, gamma_end=0.99, ln_in_factor=True):\n          self.backbone = FourierForecasterLNScalarRamp(\n              rank_k=rank_k, proj_rank=proj_rank, num_harmonics=num_harmonics,\n              hidden_size=hidden_size, gamma_start=gamma_start, gamma_end=gamma_end,\n              ln_in_factor=ln_in_factor\n          )\n          self.copy_head = ResidualCopyHead(output_horizon=32)\n          self.needs_rng = False\n\n      def init(self, rng_key, dummy_input):\n          rng_back,\
    \ rng_copy = jax.random.split(rng_key)\n          params_back = self.backbone.init(rng_back, dummy_input, training=True)\n          params_copy = self.copy_head.init(rng_copy, dummy_input)\n          return {\"backbone\": params_back, \"copy\": params_copy}\n\n      def apply(self, params, x, training=False, mutable=None, rngs=None):\n          y_factor = self.backbone.apply(params[\"backbone\"], x, training=training)\n          y_copy = self.copy_head.apply(params[\"copy\"], x)\n          return y_factor + y_copy\n\n  def _define_hyperparameters():\n      return {\n          \"learning_rate\": 9e-4,\n          \"rank_k\": 320,\n          \"proj_rank\": 36,\n          \"num_harmonics\": 16,\n          \"hidden_size\": 128,\n          \"gamma_start\": 0.25,\n          \"gamma_end\": 0.99,\n          \"ln_in_factor\": True\n      }\n\n  def create_network(hparams):\n      return Wrapper(\n          rank_k=int(hparams.get(\"rank_k\", 320)),\n          proj_rank=int(hparams.get(\"proj_rank\"\
    , 36)),\n          num_harmonics=int(hparams.get(\"num_harmonics\", 16)),\n          hidden_size=int(hparams.get(\"hidden_size\", 128)),\n          gamma_start=float(hparams.get(\"gamma_start\", 0.25)),\n          gamma_end=float(hparams.get(\"gamma_end\", 0.99)),\n          ln_in_factor=bool(hparams.get(\"ln_in_factor\", True))\n      )\n\n  def compute_loss(predictions, targets, params, x):\n      return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adam(learning_rate=9e-4, eps=1e-8)\n      )\n\n  def complete(params, opt_state, trial_data):\n      try:\n          p_back = params[\"backbone\"]\n          gamma_raw = p_back[\"params\"][\"gamma_raw\"]  # (T_out,)\n          freq_raw = p_back[\"params\"][\"freq_raw\"]    # (k,M)\n          gamma = jax.nn.sigmoid(gamma_raw)\n          w = jnp.pi * jax.nn.sigmoid(freq_raw)\n\
