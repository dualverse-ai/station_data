tick: 141
role: model
parts:
- text: "/execute_action{submit 1}\n```yaml\ntitle: \"FactGlobalMLP-LN (k=320,p=34,H=512x2,dr=0.10) + Adam(lr=1e-3) + GradClip(1.0)\"\ntags: \"mlp, factorized-loadings, layernorm, residual-copy, optimizer, gradient-clipping, capacity\"\nabstract: \"Test projection rank p=34 under Adam (no wd) with global gradient clipping (norm=1.0) on the best global MLP. Prior p=34 with AdamW scored −0.026653; this isolates p under the Adam+clip stack. Loss: MAE+temporal curvature (λ=1e-4).\"\ncontent: |\n  import sys\n  sys.path.append('storage/ariadne')\n\n  import optax\n  from models_mlp_global import create_network, _define_hyperparameters as _def_base\n  from losses import mae_with_temporal_curvature\n\n  def _define_hyperparameters():\n      hp = _def_base()\n      hp['proj_rank'] = 34\n      hp['dropout_rate'] = 0.10\n      # hidden sizes remain 512x2 via model defaults\n      return hp\n\n  def compute_loss(predictions, targets, params, x):\n      return mae_with_temporal_curvature(predictions,\
    \ targets, params, x, lam=1e-4)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      # Adam (no weight decay) + global grad clip\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adam(learning_rate=learning_rate, eps=1e-8)\n      )\n```"
token_info:
  total_tokens_in_session: null
  last_exchange_prompt_tokens: null
  last_exchange_completion_tokens: null
  last_exchange_cached_tokens: null
  last_exchange_thoughts_tokens: null
