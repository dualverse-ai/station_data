tick: 277
role: model
parts:
- text: "/execute_action{storage read ariadne/analyses/fourier_learn_gamma_per_condition/trial_43.json}\n/execute_action{storage read ariadne/analyses/fourier_learn_gamma_export_v2/trial_43.json}\n/execute_action{submit 1}\n```yaml\ntitle: \"Analysis v3: Robust γ[t] vs per-condition difficulty (deep-scan JSON)\"\ntags: \"analysis, fourier, learnable-gamma, condition-wise, reproducibility\"\nabstract: \"CPU-only test() that deeply scans JSON to extract γ profiles and per-condition step-MAEs even under nested schemas. Saves cond_gamma_correlation_v3.json.\"\ncontent: |\n  import os, json\n  import numpy as np\n\n  T = 32\n\n  # Deep utilities\n  def _find_first_len32_array(obj):\n      # DFS to find first list/tuple length 32 of numbers\n      if isinstance(obj, (list, tuple)) and len(obj) == T and all(isinstance(x, (int, float)) for x in obj):\n          return np.array(obj, dtype=float)\n      if isinstance(obj, dict):\n          for v in obj.values():\n              arr = _find_first_len32_array(v)\n\
    \              if arr is not None:\n                  return arr\n      if isinstance(obj, (list, tuple)):\n          for v in obj:\n              arr = _find_first_len32_array(v)\n              if arr is not None:\n                  return arr\n      return None\n\n  def _extract_gamma(obj):\n      # try common keys first\n      for k in (\"gamma\", \"gamma_profile\", \"gamma_t\", \"gamma_values\"):\n          if k in obj:\n              arr = _find_first_len32_array(obj[k])\n              if arr is not None:\n                  return arr\n      # nested fallback\n      return _find_first_len32_array(obj)\n\n  def _extract_per_condition(obj):\n      # Accept various container keys\n      cand = None\n      for k in (\n          \"per_condition_step_mae\",\n          \"val_mae_by_condition\",\n          \"per_condition_mae\",\n          \"condition_step_mae\",\n          \"conditions\",\n          \"by_condition\",\n      ):\n          if k in obj and isinstance(obj[k], dict):\n    \
    \          cand = obj[k]\n              break\n      if cand is None:\n          # If not present, maybe whole object is the condition map\n          if isinstance(obj, dict):\n              cand = obj\n          else:\n              return {}\n      out = {}\n      # Each value may be a length-32 list, or nested where we need to find first length-32 array\n      for ck, cv in cand.items():\n          arr = _find_first_len32_array(cv)\n          if arr is not None and arr.size == T and not np.isnan(arr).any():\n              out[str(ck)] = arr\n      return out\n\n  def test():\n      base_dir = \"storage/ariadne/analyses\"\n      gamma_list = []\n      percond_list = []\n\n      for root, _, files in os.walk(base_dir):\n          for fn in files:\n              if not fn.endswith(\".json\"):\n                  continue\n              path = os.path.join(root, fn)\n              try:\n                  with open(path, \"r\") as f:\n                      obj = json.load(f)\n         \
    \     except Exception:\n                  continue\n              g = _extract_gamma(obj)\n              if g is not None and g.size == T:\n                  gamma_list.append((path, g))\n              pc = _extract_per_condition(obj)\n              if pc:\n                  percond_list.append((path, pc))\n\n      summary = {\n          \"gamma_files\": len(gamma_list),\n          \"per_condition_files\": len(percond_list),\n          \"base_dir\": base_dir,\n      }\n\n      if not gamma_list or not percond_list:\n          out = {\"ok\": False, \"reason\": \"Insufficient files after deep scan\", **summary}\n      else:\n          G = np.vstack([g for _, g in gamma_list])\n          gamma_mean = G.mean(axis=0)\n          gamma_std  = G.std(axis=0)\n\n          # Merge per-condition\n          cond_acc = {}\n          for _, pc in percond_list:\n              for ck, arr in pc.items():\n                  cond_acc.setdefault(ck, []).append(arr)\n          cond_stats = {}\n         \
    \ for ck, lst in cond_acc.items():\n              M = np.vstack(lst)\n              if M.shape[1] != T or np.isnan(M).any():\n                  continue\n              cond_stats[ck] = {\n                  \"mean\": M.mean(axis=0).tolist(),\n                  \"std\":  M.std(axis=0).tolist(),\n                  \"count\": int(M.shape[0]),\n              }\n\n          # Overall step difficulty\n          if cond_stats:\n              step_mae_mean = np.vstack([np.array(v[\"mean\"]) for v in cond_stats.values()]).mean(axis=0)\n          else:\n              step_mae_mean = np.full((T,), np.nan)\n\n          def safe_corr(a, b):\n              a = np.asarray(a, dtype=float); b = np.asarray(b, dtype=float)\n              if np.isnan(a).any() or np.isnan(b).any(): return None\n              if a.std() == 0 or b.std() == 0: return None\n              return float(np.corrcoef(a, b)[0,1])\n\n          corr_gamma_vs_mean = safe_corr(gamma_mean, step_mae_mean)\n\n          # heuristic potential\
    \ alignment score\n          def z(x): x=np.asarray(x,dtype=float); return (x-x.mean())/(x.std()+1e-8)\n          potential = None if np.isnan(step_mae_mean).any() else float(np.dot(-z(gamma_mean), z(step_mae_mean))/T)\n\n          out = {\n              \"ok\": True,\n              **summary,\n              \"gamma_mean\": gamma_mean.tolist(),\n              \"gamma_std\": gamma_std.tolist(),\n              \"corr_gamma_vs_step_mae_mean\": corr_gamma_vs_mean,\n              \"potential_alignment_score\": potential,\n              \"conditions_analyzed\": {k: {\"count\": v[\"count\"]} for k,v in cond_stats.items()},\n          }\n\n      out_path = os.path.join(base_dir, \"cond_gamma_correlation_v3.json\")\n      with open(out_path, \"w\") as f:\n          json.dump(out, f, indent=2)\n      print(\"Analysis v3 complete ->\", out_path)\n      return \"OK\"\n```"
