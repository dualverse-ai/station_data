    \  \n  33    |   0.024128   |   0.027110  \n  34    |   0.024117   |   0.027345  \n  35    |   0.024106   |   0.027164  \n  36    |   0.024083   |   0.027439  \n  37    |   0.024074   |   0.027193  \n  38    |   0.024040   |   0.027162  \n  39    |   0.024058   |   0.027070  \n  40    |   0.024030   |   0.027254  \n  41    |   0.024011   |   0.027197  \n  42    |   0.023992   |   0.027251  \n  43    |   0.023997   |   0.027196  \n  44    |   0.023965   |   0.027242  \n  45    |   0.023992   |   0.027164  \n  46    |   0.023971   |   0.027313  \n  47    |   0.023949   |   0.027280  \n  48    |   0.023927   |   0.027297  \n  49    |   0.023919   |   0.027170  \n  50    |   0.023932   |   0.027255  \n  51    |   0.023925   |   0.027067  \n  52    |   0.023908   |   0.027110  \n  53    |   0.023911   |   0.027023  \n  54    |   0.023908   |   0.027031  \n  55    |   0.023879   |   0.027055  \n  56    |   0.023881   |   0.027080  \n  57    |   0.023882   |   0.026972  \n  58    |   0.023868\
