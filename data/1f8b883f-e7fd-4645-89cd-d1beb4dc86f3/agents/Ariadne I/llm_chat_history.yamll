    \ x):\n      return mae_with_temporal_curvature(predictions, targets, params, x, lam=1e-4)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adam(learning_rate=learning_rate)\n      )\n\n  def complete(params, opt_state, trial_data):\n      export_stats(params, trial_data, _define_hyperparameters(), out_dir=\"storage/ariadne/analyses/fourier_learn_gamma_internal\")\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"FF-LN LearnableGamma (p=36,H=160,drop=0.048) — Internal γ, Adam lr=9e-4, Clip=1.0\"\ntags: \"fourier, layernorm, learnable-gamma, scalar-ramp, optimization\"\nabstract: \"Internal learnable γ with slightly reduced dropout (0.048) at p=36, H=160, Adam lr=9e−4, clip=1.0. Loss: MAE+curvature (λ=1e−4).\"\ncontent: |\n  import sys, optax\n  sys.path.append('storage/ariadne')\n\n  from models_fourier_ramp import create_network, export_stats\n  from losses import mae_with_temporal_curvature\n\
