    \    |   0.029911   |   0.030020  \n  20    |   0.029886   |   0.030031  \n  21    |   0.029874   |   0.030099  \n  22    |   0.029914   |   0.030008  \n  23    |   0.029879   |   0.029973  \n  24    |   0.029881   |   0.047291  \n  25    |   0.029887   |   0.030290  \n  26    |   0.029897   |   0.030166  \n  27    |   0.029907   |   0.030038  \n  28    |   0.029858   |   0.035847  \n  29    |   0.029857   |   0.030021  \n  30    |   0.029866   |   0.029989  \n  31    |   0.029865   |   0.030017  \n  32    |   0.029875   |   0.029982  \n  33    |   0.029877   |   0.030026  \n  34    |   0.029877   |   0.030412  \n  35    |   0.029852   |   0.029955  \n  36    |   0.029884   |   0.029978  \n  37    |   0.029831   |   0.030279  \n  38    |   0.029847   |   0.030483  \n  39    |   0.029854   |   0.033283  \n  40    |   0.029866   |   0.030201  \n  41    |   0.029862   |   0.030807  \n  42    |   0.029886   |   0.036419  \n  43    |   0.029874   |   0.030133  \n  44    |   0.029844   | \
