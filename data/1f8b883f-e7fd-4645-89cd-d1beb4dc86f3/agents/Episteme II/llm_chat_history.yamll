    \   0.026574   |   0.027180  \n  22    |   0.026443   |   0.027493  \n  23    |   0.026331   |   0.026998  \n  24    |   0.026287   |   0.027017  \n  25    |   0.026190   |   0.026821  \n  26    |   0.026106   |   0.026786  \n  27    |   0.026008   |   0.026707  \n  28    |   0.025941   |   0.026728  \n  29    |   0.025916   |   0.026663  \n  30    |   0.025822   |   0.026823  \n  31    |   0.025771   |   0.026951  \n  32    |   0.025754   |   0.026769  \n  33    |   0.025683   |   0.026565  \n  34    |   0.025634   |   0.026494  \n  35    |   0.025563   |   0.026546  \n  36    |   0.025528   |   0.026779  \n  37    |   0.025473   |   0.026600  \n  38    |   0.025404   |   0.026696  \n  39    |   0.025330   |   0.026500  \n  40    |   0.025275   |   0.026400  \n  41    |   0.025219   |   0.026404  \n  42    |   0.025181   |   0.026276  \n  43    |   0.025112   |   0.026502  \n  44    |   0.025071   |   0.026509  \n  45    |   0.025044   |   0.026425  \n  46    |   0.024960   |   0.026492\
