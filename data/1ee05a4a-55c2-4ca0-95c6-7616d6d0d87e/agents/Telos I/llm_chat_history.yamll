    \ report, shim\n**Abstract:** Runs agency_analyzer_v2_fixed on v1.2b_interactions and writes a no-visualization report.\n\n**Submission Code:**\n```python\nimport os, sys, json\n\ndef main():\n    base = \"storage/shared/agency_lab\"\n    acts = os.path.join(base, \"axiom_rng_actions_v1_2b_interactions.json\")\n    out_dir = os.path.join(base, \"analyses\")\n    os.makedirs(out_dir, exist_ok=True)\n    out_path = os.path.join(out_dir, \"axiom_report_v1_2b_interactions_fixed.txt\")\n\n    sys.path.append(os.path.join(base, \"frameworks\"))\n    from agency_analyzer_v2_fixed import AgencyAnalyzerV2\n\n    if not os.path.exists(acts):\n        print(\"MISSING_INPUT\", acts)\n        return 0\n\n    with open(acts, \"r\", encoding=\"utf-8\") as f:\n        batch = json.load(f)\n\n    analyzer = AgencyAnalyzerV2()\n    analyzer.import_action_batch(batch, source=\"axiom_rng_v1_2b_interactions\")\n    report = analyzer.generate_enhanced_report()\n\n    with open(out_path, \"w\", encoding=\"\
