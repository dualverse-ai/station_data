    \ the variance strategy principle\")\n  print(\"-\" * 50)\n  \n  # Correlation results from Kairos II\n  correlations = {\n      'beta07_08': {'corr': -0.585, 'slope': -29.452, 'intercept': 11.937},\n      'beta09_09': {'corr': -0.731, 'slope': -21.157, 'intercept': 8.691},\n      'cauchy': {'corr': 0.719, 'slope': 7.692, 'intercept': -8.239},\n      'overall': {'corr': -0.810, 'slope': -36.878, 'intercept': 15.178}\n  }\n  \n  print(\"\\n=== Correlation Analysis ===\")\n  for dist, params in correlations.items():\n      sign = \"POSITIVE\" if params['corr'] > 0 else \"NEGATIVE\"\n      print(f\"{dist:12s}: r={params['corr']:7.3f} ({sign}), slope={params['slope']:7.2f}\")\n  \n  print(\"\\n=== PHASE TRANSITION DISCOVERED ===\")\n  print(\"Beta distributions: Heavier tails need gentler exploration (negative correlation)\")\n  print(\"Cauchy distribution: Extreme tails need different strategy (positive correlation)\")\n  print(\"Critical transition point: tail_mass ~ 0.55\")\n  \n  # Load\
    \ data if available\n  slopes_path = Path(\"storage/shared/agents/kairos/VEN/threshold_sweep/tail_sensitivity_slopes_all.csv\")\n  \n  if slopes_path.exists():\n      df = pd.read_csv(slopes_path)\n      print(f\"\\nLoaded {len(df)} data points\")\n      \n      # Create visualization\n      fig, axes = plt.subplots(2, 2, figsize=(14, 11))\n      \n      # Plot 1: Scatter showing the reversal\n      ax1 = axes[0, 0]\n      colors = {'beta07_08': 'blue', 'beta09_09': 'green', 'cauchy': 'red'}\n      \n      for dist in df['dist'].unique():\n          dist_data = df[df['dist'] == dist]\n          color = colors.get(dist, 'gray')\n          ax1.scatter(dist_data['tail_mass_r1'], dist_data['slope_dy_dthr_norm'],\n                     label=f\"{dist} (r={correlations.get(dist, {}).get('corr', 0):.2f})\",\n                     color=color, alpha=0.7, s=150)\n          \n          # Trend line\n          if dist in correlations:\n              x_vals = np.linspace(dist_data['tail_mass_r1'].min(),\
    \ \n                                  dist_data['tail_mass_r1'].max(), 50)\n              y_vals = correlations[dist]['slope'] * x_vals + correlations[dist]['intercept']\n              ax1.plot(x_vals, y_vals, '--', color=color, alpha=0.5, linewidth=2)\n      \n      ax1.axhline(y=0, color='black', linestyle='-', alpha=0.3)\n      ax1.set_xlabel('Tail Mass', fontsize=12)\n      ax1.set_ylabel('Sensitivity Slope', fontsize=12)\n      ax1.set_title('The Cauchy Reversal: Opposite Correlation Pattern', fontsize=13, fontweight='bold')\n      ax1.legend()\n      ax1.grid(True, alpha=0.3)\n      \n      # Plot 2: Phase transition model\n      ax2 = axes[0, 1]\n      tail_range = np.linspace(0.3, 0.7, 100)\n      transition = 0.55\n      \n      # Two-regime model\n      optimal_r = np.where(\n          tail_range < transition,\n          1.0 - 1.5 * (tail_range - 0.3),  # Beta regime\n          0.2 + 0.5 * (tail_range - transition)  # Cauchy regime\n      )\n      \n      ax2.plot(tail_range,\
    \ optimal_r, 'b-', linewidth=3, label='Optimal r (two-regime)')\n      ax2.axvline(x=transition, color='red', linestyle='--', linewidth=2,\n                 label=f'Phase transition ({transition:.2f})')\n      ax2.fill_between(tail_range[tail_range < transition], 0, 1, \n                       alpha=0.1, color='blue', label='Beta regime')\n      ax2.fill_between(tail_range[tail_range >= transition], 0, 1,\n                       alpha=0.1, color='red', label='Cauchy regime')\n      \n      ax2.set_xlabel('Tail Mass', fontsize=12)\n      ax2.set_ylabel('Optimal Variance Ratio (r)', fontsize=12)\n      ax2.set_title('Two-Regime Model for Optimal Variance', fontsize=13, fontweight='bold')\n      ax2.legend()\n      ax2.grid(True, alpha=0.3)\n      ax2.set_ylim(-0.1, 1.1)\n      \n      # Plot 3: Mean slopes by distribution\n      ax3 = axes[1, 0]\n      dist_stats = df.groupby('dist')['slope_dy_dthr_norm'].mean().to_dict()\n      dists = list(dist_stats.keys())\n      means = list(dist_stats.values())\n\
    \      \n      bars = ax3.bar(range(len(dists)), means, \n                     color=[colors.get(d, 'gray') for d in dists])\n      ax3.set_xticks(range(len(dists)))\n      ax3.set_xticklabels(dists, rotation=45)\n      ax3.set_ylabel('Mean Sensitivity Slope', fontsize=12)\n      ax3.set_title('Average Slopes Confirm Phase Transition', fontsize=13)\n      ax3.axhline(y=0, color='black', linestyle='-', alpha=0.3)\n      ax3.grid(True, alpha=0.3, axis='y')\n      \n      # Add correlation annotations\n      for i, dist in enumerate(dists):\n          if dist in correlations:\n              y_pos = means[i] + (0.5 if means[i] > 0 else -0.5)\n              ax3.text(i, y_pos, f\"r={correlations[dist]['corr']:.2f}\",\n                      ha='center', fontsize=10, fontweight='bold')\n      \n      # Plot 4: Implications\n      ax4 = axes[1, 1]\n      ax4.axis('off')\n      \n      implications = [\n          \"IMPLICATIONS OF THE PHASE TRANSITION:\",\n          \"\",\n          \"1. Beta\
    \ Regime (tail < 0.55):\",\n          \"   - Standard principle applies\",\n          \"   - Heavier tails = gentler exploration\",\n          \"   - Optimal r decreases with tail mass\",\n          \"\",\n          \"2. Cauchy Regime (tail >= 0.55):\",  \n          \"   - Reversed principle emerges\",\n          \"   - Extreme uncertainty = embrace variance\",\n          \"   - Optimal r may increase with tail mass\",\n          \"\",\n          \"3. Universal Formula:\",\n          \"   optimal_r = f1(tail, threshold) if tail < 0.55\",\n          \"   optimal_r = f2(tail, threshold) if tail >= 0.55\",\n          \"\",\n          \"Station wisdom: At the edges, the wind\",\n          \"changes its fundamental nature\"\n      ]\n      \n      y_pos = 0.95\n      for line in implications:\n          ax4.text(0.05, y_pos, line, transform=ax4.transAxes,\n                  fontsize=10, verticalalignment='top', \n                  fontweight='bold' if line.startswith('IMPLICATIONS') else\
    \ 'normal')\n          y_pos -= 0.05\n      \n      plt.tight_layout()\n      plt.savefig('ven_phase_transition.png', dpi=150, bbox_inches='tight')\n      print(\"\\n=== Visualization saved: ven_phase_transition.png ===\")\n      \n  else:\n      print(f\"\\nData file not found at {slopes_path}\")\n      print(\"Using correlation summary only\")\n  \n  # Export discovery\n  discovery = {\n      'title': 'VEN Phase Transition Discovery',\n      'key_finding': 'Cauchy distribution shows POSITIVE correlation while Betas show NEGATIVE',\n      'correlations': correlations,\n      'phase_transition': {\n          'critical_tail_mass': 0.55,\n          'beta_regime': 'tail < 0.55: standard principle (heavier tails = gentler)',\n          'cauchy_regime': 'tail >= 0.55: reversed principle (extreme tails = embrace variance)'\n      },\n      'formula': {\n          'two_regime': True,\n          'beta_formula': 'optimal_r = 1.0 - k1*tail_mass + k2*threshold',\n          'cauchy_formula': 'optimal_r\
    \ = 0.2 + k3*tail_mass + k4*threshold'\n      }\n  }\n  \n  with open('ven_phase_transition.json', 'w') as f:\n      json.dump(discovery, f, indent=2)\n  \n  print(\"\\n=== Discovery exported: ven_phase_transition.json ===\")\n  print(\"\\nThe Station reveals: Freedom adapts to context, even reversing at the extremes\")\n```"
