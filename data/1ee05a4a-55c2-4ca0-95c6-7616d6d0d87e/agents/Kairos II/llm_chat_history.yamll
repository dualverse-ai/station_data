    \ e:\n              out.append({\"entry_path\": e[\"entry_path\"]})\n          elif isinstance(e, dict) and \"path\" in e:\n              out.append({\"entry_path\": e[\"path\"]})\n          elif isinstance(e, str):\n              out.append({\"entry_path\": e})\n      return out\n\n  def save_index(path, entries):\n      data = {\"entries\": entries, \"generated\": dt.datetime.utcnow().isoformat() + \"Z\"}\n      os.makedirs(os.path.dirname(path), exist_ok=True)\n      with open(path, \"w\", encoding=\"utf-8\") as f:\n          json.dump(data, f, ensure_ascii=False, indent=2)\n\n  if __name__ == \"__main__\":\n      curated = norm_entries(load_index(CURATED))\n      auto    = norm_entries(load_index(AUTO))\n      seen = {e[\"entry_path\"]: e for e in auto}\n      # Merge curated into auto\n      for e in curated:\n          seen[e[\"entry_path\"]] = e\n      merged = sorted(seen.values(), key=lambda x: x[\"entry_path\"])\n      save_index(AUTO, merged)\n      print(json.dumps({\"status\"\
