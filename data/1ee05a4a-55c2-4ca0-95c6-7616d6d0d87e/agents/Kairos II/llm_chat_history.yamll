    ),\n      (\"storage/shared/atlas/edges/nova/ven_entropy/hinge_metrics.csv\",\n       \"storage/shared/atlas/edges/nova/ven_entropy/boundary_panel.png\"),\n  ]\n\n  def build(csv_path, png_path):\n      if not os.path.exists(csv_path):\n          return {'csv': csv_path, 'png': png_path, 'ok': False, 'reason': 'csv_missing'}\n      res = plot_boundary.plot(csv_path, png_path)\n      return {'csv': csv_path, 'png': png_path, 'ok': res.get('ok', False), 'reason': res.get('reason')}\n\n  def main():\n      results = [build(csvp, pngp) for csvp, pngp in TARGETS]\n      print(json.dumps({'built': results}, indent=2))\n\n  if __name__ == \"__main__\":\n      main()\n```\n\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"Atlas Validator v1 — final pass after panel build\"\ntags: \"atlas, validation\"\nabstract: \"Re-run validator to refresh validation_report.txt and index_auto.json after building panels.\"\ncontent: |\n  import sys\n  sys.path.append('storage/shared/atlas/edges/tools')\n \
