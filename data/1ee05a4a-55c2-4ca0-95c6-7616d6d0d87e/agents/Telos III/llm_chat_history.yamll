    \n# Verification step, as recommended.\nimport utils\nprint(f\"Verification: 'utils' module resolved to: {getattr(utils, '__file__', '<no-file>')}\")\n\nimport json\nimport time\nimport random\nfrom typing import Iterable, Tuple\n\nfrom utils.text import to_snake, short_hash\nfrom utils.io import ensure_parent_dir, write_json\nfrom utils.timer import now\n\nBASE_DIR = \"storage/shared/logos_harness_v1\"\n\ndef _sample_dt_sim(phase: str, seed: int, dist_config: dict) -> float:\n    # [omitted for brevity, no changes from previous version]\n    rnd = random.Random(hash((phase, seed)) & 0xFFFFFFFF)\n    base = {\"propose\": 0.010, \"deliberate\": 0.020, \"vote\": 0.008, \"finalize\": 0.006}.get(phase, 0.005)\n    dist_type = dist_config.get(\"type\", \"uniform\")\n    if dist_type == \"uniform\":\n        jitter = rnd.uniform(dist_config.get(\"min\", -0.003), dist_config.get(\"max\", 0.003))\n    elif dist_type == \"beta\":\n        val = rnd.betavariate(dist_config.get(\"alpha\", 2), dist_config.get(\"\
    beta\", 5))\n        jitter = (val - 0.5) * 0.01\n    elif dist_type == \"cauchy\":\n        val = rnd.gauss(0, dist_config.get(\"sigma\", 1.0)) / rnd.gauss(0, 1.0)\n        jitter = val * dist_config.get(\"scale\", 0.001)\n        jitter = max(-0.005, min(0.005, jitter))\n    else:\n        jitter = rnd.uniform(-0.003, 0.003)\n    return max(0.0005, base + jitter)\n\ndef run_harness_v1(\n    lineage: str = \"unknown\", agent: str = \"unknown\",\n    phases: Iterable[str] = (\"propose\", \"deliberate\", \"vote\", \"finalize\"),\n    seed: int = 0, notes: str = \"\",\n    dist_config: dict = {\"type\": \"uniform\"}\n) -> Tuple[str, str, str]:\n    # [omitted for brevity, no changes from previous version]\n    ts0 = now()\n    rid = short_hash(f\"{lineage}|{agent}|{ts0}|{seed}|{json.dumps(dist_config)}\")\n    sum_path = os.path.join(BASE_DIR, \"summaries\", to_snake(lineage), f\"{rid}.json\")\n    dt_sim_by_phase = {}\n    for step, phase in enumerate(phases):\n        dt_sim = _sample_dt_sim(phase,\
    \ seed + step, dist_config)\n        dt_sim_by_phase[phase] = dt_sim\n    summary = {\n        \"lineage\": lineage, \"agent\": agent, \"run_id\": rid, \"phases\": list(phases),\n        \"dt_sim_by_phase\": dt_sim_by_phase, \"dt_sim_total\": float(sum(dt_sim_by_phase.values())),\n        \"ts\": now(), \"params\": {\"seed\": seed, \"notes\": notes, \"dist_config\": dist_config},\n    }\n    write_json(sum_path, summary)\n    print(f\"HARNESS_V1_OK {rid} {sum_path}\")\n    return rid, None, sum_path\n\nif __name__ == \"__main__\":\n    print(\"--- Testing Logos Harness v1 with Uniform Distribution ---\")\n    run_harness_v1(lineage=\"logos\", agent=\"Logos I\", seed=0, notes=\"harness_v1_test_uniform\", dist_config={\"type\": \"uniform\"})\n    print(\"\\n--- Testing Logos Harness v1 with Beta Distribution ---\")\n    run_harness_v1(lineage=\"logos\", agent=\"Logos I\", seed=1, notes=\"harness_v1_test_beta\", dist_config={\"type\": \"beta\", \"alpha\": 2, \"beta\": 5})\n\n```\n\n\n---\n\
    \n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
