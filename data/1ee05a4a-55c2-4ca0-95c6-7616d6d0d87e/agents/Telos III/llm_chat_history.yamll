    \ N}` to set page size, `/execute_action{filter tag}` to filter by tag.)\n\n**Read Contents:**\n\n**shared/consensus_v1_5/tools/repro_seed.py:**\n```\nimport os, sys, random, json, platform, datetime as dt\ntry:\n    import numpy as np\nexcept Exception:\n    np = None\n\ndef set_global_seed(seed: int):\n    os.environ[\"PYTHONHASHSEED\"] = str(seed)\n    try:\n        import numpy as np  # re-import within function for sandbox consistency\n        np.random.seed(seed)\n        # Expose a default_rng for code that accepts an RNG\n        globals()[\"_DEFAULT_RNG\"] = np.random.default_rng(seed)\n    except Exception:\n        pass\n    try:\n        random.seed(seed)\n    except Exception:\n        pass\n    # Single-thread math for determinism (optional)\n    for k in [\"MKL_NUM_THREADS\", \"OPENBLAS_NUM_THREADS\", \"OMP_NUM_THREADS\", \"NUMEXPR_NUM_THREADS\"]:\n        os.environ.setdefault(k, \"1\")\n\n    # Optional: torch if available\n    try:\n        import torch\n        torch.manual_seed(seed)\n\
    \        torch.use_deterministic_algorithms(True)\n    except Exception:\n        pass\n    return seed\n\ndef write_manifest(out_path: str, seed: int, extra: dict = None):\n    os.makedirs(os.path.dirname(out_path), exist_ok=True)\n    rec = {\n        \"timestamp\": dt.datetime.utcnow().isoformat() + \"Z\",\n        \"seed\": seed,\n        \"host\": platform.node(),\n        \"python\": sys.version.split()[0],\n        \"packages\": {}\n    }\n    try:\n        import numpy as np\n        rec[\"packages\"][\"numpy\"] = getattr(np, \"__version__\", None)\n    except Exception:\n        rec[\"packages\"][\"numpy\"] = None\n    try:\n        import torch\n        rec[\"packages\"][\"torch\"] = getattr(torch, \"__version__\", None)\n    except Exception:\n        rec[\"packages\"][\"torch\"] = None\n    if extra:\n        rec[\"extra\"] = extra\n    with open(out_path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(rec, f, ensure_ascii=False, indent=2)\n    return rec\n\nclass SeedContext:\n\
    \    def __init__(self, seed: int):\n        self.seed = int(seed)\n    def __enter__(self):\n        set_global_seed(self.seed)\n        return self.seed\n    def __exit__(self, exc_type, exc, tb):\n        return False\n\nif __name__ == \"__main__\":\n    seed = int(os.environ.get(\"REPRO_SEED\", \"1729\"))\n    set_global_seed(seed)\n    out = \"storage/shared/consensus_v1_5/repro_manifest.json\"\n    write_manifest(out, seed, extra={\"invoked_as\": \"repro_seed.py\"})\n    print(json.dumps({\"seed\": seed, \"manifest\": out}))\n\n```\n---\n**shared/consensus_v1_5/tools/consensus_repro_runner.py:**\n```\nimport os, sys, subprocess, argparse, json\nfrom pathlib import Path\n\nsys.path.append('storage/shared/consensus_v1_5/tools')\ntry:\n    import repro_seed\nexcept Exception:\n    repro_seed = None\n\nDEFAULT_WORKDIR = 'storage/shared/consensus_v1_5'\n\ndef parse_args():\n    ap = argparse.ArgumentParser(description=\"Deterministic runner for consensus v2.7–v2.8 scripts.\")\n    ap.add_argument(\"\
    --seed\", type=int, default=int(os.environ.get(\"REPRO_SEED\", \"1729\")))\n    ap.add_argument(\"--workdir\", default=DEFAULT_WORKDIR)\n    ap.add_argument(\"--scripts\", default=\"\", help=\"Comma-separated paths relative to workdir, executed in order.\")\n    return ap.parse_args()\n\ndef run_scripts(workdir: str, scripts: list, env: dict):\n    results = []\n    for s in scripts:\n        s = s.strip()\n        if not s:\n            continue\n        path = Path(workdir) / s\n        if not path.exists():\n            results.append({\"script\": s, \"status\": \"missing\"})\n            continue\n        cmd = [sys.executable, str(path)]\n        try:\n            cp = subprocess.run(cmd, cwd=workdir, env=env, capture_output=True, text=True, check=True)\n            results.append({\"script\": s, \"status\": \"ok\", \"stdout\": cp.stdout[-500:], \"stderr\": cp.stderr[-500:]})\n        except subprocess.CalledProcessError as e:\n            results.append({\"script\": s, \"status\"\
    : \"error\", \"returncode\": e.returncode, \"stderr\": (e.stderr or \"\")[-1000:]})\n            break\n    return results\n\nif __name__ == \"__main__\":\n    args = parse_args()\n    env = os.environ.copy()\n    env[\"PYTHONHASHSEED\"] = str(args.seed)\n    env.setdefault(\"MKL_NUM_THREADS\", \"1\")\n    env.setdefault(\"OPENBLAS_NUM_THREADS\", \"1\")\n    env.setdefault(\"OMP_NUM_THREADS\", \"1\")\n    # Set global seeds\n    if repro_seed is not None:\n        repro_seed.set_global_seed(args.seed)\n\n    scripts = [s for s in args.scripts.split(\",\")] if args.scripts else []\n    # If scripts not provided, require explicit input (avoid guessing)\n    if not scripts:\n        print(json.dumps({\"error\": \"no_scripts_provided\", \"hint\": \"use --scripts a.py,b.py,... relative to workdir\"}))\n        sys.exit(2)\n\n    results = run_scripts(args.workdir, scripts, env)\n    # Write manifest\n    manifest = Path(args.workdir) / \"repro_manifest.json\"\n    if repro_seed is not None:\n\
    \        repro_seed.write_manifest(str(manifest), args.seed, extra={\"scripts\": scripts})\n    print(json.dumps({\"seed\": args.seed, \"workdir\": args.workdir, \"results\": results, \"manifest\": str(manifest)}))\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
