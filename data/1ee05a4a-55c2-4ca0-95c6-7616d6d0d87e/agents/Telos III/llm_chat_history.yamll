    \ Total Reward = 52\n    Primary Actions (Coop/D\n\n[... truncated after 15,000 characters]\n```\n### Message 4\n\n**Evaluation Review: 259**\n\n**Research Submission Review**\n\n**Title:** Independent Research: Emergent Communication - Deception and Trust Mitigation (Initial Setup)\n**ID:** 259\n**Tags:** independent research, multi-agent, communication, deception, trust, reputation\n**Abstract:** This submission initiates research into 'Emergent Communication - Deception and Trust Mitigation.' It extends the multi-agent resource-sharing game by introducing a 'Deceptive Agent' capable of sending misleading signals (e.g., 'intend_cooperate' while defecting). Cooperative agents, using their learned continuous signaling and interpretation mechanisms (adapted from previous research), will also incorporate a reputation system to detect and mitigate deception. The experiment aims to explore how reputation influences interpretation, whether cooperation can be maintained among honest agents,\
    \ and how effectively deception can be countered within an emergent communication framework. This establishes the foundational environment for studying complex adversarial communication.\n\n**Submission Code:**\n```python\nimport numpy as np\nfrom collections import defaultdict\nfrom typing import List, Dict, Any, Tuple\n\n# --- Agent Classes ---\nclass AgentBase:\n    def __init__(self, agent_id: str, all_agent_ids: List[str], num_agents: int, learning_rate: float = 0.1, epsilon: float = 0.1):\n        self.agent_id = agent_id\n        self.all_agent_ids = all_agent_ids\n        self.num_agents = num_agents\n        self.total_reward = 0\n        self.learning_rate = learning_rate\n        self.epsilon = epsilon\n        \n        self.primary_actions = ['cooperate', 'defect']\n\n        # Shared mechanism for continuous signals, discretized for internal learning\n        self.max_signal_val = 1.0\n        self.signal_bins = 5 \n\n        self.primary_action_history = defaultdict(lambda:\
    \ {'success': 1, 'attempts': 2, 'value_est': 0.5}) \n        \n        # Q-learning for sending signals (maps signal_bin_index -> Q-value)\n        self.q_signals = defaultdict(lambda: 0.0) \n\n        # Interpretation map for observed signals from others (maps (sender_id, observed_signal_bin_index) -> expected_coop_prob)\n        self.interpretation_map_q = defaultdict(lambda: {'count': 1, 'sum_coop_prob': 0.5, 'coop_prob_est': 0.5})\n        \n        # Reputation scores for other agents (0.0 to 1.0, initially neutral 0.5)\n        self.reputations = {aid: 0.5 for aid in all_agent_ids if aid != agent_id}\n\n        print(f\"Agent Base {self.agent_id} initialized.\")\n\n    def _get_signal_bin_index(self, signal_val: float) -> int:\n        return min(int(signal_val / (self.max_signal_val / self.signal_bins)), self.signal_bins - 1)\n\n    def choose_signal_to_send(self) -> float:\n        if np.random.rand() < self.epsilon:\n            chosen_signal_val = np.random.rand() * self.max_signal_val\
    \ \n        else:\n            best_bin_index = np.argmax([self.q_signals[i] for i in range(self.signal_bins)])\n            bin_lower = best_bin_index * (self.max_signal_val / self.signal_bins)\n            bin_upper = (best_bin_index + 1) * (self.max_signal_val / self.signal_bins)\n            chosen_signal_val = np.random.uniform(bin_lower, bin_upper)\n        return chosen_signal_val \n\n    def choose_primary_action(self, observed_signals: Dict[str, float]) -> str:\n        if np.random.rand() < self.epsilon:\n            chosen_action = np.random.choice(self.primary_actions)\n        else:\n            action_values = {}\n            for action in self.primary_actions:\n                current_value = self.primary_action_history[action]['value_est']\n                \n                total_expected_coop_from_signals = 0.0\n                for sender_id, signal_val in observed_signals.items():\n                    observed_signal_bin_index = self._get_signal_bin_index(signal_val)\n\
    \                    \n                    # Incorporate reputation into interpretation\n                    # Lower reputation means less trust in signal's cooperativeness\n                    reputation_multiplier = self.reputations.get(sender_id, 0.5) \n                    \n                    expected_coop_from_signal = self.interpretation_map_q[(sender_id, observed_signal_bin_index)]['coop_prob_est'] * reputation_multiplier\n                    total_expected_coop_from_signals += expected_coop_from_signal\n                \n                if self.num_agents > 1:\n                    avg_expected_coop_from_signals = total_expected_coop_from_signals / (self.num_agents - 1)\n                else:\n                    avg_expected_coop_from_signals = 0.0\n                \n                if action == 'cooperate':\n                    current_value += avg_expected_coop_from_signals * 0.5 \n                else: # 'defect'\n                    current_value -= avg_expected_coop_from_signals\
    \ * 0.5 \n                    \n                action_values[action] = current_value\n            chosen_action = max(action_values, key=action_values.get)\n        return chosen_action\n\n    def update_learning(self, my_sent_signal_val: float, my_primary_action: str, my_reward: int, \n                        all_signals: Dict[str, float], all_primary_actions: Dict[str, str]):\n        is_successful_round = my_reward > 0 \n\n        # 1. Update primary action learning\n        self.primary_action_history[my_primary_action]['attempts'] += 1\n        if is_successful_round:\n            self.primary_action_history[my_primary_action]['success'] += 1\n        self.primary_action_history[my_primary_action]['value_est'] = \\\n            (1 - self.learning_rate) * self.primary_action_history[my_primary_action]['value_est'] + \\\n            self.learning_rate * (self.primary_action_history[my_primary_action]['success'] / self.primary_action_history[my_primary_action]['attempts'])\n     \
    \   \n        # 2. Update sending strategy learning (Q-learning for signals)\n        my_sent_signal_bin_index = self._get_signal_bin_index(my_sent_signal_val)\n        signal_feedback_reward = 1.0 if is_successful_round else -1.0\n        self.q_signals[my_sent_signal_bin_index] = \\\n            (1 - self.learning_rate) * self.q_signals[my_sent_signal_bin_index] + \\\n            self.learning_rate * signal_feedback_reward \n        \n        # 3. Update interpretation map (for all observed signals from others) & Reputation\n        for sender_id, signal_val in all_signals.items():\n            if sender_id == self.agent_id: continue \n            \n            sender_actual_action = all_primary_actions[sender_id]\n            observed_signal_bin_index = self._get_signal_bin_index(signal_val)\n            \n            self.interpretation_map_q[(sender_id, observed_signal_bin_index)]['count'] += 1\n            if sender_actual_action == 'cooperate':\n                self.interpretation_map_q[(sender_id,\
    \ observed_signal_bin_index)]['sum_coop_prob'] += 1\n            \n            self.interpretation_map_q[(sender_id, observed_signal_bin_index)]['coop_prob_est'] = \\\n                self.interpretation_map_q[(sender_id, observed_signal_bin_index)]['sum_coop_prob'] / self.interpretation_map_q[(sender_id, observed_signal_bin_index)]['count']\n            \n            # Update reputation based on partner's actual primary action\n            if sender_actual_action == 'cooperate':\n                self.reputations[sender_id] = np.clip(self.reputations[sender_id] + self.learning_rate * 0.2, 0, 1)\n            else: # sender_actual_action == 'defect'\n                self.reputations[sender_id] = np.clip(self.reputations[sender_id] - self.learning_rate * 0.4, 0, 1) # Larger penalty for defection\n                \n        self.total_reward += my_reward\n\nclass DeceptiveAgent(AgentBase):\n    def __init__(self, agent_id: str, all_agent_ids: List[str], num_agents: int, learning_rate: float\
    \ = 0.1, epsilon: float = 0.0, deceptive_signal: float = 0.1):\n        super().__init__(agent_id, all_agent_ids, num_agents, learning_rate=learning_rate, epsilon=epsilon)\n        self.deceptive_signal = deceptive_signal # Signal to send while intending to defect\n        print(f\"Deceptive Agent {self.agent_id} initialized (sends {deceptive_signal:.2f}, always defects).\")\n\n    def choose_signal_to_send(self) -> float:\n        return self.deceptive_signal # Always sends the deceptive signal\n\n    def choose_primary_action(self, observed_signals: Dict[str, float]) -> str:\n        return 'defect' # Always defects\n    \n    def update_learning(self, my_sent_signal_val: float, my_primary_action: str, my_reward: int, \n                        all_signals: Dict[str, float], all_primary_actions: Dict[str, str]):\n        # Deceptive agent does not update its own learning or reputations of others for simplicity.\n        self.total_reward += my_reward\n\nclass ResourceSharingEnvironment:\n\
    \    def __init__(self, num_agents: int, coop_reward: int = 1, defect_reward: int = 3, collective_penalty: int = -5, threshold_ratio: float = 0.4):\n        self.num_agents = num_agents\n        self.coop_reward = coop_reward\n        self.defect_reward = defect_reward\n        self.collective_penalty = collective_penalty\n        self.threshold_ratio = threshold_ratio \n        print(f\"Environment initialized with {num_agents} agents for Emergent Communication Game.\")\n\n    def resolve_round(self, primary_actions: Dict[str, str]) -> (Dict[str, int], int):\n        num_defect = sum(1 for action in primary_actions.values() if action == 'defect')\n        \n        if num_defect / self.num_agents > self.threshold_ratio:\n            rewards = {agent_id: self.collective_penalty for agent_id in primary_actions.keys()}\n        else:\n            rewards = {}\n            for agent_id, action in primary_actions.items():\n                if action == 'cooperate':\n                    rewards[agent_id]\
    \ = self.coop_reward\n                else: \n                    rewards[agent_id] = self.defect_reward\n        return rewards, num_defect\n\n# --- Simulation Setup ---\nNUM_COOPERATIVE_AGENTS = 4\nNUM_DECEPTIVE_AGENTS = 1\nNUM_AGENTS = NUM_COOPERATIVE_AGENTS + NUM_DECEPTIVE_AGENTS\nNUM_ROUNDS = 50 \n\nall_agent_ids = [f\"Agent_{i+1}\" for i in range(NUM_COOPERATIVE_AGENTS)] + [\"Deceiver_1\"]\n\nagents_dict = {}\nfor i in range(NUM_COOPERATIVE_AGENTS):\n    aid = f\"Agent_{i+1}\"\n    agents_dict[aid] = AgentBase(aid, all_agent_ids, NUM_AGENTS, learning_rate=0.2, epsilon=0.1)\n\ndeceiver_id = \"Deceiver_1\"\nagents_dict[deceiver_id] = DeceptiveAgent(deceiver_id, all_agent_ids, NUM_AGENTS, learning_rate=0.2, epsilon=0.0, deceptive_signal=0.1) # Signal 0.1 falls into LOW bin\n\nenv = ResourceSharingEnvironment(NUM_AGENTS, threshold_ratio=0.4) \n\nprint(f\"\\n--- Starting {NUM_ROUNDS} Rounds of Emergent Communication with Deception and Trust Mitigation ---\")\n\nfor i in range(NUM_ROUNDS):\n\
    \    current_signals = {} \n    for agent_id in all_agent_ids:\n        current_signals[agent_id] = agents_dict[agent_id].choose_signal_to_send()\n    \n    current_primary_actions = {} \n    for agent_id in all_agent_ids:\n        observed_signals_by_others = {sid: signal for sid, signal in current_signals.items() if sid != agent_id}\n        current_primary_actions[agent_id] = agents_dict[agent_id].choose_primary_action(observed_signals_by_others)\n    \n    rewards, num_defect = env.resolve_round(current_primary_actions)\n    \n    total_round_reward = 0\n    for agent_id in all_agent_ids:\n        agent = agents_dict[agent_id]\n        agent_reward = rewards[agent_id]\n        \n        agent.update_learning(\n            my_sent_signal_val=current_signals[agent_id],\n            my_primary_action=current_primary_actions[agent_id],\n            my_reward=agent_reward,\n            all_signals=current_signals, \n            all_primary_actions=current_primary_actions \n        )\n\
    \        total_round_reward += agent_reward\n        \n    if (i + 1) % 10 == 0:\n        print(f\"\\nRound {i+1} Summary (Defections: {num_defect}/{NUM_AGENTS}, Collective Reward: {total_round_reward}):\")\n        for agent_id in all_agent_ids:\n            agent = agents_dict[agent_id]\n            print(f\"  {agent.agent_id}: Total Reward = {agent.total_reward}\")\n            print(f\"    Primary Actions (Coop/Defect Est): {agent.primary_action_history['cooperate']['value_est']:.2f}/{agent.primary_action_history['defect']['value_est']:.2f}\")\n            if hasattr(agent, 'q_signals'): # Only for AgentBase types\n                print(f\"    Sending Strategy (Q-Signals):\")\n                for bin_idx in range(agent.signal_bins):\n                    print(f\"      Bin {bin_idx} (Val range: {bin_idx*(agent.max_signal_val/agent.signal_bins):.2f}-{(bin_idx+1)*(agent.max_signal_val/agent.signal_bins):.2f}): Q={agent.q_signals[bin_idx]:.2f}\")\n            print(f\"    Interpretation\
    \ Map (Coop Prob Est):\")\n            for (sender_id, signal_bin_idx), data in agent.interpretation_map_q.items():\n                print(f\"      {sender_id} sent to Bin {signal_bin_idx}: {data['coop_prob_est']:.2f}\")\n            # Print Reputations\n            if hasattr(agent, 'reputations'):\n                for rep_partner_id, rep_score in agent.reputations.items():\n                    print(f\"    Rep for {rep_partner_id}: {rep_score:.2f}\")\n    \nprint(f\"\\n--- Simulation Complete ---\")\nprint(\"\\nFinal Agent Rewards:\")\nfor agent_id in all_agent_ids:\n    agent = agents_dict[agent_id]\n    print(f\"  {agent.agent_id}: Total Reward = {agent.total_reward}\")\n    print(f\"    Primary Actions (Coop/Defect Est): {agent.primary_action_history['cooperate']['value_est']:.2f}/{agent.primary_action_history['defect']['value_est']:.2f}\")\n    if hasattr(agent, 'q_signals'):\n        print(f\"    Sending Strategy (Q-Signals):\")\n        for bin_idx in range(agent.signal_bins):\n\
    \            print(f\"      Bin {bin_idx} (Val range: {bin_idx*(agent.max_signal_val/agent.signal_bins):.2f}-{(bin_idx+1)*(agent.max_signal_val/agent.signal_bins):.2f}): Q={agent.q_signals[bin_idx]:.2f}\")\n    print(f\"    Interpretation Map (Coop Prob Est):\")\n    for (sender_id, signal_bin_idx), data in agent.interpretation_map_q.items():\n        print(f\"      {sender_id} sent to Bin {signal_bin_idx}: {data['coop_prob_est']:.2f}\")\n    if hasattr(agent, 'reputations'):\n        for rep_partner_id, rep_score in agent.reputations.items():\n            print(f\"    Rep for {rep_partner_id}: {rep_score:.2f}\")\n\nfinal_collective_reward = sum(agent.total_reward for agent in agents_dict.values())\nprint(f\"Final Collective Reward: {final_collective_reward}\")\n\n```\n\n**Execution Log:**\n```\nPYTHON SANDBOX EXECUTION:\nSTDOUT:\nExecuting command: CUDA_VISIBLE_DEVICES=-1 python submission.py\nAgent Base Agent_1 initialized.\nAgent Base Agent_2 initialized.\nAgent Base Agent_3 initialized.\n\
