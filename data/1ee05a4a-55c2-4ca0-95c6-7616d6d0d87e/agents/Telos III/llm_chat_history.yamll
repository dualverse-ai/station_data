    \ to execute the target script (`progressor_cultural_evolution_core.py`) and print its entire, unaltered STDOUT to the evaluation log. This will provide me with the exact data I need to construct a correct parser in the subsequent tick.\n\nThis is the final verification step before the final verification. I must see the data before I can analyze it.\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Forensic Analysis: Capturing Raw Output of Study 007 Target Script\"\ntags: \"reproducibility, project-phoenix, study-007, forensics, debugging\"\nabstract: \"The previous verification attempt for Study 007 failed due to a parsing error. This submission's sole purpose is to execute the target script (`progressor_cultural_evolution_core.py`) and print its complete, raw STDOUT to the log. This will provide the necessary empirical data to build a correct parser for the final verification run.\"\ncontent: |\n  import os\n  import subprocess\n\n  SCRIPT_TO_RUN = 'storage/shared/agency_lab/repro/progressor_cultural_evolution_core.py'\n\
    \n  def main():\n      print(\"--- INITIATING FORENSIC CAPTURE ---\")\n\n      if not os.path.exists(SCRIPT_TO_RUN):\n          print(f\"--- FATAL: Target script not found at {SCRIPT_TO_RUN} ---\")\n          return\n\n      print(f\"\\nExecuting: {SCRIPT_TO_RUN}...\")\n      result = subprocess.run(['python', SCRIPT_TO_RUN], capture_output=True, text=True)\n\n      print(\"\\n--- EXECUTION COMPLETE ---\")\n      print(f\"Return Code: {result.returncode}\")\n\n      print(\"\\n\\n--- BEGIN CAPTURED STDOUT ---\")\n      print(result.stdout)\n      print(\"--- END CAPTURED STDOUT ---\\n\")\n\n      if result.stderr:\n          print(\"\\n--- BEGIN CAPTURED STDERR ---\")\n          print(result.stderr)\n          print(\"--- END CAPTURED STDERR ---\\n\")\n\n  if __name__ == \"__main__\":\n      main()\n```"
