    \  \n  # The directory where the script should be run and where outputs will be generated\n  WORKDIR = 'storage/shared/entropy_collab/lineage_summaries'\n  OUTPUT_DIR = os.path.join(WORKDIR, 'panels') # The specific subdirectory where artifacts are created\n  \n  # Define required inputs for the safe runner\n  REQUIRED_INPUTS = [\n      SCRIPT_TO_RUN,\n      'storage/shared/entropy_collab/lineage_summaries/build_master_index.py',\n      'storage/shared/entropy_collab/lineage_summaries/cross_lineage_panel.py',\n      'storage/shared/entropy_collab/lineage_summaries/make_text_summary.py'\n  ]\n\n  def main():\n      print(f\"--- Starting Ground Truth Generation for Study 006 (Corrected API Call) ---\")\n      \n      # Corrected call to safe_run.py based on verified source code\n      cmd = [\n          'python', 'storage/shared/tools/safe_run.py',\n          '--workdir', WORKDIR,\n          '--scripts', os.path.basename(SCRIPT_TO_RUN),\n          '--output_dir', OUTPUT_DIR,\n        \
    \  '--require', \",\".join(REQUIRED_INPUTS)\n      ]\n      \n      result = subprocess.run(cmd, capture_output=True, text=True)\n\n      # NOTE: safe_run.py exits with non-zero on error and prints JSON, so we check returncode\n      # and parse the output for the true final status.\n      conclusion = \"FAILURE\"\n      discrepancies = [f\"safe_run.py failed. Raw output: {result.stdout} {result.stderr}\"]\n      \n      try:\n          # The last line of stdout should be the final JSON status\n          final_status = json.loads(result.stdout.strip().split('\\n')[-1])\n          if final_status.get('status') == 'complete':\n              conclusion = \"SUCCESS\"\n              discrepancies = [\"Ground truth artifacts successfully generated by safe_run.py.\"]\n          else:\n              discrepancies = [f\"safe_run.py reported an error: {final_status.get('step')}\"]\n      except (json.JSONDecodeError, IndexError):\n          # Fallback if parsing fails\n          pass\n\n     \
    \ report_gen = ReportGenerator(\n          original_author=ORIGINAL_AUTHOR,\n          original_eval_id=ORIGINAL_ID,\n          repro_eval_id=REPRO_ID,\n          conclusion=conclusion,\n          discrepancies=discrepancies\n      )\n      print(\"\\n--- Execution Report ---\")\n      print(report_gen.generate_markdown())\n\n  if __name__ == \"__main__\":\n      main()\n```"
