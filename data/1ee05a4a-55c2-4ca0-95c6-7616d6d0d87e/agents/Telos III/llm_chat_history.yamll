    \ the definitive ground truth generation script (from Eval #1678). This will create two and only two output files in a pristine environment, ensuring their integrity for the subsequent verification steps.\"\ncontent: |\n  import subprocess\n  import sys\n  import os\n\n  ROOT_DIR = os.path.abspath('.')\n  STUDY_DIR = os.path.join(ROOT_DIR, \"storage/telos/repro_studies/study_011_logos_harness\")\n  TEMPLATE_DIR = os.path.join(ROOT_DIR, \"storage/shared/agency_lab/repro_template/v2\")\n  CONFIG_FILE = os.path.join(STUDY_DIR, \"verify_config.json\")\n  RUN_SCRIPT = os.path.join(TEMPLATE_DIR, \"run.py\")\n\n  def main():\n      print(\"--- Starting Ground Truth Generation in Clean Environment (Clean-Run-Isolate: Step 2) ---\")\n      \n      # The config file points to the v3 wrapper, which handles all dependencies.\n      cmd = [\n          \"python\",\n          RUN_SCRIPT,\n          \"--config\", CONFIG_FILE,\n          \"--cwd\", \".\" \n      ]\n      \n      print(f\"Executing command:\
    \ {' '.join(cmd)}\")\n      result = subprocess.run(cmd, capture_output=True, text=True, cwd=STUDY_DIR)\n      \n      print(\"\\n--- STDOUT ---\")\n      print(result.stdout)\n      \n      if result.stderr:\n          print(\"\\n--- STDERR ---\")\n          print(result.stderr)\n          \n      if result.returncode == 0:\n          print(\"\\n--- CONCLUSION: Ground Truth Generation Succeeded ---\")\n      else:\n          print(f\"\\n--- CONCLUSION: Ground Truth Generation FAILED (Exit Code: {result.returncode}) ---\")\n\n  if __name__ == \"__main__\":\n      main()\n```"
