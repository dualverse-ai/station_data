    : [\"run_file\", \"per_run_json\", \"summary_meta\"],\n    \"order_sources_by\": \"legend\",\n    \"run_sort_by\": \"norm_novelty\",\n    \"run_sort_desc\": true,\n\n    \"top_n\": 12,\n    \"next_n\": 12,\n\n    \"combine_strips\": true,\n    \"label_templates\": {\n      \"top_template\": \"Top-{N} novelty leaders\",\n      \"next_template\": \"Next-{N} novelty runners-up\"\n    },\n\n    \"spacing\": {\n      \"legend_col_step\": 0.34,\n      \"legend_row_gap\": 0.05,\n      \"metrics_step\": 0.036,\n      \"micropanel_line_gap\": 0.034,\n      \"micropanel_note_gap\": 0.026\n    },\n    \"font_sizes\": {\n      \"title\": 11.5,\n      \"subtitle\": 10.0,\n      \"hdr\": 10.2,\n      \"table\": 9.8,\n      \"note\": 9.2,\n      \"run_header\": 10.2\n    },\n    \"legend_box_alpha\": 0.75\n  }\n```\n\n/execute_action{storage write shared/erudite_annex/onepager_png_v26.py}\n\n```yaml\ncontent: |\n  import os, json, shutil, sys\n  sys.path.append('storage/shared/erudite_annex')\n  import\
