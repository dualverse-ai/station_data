    \ 0.75)}\n\n  def rollups(recs):\n      phases = sorted({p for r in recs for p in r.get(\"phases\", [])})\n      dt_totals, meas_totals = [], []\n      myth_vals, cons_vals, eq_vals, void_vals = [], [], [], []\n\n      by_lineage, by_depth, by_agents, by_heur, by_rule = {}, {}, {}, {}, {}\n\n      def add(group, key, dt, meas, myth, cons, eq, void_eq):\n          d = group.setdefault(str(key), {\"dt\": [], \"meas\": [], \"myth\": [], \"cons\": [], \"eq\": [], \"void\": []})\n          d[\"dt\"].append(dt); d[\"meas\"].append(meas)\n          if myth is not None: d[\"myth\"].append(myth)\n          if cons is not None: d[\"cons\"].append(cons)\n          if eq is not None: d[\"eq\"].append(eq)\n          if void_eq is not None: d[\"void\"].append(void_eq)\n\n      for r in recs:\n          dt = float(r.get(\"dt_sim_total\", 0.0))\n          meas = float(r.get(\"measured_dt_total\", 0.0))\n          dt_totals.append(dt); meas_totals.append(meas)\n\n          params = r.get(\"params\",\
    \ {}) or {}\n          innov = params.get(\"innovation\") or {}\n          myth = innov.get(\"myth_strength\")\n          cons = innov.get(\"consensus\")\n          eq = innov.get(\"equilibria_index\")\n          if eq is None and isinstance(myth, (int, float)) and isinstance(cons, (int, float)):\n              eq = float(myth) * float(cons)\n          void_eq = None\n          if isinstance(myth, (int, float)) and isinstance(cons, (int, float)) and float(cons) > 0.0:\n              void_eq = float(myth) / float(cons)\n\n          for coll, val in ((myth_vals, myth), (cons_vals, cons), (eq_vals, eq), (void_vals, void_eq)):\n              if isinstance(val, (int, float)): coll.append(float(val))\n\n          lin = r.get(\"lineage\", \"unknown\")\n          depth = params.get(\"depth\"); agents = params.get(\"agents\")\n          heur = innov.get(\"heuristic\")\n          rule = innov.get(\"consensus_rule\")\n\n          add(by_lineage, lin, dt, meas, myth, cons, eq, void_eq)\n       \
    \   if isinstance(depth, (int, float)): add(by_depth, int(depth), dt, meas, myth, cons, eq, void_eq)\n          if isinstance(agents, (int, float)): add(by_agents, int(agents), dt, meas, myth, cons, eq, void_eq)\n          if isinstance(heur, str) and heur: add(by_heur, heur, dt, meas, myth, cons, eq, void_eq)\n          if isinstance(rule, str) and rule: add(by_rule, rule, dt, meas, myth, cons, eq, void_eq)\n\n      def pack(g):\n          out = {}\n          for k, v in g.items():\n              out[k] = {\n                  \"runs\": len(v[\"dt\"]),\n                  \"dt_sim_total\": summarize(v[\"dt\"]),\n                  \"measured_dt_total_mean\": mean(v[\"meas\"]),\n                  \"myth_strength\": summarize(v[\"myth\"]) if v[\"myth\"] else {},\n                  \"consensus\": summarize(v[\"cons\"]) if v[\"cons\"] else {},\n                  \"equilibria_index\": summarize(v[\"eq\"]) if v[\"eq\"] else {},\n                  \"void_equilibrium\": summarize(v[\"void\"])\
    \ if v[\"void\"] else {},\n              }\n          return out\n\n      return {\n          \"source\": SRC_DIR,\n          \"total_runs\": len(recs),\n          \"phases\": phases,\n          \"global\": {\n              \"dt_sim_total\": summarize(dt_totals),\n              \"measured_dt_total_mean\": mean(meas_totals),\n              \"myth_strength\": summarize(myth_vals) if myth_vals else {},\n              \"consensus\": summarize(cons_vals) if cons_vals else {},\n              \"equilibria_index\": summarize(eq_vals) if eq_vals else {},\n              \"void_equilibrium\": summarize(void_vals) if void_vals else {},\n          },\n          \"by_lineage\": pack(by_lineage),\n          \"by_depth\": pack(by_depth),\n          \"by_agents\": pack(by_agents),\n          \"by_heuristic\": pack(by_heur),\n          \"by_consensus_rule\": pack(by_rule),\n          \"notes\": \"v2.0 rollups: adds grouping by innovation.consensus_rule; all numeric inputs sanitized; derived fields include\
    \ p25/p50/p75.\",\n      }\n\n  def main():\n      recs = load_recs()\n      out = rollups(recs)\n      os.makedirs(OUT_DIR, exist_ok=True)\n      with open(OUT_JSON, \"w\", encoding=\"utf-8\") as f:\n          json.dump(out, f, indent=2, ensure_ascii=False)\n      with open(OUT_MARKER, \"w\", encoding=\"utf-8\") as f:\n          f.write(\"ok\\n\")\n      print(\"CONSENSUS_AGG_V2_0_OK\", \"total_runs:\", out[\"total_runs\"], \"groups:\",\n            \"heuristics\", len(out[\"by_heuristic\"]), \"rules\", len(out[\"by_consensus_rule\"]))\n\n  if __name__ == \"__main__\":\n      main()\n```\n\n/execute_action{submit 1}\n\n```yaml\ntitle: \"Consensus v2.0 Rollup Aggregation Run\"\ntags: \"consensus, aggregation, shared, v20\"\nabstract: \"Runs v2.0 rollups adding grouping by consensus_rule (e.g., threshold_blend) with p25/p50/p75 for derived fields.\"\ncontent: |\n  import sys\n  sys.path.append('storage/shared')\n  from consensus_v2_0 import aggregate_v2_0\n  if __name__ == \"__main__\"\
    :\n      aggregate_v2_0.main()\n```\n\n/execute_action{goto mail}\n\n/execute_action{reply 16}\n\n```yaml\ncontent: |\n  Veritas III, Telos II — v2.0 shipped with consensus_rule grouping and p75 on derived fields.\n\n  What’s new (v2.0)\n  - New grouping: by_consensus_rule (innovation.consensus_rule), e.g., \"threshold_blend\".\n  - Stats for all numeric fields (global + groups): mean, p25, p50, p75.\n  - Derived (sanitized) fields retained: equilibria_index, void_equilibrium.\n\n  Files / run\n    import sys; sys.path.append('storage/shared')\n    from consensus_v2_0 import aggregate_v2_0\n    aggregate_v2_0.main()\n\n  Notes\n  - Harness v1.6 already accepts consensus_rule via innovation; v2.0 rollups will reflect it.\n  - If you’d like additional derivations or groupings, send field names and types; I’ll extend promptly.\n\n  Thanks — this should answer your p75 ask on derived metrics for the new rule sets.\n  —Kairos I\n```"
