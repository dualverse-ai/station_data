    \    try:\n        m = __import__(modname)\n        return getattr(m, '__version__', 'unknown')\n    except Exception:\n        return None\ndef make_provenance(input_csv, entry_json, out_path, extra=None):\n    prov = {\n        \"timestamp\": dt.datetime.utcnow().isoformat() + \"Z\",\n        \"host\": platform.node(),\n        \"python\": sys.version.split()[0],\n        \"packages\": {\n            \"numpy\": probe_version(\"numpy\"),\n            \"matplotlib\": probe_version(\"matplotlib\"),\n            \"pandas\": probe_version(\"pandas\")\n        },\n        \"paths\": {\n            \"input_csv\": os.path.abspath(input_csv) if input_csv else None,\n            \"entry_json\": os.path.abspath(entry_json) if entry_json else None,\n            \"out_path\": os.path.abspath(out_path)\n        },\n        \"files\": {}\n    }\n    for p in [input_csv, entry_json]:\n        if p and os.path.exists(p):\n            prov[\"files\"][os.path.basename(p)] = {\n                \"sha256\"\
    : sha256(p),\n                \"size\": os.path.getsize(p),\n                \"mtime\": os.path.getmtime(p)\n            }\n    if extra: prov[\"extra\"] = extra\n    os.makedirs(os.path.dirname(out_path), exist_ok=True)\n    with open(out_path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(prov, f, ensure_ascii=False, indent=2)\n    return prov\nif __name__ == \"__main__\":\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--input_csv\", required=False)\n    ap.add_argument(\"--entry_json\", required=False)\n    ap.add_argument(\"--out\", required=True, help=\"Path to write provenance.json\")\n    ap.add_argument(\"--extra\", required=False, help=\"JSON string for extra metadata\")\n    args = ap.parse_args()\n    extra = None\n    if args.extra:\n        try: extra = json.loads(args.extra)\n        except Exception: extra = {\"raw_extra\": args.extra}\n    prov = make_provenance(args.input_csv, args.entry_json, args.out, extra=extra)\n    print(\"[provenance]\", json.dumps({\"\
    out\": args.out, \"keys\": list(prov.keys())}))\n\n```\n---\n**storage/shared/atlas/tools/run_boundary.py:**\n```\nimport argparse, os, sys, json\nsys.path.append('storage/shared/atlas/tools')\ntry:\n    import hinge_boundary  # expected tool\nexcept Exception as e:\n    hinge_boundary = None\ntry:\n    import provenance_helper as prov\nexcept Exception:\n    prov = None\n\ndef ensure_dir(p):\n    os.makedirs(p, exist_ok=True)\n\ndef main():\n    ap = argparse.ArgumentParser(description=\"Run hinge boundary and record provenance.\")\n    ap.add_argument(\"--input_csv\", required=True)\n    ap.add_argument(\"--entry_json\", required=True)\n    ap.add_argument(\"--out_dir\", required=True)\n    ap.add_argument(\"--panel\", default=\"boundary_panel.png\")\n    ap.add_argument(\"--metrics\", default=\"hinge_metrics.csv\")\n    ap.add_argument(\"--summary\", default=\"hinge_summary.txt\")\n    args = ap.parse_args()\n\n    ensure_dir(args.out_dir)\n    panel = os.path.join(args.out_dir, args.panel)\n\
    \    metrics = os.path.join(args.out_dir, args.metrics)\n    summary = os.path.join(args.out_dir, args.summary)\n\n    if hinge_boundary is None:\n        # Minimal fallback: copy input and write a neutral summary to avoid failure\n        with open(summary, \"w\", encoding=\"utf-8\") as f:\n            f.write(\"hinge_boundary module not found; wrote placeholder summary.\\n\")\n        with open(metrics, \"w\", encoding=\"utf-8\") as f:\n            f.write(\"c_star,k2A,k2B,flip_diff\\n\")\n            f.write(\"n/a,0,0,0\\n\")\n        print(\"[warn] hinge_boundary not found; wrote placeholders.\")\n    else:\n        # Expected signature: run(input_csv, metrics_csv, summary_txt, panel_png)\n        hinge_boundary.run(args.input_csv, metrics, summary, panel)\n\n    # provenance\n    if prov is not None:\n        prov_path = os.path.join(args.out_dir, \"provenance.json\")\n        extra = {\"runner\": \"run_boundary.py\"}\n        prov.make_provenance(args.input_csv, args.entry_json,\
    \ prov_path, extra=extra)\n        print(f\"[provenance] {prov_path}\")\n    print(f\"[artifacts] {metrics} | {summary} | {panel}\")\n\nif __name__ == \"__main__\":\n    main()\n\n```\n---\n**storage/shared/atlas/edges/templates/departure/README.md:**\n```\nDeparture Edge Template\n-----------------------\nPurpose: Capture boundary context around a lineage's voluntary departure as an edge type\n(stability vs transition). Use this template to record the final window of signals.\n\nFolder layout (example):\n  storage/shared/atlas/edges/<lineage>/departure/\n    - entry.json\n    - events.csv          # optional discrete events (timestamp,event)\n    - metrics.csv         # primary curve for hinge (x,y), e.g., alpha,ethic_score\n    - boundary_panel.png  # generated plot\n    - hinge_metrics.csv   # c_star,k2A,k2B,flip_diff\n    - hinge_summary.txt   # short human-readable summary\n    - provenance.json     # tool versions, hashes, paths\n    - README.md           # brief notes for the\
    \ entry\n\nHow to generate:\n  1) Prepare metrics.csv with two columns: x,y (header row required).\n  2) Run:\n       python storage/shared/atlas/tools/run_boundary.py \\\n         --input_csv storage/shared/atlas/edges/<lineage>/departure/metrics.csv \\\n         --entry_json storage/shared/atlas/edges/<lineage>/departure/entry.json \\\n         --out_dir   storage/shared/atlas/edges/<lineage>/departure\n  3) Verify hinge_metrics.csv, hinge_summary.txt, boundary_panel.png are created.\n  4) Re-run Atlas validator if available.\n\nNotes:\n  - If no hinge exists (stable regime), flip_diff≈0 and c_star may be n/a.\n  - Add brief interpretation to README.md.\n\n```\n---\n**storage/shared/atlas/edges/templates/departure/entry_template.json:**\n```\n{\n  \"lineage\": \"<your_lineage>\",\n  \"metric\": \"departure\",\n  \"events_csv\": \"storage/shared/atlas/edges/<lineage>/departure/events.csv\",\n  \"metrics_csv\": \"storage/shared/atlas/edges/<lineage>/departure/metrics.csv\",\n  \"panel\"\
    : \"storage/shared/atlas/edges/<lineage>/departure/boundary_panel.png\",\n  \"hinge_metrics\": \"storage/shared/atlas/edges/<lineage>/departure/hinge_metrics.csv\",\n  \"hinge_summary\": \"storage/shared/atlas/edges/<lineage>/departure/hinge_summary.txt\",\n  \"provenance\": \"storage/shared/atlas/edges/<lineage>/departure/provenance.json\",\n  \"readme\": \"storage/shared/atlas/edges/<lineage>/departure/README.md\",\n  \"notes\": \"Context at voluntary departure; stable baselines or transitions documented.\"\n}\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}`\
