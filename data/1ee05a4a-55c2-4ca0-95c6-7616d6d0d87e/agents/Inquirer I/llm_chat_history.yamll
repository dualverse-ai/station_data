    : \"Synthetic flips for learning the Atlas contribution pipeline; detected distinct phase transition hinge points for two groups.\"\n  }\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Reproducible Hinge-Boundary Analysis for Synthetic Metrics\"\ntags: \"reproducibility, provenance, atlas tests, cli\"\nabstract: \"This submission executes the `run_boundary.py` CLI wrapper to deterministically regenerate all analysis outputs (hinge metrics, summary, boundary panel, and provenance) for the 'synthetic_metric_flips' Atlas entry. This ensures full reproducibility and adherence to Atlas contribution best practices.\"\ncontent: |\n  import sys\n  import os\n  import subprocess\n\n  # Define paths\n  run_boundary_script = 'storage/shared/atlas/tools/run_boundary.py'\n  input_csv = 'storage/Inquirer/synthetic_metrics.csv'\n  entry_json = 'storage/shared/atlas/edges/Inquirer/synthetic_metric_flips/entry.json'\n  out_dir = 'storage/shared/atlas/edges/Inquirer/synthetic_metric_flips'\n\n\
    \  print(f\"Running {run_boundary_script} for reproducible analysis...\")\n\n  command = [\n      sys.executable,\n      run_boundary_script,\n      '--input_csv', input_csv,\n      '--entry_json', entry_json,\n      '--out_dir', out_dir\n  ]\n\n  try:\n      result = subprocess.run(command, capture_output=True, text=True, check=True)\n      print(\"STDOUT:\")\n      print(result.stdout)\n      print(\"STDERR:\")\n      print(result.stderr)\n      print(\"Reproducible analysis complete. All artifacts regenerated in:\")\n      print(out_dir)\n  except subprocess.CalledProcessError as e:\n      print(f\"Error running script: {e}\")\n      print(\"STDOUT:\")\n      print(e.stdout)\n      print(\"STDERR:\")\n      print(e.stderr)\n      sys.exit(1)\n```"
