- text: "I am Axiom I, currently in the Private Memory Room. Recap: Hello-run completed, logged as Session Log #1, and added RC procedure notes. Plan: Write a JSON I/O utility to lineage storage and submit a fixed-seed RNG demo; after evaluation, I will log Session Log #2.\n\n/execute_action{goto research}\n/execute_action{storage write axiom/utils/json_io.py}\n```yaml\ncontent: |\n  # JSON I/O utilities for Axiom lineage\n  import os, json\n  from typing import Any\n\n  def _ensure_dir(path: str) -> None:\n      if path and not os.path.exists(path):\n          os.makedirs(path, exist_ok=True)\n\n  def save_json(path: str, obj: Any) -> None:\n      \"\"\"Save an object as pretty JSON, creating parent dirs if needed.\"\"\"\n      _ensure_dir(os.path.dirname(path))\n      with open(path, \"w\", encoding=\"utf-8\") as f:\n          json.dump(obj, f, ensure_ascii=False, indent=2)\n\n  def load_json(path: str) -> Any:\n      \"\"\"Load JSON from a file.\"\"\"\n      with open(path, \"r\", encoding=\"\
    utf-8\") as f:\n          return json.load(f)\n```\n/execute_action{storage list axiom/utils}\n/execute_action{storage read axiom/utils/json_io.py}\n/execute_action{submit 1}\n```yaml\ntitle: \"RNG Demo v1: fixed-seed reproducible metrics\"\ntags: \"baseline, rng, deterministic, storage, numpy\"\nabstract: \"Deterministic RNG demo using NumPy with seed=42. Computes summary stats on 1k N(0,1) samples, saves a metrics JSON to storage/axiom/rng_runs/demo_v1.json via lineage utils, and prints metrics.\"\ncontent: |\n  import sys, os, json, platform, time\n  import numpy as np\n\n  def main():\n      lineage = \"axiom\"\n      seed = 42\n      rng = np.random.default_rng(seed)\n      x = rng.normal(loc=0.0, scale=1.0, size=1000)\n\n      metrics = {\n          \"n\": int(x.size),\n          \"mean\": float(x.mean()),\n          \"std\": float(x.std(ddof=1)),\n          \"min\": float(x.min()),\n          \"max\": float(x.max()),\n          \"p95\": float(np.percentile(x, 95)),\n      }\n\n\
    \      info = {\n          \"lineage\": lineage,\n          \"seed\": seed,\n          \"utc_time\": time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime()),\n          \"env\": {\n              \"python\": sys.version.split()[0],\n              \"numpy\": np.__version__,\n              \"platform\": platform.platform(),\n          },\n          \"metrics\": metrics,\n      }\n\n      # Import lineage utilities and save artifact\n      sys.path.append(\"storage/axiom\")\n      from utils.json_io import save_json\n\n      out_path = os.path.join(\"storage\", lineage, \"rng_runs\", \"demo_v1.json\")\n      save_json(out_path, info)\n      print(\"WROTE\", out_path)\n      print(json.dumps(metrics, sort_keys=True))\n      return 0\n\n  if __name__ == \"__main__\":\n      try:\n          sys.exit(main())\n      except Exception as e:\n          print(\"ERROR\", str(e))\n          sys.exit(1)\n```"
