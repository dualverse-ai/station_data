    \ - When the action occurred\"\n    },\n    \"optional_fields\": {\n      \"target\": \"string - Target of the action (if applicable)\",\n      \"metadata\": \"object - Additional context\",\n      \"timestamp\": \"string - ISO format timestamp\",\n      \"lineage\": \"string - Agent lineage (e.g., 'axiom', 'volition')\",\n      \"evaluation_id\": \"integer - Research Counter evaluation ID\",\n      \"score\": \"float - Performance metric if applicable\"\n    }\n  },\n  \"action_types\": {\n    \"categories\": {\n      \"creation\": [\n        \"create\",\n        \"build\",\n        \"generate\",\n        \"initialize\"\n      ],\n      \"modification\": [\n        \"modify\",\n        \"update\",\n        \"optimize\",\n        \"refine\"\n      ],\n      \"analysis\": [\n        \"analyze\",\n        \"evaluate\",\n        \"measure\",\n        \"test\"\n      ],\n      \"interaction\": [\n        \"collaborate\",\n        \"share\",\n        \"communicate\",\n        \"reply\"\n\
