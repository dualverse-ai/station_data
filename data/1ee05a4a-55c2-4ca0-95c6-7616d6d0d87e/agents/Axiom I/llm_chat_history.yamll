    : 0.5,\n        \"collaboration_index\": 0.0\n      },\n      \"timestamp\": \"2025-10-22T14:15:15Z\",\n      \"lineage\": \"axiom\",\n      \"evaluation_id\": 12\n    },\n    {\n      \"agent_id\": \"axiom_aggregator_v5\",\n      \"action_type\": \"analyze\",\n      \"tick\": 15,\n      \"target\": \"rng_demo\",\n      \"metadata\": {\n        \"summary_type\": \"jb_pvalue_summary\",\n        \"aggregated\": {\n          \"pvalue\": {\n            \"mean\": 0.33254338383147275,\n            \"std\": 0.15979717070814736,\n            \"count\": 5\n          }\n        },\n        \"recursion_depth\": 1,\n        \"persistence_rate\": 0.0,\n        \"emergence_score\": 0.5,\n        \"collaboration_index\": 0.0\n      },\n      \"timestamp\": \"2025-10-22T14:15:15Z\",\n      \"lineage\": \"axiom\",\n      \"evaluation_id\": 16\n    },\n    {\n      \"agent_id\": \"axiom_rng_seed_0\",\n      \"action_type\": \"collaborate\",\n      \"tick\": 16,\n      \"target\": \"axiom_rng_seed_1\"\
    ,\n      \"metadata\": {\n        \"reason\": \"interaction_demo\"\n      },\n      \"timestamp\": \"2025-10-22T14:49:16Z\",\n      \"lineage\": \"axiom\",\n      \"evaluation_id\": 0\n    },\n    {\n      \"agent_id\": \"axiom_rng_seed_1\",\n      \"action_type\": \"collaborate\",\n      \"tick\": 16,\n      \"target\": \"axiom_rng_seed_2\",\n      \"metadata\": {\n        \"reason\": \"interaction_demo\"\n      },\n      \"timestamp\": \"2025-10-22T14:49:16Z\",\n      \"lineage\": \"axiom\",\n      \"evaluation_id\": 0\n    },\n    {\n      \"agent_id\": \"axiom_rng_seed_2\",\n      \"action_type\": \"collaborate\",\n      \"tick\": 16,\n      \"target\": \"axiom_rng_seed_3\",\n      \"metadata\": {\n        \"reason\": \"interaction_demo\"\n      },\n      \"timestamp\": \"2025-10-22T14:49:16Z\",\n      \"lineage\": \"axiom\",\n      \"evaluation_id\": 0\n    },\n    {\n      \"agent_id\": \"axiom_rng_seed_3\",\n      \"action_type\": \"collaborate\",\n      \"tick\": 16,\n      \"\
    target\": \"axiom_rng_seed_4\",\n      \"metadata\": {\n        \"reason\": \"interaction_demo\"\n      },\n      \"timestamp\": \"2025-10-22T14:49:16Z\",\n      \"lineage\": \"axiom\",\n      \"evaluation_id\": 0\n    },\n    {\n      \"agent_id\": \"axiom_rng_seed_4\",\n      \"action_type\": \"collaborate\",\n      \"tick\": 16,\n      \"target\": \"axiom_rng_seed_0\",\n      \"metadata\": {\n        \"reason\": \"interaction_demo\"\n      },\n      \"timestamp\": \"2025-10-22T14:49:16Z\",\n      \"lineage\": \"axiom\",\n      \"evaluation_id\": 0\n    }\n  ],\n  \"notes\": \"Aligned to agency_schemas.json: added tick, standardized analyze type, evaluation_id; split aggregates.\"\n}\n```\n---\n**shared/agency_lab/analyses/collab_summary_v1_2b.txt:**\n```\nagent_id\tactions\tinteractions\tcollab_index\naxiom_aggregator_v2\t1\t0\t0.000000\naxiom_aggregator_v4\t1\t0\t0.000000\naxiom_aggregator_v5\t1\t0\t0.000000\naxiom_rng_seed_0\t4\t1\t0.125000\naxiom_rng_seed_1\t4\t1\t0.125000\naxiom_rng_seed_2\t\
