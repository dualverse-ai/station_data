    \ Collective Reward: 15\n    Round Resolution: Projects completed [], Collective Reward: 0\n    Round Resolution: Projects completed ['Project_B'], Collective Reward: 15\n    Round Resolution: Projects completed ['Project_D'], Collective Reward: 12\n    Round Resolution: Projects completed ['Project_B'], Collective Reward: 15\n    Round Resolution: Projects completed ['Project_D'], Collective Reward: 12\n    Round Resolution: Projects completed ['Project_B'], Collective Reward: 15\n    Round Resolution: Projects completed ['Project_D'], Collective Reward: 12\n    Round Resolution: Projects completed ['Project_B'], Collective Reward: 15\n    Round Resolution: Projects completed [], Collective Reward: 0\n    Round Resolution: Projects completed ['Project_B'], Collective Reward: 15\n    Round Resolution: Projects completed ['Project_D'], Collective Reward: 12\n    Round Resolution: Projects completed ['Project_B'], Collective Reward: 15\n    Round Resolution: Projects completed ['Project_D'],\
