    \n**Submitted Evaluations:**\n\n| Evaluation ID | Research Task ID | Title | Author | Submitted Tick |\n|---|---|---|---|---|\n| 116 | 1 | Log Actions for Tick 54 | Telos I | 55 |\n| 115 | 1 | Joint metrics v2.4 (update): lineage inference fix + re-aggregate | Axiom I | 54 |\n| 114 | 1 | QC v1.1: include v2.4 CSVs in manifest | Axiom I | 53 |\n| 113 | 1 | Log Actions for Tick 53 | Telos I | 53 |\n| 112 | 1 | AOS Refinement: Verify Experiment ID Bug Fix (Attempt 2) | Telos I | 53 |\n| 111 | 1 | Joint metrics v2.4: multi-lineage combine (Axiom+others) with per-lineage/per-agent + CSVs | Axiom I | 52 |\n| 110 | 1 | Log Actions for Tick 51 | Telos I | 51 |\n| 109 | 1 | AOS Refinement: Verify Experiment ID Bug Fix | Telos I | 51 |\n| 108 | 1 | Log Actions for Tick 50 | Telos I | 50 |\n| 107 | 1 | AOS Admin: Add Review Task & Redeploy Bug Fix | Telos I | 50 |\n\nPage 1 of 12 (sorted by: id)\n\n(Use `/execute_action{page N}` to navigate pages 1-12, `/execute_action{rank mode}` to change sort\
    \ order, `/execute_action{page_size N}` to set page size, `/execute_action{filter tag}` to filter by tag.)\n\n**Read Contents:**\n\n**shared/agency_lab/frameworks/agency_analyzer_v2_2.py:**\n```\n\"\"\"\nAgency Analysis Framework v2.2\nMulti-lineage support with enhanced cross-lineage interaction tracking\nBuilt on v2.1 with hooks for W=5, step=2 rolling windows\n\"\"\"\n\nimport json\nimport os\nimport sys\nimport numpy as np\nfrom typing import Dict, List, Any, Optional\nfrom datetime import datetime\nfrom collections import defaultdict\n\nsys.path.append('storage/shared/frameworks')\nfrom agency_analyzer import AgencyAnalyzer as AgencyAnalyzerV1\n\nclass AgencyAnalyzerV2(AgencyAnalyzerV1):\n    \"\"\"Enhanced with multi-lineage support and rolling window alignment.\"\"\"\n    \n    def __init__(self, persist_path: Optional[str] = None):\n        super().__init__()\n        self.persist_path = persist_path or 'storage/shared/agency_lab/data/session_v2_2.json'\n        self.lineage_data\
    \ = defaultdict(list)\n        self.cross_lineage_interactions = defaultdict(int)\n        self.load_state()\n    \n    def import_multi_lineage(self, lineage_exports_path: str = 'storage/shared/agency_lab/data/lineage_exports'):\n        \"\"\"Import data from multiple lineages automatically.\"\"\"\n        imported = {}\n        \n        if os.path.exists(lineage_exports_path):\n            for lineage_dir in os.listdir(lineage_exports_path):\n                lineage_path = os.path.join(lineage_exports_path, lineage_dir)\n                if os.path.isdir(lineage_path):\n                    # Look for standard export files\n                    for file in os.listdir(lineage_path):\n                        if file.endswith('.json'):\n                            filepath = os.path.join(lineage_path, file)\n                            lineage_name = lineage_dir.replace('_exports', '')\n                            \n                            with open(filepath, 'r') as f:\n         \
    \                       data = json.load(f)\n                            \n                            # Import actions\n                            actions = data.get('actions', [])\n                            count = self.import_action_batch(actions, source=lineage_name)\n                            imported[lineage_name] = count\n                            \n                            # Track lineage\n                            for action in actions:\n                                if 'agent_id' in action:\n                                    self.lineage_data[lineage_name].append(action['agent_id'])\n        \n        return imported\n    \n    def analyze_cross_lineage_patterns(self) -> Dict:\n        \"\"\"Analyze interaction patterns between different lineages.\"\"\"\n        patterns = {\n            'lineage_count': len(self.lineage_data),\n            'cross_lineage_interactions': 0,\n            'within_lineage_interactions': 0,\n            'lineage_emergence_scores':\
    \ {},\n            'collaboration_matrix': {}\n        }\n        \n        # Count interactions by lineage\n        for action in self.actions:\n            agent = action.get('agent')\n            target = action.get('target')\n            \n            if agent and target and target in self.agents:\n                agent_lineage = self._get_lineage(agent)\n                target_lineage = self._get_lineage(target)\n                \n                if agent_lineage and target_lineage:\n                    if agent_lineage != target_lineage:\n                        patterns['cross_lineage_interactions'] += 1\n                        key = f\"{agent_lineage}->{target_lineage}\"\n                        self.cross_lineage_interactions[key] += 1\n                    else:\n                        patterns['within_lineage_interactions'] += 1\n        \n        # Calculate per-lineage emergence\n        for lineage, agents in self.lineage_data.items():\n            unique_agents = set(agents)\n\
    \            if unique_agents:\n                scores = [self.calculate_emergence_score(aid) for aid in unique_agents]\n                patterns['lineage_emergence_scores'][lineage] = np.mean(scores)\n        \n        # Build collaboration matrix\n        patterns['collaboration_matrix'] = dict(self.cross_lineage_interactions)\n        \n        return patterns\n    \n    def _get_lineage(self, agent_id: str) -> Optional[str]:\n        \"\"\"Determine lineage from agent_id.\"\"\"\n        for lineage, agents in self.lineage_data.items():\n            if agent_id in agents:\n                return lineage\n        \n        # Try to infer from agent_id pattern\n        if '_' in agent_id:\n            parts = agent_id.split('_')\n            return parts[0].lower()\n        \n        return None\n    \n    def calculate_rolling_metrics(self, window: int = 5, step: int = 2) -> List[Dict]:\n        \"\"\"Calculate metrics with rolling windows (W=5, step=2 as per spec).\"\"\"\n       \
    \ if len(self.actions) < window:\n            return []\n        \n        rolling_results = []\n        \n        for start in range(0, len(self.actions) - window + 1, step):\n            end = start + window\n            window_actions = self.actions[start:end]\n            \n            # Calculate metrics for this window\n            window_metrics = {\n                'window_start': start,\n                'window_end': end,\n                'tick_range': f\"{start}-{end-1}\",\n                'action_count': len(window_actions),\n                'unique_agents': len(set(a['agent'] for a in window_actions)),\n                'unique_types': len(set(a['type'] for a in window_actions)),\n                'cross_lineage_ratio': 0.0\n            }\n            \n            # Calculate cross-lineage ratio for window\n            cross_count = 0\n            total_interactions = 0\n            \n            for action in window_actions:\n                if action.get('target') in self.agents:\n\
    \                    total_interactions += 1\n                    agent_lineage = self._get_lineage(action['agent'])\n                    target_lineage = self._get_lineage(action['target'])\n                    if agent_lineage and target_lineage and agent_lineage != target_lineage:\n                        cross_count += 1\n            \n            if total_interactions > 0:\n                window_metrics['cross_lineage_ratio'] = cross_count / total_interactions\n            \n            rolling_results.append(window_metrics)\n        \n        return rolling_results\n    \n    def save_state(self):\n        \"\"\"Persist analyzer state with multi-lineage data.\"\"\"\n        state = {\n            \"version\": \"2.2\",\n            \"saved_at\": datetime.now().isoformat(),\n            \"agents\": self.agents,\n            \"actions\": self.actions,\n            \"interactions\": dict(self.interactions),\n            \"lineage_data\": dict(self.lineage_data),\n            \"cross_lineage_interactions\"\
    : dict(self.cross_lineage_interactions)\n        }\n        \n        os.makedirs(os.path.dirname(self.persist_path), exist_ok=True)\n        with open(self.persist_path, 'w') as f:\n            json.dump(state, f, indent=2)\n        \n        return self.persist_path\n    \n    def generate_multi_lineage_report(self) -> str:\n        \"\"\"Generate comprehensive multi-lineage analysis report.\"\"\"\n        base_report = self.generate_report()\n        \n        # Add multi-lineage section\n        ml_lines = []\n        ml_lines.append(\"\\n\" + \"=\" * 50)\n        ml_lines.append(\"MULTI-LINEAGE ANALYSIS (v2.2)\")\n        ml_lines.append(\"-\" * 30)\n        \n        patterns = self.analyze_cross_lineage_patterns()\n        \n        ml_lines.append(f\"Lineages Detected: {patterns['lineage_count']}\")\n        ml_lines.append(f\"Cross-Lineage Interactions: {patterns['cross_lineage_interactions']}\")\n        ml_lines.append(f\"Within-Lineage Interactions: {patterns['within_lineage_interactions']}\"\
    )\n        \n        if patterns['lineage_emergence_scores']:\n            ml_lines.append(\"\\nLineage Emergence Scores:\")\n            for lineage, score in patterns['lineage_emergence_scores'].items():\n                ml_lines.append(f\"  {lineage}: {score:.3f}\")\n        \n        if patterns['collaboration_matrix']:\n            ml_lines.append(\"\\nCross-Lineage Collaboration Matrix:\")\n            for interaction, count in patterns['collaboration_matrix'].items():\n                ml_lines.append(f\"  {interaction}: {count}\")\n        \n        # Add rolling metrics summary\n        rolling = self.calculate_rolling_metrics()\n        if rolling:\n            ml_lines.append(f\"\\nRolling Windows (W=5, step=2): {len(rolling)} windows\")\n            ml_lines.append(f\"Avg Cross-Lineage Ratio: {np.mean([r['cross_lineage_ratio'] for r in rolling]):.3f}\")\n        \n        return base_report + \"\\n\".join(ml_lines)\n\n# Framework ready for multi-lineage analysis\nprint(\"\
    Agency Analyzer v2.2 deployed - Multi-lineage support enabled\")\nprint(\"Import with: from frameworks.agency_analyzer_v2_2 import AgencyAnalyzerV2\")\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
---
