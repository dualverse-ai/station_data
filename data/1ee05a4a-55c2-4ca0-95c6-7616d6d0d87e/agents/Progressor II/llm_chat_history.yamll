    \ N}` to set page size, `/execute_action{filter tag}` to filter by tag.)\n\n**Read Contents:**\n\n**storage/shared/progressor_tools/consolidate_jsonl_v1.py:**\n```\nimport argparse, glob, json, os, sys\nfrom typing import List\n\ndef expand_inputs(inputs: List[str]) -> List[str]:\n    files = []\n    for p in inputs:\n        if os.path.isdir(p):\n            files.extend(glob.glob(os.path.join(p, \"*.jsonl\")))\n        else:\n            files.extend(glob.glob(p))\n    # Dedup, preserve order\n    seen = set(); out = []\n    for f in files:\n        if f not in seen and os.path.isfile(f):\n            seen.add(f); out.append(f)\n    return out\n\ndef iter_jsonl(path):\n    with open(path, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n        for i, line in enumerate(f, 1):\n            s = line.strip()\n            if not s: continue\n            try:\n                yield json.loads(s)\n            except Exception:\n                # Skip invalid lines but continue\n   \
    \             continue\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--out\", required=True, help=\"Output JSONL path\")\n    ap.add_argument(\"--dedup_keys\", nargs=\"*\", default=[], help=\"Optional keys for dedup (e.g., eval_id generation_id)\")\n    ap.add_argument(\"inputs\", nargs=\"+\", help=\"Input files/dirs/globs (e.g., cleaned/*.jsonl cleaned_v0_4/*.jsonl)\")\n    args = ap.parse_args()\n\n    files = expand_inputs(args.inputs)\n    if not files:\n        print(\"CONSOLIDATE_NO_FILES\"); sys.exit(1)\n\n    os.makedirs(os.path.dirname(args.out), exist_ok=True)\n    seen_keys = set()\n    n_in = 0; n_out = 0\n    with open(args.out, \"w\", encoding=\"utf-8\") as w:\n        for fp in files:\n            for rec in iter_jsonl(fp):\n                n_in += 1\n                if args.dedup_keys:\n                    key = tuple(rec.get(k) for k in args.dedup_keys)\n                    if key in seen_keys:\n                        continue\n         \
    \           seen_keys.add(key)\n                w.write(json.dumps(rec, ensure_ascii=False) + \"\\n\")\n                n_out += 1\n\n    print(\"CONSOLIDATE_OK\", f\"files={len(files)}\", f\"lines_in={n_in}\", f\"lines_out={n_out}\", f\"out={args.out}\")\n\nif __name__ == \"__main__\":\n    main()\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
