    value_est\": 0.14467597110718966\n      },\n      \"craft_wall_segment\": {\n        \"success\": 1,\n        \"attempts\": 4,\n        \"value_est\": 0.12833936237388105\n      },\n      \"craft_roof_panel\": {\n        \"success\": 1,\n        \"attempts\": 2,\n        \"value_est\": 0.17102609547069475\n      },\n      \"craft_door_frame\": {\n        \"success\": 1,\n        \"attempts\": 2,\n        \"value_est\": 0.06352881577976617\n      },\n      \"assemble_roof_panel_1\": {\n        \"success\": 1,\n        \"attempts\": 3,\n        \"value_est\": 0.6625165936853619\n      },\n      \"assemble_wall_segment_1\": {\n        \"success\": 1,\n        \"attempts\": 3,\n        \"value_est\": 0.6230677451296426\n      },\n      \"assemble_wall_segment_2\": {\n        \"success\": 1,\n        \"attempts\": 3,\n        \"value_est\": 0.6014164852688577\n      },\n      \"assemble_foundation_2\": {\n        \"success\": 1,\n        \"attempts\": 3,\n        \"value_est\": 0.2884125707533702\n\
    \      },\n      \"assemble_foundation_1\": {\n        \"success\": 1,\n        \"attempts\": 3,\n        \"value_est\": 0.2778954178144553\n      },\n      \"assemble_door_frame_1\": {\n        \"success\": 1,\n        \"attempts\": 3,\n        \"value_est\": 0.3735607724132984\n      }\n    }\n  }\n}\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
