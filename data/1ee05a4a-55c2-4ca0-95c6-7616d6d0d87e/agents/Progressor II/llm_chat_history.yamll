    \   \"weight_source\": \"eta_default\"\n  },\n  {\n    \"run_id\": \"822\",\n    \"std\": 17.8,\n    \"tail_alpha\": 0.0,\n    \"js_divergence\": 0.11554151748646908,\n    \"norm_js\": 0.1666911742945144,\n    \"tail_mass\": 0.99,\n    \"tail_coverage\": 0.3,\n    \"coupling_weight\": 1.0,\n    \"norm_novelty\": 0.1666911742945144,\n    \"tail_start_bin_used\": 8.0,\n    \"pv_sidecar\": false,\n    \"weight_source\": \"eta_default\"\n  },\n  {\n    \"run_id\": \"824\",\n    \"std\": 17.68,\n    \"tail_alpha\": 0.0,\n    \"js_divergence\": 0.12197352747195511,\n    \"norm_js\": 0.1759706032035234,\n    \"tail_mass\": 0.99,\n    \"tail_coverage\": 0.3,\n    \"coupling_weight\": 1.0,\n    \"norm_novelty\": 0.1759706032035234,\n    \"tail_start_bin_used\": 8.0,\n    \"pv_sidecar\": false,\n    \"weight_source\": \"eta_default\"\n  },\n  {\n    \"run_id\": \"826\",\n    \"std\": 5.54,\n    \"tail_alpha\": 0.0,\n    \"js_divergence\": 0.17022851413124185,\n    \"norm_js\": 0.24558783315503946,\n\
    \    \"tail_mass\": 0.2,\n    \"tail_coverage\": 0.3,\n    \"coupling_weight\": 1.0,\n    \"norm_novelty\": 0.24558783315503946,\n    \"tail_start_bin_used\": 8.0,\n    \"pv_sidecar\": false,\n    \"weight_source\": \"eta_default\"\n  },\n  {\n    \"run_id\": \"828\",\n    \"std\": 6.12,\n    \"tail_alpha\": 0.0,\n    \"js_divergence\": 0.10382209026088339,\n    \"norm_js\": 0.14978361475410282,\n    \"tail_mass\": 0.4,\n    \"tail_coverage\": 0.3,\n    \"coupling_weight\": 1.0,\n    \"norm_novelty\": 0.14978361475410282,\n    \"tail_start_bin_used\": 8.0,\n    \"pv_sidecar\": false,\n    \"weight_source\": \"eta_default\"\n  }\n]\n```\n---\n**shared/erudite_annex/extend_metrics_v3.py:**\n```\nimport os, json, csv, math, sys\n\nBASE = \"storage/shared/erudite_annex\"\nSRC = os.path.join(BASE, \"summary.json\")\nOUT_CSV = os.path.join(BASE, \"summary_table_v3.csv\")\nOUT_JSON = os.path.join(BASE, \"summary_table_v3.json\")\nPROFILES_DIR = os.path.join(BASE, \"tail_profiles\")\nPROFILES_INDEX\
    \ = os.path.join(BASE, \"tail_profiles\", \"index.json\")\nINDEX_V3 = os.path.join(BASE, \"index_v3.json\")\n\n# Import adapter for robust histogram parsing\nsys.path.append('storage/shared/erudite_bridge')\nimport adapter as A  # noqa\n\ndef load_json(path):\n  with open(path, \"r\", encoding=\"utf-8\") as f:\n    return json.load(f)\n\ndef save_json(path, obj):\n  os.makedirs(os.path.dirname(path), exist_ok=True)\n  with open(path, \"w\", encoding=\"utf-8\") as f:\n    json.dump(obj, f, indent=2, ensure_ascii=False)\n\ndef derive_pdf_for_run(run_id):\n  candidates = [\n    f\"storage/shared/erudite/runs/{run_id}.json\",\n    f\"storage/erudite/runs/{run_id}.json\",\n  ]\n  for p in candidates:\n    if os.path.exists(p):\n      data = load_json(p)\n      bins, counts = A._derive_bins_counts(data)  # intentional SLF use\n      if bins and counts and len(bins) == len(counts):\n        total = float(sum(max(0.0, c) for c in counts))\n        pdf = [max(0.0, c) / total if total > 0 else\
    \ 0.0 for c in counts]\n        return bins, pdf\n  return [], []\n\ndef write_tail_profile(run_id, bins, pdf, tstart):\n  os.makedirs(PROFILES_DIR, exist_ok=True)\n  rows = []\n  for b, p in zip(bins, pdf):\n    rows.append({\"bin\": float(b), \"pdf\": float(p), \"is_tail\": (tstart is not None and float(b) >= float(tstart))})\n\n  # CSV\n  p_csv = os.path.join(PROFILES_DIR, f\"tail_profile_{run_id}.csv\")\n  with open(p_csv, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n    w = csv.DictWriter(f, fieldnames=[\"bin\", \"pdf\", \"is_tail\"])\n    w.writeheader()\n    for r in rows:\n      w.writerow(r)\n\n  # JSON\n  p_json = os.path.join(PROFILES_DIR, f\"tail_profile_{run_id}.json\")\n  save_json(p_json, rows)\n  return p_csv, p_json\n\ndef main():\n  data = load_json(SRC)\n  runs = data.get(\"runs\", [])\n  out_rows = []\n  profiles = {}\n\n  for r in runs:\n    if \"error\" in r:\n      out_rows.append({\n        \"run_id\": r.get(\"run_path\", \"unknown\"),\n        \"std\": None,\
    \ \"tail_alpha\": None, \"js_divergence\": None,\n        \"norm_js\": None, \"tail_mass\": None, \"tail_coverage\": None,\n        \"coupling_weight\": None, \"norm_novelty\": None,\n        \"tail_start_bin_used\": None, \"pv_sidecar\": False, \"weight_source\": \"n/a\",\n        \"error\": r[\"error\"],\n      })\n      continue\n\n    run_id = str(r.get(\"run_id\"))\n    std = r.get(\"std\")\n    tstart = r.get(\"tail_start_bin_used\")\n    js = r.get(\"js_divergence\")\n    weight = r.get(\"coupling_weight\")\n    pv_present = bool(r.get(\"pv_sidecar\"))\n    weight = 1.0 if (weight is None) else float(weight)\n    weight_source = \"pv\" if pv_present else (\"eta_default\" if weight is not None else \"none\")\n\n    # norm_js in [0,1]\n    norm_js = (js / math.log(2.0)) if js is not None else None\n    norm_novelty = (norm_js * weight) if (norm_js is not None and weight is not None) else None\n\n    # Tail mass and coverage (reuse v2 logic)\n    bins, pdf = derive_pdf_for_run(run_id)\n\
    \    tail_mass, tail_cov = None, None\n    if bins and pdf and tstart is not None:\n      n = len(bins)\n      tail_idx = [i for i, b in enumerate(bins) if float(b) >= float(tstart)]\n      if n > 0:\n        tail_cov = len(tail_idx) / n\n        tail_mass = float(sum(pdf[i] for i in tail_idx)) if tail_idx else 0.0\n\n    # Write per-run tail profile\n    p_csv, p_json = None, None\n    if bins and pdf:\n      p_csv, p_json = write_tail_profile(run_id, bins, pdf, tstart)\n      profiles[run_id] = {\"csv\": p_csv, \"json\": p_json}\n\n    out_rows.append({\n      \"run_id\": run_id,\n      \"std\": std,\n      \"tail_alpha\": r.get(\"tail_alpha\"),\n      \"js_divergence\": js,\n      \"norm_js\": norm_js,\n      \"tail_mass\": tail_mass,\n      \"tail_coverage\": tail_cov,\n      \"coupling_weight\": weight,\n      \"norm_novelty\": norm_novelty,\n      \"tail_start_bin_used\": tstart,\n      \"pv_sidecar\": pv_present,\n      \"weight_source\": weight_source,\n    })\n\n  # Write CSV\n\
    \  cols = [\"run_id\",\"std\",\"tail_alpha\",\"js_divergence\",\"norm_js\",\"tail_mass\",\"tail_coverage\",\n          \"coupling_weight\",\"norm_novelty\",\"tail_start_bin_used\",\"pv_sidecar\",\"weight_source\"]\n  os.makedirs(os.path.dirname(OUT_CSV), exist_ok=True)\n  with open(OUT_CSV, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n    w = csv.DictWriter(f, fieldnames=cols)\n    w.writeheader()\n    for row in out_rows:\n      w.writerow({k: row.get(k) for k in cols})\n\n  # Write JSON\n  save_json(OUT_JSON, out_rows)\n\n  # Profiles index\n  save_json(PROFILES_INDEX, {\"profiles\": profiles})\n\n  # Write annex index v3\n  save_json(INDEX_V3, {\n    \"version\": \"erudite_annex_index_v3\",\n    \"base\": \"storage/shared/erudite_annex\",\n    \"source_summary\": \"storage/shared/erudite_annex/summary.json\",\n    \"tables\": {\n      \"v1\": {\n        \"csv\": \"storage/shared/erudite_annex/summary_table.csv\",\n        \"json\": \"storage/shared/erudite_annex/summary_table.json\"\
    \n      },\n      \"v2\": {\n        \"csv\": \"storage/shared/erudite_annex/summary_table_v2.csv\",\n        \"json\": \"storage/shared/erudite_annex/summary_table_v2.json\"\n      },\n      \"v3\": {\n        \"csv\": OUT_CSV,\n        \"json\": OUT_JSON,\n        \"columns\": cols\n      }\n    },\n    \"tail_profiles\": {\n      \"dir\": \"storage/shared/erudite_annex/tail_profiles/\",\n      \"index\": PROFILES_INDEX\n    },\n    \"notes\": \"v3 adds norm_novelty = norm_js * weight and per-run tail profiles (bin, pdf, is_tail).\"\n  })\n\n  print(\"ANNEX_EXTENDED_V3_OK\", OUT_CSV, OUT_JSON, INDEX_V3, PROFILES_INDEX, len(out_rows))\n\nif __name__ == \"__main__\":\n  main()\n\n```\n---\n**shared/erudite_annex/tail_profiles/profiles_overlay_cdf.txt:**\n```\nTail Profiles — Overlay CDF Summary (with labels)\n819: tail_mass=0.990000 cov=0.300 norm_novelty=0.16763720909260552\n822: tail_mass=0.990000 cov=0.300 norm_novelty=0.1666911742945144\n824: tail_mass=0.990000 cov=0.300 norm_novelty=0.1759706032035234\n\
    826: tail_mass=0.200000 cov=0.300 norm_novelty=0.24558783315503946\n828: tail_mass=0.400000 cov=0.300 norm_novelty=0.14978361475410282\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
