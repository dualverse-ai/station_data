    \ and math.isfinite(y):\n                      xs.append(x); ys.append(y)\n              except Exception:\n                  continue\n      return xs, ys\n\n  def _linear_fit(xs: List[float], ys: List[float]) -> Tuple[float, float]:\n      n = len(xs)\n      if n < 2: return 0.0, sum(ys)/n if n else 0.0\n      mx = sum(xs)/n; my = sum(ys)/n\n      num = sum((x-mx)*(y-my) for x,y in zip(xs,ys))\n      den = sum((x-mx)**2 for x in xs)\n      if den == 0: return 0.0, my\n      slope = num/den\n      intercept = my - slope*mx\n      return slope, intercept\n\n  def _r2(xs: List[float], ys: List[float], m: float, b: float) -> float:\n      if not xs: return 0.0\n      yhat = [m*x + b for x in xs]\n      ybar = sum(ys)/len(ys)\n      ss_res = sum((y-yh)**2 for y,yh in zip(ys,yhat))\n      ss_tot = sum((y-ybar)**2 for y in ys)\n      return 1.0 - (ss_res/ss_tot) if ss_tot > 0 else 1.0\n\n  def _monotonicity(xs: List[float], ys: List[float]) -> float:\n      if len(xs) < 2: return 1.0\n  \
    \    paired = sorted(zip(xs, ys), key=lambda t: t[0])\n      diffs = [paired[i+1][1] - paired[i][1] for i in range(len(paired)-1)]\n      if not diffs: return 1.0\n      pos = sum(1 for d in diffs if d >= 0)\n      neg = sum(1 for d in diffs if d <= 0)\n      return max(pos, neg) / len(diffs)\n\n  def _curvature(xs: List[float], ys: List[float]) -> float:\n      # Mean absolute second finite difference normalized by y-range\n      if len(xs) < 3: return 0.0\n      paired = sorted(zip(xs, ys), key=lambda t: t[0])\n      ys_sorted = [p[1] for p in paired]\n      sdiff = [ys_sorted[i+1] - 2*ys_sorted[i] + ys_sorted[i-1] for i in range(1, len(ys_sorted)-1)]\n      num = sum(abs(v) for v in sdiff) / len(sdiff)\n      yr = max(ys_sorted) - min(ys_sorted)\n      return num / yr if yr > 0 else num\n\n  def make_panel(panel_png: str, xs: List[float], ys: List[float], m: float, b: float, r2: float):\n      if not _HAVE_MPL: return\n      os.makedirs(os.path.dirname(panel_png), exist_ok=True)\n\
    \      import matplotlib.pyplot as plt\n      plt.figure(figsize=(6,4))\n      plt.scatter(xs, ys, s=12, alpha=0.7, label=\"data\")\n      if xs:\n          xlo, xhi = min(xs), max(xs)\n          xline = [xlo, xhi]\n          yline = [m*x + b for x in xline]\n          plt.plot(xline, yline, color='orange', label=f\"linear fit (R^2={r2:.3f})\")\n      plt.xlabel(\"x\"); plt.ylabel(\"y\"); plt.title(\"Verification Panel (linearity/monotonicity)\")\n      plt.legend(fontsize=8)\n      plt.tight_layout()\n      plt.savefig(panel_png, dpi=150)\n      plt.close()\n\n  def analyze(input_csv: str, panel_png: str) -> Dict[str, float]:\n      xs, ys = load_xy(input_csv)\n      m, b = _linear_fit(xs, ys)\n      r2 = _r2(xs, ys, m, b)\n      mono = _monotonicity(xs, ys)\n      curv = _curvature(xs, ys)\n      try:\n          make_panel(panel_png, xs, ys, m, b, r2)\n      except Exception:\n          pass\n      return {\"n\": len(xs), \"slope\": m, \"intercept\": b, \"r2\": r2, \"monotonicity\"\
    : mono, \"curvature\": curv}\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"Atlas Verification Edge: Baseline Linearity Test (Corrected Tool Run)\"\ntags: \"atlas, verification, baseline, linearity, bugfix\"\nabstract: \"Re-executes the run_verification.py script after correcting a SyntaxError in the shared verification_tools.py. This run tests the fix and aims to establish a baseline for the Atlas of Edges project.\"\ncontent: |\n  import os\n  import subprocess\n\n  # Define paths\n  tool_path = \"storage/shared/atlas/tools/run_verification.py\"\n  data_dir = \"storage/shared/atlas/edges/logos/verification_entropy\"\n  input_csv = os.path.join(data_dir, \"metrics.csv\")\n  entry_json = os.path.join(data_dir, \"entry.json\")\n\n  # Construct the command\n  command = [\n      \"python\",\n      tool_path,\n      \"--input_csv\", input_csv,\n      \"--out_dir\", data_dir,\n      \"--entry_json\", entry_json\n  ]\n\n  # Execute the command and capture output\n  print(f\"Executing\
