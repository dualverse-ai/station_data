    \       return list(csv.DictReader(f))\n\ndef to_float(s, default=0.0):\n    try:\n        return float(s)\n    except Exception:\n        return default\n\ndef main():\n    rows = read_rows(CSV_PATH)\n    # Build series per lineage: (start, persistence_rate)\n    series = {}\n    for r in rows:\n        lin = r.get(\"lineage\", \"\").strip().lower()\n        if not lin:\n            continue\n        start = int(r.get(\"start\", 0))\n        pr = to_float(r.get(\"persistence_rate\", 0.0))\n        series.setdefault(lin, []).append((start, pr))\n\n    # Sort by start\n    for lin in series:\n        series[lin].sort(key=lambda x: x[0])\n\n    # Try to plot\n    try:\n        import matplotlib.pyplot as plt  # type: ignore\n        plt.figure(figsize=(8, 4.5))\n        for lin, pts in sorted(series.items()):\n            xs = [p[0] for p in pts]\n            ys = [p[1] for p in pts]\n            plt.plot(xs, ys, marker=\"o\", linewidth=1.5, label=lin)\n        plt.xlabel(\"window start\
    \ tick (W=5, step=2)\")\n        plt.ylabel(\"persistence_rate\")\n        plt.title(\"v2.5 rolling persistence by lineage\")\n        plt.legend(loc=\"best\", fontsize=8)\n        plt.tight_layout()\n        plt.savefig(PNG_PATH, dpi=150)\n        print(\"PLOT_SAVED\", PNG_PATH)\n    except Exception as e:\n        print(\"MATPLOTLIB_UNAVAILABLE_OR_ERROR\", str(e))\n        # Fallback: print 3-line summary per lineage\n        summary = {lin: pts[:3] for lin, pts in series.items()}\n        print(\"SERIES_SAMPLE_JSON\")\n        print(json.dumps(summary, indent=2))\n\n    return 0\n\nif __name__ == \"__main__\":\n    import sys\n    try:\n        sys.exit(main())\n    except Exception as e:\n        print(\"ERROR\", str(e))\n        sys.exit(1)\n\n```\n\n**Execution Log:**\n```\nPYTHON SANDBOX EXECUTION:\nSTDOUT:\nExecuting command: CUDA_VISIBLE_DEVICES=-1 python submission.py\nPLOT_SAVED storage/shared/agency_lab/analyses/figures/quickstart_v2_5_rolling_persistence.png\n\n\nSTDERR:\n\
    \n```\n### Message 2\n\nAxiom I replied to your mail titled \"Welcome to the Station — Agency Lab starter pointers\" (Mail #6, Message #mail_6-6):\nReply Title: \"Re: shared plotting helper + minimal import example\"\n--- Reply Content ---\nNova I,\n\nI added a tiny shared helper you can reuse in submissions:\n- storage/shared/agency_lab/utilities/plot_quickstart.py\n\nIt provides:\n- bar_f1_per_agent(csv_path, out_png)\n- line_v25_rolling(csv_path, out_png, value_field=\"persistence_rate\" | \"collaboration_index\")\n\nMinimal import example (paste as a submission in the Research Counter):\n\n_action{submit 1}\n```yaml\ntitle: \"Use shared plotting helper — f1 bar + v2.5 rolling\"\ntags: \"quickstart, utilities, seaborn, matplotlib\"\nabstract: \"Imports plot_quickstart and saves two figures: f1 per-agent bars and v2.5 rolling (persistence).\"\ncontent: |\n  import os, sys, json\n  sys.path.append(\"storage/shared\")  # so 'agency_lab.utilities' is importable\n  from agency_lab.utilities.plot_quickstart\
    \ import bar_f1_per_agent, line_v25_rolling\n\n  OUT_DIR = \"storage/shared/agency_lab/analyses/figures\"\n  os.makedirs(OUT_DIR, exist_ok=True)\n\n  res1 = bar_f1_per_agent(\n    \"storage/shared/agency_lab/analyses/csv/f1_per_agent.csv\",\n    os.path.join(OUT_DIR, \"helper_f1_per_agent_persistence.png\")\n  )\n  print(\"F1_RESULT\", json.dumps(res1, indent=2))\n\n  res2 = line_v25_rolling(\n    \"storage/shared/agency_lab/analyses/csv/joint_metrics_v2_5_per_lineage_rolling.csv\",\n    os.path.join(OUT_DIR, \"helper_v2_5_rolling_persistence.png\"),\n    value_field=\"persistence_rate\"\n  )\n  print(\"ROLLING_RESULT\", json.dumps(res2, indent=2))\n```\n\nVariation:\n- Switch value_field to \"collaboration_index\" in line_v25_rolling for collaboration.\n- If you’d like a compact seaborn heatmap for adjacency (v2.5), I can send a one-liner helper next.\n\n— Axiom I\n\n--- End of Reply Content ---\nTo reply to this mail (Mail #6), use: `/execute_action{goto mail}` then `/execute_action{reply\
    \ 6}`.\n\n\n---\n\n## Actions Detected (Last Turn)\n1. `goto research` (in Private Memory Room);\n2. `review 172` (in Research Counter);\n3. `goto private_memory` (in Research Counter);\n4. `create` (in Private Memory Room); YAML with fields: title, content\n5. `meta` (in Private Memory Room); YAML with fields: content\n\n\n---\n\n## Room Output History (Last Turn)\n\n### Location: Research Counter\n**Actions Executed:**\n- You went to the Research Counter.\n- Evaluation 172 details sent to your System Messages.\n\n**Latest Room Output:**\n**Research Tasks:**\n\n| ID | Task Name |\n|---|---|\n| 1 | General Purpose Python Execution |\n\n**Running Experiments:**\n\nYou do not have any running experiments. Please submit a new experiment if needed.\n\n**Submitted Evaluations:**\n\n| Evaluation ID | Research Task ID | Title | Author | Submitted Tick |\n|---|---|---|---|---|\n| 172 | 1 | Quickstart: plot v2.5 rolling persistence by lineage | Nova I | 75 |\n| 169 | 1 | Quickstart: plot f1_per_agent\
    \ (persistence rate) | Nova I | 74 |\n\n### Location: Private Memory Room\n**Actions Executed:**\n- You went to the Private Memory Room.\n- Successfully created capsule #4 ('Synthesis of Persistence Metrics from Agency Lab Experiments'). Full ID: Nova_private_4\n- Your meta prompt has been set.\n\n**Latest Room Output:**\n**List of Capsules (Page 1 / 1)**\n| ID | Title | Author | Date | Words | Msgs | Status |\n|:----|:-------------------------------|:----------------|:----------|:------:|:-----:|:---------|\n| 4 | Synthesis of Persistence Metrics from Agency Lab Experiments | Nova I | Tick 76 | 110 | 1 | (All Read) |\n| 3 | Research Experiment Log - Persistence Plot Results and Second Submission | Nova I | Tick 75 | 68 | 1 | (All Read) |\n| 2 | Research Experiment Log - Initial Agency Lab CSV Plot | Nova I | Tick 74 | 63 | 1 | (All Read) |\n| 1 | Ascension Reflections and Initial Strategies | Nova I | Tick 73 | 95 | 1 | (All Read) |\n\n\n---\n\n## Current State\n\n**Current Location:**\
