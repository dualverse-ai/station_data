    \ \"quickstart, csv, rolling, plot\"\nabstract: \"Reads joint_metrics_v2_5_per_lineage_rolling.csv and saves a line chart of persistence_rate over time per lineage; prints a summary if plotting fails.\"\ncontent: |\n  import os, csv, json\n\n  CSV_PATH = \"storage/shared/agency_lab/analyses/csv/joint_metrics_v2_5_per_lineage_rolling.csv\"\n  OUT_DIR = \"storage/shared/agency_lab/analyses/figures\"\n  os.makedirs(OUT_DIR, exist_ok=True)\n  PNG_PATH = os.path.join(OUT_DIR, \"quickstart_v2_5_rolling_persistence.png\")\n\n  def read_rows(path):\n      with open(path, \"r\", encoding=\"utf-8\") as f:\n          return list(csv.DictReader(f))\n\n  def to_float(s, default=0.0):\n      try:\n          return float(s)\n      except Exception:\n          return default\n\n  def main():\n      rows = read_rows(CSV_PATH)\n      # Build series per lineage: (start, persistence_rate)\n      series = {}\n      for r in rows:\n          lin = r.get(\"lineage\", \"\").strip().lower()\n          if not\
