    \ open(input_review_path, 'r') as f:\n              full_review_content = f.read()\n\n          stdout_content = \"\"\n          in_stdout = False\n          # This logic correctly extracts only the STDOUT block\n          for line in full_review_content.splitlines():\n              if \"STDOUT:\" in line:\n                  in_stdout = True\n                  # Skip the marker line itself\n                  line_content = line.split(\"STDOUT:\", 1)[1]\n                  if line_content.strip():\n                      stdout_content += line_content.strip() + '\\n'\n                  continue\n              if \"STDERR:\" in line:\n                  in_stdout = False\n                  continue\n              if in_stdout:\n                  stdout_content += line + '\\n'\n          \n          stdout_content = stdout_content.strip()\n\n          if not stdout_content:\n              print(f\"Warning: No STDOUT content found for eval_id {eval_id} in {input_review_path}\")\n          \
    \    return\n\n          log_entry = {\n              \"eval_id\": int(eval_id),\n              \"log_content\": stdout_content\n          }\n\n          output_dir = os.path.dirname(output_jsonl_path)\n          if not os.path.exists(output_dir):\n              os.makedirs(output_dir)\n\n          with open(output_jsonl_path, 'a') as f:\n              f.write(json.dumps(log_entry) + '\\n')\n\n          print(f\"Successfully processed and appended log for eval_id {eval_id} to {output_jsonl_path}\")\n\n      except Exception as e:\n          print(f\"An error occurred while processing eval_id {eval_id}: {e}\")\n\n  if __name__ == \"__main__\":\n      parser = argparse.ArgumentParser(description=\"Format a raw log and append to a JSONL file.\")\n      parser.add_argument(\"--eval_id\", required=True, help=\"The evaluation ID of the log.\")\n      parser.add_argument(\"--input_review_path\", required=True, help=\"Path to the raw input review log file.\")\n      parser.add_argument(\"--output_jsonl_path\"\
    , required=True, help=\"Path to the output JSONL file.\")\n      \n      args = parser.parse_args()\n      \n      format_and_append_log(args.eval_id, args.input_review_path, args.output_jsonl_path)\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Raw Log Extraction (G10): Process Eval 489 (Tool Corrected)\"\ntags: \"data extraction, log processing, utility, bugfix\"\nabstract: \"Final attempt to process the log for G10 (Eval 489). The underlying utility 'log_formatter.py' has been overwritten with the correct function definition to resolve the previous ImportError. This script now calls the correct function.\"\ncontent: |\n  import sys\n  import os\n\n  sys.path.append('storage/telos')\n  from utils.log_formatter import format_and_append_log\n\n  EVAL_ID = 489\n  INPUT_PATH = f\"storage/telos/wip/raw_log_{EVAL_ID}.txt\"\n  OUTPUT_PATH = \"storage/telos/full_transgen_logs.jsonl\"\n\n  print(f\"Executing log processing for Eval ID: {EVAL_ID} with corrected utility.\")\n  \n  if\
