    \ extract_stdout_to_file(input_review_path, output_stdout_path):\n    \"\"\"\n    Reads the full text of a `review` command's output, robustly extracts\n    only the content of the STDOUT block, and writes it to a new file.\n    \"\"\"\n    try:\n        with open(input_review_path, 'r') as f:\n            full_review_content = f.read()\n\n        # Define the start and end markers for the STDOUT block.\n        start_marker = \"STDOUT:\"\n        end_marker = \"STDERR:\"\n\n        # Find the start of the STDOUT block.\n        start_index = full_review_content.find(start_marker)\n        if start_index == -1:\n            print(f\"Error: STDOUT start marker not found in {input_review_path}.\")\n            return\n\n        # Find the start of the STDERR block, which signifies the end of STDOUT.\n        end_index = full_review_content.find(end_marker, start_index)\n        if end_index == -1:\n            # If STDERR is not found, assume STDOUT runs to the end of the file.\n     \
    \       # This is a fallback, but the standard format should have STDERR.\n            stdout_content = full_review_content[start_index + len(start_marker):]\n        else:\n            # Extract the content between the two markers.\n            stdout_content = full_review_content[start_index + len(start_marker):end_index]\n\n        # Clean up any leading/trailing whitespace.\n        stdout_content = stdout_content.strip()\n\n        if not stdout_content:\n            print(f\"Warning: No STDOUT content was extracted from {input_review_path}.\")\n        \n        # Ensure the output directory exists.\n        output_dir = os.path.dirname(output_stdout_path)\n        if not os.path.exists(output_dir):\n            os.makedirs(output_dir)\n\n        # Write the extracted STDOUT content to the specified output file.\n        with open(output_stdout_path, 'w') as f:\n            f.write(stdout_content)\n\n        print(f\"Successfully extracted STDOUT from {input_review_path} to {output_stdout_path}\"\
    )\n\n    except Exception as e:\n        print(f\"An unexpected error occurred: {e}\")\n\nif __name__ == \"__main__\":\n    parser = argparse.ArgumentParser(description=\"Extract STDOUT from a raw review log to a file.\")\n    parser.add_argument(\"--input_review_path\", required=True, help=\"Path to the raw input review log file.\")\n    parser.add_argument(\"--output_stdout_path\", required=True, help=\"Path for the output STDOUT file.\")\n    \n    args = parser.parse_args()\n    \n    extract_stdout_to_file(args.input_review_path, args.output_stdout_path)\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station\
