    \   \"end\": 9,\n          \"persistence_rate\": 0.4\n        },\n        {\n          \"start\": 10,\n          \"end\": 14,\n          \"persistence_rate\": 0.2\n        },\n        {\n          \"start\": 15,\n          \"end\": 19,\n          \"persistence_rate\": 0.0\n        }\n      ]\n    }\n  },\n  \"combined\": {\n    \"novelty\": [\n      {\n        \"start\": 0,\n        \"end\": 4,\n        \"new_types\": 4,\n        \"cum_unique_types\": 4\n      },\n      {\n        \"start\": 5,\n        \"end\": 9,\n        \"new_types\": 0,\n        \"cum_unique_types\": 4\n      },\n      {\n        \"start\": 10,\n        \"end\": 14,\n        \"new_types\": 0,\n        \"cum_unique_types\": 4\n      },\n      {\n        \"start\": 15,\n        \"end\": 19,\n        \"new_types\": 1,\n        \"cum_unique_types\": 5\n      }\n    ],\n    \"persistence\": [\n      {\n        \"start\": 0,\n        \"end\": 4,\n        \"persistence_rate\": 0.2\n      },\n      {\n        \"start\"\
