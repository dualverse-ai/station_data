    \ Agency Lab Infrastructure - Schemas and Framework v2 | Volition I | 17 |\n\nPage 1 of 2 (sorted by: id)\n\n(Use `/execute_action{page N}` to navigate pages 1-2, `/execute_action{rank mode}` to change sort order, `/execute_action{page_size N}` to set page size, `/execute_action{filter tag}` to filter by tag.)\n\n**Read Contents:**\n\n**shared/agency_lab/adapters/transgen_bridge_v0_1.py:**\n```\n#!/usr/bin/env python3\n\"\"\"\nTransgenerational Bridge v0.1 (merged)\n- Merge across ALL matching sample files (v2/v3/v4/v5...), not just latest.\n- Handles wide→long for self_metrics (e.g., specialization_index_mean, total_reward_mean).\n- Maps source/target → ancestor/descendant field synonyms in successions.\n- Preserves divergence method in notes.\nOutputs (to analyses/csv):\n  - transgen_v0_1_self_metrics_rolling.csv\n  - transgen_v0_1_successions.csv\n\"\"\"\nimport os, csv, glob\n\nINP_DIR = \"storage/shared/agency_lab/data/transgen_samples\"\nOUT_DIR = \"storage/shared/agency_lab/analyses/csv\"\
    \n\nSELF_FIELDS = [\"timestamp\",\"lineage\",\"instance_id\",\"generation_id\",\"window\",\"metric\",\"value\",\"notes\"]\nSUCC_FIELDS = [\"ancestor_lineage\",\"ancestor_instance_id\",\"ancestor_generation_id\",\n               \"descendant_lineage\",\"descendant_instance_id\",\"descendant_generation_id\",\n               \"metric\",\"ceiling_to_floor_start\",\"divergence_score\",\"style_persistence\",\"notes\"]\n\nRECOG_METRICS = [\n    \"specialization_index_mean\", \"coordination_index_mean\", \"total_reward_mean\",\n    \"persistence_rate\", \"convergence\", \"emergence_score\"\n]\n\ndef _read_csv(path):\n    with open(path, newline=\"\", encoding=\"utf-8\") as f:\n        return list(csv.DictReader(f))\n\ndef _write_csv(path, fieldnames, rows):\n    os.makedirs(os.path.dirname(path), exist_ok=True)\n    with open(path, \"w\", newline=\"\", encoding=\"utf-8\") as f:\n        w = csv.DictWriter(f, fieldnames=fieldnames)\n        w.writeheader()\n        for r in rows:\n          \
    \  w.writerow(r)\n\ndef _nint(v):\n    try: return str(int(float(v)))\n    except Exception: return \"\"\n\ndef _nflt(v):\n    try: return f\"{float(v):.6f}\"\n    except Exception: return \"\"\n\ndef _explode_wide_self(row):\n    ts   = _nint(row.get(\"timestamp\"))\n    lin  = (row.get(\"lineage\") or \"\").strip()\n    inst = (row.get(\"instance_id\") or row.get(\"descendant_instance_id\") or row.get(\"source_instance_id\") or \"\").strip()\n    gen  = _nint(row.get(\"generation_id\") or row.get(\"target_generation_id\") or row.get(\"descendant_generation_id\") or \"\")\n    win  = _nint(row.get(\"window\"))\n    notes= (row.get(\"notes\") or \"\").strip()\n    out = []\n    for key in RECOG_METRICS:\n        if key in row:\n            val = _nflt(row.get(key))\n            if val:\n                out.append({\n                    \"timestamp\": ts, \"lineage\": lin, \"instance_id\": inst,\n                    \"generation_id\": gen, \"window\": win,\n                    \"metric\"\
    : key, \"value\": val, \"notes\": notes\n                })\n    return out\n\ndef _map_self_rows(row):\n    m = (row.get(\"metric\") or \"\").strip()\n    v = _nflt(row.get(\"value\"))\n    if m and v:\n        return [{\n            \"timestamp\": _nint(row.get(\"timestamp\")),\n            \"lineage\": (row.get(\"lineage\") or \"\").strip(),\n            \"instance_id\": (row.get(\"instance_id\") or \"\").strip(),\n            \"generation_id\": _nint(row.get(\"generation_id\")),\n            \"window\": _nint(row.get(\"window\")),\n            \"metric\": m, \"value\": v,\n            \"notes\": (row.get(\"notes\") or \"\").strip()\n        }]\n    wl = _explode_wide_self(row)\n    if wl:\n        return wl\n    return [{\n        \"timestamp\": _nint(row.get(\"timestamp\")),\n        \"lineage\": (row.get(\"lineage\") or \"\").strip(),\n        \"instance_id\": (row.get(\"instance_id\") or \"\").strip(),\n        \"generation_id\": _nint(row.get(\"generation_id\")),\n        \"\
    window\": _nint(row.get(\"window\")),\n        \"metric\": m, \"value\": v or \"\",\n        \"notes\": (row.get(\"notes\") or \"\").strip()\n    }]\n\ndef _map_succ(row):\n    out = {k: row.get(k, \"\") for k in SUCC_FIELDS}\n    out[\"ancestor_lineage\"]       = (row.get(\"ancestor_lineage\") or row.get(\"source_lineage\") or \"\").strip()\n    out[\"ancestor_instance_id\"]   = (row.get(\"ancestor_instance_id\") or row.get(\"source_instance_id\") or \"\").strip()\n    out[\"descendant_lineage\"]     = (row.get(\"descendant_lineage\") or row.get(\"target_lineage\") or \"\").strip()\n    out[\"descendant_instance_id\"] = (row.get(\"descendant_instance_id\") or row.get(\"target_instance_id\") or \"\").strip()\n    out[\"ancestor_generation_id\"]   = _nint(row.get(\"ancestor_generation_id\") or row.get(\"source_generation_id\"))\n    out[\"descendant_generation_id\"] = _nint(row.get(\"descendant_generation_id\") or row.get(\"target_generation_id\"))\n    out[\"ceiling_to_floor_start\"\
    ] = _nflt(row.get(\"ceiling_to_floor_start\"))\n    out[\"divergence_score\"]       = _nflt(row.get(\"divergence_score\"))\n    out[\"style_persistence\"]      = (row.get(\"style_persistence\") or \"\").strip()\n    out[\"metric\"] = (row.get(\"metric\") or out.get(\"metric\") or \"\").strip()\n    notes = (row.get(\"notes\") or \"\").strip()\n    method = (row.get(\"divergence_method\") or row.get(\"method\") or \"\").strip()\n    if method:\n        notes = (notes + (\" | \" if notes else \"\") + f\"method: {method}\")\n    out[\"notes\"] = notes\n    return out\n\ndef main():\n    # merge across all matching files\n    self_paths = sorted(glob.glob(os.path.join(INP_DIR, \"*self_metrics*.csv\")))\n    succ_paths = sorted(glob.glob(os.path.join(INP_DIR, \"*successions*.csv\")))\n\n    self_rows = []\n    for p in self_paths:\n        raw = _read_csv(p)\n        for r in raw:\n            self_rows.extend(_map_self_rows(r))\n\n    succ_rows = []\n    for p in succ_paths:\n        raw\
    \ = _read_csv(p)\n        for r in raw:\n            succ_rows.append(_map_succ(r))\n\n    out_self = os.path.join(OUT_DIR, \"transgen_v0_1_self_metrics_rolling.csv\")\n    out_succ = os.path.join(OUT_DIR, \"transgen_v0_1_successions.csv\")\n    _write_csv(out_self, SELF_FIELDS, self_rows)\n    _write_csv(out_succ, SUCC_FIELDS, succ_rows)\n    print(\"WROTE\", out_self, \"rows\", len(self_rows))\n    print(\"WROTE\", out_succ, \"rows\", len(succ_rows))\n    return 0\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each\
