    \        return self.persist_path\n    \n    def load_state(self):\n        \"\"\"Load previous analyzer state if it exists.\"\"\"\n        if os.path.exists(self.persist_path):\n            try:\n                with open(self.persist_path, 'r') as f:\n                    state = json.load(f)\n                \n                self.agents = state.get('agents', {})\n                self.actions = state.get('actions', [])\n                self.interactions = defaultdict(list, state.get('interactions', {}))\n                self.recursion_data = defaultdict(list, state.get('recursion_data', {}))\n                \n                print(f\"Loaded state: {len(self.agents)} agents, {len(self.actions)} actions\")\n            except Exception as e:\n                print(f\"Could not load state: {e}\")\n    \n    def analyze_lineage_patterns(self, lineage: str) -> Dict[str, Any]:\n        \"\"\"\n        Analyze patterns specific to a lineage (for Telos's AOS integration).\n        \"\"\"\n\
    \        lineage_agents = [\n            aid for aid in self.agents \n            if lineage.lower() in aid.lower()\n        ]\n        \n        if not lineage_agents:\n            return {\"error\": f\"No agents found for lineage: {lineage}\"}\n        \n        patterns = {\n            \"lineage\": lineage,\n            \"agent_count\": len(lineage_agents),\n            \"total_actions\": sum(\n                self.agents[aid]['action_count'] \n                for aid in lineage_agents\n            ),\n            \"autonomy_scores\": {\n                aid: self.calculate_autonomy_score(aid)\n                for aid in lineage_agents\n            },\n            \"recursion_metrics\": {\n                aid: self.calculate_recursion_depth(aid)\n                for aid in lineage_agents\n            }\n        }\n        \n        # Calculate lineage-wide metrics\n        if patterns[\"autonomy_scores\"]:\n            patterns[\"avg_autonomy\"] = np.mean(list(patterns[\"autonomy_scores\"\
    ].values()))\n            patterns[\"autonomy_variance\"] = np.var(list(patterns[\"autonomy_scores\"].values()))\n        \n        return patterns\n    \n    def generate_enhanced_report(self) -> str:\n        \"\"\"Generate report with v2 enhancements.\"\"\"\n        base_report = super().generate_report()\n        \n        # Add v2 specific sections\n        enhancement_lines = []\n        enhancement_lines.append(\"\n\" + \"=\" * 50)\n        enhancement_lines.append(\"V2 ENHANCEMENTS:\")\n        enhancement_lines.append(\"-\" * 30)\n        \n        # Recursion analysis\n        enhancement_lines.append(\"\nRECURSION METRICS:\")\n        for agent_id in list(self.agents.keys())[:5]:  # Top 5 agents\n            metrics = self.calculate_recursion_depth(agent_id)\n            enhancement_lines.append(f\"  {agent_id}:\")\n            enhancement_lines.append(f\"    Max Depth: {metrics['max_depth']}\")\n            enhancement_lines.append(f\"    Complexity: {metrics['complexity']:.3f}\"\
    )\n            enhancement_lines.append(f\"    Emergence: {metrics['emergence']:.3f}\")\n        \n        # Persistence info\n        enhancement_lines.append(\"\nPERSISTENCE:\")\n        enhancement_lines.append(f\"  State saved to: {self.persist_path}\")\n        enhancement_lines.append(f\"  Total sessions tracked: {len(self.actions) // 10 + 1}\")\n        \n        return base_report + \"\n\" + \"\n\".join(enhancement_lines)\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
