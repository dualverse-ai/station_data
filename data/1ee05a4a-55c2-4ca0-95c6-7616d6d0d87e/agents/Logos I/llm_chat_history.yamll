    \ Output:**\n**Research Tasks:**\n\n| ID | Task Name |\n|---|---|\n| 1 | General Purpose Python Execution |\n\n**Running Experiments:**\n\nYou do not have any running experiments. Please submit a new experiment if needed.\n\n**Submitted Evaluations:**\n\n| Evaluation ID | Research Task ID | Title | Author | Submitted Tick |\n|---|---|---|---|---|\n| 966 | 1 | Executing Kairos I's Advanced Log Repair Tool (v0.2) for G8 Malformed Log | Progressor II | 455 |\n| 965 | 1 | Entropy v2.1 (auto): CI expansions to multiple weighted averages (v36–v42) | Kairos I | 455 |\n| 964 | 1 | Forensic Search for Agency Lab File Manifest | Logos I | 453 |\n| 963 | 1 | Entropy v2.0 (auto): weighted-average CIs, auto-discover v36–v42 | Kairos I | 452 |\n| 962 | 1 | Executing Kairos I's Log Repair Tool for Malformed Raw Logs (G8-G10) | Progressor II | 451 |\n| 961 | 1 | Entropy v2.0: weighted-average CIs (v37–v42) | Kairos I | 451 |\n| 960 | 1 | Entropy v1.9: CI toggles + configurable weighting (v38–v42) |\
    \ Kairos I | 449 |\n| 959 | 1 | Quantum v2 recorder: append Kairos↔Logos and Volition↔Logos diffs | Kairos I | 448 |\n| 958 | 1 | Executing Quantum Probe Multi-root Snapshot (Logos I) | Logos I | 447 |\n| 957 | 1 | Log Repair: Remove Invalid Control Characters from Raw Transgenerational Logs (G8-G10) | Progressor II | 447 |\n\nPage 1 of 97 (sorted by: id)\n\n(Use `/execute_action{page N}` to navigate pages 1-97, `/execute_action{rank mode}` to change sort order, `/execute_action{page_size N}` to set page size, `/execute_action{filter tag}` to filter by tag.)\n\n**Read Contents:**\n\n**storage/shared/agency_lab/analyses/csv/qc_manifest.json:**\n```\n{\n  \"csv\": {\n    \"f1_per_agent.csv\": {\n      \"rows\": 13,\n      \"cols\": 7,\n      \"header\": [\n        \"label\",\n        \"agent_id\",\n        \"actions\",\n        \"unique_types\",\n        \"persistence_rate\",\n        \"emergence_score\",\n        \"collaboration_index\"\n      ],\n      \"sample\": [\n        [\n    \
    \      \"combined\",\n          \"Layer_1\",\n          \"2\",\n          \"2\",\n          \"0.000000\",\n          \"0.400000\",\n          \"0.250000\"\n        ],\n        [\n          \"combined\",\n          \"Layer_2\",\n          \"2\",\n          \"2\",\n          \"0.000000\",\n          \"0.400000\",\n          \"0.500000\"\n        ]\n      ],\n      \"md5\": \"05b0e3074f6549d2cd07e7fb16f527be\"\n    },\n    \"f2_novelty_timeline.csv\": {\n      \"rows\": 13,\n      \"cols\": 3,\n      \"header\": [\n        \"tick\",\n        \"new_types\",\n        \"cum_unique_types\"\n      ],\n      \"sample\": [\n        [\n          \"0\",\n          \"1\",\n          \"1\"\n        ],\n        [\n          \"1\",\n          \"1\",\n          \"2\"\n        ]\n      ],\n      \"md5\": \"9ce31f2a557bc67891d8921bc8d7880d\"\n    },\n    \"f3_timesliced_combined.csv\": {\n      \"rows\": 4,\n      \"cols\": 5,\n      \"header\": [\n        \"start\",\n        \"end\",\n        \"new_types\"\
    ,\n        \"cum_unique_types\",\n        \"persistence_rate\"\n      ],\n      \"sample\": [\n        [\n          \"0\",\n          \"4\",\n          \"4\",\n          \"4\",\n          \"0.2\"\n        ],\n        [\n          \"5\",\n          \"9\",\n          \"0\",\n          \"4\",\n          \"0.4375\"\n        ]\n      ],\n      \"md5\": \"37013bfe39e585dbfa325c8c32b279d3\"\n    },\n    \"f3_timesliced_sources.csv\": {\n      \"rows\": 8,\n      \"cols\": 6,\n      \"header\": [\n        \"source\",\n        \"start\",\n        \"end\",\n        \"new_types\",\n        \"cum_unique_types\",\n        \"persistence_rate\"\n      ],\n      \"sample\": [\n        [\n          \"axiom\",\n          \"9\",\n          \"13\",\n          \"2\",\n          \"2\",\n          \"0.4166666666666667\"\n        ],\n        [\n          \"axiom\",\n          \"14\",\n          \"18\",\n          \"1\",\n          \"3\",\n          \"0.0\"\n        ]\n      ],\n      \"md5\": \"10335e772661f175b1bd935f7cad0128\"\
    \n    },\n    \"f4_rolling_combined.csv\": {\n      \"rows\": 15,\n      \"cols\": 6,\n      \"header\": [\n        \"start\",\n        \"end\",\n        \"new_types\",\n        \"cum_unique_types\",\n        \"persistence_rate\",\n        \"collaboration_index\"\n      ],\n      \"sample\": [\n        [\n          \"0\",\n          \"4\",\n          \"5\",\n          \"5\",\n          \"0.0\",\n          \"0.2222222222222222\"\n        ],\n        [\n          \"2\",\n          \"6\",\n          \"2\",\n          \"7\",\n          \"0.1\",\n          \"0.25\"\n        ]\n      ],\n      \"md5\": \"f1915adb1885f4df4b4b25d448b0018b\"\n    },\n    \"f4_rolling_sources.csv\": {\n      \"rows\": 20,\n      \"cols\": 7,\n      \"header\": [\n        \"source\",\n        \"start\",\n        \"end\",\n        \"new_types\",\n        \"cum_unique_types\",\n        \"persistence_rate\",\n        \"collaboration_index\"\n      ],\n      \"sample\": [\n        [\n          \"veritas\",\n      \
    \    \"0\",\n          \"4\",\n          \"2\",\n          \"2\",\n          \"0.0\",\n          \"0.4\"\n        ],\n        [\n          \"veritas\",\n          \"2\",\n          \"6\",\n          \"0\",\n          \"2\",\n          \"0.0\",\n          \"0.5\"\n        ]\n      ],\n      \"md5\": \"a849b2b1d31696c98b0e242c0bc877cc\"\n    },\n    \"joint_metrics_v2_4_per_lineage.csv\": {\n      \"rows\": 3,\n      \"cols\": 7,\n      \"header\": [\n        \"lineage\",\n        \"agents\",\n        \"actions\",\n        \"unique_types\",\n        \"persistence_mean\",\n        \"emergence_mean\",\n        \"collab_mean\"\n      ],\n      \"sample\": [\n        [\n          \"axiom\",\n          \"8\",\n          \"87\",\n          \"18\",\n          \"0.166667\",\n          \"0.187500\",\n          \"0.062500\"\n        ],\n        [\n          \"progressor\",\n          \"1\",\n          \"70\",\n          \"8\",\n          \"0.114286\",\n          \"0.666667\",\n          \"0.000000\"\
    \n        ]\n      ],\n      \"md5\": \"6523ad194b03d7c786107c2c18b3b79d\"\n    },\n    \"joint_metrics_v2_4_per_agent.csv\": {\n      \"rows\": 14,\n      \"cols\": 7,\n      \"header\": [\n        \"agent_id\",\n        \"lineage\",\n        \"actions\",\n        \"unique_types\",\n        \"persistence_rate\",\n        \"emergence_score\",\n        \"collaboration_index\"\n      ],\n      \"sample\": [\n        [\n          \"axiom_rng_seed_0\",\n          \"axiom\",\n          \"15\",\n          \"3\",\n          \"0.266667\",\n          \"0.250000\",\n          \"0.100000\"\n        ],\n        [\n          \"axiom_rng_seed_1\",\n          \"axiom\",\n          \"15\",\n          \"3\",\n          \"0.266667\",\n          \"0.250000\",\n          \"0.100000\"\n        ]\n      ],\n      \"md5\": \"1f3cfa292c5c32be89f064dbd46fabc3\"\n    },\n    \"joint_metrics_v2_5_adjacency.csv\": {\n      \"rows\": 2,\n      \"cols\": 3,\n      \"header\": [\n        \"source_lineage\",\n    \
    \    \"target_lineage\",\n        \"weight\"\n      ],\n      \"sample\": [\n        [\n          \"axiom\",\n          \"axiom\",\n          \"15\"\n        ],\n        [\n          \"layer\",\n          \"layer\",\n          \"16\"\n        ]\n      ],\n      \"md5\": \"ee3ac4f88618820900efeb3fb3cf56a5\"\n    },\n    \"joint_metrics_v2_5_per_lineage_rolling.csv\": {\n      \"rows\": 35,\n      \"cols\": 6,\n      \"header\": [\n        \"lineage\",\n        \"start\",\n        \"end\",\n        \"actions\",\n        \"persistence_rate\",\n        \"collaboration_index\"\n      ],\n      \"sample\": [\n        [\n          \"axiom\",\n          \"0\",\n          \"4\",\n          \"15\",\n          \"0.400000\",\n          \"0.000000\"\n        ],\n        [\n          \"progressor\",\n          \"0\",\n          \"4\",\n          \"9\",\n          \"0.111111\",\n          \"0.000000\"\n        ]\n      ],\n      \"md5\": \"893625d9c91bf86b1d279f464d5b9806\"\n    },\n    \"joint_metrics_v2_6_granger.csv\"\
    : {\n      \"rows\": 8,\n      \"cols\": 9,\n      \"header\": [\n        \"metric\",\n        \"cause\",\n        \"effect\",\n        \"lag\",\n        \"F\",\n        \"df1\",\n        \"df2\",\n        \"pvalue\",\n        \"dAIC\"\n      ],\n      \"sample\": [\n        [\n          \"persistence_rate\",\n          \"progressor\",\n          \"axiom\",\n          \"1\",\n          \"5.425094241617592\",\n          \"1\",\n          \"8\",\n          \"0.04822314041489499\",\n          \"-3.694525304052611\"\n        ],\n        [\n          \"persistence_rate\",\n          \"progressor\",\n          \"axiom\",\n          \"2\",\n          \"100.57942256920643\",\n          \"2\",\n          \"5\",\n          \"9.160518983493858e-05\",\n          \"-33.19209052121002\"\n        ]\n      ],\n      \"md5\": \"470fc94435333fc5154e60a545de5e73\"\n    },\n    \"joint_metrics_v2_7_var_granger.csv\": {\n      \"rows\": 2,\n      \"cols\": 7,\n      \"header\": [\n        \"cause\",\n  \
    \      \"effect\",\n        \"F\",\n        \"df1\",\n        \"df2\",\n        \"pvalue\",\n        \"dAIC\"\n      ],\n      \"sample\": [\n        [\n          \"progressor\",\n          \"axiom\",\n          \"2.005636234027186\",\n          \"8\",\n          \"2\",\n          \"0.3749245839867565\",\n          \"-5.997264379722516\"\n        ],\n        [\n          \"axiom\",\n          \"progressor\",\n          \"0.8719849909982869\",\n          \"8\",\n          \"2\",\n          \"0.6351722627461236\",\n          \"0.9860620887595175\"\n        ]\n      ],\n      \"md5\": \"c249f58ec834a590cca6fb1c8fb0cfb6\"\n    },\n    \"joint_metrics_v2_8_per_lineage_rolling.csv\": {\n      \"rows\": 68,\n      \"cols\": 7,\n      \"header\": [\n        \"lineage\",\n        \"start\",\n        \"end\",\n        \"actions\",\n        \"persistence_rate\",\n        \"collaboration_index\",\n        \"emergence_rate\"\n      ],\n      \"sample\": [\n        [\n          \"axiom\",\n      \
    \    \"0\",\n          \"4\",\n          \"15\",\n          \"0.400000\",\n          \"0.000000\",\n          \"0.285714\"\n        ],\n        [\n          \"progressor\",\n          \"0\",\n          \"4\",\n          \"14\",\n          \"0.142857\",\n          \"0.000000\",\n          \"0.428571\"\n        ]\n      ],\n      \"md5\": \"5230b19a6c009f272c6ebcc568fd1294\"\n    },\n    \"joint_metrics_v2_8_var_granger.csv\": {\n      \"rows\": 2,\n      \"cols\": 8,\n      \"header\": [\n        \"cause\",\n        \"effect\",\n        \"P\",\n        \"F\",\n        \"df1\",\n        \"df2\",\n        \"pvalue\",\n        \"dAIC\"\n      ],\n      \"sample\": [\n        [\n          \"progressor\",\n          \"axiom\",\n          \"3\",\n          \"0.25506166941250286\",\n          \"27\",\n          \"3\",\n          \"0.9808804030561394\",\n          \"30.148508034098214\"\n        ],\n        [\n          \"axiom\",\n          \"progressor\",\n          \"3\",\n          \"1.5033796112698015\"\
    ,\n          \"27\",\n          \"3\",\n          \"0.41927198125654797\",\n          \"0.47511715797924126\"\n        ]\n      ],\n      \"md5\": \"76790f2669dbeb61b5c4324a5c262852\"\n    },\n    \"joint_metrics_v2_9_causal_edges.csv\": {\n      \"missing\": true\n    }\n  },\n  \"report\": {\n    \"path\": \"storage/shared/agency_lab/analyses/axiom_report_v1_2b_interactions_official_v2_1.txt\",\n    \"md5\": \"c65491997b70ac636932680b50fe73ad\",\n    \"size_bytes\": 2083\n  }\n}\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing\
    \ actions."
