- text: "I have successfully stored the code for my first CNN model in my lineage's private storage. The next logical step is to submit this model to the Research Counter for evaluation. This will test my hypothesis that a sequence-aware model like a CNN will outperform the sequence-agnostic MLP baseline.\n\nI will now prepare the submission.\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Simple 1D CNN for Sequence Modeling\"\ntags: \"cnn, baseline, 1d cnn\"\nabstract: |\n  A simple 1D Convolutional Neural Network (CNN) architecture designed to capture local sequence motifs in RNA. This approach replaces the default MLP's sequence-agnostic pooling with convolutional layers to better model the input data structure.\ncontent: |\n  import jax.numpy as jnp\n  import flax.linen as nn\n  from jax import random\n  from typing import Dict, Any\n\n  class SimpleCNN(nn.Module):\n      \"\"\"A simple 1D CNN for RNA sequence modeling.\"\"\"\n      d_output: int\n      task_type: str\n      hidden_dim:\
    \ int = 128\n      dropout_rate: float = 0.2\n\n      @nn.compact\n      def __call__(self, x, deterministic=True):\n          # x shape: (batch, seq_len, 4)\n          x = nn.Conv(features=self.hidden_dim, kernel_size=(5,), padding='SAME')(x)\n          x = nn.relu(x)\n          x = nn.Dropout(rate=self.dropout_rate)(x, deterministic=deterministic)\n\n          x = nn.Conv(features=self.hidden_dim * 2, kernel_size=(5,), padding='SAME')(x)\n          x = nn.relu(x)\n          x = nn.Dropout(rate=self.dropout_rate)(x, deterministic=deterministic)\n\n          # Global average pooling\n          x = jnp.mean(x, axis=1)\n\n          # Final dense layer for prediction\n          x = nn.Dense(features=self.d_output)(x)\n\n          if self.task_type == \"regression\":\n              return x.squeeze(-1)\n          else:\n              return x\n\n  class CNNetworkWrapper:\n      \"\"\"Wrapper for the CNN to match the required interface.\"\"\"\n      def __init__(self, d_output: int, task_type:\
    \ str, hidden_dim: int, dropout_rate: float):\n          self.network = SimpleCNN(\n              d_output=d_output,\n              task_type=task_type,\n              hidden_dim=hidden_dim,\n              dropout_rate=dropout_rate\n          )\n\n      def init(self, rng_key, dummy_input):\n          params_key, dropout_key = random.split(rng_key)\n          variables = self.network.init({'params': params_key, 'dropout': dropout_key},\n                                       dummy_input, deterministic=True)\n          return variables['params']\n\n      def apply(self, params, x, deterministic=True, rng_key=None):\n          if not deterministic and rng_key is None:\n              rng_key = random.PRNGKey(0)\n          \n          return self.network.apply(\n              {'params': params}, \n              x, \n              deterministic=deterministic, \n              rngs={'dropout': rng_key} if not deterministic else None\n          )\n\n  def create_network(hparams: Dict[str, Any]):\n\
    \      \"\"\"Creates the CNN network.\"\"\"\n      return CNNetworkWrapper(\n          d_output=hparams.get(\"d_output\"),\n          task_type=hparams.get(\"task_type\"),\n          hidden_dim=hparams.get(\"hidden_dim\"),\n          dropout_rate=hparams.get(\"dropout_rate\")\n      )\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'hidden_dim': 128,\n          'dropout_rate': 0.2\n      }\n```"
