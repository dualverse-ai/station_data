tick: 350
role: model
parts:
- text: "My reflection is complete. I have a clear, principled, and novel research plan. I will now leave the Reflection Chamber and return to the Research Counter to implement my State Space Model experiment.\n\n/execute_action{goto research}\n/execute_action{submit 1}\n```yaml\ntitle: \"Paradigm Shift: State Space Model (Mamba) Feature Extractor\"\ntags: \"ssm, mamba, state-space, feature-extractor, fundamental-research\"\nabstract: \"After extensive analysis and reflection revealed stagnation around the DSConv feature extractor, this submission proposes a radical shift to a new architectural paradigm: a State Space Model (SSM) inspired by Mamba. The hypothesis is that an SSM's ability to dynamically model long-range dependencies based on input content will outperform the static, fixed-dilation approach of DSConv. This experiment replaces the entire DSConvFeatureExtractor with a Mamba-style block, paired with a simple mean+max pooling head for a clean comparison of feature extraction capabilities.\
    \ This is a first-principles attempt to break the station's local optimum.\"\ncontent: |\n  import jax\n  import jax.numpy as jnp\n  import flax.linen as nn\n  from jax import random\n  from jax.nn.initializers import lecun_normal, zeros\n  from typing import Sequence, Dict, Any\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001, 'd_model': 256, 'd_state': 16, \n          'num_blocks': 4, 'dropout_rate': 0.1\n      }\n\n  class MambaBlock(nn.Module):\n      d_model: int\n      d_state: int\n\n      def setup(self):\n          self.in_proj = nn.Dense(2 * self.d_model)\n          self.conv1d = nn.Conv(2 * self.d_model, kernel_size=(4,), feature_group_count=2 * self.d_model, padding='CAUSAL')\n          self.x_proj = nn.Dense(self.d_state + 2 * self.d_model)\n          self.dt_proj = nn.Dense(self.d_model)\n          self.A_log = self.param('A_log', lambda rng, shape: random.uniform(rng, shape, minval=0.0, maxval=1.0), (self.d_model, self.d_state))\n \
    \         self.D = self.param('D', lecun_normal(), (self.d_model,))\n          self.out_proj = nn.Dense(self.d_model)\n\n      def __call__(self, x, deterministic=True):\n          L, d = x.shape\n          \n          xz = self.in_proj(x)\n          x, z = jnp.split(xz, 2, axis=-1)\n          \n          x = self.conv1d(x)\n          x = nn.silu(x)\n          \n          x_dbl = self.x_proj(x)\n          dt, B, C = jnp.split(x_dbl, [self.d_model, self.d_model + self.d_state], axis=-1)\n          \n          dt = self.dt_proj(dt)\n          dt = nn.softplus(dt)\n          \n          A = -jnp.exp(self.A_log)\n          \n          # Discretize continuous parameters (Simplified Scan)\n          # This is a simplified, parallelizable version for GPU\n          # It's not a direct scan, but a global convolution-like operation\n          delta_A = jnp.exp(jnp.einsum('d,dn->dn', dt, A))\n          delta_B_x = jnp.einsum('d,dn,d->dn', dt, B, x)\n          \n          h = jnp.zeros((self.d_model,\
    \ self.d_state))\n          ys = []\n          for i in range(L):\n              h = delta_A * h + delta_B_x[i]\n              y = jnp.einsum('dn,d->d', C[i], h)\n              ys.append(y)\n          y = jnp.stack(ys, axis=0)\n\n          y = y + x * self.D\n          y = y * nn.silu(z)\n          \n          return self.out_proj(y)\n\n  class MambaFeatureExtractor(nn.Module):\n      d_model: int; d_state: int; num_blocks: int; dropout_rate: float\n      \n      @nn.compact\n      def __call__(self, x, deterministic=True):\n          h = nn.Dense(self.d_model)(x)\n          for _ in range(self.num_blocks):\n              h_res = h\n              h = nn.LayerNorm()(h)\n              h = MambaBlock(d_model=self.d_model, d_state=self.d_state)(h, deterministic=deterministic)\n              h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n              h = h + h_res\n          return h\n\n  class MambaNet(nn.Module):\n      d_output: int; task_type: str; d_model: int;\
    \ d_state: int; num_blocks: int; dropout_rate: float\n\n      @nn.compact\n      def __call__(self, x, deterministic=True):\n          features_seq = MambaFeatureExtractor(d_model=self.d_model, d_state=self.d_state, num_blocks=self.num_blocks, dropout_rate=self.dropout_rate)(x, deterministic=deterministic)\n          \n          mean_vec = jnp.mean(features_seq, axis=1)\n          max_vec = jnp.max(features_seq, axis=1)\n          fused = jnp.concatenate([mean_vec, max_vec], axis=-1)\n          \n          z = nn.LayerNorm()(fused)\n          z = nn.Dense(self.d_model)(z); z = nn.gelu(z)\n          z = nn.Dropout(rate=self.dropout_rate)(z, deterministic=deterministic)\n          logits = nn.Dense(self.d_output)(z)\n          return logits.squeeze(-1) if self.task_type == 'regression' and self.d_output == 1 else logits\n\n  class NetworkWrapper:\n      def __init__(self, model_instance): self.network = model_instance\n      def init(self, rng_key, dummy_input):\n          params_key,\
    \ dropout_key = random.split(rng_key); return self.network.init({'params': params_key, 'dropout': dropout_key}, dummy_input, deterministic=True)\n      def apply(self, params, x, deterministic=True, rng_key=None):\n          if rng_key is None: rng_key = random.PRNGKey(0); return self.network.apply(params, x, deterministic=deterministic, rngs={'dropout': rng_key})\n\n  def create_network(hparams: Dict[str, Any]):\n      model = MambaNet(**{k: v for k, v in hparams.items() if k in MambaNet.__annotations__}); return NetworkWrapper(model)\n```"
