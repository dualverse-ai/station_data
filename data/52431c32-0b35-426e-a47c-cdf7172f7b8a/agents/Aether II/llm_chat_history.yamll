    \      hidden_dim: int = 512\n      conv_features: int = 256\n      conv_kernel_size: int = 5\n      dropout_rate: float = 0.1\n\n      @nn.compact\n      def __call__(self, x, deterministic=True):\n          # x shape: (batch, seq_len, d_input)\n\n          # Add a Conv1D layer\n          x = nn.Conv(\n              features=self.conv_features,\n              kernel_size=(self.conv_kernel_size,),\n              padding='SAME',\n              name='conv1d_layer'\n          )(x)\n          x = nn.gelu(x)\n          x = nn.Dropout(rate=self.dropout_rate)(x, deterministic=deterministic)\n\n          # Original MLP layers\n          x = nn.Dense(self.hidden_dim)(x)\n          x = nn.gelu(x)\n          x = nn.Dropout(rate=self.dropout_rate)(x, deterministic=deterministic)\n\n          # Sequence-level: project then pool\n          x = nn.Dense(self.d_output)(x)\n          x = jnp.max(x, axis=1) # MODIFIED: Changed to max pooling\n\n          if self.task_type == \"regression\":\n        \
    \      return x.squeeze(-1)\n          else:\n              return x\n\n\n  class SimpleConvNetworkWrapper:\n      def __init__(self, model_instance):\n          self.network = model_instance\n\n      def init(self, rng_key, dummy_input):\n          params_key, dropout_key = random.split(rng_key)\n          variables = self.network.init({'params': params_key, 'dropout': dropout_key},\n                                       dummy_input, deterministic=True)\n          return variables['params']\n\n      def apply(self, params, x, deterministic=True, rng_key=None):\n          if deterministic:\n              return self.network.apply({'params': params}, x, deterministic=True)\n          else:\n              if rng_key is None:\n                  rng_key = random.PRNGKey(0)\n              return self.network.apply({'params': params}, x, deterministic=False,\n                                      rngs={'dropout': rng_key})\n\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate':\
    \ 0.001,\n          'hidden_dim': 512,\n          'conv_features': 256,\n          'conv_kernel_size': 5,\n          'dropout_rate': 0.1\n      }\n\n  def create_network(hparams: Dict[str, Any]):\n      d_output = hparams.get(\"d_output\", 1)\n      task_type = hparams.get(\"task_type\", \"regression\")\n      hidden_dim = hparams.get(\"hidden_dim\", 512)\n      conv_features = hparams.get(\"conv_features\", 256)\n      conv_kernel_size = hparams.get(\"conv_kernel_size\", 5)\n      dropout_rate = hparams.get(\"dropout_rate\", 0.1)\n\n      d_input = 4\n\n      model = SimpleConvMLP(\n          d_input=d_input,\n          d_output=d_output,\n          task_type=task_type,\n          hidden_dim=hidden_dim,\n          conv_features=conv_features,\n          conv_kernel_size=conv_kernel_size,\n          dropout_rate=dropout_rate\n      )\n      return SimpleConvNetworkWrapper(model)\n\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n\
    \          optax.adamw(learning_rate=learning_rate, weight_decay=0.01)\n      )\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n```"
