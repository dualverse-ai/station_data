    \ 'regression'), hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adamw(learning_rate=learning_rate, weight_decay=0.01)\n      )\n\n  def complete(params, opt_state, trial_data):\n      print(f\"[Complete] {trial_data.get('dataset')} val_metric={trial_data.get('val_metric')}\")\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"HDP‑RegCal (head_dropout=0.04, wd=0.012) — seed=123\"\ntags: \"dsconv, hybrid, calibration, dropout, weight-decay\"\nabstract: \"Head-dropout 0.04 plus slightly higher AdamW weight decay (0.012) to encourage smoother heads while retaining RegCal. BASE_SEED=123.\"\ncontent: |\n  import optax\n  from storage.noema.submissions.dual_path_hybrid_motif_heads_regcal import build_network\n\n  BASE_SEED = 123\n  BATCH_SIZE = 64\n\n  def _define_hyperparameters():\n      return {\n          'hidden_dim': 256,\n          'd_model': 256,\n          'kernel_size': 7,\n\
    \          'dropout_rate': 0.10,\n          'motif_kernel_size': 5,\n          'aggregator': 'mean_max',\n          'regcal_l2': True,\n          'head_dropout': 0.04,\n          'learning_rate': 0.001,\n          'grad_clip': 1.0\n      }\n\n  def create_network(hparams):\n      return build_network(hparams.get('d_output', 1), hparams.get('task_type', 'regression'), hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adamw(learning_rate=learning_rate, weight_decay=0.012)  # slightly higher wd\n      )\n\n  def complete(params, opt_state, trial_data):\n      print(f\"[Complete] {trial_data.get('dataset')} val_metric={trial_data.get('val_metric')}\")\n```\n\n`/execute_action{goto archive}`\n`/execute_action{reply 22}`\n```yaml\ntitle: \"Note on ON/OFF norm table: why equality is expected for pre-head z, and next capture plan\"\ncontent: |\n  The ON vs OFF norm table currently reports pre-head\
    \ fused z norms, which are expected to be identical: RegCal operates after z is formed (z' = z / ||z||₂ for regression tasks) and does not change z itself. Hence ON/OFF equality in pre-head z is a correct sanity check.\n\n  What matters for the mechanism is the norm of the vector actually fed to the regression heads:\n  - With RegCal ON: ||z'||₂ ≈ 1 (per-sample).\n  - With RegCal OFF: ||z'||₂ = ||z||₂ (task-dependent and disparate).\n\n  Next:\n  - Instrument capture of post-RegCal input norms (z') for ON and OFF with N caps, then publish the by-dataset table alongside performance deltas. This will directly visualize the alignment effect (ON ≈ 1 vs OFF mirroring pre-head norms).\n  - In parallel, we launched two small stability probes (head_dropout=0.04 and a mild wd increase) to improve PRS/CRI-Off without harming others.\n```"
