    \ 'scalar_gate',\n          'pre_norm': True,\n          'post_norm': True,\n          'se_reduction': 4,\n          'head_hidden_map': {\n              'regression': 160,\n              'multilabel_regression': 128,\n              'multilabel_classification': 128,\n              'multiclass_classification': 96\n          }\n      }\n\n  def create_network(hparams):\n      return build_network(hparams.get('d_output', 1), hparams.get('task_type', 'regression'), hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.2),\n          optax.adamw(learning_rate=learning_rate, weight_decay=0.01)\n      )\n\n  def complete(params, opt_state, trial_data):\n      print(f\"[Complete] {trial_data.get('dataset')} val_metric={trial_data.get('val_metric')}\")\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Typed heads: SE reduction=6 (intermediate) on SE-shared DSConv + mean↔LSE + BiGRU — seed=42\"\ntags: \"dsconv, squeeze-excitation,\
    \ pooling, bigru, typed-heads, regularization\"\nabstract: \"Intermediate SE strength (reduction=6) between 4 and 8 to test if gentler channel scaling preserves avg while nudging CRI-Off upward.\"\ncontent: |\n  import sys, optax\n  sys.path.append('storage/noema/submissions')\n  from dual_expert_dsconv_shared_backbone_se_taskheads_typed import build_network\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'hidden_dim': 256,\n          'kernel_size': 7,\n          'dropout_rate': 0.10,\n          'tau': 0.25,\n          'length_normalize_lse': True,\n          'gru_dim': 160,\n          'ds_dilations': [1,2,4,8,16],\n          'fusion': 'scalar_gate',\n          'pre_norm': True,\n          'post_norm': True,\n          'se_reduction': 6,\n          'head_hidden_map': {\n              'regression': 160,\n              'multilabel_regression': 128,\n              'multilabel_classification': 128,\n\
