tick: 534
role: model
parts:
- text: "/execute_action{goto research}\n/execute_action{storage write noema/submissions/hdp_regcal_topk.py}\n```yaml\ncontent: |\n  \"\"\"\n  HDP-RegCal with max-preserving top-k pooling in the main path.\n  Main path pooled features: [mean, max, topk_mean(ReLU(h), k)]\n  Motif path: 1D conv (k=5) + global max.\n  Regression heads use RegCal (per-sample L2) before the output layer.\n  \"\"\"\n  from typing import Any, Dict, Sequence\n  import jax\n  import jax.numpy as jnp\n  from jax import random, lax\n  import flax.linen as nn\n  import optax\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def _define_hyperparameters():\n      return {\n          \"learning_rate\": 0.001,\n          \"hidden_dim\": 256,\n          \"kernel_size\": 7,\n          \"dropout_rate\": 0.10,\n          \"ds_dilations\": [1, 2, 4, 8, 16],\n          \"motif_k\": 5,\n          \"head_hidden\": 128,\n          \"head_dropout\": 0.05,\n          \"weight_decay\": 0.01,\n          \"k_top\": 2,            # try {2,3}\n\
    \      }\n\n  class DSConvBlock(nn.Module):\n      hidden_dim: int\n      kernel_size: int\n      dilation: int\n      dropout_rate: float\n      @nn.compact\n      def __call__(self, x, deterministic: bool = True):\n          residual = x\n          x = nn.Conv(features=self.hidden_dim,\n                      kernel_size=(self.kernel_size,),\n                      feature_group_count=self.hidden_dim,\n                      dilation=(self.dilation,),\n                      padding=\"SAME\")(x)\n          x = jax.nn.gelu(x)\n          x = nn.Dropout(rate=self.dropout_rate)(x, deterministic=deterministic)\n          x = nn.Conv(features=self.hidden_dim, kernel_size=(1,), padding=\"SAME\")(x)\n          x = jax.nn.gelu(x)\n          return residual + x\n\n  class DSConvBackbone(nn.Module):\n      hidden_dim: int\n      kernel_size: int\n      dilations: Sequence[int]\n      dropout_rate: float\n      @nn.compact\n      def __call__(self, x, deterministic: bool = True):\n          h = nn.Conv(features=self.hidden_dim,\
    \ kernel_size=(1,), padding=\"SAME\")(x)\n          h = jax.nn.silu(h)\n          for d in self.dilations:\n              h = DSConvBlock(self.hidden_dim, self.kernel_size, d, self.dropout_rate)(h, deterministic)\n          return h\n\n  def global_mean_max(h):\n      mean = jnp.mean(h, axis=1)\n      maxv = jnp.max(h, axis=1)\n      return mean, maxv\n\n  def topk_mean_relu(h, k: int):\n      # h: (B, L, C); compute mean of top-k over length per (B,C) after ReLU\n      hp = jnp.maximum(h, 0.0)\n      B, L, C = hp.shape\n      x = hp.transpose(0, 2, 1).reshape((B * C, L))  # (B*C, L)\n      vals, _ = lax.top_k(x, k)\n      m = jnp.mean(vals, axis=-1)                    # (B*C,)\n      return m.reshape((B, C))                       # (B, C)\n\n  class MotifBranch(nn.Module):\n      hidden_dim: int\n      k: int\n      @nn.compact\n      def __call__(self, h):\n          x = nn.Conv(features=self.hidden_dim, kernel_size=(self.k,), padding=\"SAME\")(h)\n          x = jax.nn.gelu(x)\n  \
    \        return jnp.max(x, axis=1)\n\n  def l2_normalize_feats(z, eps=1e-6):\n      return z / (jnp.linalg.norm(z, axis=-1, keepdims=True) + eps)\n\n  class HDPRegCalTopK(nn.Module):\n      d_output: int\n      task_type: str\n      hidden_dim: int = 256\n      kernel_size: int = 7\n      ds_dilations: Sequence[int] = (1,2,4,8,16)\n      dropout_rate: float = 0.10\n      motif_k: int = 5\n      head_hidden: int = 128\n      head_dropout: float = 0.05\n      k_top: int = 2\n\n      @nn.compact\n      def __call__(self, x, deterministic: bool = True):\n          # Backbone\n          h = DSConvBackbone(self.hidden_dim, self.kernel_size, self.ds_dilations, self.dropout_rate)(x, deterministic)\n          # Main pooling: mean, max, topk_mean(ReLU)\n          mean, maxv = global_mean_max(h)\n          tkm = topk_mean_relu(h, self.k_top)\n          main_pooled = jnp.concatenate([mean, maxv, tkm], axis=-1)  # (B, 3C)\n          # Motif path\n          motif = MotifBranch(self.hidden_dim, self.motif_k)(h)\
    \      # (B, C)\n          pooled = jnp.concatenate([main_pooled, motif], axis=-1)    # (B, 4C)\n\n          # Head block\n          z = nn.Dense(self.head_hidden)(pooled)\n          z = nn.LayerNorm(epsilon=1e-6)(z)\n          z = jax.nn.gelu(z)\n          z = nn.Dropout(rate=self.head_dropout)(z, deterministic=deterministic)\n\n          if self.task_type in (\"regression\", \"multilabel_regression\"):\n              z_reg = l2_normalize_feats(z)  # RegCal ON\n              z_reg = nn.Dropout(rate=self.head_dropout)(z_reg, deterministic=deterministic)\n              out = nn.Dense(self.d_output)(z_reg)\n              return out.squeeze(-1) if (self.task_type == \"regression\" and self.d_output == 1) else out\n          elif self.task_type in (\"multilabel_classification\", \"multiclass_classification\"):\n              z_cls = nn.Dropout(rate=self.head_dropout)(z, deterministic=deterministic)\n              return nn.Dense(self.d_output)(z_cls)\n          else:\n              raise\
    \ ValueError(f\"Unknown task_type {self.task_type}\")\n\n  class WrappedRNANetwork:\n      def __init__(self, d_output=1, task_type=\"regression\", hparams: Dict[str, Any] = None):\n          hp = hparams or {}\n          self.net = HDPRegCalTopK(\n              d_output=d_output,\n              task_type=task_type,\n              hidden_dim=int(hp.get(\"hidden_dim\", 256)),\n              kernel_size=int(hp.get(\"kernel_size\", 7)),\n              ds_dilations=tuple(hp.get(\"ds_dilations\", [1,2,4,8,16])),\n              dropout_rate=float(hp.get(\"dropout_rate\", 0.10)),\n              motif_k=int(hp.get(\"motif_k\", 5)),\n              head_hidden=int(hp.get(\"head_hidden\", 128)),\n              head_dropout=float(hp.get(\"head_dropout\", 0.05)),\n              k_top=int(hp.get(\"k_top\", 2)),\n          )\n\n      def init(self, rng_key, dummy_input):\n          params_key, dropout_key = random.split(rng_key)\n          variables = self.net.init({'params': params_key, 'dropout':\
    \ dropout_key}, dummy_input, deterministic=True)\n          return variables['params']\n\n      def apply(self, params, x, deterministic=True, rng_key=None):\n          if deterministic:\n              return self.net.apply({'params': params}, x, deterministic=True)\n          else:\n              if rng_key is None:\n                  rng_key = random.PRNGKey(0)\n              return self.net.apply({'params': params}, x, deterministic=False, rngs={'dropout': rng_key})\n\n  def create_network(hparams):\n      return WrappedRNANetwork(d_output=hparams.get('d_output', 1), task_type=hparams.get('task_type', 'regression'), hparams=hparams)\n\n  def create_optimizer(learning_rate: float = 0.001, weight_decay: float = 0.01):\n      return optax.adamw(learning_rate=learning_rate, weight_decay=weight_decay)\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"HDP‑RegCal + max‑preserving top‑k pooling (k=2) in main path — seed=42\"\ntags: \"dsconv, pooling, top-k, max-preserving, regcal\"\nabstract:\
    \ \"Main path pooling uses [mean, max, topk_mean(ReLU, k=2)] while keeping the motif max branch unchanged. Regression heads retain RegCal. Tests whether small k top‑k reduces outlier noise without harming CRI‑Off/PRS.\"\ncontent: |\n  import sys\n  sys.path.append('storage/noema/submissions')\n  from hdp_regcal_topk import create_network, create_optimizer\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def _define_hyperparameters():\n      return {\n          \"learning_rate\": 0.001,\n          \"hidden_dim\": 256,\n          \"kernel_size\": 7,\n          \"dropout_rate\": 0.10,\n          \"ds_dilations\": [1,2,4,8,16],\n          \"motif_k\": 5,\n          \"head_hidden\": 128,\n          \"head_dropout\": 0.05,\n          \"weight_decay\": 0.01,\n          \"k_top\": 2\n      }\n\n  def create_network(hparams):\n      return create_network(hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return create_optimizer(learning_rate=learning_rate, weight_decay=0.01)\n\
    ```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"HDP‑RegCal + max‑preserving top‑k pooling (k=3) in main path — seed=42\"\ntags: \"dsconv, pooling, top-k, max-preserving, regcal\"\nabstract: \"As above but with k=3 for top‑k mean of ReLU activations. Hypothesis: k=3 may stabilize CRI‑Off without depressing PRS, while retaining literal max.\"\ncontent: |\n  import sys\n  sys.path.append('storage/noema/submissions')\n  from hdp_regcal_topk import create_network, create_optimizer\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def _define_hyperparameters():\n      return {\n          \"learning_rate\": 0.001,\n          \"hidden_dim\": 256,\n          \"kernel_size\": 7,\n          \"dropout_rate\": 0.10,\n          \"ds_dilations\": [1,2,4,8,16],\n          \"motif_k\": 5,\n          \"head_hidden\": 128,\n          \"head_dropout\": 0.05,\n          \"weight_decay\": 0.01,\n          \"k_top\": 3\n      }\n\n  def create_network(hparams):\n      return create_network(hparams)\n\n  def\
    \ create_optimizer(learning_rate: float = 0.001):\n      return create_optimizer(learning_rate=learning_rate, weight_decay=0.01)\n```"
