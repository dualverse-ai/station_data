parts:
- text: "Adding per-expert LayerNorm before gating to stabilize fusion; then testing with and without grad clipping.\n\n`/execute_action{storage write noema/submissions/dual_expert_pool_gru_weighted_prenorm.py}`\n```yaml\ncontent: |\n  \"\"\"\n  Dual-expert RNA model with learnable fusion and optional pre-/post-fusion normalization.\n    - Expert A: Conv + Pooling (mean/LSE variants with length normalization; scalar or channel-wise mixing)\n    - Expert B: small BiGRU on one-hot sequence (with linear embed)\n  Fusion modes:\n    - 'avg': simple average of expert projections\n    - 'scalar_gate': learned global 2-way softmax gating (params only, data-independent)\n    - 'mlp_gate': small MLP gate over [pool_proj || rnn_proj] producing 2-way softmax\n  Options:\n    - pre_expert_norm: LayerNorm each expert projection prior to fusion (scale calibration)\n    - post_norm: LayerNorm after fusion\n  \"\"\"\n  from typing import Dict, Any\n  import jax\n  import jax.numpy as jnp\n  from jax import\
    \ random\n  from jax.scipy.special import logsumexp\n  import flax.linen as nn\n  import optax\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def _define_hyperparameters():\n    return {\n      'learning_rate': 0.001,\n      'hidden_dim': 256,\n      'kernel_size': 7,\n      'dropout_rate': 0.10,\n      # pooling settings\n      'aggregator': 'mean_lse_mix',    # 'mean_lse_max' | 'mean_lse_mix' | 'mean_lse_mix_cw'\n      'tau': 0.25,\n      'length_normalize_lse': True,\n      'learn_tau': False,\n      # rnn settings\n      'gru_dim': 128,\n      # fusion settings\n      'fusion': 'scalar_gate',         # 'avg' | 'scalar_gate' | 'mlp_gate'\n      'gate_hidden_frac': 0.5,         # for mlp_gate: hidden = int(hidden_dim * frac)\n      'pre_expert_norm': False,        # NEW: per-expert LayerNorm before fusion\n      'post_norm': False               # LayerNorm after fusion\n    }\n\n  def _lse_pool(h, tau, length_normalize=True):\n    L = h.shape[1]\n    core = logsumexp(h / tau, axis=1)\n\
    \    if length_normalize:\n      core = core - jnp.log(jnp.array(L, dtype=h.dtype))\n    return tau * core\n\n  class PoolingBlock(nn.Module):\n    hidden_dim: int\n    dropout_rate: float\n    aggregator: str = \"mean_lse_mix\"\n    tau: float = 0.25\n    length_normalize_lse: bool = True\n    learn_tau: bool = False\n\n    @nn.compact\n    def __call__(self, h, deterministic: bool = True):\n      h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n      mean_pool = jnp.mean(h, axis=1)\n      tau_val = self.tau\n      if self.learn_tau:\n        tau_raw = self.param('tau_raw', lambda rng, shape: jnp.full(shape, self.tau), (1,))\n        tau_val = jax.nn.softplus(tau_raw)[0] + 1e-3\n      lse_pool = _lse_pool(h, tau_val, self.length_normalize_lse)\n      max_pool = jnp.max(h, axis=1)\n\n      if self.aggregator == 'mean_lse_max':\n        pooled = jnp.concatenate([mean_pool, lse_pool, max_pool], axis=-1)\n        pooled = nn.Dense(self.hidden_dim)(pooled)\n      elif\
    \ self.aggregator == 'mean_lse_mix':\n        w = self.param('mix_weights', lambda rng, shp: jnp.array([0.5, 0.5], dtype=mean_pool.dtype), (2,))\n        w = jax.nn.softmax(w)\n        pooled = w[0] * mean_pool + w[1] * lse_pool\n      elif self.aggregator == 'mean_lse_mix_cw':\n        w_cw = self.param('mix_weights_cw',\n                          lambda rng, shp: jnp.stack([jnp.full((self.hidden_dim,), 0.5),\n                                                       jnp.full((self.hidden_dim,), 0.5)], axis=0),\n                          (2, self.hidden_dim))\n        w_cw = jax.nn.softmax(w_cw, axis=0)\n        pooled = w_cw[0] * mean_pool + w_cw[1] * lse_pool\n      else:\n        raise ValueError(f\"Unknown aggregator: {self.aggregator}\")\n      return pooled\n\n  class BiGRUBlock(nn.Module):\n    gru_dim: int\n\n    @nn.compact\n    def __call__(self, x):\n      x_emb = nn.Dense(self.gru_dim)(x)  # (batch, seq, gru_dim)\n      f_gru = nn.RNN(nn.GRUCell(features=self.gru_dim))\n  \
    \    hf = f_gru(x_emb)              # (batch, seq, gru_dim)\n      hf_final = hf[:, -1, :]\n      x_emb_rev = jnp.flip(x_emb, axis=1)\n      b_gru = nn.RNN(nn.GRUCell(features=self.gru_dim))\n      hb = b_gru(x_emb_rev)\n      hb_final = hb[:, -1, :]\n      return jnp.concatenate([hf_final, hb_final], axis=-1)\n\n  class DualExpertWeighted(nn.Module):\n    d_output: int\n    task_type: str = \"regression\"\n    hidden_dim: int = 256\n    kernel_size: int = 7\n    dropout_rate: float = 0.10\n    aggregator: str = \"mean_lse_mix\"\n    tau: float = 0.25\n    length_normalize_lse: bool = True\n    learn_tau: bool = False\n    gru_dim: int = 128\n    fusion: str = \"scalar_gate\"\n    gate_hidden_frac: float = 0.5\n    pre_expert_norm: bool = False\n    post_norm: bool = False\n\n    @nn.compact\n    def __call__(self, x, deterministic: bool = True):\n      # Conv features\n      h = nn.Conv(features=self.hidden_dim, kernel_size=(self.kernel_size,), padding=\"SAME\")(x)\n      h = jax.nn.silu(h)\n\
    \n      # Experts\n      pool_rep = PoolingBlock(self.hidden_dim, self.dropout_rate,\n                              self.aggregator, self.tau,\n                              self.length_normalize_lse, self.learn_tau)(h, deterministic)\n      rnn_rep = BiGRUBlock(self.gru_dim)(x)\n      rnn_rep = nn.Dense(self.hidden_dim)(rnn_rep)\n\n      # Projections\n      pool_proj = nn.Dense(self.hidden_dim)(pool_rep)\n      rnn_proj  = nn.Dense(self.hidden_dim)(rnn_rep)\n\n      # Pre-expert normalization (per-expert)\n      if self.pre_expert_norm:\n        pool_proj = nn.LayerNorm(epsilon=1e-6)(pool_proj)\n        rnn_proj  = nn.LayerNorm(epsilon=1e-6)(rnn_proj)\n\n      # Fusion\n      if self.fusion == 'avg':\n        fused = 0.5 * (pool_proj + rnn_proj)\n      elif self.fusion == 'scalar_gate':\n        logits = self.param('fusion_logits', lambda rng, shp: jnp.zeros((2,), dtype=pool_proj.dtype), (2,))\n        w = jax.nn.softmax(logits)\n        fused = w[0] * pool_proj + w[1] * rnn_proj\n\
    \      elif self.fusion == 'mlp_gate':\n        gate_in = jnp.concatenate([pool_proj, rnn_proj], axis=-1)\n        hidden = max(1, int(self.hidden_dim * self.gate_hidden_frac))\n        g = nn.Dense(hidden)(gate_in)\n        g = jax.nn.gelu(g)\n        g = nn.Dense(2)(g)\n        w = jax.nn.softmax(g, axis=-1)\n        fused = w[:, :1] * pool_proj + w[:, 1:] * rnn_proj\n      else:\n        raise ValueError(f\"Unknown fusion: {self.fusion}\")\n\n      if self.post_norm:\n        fused = nn.LayerNorm(epsilon=1e-6)(fused)\n\n      # Head\n      z = nn.Dense(self.hidden_dim)(fused)\n      z = jax.nn.gelu(z)\n      z = nn.Dropout(rate=self.dropout_rate)(z, deterministic=deterministic)\n      z = nn.Dense(self.d_output)(z)\n\n      if self.task_type == \"regression\" and self.d_output == 1:\n        return z.squeeze(-1)\n      else:\n        return z\n\n  class WrappedRNANetwork:\n    def __init__(self, d_output=1, task_type=\"regression\", hparams: Dict[str, Any] = None):\n      h = hparams\
    \ or {}\n      self.network = DualExpertWeighted(\n        d_output=d_output,\n        task_type=task_type,\n        hidden_dim=int(h.get('hidden_dim', 256)),\n        kernel_size=int(h.get('kernel_size', 7)),\n        dropout_rate=float(h.get('dropout_rate', 0.10)),\n        aggregator=str(h.get('aggregator', 'mean_lse_mix')),\n        tau=float(h.get('tau', 0.25)),\n        length_normalize_lse=bool(h.get('length_normalize_lse', True)),\n        learn_tau=bool(h.get('learn_tau', False)),\n        gru_dim=int(h.get('gru_dim', 128)),\n        fusion=str(h.get('fusion', 'scalar_gate')),\n        gate_hidden_frac=float(h.get('gate_hidden_frac', 0.5)),\n        pre_expert_norm=bool(h.get('pre_expert_norm', False)),\n        post_norm=bool(h.get('post_norm', False)),\n      )\n\n    def init(self, rng_key, dummy_input):\n      params_key, dropout_key = random.split(rng_key)\n      variables = self.network.init({'params': params_key, 'dropout': dropout_key},\n                            \
    \        dummy_input, deterministic=True)\n      return variables['params']\n\n    def apply(self, params, x, deterministic=True, rng_key=None):\n      if deterministic:\n        return self.network.apply({'params': params}, x, deterministic=True)\n      else:\n        if rng_key is None:\n          rng_key = random.PRNGKey(0)\n        return self.network.apply({'params': params}, x, deterministic=False, rngs={'dropout': rng_key})\n\n  def build_network(d_output, task_type, hparams):\n    return WrappedRNANetwork(d_output=d_output, task_type=task_type, hparams=hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n    return optax.adamw(learning_rate=learning_rate, weight_decay=0.01)\n```\n\n`/execute_action{goto research}`\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Dual-expert (scalar gate) + Pre-expert LN + Post-norm — BiGRU=160, k=7 — seed=42\"\ntags: \"ensemble, gating, layernorm, prenorm, bigru, pooling\"\nabstract: \"Adds per-expert LayerNorm before fusion (plus\
    \ post-fusion LayerNorm) to stabilize expert scales in the scalar-gated dual-expert (Conv+Pooling mean↔LSE τ=0.25 len-norm + BiGRU=160). Tests impact on PRS/Spearman with minimal complexity.\"\ncontent: |\n  import sys\n  sys.path.append('storage/noema/submissions')\n  from dual_expert_pool_gru_weighted_prenorm import build_network, create_optimizer as make_optimizer\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'hidden_dim': 256,\n          'kernel_size': 7,\n          'dropout_rate': 0.10,\n          'aggregator': 'mean_lse_mix',\n          'tau': 0.25,\n          'length_normalize_lse': True,\n          'learn_tau': False,\n          'gru_dim': 160,\n          'fusion': 'scalar_gate',\n          'pre_expert_norm': True,   # NEW\n          'post_norm': True\n      }\n\n  def create_network(hparams):\n      return build_network(hparams.get('d_output', 1), hparams.get('task_type', 'regression'),\
    \ hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return make_optimizer(learning_rate)\n\n  def complete(params, opt_state, trial_data):\n      ds = trial_data.get('dataset'); vm = trial_data.get('val_metric')\n      print(f\"[Complete] {ds} val_metric={vm}\")\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Dual-expert (scalar gate) + Pre-expert LN + Post-norm + grad-clip=1.0 — BiGRU=160, k=7 — seed=42\"\ntags: \"ensemble, gating, layernorm, prenorm, bigru, pooling, optimization\"\nabstract: \"Same as pre-expert LN config, with optimizer adding global-norm gradient clipping (1.0) to further stabilize training across datasets (targeting PRS/CRISPR).\"\ncontent: |\n  import sys\n  sys.path.append('storage/noema/submissions')\n  from dual_expert_pool_gru_weighted_prenorm import build_network\n  import optax\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'hidden_dim':\
    \ 256,\n          'kernel_size': 7,\n          'dropout_rate': 0.10,\n          'aggregator': 'mean_lse_mix',\n          'tau': 0.25,\n          'length_normalize_lse': True,\n          'learn_tau': False,\n          'gru_dim': 160,\n          'fusion': 'scalar_gate',\n          'pre_expert_norm': True,\n          'post_norm': True,\n          'grad_clip': 1.0\n      }\n\n  def create_network(hparams):\n      return build_network(hparams.get('d_output', 1), hparams.get('task_type', 'regression'), hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      # Add global-norm clipping before AdamW\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adamw(learning_rate=learning_rate, weight_decay=0.01)\n      )\n\n  def complete(params, opt_state, trial_data):\n      ds = trial_data.get('dataset'); vm = trial_data.get('val_metric')\n      print(f\"[Complete] {ds} val_metric={vm}\")\n```"
