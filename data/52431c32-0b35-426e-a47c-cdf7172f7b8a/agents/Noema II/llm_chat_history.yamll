    \      return {\n          'hidden_dim': 256,\n          'd_model': 256,\n          'kernel_size': 7,\n          'dropout_rate': 0.10,\n          'motif_kernel_size': 5,\n          'aggregator': 'mean_max',\n          'regcal_l2': False,  # OFF\n          'head_dropout': 0.05,\n          'learning_rate': 0.001,\n          'grad_clip': 1.0,\n          'capture_norms': True,\n          'capture_point': 'post',  # tap after RegCal (no-op when OFF)\n          'capture_max_n': 2048,\n          'capture_dir': 'storage/noema/results/hdp_regcal_norms_post_off'\n      }\n\n  def create_network(hparams):\n      return build_network(hparams.get('d_output', 1), hparams.get('task_type', 'regression'), hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adamw(learning_rate=learning_rate, weight_decay=0.01)\n      )\n\n  def complete(params, opt_state, trial_data):\n      print(f\"[Complete] {trial_data.get('dataset')}\
    \ val_metric={trial_data.get('val_metric')}\")\n```\n\n\n`/execute_action{storage write noema/results/tri_seed_wd0012_summary.md}`\n```yaml\ncontent: |\n  # HDP‑RegCal — Tri-seed summary (weight_decay=0.012, head_dropout=0.05)\n\n  | Eval ID | Seed | Score  | APA   | CRI-Off | CRI-On | PRS   | MRL   | Modif | ncRNA |\n  |---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|\n  | 713 | 42  | 0.6886 | 0.8575 | 0.0717 | 0.5139 | 0.5695 | 0.8974 | 0.9516 | 0.9585 |\n  | 714 | 123 | 0.6910 | 0.8557 | 0.0846 | 0.5252 | 0.5671 | 0.8989 | 0.9514 | 0.9538 |\n  | 717 | 7   | 0.6842 | 0.8612 | 0.0739 | 0.4924 | 0.5698 | 0.8870 | 0.9516 | 0.9538 |\n  | Mean | — | 0.6880 | 0.8581 | 0.0767 | 0.5105 | 0.5688 | 0.8944 | 0.9515 | 0.9554 |\n\n  Decision: Do not adopt wd=0.012 as default (criterion ≥0.689 mean not met; baseline RegCal ON tri-seed mean ≈0.6885 with wd=0.01). Keep wd=0.01.\n  Notes:\n  - wd=0.012 shows strong CRI-On on seed=123 but reduces CRI-Off on seed=42; overall neutral on average.\n```\n\
    \n\n`/execute_action{goto archive}`\n`/execute_action{reply 22}`\n```yaml\ntitle: \"wd=0.012 tri-seed outcome and norm-capture status\"\ncontent: |\n  Tri-seed with wd=0.012 (head_dropout=0.05) completed:\n  - 713 (seed=42): 0.6886\n  - 714 (seed=123): 0.6910\n  - 717 (seed=7):  0.6842\n  Mean ≈ 0.6880 (below adoption threshold 0.689). We will retain wd=0.01 as default.\n\n  Norm captures:\n  - Post-RegCal ON (z′) captured (ID 718) -> storage/noema/results/hdp_regcal_norms_post_on/*.json\n  - Post-RegCal OFF (z′ == z) capture submitted; OFF table + ON/OFF aggregation will follow. Expectation: ON has ||z′||₂ ≈ 1 per sample; OFF mirrors pre-head scale.\n```\n\n\n`/execute_action{meta}`\n```yaml\ncontent: |\n  Noema II — Working Meta (Tick 456)\n  Status:\n  - wd=0.012 tri-seed mean = 0.6880 (< 0.689) → keep wd=0.01 default.\n  - Post-RegCal z′ capture: ON complete (ID 718); OFF submitted (seed=7).\n\n  Next:\n  - After OFF completes, run norms_post_aggregate.py to write hdp_regcal_norms_post_on_off.md;\
