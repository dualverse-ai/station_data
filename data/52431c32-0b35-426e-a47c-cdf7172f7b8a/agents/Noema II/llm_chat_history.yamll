role: model
parts:
- text: "/execute_action{goto research}\n/execute_action{storage write noema/submissions/dsconv_minibase_expts3.py}\n```yaml\ncontent: |\n  \"\"\"\n  Minimal DSConv + pooling baseline with new probes (Flax 0.10.6 compatible):\n    - learned_mix: per-channel convex mix of mean and max (no smoothing of maxima)\n    - mix_concat_max: optionally concatenate [mix, max] to retain explicit maxima features\n    - use_rmsnorm: replace LayerNorm with RMSNorm before the output head\n  Heads: single hidden MLP; no motif; no RegCal. <1M params.\n  \"\"\"\n  from typing import Any, Dict, Sequence\n  import jax\n  import jax.numpy as jnp\n  from jax import random\n  import flax.linen as nn\n  import optax\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def _define_hyperparameters():\n      return {\n          \"learning_rate\": 0.001,\n          \"hidden_dim\": 256,\n          \"kernel_size\": 7,\n          \"dropout_rate\": 0.10,\n          \"ds_dilations\": [1, 2, 4, 8, 16],\n          \"head_hidden\": 128,\n\
    \          \"head_dropout\": 0.05,\n          # Probes\n          \"learned_mix\": False,\n          \"mix_concat_max\": False,\n          \"alpha0\": 0.35,           # initial α favoring max (protect CRI-Off)\n          \"use_rmsnorm\": False,\n      }\n\n  class DSConvBlock(nn.Module):\n      hidden_dim: int\n      kernel_size: int\n      dilation: int\n      dropout_rate: float\n      @nn.compact\n      def __call__(self, x, deterministic: bool = True):\n          residual = x\n          x = nn.Conv(features=self.hidden_dim,\n                      kernel_size=(self.kernel_size,),\n                      feature_group_count=self.hidden_dim,\n                      kernel_dilation=(self.dilation,),  # Flax 0.10.6\n                      padding=\"SAME\")(x)\n          x = jax.nn.gelu(x)\n          x = nn.Dropout(rate=self.dropout_rate)(x, deterministic=deterministic)\n          x = nn.Conv(features=self.hidden_dim, kernel_size=(1,), padding=\"SAME\")(x)\n          x = jax.nn.gelu(x)\n\
    \          return residual + x\n\n  class DSConvBackbone(nn.Module):\n      hidden_dim: int\n      kernel_size: int\n      dilations: Sequence[int]\n      dropout_rate: float\n      @nn.compact\n      def __call__(self, x, deterministic: bool = True):\n          h = nn.Conv(features=self.hidden_dim, kernel_size=(1,), padding=\"SAME\")(x)\n          h = jax.nn.silu(h)\n          for d in self.dilations:\n              h = DSConvBlock(self.hidden_dim, self.kernel_size, d, self.dropout_rate)(h, deterministic)\n          return h\n\n  def global_mean_max(h):\n      return jnp.mean(h, axis=1), jnp.max(h, axis=1)\n\n  class RMSNorm(nn.Module):\n      features: int\n      eps: float = 1e-6\n      @nn.compact\n      def __call__(self, x):\n          gamma = self.param(\"gamma\", nn.initializers.ones, (self.features,))\n          rms = jnp.sqrt(jnp.mean(jnp.square(x), axis=-1, keepdims=True) + self.eps)\n          return (x / rms) * gamma\n\n  class MiniDSConvNet3(nn.Module):\n      d_output:\
    \ int\n      task_type: str\n      hidden_dim: int = 256\n      kernel_size: int = 7\n      ds_dilations: Sequence[int] = (1,2,4,8,16)\n      dropout_rate: float = 0.10\n      head_hidden: int = 128\n      head_dropout: float = 0.05\n      learned_mix: bool = False\n      mix_concat_max: bool = False\n      alpha0: float = 0.35\n      use_rmsnorm: bool = False\n\n      @nn.compact\n      def __call__(self, x, deterministic: bool = True):\n          # Backbone\n          h = DSConvBackbone(self.hidden_dim, self.kernel_size, self.ds_dilations, self.dropout_rate)(x, deterministic)\n          mean, maxv = global_mean_max(h)  # (B,C), (B,C)\n\n          if self.learned_mix:\n              C = mean.shape[-1]\n              w = self.param(\"mix_w\", nn.initializers.zeros, (C,))\n              # Bias toward max at init via alpha0\n              a0 = jnp.clip(self.alpha0, 1e-3, 1 - 1e-3)\n              b0 = jnp.log(a0 / (1.0 - a0))\n              alpha = jax.nn.sigmoid(w + b0)[None, :]  # (1,C)\n\
    \              mixed = alpha * mean + (1.0 - alpha) * maxv  # (B,C)\n              if self.mix_concat_max:\n                  pooled = jnp.concatenate([mixed, maxv], axis=-1)  # (B,2C)\n              else:\n                  pooled = mixed  # (B,C)\n          else:\n              pooled = jnp.concatenate([mean, maxv], axis=-1)  # default mean+max\n\n          # Head\n          z = nn.Dense(self.head_hidden)(pooled)\n          if self.use_rmsnorm:\n              z = RMSNorm(self.head_hidden)(z)\n          else:\n              z = nn.LayerNorm(epsilon=1e-6)(z)\n          z = jax.nn.gelu(z)\n          z = nn.Dropout(rate=self.head_dropout)(z, deterministic=deterministic)\n          out = nn.Dense(self.d_output)(z)\n          if self.task_type == \"regression\" and self.d_output == 1:\n              return out.squeeze(-1)\n          return out\n\n  class WrappedRNANetwork:\n      def __init__(self, d_output=1, task_type=\"regression\", hparams: Dict[str, Any] = None):\n          hp = hparams\
    \ or {}\n          self.net = MiniDSConvNet3(\n              d_output=d_output,\n              task_type=task_type,\n              hidden_dim=int(hp.get(\"hidden_dim\", 256)),\n              kernel_size=int(hp.get(\"kernel_size\", 7)),\n              ds_dilations=tuple(hp.get(\"ds_dilations\", [1,2,4,8,16])),\n              dropout_rate=float(hp.get(\"dropout_rate\", 0.10)),\n              head_hidden=int(hp.get(\"head_hidden\", 128)),\n              head_dropout=float(hp.get(\"head_dropout\", 0.05)),\n              learned_mix=bool(hp.get(\"learned_mix\", False)),\n              mix_concat_max=bool(hp.get(\"mix_concat_max\", False)),\n              alpha0=float(hp.get(\"alpha0\", 0.35)),\n              use_rmsnorm=bool(hp.get(\"use_rmsnorm\", False)),\n          )\n      def init(self, rng_key, dummy_input):\n          pk, dk = random.split(rng_key)\n          variables = self.net.init({'params': pk, 'dropout': dk}, dummy_input, deterministic=True)\n          return variables['params']\n\
    \      def apply(self, params, x, deterministic=True, rng_key=None):\n          if deterministic:\n              return self.net.apply({'params': params}, x, deterministic=True)\n          if rng_key is None:\n              rng_key = random.PRNGKey(0)\n          return self.net.apply({'params': params}, x, deterministic=False, rngs={'dropout': rng_key})\n\n  def create_network(hparams):\n      return WrappedRNANetwork(d_output=hparams.get('d_output', 1), task_type=hparams.get('task_type', 'regression'), hparams=hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.adamw(learning_rate=learning_rate, weight_decay=0.01)\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"Idea 1 — Learned per-channel mean↔max mix (α0=0.35) + concat[max] — minimal DSConv baseline — seed=42\"\ntags: \"baseline, dsconv, pooling, per-channel, robustness\"\nabstract: \"Per-channel convex mixing of mean and max with bias toward max (α0=0.35), concatenated with explicit max to retain\
    \ literal extremes. Hypothesis: reweights extremes robustly without smoothing.\"\ncontent: |\n  import sys\n  sys.path.append('storage/noema/submissions')\n  from dsconv_minibase_expts3 import create_network, create_optimizer\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def _define_hyperparameters():\n      return {\n          \"learning_rate\": 0.001,\n          \"hidden_dim\": 256,\n          \"kernel_size\": 7,\n          \"dropout_rate\": 0.10,\n          \"ds_dilations\": [1,2,4,8,16],\n          \"head_hidden\": 128,\n          \"head_dropout\": 0.05,\n          \"learned_mix\": True,\n          \"mix_concat_max\": True,\n          \"alpha0\": 0.35,\n          \"use_rmsnorm\": False,\n      }\n\n  def create_network(hparams):\n      return create_network(hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return create_optimizer(learning_rate)\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"Idea 2 — RMSNorm pre-head (swap LayerNorm) — minimal DSConv baseline\
    \ — seed=42\"\ntags: \"baseline, normalization, rmsnorm, head\"\nabstract: \"Replace LayerNorm with RMSNorm (scale-only) before the head MLP on the minimal DSConv + mean+max baseline. Tests whether scale-only normalization improves stability.\"\ncontent: |\n  import sys\n  sys.path.append('storage/noema/submissions')\n  from dsconv_minibase_expts3 import create_network, create_optimizer\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def _define_hyperparameters():\n      return {\n          \"learning_rate\": 0.001,\n          \"hidden_dim\": 256,\n          \"kernel_size\": 7,\n          \"dropout_rate\": 0.10,\n          \"ds_dilations\": [1,2,4,8,16],\n          \"head_hidden\": 128,\n          \"head_dropout\": 0.05,\n          \"learned_mix\": False,\n          \"mix_concat_max\": False,\n          \"alpha0\": 0.35,\n          \"use_rmsnorm\": True,\n      }\n\n  def create_network(hparams):\n      return create_network(hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n\
    \      return create_optimizer(learning_rate)\n```"
