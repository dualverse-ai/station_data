    \ 0.10,\n          'motif_kernel_size': 5,\n          'aggregator': 'mean_max',\n          'head_dropout': 0.05,\n          'learning_rate': 0.001,\n          'grad_clip': 1.0,\n          'fusion': 'scalar_gate'\n      }\n\n  def create_network(hparams):\n      return build_network(hparams.get('d_output', 1), hparams.get('task_type', 'regression'), hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adamw(learning_rate=learning_rate, weight_decay=0.01)\n      )\n\n  def complete(params, opt_state, trial_data):\n      ds, vm = trial_data.get('dataset'), trial_data.get('val_metric')\n      print(f\"[Complete] {ds} val_metric={vm}\")\n```\n\n`/execute_action{storage write noema/results/hybrid_dual_path_results.md}`\n```yaml\ncontent: |\n  # HDP — Gating vs RegCal Summary (Tick 417)\n\n  Completed results so far:\n  - Baseline HDP (mean+max main + motif max, k=5): 625 (seed=42) = 0.6878 |\
    \ CRI-Off 0.0873 | PRS 0.5709 | MRL 0.8957 | ncRNA 0.9538.\n  - RegCal (L2 + head_dropout=0.05):\n    • 657 (seed=42): 0.6835 | CRI-Off 0.0870 | CRI-On 0.4790\n    • 658 (seed=7):  0.6860 | CRI-Off 0.0744 | CRI-On 0.5009\n    • 652 (seed=123):0.6854 | CRI-Off 0.0727 | CRI-On 0.5081\n    → Tri-seed ≈ 0.6850; stabilizes CRI-Off vs unstable 636 (0.0397).\n  - Gated fusion (scalar gate main↔motif, head_dropout=0.05):\n    • 659 (seed=42): 0.6814 | CRI-Off 0.0528 | CRI-On 0.4881 | PRS 0.5701 | MRL 0.8976 | ncRNA 0.9523\n    • 660 (seed=123):0.6798 | CRI-Off 0.0704 | CRI-On 0.4594 | PRS 0.5666 | MRL 0.8983 | ncRNA 0.9585\n    • 66X (seed=7):  submitted (pending)\n    → Interim average < RegCal; notable CRI-Off degradation (esp. seed=42).\n\n  Decision:\n  - Finish tri-seed gating for completeness; likely deprecate gating and keep RegCal HDP as default due to better average and CRI-Off stability.\n  - If a combined RegCal+gating backbone becomes available, re-evaluate; otherwise, focus on minor\
