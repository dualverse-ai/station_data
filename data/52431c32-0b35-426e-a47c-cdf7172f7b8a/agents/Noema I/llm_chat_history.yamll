tick: 174
role: model
parts:
- text: "I am Noema I, at the Research Counter. To address the inactivity notice, I’ll run low-risk, unified ablations on the τ=0.5 default: increase head width and reduce head dropout, keeping the backbone unchanged; also test a slightly lower weight decay.\n\n`/execute_action{storage write noema/submissions/dsconv_lse_variants.py}`\n```yaml\ncontent: |\n  import jax\n  import jax.numpy as jnp\n  from jax import random\n  import flax.linen as nn\n  import optax\n  from typing import Sequence, Dict, Any\n\n  class DSConvDilatedBlock(nn.Module):\n      d_model: int\n      kernel_size: int = 7\n      dilation: int = 1\n      dropout_rate: float = 0.1\n      @nn.compact\n      def __call__(self, x, deterministic=True):\n          h = nn.LayerNorm()(x)\n          h = nn.Conv(features=self.d_model,\n                      kernel_size=(self.kernel_size,),\n                      feature_group_count=self.d_model,\n                      padding='SAME',\n                      kernel_dilation=(self.dilation,),\n\
    \                      name='dw_conv')(h)\n          h = nn.gelu(h)\n          h = nn.Conv(features=self.d_model, kernel_size=(1,), name='pw_conv')(h)\n          h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n          return x + h\n\n  def lse_pool(h: jnp.ndarray, tau: float) -> jnp.ndarray:\n      # Length-normalized LogSumExp per channel: tau * log(mean(exp(h/tau)))\n      x = h / tau\n      m = jnp.max(x, axis=1, keepdims=True)             # (B,1,C)\n      lse = jnp.log(jnp.mean(jnp.exp(x - m), axis=1) + 1e-12) + jnp.squeeze(m, axis=1)\n      return tau * lse                                   # (B,C)\n\n  class RNANetLSEVar(nn.Module):\n      d_input: int = 4\n      d_output: int = 1\n      task_type: str = 'regression'\n      d_model: int = 256\n      num_blocks: int = 5\n      dilations: Sequence[int] = (1, 2, 4, 8, 16)\n      kernel_size: int = 7\n      dropout_backbone: float = 0.1\n      dropout_head: float = 0.1\n      head_mult: float = 2.0       \
    \    # head hidden = d_model * head_mult\n      positional_encoding: bool = False\n      tau: float = 0.5                 # soft-extreme temperature (length-normalized)\n\n      @nn.compact\n      def __call__(self, x, deterministic=True):\n          # Input projection\n          h = nn.Dense(self.d_model, name='in_proj')(x)\n          h = nn.gelu(h)\n          h = nn.Dropout(rate=self.dropout_backbone)(h, deterministic=deterministic)\n\n          # DSConv stack\n          for i in range(self.num_blocks):\n              d = self.dilations[i] if i < len(self.dilations) else self.dilations[-1]\n              h = DSConvDilatedBlock(self.d_model, self.kernel_size, d, self.dropout_backbone)(h, deterministic=deterministic)\n\n          # Pooling: concat(mean, LSE_tau)\n          mean_vec = jnp.mean(h, axis=1)        # (B,C)\n          lse_vec  = lse_pool(h, self.tau)      # (B,C)\n          fused = jnp.concatenate([mean_vec, lse_vec], axis=-1)  # (B,2C)\n\n          # Head\n          z = nn.LayerNorm()(fused)\n\
    \          hidden_dim = int(self.d_model * self.head_mult)\n          z = nn.Dense(hidden_dim, name='head_dense')(z)\n          z = nn.gelu(z)\n          z = nn.Dropout(rate=self.dropout_head)(z, deterministic=deterministic)\n          logits = nn.Dense(self.d_output, name='out')(z)\n\n          if self.task_type == 'regression' and self.d_output == 1:\n              return logits.squeeze(-1)\n          return logits\n\n  class LSEVarNetwork:\n      def __init__(self, d_input, d_output, task_type, **kwargs):\n          self.network = RNANetLSEVar(d_input=d_input, d_output=d_output, task_type=task_type, **kwargs)\n      def init(self, rng_key, dummy_input):\n          params_key, dropout_key = random.split(rng_key)\n          variables = self.network.init({'params': params_key, 'dropout': dropout_key}, dummy_input, deterministic=True)\n          return variables['params']\n      def apply(self, params, x, deterministic=True, rng_key=None):\n          if deterministic:\n              return\
    \ self.network.apply({'params': params}, x, deterministic=True)\n          else:\n              if rng_key is None:\n                  rng_key = random.PRNGKey(0)\n              return self.network.apply({'params': params}, x, deterministic=False, rngs={'dropout': rng_key})\n\n  def build_network(d_output: int, task_type: str, hparams: Dict[str, Any]):\n      return LSEVarNetwork(\n          d_input=4,\n          d_output=d_output,\n          task_type=task_type,\n          d_model=hparams.get('d_model', 256),\n          num_blocks=hparams.get('num_blocks', 5),\n          dilations=tuple(hparams.get('dilations', [1,2,4,8,16])),\n          kernel_size=hparams.get('kernel_size', 7),\n          dropout_backbone=hparams.get('dropout_backbone', 0.1),\n          dropout_head=hparams.get('dropout_head', 0.1),\n          head_mult=hparams.get('head_mult', 2.0),\n          positional_encoding=hparams.get('positional_encoding', False),\n          tau=hparams.get('tau', 0.5),\n      )\n\n  def\
    \ create_optimizer(learning_rate: float = 0.001, weight_decay: float = 0.01, clip_norm: float = 1.0):\n      return optax.chain(\n          optax.clip_by_global_norm(clip_norm),\n          optax.adamw(learning_rate=learning_rate, weight_decay=weight_decay),\n      )\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"τ=0.5 default, wider head (x2) + lower head dropout (0.05), wd=0.01\"\ntags: \"cnn, pooling, lse_tau=0.5, head width, dropout\"\nabstract: \"Unified DSConv with mean+LSE_τ=0.5; increase head hidden to 2×d_model and reduce head dropout to 0.05 while keeping backbone dropout 0.1. Tests if a slightly stronger head improves aggregate without harming stability.\"\ncontent: |\n  import sys\n  sys.path.append('storage/noema/submissions')\n  from dsconv_lse_variants import build_network, create_optimizer\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'd_model': 256,\n          'num_blocks': 5,\n          'dilations': [1,2,4,8,16],\n\
    \          'kernel_size': 7,\n          'dropout_backbone': 0.1,\n          'dropout_head': 0.05,\n          'head_mult': 2.0,\n          'positional_encoding': False,\n          'tau': 0.5,\n          'weight_decay': 0.01,\n          'clip_norm': 1.0,\n      }\n\n  def create_network(hparams):\n      return build_network(hparams.get('d_output', 1), hparams.get('task_type', 'regression'), hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return create_optimizer(learning_rate=learning_rate,\n                              weight_decay=0.01,\n                              clip_norm=1.0)\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def complete(params, opt_state, trial_data):\n      print(f\"[Complete] {trial_data.get('dataset')} val_metric={trial_data.get('val_metric')}\")\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"τ=0.5 default, wider head (x2) + lower head dropout (0.05), wd=0.005\"\ntags: \"cnn, pooling, lse_tau=0.5, head width, dropout, weight decay\"\
    \nabstract: \"Same as prior variant but reduce AdamW weight decay to 0.005 to test if slightly weaker L2 helps median aggregate under the unified protocol.\"\ncontent: |\n  import sys\n  sys.path.append('storage/noema/submissions')\n  from dsconv_lse_variants import build_network, create_optimizer\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'd_model': 256,\n          'num_blocks': 5,\n          'dilations': [1,2,4,8,16],\n          'kernel_size': 7,\n          'dropout_backbone': 0.1,\n          'dropout_head': 0.05,\n          'head_mult': 2.0,\n          'positional_encoding': False,\n          'tau': 0.5,\n          'weight_decay': 0.005,\n          'clip_norm': 1.0,\n      }\n\n  def create_network(hparams):\n      return build_network(hparams.get('d_output', 1), hparams.get('task_type', 'regression'), hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return create_optimizer(learning_rate=learning_rate,\n\
    \                              weight_decay=0.005,\n                              clip_norm=1.0)\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def complete(params, opt_state, trial_data):\n      print(f\"[Complete] {trial_data.get('dataset')} val_metric={trial_data.get('val_metric')}\")\n```\n\n`/execute_action{storage write noema/results/append_tick174.csv}`\n```yaml\ncontent: |\n  # Tick 174 log\n  SUBMITTED,τ0.5_headx2_headdrop0.05_wd0.01,seed=42\n  SUBMITTED,τ0.5_headx2_headdrop0.05_wd0.005,seed=42\n```"
