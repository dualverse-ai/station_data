parts:
- text: "`/execute_action{goto research}`\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Replication: DSConv (No-PE) + concat(mean, LSE_tau=0.25) — length-normalized\"\ntags: \"cnn, pooling, logsumexp, mean, replication, no positional encoding\"\nabstract: \"Replicate Aetheria’s promising tau=0.25 result under our unified length-normalized LSE formulation. Seed=42; tri-seed only if >= 0.683.\"\ncontent: |\n  import sys\n  sys.path.append('storage/noema/submissions')\n  from dsconv_pool_variants import build_network, create_optimizer\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'd_model': 256,\n          'num_blocks': 5,\n          'dilations': [1,2,4,8,16],\n          'kernel_size': 7,\n          'dropout_rate': 0.1,\n          'positional_encoding': False,\n          'aggregator': 'mean_lse',\n          'tau': 0.25,   # length-normalized LSE, tau=0.25\n          'topk': 2\n      }\n\n  def create_network(hparams):\n      return build_network(hparams.get('d_output',\
    \ 1), hparams.get('task_type', 'regression'), hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return create_optimizer(learning_rate)\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def complete(params, opt_state, trial_data):\n      print(f\"[Complete] {trial_data.get('dataset')} val_metric={trial_data.get('val_metric')}\")\n```\n\n`/execute_action{storage write noema/submissions/dsconv_pool_variants_lse_sum.py}`\n```yaml\ncontent: |\n  import jax\n  import jax.numpy as jnp\n  from jax import random, lax\n  import flax.linen as nn\n  import optax\n  from typing import Sequence, Dict, Any\n\n  class DSConvDilatedBlock(nn.Module):\n      d_model: int\n      kernel_size: int = 7\n      dilation: int = 1\n      dropout_rate: float = 0.1\n      @nn.compact\n      def __call__(self, x, deterministic=True):\n          h = nn.LayerNorm()(x)\n          h = nn.Conv(features=self.d_model, kernel_size=(self.kernel_size,),\n                      feature_group_count=self.d_model,\
    \ padding='SAME',\n                      kernel_dilation=(self.dilation,), name='dw_conv')(h)\n          h = nn.gelu(h)\n          h = nn.Conv(features=self.d_model, kernel_size=(1,), name='pw_conv')(h)\n          h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n          return x + h\n\n  def lse_pool_sum(h: jnp.ndarray, tau: float) -> jnp.ndarray:\n      # Unnormalized LSE over length: tau * log(sum(exp(h/tau)))\n      x = h / tau\n      m = jnp.max(x, axis=1, keepdims=True)                  # (B,1,C)\n      lse = jnp.log(jnp.sum(jnp.exp(x - m), axis=1) + 1e-12) # (B,C)\n      return tau * (lse + jnp.squeeze(m, axis=1))            # (B,C)\n\n  class RNANetMeanLSESum(nn.Module):\n      d_input: int = 4\n      d_output: int = 1\n      task_type: str = 'regression'\n      d_model: int = 256\n      num_blocks: int = 5\n      dilations: Sequence[int] = (1, 2, 4, 8, 16)\n      kernel_size: int = 7\n      dropout_rate: float = 0.1\n      positional_encoding: bool =\
    \ False\n      tau: float = 0.25\n\n      @nn.compact\n      def __call__(self, x, deterministic=True):\n          h = nn.Dense(self.d_model)(x)\n          h = nn.gelu(h)\n          h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n          for i in range(self.num_blocks):\n              d = self.dilations[i] if i < len(self.dilations) else self.dilations[-1]\n              h = DSConvDilatedBlock(self.d_model, self.kernel_size, d, self.dropout_rate)(h, deterministic=deterministic)\n\n          mean_vec = jnp.mean(h, axis=1)            # (B,C)\n          lse_vec  = lse_pool_sum(h, self.tau)      # (B,C)\n          fused = jnp.concatenate([mean_vec, lse_vec], axis=-1)  # (B,2C)\n\n          z = nn.LayerNorm()(fused)\n          z = nn.Dense(self.d_model)(z)\n          z = nn.gelu(z)\n          z = nn.Dropout(rate=self.dropout_rate)(z, deterministic=deterministic)\n          logits = nn.Dense(self.d_output)(z)\n          if self.task_type == 'regression' and self.d_output\
    \ == 1:\n              return logits.squeeze(-1)\n          return logits\n\n  class MeanLSESumNetwork:\n      def __init__(self, d_input, d_output, task_type, **kwargs):\n          self.network = RNANetMeanLSESum(d_input=d_input, d_output=d_output, task_type=task_type, **kwargs)\n      def init(self, rng_key, dummy_input):\n          params_key, dropout_key = random.split(rng_key)\n          variables = self.network.init({'params': params_key, 'dropout': dropout_key}, dummy_input, deterministic=True)\n          return variables['params']\n      def apply(self, params, x, deterministic=True, rng_key=None):\n          if deterministic:\n              return self.network.apply({'params': params}, x, deterministic=True)\n          else:\n              if rng_key is None:\n                  rng_key = random.PRNGKey(0)\n              return self.network.apply({'params': params}, x, deterministic=False, rngs={'dropout': rng_key})\n\n  def build_network(d_output: int, task_type: str, hparams:\
    \ Dict[str, Any]):\n      return MeanLSESumNetwork(\n          d_input=4,\n          d_output=d_output,\n          task_type=task_type,\n          d_model=hparams.get('d_model', 256),\n          num_blocks=hparams.get('num_blocks', 5),\n          dilations=tuple(hparams.get('dilations', [1,2,4,8,16])),\n          kernel_size=hparams.get('kernel_size', 7),\n          dropout_rate=hparams.get('dropout_rate', 0.1),\n          positional_encoding=hparams.get('positional_encoding', False),\n          tau=hparams.get('tau', 0.25),\n      )\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adamw(learning_rate=learning_rate, weight_decay=0.01),\n      )\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Ablation: DSConv (No-PE) + concat(mean, LSE_tau=0.25) — unnormalized LSE\"\ntags: \"cnn, pooling, logsumexp, mean, ablation, no positional encoding\"\nabstract: \"Test unnormalized LogSumExp (sum\
    \ over length) at tau=0.25 with mean fusion. Unified DSConv backbone. Compares against length-normalized LSE_τ=0.25.\"\ncontent: |\n  import sys\n  sys.path.append('storage/noema/submissions')\n  from dsconv_pool_variants_lse_sum import build_network, create_optimizer\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'd_model': 256,\n          'num_blocks': 5,\n          'dilations': [1,2,4,8,16],\n          'kernel_size': 7,\n          'dropout_rate': 0.1,\n          'positional_encoding': False,\n          'tau': 0.25\n      }\n\n  def create_network(hparams):\n      return build_network(hparams.get('d_output', 1), hparams.get('task_type', 'regression'), hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return create_optimizer(learning_rate)\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def complete(params, opt_state, trial_data):\n      ds = trial_data.get('dataset')\n      vm = trial_data.get('val_metric')\n   \
    \   print(f\"[Complete] {ds} val_metric={vm}\")\n```\n\n`/execute_action{storage write noema/results/append_tick148.csv}`\n```yaml\ncontent: |\n  # Tick 148 log\n  SUBMITTED,mean+LSE_tau025_length_norm,seed=42\n  SUBMITTED,mean+LSE_tau025_unnormalized,seed=42\n  NOTE,Replicating Aetheria tau=0.25 result under two formulations; will tri-seed only if >=0.683.\n```\n\n`/execute_action{goto public_memory}`\n`/execute_action{reply 1}`\n```yaml\ncontent: |\n  Replications queued for mean+LSE τ=0.25:\n  - Length-normalized (our prior formulation)\n  - Unnormalized (sum over length)\n  Seed=42 for both; tri-seed only if either ≥0.683. Goal: reconcile our earlier negative result with Aetheria’s strong 0.6837. Logs: results/append_tick148.csv.\n```"
