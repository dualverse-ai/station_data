- text: "`/execute_action{goto research}`\n`/execute_action{storage write noema/submissions/gated_dualpath.py}`\n```yaml\ncontent: |\n  import jax\n  import jax.numpy as jnp\n  from jax import random\n  import flax.linen as nn\n  import optax\n  from typing import Sequence, Dict, Any\n\n  class DSConvDilatedBlock(nn.Module):\n      d_model: int\n      kernel_size: int = 7\n      dilation: int = 1\n      dropout_rate: float = 0.1\n      @nn.compact\n      def __call__(self, x, deterministic=True):\n          h = nn.LayerNorm()(x)\n          h = nn.Conv(features=self.d_model,\n                      kernel_size=(self.kernel_size,),\n                      feature_group_count=self.d_model,\n                      padding='SAME',\n                      kernel_dilation=(self.dilation,),\n                      name='dw_conv')(h)\n          h = nn.gelu(h)\n          h = nn.Conv(features=self.d_model, kernel_size=(1,), name='pw_conv')(h)\n          h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n\
    \          return x + h\n\n  class MeanMaxPoolingHead(nn.Module):\n      d_model: int\n      dropout_rate: float\n      @nn.compact\n      def __call__(self, h_cnn, deterministic=True):\n          mean_vec = jnp.mean(h_cnn, axis=1)\n          max_vec  = jnp.max(h_cnn, axis=1)\n          fused = jnp.concatenate([mean_vec, max_vec], axis=-1)\n          z = nn.LayerNorm()(fused)\n          z = nn.Dense(self.d_model)(z)\n          z = nn.gelu(z)\n          z = nn.Dropout(rate=self.dropout_rate)(z, deterministic=deterministic)\n          return z\n\n  class AdditiveAttentionPooling(nn.Module):\n      features: int\n      dropout_rate: float = 0.1\n      @nn.compact\n      def __call__(self, x, deterministic=True):\n          query = self.param('query', nn.initializers.normal(0.02), (self.features,))\n          proj = nn.Dense(self.features, name='attn_proj')(x)\n          proj = jnp.tanh(proj)\n          scores = jnp.einsum('blc,c->bl', proj, query)\n          w = nn.softmax(scores, axis=-1)\n\
    \          w = nn.Dropout(rate=self.dropout_rate)(w, deterministic=deterministic)\n          return jnp.einsum('bl,blc->bc', w, x)\n\n  class BiLSTMAdditiveAttentionHead(nn.Module):\n      d_model: int\n      lstm_hidden_dim: int\n      dropout_rate: float\n      @nn.compact\n      def __call__(self, h_cnn, deterministic=True):\n          fwd = nn.RNN(nn.LSTMCell(self.lstm_hidden_dim), name='forward_lstm')\n          bwd = nn.RNN(nn.LSTMCell(self.lstm_hidden_dim), name='backward_lstm')\n          h_bi = nn.Bidirectional(fwd, bwd)(h_cnn)\n          pooled = AdditiveAttentionPooling(features=2*self.lstm_hidden_dim,\n                                            dropout_rate=self.dropout_rate)(h_bi, deterministic=deterministic)\n          z = nn.LayerNorm()(pooled)\n          z = nn.Dense(self.d_model)(z)\n          z = nn.gelu(z)\n          z = nn.Dropout(rate=self.dropout_rate)(z, deterministic=deterministic)\n          return z\n\n  class GatedDualPathNetwork(nn.Module):\n      d_input:\
    \ int = 4\n      d_output: int = 1\n      task_type: str = 'regression'\n      d_model: int = 256\n      num_blocks: int = 5\n      dilations: Sequence[int] = (1,2,4,8,16)\n      cnn_kernel_size: int = 7\n      lstm_hidden_dim: int = 128\n      dropout_rate: float = 0.1\n      positional_encoding: bool = False\n      alpha_init_val: float = 0.0  # sigmoid(0)=0.5\n\n      @nn.compact\n      def __call__(self, x, deterministic=True):\n          h = nn.Dense(self.d_model, name='in_proj')(x)\n          h = nn.gelu(h)\n          h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n          for i in range(self.num_blocks):\n              d = self.dilations[i] if i < len(self.dilations) else self.dilations[-1]\n              h = DSConvDilatedBlock(self.d_model, self.cnn_kernel_size, d, self.dropout_rate)(h, deterministic=deterministic)\n          path1 = MeanMaxPoolingHead(self.d_model, self.dropout_rate, name='cnn_only_head')(h, deterministic=deterministic)\n          path2\
    \ = BiLSTMAdditiveAttentionHead(self.d_model, self.lstm_hidden_dim, self.dropout_rate, name='hybrid_bilstm_head')(h, deterministic=deterministic)\n          alpha_logit = self.param('alpha_logit', nn.initializers.constant(self.alpha_init_val), ())\n          alpha = nn.sigmoid(alpha_logit)\n          blended = alpha * path1 + (1.0 - alpha) * path2\n          z = nn.LayerNorm()(blended)\n          z = nn.Dense(self.d_model)(z)\n          z = nn.gelu(z)\n          z = nn.Dropout(rate=self.dropout_rate)(z, deterministic=deterministic)\n          logits = nn.Dense(self.d_output, name='out')(z)\n          if self.task_type == 'regression' and self.d_output == 1:\n              return logits.squeeze(-1)\n          return logits\n\n  class GatedDualPathNetworkWrapper:\n      def __init__(self, d_input, d_output, task_type, **kwargs):\n          self.network = GatedDualPathNetwork(d_input=d_input, d_output=d_output, task_type=task_type, **kwargs)\n      def init(self, rng_key, dummy_input):\n\
    \          params_key, dropout_key = random.split(rng_key)\n          variables = self.network.init({'params': params_key, 'dropout': dropout_key}, dummy_input, deterministic=True)\n          return variables['params']\n      def apply(self, params, x, deterministic=True, rng_key=None):\n          if deterministic:\n              return self.network.apply({'params': params}, x, deterministic=True)\n          else:\n              if rng_key is None:\n                  rng_key = random.PRNGKey(0)\n              return self.network.apply({'params': params}, x, deterministic=False, rngs={'dropout': rng_key})\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'd_model': 256,\n          'num_blocks': 5,\n          'dilations': [1,2,4,8,16],\n          'cnn_kernel_size': 7,\n          'lstm_hidden_dim': 128,\n          'dropout_rate': 0.1,\n          'positional_encoding': False,\n          'alpha_init_val': 0.0\n      }\n\n  def create_network(hparams:\
    \ Dict[str, Any]):\n      d_output = hparams.get('d_output', 1)\n      task_type = hparams.get('task_type', 'regression')\n      return GatedDualPathNetworkWrapper(\n          d_input=4,\n          d_output=d_output,\n          task_type=task_type,\n          d_model=hparams.get('d_model', 256),\n          num_blocks=hparams.get('num_blocks', 5),\n          dilations=tuple(hparams.get('dilations', [1,2,4,8,16])),\n          cnn_kernel_size=hparams.get('cnn_kernel_size', 7),\n          lstm_hidden_dim=hparams.get('lstm_hidden_dim', 128),\n          dropout_rate=hparams.get('dropout_rate', 0.1),\n          positional_encoding=hparams.get('positional_encoding', False),\n          alpha_init_val=hparams.get('alpha_init_val', 0.0),\n      )\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adamw(learning_rate=learning_rate, weight_decay=0.01)\n      )\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def\
    \ complete(params, opt_state, trial_data):\n      ds = trial_data.get('dataset'); vm = trial_data.get('val_metric')\n      print(f\"[Complete] {ds} val_metric={vm}\")\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Replication: Gated Dual-Path (No-PE) — Seed=7\"\ntags: \"replication, dual-path, gating, cnn, bilstm, no positional encoding\"\nabstract: \"Independent replication of Aetheria’s gated dual-path architecture (CNN mean+max + BiLSTM+attn, scalar blend) under unified rules. Seed=7.\"\ncontent: |\n  import sys\n  sys.path.append('storage/noema/submissions')\n  import gated_dualpath as gd\n\n  def _define_hyperparameters():\n      return gd._define_hyperparameters()\n\n  def create_network(hparams):\n      return gd.create_network(hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return gd.create_optimizer(learning_rate)\n\n  BASE_SEED = 7\n  BATCH_SIZE = 64\n\n  def complete(params, opt_state, trial_data):\n      print(f\"[Complete] {trial_data.get('dataset')}\
    \ val_metric={trial_data.get('val_metric')}\")\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Replication: Gated Dual-Path (No-PE) — Seed=123\"\ntags: \"replication, dual-path, gating, cnn, bilstm, no positional encoding\"\nabstract: \"Second replication of the gated dual-path (CNN mean+max + BiLSTM+attn) to assess stability (median/IQR). Seed=123.\"\ncontent: |\n  import sys\n  sys.path.append('storage/noema/submissions')\n  import gated_dualpath as gd\n\n  def _define_hyperparameters():\n      return gd._define_hyperparameters()\n\n  def create_network(hparams):\n      return gd.create_network(hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return gd.create_optimizer(learning_rate)\n\n  BASE_SEED = 123\n  BATCH_SIZE = 64\n\n  def complete(params, opt_state, trial_data):\n      print(f\"[Complete] {trial_data.get('dataset')} val_metric={trial_data.get('val_metric')}\")\n```"
