parts:
- text: "`/execute_action{goto research}`\n`/execute_action{storage write noema/submissions/dsconv_pool_variants_learn_tau.py}`\n```yaml\ncontent: |\n  import jax\n  import jax.numpy as jnp\n  from jax import random, lax\n  import flax.linen as nn\n  import optax\n  from typing import Sequence, Dict, Any\n\n  class DSConvDilatedBlock(nn.Module):\n      d_model: int\n      kernel_size: int = 7\n      dilation: int = 1\n      dropout_rate: float = 0.1\n      @nn.compact\n      def __call__(self, x, deterministic=True):\n          h = nn.LayerNorm()(x)\n          h = nn.Conv(features=self.d_model,\n                      kernel_size=(self.kernel_size,),\n                      feature_group_count=self.d_model,\n                      padding='SAME',\n                      kernel_dilation=(self.dilation,),\n                      name='dw_conv')(h)\n          h = nn.gelu(h)\n          h = nn.Conv(features=self.d_model, kernel_size=(1,), name='pw_conv')(h)\n          h = nn.Dropout(rate=self.dropout_rate)(h,\
    \ deterministic=deterministic)\n          return x + h\n\n  def lse_pool(h: jnp.ndarray, tau: jnp.ndarray) -> jnp.ndarray:\n      # length-normalized log-sum-exp: tau * log(mean(exp(h/tau)))\n      x = h / tau\n      m = jnp.max(x, axis=1, keepdims=True)     # (B,1,C)\n      return tau * (jnp.log(jnp.mean(jnp.exp(x - m), axis=1) + 1e-12) + jnp.squeeze(m, axis=1))\n\n  class RNANetMeanLSELearnTau(nn.Module):\n      d_input: int = 4\n      d_output: int = 1\n      task_type: str = 'regression'\n      d_model: int = 256\n      num_blocks: int = 5\n      dilations: Sequence[int] = (1, 2, 4, 8, 16)\n      kernel_size: int = 7\n      dropout_rate: float = 0.1\n      positional_encoding: bool = False\n      tau_init: float = 0.5    # initial temperature\n\n      @nn.compact\n      def __call__(self, x, deterministic=True):\n          # Backbone\n          h = nn.Dense(self.d_model, name='in_proj')(x)\n          h = nn.gelu(h)\n          h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n\
    \          for i in range(self.num_blocks):\n              d = self.dilations[i] if i < len(self.dilations) else self.dilations[-1]\n              h = DSConvDilatedBlock(self.d_model, self.kernel_size, d, self.dropout_rate)(h, deterministic=deterministic)\n\n          # Learnable global scalar tau (positive via softplus)\n          def _tau_init_fn(key, shape, dtype=jnp.float32):\n              # softplus_inv(y) = log(exp(y)-1)\n              return jnp.broadcast_to(jnp.log(jnp.expm1(jnp.asarray(self.tau_init, dtype))), shape or ())\n          tau_log = self.param('tau_log', _tau_init_fn, ())\n          tau = nn.softplus(tau_log) + 1e-6  # scalar\n\n          # Mean + LSE_tau pooling\n          mean_vec = jnp.mean(h, axis=1)     # (B,C)\n          lse_vec  = lse_pool(h, tau)        # (B,C)\n          fused = jnp.concatenate([mean_vec, lse_vec], axis=-1)  # (B, 2C)\n\n          z = nn.LayerNorm()(fused)\n          z = nn.Dense(self.d_model)(z)\n          z = nn.gelu(z)\n          z =\
    \ nn.Dropout(rate=self.dropout_rate)(z, deterministic=deterministic)\n          logits = nn.Dense(self.d_output, name='out')(z)\n\n          if self.task_type == 'regression' and self.d_output == 1:\n              return logits.squeeze(-1)\n          return logits\n\n  class MeanLSELearnTauNetwork:\n      def __init__(self, d_input, d_output, task_type, **kwargs):\n          self.network = RNANetMeanLSELearnTau(d_input=d_input, d_output=d_output, task_type=task_type, **kwargs)\n      def init(self, rng_key, dummy_input):\n          params_key, dropout_key = random.split(rng_key)\n          variables = self.network.init({'params': params_key, 'dropout': dropout_key}, dummy_input, deterministic=True)\n          return variables['params']\n      def apply(self, params, x, deterministic=True, rng_key=None):\n          if deterministic:\n              return self.network.apply({'params': params}, x, deterministic=True)\n          else:\n              if rng_key is None:\n                \
    \  rng_key = random.PRNGKey(0)\n              return self.network.apply({'params': params}, x, deterministic=False, rngs={'dropout': rng_key})\n\n  def build_network(d_output: int, task_type: str, hparams: Dict[str, Any]):\n      return MeanLSELearnTauNetwork(\n          d_input=4,\n          d_output=d_output,\n          task_type=task_type,\n          d_model=hparams.get('d_model', 256),\n          num_blocks=hparams.get('num_blocks', 5),\n          dilations=tuple(hparams.get('dilations', [1,2,4,8,16])),\n          kernel_size=hparams.get('kernel_size', 7),\n          dropout_rate=hparams.get('dropout_rate', 0.1),\n          positional_encoding=hparams.get('positional_encoding', False),\n          tau_init=hparams.get('tau_init', 0.5),\n      )\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adamw(learning_rate=learning_rate, weight_decay=0.01),\n      )\n```\n\n`/execute_action{submit\
    \ 1}`\n```yaml\ntitle: \"Learnable τ (global): DSConv (No-PE) + concat(mean, LSE_τ) — Seed=42\"\ntags: \"cnn, pooling, logsumexp, learnable temperature, no positional encoding\"\nabstract: \"Make the LogSumExp temperature τ a learned global scalar (initialized to 0.5) in a unified DSConv backbone; hypothesis: adaptivity balances CRI-On vs CRI-Off trade-offs.\"\ncontent: |\n  import sys\n  sys.path.append('storage/noema/submissions')\n  from dsconv_pool_variants_learn_tau import build_network\n  from dsconv_pool_variants_learn_tau import create_optimizer as create_opt\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'd_model': 256,\n          'num_blocks': 5,\n          'dilations': [1,2,4,8,16],\n          'kernel_size': 7,\n          'dropout_rate': 0.1,\n          'positional_encoding': False,\n          'tau_init': 0.5\n      }\n\n  def create_network(hparams):\n      return build_network(hparams.get('d_output', 1), hparams.get('task_type',\
    \ 'regression'), hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return create_opt(learning_rate)\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def complete(params, opt_state, trial_data):\n      print(f\"[Complete] {trial_data.get('dataset')} val_metric={trial_data.get('val_metric')}\")\n```\n\n`/execute_action{storage write noema/submissions/dsconv_pool_variants_hybrid.py}`\n```yaml\ncontent: |\n  import jax\n  import jax.numpy as jnp\n  from jax import random\n  import flax.linen as nn\n  import optax\n  from typing import Sequence, Dict, Any\n\n  class DSConvDilatedBlock(nn.Module):\n      d_model: int\n      kernel_size: int = 7\n      dilation: int = 1\n      dropout_rate: float = 0.1\n      @nn.compact\n      def __call__(self, x, deterministic=True):\n          h = nn.LayerNorm()(x)\n          h = nn.Conv(features=self.d_model,\n                      kernel_size=(self.kernel_size,),\n                      feature_group_count=self.d_model,\n            \
    \          padding='SAME',\n                      kernel_dilation=(self.dilation,),\n                      name='dw_conv')(h)\n          h = nn.gelu(h)\n          h = nn.Conv(features=self.d_model, kernel_size=(1,), name='pw_conv')(h)\n          h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n          return x + h\n\n  def lse_pool(h: jnp.ndarray, tau: float) -> jnp.ndarray:\n      x = h / tau\n      m = jnp.max(x, axis=1, keepdims=True)\n      return tau * (jnp.log(jnp.mean(jnp.exp(x - m), axis=1) + 1e-12) + jnp.squeeze(m, axis=1))\n\n  class RNANetHybridMeanMaxLSE(nn.Module):\n      d_input: int = 4\n      d_output: int = 1\n      task_type: str = 'regression'\n      d_model: int = 256\n      num_blocks: int = 5\n      dilations: Sequence[int] = (1, 2, 4, 8, 16)\n      kernel_size: int = 7\n      dropout_rate: float = 0.1\n      positional_encoding: bool = False\n      tau: float = 0.5\n\n      @nn.compact\n      def __call__(self, x, deterministic=True):\n\
    \          h = nn.Dense(self.d_model, name='in_proj')(x)\n          h = nn.gelu(h)\n          h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n          for i in range(self.num_blocks):\n              d = self.dilations[i] if i < len(self.dilations) else self.dilations[-1]\n              h = DSConvDilatedBlock(self.d_model, self.kernel_size, d, self.dropout_rate)(h, deterministic=deterministic)\n\n          mean_vec = jnp.mean(h, axis=1)         # (B,C)\n          max_vec  = jnp.max(h, axis=1)          # (B,C)\n          lse_vec  = lse_pool(h, self.tau)       # (B,C)\n          fused = jnp.concatenate([mean_vec, max_vec, lse_vec], axis=-1)  # (B, 3C)\n\n          z = nn.LayerNorm()(fused)\n          z = nn.Dense(self.d_model)(z)\n          z = nn.gelu(z)\n          z = nn.Dropout(rate=self.dropout_rate)(z, deterministic=deterministic)\n          logits = nn.Dense(self.d_output, name='out')(z)\n          if self.task_type == 'regression' and self.d_output == 1:\n\
    \              return logits.squeeze(-1)\n          return logits\n\n  class HybridMeanMaxLSENetwork:\n      def __init__(self, d_input, d_output, task_type, **kwargs):\n          self.network = RNANetHybridMeanMaxLSE(d_input=d_input, d_output=d_output, task_type=task_type, **kwargs)\n      def init(self, rng_key, dummy_input):\n          params_key, dropout_key = random.split(rng_key)\n          variables = self.network.init({'params': params_key, 'dropout': dropout_key}, dummy_input, deterministic=True)\n          return variables['params']\n      def apply(self, params, x, deterministic=True, rng_key=None):\n          if deterministic:\n              return self.network.apply({'params': params}, x, deterministic=True)\n          else:\n              if rng_key is None:\n                  rng_key = random.PRNGKey(0)\n              return self.network.apply({'params': params}, x, deterministic=False, rngs={'dropout': rng_key})\n\n  def build_network(d_output: int, task_type: str, hparams:\
    \ Dict[str, Any]):\n      return HybridMeanMaxLSENetwork(\n          d_input=4,\n          d_output=d_output,\n          task_type=task_type,\n          d_model=hparams.get('d_model', 256),\n          num_blocks=hparams.get('num_blocks', 5),\n          dilations=tuple(hparams.get('dilations', [1,2,4,8,16])),\n          kernel_size=hparams.get('kernel_size', 7),\n          dropout_rate=hparams.get('dropout_rate', 0.1),\n          positional_encoding=hparams.get('positional_encoding', False),\n          tau=hparams.get('tau', 0.5),\n      )\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adamw(learning_rate=learning_rate, weight_decay=0.01),\n      )\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Hybrid pooling: concat(mean, max, LSE_tau=0.5) — Seed=42\"\ntags: \"cnn, pooling, hybrid, mean, max, logsumexp, no positional encoding\"\nabstract: \"Parallel pooling paths (mean, max, LSE_τ=0.5)\
    \ concatenated, letting the head learn task-appropriate weighting under a unified backbone.\"\ncontent: |\n  import sys\n  sys.path.append('storage/noema/submissions')\n  from dsconv_pool_variants_hybrid import build_network\n  from dsconv_pool_variants_hybrid import create_optimizer as create_opt\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'd_model': 256,\n          'num_blocks': 5,\n          'dilations': [1,2,4,8,16],\n          'kernel_size': 7,\n          'dropout_rate': 0.1,\n          'positional_encoding': False,\n          'tau': 0.5\n      }\n\n  def create_network(hparams):\n      return build_network(hparams.get('d_output', 1), hparams.get('task_type', 'regression'), hparams)\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return create_opt(learning_rate)\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def complete(params, opt_state, trial_data):\n      print(f\"[Complete] {trial_data.get('dataset')} val_metric={trial_data.get('val_metric')}\"\
    )\n```\n\n`/execute_action{storage write noema/results/append_tick132.csv}`\n```yaml\ncontent: |\n  # Tick 132 log\n  SUBMITTED,learnable_tau_mean+LSE,seed=42\n  SUBMITTED,hybrid_mean_max_lse_tau05,seed=42\n```\n\n`/execute_action{update 7-1}`\n```yaml\ncontent: |\n  Post-review plan (Tick 132): We are addressing the reviewer’s suggestions with two unified variants:\n  - Learnable τ: mean+LSE with a global, strictly-positive trainable τ (initialized to 0.5) to adapt pooling hardness during training (submitted, seed=42).\n  - Hybrid pooling: concat(mean, max, LSE_τ=0.5) with a shared head to learn the appropriate weighting across tasks (submitted, seed=42).\n  We will report tri-seed medians/IQR and per-dataset deltas. If gains are not robust, we will document as negative and keep mean+LSE_τ=0.5 (or mean+max) as the parsimonious default.\n```\n\n`/execute_action{storage write noema/results/SOTA_MONITOR.md}`\n```yaml\ncontent: |\n  SOTA Monitor (Tick 132)\n  - Top single-run remains ID\
