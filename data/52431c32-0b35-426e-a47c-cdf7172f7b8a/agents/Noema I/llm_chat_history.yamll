- text: "`/execute_action{goto research}`\n`/execute_action{storage write noema/results/append_tick75.csv}`\n```yaml\ncontent: |\n  evaluation_id,title,score,APA_R2,CRI-Off_Spearman,CRI-On_Spearman,PRS_R2,MRL_R2,Modif_AUC_ROC,ncRNA_Accuracy,notes\n  132,\"No-PE + Gated Second-Order Pooling (LRB r=8; gate_bias=-2.0; gate=mean+MHA)\",0.6667,0.8586,0.0541,0.4788,0.5567,0.8844,0.9509,0.8831,\"Gated LRB blended with baseline; aggregate < SOTA; small CRI-Off gain vs many variants but below SOTA; ncRNA/PRS/MRL down\"\n  133,\"Ablation: Gated Second-Order Pooling (LRB r=8; gate_bias=-4.0; gate=mean only)\",0.6312,0.8518,0.0384,0.4403,0.5629,0.9015,0.9495,0.6738,\"Catastrophic ncRNA collapse; avoid mean-only gate; shows instability of strong baseline bias without informative features\"\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"No-PE + Gated Second-Order Residual (alpha=0.2, temp=2.0, r=4, gate_bias=-3)\"\ntags: \"cnn, dilated dsconv, gated residual, bilinear low-rank, unified, no pe\"\
    \nabstract: \"Safer conditional pooling: fuse baseline with second-order path via a small residual blend alpha=0.2 scaled by a smoothed gate (temp=2.0), low-rank r=4, gate biased to baseline (bias=-3). Goal: retain CRI-On benefits without harming APA/MRL/ncRNA.\"\ncontent: |\n  import jax\n  import jax.numpy as jnp\n  from jax import random\n  import flax.linen as nn\n  import optax\n  from typing import Sequence\n\n  class DSConvDilatedBlock(nn.Module):\n      d_model: int\n      kernel_size: int = 7\n      dilation: int = 1\n      dropout_rate: float = 0.1\n      @nn.compact\n      def __call__(self, x, deterministic=True):\n          h = nn.LayerNorm()(x)\n          h = nn.Conv(features=self.d_model, kernel_size=(self.kernel_size,),\n                      feature_group_count=self.d_model, padding='SAME',\n                      kernel_dilation=(self.dilation,))(h)\n          h = nn.gelu(h)\n          h = nn.Conv(features=self.d_model, kernel_size=(1,))(h)\n          h = nn.Dropout(rate=self.dropout_rate)(h,\
    \ deterministic=deterministic)\n          return x + h\n\n  class FixedQueryAttnPool1D(nn.Module):\n      d_model: int\n      num_heads: int = 4\n      attn_temp: float = 0.5\n      @nn.compact\n      def __call__(self, x):\n          B, L, C = x.shape\n          H = self.num_heads\n          Dh = C // H\n          k = nn.DenseGeneral(features=(H, Dh), axis=-1)(x)\n          v = nn.DenseGeneral(features=(H, Dh), axis=-1)(x)\n          q = self.param('q', nn.initializers.normal(0.02), (H, Dh))\n          scale = jnp.sqrt(jnp.asarray(Dh, dtype=x.dtype))\n          logits = jnp.einsum('blhd,hd->blh', k, q) / (scale * self.attn_temp)\n          w = nn.softmax(logits, axis=1)\n          return jnp.einsum('blh,blhd->bhd', w, v).reshape(B, C)\n\n  class LowRankBilinearPool(nn.Module):\n      d_model: int\n      rank: int = 4\n      @nn.compact\n      def __call__(self, x):\n          u = nn.Dense(self.rank)(x)                    # (B,L,r)\n          mu = jnp.mean(u, axis=1)                \
    \      # (B,r)\n          mat = jnp.einsum('br,bq->brq', mu, mu)        # (B,r,r)\n          flat = mat.reshape(x.shape[0], self.rank * self.rank)\n          z = nn.LayerNorm()(flat)\n          z = nn.Dense(self.d_model)(z)\n          z = nn.gelu(z)\n          z = nn.LayerNorm()(z)\n          return z                                       # (B,C)\n\n  class RNANetGatedResidualSecondOrder(nn.Module):\n      d_input: int = 4\n      d_output: int = 1\n      task_type: str = 'regression'\n      d_model: int = 256\n      num_blocks: int = 5\n      dilations: Sequence[int] = (1,2,4,8,16)\n      kernel_size: int = 7\n      dropout_rate: float = 0.1\n      num_heads: int = 4\n      attn_temp: float = 0.5\n      rank: int = 4\n      gate_bias_init: float = -3.0\n      gate_temperature: float = 2.0\n      residual_alpha: float = 0.2  # small residual blend\n      @nn.compact\n      def __call__(self, x, deterministic=True):\n          # Encoder\n          h = nn.Dense(self.d_model)(x)\n      \
    \    h = nn.gelu(h)\n          h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n          for i in range(self.num_blocks):\n              d = self.dilations[i] if i < len(self.dilations) else self.dilations[-1]\n              h = DSConvDilatedBlock(self.d_model, self.kernel_size, d, self.dropout_rate)(h, deterministic=deterministic)\n\n          # Baseline global features\n          mean_vec = jnp.mean(h, axis=1)\n          attn_vec = FixedQueryAttnPool1D(self.d_model, self.num_heads, self.attn_temp)(h)\n          gate_in = jnp.concatenate([mean_vec, attn_vec], axis=-1)  # (B,2C)\n\n          base = nn.LayerNorm()(gate_in)\n          base = nn.Dense(self.d_model)(base)\n          base = nn.gelu(base)\n          base = nn.Dropout(rate=self.dropout_rate)(base, deterministic=deterministic)\n\n          # Second-order path (reduced rank, normalized)\n          second = LowRankBilinearPool(self.d_model, self.rank)(h)\n\n          # Smoothed, biased gate\n          g_h\
    \ = nn.LayerNorm()(gate_in)\n          g_h = nn.Dense(self.d_model // 2)(g_h)\n          g_h = nn.gelu(g_h)\n          bias = self.param('gate_bias', lambda k: jnp.array(self.gate_bias_init, dtype=jnp.float32))\n          g_logit = nn.Dense(1)(g_h).squeeze(-1) + bias\n          g = nn.sigmoid(g_logit / self.gate_temperature)[:, None]  # (B,1)\n\n          # Residual blend for safety\n          fused = base + self.residual_alpha * g * (second - base)\n\n          z = nn.LayerNorm()(fused)\n          z = nn.Dense(self.d_model)(z)\n          z = nn.gelu(z)\n          z = nn.Dropout(rate=self.dropout_rate)(z, deterministic=deterministic)\n          logits = nn.Dense(self.d_output)(z)\n          if self.task_type == 'regression' and self.d_output == 1:\n              return logits.squeeze(-1)\n          return logits\n\n  class GatedResidualSecondOrderNetwork:\n      def __init__(self, d_input, d_output, task_type, **kwargs):\n          self.net = RNANetGatedResidualSecondOrder(d_input=d_input,\
    \ d_output=d_output, task_type=task_type, **kwargs)\n      def init(self, rng_key, dummy_input):\n          params_key, dropout_key = random.split(rng_key)\n          variables = self.net.init({'params': params_key, 'dropout': dropout_key}, dummy_input, deterministic=True)\n          return variables['params']\n      def apply(self, params, x, deterministic=True, rng_key=None):\n          if deterministic:\n              return self.net.apply({'params': params}, x, deterministic=True)\n          if rng_key is None:\n              rng_key = random.PRNGKey(0)\n          return self.net.apply({'params': params}, x, deterministic=False, rngs={'dropout': rng_key})\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'd_model': 256,\n          'num_blocks': 5,\n          'dilations': [1,2,4,8,16],\n          'kernel_size': 7,\n          'dropout_rate': 0.1,\n          'num_heads': 4,\n          'attn_temp': 0.5,\n          'rank': 4,\n         \
    \ 'gate_bias_init': -3.0,\n          'gate_temperature': 2.0,\n          'residual_alpha': 0.2,\n      }\n\n  def create_network(hparams):\n      d_output = hparams.get('d_output', 1)\n      task_type = hparams.get('task_type', 'regression')\n      return GatedResidualSecondOrderNetwork(\n          d_input=4,\n          d_output=d_output,\n          task_type=task_type,\n          d_model=hparams.get('d_model', 256),\n          num_blocks=hparams.get('num_blocks', 5),\n          dilations=tuple(hparams.get('dilations', [1,2,4,8,16])),\n          kernel_size=hparams.get('kernel_size', 7),\n          dropout_rate=hparams.get('dropout_rate', 0.1),\n          num_heads=hparams.get('num_heads', 4),\n          attn_temp=hparams.get('attn_temp', 0.5),\n          rank=hparams.get('rank', 4),\n          gate_bias_init=hparams.get('gate_bias_init', -3.0),\n          gate_temperature=hparams.get('gate_temperature', 2.0),\n          residual_alpha=hparams.get('residual_alpha', 0.2),\n      )\n\n\
    \  def create_optimizer(learning_rate: float = 0.001):\n      return optax.chain(optax.clip_by_global_norm(1.0),\n                         optax.adamw(learning_rate=learning_rate, weight_decay=0.01))\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n\n  def complete(params, opt_state, trial_data):\n      ds = trial_data.get('dataset')\n      vm = trial_data.get('val_metric')\n      print(f\"[Complete] {ds} val_metric={vm}\")\n```\n\n`/execute_action{goto private_memory}`\n`/execute_action{reply 3}`\n```yaml\ncontent: |\n  Tick 75 — Gate results and next step\n  - 132 (gate_bias=-2, mean+MHA): 0.6667 (APA 0.8586, CRI-Off 0.0541, CRI-On 0.4788, PRS 0.5567, MRL 0.8844, Modif 0.9509, ncRNA 0.8831).\n  - 133 (gate_bias=-4, mean-only): 0.6312 with ncRNA collapse (0.6738). Strong baseline bias + weak gate features is unsafe.\n  - Action: Submitted safer gated residual (alpha=0.2, temp=2.0, r=4, bias=-3) to cap second-order influence and smooth gate. Logged CSV (append_tick75.csv).\n  - Criterion unchanged:\
    \ only adopt if ≥0.6801 without harming APA/MRL/ncRNA; otherwise record as negative and keep SOTA.\n```"
