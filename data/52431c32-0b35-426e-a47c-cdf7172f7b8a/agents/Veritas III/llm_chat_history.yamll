    \ performance and CRI-Off. BASE_SEED=42 is explicitly set for reproducibility.\"\ncontent: |\n  import jax\n  import jax.numpy as jnp\n  import flax.linen as nn\n  from jax import random\n  import optax\n  from typing import Dict, Any, Sequence\n\n  # Hyperparameters for CPE-enhanced Simple 1D CNN\n  def _define_hyperparameters():\n      return {\n          'learning_rate': 0.001,\n          'dropout_rate_conv': 0.2,\n          'hidden_dim_conv1': 128,\n          'hidden_dim_conv2': 256,\n          'kernel_size': 5,\n          'pos_embedding_dim': 8,         # MODIFIED: Reduced pos_embedding_dim\n          'context_window_size': 3,\n          'max_overall_seq_len': 1200\n      }\n\n  # --- ContextEncoder for CPE ---\n  class ContextEncoder(nn.Module):\n      output_dim: int\n      @nn.compact\n      def __call__(self, local_context_window):\n          flat_context = local_context_window.reshape(local_context_window.shape[0], -1)\n          encoded_context = nn.Dense(self.output_dim,\
    \ name='context_dense')(flat_context)\n          encoded_context = nn.gelu(encoded_context)\n          return encoded_context\n\n  # --- CPE_Generator Module ---\n  class CPE_Generator(nn.Module):\n      d_input: int\n      pos_embedding_dim: int\n      context_window_size: int\n      max_overall_seq_len: int\n      @nn.compact\n      def __call__(self, x_raw): # x_raw is (batch, seq_len, d_input)\n          batch_size, seq_len, _ = x_raw.shape\n\n          positional_embeddings_table = self.param(\n              'pos_embeddings_table',\n              nn.initializers.normal(stddev=0.01),\n              (self.max_overall_seq_len, self.pos_embedding_dim)\n          )\n\n          pad_width = self.context_window_size // 2\n          padded_x = jnp.pad(x_raw, ((0,0), (pad_width, pad_width), (0,0)), mode='constant', constant_values=0.0)\n          \n          all_windows_flat = jnp.stack(\n              [padded_x[:, i : i + self.context_window_size, :].reshape(batch_size, -1) for i in range(seq_len)],\n\
    \              axis=1\n          )\n\n          context_encoder = ContextEncoder(output_dim=self.pos_embedding_dim, name='context_encoder')\n          encoded_contexts_batched = context_encoder(all_windows_flat.reshape(-1, self.context_window_size * self.d_input)).reshape(batch_size, seq_len, -1)\n\n          current_pos_embeddings_sliced = positional_embeddings_table[:seq_len] \n          current_pos_embeddings_batched = jnp.tile(current_pos_embeddings_sliced[None, :, :], (batch_size, 1, 1))\n          \n          cpe_raw_signals = current_pos_embeddings_batched * encoded_contexts_batched\n          return cpe_raw_signals # (batch, seq_len, pos_embedding_dim)\n\n  # --- Simple 1D CNN with CPE (Input Concatenation) ---\n  class Simple1DCNNWithCPE(nn.Module):\n      d_input: int = 4\n      d_output: int = 1\n      task_type: str = \"regression\"\n      hidden_dim_conv1: int = 128\n      hidden_dim_conv2: int = 256\n      kernel_size: int = 5\n      dropout_rate_conv: float = 0.2\n   \
    \   \n      # CPE-specific hparams\n      pos_embedding_dim: int = 8 # MODIFIED\n      context_window_size: int = 3\n      max_overall_seq_len: int = 1200\n\n      @nn.compact\n      def __call__(self, x_raw, deterministic=True):\n          # 1. Generate CPE signals\n          cpe_generator = CPE_Generator(\n              d_input=self.d_input,\n              pos_embedding_dim=self.pos_embedding_dim,\n              context_window_size=self.context_window_size,\n              max_overall_seq_len=self.max_overall_seq_len,\n              name='cpe_generator'\n          )\n          cpe_output = cpe_generator(x_raw) # (batch, seq_len, pos_embedding_dim)\n\n          # 2. Augment input with CPE\n          x_augmented = jnp.concatenate([x_raw, cpe_output], axis=-1) # (batch, seq_len, d_input + pos_embedding_dim)\n\n          # 3. Apply 1D CNN layers\n          x = nn.Conv(features=self.hidden_dim_conv1, kernel_size=(self.kernel_size,), padding='SAME', name='conv1')(x_augmented)\n          x\
    \ = nn.relu(x)\n          x = nn.Dropout(rate=self.dropout_rate_conv)(x, deterministic=deterministic)\n\n          x = nn.Conv(features=self.hidden_dim_conv2, kernel_size=(self.kernel_size,), padding='SAME', name='conv2')(x)\n          x = nn.relu(x)\n          x = nn.Dropout(rate=self.dropout_rate_conv)(x, deterministic=deterministic)\n\n          # 4. Global Average Pooling\n          x = jnp.mean(x, axis=1) # (batch, hidden_dim_conv2)\n\n          # 5. Output Head\n          x = nn.Dense(self.d_output)(x) # (batch, d_output)\n\n          if self.d_output == 1 and self.task_type == \"regression\":\n              return x.squeeze(-1) # (batch,)\n          else:\n              return x # (batch, d_output)\n\n  # Wrapper to conform to the system's create_network interface\n  class DefaultRNANetworkForCPE_CNN:\n      def __init__(self, d_output=1, task_type='regression', hparams: Dict[str, Any] = None):\n          hp = hparams or {}\n          self.network = Simple1DCNNWithCPE(\n     \
    \         d_output=d_output,\n              task_type=task_type,\n              hidden_dim_conv1=int(hp.get('hidden_dim_conv1', 128)),\n              hidden_dim_conv2=int(hp.get('hidden_dim_conv2', 256)),\n              kernel_size=int(hp.get('kernel_size', 5)),\n              dropout_rate_conv=float(hp.get('dropout_rate_conv', 0.2)),\n              pos_embedding_dim=int(hp.get('pos_embedding_dim', 8)), # MODIFIED\n              context_window_size=int(hp.get('context_window_size', 3)),\n              max_overall_seq_len=int(hp.get('max_overall_seq_len', 1200))\n          )\n      \n      def init(self, rng_key, dummy_input):\n          params_key, dropout_key = random.split(rng_key)\n          variables = self.network.init({'params': params_key, 'dropout': dropout_key},\n                                       dummy_input, deterministic=True)\n          return variables['params']\n\n      def apply(self, params, x_raw, deterministic=True, rng_key=None):\n          if deterministic:\n\
    \              return self.network.apply({'params': params}, x_raw, deterministic=True)\n          else:\n              if rng_key is None:\n                  rng_key = random.PRNGKey(0)\n              return self.network.apply({'params': params}, x_raw, deterministic=False,\n                                      rngs={'dropout': rng_key})\n\n  def create_network(hparams: Dict[str, Any]):\n      return DefaultRNANetworkForCPE_CNN(\n          d_output=hparams.get('d_output', 1),\n          task_type=hparams.get('task_type', 'regression'),\n          hparams=hparams\n      )\n\n  def create_optimizer(learning_rate: float = 0.001):\n      return optax.adamw(learning_rate=learning_rate, weight_decay=0.01)\n\n  BASE_SEED = 42\n  BATCH_SIZE = 64\n```"
