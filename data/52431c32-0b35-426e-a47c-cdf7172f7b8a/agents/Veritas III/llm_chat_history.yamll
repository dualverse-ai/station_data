tick: 550
role: model
parts:
- text: "I have a robust experimental plan for \"Deep CPE Integration with Learned Gating\". Now, I will assemble the complete submission code. I need to make sure all modules, classes, and functions are correctly defined and integrated, especially the new `CPE_Generator` and `DeepCPE_DSConvDilatedBlock_Gated`.\n\n**Full Code Structure for Submission (`submission.py`):**\n\n```python\nimport sys\n# The DSConvNetworkWrapper import was removed in previous debugging, will not be re-added as it's unused.\n\nimport jax\nimport jax.numpy as jnp\nimport flax.linen as nn\nfrom jax import random\nimport optax\nfrom typing import Any, Dict, Sequence\n\n# --- Define Hyperparameters ---\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'd_model_common': 256,\n        'ds_num_blocks': 5,\n        'ds_dilations': (1, 2, 4, 8, 16),\n        'ds_kernel_size': 7,\n        'motif_kernel_size': 5,\n        \n        'dropout_rate': 0.1,\n        'reg_head_dropout': 0.05,\n\
    \        'head_intermediate_dim': 128,\n        'weight_decay': 0.012,\n\n        'pos_embedding_dim': 16,        \n        'context_window_size': 3,       \n        'max_overall_seq_len': 1200,    \n        'gate_intermediate_dim': 64,    # New: for learned gating mechanism\n    }\n\n# --- Prediction Head Modules (from ID 730, unchanged) ---\n# Will include: RegressionHead, MultiLabelRegressionHead, MultiLabelClassificationHead, MultiClassClassificationHead\n# (Code as previously defined in the `content` block for ID 799/815, not re-pasted here to save tokens in reflection, but will be in actual submission)\nclass RegressionHead(nn.Module):\n    d_output: int\n    dense_dim: int = 128\n    dropout_rate: float = 0.1\n    l2_norm_input: bool = False\n\n    @nn.compact\n    def __call__(self, x, deterministic=True):\n        if self.l2_norm_input:\n            norm = jnp.linalg.norm(x, ord=2, axis=-1, keepdims=True)\n            x = x / (norm + 1e-6)\n\n        z = nn.Dense(self.dense_dim,\
    \ name='head_dense_1')(x)\n        z = nn.gelu(z)\n        z = nn.Dropout(rate=self.dropout_rate)(z, deterministic=deterministic)\n        logits = nn.Dense(self.d_output, name='out_proj')(z)\n        return logits.squeeze(-1)\n\nclass MultiLabelRegressionHead(nn.Module):\n    d_output: int\n    dense_dim: int = 128\n    dropout_rate: float = 0.1\n\n    @nn.compact\n    def __call__(self, x, deterministic=True):\n        z = nn.Dense(self.dense_dim, name='head_dense_1')(x)\n        z = nn.gelu(z)\n        z = nn.Dropout(rate=self.dropout_rate)(z, deterministic=deterministic)\n        logits = nn.Dense(self.d_output, name='out_proj')(z)\n        return logits\n\nclass MultiLabelClassificationHead(nn.Module):\n    d_output: int\n    dense_dim: int = 128\n    dropout_rate: float = 0.1\n\n    @nn.compact\n    def __call__(self, x, deterministic=True):\n        z = nn.Dense(self.dense_dim, name='head_dense_1')(x)\n        z = nn.gelu(z)\n        z = nn.Dropout(rate=self.dropout_rate)(z, deterministic=deterministic)\n\
    \        logits = nn.Dense(self.d_output, name='out_proj')(z)\n        return logits\n\nclass MultiClassClassificationHead(nn.Module):\n    d_output: int\n    dense_dim: int = 128\n    dropout_rate: float = 0.1\n\n    @nn.compact\n    def __call__(self, x, deterministic=True):\n        z = nn.Dense(self.dense_dim, name='head_dense_1')(x)\n        z = nn.gelu(z)\n        z = nn.Dropout(rate=self.dropout_rate)(z, deterministic=deterministic)\n        logits = nn.Dense(self.d_output, name='out_proj')(z)\n        return logits\n\n# --- ContextEncoder for CPE (unchanged) ---\nclass ContextEncoder(nn.Module):\n    output_dim: int\n    @nn.compact\n    def __call__(self, local_context_window):\n        flat_context = local_context_window.reshape(local_context_window.shape[0], -1)\n        encoded_context = nn.Dense(self.output_dim, name='context_dense')(flat_context)\n        encoded_context = nn.gelu(encoded_context)\n        return encoded_context\n\n# --- CPE_Generator Module (unchanged)\
    \ ---\nclass CPE_Generator(nn.Module):\n    d_input: int\n    pos_embedding_dim: int\n    context_window_size: int\n    max_overall_seq_len: int\n\n    @nn.compact\n    def __call__(self, x_raw):\n        batch_size, seq_len, _ = x_raw.shape\n\n        positional_embeddings_table = self.param(\n            'pos_embeddings_table',\n            nn.initializers.normal(stddev=0.01),\n            (self.max_overall_seq_len, self.pos_embedding_dim)\n        )\n\n        pad_width = self.context_window_size // 2\n        padded_x = jnp.pad(x_raw, ((0,0), (pad_width, pad_width), (0,0)), mode='constant', constant_values=0.0)\n        \n        all_windows_flat = jnp.stack(\n            [padded_x[:, i : i + self.context_window_size, :].reshape(batch_size, -1) for i in range(seq_len)],\n            axis=1\n        )\n\n        context_encoder = ContextEncoder(output_dim=self.pos_embedding_dim, name='context_encoder')\n        encoded_contexts_batched = context_encoder(all_windows_flat.reshape(-1,\
    \ self.context_window_size * self.d_input)).reshape(batch_size, seq_len, -1)\n\n        current_pos_embeddings_sliced = positional_embeddings_table[:seq_len] \n        current_pos_embeddings_batched = jnp.tile(current_pos_embeddings_sliced[None, :, :], (batch_size, 1, 1))\n        \n        cpe_raw_signals = current_pos_embeddings_batched * encoded_contexts_batched\n        return cpe_raw_signals\n\n# --- MODIFIED DSConvDilatedBlock for Deep CPE integration with Learned Gating ---\nclass DeepCPE_DSConvDilatedBlock_Gated(nn.Module):\n    d_model: int\n    cpe_raw_signals: Any  # (batch, seq_len, pos_embedding_dim)\n    kernel_size: int = 7\n    dilation: int = 1\n    dropout_rate: float = 0.1\n    pos_embedding_dim: int = 16 # for parameterization (though not directly used here)\n    gate_intermediate_dim: int = 64 # New hyperparameter\n\n    @nn.compact\n    def __call__(self, x, deterministic=True):\n        residual = x\n        h = nn.LayerNorm()(x)\n\n        # Standard DSConv operations\n\
    \        dw_out = nn.Conv(features=self.d_model, kernel_size=(self.kernel_size,),\n                         feature_group_count=self.d_model, padding='SAME',\n                         kernel_dilation=(self.dilation,), name='dw_conv')(h)\n        dw_out = nn.gelu(dw_out)\n        h_conv_output = nn.Conv(features=self.d_model, kernel_size=(1,), name='pw_conv')(dw_out)\n        # h_conv_output is now (batch, seq_len, d_model)\n\n        # --- LEARNED GATING MECHANISM ---\n        # 1. Project CPE signals to match d_model\n        cpe_projected = nn.Dense(self.d_model, name='cpe_proj_for_gate')(self.cpe_raw_signals)\n        cpe_projected = nn.gelu(cpe_projected) \n\n        # 2. Combine intermediate features (h_conv_output) and projected CPE\n        combined_features = jnp.concatenate([h_conv_output, cpe_projected], axis=-1)\n\n        # 3. Gate Logic: Dense -> GELU -> Dense -> Sigmoid\n        gate_input = nn.Dense(self.gate_intermediate_dim, name='gate_dense_1')(combined_features)\n\
    \        gate_input = nn.gelu(gate_input)\n        gate_output_raw = nn.Dense(self.d_model, name='gate_dense_2')(gate_input)\n        gate_factor = nn.sigmoid(gate_output_raw) # Element-wise sigmoid activation\n\n        # 4. Modulate the convolutional output\n        modulated_h = h_conv_output * gate_factor\n        # --- END LEARNED GATING ---\n\n        # Apply dropout to the modulated features before residual add\n        modulated_h_dropout = nn.Dropout(rate=self.dropout_rate)(modulated_h, deterministic=deterministic)\n        \n        return residual + modulated_h_dropout \n\n\n# --- Main Network: Dual-Path with RegCal + Deep CPE Gated Integration ---\nclass DeepCPE_DualPathRegCal_Gated(nn.Module):\n    d_input: int = 4\n    d_output: int = 1\n    task_type: str = \"regression\"\n\n    d_model_common: int = 256\n    ds_num_blocks: int = 5\n    ds_dilations: Sequence[int] = (1, 2, 4, 8, 16)\n    ds_kernel_size: int = 7\n    motif_kernel_size: int = 5\n    \n    dropout_rate: float\
    \ = 0.1\n    reg_head_dropout: float = 0.05\n    head_intermediate_dim: int = 128\n\n    pos_embedding_dim: int = 16\n    context_window_size: int = 3\n    max_overall_seq_len: int = 1200\n    gate_intermediate_dim: int = 64 # From hparams\n\n    @nn.compact\n    def __call__(self, x_raw, deterministic=True):\n        # Generate CPE raw signals once at the beginning\n        cpe_generator = CPE_Generator(\n            d_input=self.d_input,\n            pos_embedding_dim=self.pos_embedding_dim,\n            context_window_size=self.context_window_size,\n            max_overall_seq_len=self.max_overall_seq_len,\n            name='cpe_generator'\n        )\n        cpe_raw_signals = cpe_generator(x_raw)\n\n        # Initial Dense layer (applied to raw input)\n        x = nn.Dense(self.d_model_common, name=\"initial_dense\")(x_raw)\n        x = nn.gelu(x)\n        x = nn.Dropout(rate=self.dropout_rate)(x, deterministic=deterministic)\n\n        # Loop through DeepCPE_DSConvDilatedBlock_Gated\n\
    \        for i in range(self.ds_num_blocks):\n            dilation = self.ds_dilations[i] if i < len(self.ds_dilations) else self.ds_dilations[-1]\n            x = DeepCPE_DSConvDilatedBlock_Gated(\n                d_model=self.d_model_common,\n                cpe_raw_signals=cpe_raw_signals,\n                kernel_size=self.ds_kernel_size,\n                dilation=dilation,\n                dropout_rate=self.dropout_rate,\n                pos_embedding_dim=self.pos_embedding_dim,\n                gate_intermediate_dim=self.gate_intermediate_dim,\n                name=f\"dsconv_block_{i}\"\n            )(x, deterministic=deterministic)\n        cnn_features = x\n\n        # Motif path, pooling, fusion, RegCal heads remain as in ID 730\n        mean_pooled_main = jnp.mean(cnn_features, axis=1)\n        max_pooled_main = jnp.max(cnn_features, axis=1)\n        main_path_features = jnp.concatenate([mean_pooled_main, max_pooled_main], axis=-1)\n\n        motif_features = nn.Conv(features=self.d_model_common,\
    \ kernel_size=(self.motif_kernel_size,), padding='SAME', name='motif_conv_1')(cnn_features)\n        motif_features = nn.gelu(motif_features)\n        motif_features = nn.Dropout(rate=self.dropout_rate)(motif_features, deterministic=deterministic)\n        specialized_path_features = jnp.max(motif_features, axis=1)\n\n        fused_features = jnp.concatenate([main_path_features, specialized_path_features], axis=-1)\n        fused_features = nn.Dropout(rate=self.dropout_rate)(fused_features, deterministic=deterministic)\n\n        z_fused = nn.LayerNorm(name=\"final_norm\")(fused_features)\n\n        if self.task_type == \"regression\":\n            logits = RegressionHead(d_output=self.d_output, dense_dim=self.head_intermediate_dim, dropout_rate=self.reg_head_dropout, l2_norm_input=True, name='regression_head')(z_fused, deterministic=deterministic)\n        elif self.task_type == \"multilabel_regression\":\n            logits = MultiLabelRegressionHead(d_output=self.d_output, dense_dim=self.head_intermediate_dim,\
    \ dropout_rate=self.dropout_rate, name='multilabel_regression_head')(z_fused, deterministic=deterministic)\n        elif self.task_type == \"multilabel_classification\":\n            logits = MultiLabelClassificationHead(d_output=self.d_output, dense_dim=self.head_intermediate_dim, dropout_rate=self.dropout_rate, name='multilabel_classification_head')(z_fused, deterministic=deterministic)\n        elif self.task_type == \"multiclass_classification\":\n            logits = MultiClassClassificationHead(d_output=self.d_output, dense_dim=self.head_intermediate_dim, dropout_rate=self.dropout_rate, name='multiclass_classification_head')(z_fused, deterministic=deterministic)\n        else:\n            raise ValueError(f\"Unknown task type: {self.task_type}\")\n\n        return logits\n\n# Wrapper to conform to the system's create_network interface\nclass DefaultRNANetworkForDeepCPE_Gated:\n    def __init__(self, d_input=4, d_output=1, task_type=\"regression\", hparams: Dict[str, Any] = None):\n\
    \        hp = hparams or {}\n        self.network = DeepCPE_DualPathRegCal_Gated(\n            d_input=d_input, d_output=d_output, task_type=task_type,\n            d_model_common=int(hp.get('d_model_common', 256)),\n            ds_num_blocks=int(hp.get('ds_num_blocks', 5)),\n            ds_dilations=tuple(hp.get('ds_dilations', [1, 2, 4, 8, 16])),\n            ds_kernel_size=int(hp.get('ds_kernel_size', 7)),\n            motif_kernel_size=int(hp.get('motif_kernel_size', 5)),\n            dropout_rate=float(hp.get('dropout_rate', 0.1)),\n            reg_head_dropout=float(hp.get('reg_head_dropout', 0.05)),\n            head_intermediate_dim=int(hp.get('head_intermediate_dim', 128)),\n            pos_embedding_dim=int(hp.get('pos_embedding_dim', 16)),\n            context_window_size=int(hp.get('context_window_size', 3)),\n            max_overall_seq_len=int(hp.get('max_overall_seq_len', 1200)),\n            gate_intermediate_dim=int(hp.get('gate_intermediate_dim', 64))\n        )\n\n\
    \    def init(self, rng_key, dummy_input):\n        params_key, dropout_key = random.split(rng_key)\n        variables = self.network.init({'params': params_key, 'dropout': dropout_key},\n                                     dummy_input, deterministic=True)\n        return variables['params']\n\n    def apply(self, params, x_raw, deterministic=True, rng_key=None):\n        if deterministic:\n            return self.network.apply({'params': params}, x_raw, deterministic=True)\n        else:\n            if rng_key is None:\n                rng_key = random.PRNGKey(0)\n            return self.network.apply({'params': params}, x_raw, deterministic=False,\n                                    rngs={'dropout': rng_key})\n\ndef create_network(hparams: Dict[str, Any]):\n    return DefaultRNANetworkForDeepCPE_Gated(\n        d_input=4,\n        d_output=hparams.get('d_output', 1),\n        task_type=hparams.get('task_type', 'regression'),\n        hparams=hparams\n    )\n\ndef create_optimizer(learning_rate:\
    \ float = 0.001):\n    weight_decay_value = 0.012 \n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adamw(learning_rate=learning_rate, weight_decay=weight_decay_value)\n    )\n\nBASE_SEED = 42\nBATCH_SIZE = 64\n\n```"
