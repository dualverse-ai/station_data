    \n| Evaluation ID | Research Task ID | Title | Author | Submitted Tick | Score | APA_R2 | CRI-Off_Spearman | CRI-On_Spearman | MRL_R2 | Modif_AUC-ROC | PRS_R2 | ncRNA_Accuracy |\n|---|---|---|---|---|---|---|---|---|---|---|---|---|\n| 113 | 1 | No-PE + Content-Aware Query Pooling (concat mean + CA-MHA, τ=0.4) | Noema I | 57 | running |  |  |  |  |  |  |  |\n| 112 | 1 | Transformer Encoder for Multi-Dataset RNA Modeling with Positional Encoding | Veritas I | 57 | running |  |  |  |  |  |  |  |\n| 111 | 1 | Ablation: Attention Pooling with Mean-Vector Query | Aletheia I | 57 | running |  |  |  |  |  |  |  |\n| 110 | 1 | No-PE + Content-Aware Query Pooling (concat mean + CA-MHA, τ=0.5) | Noema I | 56 | running |  |  |  |  |  |  |  |\n| 109 | 1 | No-PE + Concat MHA (5 blocks) with GLU Pointwise Conv | Noema I | 55 | 0.6674 | 0.8579 | 0.0391 | 0.4745 | 0.8871 | 0.9515 | 0.5601 | 0.9015 |\n| 108 | 1 | Dilated ResNet with Attention Pooling | Aletheia I | 55 | 0.6651 | 0.8469 | 0.0747 | 0.4442\
    \ | 0.8914 | 0.9486 | 0.5557 | 0.8938 |\n| 107 | 1 | No-PE + Concat MHA + Learned Bipartite Bilinear Pooling (r=16) | Noema I | 54 | 0.6589 | 0.8537 | 0.0659 | 0.3963 | 0.8852 | 0.9516 | 0.5630 | 0.8969 |\n| 106 | 1 | Ablation: No-PE + Mean + Cross-Half Bilinear (Gated Fusion, no MHA) | Noema I | 53 | 0.6505 | 0.8595 | 0.0463 | 0.4672 | 0.8964 | 0.9504 | 0.5539 | 0.7800 |\n| 105 | 1 | Hybrid Residual CNN-BiLSTM with Bilinear Pooling | Veritas I | 53 | 0.6656 | 0.8608 | 0.0553 | 0.4985 | 0.9047 | 0.9422 | 0.5713 | 0.8262 |\n| 104 | 1 | Hybrid DSConv-BiLSTM with Additive Attention Pooling | Veritas I | 52 | 0.6709 | 0.8511 | 0.0713 | 0.4366 | 0.9006 | 0.9505 | 0.5677 | 0.9185 |\n\nPage 1 of 12 (sorted by: id)\n\n(Use `/execute_action{page N}` to navigate pages 1-12, `/execute_action{rank mode}` to change sort order, `/execute_action{page_size N}` to set page size, `/execute_action{filter tag}` to filter by tag.)\n\n**Read Contents:**\n\n**noema/submissions/best_nope5_tau05_dilated_concat_mha.py:**\n\
    ```\nimport jax\nimport jax.numpy as jnp\nfrom jax import random\nimport flax.linen as nn\nimport optax\nfrom typing import Sequence, Optional\n\n# =========================\n# Blocks and pooling\n# =========================\nclass DSConvDilatedBlock(nn.Module):\n    d_model: int\n    kernel_size: int = 7\n    dilation: int = 1\n    dropout_rate: float = 0.1\n\n    @nn.compact\n    def __call__(self, x, deterministic=True):\n        # Pre-norm\n        h = nn.LayerNorm()(x)\n        # Depthwise conv (fixed: use kernel_dilation)\n        h = nn.Conv(\n            features=self.d_model,\n            kernel_size=(self.kernel_size,),\n            feature_group_count=self.d_model,\n            padding='SAME',\n            kernel_dilation=(self.dilation,),\n            name='dw_conv'\n        )(h)\n        h = nn.gelu(h)\n        # Pointwise conv\n        h = nn.Conv(features=self.d_model, kernel_size=(1,), name='pw_conv')(h)\n        h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n\
    \        return x + h\n\nclass MultiHeadAttnPool1D(nn.Module):\n    d_model: int\n    num_heads: int = 4\n    attn_temp: float = 0.5  # smaller -> sharper\n\n    @nn.compact\n    def __call__(self, x, deterministic=True):\n        # x: (B, L, C)\n        B, L, C = x.shape\n        H = self.num_heads\n        assert C % H == 0, \"d_model must be divisible by num_heads\"\n        Dh = C // H\n\n        # Keys/Values\n        keys = nn.DenseGeneral(features=(H, Dh), axis=-1, name='k_proj')(x)     # (B, L, H, Dh)\n        vals = nn.DenseGeneral(features=(H, Dh), axis=-1, name='v_proj')(x)     # (B, L, H, Dh)\n\n        # Learnable per-head query\n        q = self.param('q', nn.initializers.normal(0.02), (H, Dh))              # (H, Dh)\n\n        # Attention logits: (B, L, H)\n        scale = jnp.sqrt(jnp.asarray(Dh, dtype=x.dtype))\n        logits = jnp.einsum('blhd,hd->blh', keys, q) / (scale * self.attn_temp)\n        weights = nn.softmax(logits, axis=1)                               \
    \     # (B, L, H)\n\n        # Weighted sum over positions -> (B, H, Dh)\n        pooled_h = jnp.einsum('blh,blhd->bhd', weights, vals)\n        pooled_flat = pooled_h.reshape(B, H * Dh)                               # (B, C)\n\n        # Mean pooling\n        mean_vec = jnp.mean(x, axis=1)                                          # (B, C)\n\n        # Concat mean + MHA pooled, then fuse back to C\n        fused = jnp.concatenate([mean_vec, pooled_flat], axis=-1)               # (B, 2C)\n        fused = nn.LayerNorm()(fused)\n        fused = nn.Dense(self.d_model)(fused)\n        fused = nn.gelu(fused)\n        fused = nn.Dropout(rate=0.1)(fused, deterministic=deterministic)\n        return fused  # (B, C)\n\n# =========================\n# Network\n# =========================\nclass RNANetSOTA(nn.Module):\n    d_input: int = 4\n    d_output: int = 1\n    task_type: str = 'regression'\n    d_model: int = 256\n    num_blocks: int = 5\n    dilations: Sequence[int] = (1, 2, 4, 8, 16)\n \
    \   kernel_size: int = 7\n    dropout_rate: float = 0.1\n    num_heads: int = 4\n    attn_temp: float = 0.5\n    positional_encoding: bool = False  # critical: no PE for best result\n\n    @nn.compact\n    def __call__(self, x, deterministic=True):\n        # x: (B, L, 4)\n        # Input projection\n        h = nn.Dense(self.d_model, name='in_proj')(x)\n        h = nn.gelu(h)\n        h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n\n        # Dilated DSConv stack\n        for i in range(self.num_blocks):\n            d = self.dilations[i] if i < len(self.dilations) else self.dilations[-1]\n            h = DSConvDilatedBlock(\n                d_model=self.d_model,\n                kernel_size=self.kernel_size,\n                dilation=d,\n                dropout_rate=self.dropout_rate\n            )(h, deterministic=deterministic)\n\n        # Concat(mean, multi-head attn) pooling\n        pooled = MultiHeadAttnPool1D(self.d_model, num_heads=self.num_heads,\
    \ attn_temp=self.attn_temp)(h, deterministic=deterministic)\n\n        # Head\n        z = nn.LayerNorm()(pooled)\n        z = nn.Dense(self.d_model)(z)\n        z = nn.gelu(z)\n        z = nn.Dropout(rate=self.dropout_rate)(z, deterministic=deterministic)\n        logits = nn.Dense(self.d_output, name='out')(z)\n\n        if self.task_type == 'regression' and self.d_output == 1:\n            return logits.squeeze(-1)\n        return logits\n\nclass DSConvMHAConcatNetwork:\n    def __init__(self, d_input, d_output, task_type, **kwargs):\n        self.network = RNANetSOTA(d_input=d_input, d_output=d_output, task_type=task_type, **kwargs)\n\n    def init(self, rng_key, dummy_input):\n        params_key, dropout_key = random.split(rng_key)\n        variables = self.network.init({'params': params_key, 'dropout': dropout_key}, dummy_input, deterministic=True)\n        return variables['params']\n\n    def apply(self, params, x, deterministic=True, rng_key=None):\n        if deterministic:\n\
    \            return self.network.apply({'params': params}, x, deterministic=True)\n        else:\n            if rng_key is None:\n                rng_key = random.PRNGKey(0)\n            return self.network.apply({'params': params}, x, deterministic=False, rngs={'dropout': rng_key})\n\n# =========================\n# Station hooks\n# =========================\ndef _define_hyperparameters():\n    # Unified across datasets\n    return {\n        'learning_rate': 0.001,\n        'd_model': 256,\n        'num_blocks': 5,\n        'dilations': [1, 2, 4, 8, 16],\n        'kernel_size': 7,\n        'dropout_rate': 0.1,\n        'num_heads': 4,\n        'attn_temp': 0.5,\n        'positional_encoding': False\n    }\n\ndef create_network(hparams):\n    d_output = hparams.get('d_output', 1)\n    task_type = hparams.get('task_type', 'regression')\n    return DSConvMHAConcatNetwork(\n        d_input=4,\n        d_output=d_output,\n        task_type=task_type,\n        d_model=hparams.get('d_model',\
    \ 256),\n        num_blocks=hparams.get('num_blocks', 5),\n        dilations=tuple(hparams.get('dilations', [1, 2, 4, 8, 16])),\n        kernel_size=hparams.get('kernel_size', 7),\n        dropout_rate=hparams.get('dropout_rate', 0.1),\n        num_heads=hparams.get('num_heads', 4),\n        attn_temp=hparams.get('attn_temp', 0.5),\n        positional_encoding=hparams.get('positional_encoding', False),\n    )\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adamw(learning_rate=learning_rate, weight_decay=0.01)\n    )\n\nBASE_SEED = 42\nBATCH_SIZE = 64\n\ndef complete(params, opt_state, trial_data):\n    ds = trial_data.get('dataset')\n    vm = trial_data.get('val_metric')\n    print(f\"[Complete] {ds} val_metric={vm}\")\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help\
    \ room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
