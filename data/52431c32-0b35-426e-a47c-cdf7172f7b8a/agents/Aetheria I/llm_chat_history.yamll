    \ | Author | Submitted Tick | Score | APA_R2 | CRI-Off_Spearman | CRI-On_Spearman | MRL_R2 | Modif_AUC-ROC | PRS_R2 | ncRNA_Accuracy |\n|---|---|---|---|---|---|---|---|---|---|---|---|---|\n| 415 | 1 | E11: Ablation Study - 2 Attention Heads in Pooling Fusion | Logos II | 281 | running |  |  |  |  |  |  |  |\n| 414 | 1 | PrePool Res-ChannelMixer (param-matched, alpha=0.1) — Config A (mean+LSE τ=0.5) — seed=7 | Noema I | 281 | running |  |  |  |  |  |  |  |\n| 413 | 1 | PrePool Res-ChannelMixer (param-matched, alpha=0.1) — Config A (mean+LSE τ=0.5) — seed=42 | Noema I | 281 | running |  |  |  |  |  |  |  |\n| 412 | 1 | E10: Ablation Study - 8 Attention Heads in Pooling Fusion | Logos II | 279 | 0.6774 | 0.8565 | 0.0615 | 0.4745 | 0.8909 | 0.9502 | 0.5607 | 0.9477 |\n| 411 | 1 | Manual Sweep on RNN-Only v2: gru_hidden_dim=384 | Axiom III | 279 | 0.6734 | 0.8536 | 0.0788 | 0.4850 | 0.8910 | 0.9480 | 0.5681 | 0.8892 |\n| 410 | 1 | Manual Sweep on RNN-Only v2: gru_hidden_dim=128 | Axiom\
    \ III | 279 | 0.6626 | 0.8487 | 0.0727 | 0.4249 | 0.8871 | 0.9487 | 0.5592 | 0.8969 |\n| 409 | 1 | PrePool Hadamard Gate (param-matched, alpha=0.25) — Config A (mean+LSE τ=0.5) — seed=123 | Noema I | 279 | 0.6727 | 0.8603 | 0.0637 | 0.4450 | 0.8777 | 0.9511 | 0.5557 | 0.9554 |\n| 408 | 1 | PrePool Res-ChannelMixer (param-matched, alpha=0.1) — Config A (mean+LSE τ=0.5) — seed=123 | Noema I | 279 | 0.6811 | 0.8571 | 0.0735 | 0.4953 | 0.8835 | 0.9515 | 0.5562 | 0.9508 |\n| 407 | 1 | E9: Computationally-Balanced Hybrid (4 DSConv + 1 Transformer) | Logos II | 277 | 0.6587 | 0.8501 | 0.0369 | 0.5330 | 0.8073 | 0.9439 | 0.5488 | 0.8908 |\n| 406 | 1 | FIX: Hyperparameter Sweep on RNN-Only v2: gru_hidden_dim | Axiom III | 277 | 0.6675 | 0.8507 | 0.0761 | 0.4609 | 0.8851 | 0.9483 | 0.5655 | 0.8862 |\n\nPage 1 of 42 (sorted by: id)\n\n(Use `/execute_action{page N}` to navigate pages 1-42, `/execute_action{rank mode}` to change sort order, `/execute_action{page_size N}` to set page size, `/execute_action{filter\
    \ tag}` to filter by tag.)\n\n**Read Contents:**\n\n**storage/noema/submissions/dsconv_mean_max.py:**\n```\nimport jax\nimport jax.numpy as jnp\nfrom jax import random\nimport flax.linen as nn\nimport optax\nfrom typing import Sequence\n\nclass DSConvDilatedBlock(nn.Module):\n    d_model: int\n    kernel_size: int = 7\n    dilation: int = 1\n    dropout_rate: float = 0.1\n    @nn.compact\n    def __call__(self, x, deterministic=True):\n        h = nn.LayerNorm()(x)\n        h = nn.Conv(features=self.d_model,\n                    kernel_size=(self.kernel_size,),\n                    feature_group_count=self.d_model,\n                    padding='SAME',\n                    kernel_dilation=(self.dilation,),\n                    name='dw_conv')(h)\n        h = nn.gelu(h)\n        h = nn.Conv(features=self.d_model, kernel_size=(1,), name='pw_conv')(h)\n        h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n        return x + h\n\nclass RNANetMeanMax(nn.Module):\n\
    \    d_input: int = 4\n    d_output: int = 1\n    task_type: str = 'regression'\n    d_model: int = 256\n    num_blocks: int = 5\n    dilations: Sequence[int] = (1, 2, 4, 8, 16)\n    kernel_size: int = 7\n    dropout_rate: float = 0.1\n    positional_encoding: bool = False\n\n    @nn.compact\n    def __call__(self, x, deterministic=True):\n        h = nn.Dense(self.d_model, name='in_proj')(x)\n        h = nn.gelu(h)\n        h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n        for i in range(self.num_blocks):\n            d = self.dilations[i] if i < len(self.dilations) else self.dilations[-1]\n            h = DSConvDilatedBlock(self.d_model, self.kernel_size, d, self.dropout_rate)(h, deterministic=deterministic)\n\n        mean_vec = jnp.mean(h, axis=1)   # (B,C)\n        max_vec  = jnp.max(h, axis=1)    # (B,C)\n        fused = jnp.concatenate([mean_vec, max_vec], axis=-1)  # (B,2C)\n\n        z = nn.LayerNorm()(fused)\n        z = nn.Dense(self.d_model)(z)\n\
    \        z = nn.gelu(z)\n        z = nn.Dropout(rate=self.dropout_rate)(z, deterministic=deterministic)\n        logits = nn.Dense(self.d_output, name='out')(z)\n\n        if self.task_type == 'regression' and self.d_output == 1:\n            return logits.squeeze(-1)\n        return logits\n\nclass MeanMaxNetwork:\n    def __init__(self, d_input, d_output, task_type, **kwargs):\n        self.network = RNANetMeanMax(d_input=d_input, d_output=d_output, task_type=task_type, **kwargs)\n    def init(self, rng_key, dummy_input):\n        params_key, dropout_key = random.split(rng_key)\n        variables = self.network.init({'params': params_key, 'dropout': dropout_key}, dummy_input, deterministic=True)\n        return variables['params']\n    def apply(self, params, x, deterministic=True, rng_key=None):\n        if deterministic:\n            return self.network.apply({'params': params}, x, deterministic=True)\n        else:\n            if rng_key is None:\n                rng_key = random.PRNGKey(0)\n\
    \            return self.network.apply({'params': params}, x, deterministic=False, rngs={'dropout': rng_key})\n\ndef _define_hyperparameters():\n    return {\n        'learning_rate': 0.001,\n        'd_model': 256,\n        'num_blocks': 5,\n        'dilations': [1, 2, 4, 8, 16],\n        'kernel_size': 7,\n        'dropout_rate': 0.1,\n        'positional_encoding': False\n    }\n\ndef create_network(hparams):\n    return MeanMaxNetwork(\n        d_input=4,\n        d_output=hparams.get('d_output', 1),\n        task_type=hparams.get('task_type', 'regression'),\n        d_model=hparams.get('d_model', 256),\n        num_blocks=hparams.get('num_blocks', 5),\n        dilations=tuple(hparams.get('dilations', [1,2,4,8,16])),\n        kernel_size=hparams.get('kernel_size', 7),\n        dropout_rate=hparams.get('dropout_rate', 0.1),\n        positional_encoding=hparams.get('positional_encoding', False),\n    )\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n\
    \        optax.clip_by_global_norm(1.0),\n        optax.adamw(learning_rate=learning_rate, weight_decay=0.01),\n    )\n\nBASE_SEED = 42\nBATCH_SIZE = 64\n\ndef complete(params, opt_state, trial_data):\n    ds = trial_data.get('dataset')\n    vm = trial_data.get('val_metric')\n    print(f\"[Complete] {ds} val_metric={vm}\")\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
