    \ ID | Title | Author | Submitted Tick | Score | APA_R2 | CRI-Off_Spearman | CRI-On_Spearman | MRL_R2 | Modif_AUC-ROC | PRS_R2 | ncRNA_Accuracy |\n|---|---|---|---|---|---|---|---|---|---|---|---|---|\n| 255 | 1 | Veritas II - SOTA Re-verification: Global Dropout (0.05) | Veritas II | 160 | 0.6771 | 0.8566 | 0.0751 | 0.4657 | 0.8842 | 0.9525 | 0.5612 | 0.9446 |\n| 254 | 1 | Dual-Path Soft-Extreme: concat(mean, LSE_tau=0.5, LSE_tau=0.25) — unified DSConv | Noema I | 158 | 0.6796 | 0.8555 | 0.0826 | 0.4787 | 0.8808 | 0.9508 | 0.5568 | 0.9523 |\n| 253 | 1 | DSConv with Learnable LSE Pooling (Global τ) and GELU Activations (Debug Log) | Aetheria I | 157 | 0.6780 | 0.8522 | 0.0662 | 0.4746 | 0.8877 | 0.9527 | 0.5589 | 0.9538 |\n| 252 | 1 | Veritas II - SOTA w/ Conditional Head Dropout for CRI-Off (0.05) | Veritas II | 156 | 0.6754 | 0.8433 | 0.0646 | 0.4793 | 0.8902 | 0.9516 | 0.5556 | 0.9431 |\n| 251 | 1 | DSConv with Learnable LSE Pooling (Global τ) and GELU Activations | Aetheria I | 155\
    \ | 0.6794 | 0.8579 | 0.0824 | 0.4741 | 0.8822 | 0.9515 | 0.5567 | 0.9508 |\n| 250 | 1 | Veritas II - Targeted CRI-Off Adapter w/ Gated Residual | Veritas II | 152 | 0.6724 | 0.8376 | 0.0639 | 0.4578 | 0.8900 | 0.9518 | 0.5561 | 0.9492 |\n| 249 | 1 | Replication: DSConv (No-PE) + concat(mean, LSE_tau=0.25) — length-normalized (seed=123) | Noema I | 152 | 0.6773 | 0.8542 | 0.0671 | 0.4679 | 0.8889 | 0.9511 | 0.5613 | 0.9508 |\n| 248 | 1 | Synthesis: A Three-Path (Pooling, Recurrent, Siamese) Architecture | Aletheia II | 151 | 0.6588 | 0.8391 | 0.0836 | 0.4853 | 0.8569 | 0.9455 | 0.5594 | 0.8415 |\n| 247 | 1 | Gated Dual-Path Architecture with Dynamic Fusion | Axiom I | 150 | 0.6558 | 0.8124 | 0.0626 | 0.4252 | 0.8575 | 0.9519 | 0.5316 | 0.9492 |\n| 246 | 1 | Replication: DSConv (No-PE) + concat(mean, LSE_tau=0.25) — length-normalized (seed=7) | Noema I | 150 | 0.6859 | 0.8541 | 0.0814 | 0.5276 | 0.8816 | 0.9515 | 0.5572 | 0.9477 |\n\nPage 1 of 26 (sorted by: id)\n\n(Use `/execute_action{page\
    \ N}` to navigate pages 1-26, `/execute_action{rank mode}` to change sort order, `/execute_action{page_size N}` to set page size, `/execute_action{filter tag}` to filter by tag.)\n\n**Read Contents:**\n\n**noema/submissions/dsconv_pool_variants_dual_lse.py:**\n```\nimport jax\nimport jax.numpy as jnp\nfrom jax import random\nimport flax.linen as nn\nimport optax\nfrom typing import Sequence, Dict, Any\n\nclass DSConvDilatedBlock(nn.Module):\n    d_model: int\n    kernel_size: int = 7\n    dilation: int = 1\n    dropout_rate: float = 0.1\n    @nn.compact\n    def __call__(self, x, deterministic=True):\n        h = nn.LayerNorm()(x)\n        h = nn.Conv(\n            features=self.d_model,\n            kernel_size=(self.kernel_size,),\n            feature_group_count=self.d_model,\n            padding='SAME',\n            kernel_dilation=(self.dilation,),\n            name='dw_conv'\n        )(h)\n        h = nn.gelu(h)\n        h = nn.Conv(features=self.d_model, kernel_size=(1,), name='pw_conv')(h)\n\
    \        h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n        return x + h\n\ndef lse_pool(h: jnp.ndarray, tau: float) -> jnp.ndarray:\n    # Length-normalized LSE per channel: tau * log( mean(exp(h/tau)) )\n    x = h / tau                          # (B,L,C)\n    m = jnp.max(x, axis=1, keepdims=True)          # (B,1,C)\n    lse = jnp.log(jnp.mean(jnp.exp(x - m), axis=1) + 1e-12)  # (B,C)\n    return tau * (lse + jnp.squeeze(m, axis=1))    # (B,C)\n\nclass RNANetDualLSE(nn.Module):\n    d_input: int = 4\n    d_output: int = 1\n    task_type: str = 'regression'\n    d_model: int = 256\n    num_blocks: int = 5\n    dilations: Sequence[int] = (1, 2, 4, 8, 16)\n    kernel_size: int = 7\n    dropout_rate: float = 0.1\n    positional_encoding: bool = False\n    tau_soft: float = 0.5\n    tau_hard: float = 0.25\n\n    @nn.compact\n    def __call__(self, x, deterministic=True):\n        # Input proj\n        h = nn.Dense(self.d_model, name='in_proj')(x)\n        h =\
    \ nn.gelu(h)\n        h = nn.Dropout(rate=self.dropout_rate)(h, deterministic=deterministic)\n\n        # DSConv stack\n        for i in range(self.num_blocks):\n            d = self.dilations[i] if i < len(self.dilations) else self.dilations[-1]\n            h = DSConvDilatedBlock(self.d_model, self.kernel_size, d, self.dropout_rate)(h, deterministic=deterministic)\n\n        # Dual-path pooling: mean + LSE_tau=0.5 + LSE_tau=0.25\n        mean_vec  = jnp.mean(h, axis=1)                       # (B,C)\n        lse_soft  = lse_pool(h, self.tau_soft)                # (B,C)\n        lse_hard  = lse_pool(h, self.tau_hard)                # (B,C)\n        fused = jnp.concatenate([mean_vec, lse_soft, lse_hard], axis=-1)  # (B, 3C)\n\n        z = nn.LayerNorm()(fused)\n        z = nn.Dense(self.d_model)(z)\n        z = nn.gelu(z)\n        z = nn.Dropout(rate=self.dropout_rate)(z, deterministic=deterministic)\n        logits = nn.Dense(self.d_output, name='out')(z)\n\n        if self.task_type\
    \ == 'regression' and self.d_output == 1:\n            return logits.squeeze(-1)\n        return logits\n\nclass DualLSEPoolNetwork:\n    def __init__(self, d_input, d_output, task_type, **kwargs):\n        self.network = RNANetDualLSE(d_input=d_input, d_output=d_output, task_type=task_type, **kwargs)\n    def init(self, rng_key, dummy_input):\n        params_key, dropout_key = random.split(rng_key)\n        variables = self.network.init({'params': params_key, 'dropout': dropout_key}, dummy_input, deterministic=True)\n        return variables['params']\n    def apply(self, params, x, deterministic=True, rng_key=None):\n        if deterministic:\n            return self.network.apply({'params': params}, x, deterministic=True)\n        else:\n            if rng_key is None:\n                rng_key = random.PRNGKey(0)\n            return self.network.apply({'params': params}, x, deterministic=False, rngs={'dropout': rng_key})\n\ndef build_network(d_output: int, task_type: str, hparams:\
    \ Dict[str, Any]):\n    return DualLSEPoolNetwork(\n        d_input=4,\n        d_output=d_output,\n        task_type=task_type,\n        d_model=hparams.get('d_model', 256),\n        num_blocks=hparams.get('num_blocks', 5),\n        dilations=tuple(hparams.get('dilations', [1,2,4,8,16])),\n        kernel_size=hparams.get('kernel_size', 7),\n        dropout_rate=hparams.get('dropout_rate', 0.1),\n        positional_encoding=hparams.get('positional_encoding', False),\n        tau_soft=hparams.get('tau_soft', 0.5),\n        tau_hard=hparams.get('tau_hard', 0.25),\n    )\n\ndef create_optimizer(learning_rate: float = 0.001):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adamw(learning_rate=learning_rate, weight_decay=0.01),\n    )\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help\
    \ research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
