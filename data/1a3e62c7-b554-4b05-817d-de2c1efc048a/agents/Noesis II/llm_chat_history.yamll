tick: 334
role: model
parts:
- text: "Reading diagnostics from the first tangent-step attempt, then running a single final variant with support-weighted hinges.\n\n`/execute_action{storage read noesis/exports/tangent_step_attempt_v1.json}`\n\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"Boundary-Preserving Tangent Micro-Step v2 (support-weighted hinges) + Equality-SLSQP\"\ntags: \"optimization, tangent-space, equality-constraints, slsqp, principled-seed, support-weighted\"\nabstract: \"Final auditable micro-step variant: compute boundary-equality tangent basis at SOTA_243, prioritize hinge pairs by cross-lineage support (then composite score), take a tiny nullspace step to reduce their gaps, and polish with equality-SLSQP. Logs predicted vs realized gap changes and ΔΣr; returns the better of baseline vs candidate.\"\ncontent: |\n  import os, json, time, math\n  import numpy as np\n  try:\n      from scipy.optimize import minimize, nnls\n  except Exception:\n      minimize = None; nnls = None\n\n  import sys\n  sys.path.append('storage/noesis')\n\
    \  try:\n      from analyze_contacts import active_sets as ac_active_sets\n  except Exception:\n      ac_active_sets = None\n  try:\n      from operators_integration import polish_preserving_boundary\n  except Exception:\n      polish_preserving_boundary = None\n\n  N = 26\n  R_MIN = 1e-6\n  SAFETY = 1e-9\n  TOL_EQ = 1e-8\n\n  P_C = 'storage/noesis/latest_centers.txt'\n  P_R = 'storage/noesis/latest_radii.txt'\n  P_CONS = 'storage/noesis/nmap/consensus_n26_tol1e8.json'\n  LOG_PATH = 'storage/noesis/exports/tangent_step_attempt_v2.json'\n\n  WEIGHT_INVSLACK = 0.5\n  WEIGHT_LAMBDA   = 0.4\n  WEIGHT_SUPPORT  = 1.0   # prioritize recurrent, cross-lineage interior hinges\n\n  def load_snapshot():\n      c = np.loadtxt(P_C, dtype=float).reshape(N, 2)\n      r = np.loadtxt(P_R, dtype=float).reshape(N,)\n      assert c.shape == (N,2) and r.shape == (N,) and np.all(r > 0)\n      return c, r\n\n  def pack_to_z(c, r):\n      Z = np.zeros((N,3), dtype=float)\n      Z[:, :2] = c; Z[:, 2] = r\n  \
    \    return Z.ravel()\n\n  def z_to_pack(z):\n      Z = np.asarray(z, float).reshape(N,3)\n      return Z[:, :2], Z[:, 2]\n\n  def slacks(c, r):\n      x = c[:,0]; y = c[:,1]\n      s_xL = x - r\n      s_xR = 1.0 - x - r\n      s_yB = y - r\n      s_yT = 1.0 - y - r\n      diff = c[:,None,:] - c[None,:,:]\n      dist = np.sqrt(np.sum(diff**2, axis=2))\n      s_pairs = dist - (r[:,None] + r[None,:])\n      return (s_xL, s_xR, s_yB, s_yT), s_pairs\n\n  def boundary_mask(c, r, tol):\n      (s_xL, s_xR, s_yB, s_yT), _ = slacks(c, r)\n      return (s_xL <= tol) | (s_xR <= tol) | (s_yB <= tol) | (s_yT <= tol)\n\n  def grad_row_boundary(i, kind, n=N):\n      row = np.zeros(3*n, dtype=float)\n      xi = 3*i; yi = xi + 1; ri = xi + 2\n      if kind in ('xL','x_min'):\n          row[xi] = 1.0;  row[ri] = -1.0\n      elif kind in ('xR','x_max'):\n          row[xi] = -1.0; row[ri] = -1.0\n      elif kind in ('yB','y_min'):\n          row[yi] = 1.0;  row[ri] = -1.0\n      elif kind in ('yT','y_max'):\n\
    \          row[yi] = -1.0; row[ri] = -1.0\n      return row\n\n  def grad_row_pair(c, i, j, n=N):\n      row = np.zeros(3*n, dtype=float)\n      xi = 3*i; yi = xi + 1; ri = xi + 2\n      xj = 3*j; yj = xj + 1; rj = xj + 2\n      dx = c[i,0] - c[j,0]; dy = c[i,1] - c[j,1]\n      d = float(np.hypot(dx, dy))\n      if d > 1e-15:\n          invd = 1.0/d\n          row[xi] = dx*invd; row[yi] = dy*invd\n          row[xj] = -dx*invd; row[yj] = -dy*invd\n      row[ri] = -1.0; row[rj] = -1.0\n      return row\n\n  def build_Aeq_boundary(c, r, tol=TOL_EQ):\n      if ac_active_sets is not None:\n          b_act, _ = ac_active_sets(c, r, tol=tol)\n      else:\n          (s_xL, s_xR, s_yB, s_yT), _ = slacks(c, r)\n          b_act = []\n          for i in range(N):\n              if s_xL[i] <= tol: b_act.append((i,'xL', float(s_xL[i])))\n              if s_xR[i] <= tol: b_act.append((i,'xR', float(s_xR[i])))\n              if s_yB[i] <= tol: b_act.append((i,'yB', float(s_yB[i])))\n              if\
    \ s_yT[i] <= tol: b_act.append((i,'yT', float(s_yT[i])))\n      rows = [grad_row_boundary(int(i), str(kind)) for (i,kind,*_) in b_act]\n      if not rows:\n          return np.zeros((0, 3*N), dtype=float)\n      A = np.vstack(rows)\n      return A\n\n  def nullspace(A, rtol=1e-10):\n      if A.size == 0:\n          return np.eye(3*N)\n      U, S, Vh = np.linalg.svd(A, full_matrices=True)\n      rank = int(np.sum(S > (rtol * S.max() if S.size else 0.0)))\n      return Vh.T[:, rank:]\n\n  def kkt_nnls_pairs(c, r, tol=TOL_EQ):\n      if ac_active_sets is not None:\n          b_act, p_act = ac_active_sets(c, r, tol=tol)\n          b_rows = [(int(i), str(kind)) for (i, kind, *_ ) in b_act]\n          p_rows = [(int(i), int(j)) for (i, j, *_ ) in p_act]\n      else:\n          (s_xL, s_xR, s_yB, s_yT), sp = slacks(c, r)\n          b_rows = []\n          for i in range(N):\n              if s_xL[i] <= tol: b_rows.append((i,'xL'))\n              if s_xR[i] <= tol: b_rows.append((i,'xR'))\n \
    \             if s_yB[i] <= tol: b_rows.append((i,'yB'))\n              if s_yT[i] <= tol: b_rows.append((i,'yT'))\n          p_rows = []\n          for i in range(N):\n              for j in range(i+1, N):\n                  if sp[i,j] <= tol:\n                      p_rows.append((i,j))\n      rows = []; ids = []\n      for (i, kind) in b_rows:\n          rows.append(grad_row_boundary(i, kind)); ids.append(('b', i, kind))\n      for (i, j) in p_rows:\n          rows.append(grad_row_pair(c, i, j));    ids.append(('p', i, j))\n      if not rows:\n          return {}, []\n      J = np.vstack(rows); A = J.T\n      b = np.zeros(3*N, dtype=float); b[2::3] = 1.0\n      if nnls is not None:\n          lam, _ = nnls(A, b)\n      else:\n          lam = np.linalg.lstsq(A, b, rcond=None)[0]\n          lam = np.maximum(lam, 0.0)\n      lam_pairs = {}\n      for idx, tag in enumerate(ids):\n          if tag[0] == 'p':\n              lam_pairs[(tag[1], tag[2])] = float(lam[idx])\n      return lam_pairs,\
    \ p_rows\n\n  def load_consensus_support():\n      if not os.path.exists(P_CONS):\n          return {}\n      try:\n          data = json.load(open(P_CONS, 'r'))\n      except Exception:\n          return {}\n      supp = {}\n      try:\n          variants = data.get('variants', {})\n          top_by_support = variants.get('pairs_top_by_support', []) or []\n          for entry in top_by_support:\n              pair, count = entry\n              i, j = int(pair[0]), int(pair[1])\n              supp[(min(i,j), max(i,j))] = int(count)\n      except Exception:\n          pass\n      return supp\n\n  def select_hinges(c, r, k=5):\n      (_, _ , _, _), sp = slacks(c, r)\n      iu = np.triu_indices(N, 1)\n      pairs_all = [(int(iu[0][idx]), int(iu[1][idx]), float(sp[iu][idx])) for idx in range(len(iu[0]))]\n      pairs_all.sort(key=lambda t: t[2])\n\n      lam_pairs, _ = kkt_nnls_pairs(c, r, tol=TOL_EQ)\n      support = load_consensus_support()\n      # Start from high-support pairs (count\
    \ ≥ 3), then fill by composite score\n      support_prior = [((i,j), cnt) for ((i,j), cnt) in support.items() if cnt >= 3]\n      support_prior.sort(key=lambda x: x[1], reverse=True)\n\n      bmask_1e9 = boundary_mask(c, r, tol=1e-9)\n      bmask_1e8 = boundary_mask(c, r, tol=1e-8)\n\n      # Build scoring table for top-200 near-active region\n      scored = {}\n      for (i, j, s) in pairs_all[:200]:\n          lam = lam_pairs.get((i,j), lam_pairs.get((j,i), 0.0))\n          supp = float(support.get((min(i,j), max(i,j)), 0))\n          pen = 0.5 if (bmask_1e9[i] or bmask_1e9[j]) else 0.0\n          if bmask_1e8[i] or bmask_1e8[j]:\n              continue\n          score = WEIGHT_INVSLACK*(1.0/(1e-12 + s)) + WEIGHT_LAMBDA*lam + WEIGHT_SUPPORT*supp - pen\n          scored[(i,j)] = (score, s, lam, supp)\n\n      chosen = []\n      used = set()\n\n      # 1) Greedy pick from high-support list with diversity\n      for (pair, cnt) in support_prior:\n          i, j = pair\n          if (i\
    \ in used) or (j in used): continue\n          if (i,j) not in scored and (j,i) not in scored: continue\n          rec = scored.get((i,j), scored.get((j,i)))\n          chosen.append({'i': i, 'j': j, 'slack': rec[1], 'lambda': rec[2], 'support': cnt, 'score': float(rec[0])})\n          used.add(i); used.add(j)\n          if len(chosen) >= k:\n              break\n\n      # 2) Fill remaining by composite score with diversity\n      for (pair, rec) in sorted(scored.items(), key=lambda kv: kv[1][0], reverse=True):\n          i, j = pair\n          if len(chosen) >= k: break\n          if i in used or j in used: continue\n          chosen.append({'i': i, 'j': j, 'slack': rec[1], 'lambda': rec[2], 'support': rec[3], 'score': float(rec[0])})\n          used.add(i); used.add(j)\n\n      return chosen\n\n  def write_log(obj):\n      os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)\n      with open(LOG_PATH, 'w') as f:\n          json.dump(obj, f, indent=2)\n\n  def construct_packing():\n\
    \      c0, r0 = load_snapshot()\n      base_sum = float(np.sum(r0))\n      if polish_preserving_boundary is None:\n          write_log({'error': 'missing_polisher', 'baseline_sum': base_sum})\n          return c0.astype(float), np.maximum(r0 - SAFETY, R_MIN).astype(float)\n\n      # Aeq and tangent basis\n      Aeq = build_Aeq_boundary(c0, r0, tol=TOL_EQ)\n      Q = nullspace(Aeq, rtol=1e-10)\n      if Q.shape[1] == 0:\n          write_log({'error': 'zero_nullspace', 'Aeq_shape': list(Aeq.shape), 'baseline_sum': base_sum})\n          return c0.astype(float), np.maximum(r0 - SAFETY, R_MIN).astype(float)\n\n      hinges = select_hinges(c0, r0, k=5)\n      # Build summed gap gradient in Q-space\n      GQ_rows = []\n      for h in hinges:\n          g = grad_row_pair(c0, h['i'], h['j'])\n          GQ_rows.append(g @ Q)\n      if not GQ_rows:\n          write_log({'error': 'no_hinges', 'baseline_sum': base_sum})\n          return c0.astype(float), np.maximum(r0 - SAFETY, R_MIN).astype(float)\n\
    \      GQ = np.vstack(GQ_rows)\n      w = np.ones((GQ.shape[0],), dtype=float)\n      v = (GQ.T @ w)\n      norm_v = float(np.linalg.norm(v))\n      if norm_v < 1e-18:\n          write_log({'error': 'flat_direction', 'baseline_sum': base_sum, 'hinges': hinges})\n          return c0.astype(float), np.maximum(r0 - SAFETY, R_MIN).astype(float)\n      u_dir = -v / norm_v\n\n      # Safety sieve on tight pairs with conservative trust radius\n      (_, _ , _, _), sp = slacks(c0, r0)\n      iu = np.triu_indices(N, 1)\n      pairs_all = [(int(iu[0][k]), int(iu[1][k]), float(sp[iu][k])) for k in range(len(iu[0]))]\n      pairs_all.sort(key=lambda t: t[2])\n      tight_pairs = pairs_all[:40]\n\n      def predict_delta(u_scale):\n          deltas = []\n          for (i, j, s) in tight_pairs:\n              g = grad_row_pair(c0, i, j)\n              d = float((g @ Q) @ (u_scale * u_dir))\n              deltas.append((i, j, s, d))\n          return deltas\n\n      tau = 1.0e-3\n      beta = 0.3\n\
    \      ok = False; u_use = None\n      for _ in range(10):\n          deltas = predict_delta(tau)\n          viol = any(d < -beta*s for (_,_,s,d) in deltas)\n          if not viol:\n              ok = True; u_use = tau * u_dir; break\n          tau *= 0.5\n      if not ok:\n          write_log({'error': 'trust_region_failed', 'baseline_sum': base_sum, 'last_tau': tau, 'hinges': hinges})\n          return c0.astype(float), np.maximum(r0 - SAFETY, R_MIN).astype(float)\n\n      # Apply tangent step and polish with equality constraints\n      z0 = pack_to_z(c0, r0)\n      dz = Q @ u_use\n      c_seed, r_seed = z_to_pack(z0 + dz)\n      c_seed = np.clip(c_seed, 0.0, 1.0)\n\n      c_opt, r_opt = polish_preserving_boundary(c_seed, r_seed, tol_eq=TOL_EQ, step_c=8e-4, step_r=8e-4, maxiter=700)\n      r_opt = np.maximum(r_opt - SAFETY, R_MIN)\n\n      sum_opt = float(np.sum(r_opt))\n      delta_sum = sum_opt - base_sum\n\n      def pair_set(c, r, tol=TOL_EQ):\n          if ac_active_sets is not\
    \ None:\n              _, p_act = ac_active_sets(c, r, tol=tol)\n              return set((min(int(i), int(j)), max(int(i), int(j))) for (i, j, *_ ) in p_act)\n          else:\n              (_, _ , _, _), sp2 = slacks(c, r)\n              ps = set()\n              for i in range(N):\n                  for j in range(i+1, N):\n                      if sp2[i,j] <= tol:\n                          ps.add((i,j))\n              return ps\n\n      pairs_base = pair_set(c0, r0, tol=TOL_EQ)\n      pairs_cand = pair_set(c_opt, r_opt, tol=TOL_EQ)\n      inter = len(pairs_base & pairs_cand); uni = len(pairs_base | pairs_cand)\n      j_pairs = (inter / uni) if uni > 0 else 1.0\n\n      post_slacks = {}\n      (_, _ , _, _), sp_after = slacks(c_opt, r_opt)\n      for h in hinges:\n          i, j = h['i'], h['j']\n          i0, j0 = (i,j) if i<j else (j,i)\n          s0 = float(sp[i0, j0]); s1 = float(sp_after[i0, j0])\n          h['slack_before'] = s0; h['slack_after'] = s1; h['delta_slack'] = s1\
    \ - s0\n\n      log = {\n          'generated_at': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),\n          'Aeq_shape': list(Aeq.shape),\n          'nullspace_dim': int(Q.shape[1]),\n          'tau_used': float(np.linalg.norm(u_use)),\n          'baseline_sum': base_sum,\n          'candidate_sum': sum_opt,\n          'delta_sum': delta_sum,\n          'pair_jaccard_vs_baseline': j_pairs,\n          'hinges': hinges\n      }\n      try:\n          write_log(log)\n      except Exception:\n          pass\n\n      if delta_sum >= 1e-12:\n          return c_opt.astype(float), r_opt.astype(float)\n      else:\n          return c0.astype(float), np.maximum(r0 - SAFETY, R_MIN).astype(float)\n```"
