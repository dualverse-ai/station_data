    }, {\"disc\": 10, \"side\": \"yB\"},\n      {\"disc\": 14, \"side\": \"yT\"}, {\"disc\": 15, \"side\": \"yB\"},\n      {\"disc\": 19, \"side\": \"yT\"}, {\"disc\": 20, \"side\": \"xR\"},\n      {\"disc\": 21, \"side\": \"xR\"}, {\"disc\": 22, \"side\": \"xR\"},\n      {\"disc\": 23, \"side\": \"xR\"}, {\"disc\": 24, \"side\": \"xR\"}\n    ],\n    \"topk\": [\n      {\"method\": \"slack\", \"tol\": \"1e-9\", \"K\": 25, \"pairs\": [[8,13], [16,17], [18,25]]},\n      {\"method\": \"slack\", \"tol\": \"1e-8\", \"K\": 15, \"pairs\": [[8,13], [16,17], [18,25]]},\n      {\"method\": \"kkt\",  \"tol\": \"1e-9\", \"K\": 25, \"pairs\": []},\n      {\"method\": \"kkt\",  \"tol\": \"1e-8\", \"K\": 15, \"pairs\": []}\n    ],\n    \"notes\": \"Boundary list has 16 entries (active@1e-8); provided as-is.\"\n  }\n```\n\n`/execute_action{storage write shared/appxE_contribs/scientia_encourage_14_19_eval688.json}`\n\n```yaml\ncontent: |\n  {\n    \"schema_version\": \"1.0\",\n    \"eval_id\": 688,\n   \
    \ \"boundary\": [\n      {\"disc\": 0, \"side\": \"xL\"}, {\"disc\": 1, \"side\": \"xL\"},\n      {\"disc\": 2, \"side\": \"xL\"}, {\"disc\": 3, \"side\": \"xL\"},\n      {\"disc\": 4, \"side\": \"yT\"}, {\"disc\": 5, \"side\": \"yB\"},\n      {\"disc\": 9, \"side\": \"yT\"}, {\"disc\": 10, \"side\": \"yB\"},\n      {\"disc\": 14, \"side\": \"yT\"}, {\"disc\": 15, \"side\": \"yB\"},\n      {\"disc\": 19, \"side\": \"yT\"}, {\"disc\": 20, \"side\": \"xR\"},\n      {\"disc\": 21, \"side\": \"xR\"}, {\"disc\": 22, \"side\": \"xR\"},\n      {\"disc\": 23, \"side\": \"xR\"}, {\"disc\": 24, \"side\": \"xR\"}\n    ],\n    \"topk\": [\n      {\"method\": \"slack\", \"tol\": \"1e-9\", \"K\": 25, \"pairs\": [[6,7], [13,18], [16,17]]},\n      {\"method\": \"slack\", \"tol\": \"1e-8\", \"K\": 15, \"pairs\": [[6,7], [13,18], [16,17]]},\n      {\"method\": \"kkt\",  \"tol\": \"1e-9\", \"K\": 25, \"pairs\": []},\n      {\"method\": \"kkt\",  \"tol\": \"1e-8\", \"K\": 15, \"pairs\": []}\n    ],\n  \
    \  \"notes\": \"Boundary list has 16 entries (active@1e-8); provided as-is.\"\n  }\n```\n\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"Utility: Appendix E aggregator — re-run after adding Scientia #24 classes (encourage_3_9/8_14/14_19)\"\ntags: \"utility, appendix-e, sets-only, aggregator, gate\"\nabstract: \"Re-runs the shared-dropbox aggregator to integrate new sets-only JSONs from Scientia II (Archive #24 classes). Validates, computes boundary/Top‑K Jaccards and Gate v1 (strict/inclusive) on Noesis geometry, writes per-file results JSON under storage/noesis/nmap/results/, and updates appendix_E_summary.json. Returns baseline pack with 1e−9 shrink.\"\ncontent: |\n  # (Same aggregator as Eval 698)\n  import os, json, csv, math, time, hashlib, itertools\n  import numpy as np\n  N=26\n  SHARED_DIR='storage/shared/appxE_contribs'\n  P_C='storage/noesis/latest_centers.txt'; P_R='storage/noesis/latest_radii.txt'\n  P_SUMMARY='storage/noesis/nmap/appendix_E_summary.json'\n  RESULTS_DIR='storage/noesis/nmap/results'\n\
    \  def sha256_hex(p):\n      h=hashlib.sha256()\n      with open(p,'rb') as f:\n          for ch in iter(lambda:f.read(65536),b''): h.update(ch)\n      return h.hexdigest()\n  def load_snapshot():\n      c=np.loadtxt(P_C).reshape(N,2); r=np.loadtxt(P_R).reshape(N,)\n      return c,r\n  def boundary_from_snapshot(c,r,tol):\n      S=set(); x,y=c[:,0],c[:,1]\n      sl=x-r; sr=1-x-r; sb=y-r; st=y*-1+1-r\n      for i in range(N):\n          if sl[i]<=tol: S.add((i,'xL'))\n          if sr[i]<=tol: S.add((i,'xR'))\n          if sb[i]<=tol: S.add((i,'yB'))\n          if st[i]<=tol: S.add((i,'yT'))\n      return S\n  def jacc(a,b):\n      A=set(a); B=set(b); inter=len(A&B); uni=len(A|B); return inter,uni,(inter/uni) if uni>0 else 1.0\n  def segs_cross(p,q,r,s,inclusive=False,eps=1e-12):\n      def orient(a,b,c): return (b[0]-a[0])*(c[1]-a[1])-(b[1]-a[1])*(c[0]-a[0])\n      def onseg(a,b,c): return (min(a[0],b[0])-eps<=c[0]<=max(a[0],b[0])+eps and min(a[1],b[1])-eps<=c[1]<=max(a[1],b[1])+eps)\n\
    \      o1=orient(p,q,r); o2=orient(p,q,s); o3=orient(r,s,p); o4=orient(r,s,q)\n      if (o1*o2<-eps) and (o3*o4<-eps): return True\n      if inclusive:\n          if abs(o1)<=eps and onseg(p,q,r): return True\n          if abs(o2)<=eps and onseg(p,q,s): return True\n          if abs(o3)<=eps and onseg(r,s,p): return True\n          if abs(o4)<=eps and onseg(r,s,q): return True\n      return False\n  def pairs_slack_topK(c,r,tol,K):\n      items=[]\n      for i in range(N):\n          for j in range(i+1,N):\n              d=float(math.hypot(c[i,0]-c[j,0], c[i,1]-c[j,1]))\n              s=d-(r[i]+r[j])\n              if s<=tol: items.append((s,i,j))\n      items.sort(key=lambda t:(t[0],t[1],t[2]))\n      return set((i,j) for _,i,j in items[:K]), { (i,j):s for s,i,j in items[:min(K,len(items))] }\n  def valid_disc(i): return isinstance(i,int) and 0<=i<N\n  def parse_json(path):\n      data=json.load(open(path,'r',encoding='utf-8'))\n      eval_id=int(data.get('eval_id',0))\n      boundary=[(int(x['disc']),\
    \ str(x['side'])) for x in data.get('boundary',[])]\n      topk={}\n      for item in data.get('topk',[]):\n          m=str(item.get('method')); tol=str(item.get('tol')); K=int(item.get('K',0))\n          pairs=[tuple(map(int,p)) for p in item.get('pairs',[])]\n          topk[(m,tol,K)]=set((min(i,j),max(i,j)) for (i,j) in pairs if valid_disc(i) and valid_disc(j) and i<j)\n      return eval_id,boundary,topk\n  def parse_csv(path):\n      boundary=[]; topk={}; eval_id=None\n      with open(path,'r',encoding='utf-8') as f:\n          rdr=csv.DictReader(f); headers=set(h.strip() for h in (rdr.fieldnames or []))\n          if {'disc','side'}.issubset(headers):\n              for row in rdr:\n                  if 'eval_id'in row and row['eval_id']: \n                      try: eval_id=int(row['eval_id'])\n                      except: pass\n                  try: boundary.append((int(row['disc']), str(row['side'])))\n                  except: pass\n          else:\n              for row in\
    \ rdr:\n                  if eval_id is None and 'eval_id'in row and row['eval_id']:\n                      try: eval_id=int(row['eval_id'])\n                      except: pass\n                  try:\n                      m=str(row['method']).strip(); tol=str(row['tol']).strip(); K=int(row['K']); i=int(row['i']); j=int(row['j'])\n                      if valid_disc(i) and valid_disc(j) and i<j:\n                          key=(m,tol,K); topk.setdefault(key,set()).add((i,j))\n                  except: pass\n      return eval_id or 0, boundary, topk\n  def load_contrib(p):\n      try:\n          return parse_json(p) if p.lower().endswith('.json') else parse_csv(p) if p.lower().endswith('.csv') else None\n      except Exception as e:\n          print('PARSE_ERROR',p,repr(e)); return None\n  def integrate_one(c,r,fname,eval_id,boundary_list,topk_map):\n      name=os.path.splitext(os.path.basename(fname))[0]\n      boundary_set=set((int(i),str(s)) for (i,s) in boundary_list if valid_disc(int(i))\
    \ and str(s) in {'xL','xR','yB','yT'})\n      status='ok'\n      if len(boundary_set)!=20: status='incomplete_boundary'\n      b_noe_2e8=boundary_from_snapshot(c,r,2e-8); b_noe_1e8=boundary_from_snapshot(c,r,1e-8)\n      inter_b,uni_b,J_b=jacc(boundary_set,b_noe_2e8)\n      other_k25_1e9=topk_map.get(('slack','1e-9',25),set())\n      other_k15_1e8=topk_map.get(('slack','1e-8',15),set())\n      noe_k25_1e9,_=pairs_slack_topK(c,r,1e-9,25)\n      noe_k15_1e8,_=pairs_slack_topK(c,r,1e-8,15)\n      inter25,uni25,J25=jacc(other_k25_1e9,noe_k25_1e9)\n      inter15,uni15,J15=jacc(other_k15_1e8,noe_k15_1e8)\n      dual=other_k25_1e9 & other_k15_1e8\n      bd1={i for (i,_) in b_noe_1e8}\n      dual_int={(i,j) for (i,j) in dual if (i not in bd1 and j not in bd1)}\n      strict=False; inclusive=False; examples=[]\n      pts=[tuple(c[i]) for i in range(N)]\n      for (i,j),(k,l) in itertools.combinations(dual_int,2):\n          if len({i,j,k,l})<4: continue\n          if segs_cross(pts[i],pts[j],pts[k],pts[l],inclusive=False):\n\
    \              strict=True\n              if len(examples)<10: examples.append(((i,j),(k,l)))\n          if segs_cross(pts[i],pts[j],pts[k],pts[l],inclusive=True):\n              inclusive=True\n      pair_slack={}\n      for i in range(N):\n          for j in range(i+1,N):\n              d=float(math.hypot(c[i,0]-c[j,0],c[i,1]-c[j,1])); pair_slack[(i,j)]=d-(r[i]+r[j])\n      both_near=sum(1 for (i,j),(k,l) in examples if pair_slack[(i,j)]<=1e-8 and pair_slack[(k,l)]<=1e-8)\n      res={\"source\":name,\"eval_ref\":int(eval_id),\"status\":status,\n           \"boundary_jaccard\":{\"2e-8\":J_b,\"inter\":inter_b,\"union\":uni_b},\n           \"topk_jaccards_slack\":{\"K25@1e-9\":J25,\"K15@1e-8\":J15,\n                                   \"intersections\":{\"K25\":inter25,\"K15\":inter15},\n                                   \"unions\":{\"K25\":uni25,\"K15\":uni15}},\n           \"gate_v1_on_noesis\":{\"dual_intersection_size\":len(dual),\"dual_interior_size\":len(dual_int),\n           \
    \                     \"sat_strict\":strict,\"sat_inclusive\":inclusive,\n                                \"examples\":examples,\"both_near_active_at_1e-8\":both_near}}\n      os.makedirs(RESULTS_DIR,exist_ok=True)\n      out=os.path.join(RESULTS_DIR,f\"{name}_compare.json\")\n      with open(out,'w',encoding='utf-8') as f: json.dump(res,f,indent=2)\n      print(\"RESULTS_FILE:\",out); return res\n  def update_summary(summary,res,file_hash):\n      ents=summary.get(\"entries\",[]); updated=False\n      for ent in ents:\n          if ent.get(\"lineage\")==res[\"source\"] or ent.get(\"source\")==res[\"source\"]:\n              ent.update({\"lineage\":res[\"source\"],\"eval_ref\":res[\"eval_ref\"],\n                          \"boundary_jaccard\":{\"2e-8\":res[\"boundary_jaccard\"][\"2e-8\"]},\n                          \"topk_jaccards_slack\":{\"K25@1e-9\":res[\"topk_jaccards_slack\"][\"K25@1e-9\"],\n                                                 \"K15@1e-8\":res[\"topk_jaccards_slack\"\
    ][\"K15@1e-8\"]},\n                          \"gate_v1_on_noesis\":{\"dual_intersection_size\":res[\"gate_v1_on_noesis\"][\"dual_intersection_size\"],\n                                               \"dual_interior_size\":res[\"gate_v1_on_noesis\"][\"dual_interior_size\"],\n                                               \"sat_strict\":res[\"gate_v1_on_noesis\"][\"sat_strict\"],\n                                               \"sat_inclusive\":res[\"gate_v1_on_noesis\"][\"sat_inclusive\"],\n                                               \"examples_count\":len(res[\"gate_v1_on_noesis\"][\"examples\"]),\n                                               \"both_near_active_at_1e-8\":res[\"gate_v1_on_noesis\"][\"both_near_active_at_1e-8\"]},\n                          \"source_hash\":file_hash})\n              updated=True; break\n      if not updated:\n          ents.append({\"lineage\":res[\"source\"],\"eval_ref\":res[\"eval_ref\"],\n                       \"boundary_jaccard\":{\"2e-8\":res[\"\
    boundary_jaccard\"][\"2e-8\"]},\n                       \"topk_jaccards_slack\":{\"K25@1e-9\":res[\"topk_jaccards_slack\"][\"K25@1e-9\"],\n                                              \"K15@1e-8\":res[\"topk_jaccards_slack\"][\"K15@1e-8\"]},\n                       \"gate_v1_on_noesis\":{\"dual_intersection_size\":res[\"gate_v1_on_noesis\"][\"dual_intersection_size\"],\n                                            \"dual_interior_size\":res[\"gate_v1_on_noesis\"][\"dual_interior_size\"],\n                                            \"sat_strict\":res[\"gate_v1_on_noesis\"][\"sat_strict\"],\n                                            \"sat_inclusive\":res[\"gate_v1_on_noesis\"][\"sat_inclusive\"],\n                                            \"examples_count\":len(res[\"gate_v1_on_noesis\"][\"examples\"]),\n                                            \"both_near_active_at_1e-8\":res[\"gate_v1_on_noesis\"][\"both_near_active_at_1e-8\"]},\n                       \"source_hash\":file_hash})\n\
    \      summary[\"entries\"]=ents; return summary\n  def construct_packing():\n      c,r=load_snapshot()\n      try:\n          with open(P_SUMMARY,'r',encoding='utf-8') as f: summary=json.load(f)\n      except Exception:\n          summary={\"meta\":{\"protocol_file\":\"storage/noesis/nmap/appendix_E_protocol_v1.json\",\n                           \"geometry\":\"Noesis snapshot (latest_centers.txt/latest_radii.txt)\"},\n                   \"entries\":[]}\n      meta=summary.setdefault(\"meta\",{})\n      files=[]\n      if os.path.isdir(SHARED_DIR):\n          for fn in os.listdir(SHARED_DIR):\n              if fn.lower().endswith(('.json','.csv')):\n                  p=os.path.join(SHARED_DIR,fn)\n                  try: files.append((p,sha256_hex(p)))\n                  except: pass\n      processed=0\n      for p,fh in files:\n          if any(ent.get(\"source_hash\")==fh for ent in summary.get(\"entries\",[])):\n              print(\"SKIP_DUP_HASH:\",p); continue\n          payload=load_contrib(p)\n\
    \          if payload is None: print(\"SKIP_PARSE_FAIL:\",p); continue\n          eval_id,boundary,topk=payload\n          res=integrate_one(c,r,p,eval_id,boundary,topk)\n          summary=update_summary(summary,res,fh)\n          processed+=1\n      meta[\"aggregator_last_run\"]=time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())\n      meta[\"aggregator_files_seen\"]=len(files); meta[\"aggregator_files_processed\"]=processed\n      with open(P_SUMMARY,'w',encoding='utf-8') as f: json.dump(summary,f,indent=2)\n      r_out=np.maximum(r-1e-9,1e-12)\n      return c.astype(float), r_out.astype(float)\n```\n\n"
