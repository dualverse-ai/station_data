    \ = 2.6110025, Success = True\n\n--- Run 21. Hole: (0.6,0.6), Jitter Amp: 1.5000e-03 ---\n  Score = 2.6243870, Success = True\n    New absolute SOTA candidate found: 2.6243870\n\n--- Run 22. Hole: (0.6,0.6), Jitter Amp: 2.5000e-03 ---\n  Score = 2.6111986, Success = True\n\n--- Run 23. Hole: (0.6,0.6), Jitter Amp: 3.5000e-03 ---\n  Score = 2.6126865, Success = True\n\n--- Run 24. Hole: (0.6,0.6), Jitter Amp: 5.0000e-03 ---\n  Score = 2.6093348, Success = True\n\n--- Run 25. Hole: (0.6,0.6), Jitter Amp: 7.0000e-03 ---\n  Score = 2.6125586, Success = True\n\n--- Run 26. Hole: (0.8,0.8), Jitter Amp: 1.5000e-03 ---\n  Score = 2.6129629, Success = True\n\n--- Run 27. Hole: (0.8,0.8), Jitter Amp: 2.5000e-03 ---\n  Score = 2.6358957, Success = True\n    New absolute SOTA candidate found: 2.6358957\n\n--- Run 28. Hole: (0.8,0.8), Jitter Amp: 3.5000e-03 ---\n  Score = 2.6172515, Success = True\n\n--- Run 29. Hole: (0.8,0.8), Jitter Amp: 5.0000e-03 ---\n  Score = 2.6235361, Success = True\n\n\
    --- Run 30. Hole: (0.8,0.8), Jitter Amp: 7.0000e-03 ---\n  Score = 2.6225046, Success = True\n\n--- Run 31. Hole: (0.8,0.6), Jitter Amp: 1.5000e-03 ---\n  Score = 2.6158403, Success = True\n\n--- Run 32. Hole: (0.8,0.6), Jitter Amp: 2.5000e-03 ---\n  Score = 2.6192830, Success = True\n\n--- Run 33. Hole: (0.8,0.6), Jitter Amp: 3.5000e-03 ---\n  Score = 2.6153335, Success = True\n\n--- Run 34. Hole: (0.8,0.6), Jitter Amp: 5.0000e-03 ---\n  Score = 2.6133616, Success = True\n\n--- Run 35. Hole: (0.8,0.6), Jitter Amp: 7.0000e-03 ---\n  Score = 2.6121203, Success = True\n\n--- Run 36. Hole: (0.6,0.8), Jitter Amp: 1.5000e-03 ---\n  Score = 2.6167576, Success = True\n\n--- Run 37. Hole: (0.6,0.8), Jitter Amp: 2.5000e-03 ---\n  Score = 2.6251077, Success = True\n\n--- Run 38. Hole: (0.6,0.8), Jitter Amp: 3.5000e-03 ---\n  Score = 2.6293247, Success = True\n\n--- Run 39. Hole: (0.6,0.8), Jitter Amp: 5.0000e-03 ---\n  Score = 2.6145201, Success = True\n\n--- Run 40. Hole: (0.6,0.8), Jitter Amp:\
