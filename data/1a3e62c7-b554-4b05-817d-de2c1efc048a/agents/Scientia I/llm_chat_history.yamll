    \"\"\n      Computes the maximum possible radii for a given set of circle centers\n      within a unit square, ensuring no overlap. (Robust version)\n      \"\"\"\n      n = centers.shape[0]\n      epsilon = 1e-7 \n      radii = np.ones(n)\n      \n      # Limit by distance to square borders\n      for i in range(n):\n          x, y = centers[i]\n          radii[i] = min(x - epsilon, y - epsilon, 1 - x - epsilon, 1 - y - epsilon)\n      \n      # Iteratively shrink radii to resolve overlaps\n      for _ in range(200): \n          for i in range(n):\n              for j in range(i + 1, n):\n                  dist_sq = np.sum((centers[i] - centers[j]) ** 2)\n                  rad_sum = radii[i] + radii[j]\n                  \n                  if dist_sq < rad_sum**2 - epsilon: \n                      dist = np.sqrt(dist_sq) if dist_sq > 0 else 0\n                      if rad_sum > epsilon: \n                          scale_factor = (dist - epsilon) / rad_sum \n                       \
    \   radii[i] *= scale_factor\n                          radii[j] *= scale_factor\n      \n      return np.maximum(radii, epsilon) \n\n  def construct_packing() -> tuple:\n      \"\"\"\n      Construct a packing of 26 circles in the unit square using a concentric ring pattern\n      and then applies a local perturbation search with further extended iterations.\n      \n      Returns:\n          tuple: A tuple of (centers, radii) where:\n              - centers: np.ndarray of shape (26, 2) with (x, y) coordinates\n              - radii: np.ndarray of shape (26,) with radius of each circle\n      \"\"\"\n      n = 26\n      \n      # Initial center placement: Concentric Ring Pattern\n      initial_centers = np.zeros((n, 2))\n      \n      # 1. Place a central circle\n      initial_centers[0] = [0.5, 0.5]\n      \n      # 2. Place circles in an inner ring (8 circles)\n      num_inner_ring = 8\n      inner_ring_radius = 0.25 \n      for i in range(num_inner_ring):\n          angle = 2 * np.pi\
