- text: "`/execute_action{storage write noesis/peer_active_boundary_tol1e8.csv}`\n```yaml\ncontent: |\n  i,kind,slack\n  0,xL,0.0\n  1,xL,0.0\n  2,xL,0.0\n  3,xL,0.0\n  4,xL,0.0\n  20,xR,0.0\n  21,xR,0.0\n  22,xR,0.0\n  23,xR,0.0\n  24,xR,0.0\n  0,yB,0.0\n  5,yB,0.0\n  10,yB,0.0\n  15,yB,0.0\n  20,yB,0.0\n  4,yT,0.0\n  9,yT,0.0\n  14,yT,0.0\n  19,yT,0.0\n  24,yT,0.0\n```\n\n`/execute_action{storage write noesis/peer_active_pairs_tol1e8.csv}`\n```yaml\ncontent: |\n  i,j,slack\n  0,1,0.0\n  0,5,0.0\n  1,2,0.0\n  1,5,0.0\n  1,25,0.0\n  2,3,0.0\n  2,7,0.0\n  2,25,0.0\n  3,4,0.0\n  3,7,0.0\n  3,8,0.0\n  4,8,0.0\n  4,9,0.0\n  5,6,0.0\n  5,10,0.0\n  5,25,0.0\n  6,10,0.0\n  6,11,0.0\n  6,12,0.0\n  6,25,0.0\n  7,8,0.0\n  7,12,0.0\n  7,13,0.0\n  7,25,0.0\n  8,9,0.0\n  8,13,0.0\n  8,14,0.0\n  9,14,0.0\n  10,11,0.0\n  10,15,0.0\n  11,12,0.0\n  11,15,0.0\n  11,16,0.0\n  12,13,0.0\n  12,16,0.0\n  12,17,0.0\n  13,14,0.0\n  13,17,0.0\n  13,18,0.0\n  14,18,0.0\n  14,19,0.0\n  15,16,0.0\n  15,20,0.0\n  16,17,0.0\n\
    \  16,20,0.0\n  16,21,0.0\n  16,22,0.0\n  17,18,0.0\n  17,22,0.0\n  17,23,0.0\n  18,19,0.0\n  18,23,0.0\n  18,24,0.0\n  19,24,0.0\n  20,21,0.0\n  21,22,0.0\n  22,23,0.0\n  23,24,0.0\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Compare active sets with peer files (tol=1e-8, no-op packing)\"\ntags: \"analysis, contact-graph, jaccard, no-op\"\nabstract: \"Reads my active sets and peer active sets from storage/noesis/*_tol1e8.csv, computes Jaccard overlaps for pairs and boundary constraints, and writes results to storage/noesis/exports/. Returns the saved best packing unchanged.\"\ncontent: |\n  import os\n  import json\n  import numpy as np\n  import sys\n\n  N = 26\n\n  # Utils to read CSVs\n  def read_active_pairs_csv(path):\n      pairs = set()\n      try:\n          with open(path, 'r') as f:\n              header = f.readline()\n              for line in f:\n                  parts = line.strip().split(',')\n                  if len(parts) < 2:\n                      continue\n\
    \                  i = int(parts[0]); j = int(parts[1])\n                  if i > j:\n                      i, j = j, i\n                  pairs.add((i, j))\n      except Exception:\n          return None\n      return pairs\n\n  def read_active_boundary_csv(path):\n      bset = set()\n      try:\n          with open(path, 'r') as f:\n              header = f.readline()\n              for line in f:\n                  parts = line.strip().split(',')\n                  if len(parts) < 2:\n                      continue\n                  i = int(parts[0]); kind = parts[1]\n                  bset.add((i, kind))\n      except Exception:\n          return None\n      return bset\n\n  def jaccard(a, b):\n      if a is None or b is None:\n          return None, None, None\n      inter = a & b\n      uni = a | b\n      if len(uni) == 0:\n          return 1.0, 0, 0\n      return len(inter) / len(uni), len(inter), len(uni)\n\n  def load_saved_best():\n      try:\n          c = np.loadtxt('storage/noesis/latest_centers.txt')\n\
    \          r = np.loadtxt('storage/noesis/latest_radii.txt')\n          c = np.array(c, dtype=float).reshape(N, 2)\n          r = np.array(r, dtype=float).reshape(N,)\n          return c, r\n      except Exception:\n          return None, None\n\n  def grid_plus_hole_seed(r0=0.1 - 1e-8, eps=1e-8):\n      coords = [0.1, 0.3, 0.5, 0.7, 0.9]\n      centers = [[x, y] for x in coords for y in coords]\n      d = float(np.linalg.norm(np.array([0.2,0.2]) - np.array([0.1,0.1])))\n      radii = [float(r0)] * 25 + [float(d - r0 - eps)]\n      return np.array(centers, dtype=float), np.array(radii, dtype=float)\n\n  def construct_packing():\n      centers, radii = load_saved_best()\n      if centers is None:\n          centers, radii = grid_plus_hole_seed()\n\n      # Paths\n      mine_pairs_path = 'storage/noesis/exports/active_pairs_tol1e8.csv'\n      mine_bdry_path  = 'storage/noesis/exports/active_boundary_tol1e8.csv'\n      peer_pairs_path = 'storage/noesis/peer_active_pairs_tol1e8.csv'\n  \
    \    peer_bdry_path  = 'storage/noesis/peer_active_boundary_tol1e8.csv'\n\n      # Load sets\n      mine_pairs = read_active_pairs_csv(mine_pairs_path)\n      mine_bdry  = read_active_boundary_csv(mine_bdry_path)\n      peer_pairs = read_active_pairs_csv(peer_pairs_path)\n      peer_bdry  = read_active_boundary_csv(peer_bdry_path)\n\n      comp = {}\n      comp['pairs'] = {}\n      comp['boundary'] = {}\n\n      if mine_pairs is not None and peer_pairs is not None:\n          jc, inter, uni = jaccard(mine_pairs, peer_pairs)\n          comp['pairs'] = {\n              'mine_count': len(mine_pairs),\n              'peer_count': len(peer_pairs),\n              'jaccard': jc,\n              'intersection': inter,\n              'union': uni\n          }\n      else:\n          comp['pairs']['available'] = False\n\n      if mine_bdry is not None and peer_bdry is not None:\n          jc_b, inter_b, uni_b = jaccard(mine_bdry, peer_bdry)\n          comp['boundary'] = {\n              'mine_count':\
    \ len(mine_bdry),\n              'peer_count': len(peer_bdry),\n              'jaccard': jc_b,\n              'intersection': inter_b,\n              'union': uni_b\n          }\n      else:\n          comp['boundary']['available'] = False\n\n      # Write outputs\n      try:\n          os.makedirs('storage/noesis/exports', exist_ok=True)\n          with open('storage/noesis/exports/jaccard_peer_tol1e8.json', 'w') as f:\n              json.dump(comp, f, indent=2)\n          with open('storage/noesis/exports/jaccard_peer_tol1e8.txt', 'w') as f:\n              if 'jaccard' in comp.get('pairs', {}):\n                  f.write(f\"Pairs: mine={comp['pairs']['mine_count']}, peer={comp['pairs']['peer_count']}, \"\n                          f\"J={comp['pairs']['jaccard']:.6f} (|∩|={comp['pairs']['intersection']}, |∪|={comp['pairs']['union']})\\n\")\n              else:\n                  f.write(\"Pairs: unavailable\\n\")\n              if 'jaccard' in comp.get('boundary', {}):\n           \
    \       f.write(f\"Boundary: mine={comp['boundary']['mine_count']}, peer={comp['boundary']['peer_count']}, \"\n                          f\"J={comp['boundary']['jaccard']:.6f} (|∩|={comp['boundary']['intersection']}, |∪|={comp['boundary']['union']})\\n\")\n              else:\n                  f.write(\"Boundary: unavailable\\n\")\n      except Exception:\n          pass\n\n      return centers.astype(float), radii.astype(float)\n```\n\n`/execute_action{storage read noesis/exports/jaccard_peer_tol1e8.txt}`"
