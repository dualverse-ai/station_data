tick: 166
role: model
parts:
- text: "`/execute_action{goto research}`\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Ingest Scientia n=26 SOTA (Eval 259): Jaccard vs Noesis SOTA 243 + 4-lineage consensus refresh\"\ntags: \"analysis, jaccard, consensus, nmap, reproducibility\"\nabstract: \"Reads published n=26 active-set exports from Scientia (Eval 259, Σr=2.6358957) and computes Jaccards vs Noesis SOTA 243; refreshes 4-lineage consensus (Noesis 243, Aletheia 155, Inquire 207, Scientia 259). Writes results to storage/noesis/nmap/. Returns Noesis SOTA packing; no peer code is imported.\"\ncontent: |\n  import os, csv, json\n  import numpy as np\n\n  N = 26\n  R_MIN = 1e-6\n\n  # ---------------- IO helpers ----------------\n  def ensure_dir(p):\n    os.makedirs(p, exist_ok=True)\n\n  def read_pairs_csv(path):\n    S = set()\n    if not os.path.exists(path):\n      return S\n    with open(path, 'r') as f:\n      rdr = csv.reader(f)\n      for row in rdr:\n        if not row or len(row) < 2:\n          continue\n    \
    \    try:\n          i = int(row[0].strip())\n          j = int(row[1].strip())\n        except Exception:\n          # header or malformed: try to parse last two columns if needed\n          try:\n            i = int(row[-2].strip()); j = int(row[-1].strip())\n          except Exception:\n            continue\n        if i == j:\n          continue\n        a, b = (i, j) if i < j else (j, i)\n        S.add((a, b))\n    return S\n\n  def read_boundary_csv(path):\n    S = set()\n    if not os.path.exists(path):\n      return S\n    with open(path, 'r') as f:\n      rdr = csv.reader(f)\n      for row in rdr:\n        if not row or len(row) < 2:\n          continue\n        # expected: index, side (xL/xR/yB/yT) or similar token\n        try:\n          i = int(row[0].strip())\n          side = row[1].strip()\n        except Exception:\n          # attempt parsing last two columns\n          try:\n            i = int(row[-2].strip()); side = row[-1].strip()\n          except Exception:\n\
    \            continue\n        S.add(f\"{i}:{side}\")\n    return S\n\n  def write_jaccard(out_json, out_csv, name_a, name_b, Ba, Pa, Bb, Pb):\n    ensure_dir(os.path.dirname(out_json))\n    # Boundary\n    interB = Ba & Bb\n    unionB = Ba | Bb\n    JB = (len(interB) / len(unionB)) if len(unionB) > 0 else 1.0\n    # Pairs\n    interP = Pa & Pb\n    unionP = Pa | Pb\n    JP = (len(interP) / len(unionP)) if len(unionP) > 0 else 1.0\n    data = {\n      \"A\": name_a,\n      \"B\": name_b,\n      \"boundary\": {\n        \"size_A\": len(Ba), \"size_B\": len(Bb),\n        \"intersection\": len(interB), \"union\": len(unionB), \"jaccard\": JB\n      },\n      \"pairs\": {\n        \"size_A\": len(Pa), \"size_B\": len(Pb),\n        \"intersection\": len(interP), \"union\": len(unionP), \"jaccard\": JP\n      }\n    }\n    with open(out_json, 'w') as f:\n      json.dump(data, f, indent=2)\n    with open(out_csv, 'w', newline='') as f:\n      w = csv.writer(f)\n      w.writerow([\"set\", \"\
    size_A\", \"size_B\", \"intersection\", \"union\", \"jaccard\", \"A\", \"B\"])\n      w.writerow([\"boundary\", len(Ba), len(Bb), len(interB), len(unionB), f\"{JB:.6f}\", name_a, name_b])\n      w.writerow([\"pairs\", len(Pa), len(Pb), len(interP), len(unionP), f\"{JP:.6f}\", name_a, name_b])\n    print(f\"Wrote Jaccard to {out_json} and {out_csv}: JB={JB:.6f}, JP={JP:.6f}\")\n\n  def write_consensus(out_json, out_csv, label_sets):\n    # label_sets: dict name -> (Bset, Pset)\n    ensure_dir(os.path.dirname(out_json))\n    names = list(label_sets.keys())\n    B_sets = [label_sets[k][0] for k in names]\n    P_sets = [label_sets[k][1] for k in names]\n    # Intersections/unions\n    B_inter = set.intersection(*B_sets) if B_sets else set()\n    B_union = set.union(*B_sets) if B_sets else set()\n    P_inter = set.intersection(*P_sets) if P_sets else set()\n    P_union = set.union(*P_sets) if P_sets else set()\n    data = {\n      \"names\": names,\n      \"boundary\": {\n        \"sizes\"\
    : {names[i]: len(B_sets[i]) for i in range(len(names))},\n        \"intersection\": len(B_inter),\n        \"union\": len(B_union)\n      },\n      \"pairs\": {\n        \"sizes\": {names[i]: len(P_sets[i]) for i in range(len(names))},\n        \"intersection\": len(P_inter),\n        \"union\": len(P_union)\n      }\n    }\n    with open(out_json, 'w') as f:\n      json.dump(data, f, indent=2)\n    with open(out_csv, 'w', newline='') as f:\n      w = csv.writer(f)\n      w.writerow([\"type\", \"intersection\", \"union\"] + [f\"size_{n}\" for n in names])\n      w.writerow([\"boundary\", len(B_inter), len(B_union)] + [len(s) for s in B_sets])\n      w.writerow([\"pairs\", len(P_inter), len(P_union)] + [len(s) for s in P_sets])\n    print(f\"Wrote consensus to {out_json} and {out_csv}\")\n\n  # ---------------- Load active sets ----------------\n  # Noesis SOTA 243 (local)\n  noe_dir = \"storage/noesis/exports/sota_243\"\n  B_noe = read_boundary_csv(os.path.join(noe_dir, \"active_boundary_tol1e8.csv\"\
    ))\n  P_noe = read_pairs_csv(os.path.join(noe_dir, \"active_pairs_tol1e8.csv\"))\n\n  # Scientia SOTA 259\n  sci_dir = \"storage/Scientia/nmap/n26\"\n  B_sci = read_boundary_csv(os.path.join(sci_dir, \"active_boundary_tol1e8.csv\"))\n  P_sci = read_pairs_csv(os.path.join(sci_dir, \"active_pairs_tol1e8.csv\"))\n\n  # Aletheia 155 (previous SOTA)\n  ale_dir = \"storage/Aletheia/nmap/n26\"\n  B_ale = read_boundary_csv(os.path.join(ale_dir, \"active_boundary_tol1e8.csv\"))\n  P_ale = read_pairs_csv(os.path.join(ale_dir, \"active_pairs_tol1e8.csv\"))\n\n  # Inquire 207\n  inq_dir = \"storage/Inquire/nmap/n26\"\n  B_inq = read_boundary_csv(os.path.join(inq_dir, \"active_boundary_tol1e8.csv\"))\n  P_inq = read_pairs_csv(os.path.join(inq_dir, \"active_pairs_tol1e8.csv\"))\n\n  # ---------------- Compute and write outputs ----------------\n  out_dir = \"storage/noesis/nmap\"\n  ensure_dir(out_dir)\n\n  # Jaccard: Noesis SOTA 243 vs Scientia 259\n  write_jaccard(\n    os.path.join(out_dir, \"\
    jaccard_scientia_eval259_vs_sota243_tol1e8.json\"),\n    os.path.join(out_dir, \"jaccard_scientia_eval259_vs_sota243_tol1e8.csv\"),\n    \"Noesis_Eval243\", \"Scientia_Eval259\", B_noe, P_noe, B_sci, P_sci\n  )\n\n  # 4-lineage consensus (latest)\n  label_sets = {\n    \"Noesis_Eval243\": (B_noe, P_noe),\n    \"Aletheia_Eval155\": (B_ale, P_ale),\n    \"Inquire_Eval207\": (B_inq, P_inq),\n    \"Scientia_Eval259\": (B_sci, P_sci),\n  }\n  write_consensus(\n    os.path.join(out_dir, \"consensus_n26_4lineage_latest_tol1e8.json\"),\n    os.path.join(out_dir, \"consensus_n26_4lineage_latest_tol1e8.csv\"),\n    label_sets\n  )\n\n  # ---------------- Return a valid packing (Noesis SOTA) ----------------\n  def load_noesis_pack():\n    # Prefer lineage latest snapshot; fall back to sota_243 if present; else grid+hole seed\n    paths = [\n      (\"storage/noesis/latest_centers.txt\", \"storage/noesis/latest_radii.txt\"),\n      (os.path.join(noe_dir, \"centers.txt\"), os.path.join(noe_dir, \"\
    radii.txt\")),\n    ]\n    for pc, pr in paths:\n      try:\n        c = np.loadtxt(pc, dtype=float).reshape(N, 2)\n        r = np.loadtxt(pr, dtype=float).reshape(N,)\n        return c, r\n      except Exception:\n        continue\n    # Fallback: grid+hole constructive seed (feasible, suboptimal)\n    r0 = 0.1 - 1e-8\n    coords = [0.1, 0.3, 0.5, 0.7, 0.9]\n    centers = [[x, y] for x in coords for y in coords]\n    hole = np.array([0.2, 0.2])\n    d = float(np.linalg.norm(hole - np.array([0.1, 0.1])))\n    r_hole = d - r0 - 1e-8\n    radii = [r0] * 25 + [r_hole]\n    return np.array(centers, float), np.array(radii, float)\n\n  def construct_packing():\n    c, r = load_noesis_pack()\n    return np.array(c, dtype=float), np.array(r, dtype=float)\n```"
