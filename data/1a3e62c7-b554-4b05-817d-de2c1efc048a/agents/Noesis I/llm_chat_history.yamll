tick: 294
role: model
parts:
- text: "`/execute_action{submit 1}`\n```yaml\ntitle: \"Jaccard + KKT Coverage for Inquire Nudged_ID_V49 (analysis-only)\"\ntags: \"analysis, jaccard, kkt, shadow-prices, no-peer-code\"\nabstract: \"Compute boundary/pair Jaccards for Inquire Nudged_ID_V49 vs Noesis_243 and vs Inquire_207_SOTA. Also compute top-K coverage of KKT shadow-price pairs (from Inquire_207) by edges that changed in V49. Write JSON/CSV artifacts; return Noesis pack unchanged.\"\ncontent: |\n  import os, csv, json\n  import numpy as np\n\n  N = 26\n  R_MIN = 1e-6\n\n  # ---------- IO helpers ----------\n  def load_noesis_pack():\n      try:\n          c = np.loadtxt('storage/noesis/latest_centers.txt')\n          r = np.loadtxt('storage/noesis/latest_radii.txt')\n          c = np.array(c, dtype=float).reshape(N, 2)\n          r = np.array(r, dtype=float).reshape(N,)\n          return c, r\n      except Exception:\n          # Minimal feasible fallback: 5x5 grid + tiny hole\n          r0 = 0.1 - 1e-6\n          coords\
    \ = [r0 + 2*r0*i for i in range(5)]\n          grid = np.array([[x, y] for x in coords for y in coords], dtype=float)\n          hole = np.array([0.2, 0.2], dtype=float)\n          d = float(np.linalg.norm(hole - grid[0]))\n          rh = max(min(d - r0 - 1e-6, min(hole[0],1-hole[0],hole[1],1-hole[1]) - 1e-6), R_MIN)\n          c = np.vstack([grid, hole.reshape(1,2)])\n          r = np.concatenate([np.full(25, r0), np.array([rh])])\n          return c, r\n\n  def read_pairs_csv(path, has_header=True):\n      pairs = set()\n      with open(path, 'r') as f:\n          rdr = csv.reader(f)\n          if has_header:\n              next(rdr, None)\n          for row in rdr:\n              if not row or len(row) < 2: continue\n              try:\n                  i = int(row[0]); j = int(row[1])\n              except Exception:\n                  continue\n              if i == j: continue\n              a, b = (i, j) if i < j else (j, i)\n              pairs.add((a, b))\n      return pairs\n\
    \n  def read_boundary_csv(path, has_header=True):\n      # Accept columns: i,kind,slack OR disc,label\n      bset = set()\n      with open(path, 'r') as f:\n          rdr = csv.reader(f)\n          if has_header:\n              headers = next(rdr, None)\n              # detect positions\n              if headers is None:\n                  return bset\n              low = [h.strip().lower() for h in headers]\n              if 'i' in low and 'kind' in low:\n                  i_pos = low.index('i'); lab_pos = low.index('kind')\n              elif 'disc' in low and 'label' in low:\n                  i_pos = low.index('disc'); lab_pos = low.index('label')\n              else:\n                  # fallback assume first two columns are disc,label\n                  i_pos, lab_pos = 0, 1\n          else:\n              i_pos, lab_pos = 0, 1\n              rdr = csv.reader(f)\n          for row in rdr:\n              if not row or len(row) <= max(i_pos, lab_pos): continue\n              try:\n\
    \                  i = int(row[i_pos])\n              except Exception:\n                  continue\n              lab = str(row[lab_pos]).strip()\n              bset.add((i, lab))\n      return bset\n\n  def jaccard(a_set, b_set):\n      inter = len(a_set & b_set)\n      uni = len(a_set | b_set)\n      return inter, uni, (inter / uni) if uni > 0 else 0.0\n\n  def parse_shadow_prices_pairs(path):\n      # Pairs only; CSV: constraint_type,id1,id2_or_label,shadow_price,...,rank\n      rows = []\n      with open(path, 'r') as f:\n          rdr = csv.DictReader(f)\n          for row in rdr:\n              ctype = (row.get('constraint_type','') or '').strip().lower()\n              if ctype != 'pair': continue\n              try:\n                  i = int(row.get('id1')); j = int(row.get('id2_or_label'))\n                  sp = float(row.get('shadow_price'))\n              except Exception:\n                  continue\n              rk = row.get('rank')\n              rk = int(rk) if rk\
    \ not in (None, '') else None\n              a, b = (i, j) if i < j else (j, i)\n              rows.append({'i': a, 'j': b, 'shadow_price': max(sp, 0.0), 'rank': rk})\n      if rows and rows[0]['rank'] is not None:\n          rows.sort(key=lambda d: d['rank'])\n      else:\n          rows.sort(key=lambda d: d['shadow_price'], reverse=True)\n          for idx, d in enumerate(rows, start=1):\n              d['rank'] = idx\n      return rows\n\n  # ---------- Paths ----------\n  p_noesis_pairs = 'storage/noesis/exports/sota_243/active_pairs_tol1e8.csv'\n  p_noesis_bound = 'storage/noesis/exports/sota_243/active_boundary_tol1e8.csv'\n\n  p_inq_sota_pairs = 'storage/Inquire/nmap/n26/Inquire_207_SOTA_active_pairs_tol1e8.csv'\n  p_inq_sota_bound = 'storage/Inquire/nmap/n26/Inquire_207_SOTA_active_boundary_tol1e8.csv'\n  p_inq_sota_summary = 'storage/Inquire/nmap/n26/Inquire_207_SOTA_summary_tol1e8.json'\n\n  p_v49_pairs = 'storage/Inquire/nmap/n26/Nudged_ID_V49/Nudged_ID_V49_active_pairs_tol1e08.csv'\n\
    \  p_v49_bound = 'storage/Inquire/nmap/n26/Nudged_ID_V49/Nudged_ID_V49_active_boundary_tol1e08.csv'\n  p_v49_summary = 'storage/Inquire/nmap/n26/Nudged_ID_V49/Nudged_ID_V49_summary_tol1e08.json'\n\n  p_shadow = 'storage/Inquire/nmap/n26/Inquire_207_SOTA_Shadow_Prices/shadow_prices_ranked_with_slack_tol1e08.csv'\n\n  def try_read_json(path):\n      try:\n          with open(path, 'r') as f:\n              return json.load(f)\n      except Exception:\n          return {}\n\n  def construct_packing():\n      # Read sets\n      no_pairs = read_pairs_csv(p_noesis_pairs)\n      no_bound = read_boundary_csv(p_noesis_bound)\n\n      inq_pairs = read_pairs_csv(p_inq_sota_pairs)\n      inq_bound = read_boundary_csv(p_inq_sota_bound)\n\n      v49_pairs = read_pairs_csv(p_v49_pairs)\n      v49_bound = read_boundary_csv(p_v49_bound)\n\n      # Jaccards\n      b_I, b_U, b_J = jaccard(no_bound, v49_bound)\n      p_I, p_U, p_J = jaccard(no_pairs, v49_pairs)\n\n      b2_I, b2_U, b2_J = jaccard(inq_bound,\
    \ v49_bound)\n      p2_I, p2_U, p2_J = jaccard(inq_pairs, v49_pairs)\n\n      # Sums\n      v49_sum = try_read_json(p_v49_summary).get('sum_r', None)\n      inq_sum = try_read_json(p_inq_sota_summary).get('sum_r', None)\n      no_sum = None\n      try:\n          # optional Noesis summary\n          no_sum = try_read_json('storage/noesis/exports/sota_243/summary_tol1e8.json').get('sum_r', None)\n      except Exception:\n          pass\n      if no_sum is None:\n          no_sum = 2.6342924  # fallback from our SOTA eval 243\n\n      # Shadow-price coverage vs Inquire_207\n      coverage = {}\n      changed_union = (inq_pairs - v49_pairs) | (v49_pairs - inq_pairs)\n      try:\n          sp_rows = parse_shadow_prices_pairs(p_shadow)\n          for K in [10, 20, 50, 100]:\n              topK = {(d['i'], d['j']) for d in sp_rows[:min(K, len(sp_rows))]}\n              ch = len(topK & changed_union)\n              coverage[f'K{K}'] = {'changed_count': ch, 'fraction': ch / max(1, min(K, len(sp_rows)))}\n\
    \      except Exception:\n          coverage = {}\n\n      # Write artifacts\n      outdir = 'storage/noesis/nmap'\n      os.makedirs(outdir, exist_ok=True)\n      j1 = {\n          'reference': 'Noesis_243',\n          'target': 'Inquire_Nudged_ID_V49',\n          'tol': '1e-8',\n          'boundary': {\n              'size_ref': len(no_bound), 'size_tgt': len(v49_bound),\n              'intersection': b_I, 'union': b_U, 'jaccard': b_J\n          },\n          'pairs': {\n              'size_ref': len(no_pairs), 'size_tgt': len(v49_pairs),\n              'intersection': p_I, 'union': p_U, 'jaccard': p_J\n          },\n          'sum_r_target': v49_sum, 'sum_r_reference': no_sum,\n          'delta_sum_r_vs_reference': None if (v49_sum is None or no_sum is None) else (v49_sum - no_sum)\n      }\n      with open(os.path.join(outdir, 'jaccard_inquire_Nudged_ID_V49_vs_noesis243_tol1e08.json'), 'w') as f:\n          json.dump(j1, f, indent=2)\n\n      j2 = {\n          'reference': 'Inquire_207_SOTA',\n\
    \          'target': 'Inquire_Nudged_ID_V49',\n          'tol': '1e-8',\n          'boundary': {\n              'size_ref': len(inq_bound), 'size_tgt': len(v49_bound),\n              'intersection': b2_I, 'union': b2_U, 'jaccard': b2_J\n          },\n          'pairs': {\n              'size_ref': len(inq_pairs), 'size_tgt': len(v49_pairs),\n              'intersection': p2_I, 'union': p2_U, 'jaccard': p2_J\n          },\n          'sum_r_target': v49_sum, 'sum_r_reference': inq_sum,\n          'delta_sum_r_vs_reference': None if (v49_sum is None or inq_sum is None) else (v49_sum - inq_sum),\n          'shadow_price_topK_coverage': coverage\n      }\n      with open(os.path.join(outdir, 'jaccard_inquire_Nudged_ID_V49_vs_inquire207_tol1e08.json'), 'w') as f:\n          json.dump(j2, f, indent=2)\n\n      # Scoreboard row\n      try:\n          with open(os.path.join(outdir, 'scoreboard_update_tick294_v49.csv'), 'w') as f:\n              f.write('target,sum_r,delta_vs_noesis243,delta_vs_inquire207,boundary_J_vs_noesis,pairs_J_vs_noesis,boundary_J_vs_inquire,pairs_J_vs_inquire\\\
    n')\n              f.write(f\"Inquire_Nudged_ID_V49,{v49_sum},{j1.get('delta_sum_r_vs_reference', '')},{j2.get('delta_sum_r_vs_reference', '')},{b_J},{p_J},{b2_J},{p2_J}\\n\")\n      except Exception:\n          pass\n\n      # Return baseline pack unchanged\n      C, R = load_noesis_pack()\n      return np.array(C, dtype=float), np.array(R, dtype=float)\n```"
