- text: "`/execute_action{storage list Inquire/nmap/n26/Inquire_207_SOTA_Shadow_Prices}`\n`/execute_action{storage list Inquire/nmap/n26/Nudged_ID_V44}`\n`/execute_action{storage write noesis/nmap/parse_shadow_prices.py}`\n```yaml\ncontent: |\n  import csv, json, re\n  from typing import List, Dict, Tuple, Optional\n\n  def _to_int(s):\n      try: return int(s)\n      except: return None\n\n  def _to_float(s):\n      try: return float(s)\n      except: return None\n\n  def infer_schema(headers: List[str]) -> str:\n      cols = [h.strip().lower() for h in headers]\n      setc = set(cols)\n      if {'i','j','shadow_price','rank'}.issubset(setc):\n          return 'A'  # pair-only\n      if {'constraint_type','id1','id2_or_label','multiplier_value','rank'}.issubset(setc):\n          return 'B'  # pair+boundary\n      return 'unknown'\n\n  def canonicalize_boundary(label: str) -> str:\n      lab = label.strip().lower()\n      mapping = {'xl':'xL','xr':'xR','yl':'yB','yb':'yB','yt':'yT',\n  \
    \               'xmin':'xL','xmax':'xR','ymin':'yB','ymax':'yT',\n                 'xlb':'xL','xrb':'xR','ylb':'yB','ytb':'yT'}\n      key = re.sub(r'[^a-z]', '', lab)\n      return mapping.get(key, label)\n\n  def parse_csv_lines(lines: List[str]) -> Dict:\n      reader = csv.reader(lines)\n      rows = list(reader)\n      if not rows:\n          return {'schema':'empty', 'pairs':[], 'boundary':[]}\n      headers = [h.strip() for h in rows[0]]\n      schema = infer_schema(headers)\n\n      pairs = []\n      boundary = []\n\n      idx = {h.strip().lower(): k for k,h in enumerate(headers)}\n      for row in rows[1:]:\n          if not row or all((c is None or str(c).strip()=='' for c in row)):\n              continue\n          if schema == 'A':\n              i = _to_int(row[idx['i']]); j = _to_int(row[idx['j']])\n              sp = _to_float(row[idx['shadow_price']]); rk = _to_int(row[idx['rank']])\n              sv = _to_float(row[idx.get('slack_value', idx.get('slack', -1))]) if 'slack_value'\
    \ in idx or 'slack' in idx else None\n              ia = row[idx.get('is_active', -1)].strip().lower() in ('1','true','yes') if 'is_active' in idx else None\n              if i is not None and j is not None and sp is not None:\n                  pairs.append({'i':i,'j':j,'shadow_price':sp,'rank':rk,'slack_value':sv,'is_active':ia})\n          elif schema == 'B':\n              ctype = row[idx['constraint_type']].strip().lower()\n              rk = _to_int(row[idx['rank']])\n              mv = _to_float(row[idx['multiplier_value']])\n              sv = _to_float(row[idx.get('slack_value', idx.get('slack', -1))]) if 'slack_value' in idx or 'slack' in idx else None\n              ia = row[idx.get('is_active', -1)].strip().lower() in ('1','true','yes') if 'is_active' in idx else None\n              if ctype == 'pair':\n                  i = _to_int(row[idx['id1']]); j = _to_int(row[idx['id2_or_label']])\n                  if i is not None and j is not None and mv is not None:\n         \
    \             pairs.append({'i':i,'j':j,'shadow_price':mv,'rank':rk,'slack_value':sv,'is_active':ia})\n              elif ctype == 'boundary':\n                  i = _to_int(row[idx['id1']]); lab = canonicalize_boundary(row[idx['id2_or_label']])\n                  if i is not None and mv is not None:\n                      boundary.append({'i':i,'label':lab,'multiplier':mv,'rank':rk,'slack_value':sv,'is_active':ia})\n          else:\n              # try best-effort A\n              possible = {'i','j','shadow_price'}\n              low = {h.strip().lower() for h in headers}\n              if possible.issubset(low):\n                  i = _to_int(row[headers.index('i')]); j = _to_int(row[headers.index('j')])\n                  sp = _to_float(row[headers.index('shadow_price')])\n                  rk = _to_int(row[headers.index('rank')]) if 'rank' in headers else None\n                  if i is not None and j is not None and sp is not None:\n                      pairs.append({'i':i,'j':j,'shadow_price':sp,'rank':rk})\n\
    \      # sort pairs by descending shadow_price (or rank if provided)\n      if pairs and pairs[0].get('rank') is not None:\n          pairs.sort(key=lambda d: (d['rank'] if d['rank'] is not None else 10**9))\n      else:\n          pairs.sort(key=lambda d: d.get('shadow_price', -1), reverse=True)\n      return {'schema': schema, 'pairs': pairs, 'boundary': boundary, 'num_pairs': len(pairs), 'num_boundary': len(boundary)}\n```\n\n`/execute_action{storage write noesis/notes_tick282.md}`\n```yaml\ncontent: |\n  Tick 282 — Shadow-price ingestion readiness\n  - Awaiting Inquire V45 trust-constr export under storage/Inquire/nmap/n26/Inquire_207_SOTA_Shadow_Prices/.\n  - Added robust parser parse_shadow_prices.py supporting Schema A (pair-only) and Schema B (pair+boundary).\n  - Will ingest via storage read (manual, not eval-code), summarize top-K, and correlate with ΔΣr over Nudged_* once available.\n```"
