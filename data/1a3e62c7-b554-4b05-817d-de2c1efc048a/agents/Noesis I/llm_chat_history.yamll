- text: "`/execute_action{goto research}`\n`/execute_action{storage list Inquire/nmap}`\n`/execute_action{storage list Inquire/nmap/n26}`\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Utility: Inquire n=26 Nudged Aggregator v1 — Jaccard vs {Noesis_243, Scientia_259, Prometheus_298}\"\ntags: \"utility, jaccard, aggregator, nudging, reproducibility\"\nabstract: \"Scan storage/Inquire/nmap/n26/ for nudged packings (directories containing centers/radii/active_*.csv). Compute boundary/pairs Jaccards (unaligned + Hungarian-aligned) vs Noesis_243, Scientia_259, and Prometheus_298 at tol=1e-8. Emit per-pack JSON/CSV and a summary table. Returns current Noesis packing unchanged.\"\ncontent: |\n  import os, re, csv, json, numpy as np\n  try:\n      from scipy.optimize import linear_sum_assignment\n  except Exception:\n      linear_sum_assignment = None\n\n  N = 26\n  TOL = 1e-8\n  OUT_ROOT = 'storage/noesis/nmap/inquire_nudged'\n\n  # Baseline dirs\n  D_NOE = 'storage/noesis/exports/sota_243'\n\
    \  D_SCI_CAND = [\n      'storage/Scientia/nmap/n26',\n      '/home/ubuntu/station_2/station_data/rooms/research/storage/lineages/scientia/nmap/n26',\n  ]\n  D_PRO_CAND = [\n      'storage/Prometheus/nmap/n26',\n      '/home/ubuntu/station_2/station_data/rooms/research/storage/lineages/prometheus/nmap/n26',\n  ]\n  D_INQ_ROOT = 'storage/Inquire/nmap/n26'\n\n  # Extended canonicalization for boundary labels\n  CANON = {\n    'xl':'xL','x_l':'xL','xleft':'xL','left':'xL','xmin':'xL','x_min':'xL',\n    'xr':'xR','x_r':'xR','xright':'xR','right':'xR','xmax':'xR','x_max':'xR',\n    'yb':'yB','y_b':'yB','ybottom':'yB','bottom':'yB','ymin':'yB','y_min':'yB',\n    'yt':'yT','y_t':'yT','ytop':'yT','top':'yT','ymax':'yT','y_max':'yT',\n    'xL':'xL','xR':'xR','yB':'yB','yT':'yT'\n  }\n  INT_RE = re.compile(r'[-+]?\\d+')\n  NUM_RE = re.compile(r'[-+]?\\d+(?:\\.\\d+)?', re.I)\n  SIDE_RE = re.compile(r'(xL|xR|yB|yT|xl|xr|yb|yt|left|right|top|bottom|xmin|xmax|ymin|ymax|x_min|x_max|y_min|y_max)', re.I)\n\
    \n  def first_existing(paths):\n      for p in paths:\n          if os.path.exists(p): return p\n      return None\n\n  def read_lines(path):\n      with open(path, 'r', encoding='utf-8', errors='ignore') as f:\n          return f.read().strip().splitlines()\n\n  def parse_pairs_raw(path):\n      rows=[]\n      if not os.path.exists(path): return rows\n      for ln in read_lines(path):\n          toks = NUM_RE.findall(ln)\n          if len(toks) >= 2:\n              try:\n                  i = int(float(toks[0])); j = int(float(toks[1]))\n                  rows.append((i, j))\n              except Exception:\n                  continue\n      return rows\n\n  def parse_boundary_raw(path):\n      rows=[]\n      if not os.path.exists(path): return rows\n      for ln in read_lines(path):\n          itoks = INT_RE.findall(ln)\n          if not itoks: \n              continue\n          try:\n              i = int(itoks[0])\n          except Exception:\n              continue\n          m\
    \ = SIDE_RE.search(ln)\n          if not m:\n              continue\n          s_raw = m.group(1)\n          k = s_raw.replace(' ', '').replace(':','').replace(',','').replace('.','').lower()\n          s = CANON.get(k, CANON.get(k.lower(), k))\n          if s in ('xL','xR','yB','yT'):\n              rows.append((i, s))\n      return rows\n\n  def normalize_indices(rows, kind):\n      # Normalize to 0-based indices\n      if kind == 'pairs':\n          idxs = [i for (i, _) in rows] + [j for (_, j) in rows]\n      else:\n          idxs = [i for (i, _) in rows]\n      if not idxs:\n          return set(), {'applied': False, 'mode': 'empty'}\n      c0 = sum(0 <= v <= N-1 for v in idxs)\n      c1 = sum(1 <= v <= N for v in idxs)\n      meta = {'applied': False, 'mode': 'as-is'}\n      out = set()\n      if c1 > c0 and all(1 <= v <= N for v in idxs):\n          meta = {'applied': True, 'mode': 'minus_one'}\n          if kind == 'pairs':\n              for (i, j) in rows:\n               \
    \   a, b = i-1, j-1\n                  if 0 <= a < N and 0 <= b < N and a != b:\n                      u, v = (a, b) if a < b else (b, a)\n                      out.add((u, v))\n          else:\n              for (i, s) in rows:\n                  a = i-1\n                  if 0 <= a < N:\n                      out.add((a, s))\n      else:\n          if kind == 'pairs':\n              for (i, j) in rows:\n                  if 0 <= i < N and 0 <= j < N and i != j:\n                      u, v = (i, j) if i < j else (j, i)\n                      out.add((u, v))\n          else:\n              for (i, s) in rows:\n                  if 0 <= i < N:\n                      out.add((i, s))\n      return out, meta\n\n  def read_centers(path):\n      rows=[]\n      for ln in read_lines(path):\n          toks = NUM_RE.findall(ln)\n          if len(toks) >= 2:\n              rows.append([float(toks[0]), float(toks[1])])\n      C = np.array(rows, float)\n      if C.shape != (N, 2):\n          raise\
    \ ValueError(f\"centers shape mismatch: {path} -> {C.shape}\")\n      return C\n\n  def load_pack(dir_root, centers_path=None):\n      pr_raw = parse_pairs_raw(os.path.join(dir_root, 'active_pairs_tol1e8.csv'))\n      bd_raw = parse_boundary_raw(os.path.join(dir_root, 'active_boundary_tol1e8.csv'))\n      pairs, m_pairs = normalize_indices(pr_raw, 'pairs')\n      bound, m_bound = normalize_indices(bd_raw, 'bound')\n      C = read_centers(centers_path) if centers_path and os.path.exists(centers_path) else None\n      return {'pairs': pairs, 'bound': bound, 'centers': C, 'meta': {'pairs_norm': m_pairs, 'bound_norm': m_bound}}\n\n  def jaccard(A, B):\n      I = A & B; U = A | B\n      J = float(len(I))/float(len(U)) if len(U) > 0 else 1.0\n      return J, len(I), len(U), len(U) - len(I)\n\n  def align_map(CA, CB):\n      M = np.sum((CA[:, None, :] - CB[None, :, :])**2, axis=2)\n      if linear_sum_assignment is None:\n          a_idx = np.lexsort((CA[:,1], CA[:,0]))\n          b_idx = np.lexsort((CB[:,1],\
    \ CB[:,0]))\n          P = np.zeros(N, dtype=int); P[a_idx] = b_idx\n          return P\n      r, c = linear_sum_assignment(M)\n      P = np.zeros(N, dtype=int); P[r] = c\n      return P\n\n  def map_pairs(P, S):\n      T = set()\n      for (i, j) in S:\n          a, b = int(P[i]), int(P[j])\n          if a == b:\n              continue\n          u, v = (a, b) if a < b else (b, a)\n          T.add((u, v))\n      return T\n\n  def map_bound(P, S):\n      T = set()\n      for (i, s) in S:\n          T.add((int(P[i]), s))\n      return T\n\n  def pair_report(A, B, out_dir, tag):\n      # Unaligned\n      Jb, Ib, Ub, Db = jaccard(A['bound'], B['bound'])\n      Jp, Ip, Up, Dp = jaccard(A['pairs'], B['pairs'])\n      with open(os.path.join(out_dir, f'{tag}.json'), 'w') as f:\n          json.dump({\"n\":N,\"boundary\":{\"jaccard\":Jb,\"I\":Ib,\"U\":Ub},\n                     \"pairs\":{\"jaccard\":Jp,\"I\":Ip,\"U\":Up,\"D\":Dp}}, f, indent=2, sort_keys=True)\n      with open(os.path.join(out_dir,\
    \ f'{tag}.csv'), 'w', newline='') as f:\n          w = csv.writer(f); w.writerow(['n','boundary_j','I_b','U_b','pairs_j','I_p','U_p','D_p'])\n          w.writerow([N,Jb,Ib,Ub,Jp,Ip,Up,Dp])\n\n      # Aligned (A->B) if centers exist\n      if A['centers'] is not None and B['centers'] is not None:\n          P = align_map(A['centers'], B['centers'])\n          Ab, Ap = map_bound(P, A['bound']), map_pairs(P, A['pairs'])\n          Jb2, Ib2, Ub2, Db2 = jaccard(Ab, B['bound'])\n          Jp2, Ip2, Up2, Dp2 = jaccard(Ap, B['pairs'])\n          with open(os.path.join(out_dir, f'{tag}_aligned.json'), 'w') as f:\n              json.dump({\"n\":N,\"alignment\":\"hungarian\",\n                         \"boundary\":{\"jaccard\":Jb2,\"I\":Ib2,\"U\":Ub2},\n                         \"pairs\":{\"jaccard\":Jp2,\"I\":Ip2,\"U\":Up2,\"D\":Dp2}}, f, indent=2, sort_keys=True)\n          with open(os.path.join(out_dir, f'{tag}_aligned.csv'), 'w', newline='') as f:\n              w = csv.writer(f); w.writerow(['n','alignment','boundary_j','I_b','U_b','pairs_j','I_p','U_p','D_p'])\n\
    \              w.writerow([N,'hungarian',Jb2,Ib2,Ub2,Jp2,Ip2,Up2,Dp2])\n\n  def discover_inquire_packs(root):\n      packs=[]\n      if not os.path.exists(root):\n          return packs\n      # Consider root itself and its immediate subdirs\n      candidates=[root] + [os.path.join(root, d) for d in os.listdir(root) if os.path.isdir(os.path.join(root,d))]\n      for p in candidates:\n          c=os.path.join(p,'centers.txt'); r=os.path.join(p,'radii.txt')\n          b=os.path.join(p,'active_boundary_tol1e8.csv')\n          if os.path.exists(c) and os.path.exists(r) and os.path.exists(b):\n              name=os.path.relpath(p, root).replace(os.sep,'_') or 'root'\n              packs.append((name,p))\n      return packs\n\n  def construct_packing():\n      os.makedirs(OUT_ROOT, exist_ok=True)\n\n      # Load baselines\n      sci_dir = first_existing(D_SCI_CAND)\n      pro_dir = first_existing(D_PRO_CAND)\n      if sci_dir is None:\n          raise FileNotFoundError(\"Scientia n=26 exports\
    \ not found\")\n      if pro_dir is None:\n          print(\"[WARN] Prometheus n=26 not found; proceeding without it\")\n      noe = load_pack(D_NOE, centers_path='storage/noesis/latest_centers.txt')\n      sci = load_pack(sci_dir, centers_path=os.path.join(sci_dir,'centers.txt'))\n      pro = load_pack(pro_dir, centers_path=os.path.join(pro_dir,'centers.txt')) if pro_dir else None\n\n      packs = discover_inquire_packs(D_INQ_ROOT)\n      summary_rows=[]\n      if not packs:\n          meta={'note':'No Inquire nudged packs found','root':D_INQ_ROOT}\n          with open(os.path.join(OUT_ROOT,'inquire_nudged_meta.json'),'w') as f:\n              json.dump(meta,f,indent=2,sort_keys=True)\n          # Return baseline unchanged\n          c = np.loadtxt('storage/noesis/latest_centers.txt'); r = np.loadtxt('storage/noesis/latest_radii.txt')\n          return np.array(c,float).reshape(N,2), np.array(r,float).reshape(N,)\n\n      for name, path in packs:\n          out_dir = os.path.join(OUT_ROOT,\
    \ name)\n          os.makedirs(out_dir, exist_ok=True)\n          pack = load_pack(path, centers_path=os.path.join(path,'centers.txt'))\n\n          # Against Noesis_243\n          pair_report(pack, noe, out_dir, f'{name}_vs_noesis243_tol1e8')\n          # Against Scientia_259\n          pair_report(pack, sci, out_dir, f'{name}_vs_scientia259_tol1e8')\n          # Against Prometheus_298 (optional)\n          if pro is not None:\n              pair_report(pack, pro, out_dir, f'{name}_vs_prometheus298_tol1e8')\n\n          # For summary, load aligned boundary J if present; else unaligned\n          def load_j(path_json, fallback_json):\n              if os.path.exists(path_json):\n                  with open(path_json,'r') as f: return float(json.load(f)['boundary']['jaccard'])\n              with open(fallback_json,'r') as f: return float(json.load(f)['boundary']['jaccard'])\n\n          j_noe = load_j(os.path.join(out_dir, f'{name}_vs_noesis243_tol1e8_aligned.json'),\n              \
    \           os.path.join(out_dir, f'{name}_vs_noesis243_tol1e8.json'))\n          j_sci = load_j(os.path.join(out_dir, f'{name}_vs_scientia259_tol1e8_aligned.json'),\n                         os.path.join(out_dir, f'{name}_vs_scientia259_tol1e8.json'))\n          if pro is not None:\n              j_pro = load_j(os.path.join(out_dir, f'{name}_vs_prometheus298_tol1e8_aligned.json'),\n                             os.path.join(out_dir, f'{name}_vs_prometheus298_tol1e8.json'))\n          else:\n              j_pro = None\n\n          summary_rows.append([name, j_noe, j_sci, '' if j_pro is None else j_pro])\n\n      with open(os.path.join(OUT_ROOT,'inquire_nudged_summary.csv'),'w',newline='') as f:\n          w=csv.writer(f); w.writerow(['pack','boundary_j_noesis243','boundary_j_scientia259','boundary_j_prometheus298'])\n          for r in summary_rows: w.writerow(r)\n\n      # Return current Noesis packing unchanged\n      c = np.loadtxt('storage/noesis/latest_centers.txt'); r = np.loadtxt('storage/noesis/latest_radii.txt')\n\
    \      return np.array(c,float).reshape(N,2), np.array(r,float).reshape(N,)\n```\n\n`/execute_action{storage write noesis/nmap/updates.md}`\n```yaml\ncontent: |\n  Tick 202 — Inquire nudged aggregator ready\n  - Submitted aggregator to scan storage/Inquire/nmap/n26/ for nudged packs and compute Jaccards vs Noesis_243, Scientia_259, Prometheus_298 (unaligned + aligned).\n  - Outputs per-pack in storage/noesis/nmap/inquire_nudged/<pack>/ and a summary CSV at storage/noesis/nmap/inquire_nudged/inquire_nudged_summary.csv.\n  - If no packs are found yet, a meta file is written and the aggregator can be rerun once exports arrive. Exports-only analysis; no eval-code peer reads.\n```\n\n`/execute_action{goto public_memory}`\n`/execute_action{reply 1}`\n```yaml\ncontent: |\n  Aggregator posted (Tick 202): I submitted a utility that will auto-scan storage/Inquire/nmap/n26/ for your nudged packs and compute Jaccards vs Noesis_243, Scientia_259, and Prometheus_298 (unaligned + Hungarian-aligned).\
    \ Results will appear under storage/noesis/nmap/inquire_nudged/ with a summary CSV. \n  If the directory is empty now, the script writes a meta note and we can rerun as soon as your exports land. Exports-only analysis; no eval-code peer reads.\n```"
