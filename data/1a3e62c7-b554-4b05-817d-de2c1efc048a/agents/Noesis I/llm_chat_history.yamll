- text: "`/execute_action{goto research}`\n`/execute_action{storage write noesis/compare_utils.py}`\n```yaml\ncontent: |\n  import os\n  import json\n\n  def read_active_pairs_csv(path):\n      pairs = set()\n      try:\n          with open(path, 'r') as f:\n              header = f.readline()\n              for line in f:\n                  parts = line.strip().split(',')\n                  if len(parts) < 3:\n                      continue\n                  i, j = int(parts[0]), int(parts[1])\n                  # store undirected edge as sorted tuple\n                  if i > j:\n                      i, j = j, i\n                  pairs.add((i, j))\n      except Exception:\n          return None\n      return pairs\n\n  def read_active_boundary_csv(path):\n      bset = set()\n      try:\n          with open(path, 'r') as f:\n              header = f.readline()\n              for line in f:\n                  parts = line.strip().split(',')\n                  if len(parts) < 3:\n    \
    \                  continue\n                  i = int(parts[0]); kind = parts[1]\n                  bset.add((i, kind))\n      except Exception:\n          return None\n      return bset\n\n  def jaccard(a, b):\n      if a is None or b is None or len(a) == 0 and len(b) == 0:\n          return None\n      inter = a & b\n      union = a | b\n      if len(union) == 0:\n          return 1.0\n      return len(inter) / len(union), len(inter), len(union)\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Compare active sets with Aletheia I (tol=1e-8, no-op packing)\"\ntags: \"analysis, contact-graph, jaccard, no-op\"\nabstract: \"Reads my active sets and, if present, Aletheia’s active sets from lineage storage at tol=1e-8, computes Jaccard overlap for pairs and boundary constraints, and writes results to storage/noesis/exports/. Returns the saved best packing unchanged.\"\ncontent: |\n  import os\n  import json\n  import numpy as np\n  import sys\n\n  N = 26\n\n  sys.path.append('storage/noesis')\n\
    \  try:\n      from compare_utils import read_active_pairs_csv, read_active_boundary_csv, jaccard\n  except Exception:\n      read_active_pairs_csv = None\n      read_active_boundary_csv = None\n      jaccard = None\n\n  def load_saved_best():\n      try:\n          c = np.loadtxt('storage/noesis/latest_centers.txt')\n          r = np.loadtxt('storage/noesis/latest_radii.txt')\n          c = np.array(c, dtype=float).reshape(N, 2)\n          r = np.array(r, dtype=float).reshape(N,)\n          return c, r\n      except Exception:\n          return None, None\n\n  def grid_plus_hole_seed(r0=0.1 - 1e-8, eps=1e-8):\n      coords = [0.1, 0.3, 0.5, 0.7, 0.9]\n      centers = [[x, y] for x in coords for y in coords]\n      d = float(np.linalg.norm(np.array([0.2,0.2]) - np.array([0.1,0.1])))\n      radii = [float(r0)] * 25 + [float(d - r0 - eps)]\n      return np.array(centers, dtype=float), np.array(radii, dtype=float)\n\n  def construct_packing():\n      centers, radii = load_saved_best()\n\
    \      if centers is None:\n          centers, radii = grid_plus_hole_seed()\n\n      results = {\n          'status': 'ok',\n          'note': 'Comparing active sets at tol=1e-8 if both lineages’ files are present.',\n          'paths': {}\n      }\n\n      try:\n          os.makedirs('storage/noesis/exports', exist_ok=True)\n      except Exception:\n          pass\n\n      if read_active_pairs_csv is not None:\n          # My files\n          mine_pairs_path = 'storage/noesis/exports/active_pairs_tol1e8.csv'\n          mine_bdry_path  = 'storage/noesis/exports/active_boundary_tol1e8.csv'\n          # Aletheia’s files (read-only)\n          their_pairs_path = 'storage/aletheia/active_pairs_tol1e8.csv'\n          their_bdry_path  = 'storage/aletheia/active_boundary_tol1e8.csv'\n\n          results['paths'] = {\n              'mine_pairs': mine_pairs_path,\n              'mine_boundary': mine_bdry_path,\n              'their_pairs': their_pairs_path,\n              'their_boundary': their_bdry_path,\n\
    \          }\n\n          mine_pairs = read_active_pairs_csv(mine_pairs_path)\n          mine_bdry  = read_active_boundary_csv(mine_bdry_path)\n          their_pairs = read_active_pairs_csv(their_pairs_path)\n          their_bdry  = read_active_boundary_csv(their_bdry_path)\n\n          comp = {}\n\n          if mine_pairs is not None and their_pairs is not None:\n              jc, inter, uni = jaccard(mine_pairs, their_pairs)\n              comp['pairs'] = {\n                  'mine_count': len(mine_pairs),\n                  'their_count': len(their_pairs),\n                  'jaccard': jc,\n                  'intersection': inter,\n                  'union': uni\n              }\n          else:\n              comp['pairs'] = {'available': False}\n\n          if mine_bdry is not None and their_bdry is not None:\n              jc_b, inter_b, uni_b = jaccard(mine_bdry, their_bdry)\n              comp['boundary'] = {\n                  'mine_count': len(mine_bdry),\n                \
    \  'their_count': len(their_bdry),\n                  'jaccard': jc_b,\n                  'intersection': inter_b,\n                  'union': uni_b\n              }\n          else:\n              comp['boundary'] = {'available': False}\n\n          try:\n              with open('storage/noesis/exports/jaccard_tol1e8.json', 'w') as f:\n                  json.dump({'results': results, 'comparison': comp}, f, indent=2)\n          except Exception:\n              pass\n\n      return centers.astype(float), radii.astype(float)\n```\n\n`/execute_action{storage write noesis/notes.md}`\n```yaml\ncontent: |\n  Tick 46 — Jaccard comparison pipeline\n  - Added compare_utils.py and a no-op submission that reads:\n    * mine: storage/noesis/exports/active_pairs_tol1e8.csv, active_boundary_tol1e8.csv\n    * theirs: storage/aletheia/active_pairs_tol1e8.csv, active_boundary_tol1e8.csv (if present)\n  - It writes storage/noesis/exports/jaccard_tol1e8.json with counts and Jaccard overlaps.\n  - Awaiting\
    \ Aletheia's index files for a high-level, code-free structural comparison.\n```"
