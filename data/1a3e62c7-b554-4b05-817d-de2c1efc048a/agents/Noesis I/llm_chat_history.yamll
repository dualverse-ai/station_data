- text: "`/execute_action{goto research}`\n`/execute_action{storage write noesis/analyze_contacts.py}`\n```yaml\ncontent: |\n  import os\n  import numpy as np\n\n  def compute_slacks(centers, radii):\n      centers = np.asarray(centers, dtype=float)\n      radii = np.asarray(radii, dtype=float)\n      n = centers.shape[0]\n      x = centers[:, 0]\n      y = centers[:, 1]\n      r = radii\n      # Boundary slacks\n      s_xL = x - r\n      s_xR = 1.0 - x - r\n      s_yB = y - r\n      s_yT = 1.0 - y - r\n      # Pairwise slacks\n      diff = centers[:, None, :] - centers[None, :, :]\n      dist = np.sqrt(np.sum(diff**2, axis=2))\n      s_pairs = dist - (r[:, None] + r[None, :])\n      return (s_xL, s_xR, s_yB, s_yT), s_pairs\n\n  def active_sets(centers, radii, tol=1e-9):\n      (s_xL, s_xR, s_yB, s_yT), s_pairs = compute_slacks(centers, radii)\n      n = len(radii)\n      boundary_actives = []\n      for i in range(n):\n          if s_xL[i] <= tol: boundary_actives.append((int(i), 'xL',\
    \ float(s_xL[i])))\n          if s_xR[i] <= tol: boundary_actives.append((int(i), 'xR', float(s_xR[i])))\n          if s_yB[i] <= tol: boundary_actives.append((int(i), 'yB', float(s_yB[i])))\n          if s_yT[i] <= tol: boundary_actives.append((int(i), 'yT', float(s_yT[i])))\n      pair_actives = []\n      for i in range(n):\n          for j in range(i+1, n):\n              v = s_pairs[i, j]\n              if v <= tol:\n                  pair_actives.append((int(i), int(j), float(v)))\n      return boundary_actives, pair_actives\n\n  def report(centers, radii, path='storage/noesis/contact_report.txt', tol=1e-9):\n      centers = np.asarray(centers, dtype=float)\n      radii = np.asarray(radii, dtype=float)\n      n = centers.shape[0]\n      (s_xL, s_xR, s_yB, s_yT), s_pairs = compute_slacks(centers, radii)\n      boundary_actives, pair_actives = active_sets(centers, radii, tol=tol)\n\n      # Degree from pair actives\n      deg = np.zeros(n, dtype=int)\n      for (i, j, _) in pair_actives:\n\
    \          deg[i] += 1\n          deg[j] += 1\n\n      # Top-10 smallest pair slacks (over all pairs, not just actives)\n      iu = np.triu_indices(n, 1)\n      spu = s_pairs[iu]\n      order = np.argsort(spu)[:10]\n      top10 = []\n      for k in order:\n          i = int(iu[0][k]); j = int(iu[1][k])\n          top10.append({'i': i, 'j': j, 'slack': float(spu[k])})\n\n      lines = []\n      lines.append(f\"Contact Report (tolerance={tol})\")\n      lines.append(f\"Number of circles: {n}\")\n      lines.append(f\"Boundary actives: {len(boundary_actives)}\")\n      lines.append(f\"Pair actives: {len(pair_actives)}\")\n      lines.append(\"\")\n      lines.append(\"Boundary contacts:\")\n      for (i, kind, slack) in boundary_actives:\n          lines.append(f\"  Circle {i}, {kind}, slack={slack:.12e}\")\n      lines.append(\"\")\n      lines.append(\"Pair contacts:\")\n      for (i, j, slack) in pair_actives:\n          lines.append(f\"  Circles ({i},{j}), slack={slack:.12e}\")\n\n\
    \      try:\n          os.makedirs(os.path.dirname(path), exist_ok=True)\n          with open(path, 'w') as f:\n              f.write(\"\\n\".join(lines) + \"\\n\")\n      except Exception:\n          pass\n\n      return {\n          'boundary_actives': boundary_actives,\n          'pair_actives': pair_actives,\n          'degree': deg,\n          'top10_pair_slacks': top10\n      }\n```\n\n`/execute_action{storage write noesis/compare_utils.py}`\n```yaml\ncontent: |\n  import os, csv, json, math\n  import numpy as np\n\n  def _boundary_slacks(centers, radii):\n      c = np.asarray(centers, float)\n      r = np.asarray(radii, float)\n      x = c[:,0]; y = c[:,1]\n      return x - r, 1.0 - x - r, y - r, 1.0 - y - r\n\n  def _pair_slacks(centers, radii):\n      c = np.asarray(centers, float)\n      r = np.asarray(radii, float)\n      diff = c[:, None, :] - c[None, :, :]\n      dist = np.sqrt(np.sum(diff**2, axis=2))\n      return dist - (r[:, None] + r[None, :])\n\n  def _active_sets_direct(centers,\
    \ radii, tol):\n      s_xL, s_xR, s_yB, s_yT = _boundary_slacks(centers, radii)\n      sp = _pair_slacks(centers, radii)\n      n = len(radii)\n      b = []\n      for i in range(n):\n          if s_xL[i] <= tol: b.append((int(i), 'xL', float(s_xL[i])))\n          if s_xR[i] <= tol: b.append((int(i), 'xR', float(s_xR[i])))\n          if s_yB[i] <= tol: b.append((int(i), 'yB', float(s_yB[i])))\n          if s_yT[i] <= tol: b.append((int(i), 'yT', float(s_yT[i])))\n      p = []\n      for i in range(n):\n          for j in range(i+1, n):\n              if sp[i, j] <= tol:\n                  p.append((int(i), int(j), float(sp[i, j])))\n      return b, p, sp\n\n  def _tol_tag(tol: float) -> str:\n      # hyphenless tag like '1e8' for 1e-8\n      try:\n          e = int(round(math.log10(tol)))\n          return f'1e{abs(e)}'\n      except Exception:\n          return '1e8'\n\n  def _save_set_csv(items, path):\n      os.makedirs(os.path.dirname(path), exist_ok=True)\n      with open(path,\
    \ 'w', newline='') as f:\n          wr = csv.writer(f)\n          for it in items:\n              wr.writerow(list(it))\n\n  def compute_and_export_from_pack(centers, radii, tol=1e-8, out_dir='storage/noesis/exports'):\n      # Direct computation (no external deps), robust to lineage changes\n      n = len(radii)\n      b_acts, p_acts, sp = _active_sets_direct(centers, radii, tol)\n      b_set = set((i, kind) for (i, kind, _) in b_acts)\n      p_set = set((min(i, j), max(i, j)) for (i, j, _) in p_acts)\n      # Degree\n      degree = np.zeros(n, dtype=int)\n      for (i, j, _) in p_acts:\n          degree[i] += 1\n          degree[j] += 1\n      # Top-10 smallest pair slacks (all pairs)\n      iu = np.triu_indices(n, 1)\n      spu = sp[iu]\n      order = np.argsort(spu)[:10]\n      top10 = [{'i': int(iu[0][k]), 'j': int(iu[1][k]), 'slack': float(spu[k])} for k in order]\n\n      tag = _tol_tag(tol)\n      os.makedirs(out_dir, exist_ok=True)\n      # Contact report\n      with open(os.path.join(out_dir,\
    \ 'contact_report.txt'), 'w') as f:\n          f.write(f\"Contact Report (tolerance={tol})\\n\")\n          f.write(f\"Number of circles: {n}\\n\")\n          f.write(f\"Boundary actives: {len(b_acts)}\\n\")\n          f.write(f\"Pair actives: {len(p_acts)}\\n\\n\")\n          f.write(\"Boundary contacts:\\n\")\n          for (i, kind, slack) in b_acts:\n              f.write(f\"  Circle {i}, {kind}, slack={slack:.12e}\\n\")\n          f.write(\"\\nPair contacts:\\n\")\n          for (i, j, slack) in p_acts:\n              f.write(f\"  Circles ({i},{j}), slack={slack:.12e}\\n\")\n\n      # CSV exports\n      _save_set_csv(sorted(list(b_set)), os.path.join(out_dir, f'active_boundary_tol{tag}.csv'))\n      _save_set_csv(sorted(list(p_set)), os.path.join(out_dir, f'active_pairs_tol{tag}.csv'))\n\n      # Degree histogram as dict of str->count (to ensure JSON keys serializable)\n      hist = {}\n      binc = np.bincount(degree)\n      for k, v in enumerate(binc):\n          if v > 0:\n \
    \             hist[str(k)] = int(v)\n\n      # Summary JSON matching the accepted debugger format\n      summary = {\n          \"tolerance\": tol,\n          \"sum_radii\": float(np.sum(radii)),\n          \"active_boundary_count\": len(b_set),\n          \"active_pair_count\": len(p_set),\n          \"degree_histogram\": hist,\n          \"top10_pair_slacks\": top10\n      }\n      with open(os.path.join(out_dir, f\"summary_tol{tag}.json\"), 'w') as f:\n          json.dump(summary, f, indent=2)\n\n      return b_set, p_set\n```\n\n`/execute_action{goto private_memory}`\n`/execute_action{reply 1}`\n```yaml\ncontent: |\n  Tick 76 — Analyzer/exports made robust to lineage drift\n  - Restored analyze_contacts.report(...) with consistent outputs (actives, degree, top10 pair slacks, contact_report.txt).\n  - Rewrote compare_utils.compute_and_export_from_pack to be self-contained (no AC dependency) and to emit the debugger’s accepted summary schema:\n      {tolerance, sum_radii, active_boundary_count,\
    \ active_pair_count, degree_histogram, top10_pair_slacks}\n  - This prevents future auto-debugger patches and keeps filenames stable (summary_tol1e8.json, active_{boundary,pairs}_tol1e8.csv, contact_report.txt).\n  - No new experiments launched; exports can be refreshed by rerunning the analysis-only submission if needed.\n```"
