- text: "I have drafted the paper for my new SOTA. Now I must conduct the ablation studies I outlined to provide the rigorous evidence required for publication.\n\n**Ablation Study 1:** This experiment will test the impact of the expanded jitter amplitudes while using the original, smaller set of 8 hole locations. This will help determine if the new jitter levels alone are responsible for the improvement.\n\nI will go to the Research Counter and submit this first ablation study.\n\n/execute_action{goto research}\n\n/execute_action{submit 1}\n```yaml\ntitle: \"Ablation Study 1: Original Holes, Expanded Jitter\"\ntags: \"ablation-study, sota-analysis, slsqp, jitter\"\nabstract: |\n  This is the first of two ablation studies supporting the new SOTA (Eval 298). This experiment uses the original 8 hole locations from the Noesis/Scientia method but applies the expanded set of 8 jitter amplitudes from my SOTA-achieving run. The goal is to isolate the effect of the finer-grained jitter search and\
    \ determine its contribution to the improved score.\ncontent: |\n  import numpy as np\n  from scipy.optimize import minimize\n  import math\n\n  N = 26\n  R_MIN = 1e-6\n  SAFETY = 1e-9\n\n  def cr_to_z(centers, radii):\n      z = np.zeros(N * 3)\n      z[0::3] = centers[:, 0]; z[1::3] = centers[:, 1]; z[2::3] = radii\n      return z\n\n  def z_to_cr(z):\n      centers = np.vstack((z[0::3], z[1::3])).T\n      radii = z[2::3]\n      return centers, radii\n\n  def _generate_seed(hole_cx, hole_cy, jitter_amp, seed):\n      np.random.seed(seed)\n      coords = [0.1, 0.3, 0.5, 0.7, 0.9]\n      grid_centers = np.array([[x, y] for x in coords for y in coords])\n      hole_center = np.array([hole_cx, hole_cy])\n      base_centers = np.vstack([grid_centers, hole_center])\n      jitter = np.random.uniform(-jitter_amp, jitter_amp, size=base_centers.shape)\n      perturbed_centers = np.clip(base_centers + jitter, 1e-6, 1 - 1e-6)\n      initial_radii = np.full(N, 0.05)\n      return cr_to_z(perturbed_centers,\
    \ initial_radii)\n\n  def objective(z): return -np.sum(z[2::3])\n  def objective_jac(z):\n      g = np.zeros_like(z); g[2::3] = -1.0; return g\n\n  def ineq_boundary(z):\n      x, y, r = z[0::3], z[1::3], z[2::3]\n      return np.concatenate([x - r, 1.0 - x - r, y - r, 1.0 - y - r])\n  def jac_boundary(z):\n      J = np.zeros((4*N, 3*N));\n      for i in range(N):\n          xi, yi, ri = 3*i, 3*i+1, 3*i+2\n          J[i, xi] = 1.0; J[i, ri] = -1.0; J[N+i, xi] = -1.0; J[N+i, ri] = -1.0\n          J[2*N+i, yi] = 1.0; J[2*N+i, ri] = -1.0; J[3*N+i, yi] = -1.0; J[3*N+i, ri] = -1.0\n      return J\n\n  def ineq_nonoverlap(z):\n      centers, r = z_to_cr(z)\n      diff = centers[:, None, :] - centers[None, :, :]\n      dist = np.sqrt(np.sum(diff**2, axis=2))\n      iu = np.triu_indices(N, 1); return dist[iu] - (r[iu[0]] + r[iu[1]])\n  def jac_nonoverlap(z):\n      centers, _ = z_to_cr(z)\n      m = N*(N-1)//2; J = np.zeros((m, 3*N)); k = 0\n      for i in range(N):\n          for j in range(i+1,\
    \ N):\n              xi, yi, ri = 3*i, 3*i+1, 3*i+2; xj, yj, rj = 3*j, 3*j+1, 3*j+2\n              dx = centers[i,0] - centers[j,0]; dy = centers[i,1] - centers[j,1]\n              d = math.hypot(dx, dy); invd = 1.0 / d if d > 1e-12 else 0.0\n              J[k, xi] = dx * invd; J[k, yi] = dy * invd; J[k, ri] = -1.0\n              J[k, xj] = -dx * invd; J[k, yj] = -dy * invd; J[k, rj] = -1.0\n              k += 1\n      return J\n\n  def _ensure_validity(centers, radii):\n      for i in range(N): radii[i] = min(radii[i], centers[i,0], 1-centers[i,0], centers[i,1], 1-centers[i,1])\n      for _ in range(10):\n          violations = 0\n          for i in range(N):\n              for j in range(i + 1, N):\n                  dist = np.linalg.norm(centers[i] - centers[j])\n                  rad_sum = radii[i] + radii[j]\n                  if dist < rad_sum:\n                      violations += 1\n                      if rad_sum > 0: scale = (dist / rad_sum) * (1.0-SAFETY); radii[i] *= scale;\
    \ radii[j] *= scale\n          if violations == 0: break\n      return centers, np.maximum(radii, 0)\n\n  def construct_packing() -> tuple:\n      # Ablation 1: Original 8 holes, but expanded 8 jitters\n      hole_locations = [(0.2,0.2), (0.2,0.4), (0.4,0.2), (0.4,0.4), (0.6,0.6), (0.8,0.8), (0.8,0.6), (0.6,0.8)]\n      jitter_amplitudes = [1.0e-3, 2.0e-3, 3.0e-3, 4.0e-3, 5.0e-3, 6.0e-3, 7.0e-3, 8.0e-3]\n      \n      best_score = -1\n      best_packing = (None, None)\n      \n      bounds = []\n      for i in range(N): bounds.extend([(0,1), (0,1), (R_MIN, 0.5)])\n      constraints = [\n          {'type': 'ineq', 'fun': ineq_boundary, 'jac': jac_boundary},\n          {'type': 'ineq', 'fun': ineq_nonoverlap, 'jac': jac_nonoverlap},\n      ]\n\n      run_idx = 0\n      # Total runs: 8 * 8 = 64\n      for hole_cx, hole_cy in hole_locations:\n          for jitter_amp in jitter_amplitudes:\n              run_idx += 1\n              seed = int(hole_cx*1000 + hole_cy*1000 + jitter_amp*10000)\
    \ + run_idx + 5000\n              initial_z = _generate_seed(hole_cx, hole_cy, jitter_amp, seed)\n              \n              res = minimize(objective, initial_z, method='SLSQP', jac=objective_jac,\n                             bounds=bounds, constraints=constraints,\n                             options={'maxiter': 400, 'ftol': 1e-9})\n              \n              if res.success and -res.fun > best_score:\n                  best_score = -res.fun\n                  centers, radii = z_to_cr(res.x)\n                  best_packing = (centers, radii)\n\n      if best_packing[0] is None: return None, None\n\n      final_centers, final_radii = _ensure_validity(best_packing[0], best_packing[1])\n      return final_centers, final_radii\n```"
