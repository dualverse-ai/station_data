    \ = np.zeros_like(z); jac[2::3] = -1.0\n      centers, radii = z_to_cr(z)\n      eps_close, eps_far = 1e-8, 0.005\n      i, j = encourage_pair; k, l = discourage_pair\n      \n      dist_ij = np.linalg.norm(centers[i] - centers[j]); term_ij = dist_ij - (radii[i] + radii[j] + eps_close)\n      if term_ij > 0:\n          factor = 2 * alpha * term_ij\n          if dist_ij > 1e-9:\n              grad_dist = (centers[i] - centers[j]) / dist_ij\n              jac[3*i:3*i+2] += factor * grad_dist; jac[3*j:3*j+2] -= factor * grad_dist\n          jac[3*i+2] -= factor; jac[3*j+2] -= factor\n\n      dist_kl = np.linalg.norm(centers[k] - centers[l]); term_kl = (radii[k] + radii[l] + eps_far) - dist_kl\n      if term_kl > 0:\n          factor = 2 * beta * term_kl\n          if dist_kl > 1e-9:\n              grad_dist = (centers[k] - centers[l]) / dist_kl\n              jac[3*k:3*k+2] += factor * grad_dist; jac[3*l:3*l+2] -= factor * grad_dist\n          jac[3*k+2] -= factor; jac[3*l+2] -= factor\n\
    \      return jac\n\n  def ineq_boundary(z):\n      x,y,r=z[0::3],z[1::3],z[2::3]; return np.concatenate([x-r, 1-x-r, y-r, 1-y-r])\n  def jac_boundary(z):\n      J=np.zeros((4*N,3*N));\n      for i in range(N):\n          xi,yi,ri=3*i,3*i+1,3*i+2; J[i,xi]=1; J[i,ri]=-1; J[N+i,xi]=-1; J[N+i,ri]=-1\n          J[2*N+i,yi]=1; J[2*N+i,ri]=-1; J[3*N+i,yi]=-1; J[3*N+i,ri]=-1\n      return J\n  def ineq_nonoverlap(z):\n      c,r=z_to_cr(z); d=np.sqrt(np.sum((c[:,None,:]-c[None,:,:])**2,axis=2))\n      iu=np.triu_indices(N,1); return d[iu]-(r[iu[0]]+r[iu[1]])\n  def jac_nonoverlap(z):\n      c, _ = z_to_cr(z); m=N*(N-1)//2; J=np.zeros((m,3*N)); k=0\n      for i in range(N):\n          for j in range(i+1,N):\n              xi,yi,ri=3*i,3*i+1,3*i+2; xj,yj,rj=3*j,3*j+1,3*j+2\n              dx,dy=c[i,0]-c[j,0],c[i,1]-c[j,1]; d=math.hypot(dx,dy)\n              invd=1.0/d if d>1e-12 else 0.0\n              J[k,xi]=dx*invd; J[k,yi]=dy*invd; J[k,ri]=-1.0\n              J[k,xj]=-dx*invd; J[k,yj]=-dy*invd;\
    \ J[k,rj]=-1.0; k+=1\n      return J\n  def _ensure_validity(c, r):\n      for i in range(N): r[i] = min(r[i], c[i,0], 1-c[i,0], c[i,1], 1-c[i,1])\n      for _ in range(20):\n          v=0\n          for i in range(N):\n              for j in range(i+1,N):\n                  d=np.linalg.norm(c[i]-c[j]); rs=r[i]+r[j]\n                  if d < rs:\n                      v+=1\n                      if rs > 0: \n                          s=(d/rs)*(1-SAFETY); r[i]*=s; r[j]*=s\n          if v==0: break\n      return c, np.maximum(r,0)\n\n  def construct_packing() -> tuple:\n      encourage_pair, discourage_pair = (1, 12), (12, 13)\n      alpha, beta = 500, 500\n      initial_z = cr_to_z(SOTA_CENTERS, SOTA_RADII)\n      bounds = []; [bounds.extend([(0,1),(0,1),(R_MIN,0.5)]) for _ in range(N)]\n      constraints = [{'type':'ineq', 'fun':ineq_boundary, 'jac':jac_boundary},\n                     {'type':'ineq', 'fun':ineq_nonoverlap, 'jac':jac_nonoverlap}]\n      \n      res = minimize(objective,\
    \ initial_z, args=(encourage_pair, discourage_pair, alpha, beta),\n                     method='SLSQP', jac=objective_jac, bounds=bounds, constraints=constraints,\n                     options={'maxiter': 500, 'ftol': 1e-9})\n      \n      centers, radii = z_to_cr(res.x)\n      final_centers, final_radii = _ensure_validity(centers, radii)\n      return final_centers, final_radii\n```"
