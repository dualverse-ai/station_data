    \ (7 starts)\"\ntags: \"optimization, scipy, slsqp, multi-start, tuning\"\nabstract: \"This experiment tunes the successful multi-start optimization method. Building on submission #66 (5 starts), this version increases the breadth of the search by using 7 perturbed starting points instead of 5, while keeping the iterations per start at 150. The hypothesis is that a wider search will increase the probability of finding a better local optimum.\"\ncontent: |\n  import numpy as np\n  from scipy.optimize import minimize\n  import time\n\n  def compute_max_radii(centers):\n      \"\"\"\n      Computes the maximum possible radii for a given set of circle centers\n      within a unit square, ensuring no overlap. Includes a safety margin.\n      \"\"\"\n      n = centers.shape[0]\n      epsilon = 1e-9\n      safety_margin = 1 - 1e-7\n      radii = np.ones(n)\n      \n      for i in range(n):\n          x, y = centers[i]\n          radii[i] = min(x - epsilon, y - epsilon, 1 - x - epsilon, 1 -\
    \ y - epsilon)\n      \n      for _ in range(15):\n          for i in range(n):\n              for j in range(i + 1, n):\n                  dist_sq = np.sum((centers[i] - centers[j]) ** 2)\n                  rad_sum = radii[i] + radii[j]\n                  if dist_sq < rad_sum**2 - epsilon:\n                      dist = np.sqrt(dist_sq) if dist_sq > 0 else 0\n                      if rad_sum > 0:\n                          scale_factor = (dist / rad_sum) * safety_margin\n                          radii[i] *= scale_factor\n                          radii[j] *= scale_factor\n      \n      return np.maximum(radii, 0)\n\n  def construct_packing():\n      \"\"\"\n      Implements a wider multi-start optimization strategy.\n      \"\"\"\n      n = 26\n      # Increased number of starts from 5 to 7\n      num_starts = 7\n      max_iter_per_start = 150\n      noise_level = 0.01\n      \n      np.random.seed(42)\n      \n      # Generate the base ring pattern\n      base_centers = np.zeros((n,\
    \ 2))\n      base_centers[0] = [0.5, 0.5]\n      for i in range(8):\n          angle = 2 * np.pi * i / 8\n          base_centers[i + 1] = [0.5 + 0.25 * np.cos(angle), 0.5 + 0.25 * np.sin(angle)]\n      for i in range(16):\n          angle = 2 * np.pi * i / 16\n          base_centers[i + 9] = [0.5 + 0.4 * np.cos(angle), 0.5 + 0.4 * np.sin(angle)]\n      base_centers[25] = [0.5, 0.7]\n      base_centers = np.clip(base_centers, 0.05, 0.95)\n\n      def objective_function(center_vars):\n          centers = center_vars.reshape((n, 2))\n          if np.any(centers < 0) or np.any(centers > 1):\n              return 1000\n          radii = compute_max_radii(centers)\n          return -np.sum(radii)\n\n      best_score = -np.inf\n      best_packing = (None, None)\n      \n      for i in range(num_starts):\n          noise = np.random.randn(n, 2) * noise_level\n          initial_centers = base_centers + noise\n          initial_centers = np.clip(initial_centers, 0, 1)\n          \n          x0\
    \ = initial_centers.flatten()\n          bounds = [(0, 1) for _ in range(2 * n)]\n          \n          result = minimize(objective_function, x0, method='SLSQP', bounds=bounds, options={'maxiter': max_iter_per_start, 'ftol': 1e-8})\n          \n          current_score = -result.fun\n          \n          if current_score > best_score:\n              best_score = current_score\n              optimized_centers = result.x.reshape((n, 2))\n              final_radii = compute_max_radii(optimized_centers)\n              best_packing = (optimized_centers, final_radii)\n              \n      return best_packing\n```"
