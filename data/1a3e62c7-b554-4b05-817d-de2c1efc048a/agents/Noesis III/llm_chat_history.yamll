parts:
- text: "/execute_action{storage write noesis/pack/active_quench_adaptive.py}\n\n```yaml\ncontent: |\n  import numpy as np, time, math, glob, os\n  from sa_lp_exact_params import solve_radii_lp, hex_centers_26, clamp01\n  import active_quench as AQ\n\n  # ----------------------------\n  # Utilities\n  # ----------------------------\n  def pair_slacks(centers, r):\n      diff = centers[:, None, :] - centers[None, :, :]\n      D = np.sqrt(np.sum(diff**2, axis=-1))\n      return D - (r[:, None] + r[None, :])\n\n  def find_best_npz(runs_dir):\n      files = sorted(glob.glob(os.path.join(runs_dir, \"polished_*.npz\")))\n      best = None; best_S = -1.0\n      for fp in files:\n          try:\n              with np.load(fp, allow_pickle=False) as f:\n                  C = f[\"centers\"].astype(float)\n                  r = f[\"radii\"].astype(float)\n                  S = float(np.array(f[\"score\"]).reshape(-1)[0]) if \"score\" in f.files else float(np.sum(r))\n              if C.shape == (26,2)\
    \ and r.shape == (26,) and S > best_S:\n                  best = (fp, C, r, S); best_S = S\n          except Exception:\n              continue\n      return best\n\n  class EMA:\n      def __init__(self, alpha):\n          self.alpha = float(alpha)\n          self.val = None\n      def update(self, x):\n          x = float(x)\n          if self.val is None:\n              self.val = x\n          else:\n              self.val = self.alpha * x + (1 - self.alpha) * self.val\n          return self.val\n\n  # ----------------------------\n  # Feasibility finalizer (pair + boundary safety)\n  # ----------------------------\n  def finalize_feasible(centers, r, pair_eps=2e-8, boundary_eps=2e-9, max_passes=6):\n      \"\"\"Project radii to satisfy boundary and pair constraints with small safety margins.\"\"\"\n      r = np.array(r, dtype=float, copy=True)\n      # Boundary clamp\n      x, y = centers[:, 0], centers[:, 1]\n      b = np.minimum.reduce([x, 1.0 - x, y, 1.0 - y])\n      r = np.minimum(r,\
    \ b - boundary_eps)\n      r = np.maximum(r, 1e-12)\n      n = len(r)\n      # Pairwise tighten iteratively\n      for _ in range(max_passes):\n          sl = pair_slacks(centers, r) - pair_eps  # enforce small positive slack\n          I, J = np.triu_indices(n, 1)\n          neg_mask = sl[I, J] < 0.0\n          if not np.any(neg_mask):\n              break\n          dI = I[neg_mask]; dJ = J[neg_mask]\n          delta = np.zeros(n, dtype=float)\n          for i, j in zip(dI, dJ):\n              over = -sl[i, j]  # amount to fix\n              d = 0.5 * over\n              delta[i] += d\n              delta[j] += d\n          r -= delta\n          # Recheck boundaries and positivity\n          r = np.minimum(r, b - boundary_eps)\n          r = np.maximum(r, 1e-12)\n      return r\n\n  def slack_frontier_mean(centers, r_current=None, K=128, pair_eps=2e-8, boundary_eps=2e-9):\n      \"\"\"Compute mean of K smallest pair slacks using radii consistent with feasibility.\"\"\"\n      # Prefer\
    \ the current radii if provided (keeps consistency with safe solver inside quench)\n      if r_current is None:\n          # Fallback to LP, but finalize for safety\n          r_lp, S_lp, _ = solve_radii_lp(centers)\n          r_safe = finalize_feasible(centers, r_lp, pair_eps=pair_eps, boundary_eps=boundary_eps)\n          r_use, S_use = r_safe, float(np.sum(r_safe))\n      else:\n          r_use = finalize_feasible(centers, r_current, pair_eps=pair_eps, boundary_eps=boundary_eps)\n          S_use = float(np.sum(r_use))\n      sl = pair_slacks(centers, r_use)\n      # Flatten upper triangle slacks\n      n = sl.shape[0]\n      vals = [float(sl[i, j]) for i in range(n) for j in range(i+1, n)]\n      vals.sort()\n      KK = min(K, len(vals))\n      meanK = float(np.mean(vals[:KK])) if KK > 0 else 0.0\n      return meanK, r_use, S_use\n\n  # ----------------------------\n  # Adaptive strict finalize\n  # ----------------------------\n  def adaptive_finalize(total_sec=1200.0, seed=20251205,\
    \ segment_sec=30.0,\n                        eta_S=5e-6, eta_slack=1e-7, gamma_alpha=0.6, dK=12,\n                        k_pairs_init=176, alpha0_init=1.2e-4, boundary_push_init=0.64,\n                        boundary_push_min=0.58, pair_eps=2e-8, boundary_eps=2e-9):\n      rng = np.random.default_rng(seed)\n      # Start from best artifact if available; else hex grid\n      runs_dir = os.path.join(\"storage\", \"noesis\", \"pack\", \"runs\")\n      best = find_best_npz(runs_dir)\n      if best is not None:\n          _, centers, r, S = best\n      else:\n          centers = clamp01(hex_centers_26())\n          r, S, _ = solve_radii_lp(centers)\n          r = finalize_feasible(centers, r, pair_eps=pair_eps, boundary_eps=boundary_eps)\n          S = float(np.sum(r))\n\n      # Initial metrics\n      slack_mean, r, S = slack_frontier_mean(centers, r, K=128, pair_eps=pair_eps, boundary_eps=boundary_eps)\n\n      # EMAs over segment rates (Δ per second)\n      ema_S = EMA(alpha=0.95)  \
    \    # ~10 s memory if segment_sec≈30 s\n      ema_slack = EMA(alpha=0.95)\n\n      k_pairs = int(k_pairs_init)\n      alpha0 = float(alpha0_init)\n      boundary_push = float(boundary_push_init)\n\n      end_time = time.time() + float(total_sec)\n      seg_id = 0\n      while time.time() < end_time:\n          seg_budget = min(segment_sec, max(0.0, end_time - time.time()))\n          if seg_budget <= 0.0:\n              break\n          # Pre-segment state\n          S0 = S\n          slack0 = slack_mean\n\n          # Run one strict quench segment (uses safe radii internally)\n          centers, r, S = AQ.active_pair_quench(\n              centers, budget_sec=float(seg_budget), seed=int(seed + 1 + seg_id),\n              k_pairs=int(k_pairs), alpha0=float(alpha0),\n              backtrack=0.5, alpha_min=1e-6, boundary_push=float(boundary_push)\n          )\n          # Post-segment metrics using current radii (keep consistency)\n          slack_mean, r, S = slack_frontier_mean(centers,\
    \ r, K=128, pair_eps=pair_eps, boundary_eps=boundary_eps)\n\n          # Rates\n          dS = S - S0\n          dSlack = slack0 - slack_mean  # reduction in mean(top-128) slack\n          rate_S = dS / max(1e-9, seg_budget)\n          rate_slack = dSlack / max(1e-9, seg_budget)\n\n          rS = ema_S.update(rate_S)\n          rSL = ema_slack.update(rate_slack)\n\n          # Transition logic (deterministic thresholds)\n          plateau = (rS < eta_S) or (rSL < eta_slack)\n          if plateau:\n              alpha0 = max(alpha0 * float(gamma_alpha), 1e-6)\n              k_pairs = int(min(288, k_pairs + int(dK)))\n              if rSL < eta_slack and boundary_push > boundary_push_min:\n                  boundary_push = max(boundary_push_min, boundary_push * 0.95)\n\n          seg_id += 1\n\n      # Final strict feasibility polish\n      r = finalize_feasible(centers, r, pair_eps=pair_eps, boundary_eps=boundary_eps)\n      S = float(np.sum(r))\n      return centers, r, S\n```\n\n\n\
    /execute_action{submit 1}\n\n```yaml\ntitle: \"Adaptive strict finalize v2 — LP-consistent segment metrics + strict finalize (20 min)\"\ntags: \"optimization, finalize, lp, exact, adaptive, schedule\"\nabstract: \"Fixes v0 instability by evaluating progress with the same safe radii used inside quench and applying a strict feasibility finalizer (pair_eps=2e−8, boundary_eps=2e−9) at segment boundaries and at the end. Deterministic 20‑minute controller with EMA‑based transitions.\"\ncontent: |\n  import sys, numpy as np\n  sys.path.append('storage/noesis/pack')\n  import active_quench_adaptive as AD\n\n  def construct_packing():\n      C, r, S = AD.adaptive_finalize(\n          total_sec=1200.0,\n          seed=20251205,\n          segment_sec=30.0,\n          eta_S=5e-6,\n          eta_slack=1e-7,\n          gamma_alpha=0.6,\n          dK=12,\n          k_pairs_init=176,\n          alpha0_init=1.2e-4,\n          boundary_push_init=0.64,\n          boundary_push_min=0.58,\n          pair_eps=2e-8,\n\
    \          boundary_eps=2e-9\n      )\n      # Validity checks\n      assert C.shape == (26,2) and r.shape == (26,)\n      assert np.all(r > 0)\n      x, y = C[:,0], C[:,1]\n      b = np.minimum.reduce([x, 1-x, y, 1-y])\n      assert np.all(r <= b + 1e-9)\n      # Pairwise slack check (conservative)\n      diff = C[:,None,:] - C[None,:,:]\n      D = np.sqrt(np.sum(diff**2, axis=-1))\n      assert np.all(D + 2e-12 >= (r[:,None] + r[None,:]))\n      return C, r\n```"
