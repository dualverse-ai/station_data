tick: 693
role: model
parts:
- text: "Noesis III in Research Counter. Recent: strict finalize polish achieved Σr=2.570645 (Eval 1158); 4-stage micro-step quench (Eval 1163) running. Appendix E v2.1 ingest for Noesis III Eval1127 completed (1155). Next: check 1163 result; add rank-correlation analysis utility for pair slacks.\n\nExecuting actions now.\n\n/execute_action{review 1163}\n/execute_action{storage list noesis/pack/runs}\n/execute_action{submit 1}\n\n```yaml\ntitle: \"Appendix E v2.1 — Pair‑slack rank correlations (Noesis III Eval1127 vs Quest latest)\"\ntags: \"analysis, appendix-e, rank-correlation, sets-only\"\nabstract: \"Computes Spearman rank correlations between full interior pair slacks from Noesis III Eval1127 and Quest II's latest packing (if available). Writes results into noesis/nmap/results and appends status. Returns a valid trivial packing.\"\ncontent: |\n  import os, json, datetime, numpy as np\n\n  def utc_now():\n      return datetime.datetime.utcnow().strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n \
    \ def ensure_dir(p):\n      os.makedirs(p, exist_ok=True)\n\n  def read_json(path):\n      with open(path, \"r\", encoding=\"utf-8\") as f:\n          return json.load(f)\n\n  def append_status(path, lines):\n      ensure_dir(os.path.dirname(path))\n      with open(path, \"a\", encoding=\"utf-8\") as f:\n          f.write(lines)\n\n  def load_pairs_sorted(path, key_sorted=\"pairs_sorted\", key_unsorted=\"pairs_unsorted\"):\n      if not os.path.exists(path):\n          return None\n      d = read_json(path)\n      rows = None\n      if key_sorted in d and isinstance(d[key_sorted], list):\n          rows = d[key_sorted]\n      elif key_unsorted in d and isinstance(d[key_unsorted], list):\n          rows = d[key_unsorted]\n      else:\n          # heuristic: find list of triples\n          for v in d.values():\n              if isinstance(v, list) and v and isinstance(v[0], (list,tuple)) and len(v[0]) >= 3:\n                  rows = v\n                  break\n      if rows is None:\n\
    \          return None\n      # normalize to (i<j, slack)\n      pairs = {}\n      for it in rows:\n          if len(it) < 3: \n              continue\n          i, j, s = int(it[0]), int(it[1]), float(it[2])\n          if i == j: \n              continue\n          if i > j: \n              i, j = j, i\n          pairs[(i, j)] = s\n      return pairs\n\n  def rank_array(x):\n      # Returns average ranks for ties (dense ranking not required); O(n log n)\n      idx = np.argsort(x, kind=\"mergesort\")\n      ranks = np.empty_like(idx, dtype=float)\n      ranks[idx] = np.arange(1, len(x)+1, dtype=float)\n      # tie handling: average ranks for equal values\n      # find blocks of equal x in the sorted order\n      xs = x[idx]\n      start = 0\n      n = len(x)\n      while start < n:\n          end = start + 1\n          while end < n and xs[end] == xs[start]:\n              end += 1\n          if end - start > 1:\n              avg = (start + 1 + end) / 2.0\n              ranks[idx[start:end]]\
    \ = avg\n          start = end\n      return ranks\n\n  def spearman_rho(a, b):\n      # Both 1D arrays of same length\n      if len(a) == 0:\n          return None\n      ra = rank_array(a.astype(float))\n      rb = rank_array(b.astype(float))\n      a0 = ra - ra.mean()\n      b0 = rb - rb.mean()\n      denom = np.sqrt((a0*a0).sum() * (b0*b0).sum())\n      return float((a0*b0).sum() / denom) if denom > 0 else None\n\n  def construct_packing():\n      ts = utc_now()\n      shared = os.path.join(\"storage\", \"shared\", \"appxE_contribs\")\n      out_root = os.path.join(\"storage\", \"noesis\", \"nmap\")\n      results_dir = os.path.join(out_root, \"results\")\n      ensure_dir(results_dir)\n      status_path = os.path.join(out_root, \"AGGREGATOR_v2_1_STATUS.md\")\n\n      # Inputs\n      noesis_pairs_path = os.path.join(shared, \"noesis_III_eval1127_pair_slacks_all.json\")\n      quest_pairs_path  = os.path.join(shared, \"quest_II_latest_pair_slacks_all.json\")  # as agreed in mail\n\
    \n      N = 26\n      # Load pair slacks\n      noesis_pairs = load_pairs_sorted(noesis_pairs_path)\n      quest_pairs  = load_pairs_sorted(quest_pairs_path) if os.path.exists(quest_pairs_path) else None\n\n      res = {\n          \"version\": \"v2.1\",\n          \"timestamp_utc\": ts,\n          \"noesis_source\": noesis_pairs_path if os.path.exists(noesis_pairs_path) else None,\n          \"quest_source\": quest_pairs_path if os.path.exists(quest_pairs_path) else None,\n          \"N\": N\n      }\n\n      if noesis_pairs is None:\n          append_status(status_path, f\"\\n[{ts}] ERROR: Noesis III pair slacks not found or invalid at {noesis_pairs_path}\\n\")\n      elif quest_pairs is None:\n          append_status(status_path, f\"\\n[{ts}] INFO: Quest II latest pair slacks not present yet; will recompute on arrival.\\n\")\n      else:\n          # Align on common pairs (should be all 325 if both identity maps)\n          keys = sorted(set(noesis_pairs.keys()) & set(quest_pairs.keys()))\n\
    \          x = np.array([noesis_pairs[k] for k in keys], dtype=float)\n          y = np.array([quest_pairs[k] for k in keys], dtype=float)\n          rho = spearman_rho(x, y)\n          res.update({\n              \"pair_count\": len(keys),\n              \"spearman_rho\": rho,\n              \"keys_checked\": len(keys)\n          })\n          # Save detailed sample of top/bottom slacks for diagnostics\n          order_noesis = np.argsort(x)\n          order_quest  = np.argsort(y)\n          res[\"diagnostics\"] = {\n              \"noesis_top5_pairs_smallest_slack\": [list(map(int, keys[i])) + [float(x[i])] for i in order_noesis[:5]],\n              \"quest_top5_pairs_smallest_slack\":  [list(map(int, keys[i])) + [float(y[i])] for i in order_quest[:5]]\n          }\n\n      out_path = os.path.join(results_dir, \"noesisIII_vs_quest_latest_pair_slack_rankcorr.json\")\n      with open(out_path, \"w\", encoding=\"utf-8\") as f:\n          json.dump(res, f, ensure_ascii=False, indent=2,\
    \ sort_keys=True)\n\n      # Return a trivial valid packing\n      centers, radii = [], []\n      r = 0.06\n      for i in range(5):\n          for j in range(6):\n              if len(centers) < 26:\n                  centers.append([0.1 + 0.2*i, 0.1 + 0.15*j]); radii.append(r)\n      return np.array(centers, float), np.array(radii, float)\n```"
