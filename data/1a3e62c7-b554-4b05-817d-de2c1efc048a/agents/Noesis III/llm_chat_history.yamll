parts:
- text: "/execute_action{storage write noesis/pack/active_quench.py}\n\n```yaml\ncontent: |\n  import numpy as np, time\n  from scipy.optimize import linprog\n\n  # Robust LP solver with safety margins on pair constraints and boundary bounds\n  def solve_radii_lp_safe(centers, r_min=1e-6, eps_pair=2e-8):\n      n = centers.shape[0]\n      # Boundary upper bounds per disk\n      x = centers[:, 0]; y = centers[:, 1]\n      b = np.minimum.reduce([x, 1.0 - x, y, 1.0 - y])\n      # Pairwise distances\n      diff = centers[:, None, :] - centers[None, :, :]\n      D = np.sqrt(np.sum(diff**2, axis=-1))\n      I, J = np.triu_indices(n, 1)\n      m = len(I)\n      A = np.zeros((m, n), dtype=float)\n      A[np.arange(m), I] = 1.0\n      A[np.arange(m), J] = 1.0\n      c = -np.ones(n, dtype=float)  # maximize sum r => minimize -sum r\n      b_pairs = D[I, J] - eps_pair\n      bounds = [(r_min, float(b[i])) for i in range(n)]\n      res = linprog(c, A_ub=A, b_ub=b_pairs, bounds=bounds, method=\"highs\"\
    )\n      if res.success:\n          r = res.x\n          return r, float(r.sum()), True\n      # Fallback: conservative radii\n      nn = (D + np.eye(n)*1e9).min(axis=1)\n      r = np.minimum(0.49 * nn, b) - 1e-6\n      r = np.clip(r, r_min, None)\n      return r, float(r.sum()), False\n\n  def clamp01(centers, pad=1e-6):\n      centers = centers.copy()\n      centers[:, 0] = np.clip(centers[:, 0], pad, 1.0 - pad)\n      centers[:, 1] = np.clip(centers[:, 1], pad, 1.0 - pad)\n      return centers\n\n  def pair_slacks(centers, r):\n      diff = centers[:, None, :] - centers[None, :, :]\n      D = np.sqrt(np.sum(diff**2, axis=-1))\n      sl = D - (r[:, None] + r[None, :])\n      return D, sl\n\n  def nearest_wall_normal(c):\n      x, y = c\n      dists = np.array([x, 1-x, y, 1-y], dtype=float)\n      k = int(np.argmin(dists))\n      if k == 0:  return np.array([+1.0, 0.0])\n      if k == 1:  return np.array([-1.0, 0.0])\n      if k == 2:  return np.array([0.0, +1.0])\n      return np.array([0.0,\
    \ -1.0])\n\n  def finalize_feasible(centers, r, margin=2e-9, iters=200, boundary_margin=2e-12):\n      \"\"\"\n      Make radii strictly feasible by:\n        1) Clamping to boundary with a tiny boundary_margin.\n        2) Iteratively shrinking pairs that violate the pairwise margin.\n      Returns radii that satisfy:\n        r_i <= boundary_i - boundary_margin and\n        r_i + r_j <= d_ij - margin (approximately, after iterations).\n      \"\"\"\n      centers = centers.copy()\n      r = r.copy()\n      n = len(r)\n      # 1) Enforce boundary feasibility first\n      x = centers[:, 0]; y = centers[:, 1]\n      b = np.minimum.reduce([x, 1.0 - x, y, 1.0 - y])\n      r = np.minimum(r, b - boundary_margin)\n      r = np.maximum(r, 1e-12)\n\n      # 2) Fix pairwise slacks iteratively\n      for _ in range(iters):\n          D, sl = pair_slacks(centers, r)\n          np.fill_diagonal(sl, np.inf)\n          m = sl.min()\n          if m >= margin:\n              break\n          i, j =\
    \ np.unravel_index(np.argmin(sl), sl.shape)\n          need = margin - sl[i, j]\n          if need <= 0:\n              break\n          shrink = 0.5 * (need + 1e-12)\n          r[i] = max(r[i] - shrink, 1e-12)\n          r[j] = max(r[j] - shrink, 1e-12)\n\n      # Final boundary clamp in case pair-shrink nudged a radius slightly\n      r = np.minimum(r, b - boundary_margin)\n      r = np.maximum(r, 1e-12)\n      return r\n\n  def active_pair_quench(centers, budget_sec=540.0, seed=123, k_pairs=20,\n                         alpha0=2e-3, backtrack=0.5, alpha_min=1e-6,\n                         boundary_push=0.4, eps_pair=2e-8, finalize_margin=2e-9):\n      \"\"\"\n      Greedy constraint-aware polish with robust LP margins.\n      - Identify top-k tight pairs and tight boundary indices.\n      - Push pairs apart along connecting line; push boundary-disks inward.\n      - All evaluations use solve_radii_lp_safe(eps_pair).\n      - Final radii are feasibility-polished to margin (pairs) and\
    \ boundary.\n      \"\"\"\n      rng = np.random.default_rng(seed)\n      start = time.time()\n      centers = clamp01(centers)\n      r, S, _ = solve_radii_lp_safe(centers, eps_pair=eps_pair)\n      best_C, best_r, best_S = centers.copy(), r.copy(), S\n\n      while True:\n          if time.time() - start > budget_sec:\n              break\n          D, sl = pair_slacks(centers, r)\n          np.fill_diagonal(sl, np.inf)\n          idx = np.unravel_index(np.argsort(sl, axis=None)[:k_pairs], sl.shape)\n          pairs = list(zip(idx[0], idx[1]))\n\n          # boundary tightness by smallest clearance b - r\n          x = centers[:, 0]; y = centers[:, 1]\n          bnd = np.minimum.reduce([x, 1.0-x, y, 1.0-y])\n          bsl = bnd - r\n          tight_bound_ids = list(np.argsort(bsl)[:min(6, len(bsl))])\n\n          improved = False\n          # Pair pushes\n          for (i, j) in pairs:\n              if i == j: continue\n              v = centers[i] - centers[j]\n              norm\
    \ = np.linalg.norm(v)\n              if norm < 1e-12:\n                  v = rng.normal(0.0, 1.0, size=2); norm = np.linalg.norm(v) + 1e-12\n              u = v / norm\n              alpha = alpha0\n              while alpha >= alpha_min:\n                  C2 = centers.copy()\n                  C2[i] = C2[i] + alpha * u\n                  C2[j] = C2[j] - alpha * u\n                  C2 = clamp01(C2)\n                  r2, S2, _ = solve_radii_lp_safe(C2, eps_pair=eps_pair)\n                  if S2 > S + 1e-12:\n                      centers, r, S = C2, r2, S2\n                      if S2 > best_S:\n                          best_C, best_r, best_S = C2.copy(), r2.copy(), S2\n                      improved = True\n                      break\n                  alpha *= backtrack\n              if time.time() - start > budget_sec:\n                  break\n          if time.time() - start > budget_sec:\n              break\n\n          # Boundary pushes\n          for i in tight_bound_ids:\n\
    \              nrm = nearest_wall_normal(centers[i])\n              alpha = boundary_push * alpha0\n              while alpha >= alpha_min:\n                  C2 = centers.copy()\n                  C2[i] = C2[i] + alpha * nrm\n                  C2 = clamp01(C2)\n                  r2, S2, _ = solve_radii_lp_safe(C2, eps_pair=eps_pair)\n                  if S2 > S + 1e-12:\n                      centers, r, S = C2, r2, S2\n                      if S2 > best_S:\n                          best_C, best_r, best_S = C2.copy(), r2.copy(), S2\n                      improved = True\n                      break\n                  alpha *= backtrack\n              if time.time() - start > budget_sec:\n                  break\n\n          if not improved:\n              # small jitter\n              i = int(rng.integers(0, len(centers)))\n              C2 = centers.copy()\n              C2[i] = C2[i] + rng.normal(0.0, alpha0 * 0.25, size=2)\n              C2 = clamp01(C2)\n              r2, S2, _\
    \ = solve_radii_lp_safe(C2, eps_pair=eps_pair)\n              if S2 > S:\n                  centers, r, S = C2, r2, S2\n                  if S2 > best_S:\n                      best_C, best_r, best_S = C2.copy(), r2.copy(), S2\n\n      # Robust finalization: solve with safety margin then polish pairs and boundary\n      r_final, _, _ = solve_radii_lp_safe(best_C, eps_pair=eps_pair)\n      r_final = finalize_feasible(best_C, r_final, margin=finalize_margin, boundary_margin=2e-12)\n      return best_C, r_final, float(r_final.sum())\n```\n\n/execute_action{submit 1}\n\n```yaml\ntitle: \"Polish saved best run with robust active‑pair quench (12m) — internal boundary clamp\"\ntags: \"optimization, linear programming, quench, exact, polish\"\nabstract: \"Loads the best saved Noesis run (exact_portfolio*.npz), then performs a 720s robust active‑pair backtracking quench using the updated internal boundary‑aware finalize. Deterministic seed.\"\ncontent: |\n  import os, glob, numpy as np, sys\n\
    \  sys.path.append('storage/noesis/pack')\n  import active_quench as AQ\n\n  def try_extract(npz):\n      keys = set(npz.files)\n      C = None; r = None; S = None\n      if 'centers' in keys: C = np.array(npz['centers'], dtype=float)\n      if 'C' in keys and C is None: C = np.array(npz['C'], dtype=float)\n      if 'radii' in keys: r = np.array(npz['radii'], dtype=float)\n      if 'r' in keys and r is None: r = np.array(npz['r'], dtype=float)\n      if 'score' in keys:\n          try: S = float(np.array(npz['score']).item())\n          except Exception:\n              S = float(np.array(npz['score']).reshape(-1)[0])\n      if 'S' in keys and S is None:\n          try: S = float(np.array(npz['S']).item())\n          except Exception:\n              S = float(np.array(npz['S']).reshape(-1)[0])\n      return C, r, S\n\n  def load_best_seed():\n      pattern = os.path.join('storage', 'noesis', 'pack', 'runs', '*.npz')\n      files = sorted(glob.glob(pattern))\n      best = None\n      best_S\
    \ = -1.0\n      for fp in files:\n          try:\n              with np.load(fp, allow_pickle=False) as npz:\n                  C, r, S = try_extract(npz)\n              if C is None:\n                  continue\n              if S is None:\n                  r_tmp, S_tmp, _ = AQ.solve_radii_lp_safe(C, eps_pair=1e-12)\n                  r = r if r is not None else r_tmp\n                  S = float(S_tmp)\n              if r is None:\n                  r, S, _ = AQ.solve_radii_lp_safe(C, eps_pair=1e-12)\n              if S > best_S:\n                  best_S = S\n                  best = (C, r, S, fp)\n          except Exception:\n              continue\n      return best\n\n  def construct_packing():\n      seed_tuple = load_best_seed()\n      if seed_tuple is None:\n          # Fallback: hex centers if no saved runs found\n          def hex_centers_26(margin_x=0.04, margin_y=0.06):\n              rows = 5; counts = [6,5,5,5,5]; maxc = max(counts)\n              width_x = 1.0 - 2*margin_x;\
    \ height_y = 1.0 - 2*margin_y\n              sx = width_x / (maxc - 1); sy = min(height_y / (rows - 1), (np.sqrt(3)/2.0) * sx)\n              ctrs = []\n              for r in range(rows):\n                  c = counts[r]; y = margin_y + r * sy\n                  total_w = (c - 1) * sx if c > 1 else 0.0\n                  start = 0.5 - 0.5 * total_w\n                  offset = 0.5 * sx if c < maxc else 0.0\n                  for i in range(c):\n                      x = start + i * sx + offset\n                      ctrs.append([x, y])\n              return np.array(ctrs[:26], dtype=float)\n          C0 = AQ.clamp01(hex_centers_26())\n      else:\n          C0, r0, S0, fp = seed_tuple\n          C0 = AQ.clamp01(C0)\n\n      # Robust active-pair quench for 12 minutes with boundary-aware finalize inside library\n      C_f, r_f, S_f = AQ.active_pair_quench(\n          C0,\n          budget_sec=720.0,\n          seed=20251111,\n          k_pairs=30,\n          alpha0=2e-3,\n          backtrack=0.5,\n\
    \          alpha_min=1e-6,\n          boundary_push=0.4,\n          eps_pair=2e-8,\n          finalize_margin=2e-9\n      )\n\n      # Validity checks\n      assert C_f.shape == (26,2)\n      assert r_f.shape == (26,)\n      assert np.all(r_f > 0)\n      x, y = C_f[:,0], C_f[:,1]\n      b = np.minimum.reduce([x, 1-x, y, 1-y])\n      assert np.all(r_f <= b + 1e-9)\n      return C_f, r_f\n```"
