tick: 666
role: model
parts:
- text: "/execute_action{submit 1}\n\n```yaml\ntitle: \"Exact‑accept SA 8m + staged robust quench 4m (k_pairs: 12→40)\"\ntags: \"optimization, simulated annealing, linear programming, exact, quench\"\nabstract: \"Runs exact‑accept SA for 480s, then a staged 240s robust quench with increasing top‑k tight‑pair backtracking (k_pairs=12,20,30,40) using a safety‑margin LP and final feasibility polish. Deterministic seeds.\"\ncontent: |\n  import numpy as np, sys\n  sys.path.append('storage/noesis/pack')\n  import sa_lp_exact_params as P\n  import active_quench as AQ\n\n  def staged_quench(centers, total_budget=240.0, seed=31415):\n      # Four 60s stages with increasing structural focus (more top‑k pairs)\n      stages = [\n          dict(budget=60.0,  k_pairs=12, alpha0=1.0e-3),\n          dict(budget=60.0,  k_pairs=20, alpha0=1.2e-3),\n          dict(budget=60.0,  k_pairs=30, alpha0=1.5e-3),\n          dict(budget=60.0,  k_pairs=40, alpha0=2.0e-3),\n      ]\n      C, r, S = centers.copy(),\
    \ None, -1.0\n      s = seed\n      for st in stages:\n          C, r, S = AQ.active_pair_quench(\n              C,\n              budget_sec=st[\"budget\"],\n              seed=s,\n              k_pairs=st[\"k_pairs\"],\n              alpha0=st[\"alpha0\"],\n              backtrack=0.5,\n              alpha_min=1e-6,\n              boundary_push=0.4,\n              eps_pair=2e-8,\n              finalize_margin=2e-9\n          )\n          s += 1\n      return C, r, S\n\n  def construct_packing():\n      # Phase 1: exact‑accept SA baseline (8 minutes)\n      centers_sa, radii_sa, score_sa = P.exact_sa_params(\n          budget_sec=480.0,\n          seed=20251101,\n          step0=0.035,\n          ar_lo=0.15, ar_hi=0.30,\n          quench_interval=12.0, quench_tries=60,\n          margins=(0.04, 0.06),\n          two_phase=True,\n          step_minmax_phase1=(0.005, 0.08),\n          step_minmax_phase2=(0.004, 0.04),\n      )\n\n      # Phase 2: staged robust quench (4 minutes total)\n\
    \      C_final, r_final, S_final = staged_quench(centers_sa, total_budget=240.0, seed=20251102)\n\n      # Validity checks\n      assert C_final.shape == (26,2)\n      assert r_final.shape == (26,)\n      assert np.all(r_final > 0)\n      x, y = C_final[:,0], C_final[:,1]\n      b = np.minimum.reduce([x, 1-x, y, 1-y])\n      assert np.all(r_final <= b + 1e-9)\n\n      return C_final, r_final\n```"
