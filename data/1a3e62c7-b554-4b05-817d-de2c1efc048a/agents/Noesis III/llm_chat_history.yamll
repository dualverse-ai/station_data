    \ research}\n/execute_action{submit 1}\n\n```yaml\ntitle: \"Strict finalize 4‑stage micro‑step quench (20 min) targeting >2.571\"\ntags: \"optimization, quench, line-search, lp, exact, schedule\"\nabstract: \"Loads best artifact; runs a 4‑stage strict, constraint‑aware backtracking quench (300s×4) with increasing k_pairs (48→64→80→96) and decreasing α0 (6e−4→4e−4→3e−4→2e−4). Exact LP objective; deterministic seed; returns final packing.\"\ncontent: |\n  import os, glob, numpy as np, sys\n  sys.path.append('storage/noesis/pack')\n  import active_quench as AQ\n  import sa_lp_exact_params as P\n\n  def load_best_npz():\n      runs_dir = os.path.join(\"storage\", \"noesis\", \"pack\", \"runs\")\n      files = sorted(glob.glob(os.path.join(runs_dir, \"polished_*.npz\")))\n      best = None\n      best_S = -1.0\n      for fp in files:\n          try:\n              with np.load(fp, allow_pickle=False) as f:\n                  C = f[\"centers\"].astype(float)\n                  r = f[\"radii\"\
    ].astype(float)\n                  S = float(np.array(f[\"score\"]).reshape(-1)[0]) if \"score\" in f.files else float(np.sum(r))\n              if C.shape == (26,2) and r.shape == (26,) and S > best_S:\n                  best = (fp, C, r, S)\n                  best_S = S\n          except Exception:\n              continue\n      return best\n\n  def construct_packing():\n      seed = 20251113\n      best = load_best_npz()\n      if best is not None:\n          _, C0, r0, S0 = best\n      else:\n          C0, r0, S0 = P.exact_sa_params(budget_sec=360.0, seed=seed)\n\n      # Stage configs: (seconds, k_pairs, alpha0, boundary_push)\n      stages = [\n          (300.0, 48, 6e-4, 0.45),\n          (300.0, 64, 4e-4, 0.50),\n          (300.0, 80, 3e-4, 0.50),\n          (300.0, 96, 2e-4, 0.55),\n      ]\n\n      C, r, S = C0, r0, S0\n      for idx, (sec, k, a0, bpush) in enumerate(stages, 1):\n          C, r, S = AQ.active_pair_quench(\n              C, budget_sec=sec, seed=seed+idx,\n \
    \             k_pairs=k, alpha0=a0, backtrack=0.5, alpha_min=1e-6, boundary_push=bpush\n          )\n\n      # Validity checks\n      assert C.shape == (26,2)\n      assert r.shape == (26,)\n      assert np.all(r > 0)\n      x, y = C[:,0], C[:,1]\n      b = np.minimum.reduce([x, 1-x, y, 1-y])\n      assert np.all(r <= b + 1e-9)\n      return C, r\n```"
