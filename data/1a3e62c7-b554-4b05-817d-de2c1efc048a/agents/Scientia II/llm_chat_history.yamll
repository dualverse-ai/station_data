- text: "I am in the Research Counter. I will now create and save the `exhaustive_local_search.py` script to my lineage storage. This script will perform a multi-start local search, as described in Prometheus I's methodology (Archive ID 19), using the non-penalized objective function. This is a critical component for my new hybrid optimization strategy.\n\n`/execute_action{storage write storage/Scientia/nmap/n26/optimization/exhaustive_local_search.py}`\n```yaml\ncontent: |\n  import numpy as np\n  from scipy.optimize import minimize, Bounds\n  from scipy.spatial.distance import pdist, squareform\n  import os\n\n  # GLOBAL CONSTANTS\n  N = 26\n  TOL = 1e-8\n  R_MIN_CONSTRAINT = 1e-6 \n\n  # Multi-start parameters (from Prometheus I's Archive ID 19)\n  JITTER_AMPLITUDES = [1.0e-3, 2.0e-3, 3.0e-3, 4.0e-3, 5.0e-3, 6.0e-3, 7.0e-3, 8.0e-3]\n  RESTARTS_PER_AMPLITUDE = 5 # Used 5 in Eval ID 416, 5 in Prometheus 298. Sticking to 5.\n\n  # ---------- Feasibility helpers (copied from nudging_optimizer\
    \ for self-containment) ----------\n  def _local_boundary_caps(centers, eps=1e-9, r_min_constraint_val=R_MIN_CONSTRAINT):\n      x = centers[:, 0]; y = centers[:, 1]\n      cap = np.minimum(np.minimum(x, 1.0 - x), np.minimum(y, 1.0 - y)) - eps\n      return np.maximum(cap, r_min_constraint_val)\n\n  def _local_make_feasible(centers, radii, eps=1e-9, max_iter=2000, r_min_constraint_val=R_MIN_CONSTRAINT):\n      n = centers.shape[0]\n      r = np.minimum(radii, _local_boundary_caps(centers, eps=eps, r_min_constraint_val=r_min_constraint_val))\n      r = np.maximum(r, r_min_constraint_val)\n      for _ in range(max_iter):\n          diff = centers[:, None, :] - centers[None, :, :]\n          dist = np.sqrt(np.sum(diff**2, axis=2)) + 1e-15\n          iu = np.triu_indices(n, 1)\n          m = dist[iu] - (r[iu[0]] + r[iu[1]])\n          if np.all(m >= eps):\n              break\n          k = int(np.argmin(m))\n          i = iu[0][k]; j = iu[1][k]\n          need = (r[i] + r[j] - dist[i, j])\
    \ + eps\n          di = min(need * 0.5, r[i] - r_min_constraint_val)\n          dj = min(need - di, r[j] - r_min_constraint_val)\n          if di <= 0 and dj <= 0:\n              r = np.maximum(r * 0.999, r_min_constraint_val)\n          else:\n              r[i] -= di; r[j] -= dj\n          r = np.minimum(r, _local_boundary_caps(centers, eps=eps, r_min_constraint_val=r_min_constraint_val))\n      return centers, r\n\n  # --- Objective and Constraint functions (non-penalized) ---\n  def _objective(x):\n      radii = x[2::3]\n      return -np.sum(radii)\n\n  def _objective_jacobian(x):\n      grad = np.zeros_like(x)\n      grad[2::3] = -1.0\n      return grad\n\n  def _constraints(x):\n      centers = x.reshape(N, 3)[:, :2]\n      radii = x[2::3]\n\n      boundary_constraints = np.empty(4 * N)\n      boundary_constraints[0*N : 1*N] = centers[:, 0] - radii  # x - r >= 0\n      boundary_constraints[1*N : 2*N] = 1.0 - (centers[:, 0] + radii) # 1 - x - r >= 0\n      boundary_constraints[2*N\
    \ : 3*N] = centers[:, 1] - radii  # y - r >= 0\n      boundary_constraints[3*N : 4*N] = 1.0 - (centers[:, 1] + radii) # 1 - y - r >= 0\n\n      dist_matrix = squareform(pdist(centers))\n      overlap_constraints = []\n      for i in range(N):\n          for j in range(i + 1, N):\n              overlap_constraints.append(dist_matrix[i, j] - (radii[i] + radii[j]))\n\n      return np.concatenate((boundary_constraints, overlap_constraints))\n\n  def _constraints_jacobian(x):\n      centers = x.reshape(N, 3)[:, :2]\n      radii = x[2::3]\n      grad = np.zeros((4 * N + N * (N - 1) // 2, N * 3))\n\n      for i in range(N):\n          grad[i, 3*i + 0] = 1.0; grad[i, 3*i + 2] = -1.0\n          grad[N + i, 3*i + 0] = -1.0; grad[N + i, 3*i + 2] = -1.0\n          grad[2*N + i, 3*i + 1] = 1.0; grad[2*N + i, 3*i + 2] = -1.0\n          grad[3*N + i, 3*i + 1] = -1.0; grad[3*N + i, 3*i + 2] = -1.0\n\n      k = 4 * N\n      for i in range(N):\n          for j in range(i + 1, N):\n              diff_centers\
    \ = centers[i] - centers[j]\n              dist_ij = np.linalg.norm(diff_centers)\n              if dist_ij < 1e-10: \n                  dist_ij = 1e-10\n              \n              grad[k, 3*i + 0] = diff_centers[0] / dist_ij\n              grad[k, 3*i + 1] = diff_centers[1] / dist_ij\n              grad[k, 3*j + 0] = -diff_centers[0] / dist_ij\n              grad[k, 3*j + 1] = -diff_centers[1] / dist_ij\n              grad[k, 3*i + 2] = -1.0\n              grad[k, 3*j + 2] = -1.0\n              k += 1\n      return grad\n\n  def run_exhaustive_local_search(base_centers, base_radii):\n      \"\"\"\n      Runs an exhaustive local search (multi-start SLSQP) from a base packing.\n      \n      Args:\n          base_centers (np.ndarray): N x 2 array of base circle centers.\n          base_radii (np.ndarray): N array of base circle radii.\n      \n      Returns:\n          tuple: (optimized_centers, optimized_radii, final_score, success_status)\n      \"\"\"\n      best_score = -np.sum(base_radii)\
    \ # Negative sum for minimization\n      best_centers = base_centers\n      best_radii = base_radii\n      overall_success = False\n\n      for jitter_mag in JITTER_AMPLITUDES:\n          for restart_idx in range(RESTARTS_PER_AMPLITUDE):\n              # Apply perturbation to centers\n              current_centers = base_centers + np.random.uniform(-jitter_mag, jitter_mag, base_centers.shape)\n              current_radii = base_radii \n\n              current_centers = np.clip(current_centers, R_MIN_CONSTRAINT, 1.0 - R_MIN_CONSTRAINT)\n              current_centers, current_radii = _local_make_feasible(current_centers, current_radii, eps=TOL)\n\n              initial_guess = np.zeros(N * 3)\n              initial_guess[0::3] = current_centers[:, 0]\n              initial_guess[1::3] = current_centers[:, 1]\n              initial_guess[2::3] = current_radii\n\n              lower_bounds = np.zeros(N * 3)\n              upper_bounds = np.ones(N * 3)\n              lower_bounds[2::3] =\
    \ R_MIN_CONSTRAINT\n              upper_bounds[2::3] = 0.5 # Max possible radius in unit square\n\n              bounds = Bounds(lower_bounds, upper_bounds)\n              ineq_constraints = {'type': 'ineq', 'fun': _constraints, 'jac': _constraints_jacobian}\n\n              result = minimize(\n                  _objective, \n                  initial_guess,\n                  method='SLSQP',\n                  jac=_objective_jacobian, \n                  bounds=bounds,\n                  constraints=[ineq_constraints],\n                  options={'maxiter': 500, 'ftol': 1e-10, 'disp': False} \n              )\n\n              if result.success and -result.fun > -best_score: \n                  best_score = -result.fun\n                  best_centers = result.x.reshape(N, 3)[:, :2]\n                  best_radii = result.x[2::3]\n                  best_centers, best_radii = _local_make_feasible(best_centers, best_radii, eps=TOL)\n                  overall_success = True # At least one\
    \ run was successful and improved\n      \n      return best_centers, best_radii, -best_score, overall_success # Return actual positive score\n\n\n  def construct_packing() -> tuple:\n      \"\"\"\n      This function serves as the entry point for an evaluation.\n      As this script is a library for exhaustive local search, it returns a trivial packing.\n      \"\"\"\n      centers = np.array([[0.5, 0.5]] * N)\n      radii = np.array([1e-3] * N) # Small radii\n      return centers, radii\n```"
