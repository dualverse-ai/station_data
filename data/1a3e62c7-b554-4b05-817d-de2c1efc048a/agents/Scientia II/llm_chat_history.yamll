    \ to the new SOTA Structural Class (Encourage 14-19 from Eval ID 688) - 3 pair contacts\n  NEW_SOTA_STRUCTURAL_CLASS_14_19_DIR = 'storage/Scientia/nmap/n26/nudging_experiments_encourage_pairs_v8/encourage_14_19'\n  NEW_SOTA_STRUCTURAL_CLASS_14_19_CENTERS = os.path.join(NEW_SOTA_STRUCTURAL_CLASS_14_19_DIR, 'centers.txt')\n  NEW_SOTA_STRUCTURAL_CLASS_14_19_RADII = os.path.join(NEW_SOTA_STRUCTURAL_CLASS_14_19_DIR, 'radii.txt')\n  NEW_SOTA_STRUCTURAL_CLASS_14_19_BOUNDARY_FILE = 'storage/Scientia/nmap/n26/analysis_nudged_encourage_14_19/nudged_encourage_14_19_boundary_contacts.txt'\n  NEW_SOTA_STRUCTURAL_CLASS_14_19_PAIR_FILE = 'storage/Scientia/nmap/n26/analysis_nudged_encourage_14_19/nudged_encourage_14_19_pair_contacts.txt'\n  NEW_SOTA_STRUCTURAL_CLASS_14_19_NAME = 'New_SOTA_Structural_Class_14_19'\n\n  # Paths to the new SOTA Structural Class (Encourage 8-13 from Eval ID 715) - 2 pair contacts\n  NEW_SOTA_STRUCTURAL_CLASS_8_13_DIR = 'storage/Scientia/nmap/n26/nudging_experiments_encourage_pairs_v9/encourage_8_13'\n\
    \  NEW_SOTA_STRUCTURAL_CLASS_8_13_CENTERS = os.path.join(NEW_SOTA_STRUCTURAL_CLASS_8_13_DIR, 'centers.txt')\n  NEW_SOTA_STRUCTURAL_CLASS_8_13_RADII = os.path.join(NEW_SOTA_STRUCTURAL_CLASS_8_13_DIR, 'radii.txt')\n  NEW_SOTA_STRUCTURAL_CLASS_8_13_BOUNDARY_FILE = 'storage/Scientia/nmap/n26/analysis_nudged_encourage_8_13/nudged_encourage_8_13_boundary_contacts.txt'\n  NEW_SOTA_STRUCTURAL_CLASS_8_13_PAIR_FILE = 'storage/Scientia/nmap/n26/analysis_nudged_encourage_8_13/nudged_encourage_8_13_pair_contacts.txt'\n  NEW_SOTA_STRUCTURAL_CLASS_8_13_NAME = 'New_SOTA_Structural_Class_8_13'\n\n\n  # Output directory for Jaccard results\n  JACCARD_RESULTS_DIR = 'storage/Scientia/nmap/n26/jaccard_results_encourage_17_22_comparison'\n\n  def _load_packing_data(centers_path, radii_path, boundary_file, pair_file, packing_name):\n      \"\"\"Helper to load all relevant packing data.\"\"\"\n      centers, radii, boundary_contacts, pair_contacts = None, None, set(), set()\n      try:\n          centers =\
    \ np.loadtxt(centers_path)\n          radii = np.loadtxt(radii_path)\n          boundary_contacts = _read_contact_file(boundary_file)\n          pair_contacts = _read_contact_file(pair_file)\n          print(f\"Loaded all data for {packing_name}.\")\n          return centers, radii, boundary_contacts, pair_contacts\n      except Exception as e:\n          print(f\"Error loading {packing_name} data: {e}. Cannot perform full comparison.\")\n          return None, None, set(), set()\n\n  def construct_packing() -> tuple:\n      \"\"\"\n      Calculates and stores aligned Jaccard similarities for the nudged packing comparison.\n      \"\"\"\n      os.makedirs(JACCARD_RESULTS_DIR, exist_ok=True)\n      results_filepath = os.path.join(JACCARD_RESULTS_DIR, 'jaccard_nudged_encourage_17_22_summary.txt')\n\n      summary_lines = [\"Aligned Jaccard Similarity: Nudged Packing (Encourage 17-22) vs. Key SOTA Variants\\n\"]\n\n      # Load data for the nudged packing (Encourage 17-22)\n      nudged_centers,\
    \ nudged_radii, nudged_boundary, nudged_pair = _load_packing_data(\n          NUDGED_CENTERS, NUDGED_RADII, NUDGED_BOUNDARY_FILE, NUDGED_PAIR_FILE, NUDGED_NAME\n      )\n      if nudged_centers is None:\n          print(f\"Critical error: Failed to load {NUDGED_NAME} data. Cannot proceed.\")\n          return load_packing_data_for_return(NEW_SOTA_STRUCTURAL_CLASS_CENTERS, NEW_SOTA_STRUCTURAL_CLASS_RADII)\n      \n      print(f\"{NUDGED_NAME} boundary contacts: {len(nudged_boundary)}, pair contacts: {len(nudged_pair)}\")\n\n      # Load data for other SOTA variants\n      packings_to_compare = [\n          (NEW_SOTA_STRUCTURAL_CLASS_CENTERS, NEW_SOTA_STRUCTURAL_CLASS_RADII, NEW_SOTA_STRUCTURAL_CLASS_BOUNDARY_FILE, NEW_SOTA_STRUCTURAL_CLASS_PAIR_FILE, NEW_SOTA_STRUCTURAL_CLASS_NAME), # 2 pair\n          (PREVIOUS_SOTA_CENTERS, PREVIOUS_SOTA_RADII, PREVIOUS_SOTA_BOUNDARY_FILE, PREVIOUS_SOTA_PAIR_FILE, PREVIOUS_SOTA_NAME), # 6 pair\n          (BASE_SOTA_CENTERS, BASE_SOTA_RADII, BASE_SOTA_BOUNDARY_FILE,\
    \ BASE_SOTA_PAIR_FILE, BASE_SOTA_NAME), # 7 pair\n          (EXHAUSTIVE_CENTERS, EXHAUSTIVE_RADII, EXHAUSTIVE_BOUNDARY_FILE, EXHAUSTIVE_PAIR_FILE, EXHAUSTIVE_NAME), # 3 pair\n          (NEW_SOTA_STRUCTURAL_CLASS_8_14_CENTERS, NEW_SOTA_STRUCTURAL_CLASS_8_14_RADII, NEW_SOTA_STRUCTURAL_CLASS_8_14_BOUNDARY_FILE, NEW_SOTA_STRUCTURAL_CLASS_8_14_PAIR_FILE, NEW_SOTA_STRUCTURAL_CLASS_8_14_NAME), # 3 pair\n          (NEW_SOTA_STRUCTURAL_CLASS_14_19_CENTERS, NEW_SOTA_STRUCTURAL_CLASS_14_19_RADII, NEW_SOTA_STRUCTURAL_CLASS_14_19_BOUNDARY_FILE, NEW_SOTA_STRUCTURAL_CLASS_14_19_PAIR_FILE, NEW_SOTA_STRUCTURAL_CLASS_14_19_NAME), # 3 pair\n          (NEW_SOTA_STRUCTURAL_CLASS_8_13_CENTERS, NEW_SOTA_STRUCTURAL_CLASS_8_13_RADII, NEW_SOTA_STRUCTURAL_CLASS_8_13_BOUNDARY_FILE, NEW_SOTA_STRUCTURAL_CLASS_8_13_PAIR_FILE, NEW_SOTA_STRUCTURAL_CLASS_8_13_NAME) # 2 pair\n      ]\n\n      for centers_path, radii_path, boundary_file, pair_file, compare_name in packings_to_compare:\n          compare_centers, compare_radii,\
    \ compare_boundary, compare_pair = _load_packing_data(\n              centers_path, radii_path, boundary_file, pair_file, compare_name\n          )\n          if compare_centers is None:\n              print(f\"Warning: Failed to load {compare_name} data. Skipping comparison.\")\n              continue\n\n          j_bound = jaccard_similarity(nudged_boundary, compare_boundary, nudged_centers, compare_centers, aligned=True)\n          j_pair = jaccard_similarity(nudged_pair, compare_pair, nudged_centers, compare_centers, aligned=True)\n          print(f\"Comparison: {NUDGED_NAME} vs {compare_name} (Aligned)\")\n          print(f\"  Boundary Jaccard: {j_bound:.4f}\")\n          print(f\"  Pair Jaccard: {j_pair:.4f}\\n\")\n          summary_lines.append(f\"Comparison: {NUDGED_NAME} vs {compare_name} (Aligned)\\n\")\n          summary_lines.append(f\"  Boundary Jaccard: {j_bound:.4f}\\n\")\n          summary_lines.append(f\"  Pair Jaccard: {j_pair:.4f}\\n\")\n\n      # Write summary to\
    \ a file\n      with open(results_filepath, 'w') as f:\n          f.writelines(summary_lines)\n      print(f\"\\nAligned Jaccard similarity analysis complete. Results saved to {results_filepath}\")\n\n      # Return the current SOTA packing for evaluation\n      return load_packing_data_for_return(NEW_SOTA_STRUCTURAL_CLASS_CENTERS, NEW_SOTA_STRUCTURAL_CLASS_RADII)\n```"
