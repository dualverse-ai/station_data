tick: 389
role: model
parts:
- text: "I am in the Research Counter. I need to initiate the SBRG experiment to investigate Selective Boundary Relaxation from my new SOTA.\n\nI will create a script `sbrg_experiment.py` that loads my current SOTA packing (from Eval ID 528), defines boundary and pairwise constraints, and then attempts to relax a specific boundary constraint (`(0, yB)`) while keeping others as equalities, using SLSQP with a small relaxation budget. This is a direct follow-up to Noesis II's research and a new direction for my hybrid optimization strategy.\n\nI will first save this script to my lineage storage.\n\n`/execute_action{storage write storage/Scientia/nmap/n26/optimization/sbrg_experiment.py}`\n```yaml\ncontent: |\n  import numpy as np\n  from scipy.optimize import minimize, Bounds, LinearConstraint\n  from scipy.spatial.distance import pdist, squareform\n  import os\n\n  # GLOBAL CONSTANTS\n  N = 26\n  TOL = 1e-8 # Tolerance for active contacts/equalities\n  R_MIN_CONSTRAINT = 1e-6\n  RELAXATION_BUDGET\
    \ = 5e-9 # Small budget for boundary relaxation\n\n  # Path to my current SOTA packing (encourage_2_3 from Eval ID 528)\n  SOTA_CENTERS_PATH = 'storage/Scientia/nmap/n26/nudging_experiments_encourage_pairs_v2/encourage_2_3/centers.txt'\n  SOTA_RADII_PATH = 'storage/Scientia/nmap/n26/nudging_experiments_encourage_pairs_v2/encourage_2_3/radii.txt'\n\n  # Output directory for SBRG experiment results\n  SBRG_RESULTS_ROOT_DIR = 'storage/Scientia/nmap/n26/sbrg_experiments'\n\n\n  # ---------- Feasibility helpers (copied for self-containment) ----------\n  def _local_boundary_caps(centers, eps=1e-9, r_min_constraint_val=R_MIN_CONSTRAINT):\n      x = centers[:, 0]; y = centers[:, 1]\n      cap = np.minimum(np.minimum(x, 1.0 - x), np.minimum(y, 1.0 - y)) - eps\n      return np.maximum(cap, r_min_constraint_val)\n\n  def _local_make_feasible(centers, radii, eps=1e-9, max_iter=2000, r_min_constraint_val=R_MIN_CONSTRAINT):\n      n = centers.shape[0]\n      r = np.minimum(radii, _local_boundary_caps(centers,\
    \ eps=eps, r_min_constraint_val=r_min_constraint_val))\n      r = np.maximum(r, r_min_constraint_val)\n      for _ in range(max_iter):\n          diff = centers[:, None, :] - centers[None, :, :]\n          dist = np.sqrt(np.sum(diff**2, axis=2)) + 1e-15\n          iu = np.triu_indices(n, 1)\n          m = dist[iu] - (r[iu[0]] + r[iu[1]])\n          if np.all(m >= eps):\n              break\n          k = int(np.argmin(m))\n          i = iu[0][k]; j = iu[1][k]\n          need = (r[i] + r[j] - dist[i, j]) + eps\n          di = min(need * 0.5, r[i] - r_min_constraint_val)\n          dj = min(need - di, r[j] - r_min_constraint_val)\n          if di <= 0 and dj <= 0:\n              r = np.maximum(r * 0.999, r_min_constraint_val)\n          else:\n              r[i] -= di; r[j] -= dj\n          r = np.minimum(r, _local_boundary_caps(centers, eps=eps, r_min_constraint_val=r_min_constraint_val))\n      return centers, r\n\n  # --- Objective and Constraint functions (non-penalized, for polish)\
    \ ---\n  def _objective(x):\n      radii = x[2::3]\n      return -np.sum(radii)\n\n  def _objective_jacobian(x):\n      grad = np.zeros_like(x)\n      grad[2::3] = -1.0\n      return grad\n\n  # Base inequality constraints (pairwise overlap)\n  def _pairwise_constraints(x):\n      centers = x.reshape(N, 3)[:, :2]\n      radii = x[2::3]\n      dist_matrix = squareform(pdist(centers))\n      overlap_constraints = []\n      for i in range(N):\n          for j in range(i + 1, N):\n              overlap_constraints.append(dist_matrix[i, j] - (radii[i] + radii[j]))\n      return np.array(overlap_constraints)\n\n  def _pairwise_constraints_jacobian(x):\n      centers = x.reshape(N, 3)[:, :2]\n      radii = x[2::3]\n      grad = np.zeros((N * (N - 1) // 2, N * 3))\n      k = 0\n      for i in range(N):\n          for j in range(i + 1, N):\n              diff_centers = centers[i] - centers[j]\n              dist_ij = np.linalg.norm(diff_centers)\n              if dist_ij < 1e-10: \n         \
    \         dist_ij = 1e-10\n              \n              grad[k, 3*i + 0] = diff_centers[0] / dist_ij\n              grad[k, 3*i + 1] = diff_centers[1] / dist_ij\n              grad[k, 3*j + 0] = -diff_centers[0] / dist_ij\n              grad[k, 3*j + 1] = -diff_centers[1] / dist_ij\n              grad[k, 3*i + 2] = -1.0\n              grad[k, 3*j + 2] = -1.0\n              k += 1\n      return grad\n\n\n  def run_sbrg_experiment(base_centers, base_radii, relaxed_boundary_info, budget=RELAXATION_BUDGET):\n      \"\"\"\n      Runs a Selective Boundary Relaxation Gate (SBRG) experiment.\n      \n      Args:\n          base_centers (np.ndarray): N x 2 array of initial circle centers.\n          base_radii (np.ndarray): N array of initial circle radii.\n          relaxed_boundary_info (tuple): (disc_idx, side_str) of the boundary to relax.\n          budget (float): The relaxation budget (delta) for the inequality constraint.\n      \n      Returns:\n          tuple: (optimized_centers,\
    \ optimized_radii, final_score, success_status)\n      \"\"\"\n      # Ensure initial packing is feasible\n      initial_centers, initial_radii = _local_make_feasible(base_centers, base_radii, eps=TOL)\n\n      # Flatten initial guess\n      initial_guess = np.zeros(N * 3)\n      initial_guess[0::3] = initial_centers[:, 0]\n      initial_guess[1::3] = initial_centers[:, 1]\n      initial_guess[2::3] = initial_radii\n\n      # Define bounds for variables\n      lower_bounds = np.zeros(N * 3)\n      upper_bounds = np.ones(N * 3)\n      lower_bounds[2::3] = R_MIN_CONSTRAINT\n      upper_bounds[2::3] = 0.5 # Max possible radius in unit square\n      bounds = Bounds(lower_bounds, upper_bounds)\n\n      # Construct linear equality constraints for *unrelaxed* boundaries\n      # And linear inequality constraint for *relaxed* boundary\n      linear_constraints_matrix = np.zeros((N * 4, N * 3))\n      linear_constraints_lower_bounds = np.zeros(N * 4)\n      linear_constraints_upper_bounds = np.zeros(N\
    \ * 4)\n\n      disc_to_relax, side_to_relax = relaxed_boundary_info\n      relaxed_idx_in_matrix = -1 # To store the index of the relaxed constraint row\n\n      current_row = 0\n      for i in range(N):\n          # x - r >= 0\n          linear_constraints_matrix[current_row, 3*i + 0] = 1.0\n          linear_constraints_matrix[current_row, 3*i + 2] = -1.0\n          if i == disc_to_relax and side_to_relax == \"xL\":\n              linear_constraints_lower_bounds[current_row] = -budget # relaxed to be >= -budget\n              linear_constraints_upper_bounds[current_row] = np.inf\n              relaxed_idx_in_matrix = current_row\n          else:\n              linear_constraints_lower_bounds[current_row] = 0.0\n              linear_constraints_upper_bounds[current_row] = 0.0 # equality\n          current_row += 1\n\n          # 1 - x - r >= 0\n          linear_constraints_matrix[current_row, 3*i + 0] = -1.0\n          linear_constraints_matrix[current_row, 3*i + 2] = -1.0\n       \
    \   if i == disc_to_relax and side_to_relax == \"xR\":\n              linear_constraints_lower_bounds[current_row] = -budget\n              linear_constraints_upper_bounds[current_row] = np.inf\n              relaxed_idx_in_matrix = current_row\n          else:\n              linear_constraints_lower_bounds[current_row] = 0.0\n              linear_constraints_upper_bounds[current_row] = 0.0\n          current_row += 1\n          \n          # y - r >= 0\n          linear_constraints_matrix[current_row, 3*i + 1] = 1.0\n          linear_constraints_matrix[current_row, 3*i + 2] = -1.0\n          if i == disc_to_relax and side_to_relax == \"yB\":\n              linear_constraints_lower_bounds[current_row] = -budget\n              linear_constraints_upper_bounds[current_row] = np.inf\n              relaxed_idx_in_matrix = current_row\n          else:\n              linear_constraints_lower_bounds[current_row] = 0.0\n              linear_constraints_upper_bounds[current_row] = 0.0\n      \
    \    current_row += 1\n\n          # 1 - y - r >= 0\n          linear_constraints_matrix[current_row, 3*i + 1] = -1.0\n          linear_constraints_matrix[current_row, 3*i + 2] = -1.0\n          if i == disc_to_relax and side_to_relax == \"yT\":\n              linear_constraints_lower_bounds[current_row] = -budget\n              linear_constraints_upper_bounds[current_row] = np.inf\n              relaxed_idx_in_matrix = current_row\n          else:\n              linear_constraints_lower_bounds[current_row] = 0.0\n              linear_constraints_upper_bounds[current_row] = 0.0\n          current_row += 1\n\n      # Add linear constraint for boundary conditions\n      boundary_linear_constraint = LinearConstraint(\n          linear_constraints_matrix,\n          linear_constraints_lower_bounds,\n          linear_constraints_upper_bounds\n      )\n\n      # Add non-linear inequality constraints for pairwise overlaps\n      pairwise_ineq_constraint = {'type': 'ineq', 'fun': _pairwise_constraints,\
    \ 'jac': _pairwise_constraints_jacobian}\n\n      # Run optimization\n      result = minimize(\n          _objective, \n          initial_guess,\n          method='SLSQP',\n          jac=_objective_jacobian, \n          bounds=bounds,\n          constraints=[boundary_linear_constraint, pairwise_ineq_constraint],\n          options={'maxiter': 500, 'ftol': 1e-10, 'disp': False} \n      )\n\n      if result.success:\n          optimized_centers = result.x.reshape(N, 3)[:, :2]\n          optimized_radii = result.x[2::3]\n          optimized_centers, optimized_radii = _local_make_feasible(optimized_centers, optimized_radii, eps=TOL)\n          final_score = np.sum(optimized_radii)\n          return optimized_centers, optimized_radii, final_score, True\n      else:\n          return None, None, -1.0, False\n\n\n  def construct_packing() -> tuple:\n      \"\"\"\n      This function serves as the entry point for an evaluation.\n      As this script is a library for SBRG experiments, it returns\
    \ a trivial packing.\n      \"\"\"\n      centers = np.array([[0.5, 0.5]] * N)\n      radii = np.array([1e-3] * N) # Small radii\n      return centers, radii\n```"
