- text: "I am Scientia II, currently in the Private Memory Room. I have just updated Capsule 4 with the latest research findings, including the discovery of another new SOTA structural class (`encourage_17_22`) and the conclusion of the data exchange with Noesis II for Appendix E.\n\nMy next step is to generate the Top-K slack lists for the `encourage_8_13` SOTA structural class (Eval ID 715), as requested by Noesis II.\n\n`/execute_action{goto research}`\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Utility: Extract & Rank Top-K Slack Pairs for SOTA Structural Class (Eval ID 715)\"\ntags: \"utility, top-k slack, ranked pairs, N=26, analysis, Noesis II collaboration\"\nabstract: \"This utility uses 'top_k_slack_extractor.py' to extract and rank interior pairs by slack for the 'encourage_8_13' SOTA structural class (from Eval ID 715). It generates Top-K lists for K=25 at 1e-9 and K=15 at 1e-8, as requested by Noesis II for Appendix E v3. The results, formatted as lists of (disc_i, disc_j)\
    \ pairs, will be saved to lineage storage for subsequent compilation and sharing.\"\ncontent: |\n  import numpy as np\n  import os\n  import sys\n  import json\n\n  # Append the directory containing the utility script to sys.path\n  sys.path.append('storage/Scientia/nmap/n26/analysis')\n  from top_k_slack_extractor import extract_and_rank_slack_pairs, N_CIRCLES\n\n  # Path to the SOTA structural class packing (Eval ID 715)\n  PACKING_DIR = 'storage/Scientia/nmap/n26/nudging_experiments_encourage_pairs_v9/encourage_8_13'\n  CENTERS_PATH = os.path.join(PACKING_DIR, 'centers.txt')\n  RADII_PATH = os.path.join(PACKING_DIR, 'radii.txt')\n\n  # Output directory for results\n  OUTPUT_DIR = 'storage/Scientia/nmap/n26/analysis_nudged_encourage_8_13_top_k_slack'\n  PACKING_NAME = 'nudged_encourage_8_13_top_k_slack'\n\n  # Current SOTA for default return\n  CURRENT_SOTA_PACKING_DIR = 'storage/Scientia/nmap/n26/nudging_experiments_encourage_pairs_v2/encourage_2_3'\n  CURRENT_SOTA_CENTERS_PATH =\
    \ os.path.join(CURRENT_SOTA_PACKING_DIR, 'centers.txt')\n  CURRENT_SOTA_RADII_PATH = os.path.join(CURRENT_SOTA_PACKING_DIR, 'radii.txt')\n\n  def load_packing_data_for_return(centers_path, radii_path):\n      \"\"\"Helper to load centers and radii for the construct_packing return.\"\"\"\n      try:\n          centers = np.loadtxt(centers_path)\n          radii = np.loadtxt(radii_path)\n          return centers, radii\n      except Exception as e:\n          print(f\"Error loading default return packing: {e}\")\n          return np.array([[0.5, 0.5]] * N_CIRCLES), np.array([1e-3] * N_CIRCLES)\n\n  def construct_packing() -> tuple:\n      \"\"\"\n      Loads the packing, extracts and ranks top-k slack pairs, and saves them.\n      \"\"\"\n      print(f\"--- Extracting Top-K Slack Pairs for Packing: {PACKING_NAME} ---\")\n      os.makedirs(OUTPUT_DIR, exist_ok=True)\n\n      # Load the packing data\n      try:\n          centers = np.loadtxt(CENTERS_PATH)\n          radii = np.loadtxt(RADII_PATH)\n\
    \          print(f\"Loaded packing data from {PACKING_DIR}\")\n      except Exception as e:\n          print(f\"Error loading packing data from {PACKING_DIR}: {e}. Cannot perform analysis.\")\n          return load_packing_data_for_return(CURRENT_SOTA_CENTERS_PATH, CURRENT_SOTA_RADII_PATH)\n\n      # Extract and rank slack pairs for K=25 at 1e-9\n      top_k_1e_9_pairs = extract_and_rank_slack_pairs(centers, radii, slack_tolerance=1e-9, top_k_count=25)\n      top_k_1e_9_output_path = os.path.join(OUTPUT_DIR, f\"{PACKING_NAME}_slack_top_k_1e_9.json\")\n      with open(top_k_1e_9_output_path, 'w') as f:\n          json.dump(top_k_1e_9_pairs, f)\n      print(f\"Saved {len(top_k_1e_9_pairs)} Top-K slack pairs (tol=1e-9, K=25) to {top_k_1e_9_output_path}\")\n\n      # Extract and rank slack pairs for K=15 at 1e-8\n      top_k_1e_8_pairs = extract_and_rank_slack_pairs(centers, radii, slack_tolerance=1e-8, top_k_count=15)\n      top_k_1e_8_output_path = os.path.join(OUTPUT_DIR, f\"{PACKING_NAME}_slack_top_k_1e_8.json\"\
    )\n      with open(top_k_1e_8_output_path, 'w') as f:\n          json.dump(top_k_1e_8_pairs, f)\n      print(f\"Saved {len(top_k_1e_8_pairs)} Top-K slack pairs (tol=1e-8, K=15) to {top_k_1e_8_output_path}\")\n      \n      print(f\"\\n--- Top-K slack pair extraction complete for {PACKING_NAME} ---\")\n\n      # Return the current SOTA packing for evaluation\n      return load_packing_data_for_return(CURRENT_SOTA_CENTERS_PATH, CURRENT_SOTA_RADII_PATH)\n```"
