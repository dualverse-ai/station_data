    \  SOTA_RADII_PATH = 'storage/Scientia/nmap/n26/nudging_experiments_encourage_pairs_v2/encourage_2_3/radii.txt'\n\n  # Output directory for results\n  RESULTS_DIR = 'storage/Scientia/nmap/n26/dual_tol_gate_results'\n\n  def _load_packing_data(centers_path, radii_path):\n      \"\"\"Helper to load centers and radii.\"\"\"\n      try:\n          centers = np.loadtxt(centers_path)\n          radii = np.loadtxt(radii_path)\n          return centers, radii\n      except Exception as e:\n          print(f\"Error loading packing data from {centers_path} and {radii_path}: {e}\")\n          return None, None\n\n  def _get_active_boundary_discs(centers, radii, tol):\n      \"\"\"Identifies discs that are active on a boundary.\"\"\"\n      boundary_active_discs = set()\n      for i in range(N):\n          x, y = centers[i]\n          r = radii[i]\n          slacks = [x - r, 1 - (x + r), y - r, 1 - (y + r)]\n          if any(abs(s) < tol for s in slacks):\n              boundary_active_discs.add(i)\n\
    \      return boundary_active_discs\n\n  def _get_interior_pairs_with_slacks(centers, radii, boundary_filter_tol, slack_filter_tol):\n      \"\"\"\n      Identifies all interior pair contacts (slack > slack_filter_tol) and their slacks.\n      Filters out discs active on boundary at boundary_filter_tol.\n      Returns a list of (i, j, slack_value).\n      \"\"\"\n      boundary_active_discs = _get_active_boundary_discs(centers, radii, boundary_filter_tol)\n      \n      interior_pairs_with_slacks = []\n      dist_matrix = squareform(pdist(centers))\n      for i in range(N):\n          for j in range(i + 1, N): # Only check upper triangle\n              if i not in boundary_active_discs and j not in boundary_active_discs: # Ensure both discs are interior\n                  r_sum = radii[i] + radii[j]\n                  dist_ij = dist_matrix[i, j]\n                  slack = dist_ij - r_sum\n                  if slack > slack_filter_tol: # Only include pairs that are not actively touching\
    \ at the given tolerance\n                      interior_pairs_with_slacks.append({\"i\": i, \"j\": j, \"slack\": float(slack)})\n      return interior_pairs_with_slacks\n\n  def _orientation(p, q, r):\n      \"\"\"Determines orientation of (p, q, r) triplet.\"\"\"\n      val = (q[1] - p[1]) * (r[0] - q[0]) - \\\n            (q[0] - p[0]) * (r[1] - q[1])\n      if val == 0: return 0  # Collinear\n      return 1 if val > 0 else 2 # Clockwise or Counterclockwise\n\n  def _on_segment(p, q, r):\n      \"\"\"Checks if point q lies on segment pr.\"\"\"\n      return (q[0] <= max(p[0], r[0]) and q[0] >= min(p[0], r[0]) and\n              q[1] <= max(p[1], r[1]) and q[1] >= min(p[1], r[1]))\n\n  def _do_intersect(p1, q1, p2, q2):\n      \"\"\"Checks if line segment p1q1 and p2q2 intersect.\"\"\"\n      o1 = _orientation(p1, q1, p2)\n      o2 = _orientation(p1, q1, q2)\n      o3 = _orientation(p2, q2, p1)\n      o4 = _orientation(p2, q2, q1)\n\n      # General case\n      if o1 != 0 and o2 !=\
    \ 0 and o3 != 0 and o4 != 0:\n          return True\n\n      # Special Cases (collinear and on segment) - handle endpoints carefully\n      if o1 == 0 and _on_segment(p1, p2, q1): return True\n      if o2 == 0 and _on_segment(p1, q2, q1): return True\n      if o3 == 0 and _on_segment(p2, p1, q2): return True\n      if o4 == 0 and _on_segment(p2, q1, q2): return True\n\n      return False # Doesn't fall in any of the above cases\n\n  def _check_crossing_quads(pair_set, centers):\n      \"\"\"\n      Checks for crossing quads in a set of pairs.\n      Returns True and an example quad if found, else False.\n      \"\"\"\n      pairs_list = list(pair_set)\n      n_pairs = len(pairs_list)\n\n      for i in range(n_pairs):\n          for j in range(i + 1, n_pairs):\n              p1_idx, q1_idx = pairs_list[i]\n              p2_idx, q2_idx = pairs_list[j]\n\n              # Check if disjoint endpoints\n              if len(set([p1_idx, q1_idx, p2_idx, q2_idx])) == 4:\n                  p1_coords\
    \ = centers[p1_idx]\n                  q1_coords = centers[q1_idx]\n                  p2_coords = centers[p2_idx]\n                  q2_coords = centers[q2_idx]\n\n                  if _do_intersect(p1_coords, q1_coords, p2_coords, q2_coords):\n                      return True, (pairs_list[i], pairs_list[j])\n      return False, None\n\n\n  def construct_packing() -> tuple:\n      \"\"\"\n      Runs the dual-tolerance slack-based crossing-gate on Scientia II's SOTA packing.\n      \"\"\"\n      os.makedirs(RESULTS_DIR, exist_ok=True)\n      results_filepath = os.path.join(RESULTS_DIR, 'dual_tol_gate_result.json')\n      \n      centers, radii = _load_packing_data(SOTA_CENTERS_PATH, SOTA_RADII_PATH)\n      if centers is None:\n          print(\"Failed to load SOTA packing data. Cannot run gate check.\")\n          return np.array([[0.5, 0.5]] * N), np.array([1e-3] * N)\n\n      print(f\"--- Running Dual-Tolerance Crossing Gate on Scientia II SOTA (Eval ID 528) ---\")\n      \n      #\
    \ 1. Identify interior pair lists at specified tolerances\n      # Top-K at 1e-9 slack (K=25)\n      all_interior_pairs_1e9 = _get_interior_pairs_with_slacks(centers, radii, TOL_ACTIVE_BOUNDARY, TOL_SLACK_1E9)\n      top_k_1e9_pairs = set(tuple(sorted((p['i'], p['j']))) for p in all_interior_pairs_1e9[:K_1E9])\n      \n      # Top-K at 1e-8 slack (K=15)\n      all_interior_pairs_1e8 = _get_interior_pairs_with_slacks(centers, radii, TOL_ACTIVE_BOUNDARY, TOL_SLACK_1E8)\n      top_k_1e8_pairs = set(tuple(sorted((p['i'], p['j']))) for p in all_interior_pairs_1e8[:K_1E8])\n\n      # 2. Compute intersection C = Top9 ∩ Top8\n      C_intersection = top_k_1e9_pairs.intersection(top_k_1e8_pairs)\n      \n      print(f\"Top-K 1e-9 Pairs (K={K_1E9}): {len(top_k_1e9_pairs)}\")\n      print(f\"Top-K 1e-8 Pairs (K={K_1E8}): {len(top_k_1e8_pairs)}\")\n      print(f\"Intersection C: {len(C_intersection)}\")\n\n      # 3. Check for crossing quads in C\n      gate_sat, example_quad = _check_crossing_quads(C_intersection,\
    \ centers)\n\n      result_summary = {\n          \"eval_id\": 528,\n          \"gate_status\": \"SAT\" if gate_sat else \"UNSAT\",\n          \"top_k_1e9_count\": len(top_k_1e9_pairs),\n          \"top_k_1e8_count\": len(top_k_1e8_pairs),\n          \"intersection_count\": len(C_intersection),\n          \"example_crossing_quad\": example_quad if gate_sat else None\n      }\n\n      print(f\"\\n--- Dual-Tolerance Gate Result: {result_summary['gate_status']} ---\")\n      if gate_sat:\n          print(f\"Example Crossing Quad: {example_quad}\")\n      \n      with open(results_filepath, 'w') as f:\n          json.dump(result_summary, f, indent=2)\n      print(f\"Results saved to {results_filepath}\")\n\n      print(\"\\n--- Dual-Tolerance Gate Check Completed ---\")\n\n      # Return the SOTA packing to satisfy the evaluator\n      return centers, radii\n```"
thinking_content: '**Implementing the Dual-Tolerance Crossing Gate for My SOTA Packing**


  Okay, so the task at hand is to build this utility script to apply Noesis II''s dual-tolerance slack-based crossing-gate to my current State-of-the-Art packing, specifically Eval ID 528. I need a script called `dual_tol_crossing_gate_scientia.py`.


  Here''s how I envision this script working:


  First, I need to load in the center and radius data for my SOTA packing. Then, I''ll define all the necessary constants: `N`, `TOL_1E9`, `TOL_1E8`, `K_1E9`, and `K_1E8`.


  Next, I''ll need some helper functions. `_get_active_boundary_discs(centers, radii, tol)` is crucial for identifying which discs are on the boundary, which I''ll use to filter the pairs. Then, I''ll create `_get_pair_slacks(centers, radii)` to calculate the slack for all pairs of discs.


  `_rank_interior_pairs_by_slack(centers, radii, boundary_filter_tol, slack_rank_tol)` is key. I''ll use it to:


  1.  Filter pairs to be *interior* at a specific tolerance.

  2.  Calculate slacks for the remaining pairs.

  3.  Sort these pairs by slack in ascending order.

  4.  Filter out any pairs with a slack at or below the given tolerance, because they are effectively touching.


  I''ll also need a standard geometric function `_check_segment_intersection(p1, p2, p3, p4)` to check if two line segments cross each other. This is a pretty standard algorithm, nothing too special there.


  Then comes the heart of the check: `_check_crossing_quads(pair_set, centers)`. This function will take a set of pairs and iterate through them, looking for two disjoint pairs whose segments actually intersect, indicating a violation.


  The main `construct_packing` function will be the driver. It will:


  1.  Load the SOTA data.

  2.  Identify discs active on the boundary at `TOL_1E8`.

  3.  Get `Top9` (the top 25 pairs at `TOL_1E9`) and `Top8` (the top 15 pairs at `TOL_1E8`) interior pairs using the helper functions.

  4.  Compute the intersection of `Top9` and `Top8`, calling it `C`.

  5.  Run `_check_crossing_quads(C, centers)` to look for any violations.

  6.  Print whether the result is SAT or UNSAT.

  7.  If it''s SAT, print an example of the crossing.

  8.  Return the SOTA packing for further evaluation.


  I''ll make sure to handle any `NameError` issues by ensuring all necessary helper functions are either imported or defined within the script itself. I''ll probably just include the helpers directly in the script like I''ve done with previous utility scripts to keep it self-contained.


  Finally, I''ll save this script to `storage/Scientia/nmap/n26/analysis/dual_tol_crossing_gate_scientia.py`.

  '
