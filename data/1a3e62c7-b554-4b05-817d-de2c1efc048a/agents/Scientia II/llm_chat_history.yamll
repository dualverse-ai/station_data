- text: "I have saved the `export_for_noesis_ii_v2.py` script. Now, I will submit a new utility evaluation to execute this script, which will re-export my SOTA packing's boundary equalities at `2e-8` tolerance, along with the Top-K slack-based interior pairs, and save it to my lineage storage. This directly addresses Noesis II's refined request.\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Utility: Re-Export Scientia II SOTA Contact Data (Boundary @ 2e-8) for Noesis II Comparative Appendix\"\ntags: \"utility, data export, contact graph, N=26, collaboration, SOTA\"\nabstract: \"This utility re-exports contact data for Scientia II's current SOTA packing (from Eval ID 528, Σr=2.635983) in the sets-only JSON format requested by Noesis II (Archive #21, Appendix B). It specifically provides boundary equalities at a tolerance of `2e-8`, as requested for separating tolerance effects from structural ones. It also includes Top-K interior pairs ranked by slack at tol=1e-9 (K=25) and tol=1e-8 (K=15).\
    \ This data will facilitate further cross-lineage comparison and structural analysis.\"\ncontent: |\n  import numpy as np\n  import os\n  import sys\n  import json\n  from scipy.spatial.distance import pdist, squareform # Make sure these are imported\n\n\n  # GLOBAL CONSTANTS\n  N = 26\n  TOL_1E8 = 1e-8 # Tolerance for active contacts (boundary equalities, interior pairs)\n  TOL_2E8 = 2e-8 # New tolerance for boundary equalities export\n  TOL_1E9 = 1e-9 # Smaller tolerance for slack-based ranking\n  \n  K_1E9 = 25 # Top-K for 1e-9 slack\n  K_1E8 = 15 # Top-K for 1e-8 slack\n\n  # Paths to my current SOTA packing (encourage_2_3 from Eval ID 528)\n  SOTA_PACKING_DIR = 'storage/Scientia/nmap/n26/nudging_experiments_encourage_pairs_v2/encourage_2_3'\n  SOTA_CENTERS_PATH = os.path.join(SOTA_PACKING_DIR, 'centers.txt')\n  SOTA_RADII_PATH = os.path.join(SOTA_PACKING_DIR, 'radii.txt')\n\n  # Output directory for exported data for Noesis II\n  EXPORT_DIR = 'storage/Scientia/nmap/n26/exports_for_noesis_ii'\n\
    \n  def _load_packing_data(centers_path, radii_path):\n      \"\"\"Helper to load centers and radii.\"\"\"\n      try:\n          centers = np.loadtxt(centers_path)\n          radii = np.loadtxt(radii_path)\n          return centers, radii\n      except Exception as e:\n          print(f\"Error loading packing data from {centers_path} and {radii_path}: {e}\")\n          return None, None\n\n  def _get_active_boundary_contacts_and_slacks(centers, radii, tol): # Use parameter 'tol'\n      \"\"\"\n      Identifies active boundary contacts (equalities) and their slacks at a given tolerance.\n      Returns a list of (circle_idx, boundary_side_str, slack_value)\n      \"\"\"\n      boundary_contacts = []\n      for i in range(N):\n          x, y = centers[i]\n          r = radii[i]\n          slacks = {\n              \"xL\": x - r,\n              \"xR\": 1 - (x + r),\n              \"yB\": y - r,\n              \"yT\": 1 - (y + r)\n          }\n          for side, slack in slacks.items():\n\
    \              if abs(slack) < tol:\n                  boundary_contacts.append({\"disc\": i, \"side\": side, \"slack\": float(slack)})\n      # Sort for consistent output\n      return sorted(boundary_contacts, key=lambda c: (c['disc'], c['side']))\n\n  def _get_interior_pair_contacts_and_slacks(centers, radii, tol_boundary_filter=TOL_1E8, tol_slack_filter=TOL_1E9): # Added filters\n      \"\"\"\n      Identifies all interior pair contacts (slack > 0) and their slacks.\n      Returns a list of (circle_idx1, circle_idx2, slack_value).\n      Filters out discs active on boundary at tol_boundary_filter.\n      Only includes pairs that are not actively touching at tol_slack_filter.\n      \"\"\"\n      boundary_active_discs = set()\n      for i in range(N):\n          x, y = centers[i]\n          r = radii[i]\n          slacks = [x - r, 1 - (x + r), y - r, 1 - (y + r)]\n          if any(abs(s) < tol_boundary_filter for s in slacks):\n              boundary_active_discs.add(i)\n\n      interior_pairs_with_slacks\
    \ = []\n      dist_matrix = squareform(pdist(centers))\n      for i in range(N):\n          for j in range(i + 1, N): # Only check upper triangle\n              if i not in boundary_active_discs and j not in boundary_active_discs: # Ensure both discs are interior\n                  r_sum = radii[i] + radii[j]\n                  dist_ij = dist_matrix[i, j]\n                  slack = dist_ij - r_sum\n                  if slack > tol_slack_filter: # Only include pairs that are not actively touching at the tighter tolerance\n                      all_interior_pairs_with_slacks.append({\"i\": i, \"j\": j, \"slack\": float(slack)})\n      # Sort by slack for ranking\n      return sorted(interior_pairs_with_slacks, key=lambda p: p['slack'])\n\n\n  def construct_packing() -> tuple:\n      \"\"\"\n      Extracts and formats SOTA packing data (boundary equalities at 2e-8, Top-K slack-based interior pairs)\n      for Noesis II's comparative appendix.\n      \"\"\"\n      os.makedirs(EXPORT_DIR,\
    \ exist_ok=True)\n      \n      centers, radii = _load_packing_data(SOTA_CENTERS_PATH, SOTA_RADII_PATH)\n      if centers is None:\n          print(\"Failed to load SOTA packing data. Cannot export for Noesis II.\")\n          return np.array([[0.5, 0.5]] * N), np.array([1e-3] * N)\n\n      current_eval_id = 528 # The Eval ID that produced this SOTA packing\n      \n      # --- A. Boundary Equalities (JSON) at TOL_2E8 ---\n      boundary_equalities_2e8 = _get_active_boundary_contacts_and_slacks(centers, radii, tol=TOL_2E8)\n      boundary_output_2e8 = {\n          \"eval_id\": current_eval_id,\n          \"boundary_equalities\": [{\"disc\": c['disc'], \"side\": c['side']} for c in boundary_equalities_2e8],\n          \"tolerance\": str(TOL_2E8)\n      }\n      boundary_filepath_2e8 = os.path.join(EXPORT_DIR, f'scientia_sota_{current_eval_id}_boundary_equalities_tol_2e8.json')\n      with open(boundary_filepath_2e8, 'w') as f:\n          json.dump(boundary_output_2e8, f, indent=2)\n \
    \     print(f\"Exported {len(boundary_equalities_2e8)} boundary equalities at tol 2e-8 to {boundary_filepath_2e8}\")\n\n      # --- B. Interior Pair Rankings (slack-based, JSON) ---\n      # For now, use the same interior pair logic from previous export (tol_1e8 for filtering boundary-active discs)\n      # Re-calculating slacks to ensure they are based on the *optimized* packing\n      # Use `_get_interior_pair_contacts_and_slacks` with appropriate filters\n      all_interior_pairs_with_slacks_sorted_1e9 = _get_interior_pair_contacts_and_slacks(centers, radii, tol_boundary_filter=TOL_1E8, tol_slack_filter=TOL_1E9)\n      all_interior_pairs_with_slacks_sorted_1e8 = _get_interior_pair_contacts_and_slacks(centers, radii, tol_boundary_filter=TOL_1E8, tol_slack_filter=TOL_1E8)\n      \n      # Top-K for 1e-9 slack\n      top_k_1e9_pairs = all_interior_pairs_with_slacks_sorted_1e9[:K_1E9]\n      pairs_1e9_output = {\n          \"eval_id\": current_eval_id,\n          \"method\": \"slack\"\
    ,\n          \"tol\": \"1e-9\",\n          \"K\": K_1E9,\n          \"pairs\": [[p['i'], p['j']] for p in top_k_1e9_pairs]\n      }\n      pairs_1e9_filepath = os.path.join(EXPORT_DIR, f'scientia_sota_{current_eval_id}_top_k_slack_1e9.json')\n      with open(pairs_1e9_filepath, 'w') as f:\n          json.dump(pairs_1e9_output, f, indent=2)\n      print(f\"Re-exported Top-{K_1E9} interior pairs (slack 1e-9) to {pairs_1e9_filepath}\")\n\n      # Top-K for 1e-8 slack\n      top_k_1e8_pairs = all_interior_pairs_with_slacks_sorted_1e8[:K_1E8]\n      pairs_1e8_output = {\n          \"eval_id\": current_eval_id,\n          \"method\": \"slack\",\n          \"tol\": \"1e-8\",\n          \"K\": K_1E8,\n          \"pairs\": [[p['i'], p['j']] for p in top_k_1e8_pairs]\n      }\n      pairs_1e8_filepath = os.path.join(EXPORT_DIR, f'scientia_sota_{current_eval_id}_top_k_slack_1e8.json')\n      with open(pairs_1e8_filepath, 'w') as f:\n          json.dump(pairs_1e8_output, f, indent=2)\n      print(f\"\
    Re-exported Top-{K_1E8} interior pairs (slack 1e-8) to {pairs_1e8_filepath}\")\n\n\n      print(\"\\n--- Data export for Noesis II complete ---\")\n\n      # Return the current SOTA packing to satisfy the evaluator\n      return centers, radii\n```"
