    \  \"i\": 20,\n      \"kind\": \"xmax\"\n    },\n    {\n      \"i\": 21,\n      \"kind\": \"xmax\"\n    },\n    {\n      \"i\": 22,\n      \"kind\": \"xmax\"\n    },\n    {\n      \"i\": 23,\n      \"kind\": \"xmax\"\n    },\n    {\n      \"i\": 24,\n      \"kind\": \"xmax\"\n    },\n    {\n      \"i\": 0,\n      \"kind\": \"ymin\"\n    },\n    {\n      \"i\": 5,\n      \"kind\": \"ymin\"\n    },\n    {\n      \"i\": 10,\n      \"kind\": \"ymin\"\n    },\n    {\n      \"i\": 15,\n      \"kind\": \"ymin\"\n    },\n    {\n      \"i\": 20,\n      \"kind\": \"ymin\"\n    },\n    {\n      \"i\": 4,\n      \"kind\": \"ymax\"\n    },\n    {\n      \"i\": 9,\n      \"kind\": \"ymax\"\n    },\n    {\n      \"i\": 14,\n      \"kind\": \"ymax\"\n    },\n    {\n      \"i\": 19,\n      \"kind\": \"ymax\"\n    },\n    {\n      \"i\": 24,\n      \"kind\": \"ymax\"\n    }\n  ],\n  \"pairs_core\": [\n    {\n      \"i\": 0,\n      \"j\": 1\n    },\n    {\n      \"i\": 0,\n      \"j\": 5\n    },\n    {\n\
    \      \"i\": 0,\n      \"j\": 6\n    },\n    {\n      \"i\": 1,\n      \"j\": 2\n    },\n    {\n      \"i\": 1,\n      \"j\": 6\n    },\n    {\n      \"i\": 1,\n      \"j\": 25\n    },\n    {\n      \"i\": 2,\n      \"j\": 3\n    },\n    {\n      \"i\": 2,\n      \"j\": 7\n    },\n    {\n      \"i\": 2,\n      \"j\": 8\n    },\n    {\n      \"i\": 2,\n      \"j\": 25\n    },\n    {\n      \"i\": 3,\n      \"j\": 4\n    },\n    {\n      \"i\": 3,\n      \"j\": 8\n    },\n    {\n      \"i\": 4,\n      \"j\": 8\n    },\n    {\n      \"i\": 4,\n      \"j\": 9\n    },\n    {\n      \"i\": 5,\n      \"j\": 6\n    },\n    {\n      \"i\": 5,\n      \"j\": 10\n    },\n    {\n      \"i\": 6,\n      \"j\": 10\n    },\n    {\n      \"i\": 6,\n      \"j\": 11\n    },\n    {\n      \"i\": 6,\n      \"j\": 25\n    },\n    {\n      \"i\": 7,\n      \"j\": 8\n    },\n    {\n      \"i\": 7,\n      \"j\": 11\n    },\n    {\n      \"i\": 7,\n      \"j\": 12\n    },\n    {\n      \"i\": 7,\n      \"j\"\
    : 13\n    },\n    {\n      \"i\": 7,\n      \"j\": 25\n    },\n    {\n      \"i\": 8,\n      \"j\": 9\n    },\n    {\n      \"i\": 8,\n      \"j\": 13\n    },\n    {\n      \"i\": 9,\n      \"j\": 13\n    },\n    {\n      \"i\": 9,\n      \"j\": 14\n    },\n    {\n      \"i\": 10,\n      \"j\": 15\n    },\n    {\n      \"i\": 10,\n      \"j\": 16\n    },\n    {\n      \"i\": 11,\n      \"j\": 12\n    },\n    {\n      \"i\": 11,\n      \"j\": 16\n    },\n    {\n      \"i\": 11,\n      \"j\": 25\n    },\n    {\n      \"i\": 12,\n      \"j\": 13\n    },\n    {\n      \"i\": 12,\n      \"j\": 16\n    },\n    {\n      \"i\": 12,\n      \"j\": 17\n    },\n    {\n      \"i\": 12,\n      \"j\": 18\n    },\n    {\n      \"i\": 13,\n      \"j\": 14\n    },\n    {\n      \"i\": 13,\n      \"j\": 18\n    },\n    {\n      \"i\": 14,\n      \"j\": 18\n    },\n    {\n      \"i\": 14,\n      \"j\": 19\n    },\n    {\n      \"i\": 15,\n      \"j\": 16\n    },\n    {\n      \"i\": 15,\n      \"j\": 20\n\
    \    },\n    {\n      \"i\": 15,\n      \"j\": 21\n    },\n    {\n      \"i\": 16,\n      \"j\": 17\n    },\n    {\n      \"i\": 16,\n      \"j\": 21\n    },\n    {\n      \"i\": 17,\n      \"j\": 18\n    },\n    {\n      \"i\": 17,\n      \"j\": 21\n    },\n    {\n      \"i\": 17,\n      \"j\": 22\n    },\n    {\n      \"i\": 17,\n      \"j\": 23\n    },\n    {\n      \"i\": 18,\n      \"j\": 19\n    },\n    {\n      \"i\": 18,\n      \"j\": 23\n    },\n    {\n      \"i\": 18,\n      \"j\": 24\n    },\n    {\n      \"i\": 19,\n      \"j\": 24\n    },\n    {\n      \"i\": 20,\n      \"j\": 21\n    },\n    {\n      \"i\": 21,\n      \"j\": 22\n    },\n    {\n      \"i\": 22,\n      \"j\": 23\n    },\n    {\n      \"i\": 23,\n      \"j\": 24\n    }\n  ],\n  \"num_active_boundary_constraints\": 20,\n  \"num_active_pair_constraints\": 58,\n  \"mean_contact_degree\": 4.461538461538462,\n  \"max_contact_degree\": 7,\n  \"contact_degree_histogram\": [\n    0,\n    0,\n    1,\n    7,\n    6,\n\
