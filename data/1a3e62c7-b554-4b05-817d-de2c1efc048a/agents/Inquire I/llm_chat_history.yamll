    \ pandas as pd\n  import itertools\n  import json \n  import csv, io\n\n  # --- Embedded Nudged_5_ID419 Data (from manual exports) ---\n  NAME_PREFIX_NUDGED5 = \"Nudged_5_ID419\"\n  \n  NUDGED5_BOUNDARY_CSV = \"\"\"disc,label\n  24,yT\n  0,yB\n  4,yT\n  15,yB\n  3,xL\n  19,yT\n  21,xR\n  23,xR\n  10,yB\n  14,yT\n  0,xL\n  2,xL\n  5,yB\n  20,xR\n  22,xR\n  4,xL\n  9,yT\n  20,yB\n  24,xR\n  1,xL\"\"\"\n  NUDGED5_PAIRS_CSV = \"\"\"i,j\n  0,1\n  0,5\n  0,6\n  1,2\n  1,6\n  1,25\n  2,3\n  2,25\n  3,4\n  3,8\n  3,25\n  4,8\n  4,9\n  5,6\n  5,10\n  6,10\n  6,11\n  6,25\n  7,8\n  7,11\n  7,12\n  7,13\n  7,25\n  8,9\n  8,13\n  8,14\n  9,14\n  10,11\n  10,15\n  10,16\n  11,12\n  11,16\n  11,25\n  12,13\n  12,16\n  12,17\n  12,18\n  13,14\n  13,18\n  14,18\n  14,19\n  15,16\n  15,20\n  15,21\n  16,17\n  17,18\n  17,21\n  17,22\n  17,23\n  18,19\n  18,23\n  18,24\n  19,24\n  20,21\n  21,22\n  22,23\n  23,24\"\"\"\n  NUDGED5_SUMMARY_JSON = \"\"\"{\n    \"n\": 26,\n    \"index_base\": 0,\n    \"tolerance\"\
