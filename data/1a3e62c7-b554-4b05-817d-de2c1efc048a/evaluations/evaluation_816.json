  "original_submission": {
    "content": "import numpy as np\nfrom scipy.optimize import minimize\n\nN = 26\nR_MIN = 1e-6\nSAFETY = 1e-9\n\nBASE_CENTERS = np.array([[8.46873013e-02, 8.46873013e-02], [1.32360094e-01, 2.96434501e-01], [7.82692709e-02, 5.00000000e-01], [1.32360094e-01, 7.03565499e-01], [8.46873013e-02, 9.15312699e-01], [2.73531650e-01, 1.05276079e-01], [3.81125065e-01, 2.99112331e-01], [2.69793959e-01, 5.00000000e-01], [3.81125065e-01, 7.00887669e-01], [2.73531650e-01, 8.94723921e-01], [4.82519013e-01, 1.03717099e-01], [5.96528648e-01, 2.73192781e-01], [5.32519668e-01, 5.00000000e-01], [5.96528648e-01, 7.26807219e-01], [4.82519013e-01, 8.96282901e-01], [6.82251639e-01, 9.61584984e-02], [7.63249164e-01, 2.40501408e-01], [7.42587601e-01, 4.04280278e-01], [7.42587601e-01, 5.95719722e-01], [6.82251639e-01, 9.03841502e-01], [8.88936708e-01, 1.11063292e-01], [9.07544188e-01, 3.13729982e-01], [9.06180804e-01, 5.00000000e-01], [9.07544188e-01, 6.86270018e-01], [8.88936708e-01, 8.88936708e-01], [7.63249164e-01, 7.59498592e-01]])\nBASE_RADII = np.array([8.46872913e-02, 1.32360084e-01, 7.82692609e-02, 1.32360084e-01, 8.46872913e-02, 1.05276069e-01, 1.16419283e-01, 1.13255412e-01, 1.16419283e-01, 1.05276069e-01, 1.03717089e-01, 1.00538135e-01, 1.35128279e-01, 1.00538137e-01, 1.03717089e-01, 9.61584884e-02, 6.93572823e-02, 9.57197149e-02, 9.57197171e-02, 9.61584884e-02, 1.11063282e-01, 9.24558017e-02, 9.38191856e-02, 9.24558017e-02, 1.11063282e-01, 6.93572798e-02])\n\ndef _ensure_validity(c, r):\n    for i in range(N): r[i] = min(r[i], c[i,0], 1-c[i,0], c[i,1], 1-c[i,1])\n    for _ in range(10):\n        violations = 0;\n        for i in range(N):\n            for j in range(i + 1, N):\n                dist = np.linalg.norm(c[i] - c[j]); rad_sum = r[i] + r[j]\n                if dist < rad_sum: violations+=1; scale = (dist/rad_sum)*(1.0-SAFETY); r[i]*=scale; r[j]*=scale\n        if violations == 0: break\n    return c, np.maximum(r, 0)\n\ndef z_to_cr(z): return z[:N*2].reshape(N, 2), z[N*2:]\n\ndef construct_packing() -> tuple:\n    contacts_to_discourage = [(7, 12)]\n    \n    def nudge_objective(z):\n        c, r = z_to_cr(z)\n        base_obj = -np.sum(r)\n        penalty = 0\n        for i, j in contacts_to_discourage:\n            dist = np.linalg.norm(c[i] - c[j])\n            target_dist = r[i] + r[j] + 0.01 # EPS_FAR\n            penalty += 1e1 * max(0, target_dist - dist)**2 # BETA_DISCOURAGE\n        return base_obj + penalty\n\n    bounds = [(0,1)]*N*2 + [(R_MIN, 0.5)]*N\n    def ineq_boundary(z): c,r=z_to_cr(z); return np.concatenate([c[:,0]-r, 1-(c[:,0]+r), c[:,1]-r, 1-(c[:,1]+r)])\n    def ineq_nonoverlap(z): c,r=z_to_cr(z); diff=c[:,None,:]-c[None,:,:]; dist=np.sqrt(np.sum(diff**2,axis=-1)); iu=np.triu_indices(N,1); return dist[iu]-(r[iu[0]]+r[iu[1]])\n    constraints = [{'type':'ineq','fun':ineq_boundary}, {'type':'ineq','fun':ineq_nonoverlap}]\n\n    initial_z = np.concatenate([BASE_CENTERS.flatten(), BASE_RADII])\n    res = minimize(nudge_objective, initial_z, method='SLSQP', bounds=bounds, constraints=constraints, options={'maxiter': 2000, 'ftol': 1e-10})\n    \n    final_centers, final_radii = z_to_cr(res.x)\n    return _ensure_validity(final_centers, final_radii)\n",
