  "cpu_only": false,
  "original_submission": {
    "content": "import numpy as np\n\ndef compute_max_radii(centers):\n    \"\"\"\n    Computes the maximum possible radii for a given set of circle centers\n    within a unit square, ensuring no overlap.\n    Includes a safety margin for robustness against floating-point errors.\n    \"\"\"\n    n = centers.shape[0]\n    epsilon = 1e-9 # Used for general small value comparisons and boundary checks\n    safety_margin = 1e-7 # Ensures strict non-overlap for evaluator\n    radii = np.ones(n) # Initialize with large radii, will shrink\n    \n    # Limit by distance to square borders, ensuring a minimum radius\n    for i in range(n):\n        x, y = centers[i]\n        radii[i] = min(x - epsilon, y - epsilon, 1 - x - epsilon, 1 - y - epsilon)\n        radii[i] = max(radii[i], epsilon) # Ensure all radii are at least epsilon\n    \n    # Iteratively shrink radii to resolve overlaps.\n    # Using 50 iterations for sufficient convergence.\n    for _ in range(50): \n        for i in range(n):\n            for j in range(i + 1, n):\n                dist_sq = np.sum((centers[i] - centers[j]) ** 2)\n                rad_sum = radii[i] + radii[j]\n                \n                # Check for overlap condition using epsilon\n                if dist_sq < rad_sum**2 - epsilon:\n                    dist = np.sqrt(dist_sq)\n                    \n                    # Handle cases where centers are very close or identical\n                    if dist < 2 * epsilon: \n                        radii[i] = epsilon \n                        radii[j] = epsilon\n                    else:\n                        # Target sum of radii is `dist - safety_margin` to guarantee no overlap\n                        target_rad_sum = dist - safety_margin\n                        \n                        # Only scale if current sum is greater than the target sum\n                        if rad_sum > target_rad_sum:\n                            scale_factor = target_rad_sum / rad_sum\n                            radii[i] *= scale_factor\n                            radii[j] *= scale_factor\n    \n    return np.maximum(radii, epsilon) # Final check to ensure all radii are positive\n\ndef construct_packing() -> tuple:\n    \"\"\"\n    Construct a packing of 26 circles in the unit square using a local search\n    optimization approach starting from a spiral configuration.\n    \n    Returns:\n        tuple: A tuple of (centers, radii) where:\n            - centers: np.ndarray of shape (26, 2) with (x, y) coordinates\n            - radii: np.ndarray of shape (26,) with radius of each circle\n    \"\"\"\n    n_circles = 26\n    centers = np.zeros((n_circles, 2))\n    \n    # Place the first circle at the center\n    centers[0] = [0.5, 0.5]\n    \n    # Generate the remaining 25 circles in a spiral pattern\n    num_spiral_circles = n_circles - 1\n    spiral_turns = 3.0 # Number of full turns in the spiral\n    max_spiral_extent = 0.45 # Max radius from center to fit in unit square\n    \n    for i in range(num_spiral_circles):\n        # Calculate angle, distributing over multiple turns\n        angle = i * (2 * np.pi / num_spiral_circles) * spiral_turns\n        \n        # Calculate radius from the center, increasing linearly\n        r = (i / num_spiral_circles) * max_spiral_extent\n        \n        # Convert polar to Cartesian coordinates, centered at (0.5, 0.5)\n        x = 0.5 + r * np.cos(angle)\n        y = 0.5 + r * np.sin(angle)\n        \n        centers[i + 1] = [x, y]\n        \n    # Ensure centers are within the unit square after initial placement\n    centers = np.clip(centers, 0.0, 1.0)\n    \n    # Calculate initial radii and score\n    best_centers = centers\n    best_radii = compute_max_radii(best_centers)\n    best_score = np.sum(best_radii)\n    \n    print(f\"Initial score (from spiral config): {best_score}\")\n    \n    # Local search parameters\n    num_perturbation_steps = 2000 # Number of local search iterations\n    perturbation_strength = 0.01 # Max displacement in any direction for a center\n    \n    for step in range(num_perturbation_steps):\n        current_centers = np.copy(best_centers)\n        \n        # Randomly select a circle to perturb\n        idx_to_perturb = np.random.randint(0, n_circles)\n        \n        # Apply a small random perturbation to the selected center\n        current_centers[idx_to_perturb] += np.random.uniform(-perturbation_strength, perturbation_strength, 2)\n        \n        # Ensure the perturbed center stays within the unit square [0, 1]\n        current_centers[idx_to_perturb] = np.clip(current_centers[idx_to_perturb], 0.0, 1.0)\n        \n        # Compute radii and score for the new configuration\n        current_radii = compute_max_radii(current_centers)\n        current_score = np.sum(current_radii)\n        \n        # If the new configuration is better, accept it\n        if current_score > best_score:\n            best_score = current_score\n            best_centers = current_centers\n            print(f\"Step {step+1}/{num_perturbation_steps}: New best score: {best_score}\") \n    \n    print(f\"Final best score after {num_perturbation_steps} steps: {best_score}\")\n\n    # Recalculate best_radii for the best_centers found, just to be sure it's consistent\n    best_radii = compute_max_radii(best_centers)\n    return best_centers, best_radii\n",
