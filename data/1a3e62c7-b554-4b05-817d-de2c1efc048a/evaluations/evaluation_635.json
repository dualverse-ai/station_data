    "content": "import numpy as np\nfrom scipy.optimize import minimize\nimport math\n\nN = 26\nR_MIN = 1e-6\nSAFETY = 1e-9\n\nSOTA_CENTERS = np.array([\n    [8.492626245490325632e-02, 8.492626245489955095e-02], [1.332585727708142376e-01, 2.976904749108396642e-01],\n    [7.886037291596154075e-02, 5.027155537958869491e-01], [1.302211010652318812e-01, 7.053905112181719783e-01],\n    [8.463950069576857416e-02, 9.153604993042284699e-01], [2.739528396239510055e-01, 1.051825602687500166e-01],\n    [3.816658444526486726e-01, 2.973903963009784102e-01], [2.753426167714373429e-01, 5.044682393256384456e-01],\n    [3.869235534096087670e-01, 7.052539409510502066e-01], [2.747832833508189743e-01, 8.932098553714216127e-01],\n    [4.825955822105374993e-01, 1.034672333579526315e-01], [5.960427019081339095e-01, 2.730942856883976089e-01],\n    [5.299634197531902791e-01, 5.013319244965969146e-01], [5.976347963876644798e-01, 7.283701485139996157e-01],\n    [4.846008026519129652e-01, 8.969394798584140460e-01], [6.820800429325878378e-01, 9.615133404576799159e-02],\n    [7.629588636540003410e-01, 2.406475984390707423e-01], [7.420494434605940937e-01, 4.047802670602677622e-01],\n    [7.424170495016405580e-01, 5.966412163973151550e-01], [6.832585349730860846e-01, 9.042676706929789754e-01],\n    [8.888438205895518029e-01, 1.111561794104394679e-01], [9.074079050485648335e-01, 3.140569780132145827e-01],\n    [9.060726627225502705e-01, 5.005716308609604592e-01], [9.076084484290364296e-01, 6.868841900295953318e-01],\n    [8.892209872092887712e-01, 8.892209872092843304e-01], [7.636735693833809346e-01, 7.602894720724653332e-01]\n])\nSOTA_RADII = np.array([\n    8.492625245489955621e-02, 1.332585627708142428e-01, 7.886036291596154602e-02, 1.302210910652318865e-01,\n    8.463949069576857942e-02, 1.051825502687500219e-01, 1.151488751600189958e-01, 1.176296830465418664e-01,\n    1.120770839502557153e-01, 1.067901346285783926e-01, 1.034672233579526368e-01, 1.006003628187135401e-01,\n    1.370104251237446169e-01, 9.989834559275019565e-02, 1.030605101415859592e-01, 9.615132404576799685e-02,\n    6.944018871125764991e-02, 9.601897075825123473e-02, 9.584232074550398661e-02, 9.573231930702102987e-02,\n    1.111561694104394732e-01, 9.259208495143517181e-02, 9.392732727744973475e-02, 9.239154157096357567e-02,\n    1.107790027907112340e-01, 6.918067135723383887e-02\n])\n\ndef cr_to_z(c, r): return np.concatenate([c.flatten(), r])\ndef z_to_cr(z): return z[:N*2].reshape(N, 2), z[N*2:]\n\nENCOURAGE_PAIR = (16, 17)\nALPHA_ENCOURAGE = 1e2\nEPS_CLOSE = 0.005\n\ndef objective(z):\n    centers, radii = z_to_cr(z)\n    base_objective = -np.sum(radii)\n    i, j = ENCOURAGE_PAIR\n    dist = np.linalg.norm(centers[i] - centers[j])\n    target_dist = radii[i] + radii[j] + EPS_CLOSE\n    penalty = ALPHA_ENCOURAGE * max(0, dist - target_dist)**2\n    return base_objective + penalty\n\ndef ineq_boundary(z):\n    c, r = z_to_cr(z)\n    return np.concatenate([c[:,0] - r, 1 - (c[:,0] + r), c[:,1] - r, 1 - (c[:,1] + r)])\ndef ineq_nonoverlap(z):\n    c, r = z_to_cr(z)\n    diff = c[:, None, :] - c[None, :, :]\n    dist = np.sqrt(np.sum(diff**2, axis=-1))\n    iu = np.triu_indices(N, 1)\n    return dist[iu] - (r[iu[0]] + r[iu[1]])\ndef _ensure_validity(c, r):\n    for i in range(N): r[i] = min(r[i], c[i,0], 1-c[i,0], c[i,1], 1-c[i,1])\n    for _ in range(10):\n        violations = 0\n        for i in range(N):\n            for j in range(i + 1, N):\n                dist = np.linalg.norm(c[i] - c[j])\n                rad_sum = r[i] + r[j]\n                if dist < rad_sum:\n                    violations+=1; scale = (dist/rad_sum)*(1.0-SAFETY); r[i]*=scale; r[j]*=scale\n        if violations == 0: break\n    return c, np.maximum(r, 0)\n\ndef construct_packing() -> tuple:\n    bounds = [(0,1)]*N*2 + [(R_MIN, 0.5)]*N\n    constraints = [{'type': 'ineq', 'fun': ineq_boundary}, {'type': 'ineq', 'fun': ineq_nonoverlap}]\n    initial_z = cr_to_z(SOTA_CENTERS, SOTA_RADII)\n    res = minimize(objective, initial_z, method='SLSQP', bounds=bounds, constraints=constraints, options={'maxiter': 1000, 'ftol': 1e-9})\n    if not res.success: return _ensure_validity(SOTA_CENTERS, SOTA_RADII)\n    c, r = z_to_cr(res.x)\n    return _ensure_validity(c, r)\n",
