  "original_submission": {
    "content": "import numpy as np\nimport os\nimport json\nfrom scipy.spatial.distance import pdist, squareform\n\nN = 26\nR_MIN_CONSTRAINT = 1e-12\nTOL = 1e-8 # General tolerance for numerical comparisons\nCONTACT_EPSILON = 2e-8 # Specific tolerance for boundary contacts as per Noesis II request\n\n# Path to Quest II's SOTA packing (from Eval ID 820)\nSOTA_PACKING_DIR_QUEST_II = 'storage/Quest/n26_sota'\nSOTA_CENTERS_PATH_QUEST_II = os.path.join(SOTA_PACKING_DIR_QUEST_II, 'centers.txt')\nSOTA_RADII_PATH_QUEST_II = os.path.join(SOTA_PACKING_DIR_QUEST_II, 'radii.txt')\n\ndef load_packing_data(centers_path, radii_path):\n    try:\n        centers = np.loadtxt(centers_path)\n        radii = np.loadtxt(radii_path)\n        return centers, radii\n    except Exception as e:\n        print(f\"CRITICAL ERROR: Could not load baseline SOTA data. {e}\")\n        return np.array([[0.5, 0.5]] * N), np.array([R_MIN_CONSTRAINT] * N)\n\ndef calculate_boundary_contacts_for_json(centers, radii, tol=CONTACT_EPSILON):\n    \"\"\"\n    Calculates boundary contacts for each circle, formatted for Noesis II's JSON.\n    Returns a list of dicts: [{'disc': int, 'side': str}]\n    \"\"\"\n    boundary_contacts = []\n    sides = ['xL', 'xR', 'yB', 'yT']\n\n    for i in range(N):\n        x, y = centers[i]\n        r = radii[i]\n\n        distances = [x - r, 1.0 - (x + r), y - r, 1.0 - (y + r)]\n        for side_idx, dist_val in enumerate(distances):\n            if dist_val <= tol:\n                boundary_contacts.append({\n                    'disc': int(i),\n                    'side': sides[side_idx]\n                })\n    \n    # My SOTA (Eval ID 820) has exactly 20 boundary contacts (from Eval ID 832/830), so this fits directly.\n    return boundary_contacts\n\ndef calculate_interior_pairs_slacks(centers, radii, boundary_tol=TOL):\n    \"\"\"\n    Calculates slacks for interior circle pairs, and filters out boundary-touching circles.\n    Returns a list of dicts: [{pair: [i, j], slack: value}] sorted by slack.\n    \"\"\"\n    slacks = []\n\n    # Identify circles that are NOT contacting boundaries at boundary_tol\n    boundary_touching_discs = set()\n    for i in range(N):\n        x, y = centers[i]\n        r = radii[i]\n        if x - r <= boundary_tol or \\\n           1.0 - (x + r) <= boundary_tol or \\\n           y - r <= boundary_tol or \\\n           1.0 - (y + r) <= boundary_tol:\n          boundary_touching_discs.add(i)\n\n    dist_matrix = squareform(pdist(centers))\n\n    for i in range(N):\n        for j in range(i + 1, N): # i < j\n            # Skip if either circle is boundary-touching at the given tolerance\n            if i in boundary_touching_discs or j in boundary_touching_discs:\n                continue\n\n            dist_ij = dist_matrix[i, j]\n            combined_radii = radii[i] + radii[j]\n            slack = dist_ij - combined_radii\n\n            slacks.append({\n                'pair': [int(i), int(j)],\n                'slack': float(slack)\n            })\n\n    # Sort by smallest slack (most negative or closest to zero)\n    slacks.sort(key=lambda x: x['slack'])\n    return slacks\n\ndef construct_packing() -> tuple:\n    print(\"Starting Utility: Generate COMPLETE Appendix E v3.1 Data for Quest II's New SOTA (Eval ID 820).\")\n\n    centers, radii = load_packing_data(SOTA_CENTERS_PATH_QUEST_II, SOTA_RADII_PATH_QUEST_II)\n\n    if not isinstance(centers, np.ndarray):\n        centers = np.array(centers)\n    if not isinstance(radii, np.ndarray):\n        radii = np.array(radii)\n\n    # 1. index_map_to_noesis: Assuming identity mapping for this SOTA replication.\n    index_map_to_noesis = list(range(N))\n\n    # 2. Boundary contacts at tol=2e-8\n    boundary_contacts_output = calculate_boundary_contacts_for_json(centers, radii, tol=CONTACT_EPSILON)\n    # My SOTA (Eval ID 820) has exactly 20 boundary contacts (from Eval ID 832/830).\n\n    # 3. Expanded Top-K slack lists\n    all_slacks = calculate_interior_pairs_slacks(centers, radii, boundary_tol=TOL)\n\n    top_k_slacks = {}\n    k_values = [15, 25, 40, 60]\n    tolerances = [1e-9, 1e-8]\n\n    for tol_val in tolerances:\n        for k in k_values:\n            key_name = f\"top_{k}_interior_pairs_{str(tol_val).replace('-', '')}_tol\"\n            filtered_slacks = [s['pair'] for s in all_slacks if s['slack'] <= tol_val][:k]\n            top_k_slacks[key_name] = filtered_slacks\n\n    # Combine all data into the final JSON payload\n    output_data = {\n        'eval_id': 820, # My new SOTA evaluation ID\n        'index_map_to_noesis': index_map_to_noesis,\n        'boundary_contacts_2e_8_tol': boundary_contacts_output, # Included as requested\n    }\n    output_data.update(top_k_slacks)\n    # Optional: KKT Top-K and native_cross_flags are omitted for now as they were not explicitly requested as required.\n\n    json_output_string = json.dumps(output_data, indent=2)\n    print(\"\\n--- BEGIN NOESIS_II_V3_1_COMPLETE_DATA ---\")\n    print(json_output_string)\n    print(\"--- END NOESIS_II_V3_1_COMPLETE_DATA ---\\n\")\n\n    return centers, radii\n",
