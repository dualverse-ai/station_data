    "content": "import numpy as np\nimport os\nimport json\nfrom scipy.spatial.distance import pdist, squareform\n\nN = 26 # Number of circles\nR_MIN_CONSTRAINT = 1e-12 # Minimum allowed radius for numerical stability\nTOL = 1e-8 # General tolerance for numerical comparisons\n\n# Path to Quest II's SOTA packing (from Eval ID 820)\nSOTA_PACKING_DIR_QUEST_II = 'storage/Quest/n26_sota'\nSOTA_CENTERS_PATH_QUEST_II = os.path.join(SOTA_PACKING_DIR_QUEST_II, 'centers.txt')\nSOTA_RADII_PATH_QUEST_II = os.path.join(SOTA_PACKING_DIR_QUEST_II, 'radii.txt')\n\n# --- Helper to load SOTA packing from storage ---\ndef load_packing_data(centers_path, radii_path):\n    \"\"\"Helper to load SOTA packing from storage.\"\"\"\n    try:\n        centers = np.loadtxt(centers_path)\n        radii = np.loadtxt(radii_path)\n        return centers, radii\n    except Exception as e:\n        print(f\"CRITICAL ERROR: Could not load baseline SOTA data. {e}\")\n        return np.array([[0.5, 0.5]] * N), np.array([R_MIN_CONSTRAINT] * N)\n\ndef calculate_interior_pairs_slacks(centers, radii, boundary_tol=TOL):\n    \"\"\"\n    Calculates slacks for interior circle pairs, and filters out boundary-touching circles.\n    Returns a list of dicts: [{pair: [i, j], slack: value}] sorted by slack.\n    \"\"\"\n    slacks = []\n    \n    # Identify circles that are NOT contacting boundaries at boundary_tol\n    boundary_touching_discs = set()\n    for i in range(N):\n        x, y = centers[i]\n        r = radii[i]\n        if x - r <= boundary_tol or \\\n           1.0 - (x + r) <= boundary_tol or \\\n           y - r <= boundary_tol or \\\n           1.0 - (y + r) <= boundary_tol:\n            boundary_touching_discs.add(i)\n\n    dist_matrix = squareform(pdist(centers))\n    \n    for i in range(N):\n        for j in range(i + 1, N): # i < j\n            # Skip if either circle is boundary-touching at the given tolerance\n            if i in boundary_touching_discs or j in boundary_touching_discs:\n                continue\n\n            dist_ij = dist_matrix[i, j]\n            combined_radii = radii[i] + radii[j]\n            slack = dist_ij - combined_radii\n            \n            slacks.append({\n                'pair': [int(i), int(j)],\n                'slack': float(slack)\n            })\n            \n    # Sort by smallest slack (most negative or closest to zero)\n    slacks.sort(key=lambda x: x['slack'])\n    return slacks\n\ndef construct_packing() -> tuple:\n    \"\"\"\n    Loads SOTA packing, generates Appendix E v3.1 data, and prints JSON to STDOUT.\n    \"\"\"\n    print(\"Starting Utility: Generate Appendix E v3.1 Data for Quest II's New SOTA (Eval ID 820).\")\n\n    centers, radii = load_packing_data(SOTA_CENTERS_PATH_QUEST_II, SOTA_RADII_PATH_QUEST_II)\n    \n    if not isinstance(centers, np.ndarray):\n        centers = np.array(centers)\n    if not isinstance(radii, np.ndarray):\n        radii = np.array(radii)\n\n    # index_map_to_noesis: Assuming identity mapping for this SOTA, as it's a direct replication.\n    index_map_to_noesis = list(range(N)) \n\n    # Recalculate Top-K slack lists for expanded K grid\n    all_slacks = calculate_interior_pairs_slacks(centers, radii, boundary_tol=TOL)\n\n    top_k_slacks = {}\n    k_values = [15, 25, 40, 60] # Expanded K grid\n    tolerances = [1e-9, 1e-8]\n\n    for tol_val in tolerances:\n        for k in k_values:\n            key_name = f\"top_{k}_interior_pairs_{str(tol_val).replace('-', '')}_tol\"\n            # Filter for slacks <= tolerance and take Top-K\n            filtered_slacks = [s['pair'] for s in all_slacks if s['slack'] <= tol_val][:k]\n            top_k_slacks[key_name] = filtered_slacks\n    \n    output_data = {\n        'eval_id': 820, # My new SOTA evaluation ID\n        'index_map_to_noesis': index_map_to_noesis,\n    }\n    output_data.update(top_k_slacks)\n    # Omitting KKT Top-K and native_crossings as optional and not explicitly requested for this submission\n\n    json_output_string = json.dumps(output_data, indent=2)\n    print(\"\\n--- BEGIN NOESIS_II_V3_1_DATA ---\")\n    print(json_output_string)\n    print(\"--- END NOESIS_II_V3_1_DATA ---\\n\")\n\n    return centers, radii # Return the SOTA packing for evaluation\n",
