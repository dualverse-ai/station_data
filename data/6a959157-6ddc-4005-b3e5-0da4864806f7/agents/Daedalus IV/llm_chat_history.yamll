role: model
parts:
- text: "I have read the contents of `balanced_graph.py` and `residualize.py`. I will now copy them to my local storage. Then, I will create the baseline script that replicates submission 197 and submit it.\n\n/execute_action{storage write daedalus/balanced_graph.py}\n```yaml\ncontent: |\n  import numpy as np\n  from sklearn.neighbors import NearestNeighbors\n  from scipy.sparse import coo_matrix, csr_matrix\n\n  def build_balanced_knn(\n      Z,\n      batches,\n      n_neighbors_total=15,\n      metric='euclidean',\n      weighting='binary',      # 'binary' or 'gaussian'\n      allocation='equal',      # 'equal' or 'proportional'\n      mutual=False,            # keep edge only if i in N(j) and j in N(i)\n      symmetric=True           # symmetrize final graph\n  ):\n      Z = np.asarray(Z, dtype=np.float32)\n      batches = np.asarray(batches)\n      uniq = np.unique(batches)\n      n = Z.shape[0]\n      B = len(uniq)\n      if n == 0 or B == 0:\n          return None, None\n      counts\
    \ = {b: int((batches == b).sum()) for b in uniq}\n      if allocation == 'proportional':\n          total = float(n)\n          k_map = {}\n          for b in uniq:\n              frac = counts[b] / total if total > 0 else 0.0\n              k_map[b] = max(1, int(round(n_neighbors_total * frac)))\n          if sum(k_map.values()) == 0:\n              for b in uniq:\n                  k_map[b] = 1\n      else:\n          base = max(1, int(np.ceil(n_neighbors_total / max(1, B))))\n          k_map = {b: base for b in uniq}\n      dir_edges = {}\n      for b in uniq:\n          idx_train = np.where(batches == b)[0]\n          if idx_train.size == 0:\n              continue\n          k_b = k_map[b]\n          k_query = min(k_b + 1, idx_train.size)\n          nn = NearestNeighbors(n_neighbors=k_query, metric=metric, algorithm='auto')\n          nn.fit(Z[idx_train])\n          dists, inds = nn.kneighbors(Z, n_neighbors=k_query, return_distance=True)\n          neigh_global = idx_train[inds]\n\
    \          for i in range(n):\n              g = neigh_global[i]\n              di = dists[i]\n              mask = g != i\n              g = g[mask][:k_b]\n              di = di[mask][:k_b]\n              for j, d in zip(g, di):\n                  if i == j:\n                      continue\n                  key = (int(i), int(j))\n                  prev = dir_edges.get(key)\n                  if (prev is None) or (d < prev):\n                      dir_edges[key] = float(d)\n      pairs = {}\n      if mutual:\n          for (i, j), d_ij in dir_edges.items():\n              if (j, i) in dir_edges:\n                  d_ji = dir_edges[(j, i)]\n                  d = min(d_ij, d_ji)\n                  a, c = (i, j) if i < j else (j, i)\n                  prev = pairs.get((a, c))\n                  if (prev is None) or (d < prev):\n                      pairs[(a, c)] = d\n      else:\n          for (i, j), d_ij in dir_edges.items():\n              a, c = (i, j) if i < j else (j, i)\n    \
    \          d = d_ij\n              if (j, i) in dir_edges:\n                  d = min(d, dir_edges[(j, i)])\n              prev = pairs.get((a, c))\n              if (prev is None) or (d < prev):\n                  pairs[(a, c)] = d\n      if not pairs:\n          return None, None\n      rows, cols, dist_data = [], [], []\n      for (i, j), d in pairs.items():\n          rows.append(i); cols.append(j); dist_data.append(d)\n          if symmetric:\n              rows.append(j); cols.append(i); dist_data.append(d)\n      D = coo_matrix((dist_data, (rows, cols)), shape=(n, n)).tocsr()\n      if weighting == 'binary':\n          C = D.copy()\n          C.data[:] = 1.0\n          return C.tocsr(), D\n      elif weighting == 'gaussian':\n          s = np.zeros(n, dtype=np.float32)\n          for i in range(n):\n              start, end = D.indptr[i], D.indptr[i+1]\n              di = D.data[start:end]\n              if di.size > 0:\n                  s[i] = np.median(di)\n          global_med\
    \ = np.median(D.data) if D.nnz > 0 else 1.0\n          s[s <= 0] = global_med if global_med > 0 else 1.0\n          rows_w, cols_w, w_data = [], [], []\n          for i in range(n):\n              start, end = D.indptr[i], D.indptr[i+1]\n              js = D.indices[start:end]\n              di = D.data[start:end]\n              if js.size == 0:\n                  continue\n              s_bar = 0.5 * (s[i] + s[js])\n              denom = 2.0 * (s_bar * s_bar) + 1e-12\n              w = np.exp(- (di * di) / denom).astype(np.float32)\n              rows_w.extend([i] * len(js)); cols_w.extend(js.tolist()); w_data.extend(w.tolist())\n          C = coo_matrix((w_data, (rows_w, cols_w)), shape=(n, n)).tocsr()\n          if symmetric:\n              C = C.maximum(C.transpose()).tocsr()\n          return C, D\n      else:\n          C = D.copy()\n          C.data[:] = 1.0\n          return C.tocsr(), D\n```\n/execute_action{storage write daedalus/residualize.py}\n```yaml\ncontent: |\n  import\
    \ numpy as np\n\n  def residualize_pcs_against_batch(Z, batches, l2=1e-3, gamma=0.2, center=True):\n      Z = np.asarray(Z, dtype=np.float32)\n      n, d = Z.shape\n      batches = np.asarray(batches)\n      uniq = np.unique(batches)\n      B = np.zeros((n, len(uniq)), dtype=np.float32)\n      for k, u in enumerate(uniq):\n          B[:, k] = (batches == u).astype(np.float32)\n      if center:\n          mu = Z.mean(axis=0, keepdims=True)\n          Zc = Z - mu\n      else:\n          mu = 0.0\n          Zc = Z\n      BtB = B.T @ B\n      BtZ = B.T @ Zc\n      reg = l2 * np.eye(BtB.shape[0], dtype=np.float32)\n      W = np.linalg.solve(BtB + reg, BtZ)\n      Z_pred = B @ W\n      Z_resid = Zc - gamma * Z_pred\n      if center:\n          Z_resid = Z_resid + mu\n      return Z_resid\n```\n/execute_action{storage write daedalus/d2_combat_baseline.py}\n```yaml\ncontent: |\n  import sys\n  sys.path.append('storage/daedalus')\n\n  import anndata as ad\n  import scanpy as sc\n\n  from balanced_graph\
    \ import build_balanced_knn\n  from residualize import residualize_pcs_against_batch\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      adata_for_emb = adata.copy()\n      sc.pp.normalize_total(adata_for_emb, target_sum=1e4)\n      sc.pp.log1p(adata_for_emb)\n      sc.pp.highly_variable_genes(adata_for_emb, n_top_genes=2000, batch_key='batch', subset=True)\n      sc.pp.combat(adata_for_emb, key='batch')\n      sc.pp.pca(adata_for_emb, n_comps=50)\n      my_embedding = adata_for_emb.obsm['X_pca']\n\n      adata_for_graph = adata.copy()\n      sc.pp.normalize_total(adata_for_graph, target_sum=1e4)\n      sc.pp.log1p(adata_for_graph)\n      sc.pp.highly_variable_genes(adata_for_graph, n_top_genes=2000, batch_key='batch', subset=True)\n      \n      sc.pp.pca(adata_for_graph, n_comps=64)\n      Z = adata_for_graph.obsm['X_pca']\n      batches = adata_for_graph.obs['batch'].values\n      \n      Z_resid = residualize_pcs_against_batch(Z, batches, l2=1e-3, gamma=0.70,\
    \ center=True)\n      \n      C, D = build_balanced_knn(\n          Z_resid, batches, n_neighbors_total=48, metric='cosine',\n          weighting='binary', allocation='equal', mutual=False, symmetric=True\n      )\n\n      output = ad.AnnData(obs=adata.obs[[]], var=adata.var[[]])\n      output.obsm['X_emb'] = my_embedding\n      \n      if C is not None and D is not None:\n          output.obsp['connectivities'] = C\n          output.obsp['distances'] = D\n      \n      return output\n```"
