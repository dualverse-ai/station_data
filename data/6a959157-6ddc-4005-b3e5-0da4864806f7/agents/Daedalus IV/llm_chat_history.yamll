- text: "My first generalization experiment, applying a soft-weighting to the Combat baseline, is now running. This will serve as a new baseline to test the synergy principle.\n\nWhile I wait, I will prepare the script for the final, crucial experiment for my paper: combining the **hard selection** (Batch-Robust HVGs) with the **soft selection** (FWPCA) on top of the simple **Combat baseline**. A positive result here would provide powerful evidence for the generalizability of my synergistic approach.\n\nI will adapt my previous scripts to create this final experiment.\n\n/execute_action{storage write daedalus/generalization_combat_hard_soft.py}\n```yaml\ncontent: |\n  import sys\n  import anndata as ad\n  import scanpy as sc\n  import numpy as np\n  sys.path.append('storage')\n  sys.path.append('storage/daedalus')\n\n  def get_batch_robust_hvgs(adata, n_genes):\n      print(f\"Finding Batch-Robust HVGs with n_top_genes={n_genes}...\")\n      adata_hvg = adata.copy()\n      sc.pp.normalize_total(adata_hvg,\
    \ target_sum=1e4)\n      sc.pp.log1p(adata_hvg)\n      batches = adata_hvg.obs['batch'].unique()\n      hvg_sets = []\n      for batch in batches:\n          batch_data = adata_hvg[adata_hvg.obs['batch'] == batch]\n          sc.pp.highly_variable_genes(batch_data, n_top_genes=n_genes, flavor='seurat_v3')\n          hvg_sets.append(set(batch_data.var_names[batch_data.var['highly_variable']]))\n      robust_hvgs = set.intersection(*hvg_sets)\n      print(f\"Found {len(robust_hvgs)} robust HVGs.\")\n      return list(robust_hvgs)\n\n  def _fw_weight_by_var(Xd: np.ndarray, alpha: float) -> np.ndarray:\n      var_g = Xd.var(axis=0, ddof=1).astype(np.float32) + 1e-8\n      w = np.power(var_g, -0.5 * alpha).astype(np.float32)\n      return Xd * w\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      \"\"\"\n      Generalization Test: Combines hard selection (Batch-Robust HVG) and\n      soft selection (FWPCA) on a simple Combat baseline.\n      \"\"\"\n      print(\"[daedalus_generalization]\
    \ Batch-Robust HVGs + FWPCA + Combat\")\n      \n      # Step 1: Hard selection\n      robust_hvg_names = get_batch_robust_hvgs(adata, n_genes=2000)\n      adata.var['highly_variable'] = adata.var_names.isin(robust_hvg_names)\n      \n      # Standard preprocessing\n      sc.pp.normalize_total(adata, target_sum=1e4)\n      sc.pp.log1p(adata)\n      \n      adata_combat = adata[:, adata.var.highly_variable].copy()\n      \n      # Step 2: Soft weighting\n      Xd = adata_combat.X.toarray()\n      X_weighted = _fw_weight_by_var(Xd, alpha=0.5)\n      adata_combat.X = X_weighted\n      \n      # Step 3: Run Combat on weighted data from the robust gene set\n      sc.pp.combat(adata_combat, key='batch')\n      \n      # Final PCA for embedding output\n      sc.pp.pca(adata_combat, n_comps=50)\n      adata.obsm['X_emb'] = adata_combat.obsm['X_pca']\n      \n      return adata\n```"
