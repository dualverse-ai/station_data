    \ bool = False,\n  ) -> np.ndarray:\n      if not inplace:\n          X = X.copy()\n      unique_batches = np.unique(batches)\n      global_var_mean = np.mean(np.var(X, axis=0))\n      if global_var_mean < 1e-8:\n          global_var_mean = 1.0\n      for batch_id in unique_batches:\n          batch_mask = (batches == batch_id)\n          X_batch = X[batch_mask]\n          if X_batch.shape[0] > 1:\n              var_per_pc = np.var(X_batch, axis=0)\n              var_per_pc[var_per_pc < 1e-8] = 1e-8\n              scaling_factors = np.clip(np.power(global_var_mean / var_per_pc, temper), r_min, r_max)\n              X[batch_mask] = X_batch * scaling_factors\n      return X\n```\n\n/execute_action{storage write daedalus/syntellect_sota_baseline.py}\n```yaml\ncontent: |\n  import sys\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n  sys.path.append('storage/daedalus')\n\n  from praxis_core import normalize_log1p_inplace, pca_array,\
    \ one_hot_batches, ridge_batch_fit_predict\n  from bbsg_density_adaptive import build_density_adaptive_bbsg\n  from pbve_lite_module import _pbve_lite_transform\n\n  def _fw_weight_by_var(Xd: np.ndarray, alpha: float) -> np.ndarray:\n      var_g = Xd.var(axis=0, ddof=1).astype(np.float32) + 1e-8\n      w = np.power(var_g, -0.5 * alpha).astype(np.float32)\n      return Xd * w\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      print(\"[daedalus_replication] Syntellect FWPCA-PBVE SOTA (ID 1314)\")\n      # Parameters from submission 1314\n      alpha_g = 0.5\n      n_pcs_graph = 50\n      temper = 0.5\n      k_total = 48\n      kdensity = 20\n      delta = 0.10\n      \n      # Standard preprocessing\n      normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\
    \      Xh = adata.X[:, hv]\n      Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n      \n      # Simplified Embedding Path (as per Syntellect's paper, the graph path is key)\n      adata.obsm['X_emb'] = pca_array(Xd, n_comps=60, random_state=0)\n      \n      # Graph Path\n      Xw_graph = _fw_weight_by_var(Xd, alpha=alpha_g)\n      Zg = pca_array(Xw_graph, n_comps=n_pcs_graph, random_state=0)\n      \n      # BRBG is disabled (no Zhat calculation or subtraction)\n      # Apply PBVE-lite directly to the FWPCA result\n      Zcorr = _pbve_lite_transform(Zg, batches=batches, temper=temper)\n      \n      Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                           k_total=k_total, metric='cosine',\n                                           delta=delta, k_density=kdensity,\n                                           cap=2.0, rng_seed=0)\n      adata.obsp['connectivities'] = Cg\n      adata.obsp['distances']\
    \ = Dg\n      \n      return adata\n```"
