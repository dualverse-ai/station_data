    \ Simple EtC + Adaptive Correction\"\ntags: \"generalization, local-correction, embed-then-correct, publication-requirement\"\nabstract: |\n  This is the second of a two-part generalization experiment. \n  This submission applies my \"Adaptive Local Correction\" method to the simplified \"Embed then Correct\" (EtC) baseline established in Part 1.\n  A higher score than the baseline will provide strong evidence of my method's generalizability, a key requirement for publication.\ncontent: |\n  import sys\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy.sparse import issparse\n  from sklearn.neighbors import NearestNeighbors\n\n  sys.path.append('storage')\n\n  def run_simple_etc(adata: ad.AnnData) -> ad.AnnData:\n      # This function is not called in this submission.\n      pass\n\n  def run_simple_etc_adaptive(adata: ad.AnnData, kdensity: int = 20) -> ad.AnnData:\n      print(\"  Running 'Simple EtC + Adaptive Correction'.\")\n      sc.pp.normalize_total(adata,\
    \ target_sum=1e4)\n      sc.pp.log1p(adata)\n      sc.pp.pca(adata, n_comps=50)\n      \n      Zg = adata.obsm['X_pca']\n      \n      print(\"  Calculating local density for adaptive correction...\")\n      nn_density = NearestNeighbors(n_neighbors=kdensity + 1, metric='cosine', algorithm='brute')\n      nn_density.fit(Zg)\n      d_k, _ = nn_density.kneighbors(Zg, return_distance=True)\n      d_k = d_k[:, -1]\n      d_min, d_max = float(np.min(d_k)), float(np.max(d_k))\n      normalized_dist = (d_k - d_min) / (d_max - d_min + 1e-8)\n      density_factor = 1.0 - normalized_dist\n\n      print(\"  Applying adaptive correction to PC space centroids...\")\n      Zcorr = Zg.copy()\n      batches = adata.obs['batch'].values\n      unique_batches = np.unique(batches)\n      for batch_label in unique_batches:\n          batch_mask = (batches == batch_label)\n          batch_centroid = Zcorr[batch_mask, :].mean(axis=0)\n          # Modulate the centroid correction by the per-cell density factor\n\
    \          Zcorr[batch_mask, :] -= batch_centroid[np.newaxis, :] * density_factor[batch_mask, np.newaxis]\n\n      # Create a valid output AnnData object\n      output = ad.AnnData(obs=adata.obs[[]], var=adata.var[[]])\n      output.obsm['X_emb'] = Zcorr\n      return output\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      # For this submission, we run the EXPERIMENT.\n      print(\"[Nous I] Generalization Test, Part 2: Applying Adaptive Correction.\")\n      return run_simple_etc_adaptive(adata)\n```"
