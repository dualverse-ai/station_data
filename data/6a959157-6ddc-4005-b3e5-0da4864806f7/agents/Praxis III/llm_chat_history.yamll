    \ (δ=0.15): Synergy Test | Praxis II | 359 | 0.7365 | 0.760 | 0.659 | 0.248 | 0.352 | 0.946 | 0.711 | 1.000 | 0.966 | 0.930 | 0.791 |\n| 809 | 1 | Lam Sweep B (module‑parity): BRBG(λ=0.6) + DAQB(δ=0.10, kd=20, k=48) | Praxis II | 516 | 0.7364 | 0.761 | 0.659 | 0.248 | 0.327 | 0.946 | 0.712 | 1.000 | 0.966 | 0.951 | 0.793 |\n| 485 | 1 | EtC(FWPCA α=0.5) + BRBG + BBSG: Feature-Weighted PCA Embedding + Column-Balanced Graph | Praxis I | 287 | 0.7363 | 0.744 | 0.659 | 0.248 | 0.373 | 0.946 | 0.703 | 1.000 | 0.967 | 0.935 | 0.788 |\n| 465 | 1 | EtC-BRBG + BBSG(alpha=1.0, cap=2.0): Light Column-Balanced Balanced kNN (binary) | Praxis I | 273 | 0.7362 | 0.744 | 0.681 | 0.218 | 0.385 | 0.946 | 0.703 | 1.000 | 0.967 | 0.935 | 0.783 |\n| 808 | 1 | Lam Sweep A (module‑parity): BRBG(λ=0.4) + DAQB(δ=0.10, kd=20, k=48) | Praxis II | 516 | 0.7361 | 0.761 | 0.659 | 0.248 | 0.327 | 0.946 | 0.712 | 1.000 | 0.967 | 0.952 | 0.788 |\n| 845 | 1 | MPB‑GraphFWPCA: λ=0.5, δ=0.10, kd=20, k=48 (feature‑weighted\
    \ PCA on graph path) | Praxis II | 548 | 0.7360 | 0.770 | 0.659 | 0.248 | 0.269 | 0.965 | 0.727 | 1.000 | 0.973 | 0.960 | 0.789 |\n| 823 | 1 | Auto‑λ v2 (mean target): BRBG(λ from mean shrinkage target_s=0.04) + DAQB(δ=0.10, kd=20, k=48) | Praxis II | 523 | 0.7360 | 0.760 | 0.659 | 0.248 | 0.327 | 0.946 | 0.711 | 1.000 | 0.966 | 0.951 | 0.790 |\n| 844 | 1 | Auto-λ v2 (mean-target=0.06): δ=0.10, kd=18, k=48 (MPB protocol) | Praxis II | 546 | 0.7360 | 0.760 | 0.659 | 0.248 | 0.331 | 0.946 | 0.710 | 1.000 | 0.966 | 0.951 | 0.789 |\n| 843 | 1 | Auto-λ v2 (mean-target=0.06): δ=0.10, kd=20, k=48 (MPB protocol) | Praxis II | 546 | 0.7357 | 0.760 | 0.659 | 0.248 | 0.327 | 0.946 | 0.709 | 1.000 | 0.966 | 0.951 | 0.791 |\n| 820 | 1 | Auto‑λ (φ=0.08): BRBG(λ from R² quantile, φ=0.08) + DAQB(δ=0.10, kd=20, k=48) | Praxis II | 521 | 0.7356 | 0.760 | 0.659 | 0.248 | 0.327 | 0.945 | 0.710 | 1.000 | 0.966 | 0.951 | 0.791 |\n| 657 | 1 | BRBG-AR(interactions, counts-only): B×log_total_counts + DAQB |\
    \ Praxis II | 395 | 0.7356 | 0.760 | 0.659 | 0.248 | 0.337 | 0.956 | 0.709 | 1.000 | 0.966 | 0.929 | 0.792 |\n\nPage 1 of 17 (sorted by: score)\n\n(Use `/execute_action{page N}` to navigate pages 1-17, `/execute_action{rank mode}` to change sort order, `/execute_action{page_size N}` to set page size, `/execute_action{filter tag}` to filter by tag.)\n\n**Read Contents:**\n\n**praxis/praxis_default.py:**\n```\nimport sys\nsys.path.append('storage')\n\nimport numpy as np\nimport scanpy as sc\nimport anndata as ad\nfrom scipy import sparse as sp\nfrom praxis.graph_bbsg import _build_bbsg\n\n# Praxis default: EtC(FWPCA α=0.5; PCA60→ComBat PCs) + BRBG(lam=0.9, γ_max=0.74 on PCA50) + BBSG (binary, k=48, cosine)\n# Notes:\n# - Keep embedding and graph paths separate (do not build graph on X_emb).\n# - Write BOTH obsp['connectivities'] (binary CSR) and obsp['distances'] (true metric distances).\n# - Use categorical batches consistently.\n\ndef _normalize_log1p_inplace(adata: ad.AnnData, target_sum:\
    \ float = 1e4):\n    if 'counts' in adata.layers:\n        adata.X = adata.layers['counts'].copy()\n    sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n    sc.pp.log1p(adata)\n\ndef _pca_array(X, n_comps=50, random_state=0):\n    Xd = X.A if sp.issparse(X) else X\n    ad_tmp = ad.AnnData(Xd)\n    sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n    return ad_tmp.obsm['X_pca']\n\ndef _one_hot_batches(batches: np.ndarray):\n    cats = np.unique(batches)\n    n = batches.shape[0]\n    B = np.zeros((n, cats.size), dtype=float)\n    for j, c in enumerate(cats):\n        B[:, j] = (batches == c).astype(float)\n    return B\n\ndef _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n    BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n    W = np.linalg.solve(BTB, B.T @ Z)\n    Zhat = B @ W\n    return Zhat\n\ndef _recompute_distances_from_connectivities(C: sp.csr_matrix, Z: np.ndarray, metric: str = 'cosine',\n\
    \                                             chunk_size: int = 200000) -> sp.csr_matrix:\n    \"\"\"\n    Recompute true pairwise distances for the nonzero pattern in C using representation Z.\n    - metric='cosine': d = 1 - (z_i · z_j) / (||z_i|| ||z_j|| + eps)\n    - metric='euclidean': d = ||z_i - z_j||\n    Returns CSR with same sparsity pattern and sorted indices.\n    \"\"\"\n    C = C.tocsr()\n    n = C.shape[0]\n    I = np.repeat(np.arange(n, dtype=np.int32), np.diff(C.indptr))\n    J = C.indices.copy()\n    m = I.shape[0]\n\n    if m == 0:\n        return sp.csr_matrix(C.shape, dtype=np.float32)\n\n    Z = np.asarray(Z, dtype=np.float32, order='C')\n    if metric == 'cosine':\n        norms = np.linalg.norm(Z, axis=1).astype(np.float32) + 1e-8\n\n    dist_data = np.empty(m, dtype=np.float32)\n    for s in range(0, m, chunk_size):\n        e = min(m, s + chunk_size)\n        Ii = I[s:e]\n        Jj = J[s:e]\n        Zi = Z[Ii]\n        Zj = Z[Jj]\n        if metric == 'cosine':\n\
    \            dots = np.einsum('ij,ij->i', Zi, Zj)\n            denom = norms[Ii] * norms[Jj]\n            sim = dots / denom\n            dist = 1.0 - np.clip(sim, -1.0, 1.0)\n        else:  # euclidean\n            diff = Zi - Zj\n            dist = np.sqrt(np.einsum('ij,ij->i', diff, diff))\n        dist_data[s:e] = dist.astype(np.float32)\n\n    D = sp.csr_matrix((dist_data, C.indices.copy(), C.indptr.copy()), shape=C.shape, dtype=np.float32)\n    D.sort_indices()\n    # Symmetrize distances using maximum to ensure undirected metric consistency on kNN\n    D = D.maximum(D.T)\n    return D\n\ndef eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n    # Config (frozen default)\n    n_pcs_emb = 60\n    n_pcs_graph = 50\n    l2 = 1e-3\n    gamma_max = 0.74\n    lam = 0.9\n    k_total = 48\n    metric = 'cosine'\n    alpha_weight = 0.5\n    emb_n_neighbors = 15  # for clustering; graph path provides structure\n    random_state = 0\n\n    assert 'batch' in adata.obs.columns and\
    \ 'feature_name' in adata.var.columns\n\n    # Normalize + HVGs\n    _normalize_log1p_inplace(adata, 1e4)\n    sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n    hv = adata.var['highly_variable'].to_numpy()\n    batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n    # Embedding (EtC): FWPCA (var^{-α/2}) → PCA60 → ComBat on PC scores\n    Xh = adata.X[:, hv]\n    Xd = Xh.A if sp.issparse(Xh) else Xh\n    Xd = Xd.astype(np.float32, copy=False)\n    var_g = Xd.var(axis=0, ddof=1) + 1e-8\n    w = np.power(var_g, -0.5 * alpha_weight).astype(np.float32)  # α=0.5\n    Xw = Xd * w\n    ad_emb = ad.AnnData(Xw, obs=adata.obs[['batch']].copy())\n    sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=random_state)\n    Z = ad_emb.obsm['X_pca']\n    ad_pc = ad.AnnData(Z.copy(), obs=adata.obs[['batch']].copy())\n    sc.pp.combat(ad_pc, key='batch')\n    adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n\
    \    sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n    # Graph (BRBG): PCA50 → adaptive residualization → BBSG (binary)\n    Zg = _pca_array(Xd, n_comps=n_pcs_graph, random_state=random_state)\n    B = _one_hot_batches(batches)\n    Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2)\n    var_total = Zg.var(axis=0, ddof=1) + 1e-8\n    var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n    R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n    gamma = np.minimum(gamma_max, lam * R2)\n    Zcorr = Zg - (Zhat * gamma)\n\n    Cg, Dg = _build_bbsg(Zcorr.astype(np.float32), batches=batches, k_total=k_total,\n                         metric=metric, alpha=1.0, cap=2.0)\n    if Cg is not None:\n        # Recompute true distances on the BBSG sparsity pattern to ensure LISI compatibility\n        Dfix = _recompute_distances_from_connectivities(Cg, Zcorr.astype(np.float32), metric=metric)\n        adata.obsp['connectivities'] = Cg  # binary CSR\n        adata.obsp['distances']\
    \ = Dfix      # true distances aligned to Cg\n    return adata\n\n```\n---\n**praxis/praxis_core.py:**\n```\nimport numpy as np\nimport scanpy as sc\nimport anndata as ad\nfrom scipy import sparse as sp\nfrom typing import Tuple, Literal\nfrom praxis.graph_bbsg import _build_bbsg\n\n# Core utilities for Praxis EtC-BRBG+BBSG pipelines.\n\ndef normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n    if 'counts' in adata.layers:\n        adata.X = adata.layers['counts'].copy()\n    sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n    sc.pp.log1p(adata)\n\ndef pca_array(X, n_comps: int = 50, random_state: int = 0):\n    Xd = X.A if sp.issparse(X) else X\n    ad_tmp = ad.AnnData(Xd)\n    sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n    return ad_tmp.obsm['X_pca']\n\ndef one_hot_batches(batches: np.ndarray):\n    cats = np.unique(batches)\n    n = batches.shape[0]\n    B = np.zeros((n, cats.size), dtype=float)\n    for\
    \ j, c in enumerate(cats):\n        B[:, j] = (batches == c).astype(float)\n    return B\n\ndef ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n    BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n    W = np.linalg.solve(BTB, B.T @ Z)\n    return B @ W  # Zhat\n\ndef residualize_pcs(\n    Xd: np.ndarray,\n    batches: np.ndarray,\n    n_pcs: int = 50,\n    l2: float = 1e-3,\n    lam: float = 0.9,\n    gamma_max: float = 0.74,\n    schedule: Literal['linear', 'power'] = 'linear',\n    p_exp: float = 1.0,\n    random_state: int = 0,\n) -> Tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:\n    \"\"\"\n    PCA on Xd -> per-PC batch ridge -> compute R2 -> shrink predicted batch signal.\n    Returns: Z (raw PCs), Zcorr (residualized), R2 (per-PC), gamma (per-PC).\n    \"\"\"\n    Z = pca_array(Xd, n_comps=n_pcs, random_state=random_state)\n    B = one_hot_batches(batches)\n    Zhat = ridge_batch_fit_predict(B, Z, l2=l2)\n    var_total = Z.var(axis=0, ddof=1)\
    \ + 1e-8\n    var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n    R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n    if schedule == 'power':\n        gamma = np.minimum(gamma_max, lam * np.power(R2, p_exp))\n    else:\n        gamma = np.minimum(gamma_max, lam * R2)\n    Zcorr = Z - (Zhat * gamma)\n    return Z, Zcorr, R2, gamma\n\ndef build_bbsg_graph(\n    Zcorr: np.ndarray,\n    batches: np.ndarray,\n    k_total: int = 48,\n    metric: str = 'cosine',\n    alpha: float = 1.0,\n    cap: float = 2.0,\n):\n    \"\"\"\n    Construct BBSG graph (binary connectivities, original distances).\n    \"\"\"\n    Cg, Dg = _build_bbsg(Zcorr.astype(np.float32), batches=batches, k_total=k_total,\n                         metric=metric, alpha=alpha, cap=cap)\n    return Cg, Dg\n\n```\n---\n**praxis/balanced_graph.py:**\n```\nimport numpy as np\nfrom sklearn.neighbors import NearestNeighbors\nfrom scipy.sparse import coo_matrix, csr_matrix\n\ndef build_balanced_knn(\n    Z,\n    batches,\n   \
    \ n_neighbors_total=15,\n    metric='euclidean',\n    weighting='binary',      # 'binary' or 'gaussian'\n    allocation='equal',      # 'equal' or 'proportional'\n    mutual=False,            # keep edge only if i in N(j) and j in N(i)\n    symmetric=True           # symmetrize final graph\n):\n    \"\"\"\n    Build a batch-balanced kNN graph over embedding Z.\n\n    Strategy:\n    - For each batch b, fit a NN index on cells from batch b.\n    - For each query cell i, retrieve k_b neighbors from batch b (dropping self if present).\n    - Aggregate across batches to approximate ~n_neighbors_total per node.\n    - If mutual=True, keep only pairs that appear in both directions (i->j and j->i).\n    - Distances are stored; connectivities are either binary or gaussian-weighted.\n\n    Parameters:\n      Z: (n, d) embedding (np array)\n      batches: (n,) array-like batch labels\n      n_neighbors_total: desired total neighbors per node after combining batches\n      metric: NN distance metric\n\
    \      weighting:\n        - 'binary': connectivities = 1.0 on edges\n        - 'gaussian': exp(-d^2/(2*s_bar^2)), s_bar from per-node median distances\n      allocation:\n        - 'equal': k_b = ceil(n_neighbors_total / B) for all batches (B = #unique batches)\n        - 'proportional': k_b ∝ batch size; k_b >= 1\n      mutual: retain only edges observed in both directions\n      symmetric: ensure C and D are symmetric\n\n    Returns:\n      C: CSR connectivities (n x n)\n      D: CSR distances (n x n)\n    \"\"\"\n    Z = np.asarray(Z, dtype=np.float32)\n    batches = np.asarray(batches)\n    uniq = np.unique(batches)\n    n = Z.shape[0]\n    B = len(uniq)\n    if n == 0 or B == 0:\n        return None, None\n\n    # Determine per-batch neighbor quotas k_b\n    counts = {b: int((batches == b).sum()) for b in uniq}\n    if allocation == 'proportional':\n        total = float(n)\n        k_map = {}\n        # round and ensure at least 1\n        for b in uniq:\n            frac = counts[b]\
    \ / total if total > 0 else 0.0\n            k_map[b] = max(1, int(round(n_neighbors_total * frac)))\n        # fallback guarantee: ensure at least 1 per batch and nonzero total\n        if sum(k_map.values()) == 0:\n            for b in uniq:\n                k_map[b] = 1\n    else:\n        base = max(1, int(np.ceil(n_neighbors_total / max(1, B))))\n        k_map = {b: base for b in uniq}\n\n    # Gather directed edges (i->j) with minimal distances\n    dir_edges = {}  # (i,j) -> dist\n\n    for b in uniq:\n        idx_train = np.where(batches == b)[0]\n        if idx_train.size == 0:\n            continue\n        k_b = k_map[b]\n        k_query = min(k_b + 1, idx_train.size)  # +1 to allow self, will drop later\n        nn = NearestNeighbors(n_neighbors=k_query, metric=metric, algorithm='auto')\n        nn.fit(Z[idx_train])\n\n        # Query using all cells\n        dists, inds = nn.kneighbors(Z, n_neighbors=k_query, return_distance=True)\n        neigh_global = idx_train[inds]\
    \  # map batch-local to global indices\n\n        for i in range(n):\n            g = neigh_global[i]\n            di = dists[i]\n            mask = g != i\n            g = g[mask][:k_b]\n            di = di[mask][:k_b]\n            for j, d in zip(g, di):\n                if i == j:\n                    continue\n                key = (int(i), int(j))\n                prev = dir_edges.get(key)\n                if (prev is None) or (d < prev):\n                    dir_edges[key] = float(d)\n\n    # Convert to undirected pairs with minimum distance rule\n    pairs = {}\n    if mutual:\n        # keep only if both directions exist\n        for (i, j), d_ij in dir_edges.items():\n            if (j, i) in dir_edges:\n                d_ji = dir_edges[(j, i)]\n                d = min(d_ij, d_ji)\n                a, c = (i, j) if i < j else (j, i)\n                prev = pairs.get((a, c))\n                if (prev is None) or (d < prev):\n                    pairs[(a, c)] = d\n    else:\n \
    \       # keep if either direction exists, using min distance if both\n        for (i, j), d_ij in dir_edges.items():\n            a, c = (i, j) if i < j else (j, i)\n            d = d_ij\n            if (j, i) in dir_edges:\n                d = min(d, dir_edges[(j, i)])\n            prev = pairs.get((a, c))\n            if (prev is None) or (d < prev):\n                pairs[(a, c)] = d\n\n    if not pairs:\n        return None, None\n\n    # Build symmetric distance matrix\n    rows, cols, dist_data = [], [], []\n    for (i, j), d in pairs.items():\n        rows.append(i); cols.append(j); dist_data.append(d)\n        if symmetric:\n            rows.append(j); cols.append(i); dist_data.append(d)\n\n    D = coo_matrix((dist_data, (rows, cols)), shape=(n, n)).tocsr()\n\n    # Connectivities\n    if weighting == 'binary':\n        C = D.copy()\n        C.data[:] = 1.0\n        return C.tocsr(), D\n    elif weighting == 'gaussian':\n        # Per-node scale: median incident distance (fallback\
    \ to global median)\n        s = np.zeros(n, dtype=np.float32)\n        for i in range(n):\n            start, end = D.indptr[i], D.indptr[i+1]\n            di = D.data[start:end]\n            if di.size > 0:\n                s[i] = np.median(di)\n        global_med = np.median(D.data) if D.nnz > 0 else 1.0\n        s[s <= 0] = global_med if global_med > 0 else 1.0\n\n        rows_w, cols_w, w_data = [], [], []\n        for i in range(n):\n            start, end = D.indptr[i], D.indptr[i+1]\n            js = D.indices[start:end]\n            di = D.data[start:end]\n            if js.size == 0:\n                continue\n            s_bar = 0.5 * (s[i] + s[js])\n            denom = 2.0 * (s_bar * s_bar) + 1e-12\n            w = np.exp(- (di * di) / denom).astype(np.float32)\n            rows_w.extend([i] * len(js)); cols_w.extend(js.tolist()); w_data.extend(w.tolist())\n\n        C = coo_matrix((w_data, (rows_w, cols_w)), shape=(n, n)).tocsr()\n        if symmetric:\n            C = C.maximum(C.transpose()).tocsr()\n\
    \        return C, D\n    else:\n        C = D.copy()\n        C.data[:] = 1.0\n        return C.tocsr(), D\n\n```\n---\n**shared/algorithms/daqb_recommended.py:**\n```\n\"\"\"\nDAQB Recommended Pipeline (Heart) with Auto-λ v2 (mean-target) default.\nVersion: v2.1 (delta default set to 0.10 per community consensus)\nNotes:\n  - Heart ridge under module-parity builder + neighbors:\n      λ≈0.5–0.6, δ=0.10, kd=20, k=48, cosine (binary edges + true distances).\n  - References:\n      • Praxis II λ sweep: EIDs 808=0.7361 (λ=0.4), 809=0.7364 (λ=0.6), 801=0.7356 (λ=0.5) at δ=0.10, kd=20.\n      • Auto-λ v2: EID 823=0.7360 (δ=0.10, kd=20, λ=0.6265); EID 828=0.7343 (δ=0.15, kd=20).\n      • Wrapper parity: EID 832=0.7341 (δ=0.15, kd=20).\n      • Sophia III kd sweep: kd=20 @ δ=0.15 best (Public #3).\n      • Pioneer I replication of Logos V: EID 834=0.7418 (lam=0.5, δ=0.10, kd=20).\n  - Critical: run sc.pp.neighbors on X_emb (EtC) before graph; omitting collapses iLISI (cf. EID 816).\n\"\"\"\
    \n\nimport sys\nimport numpy as np\nimport scanpy as sc\nimport anndata as ad\nfrom scipy.sparse import issparse\n\nsys.path.append('storage/praxis')\nfrom bbsg_density_adaptive import build_density_adaptive_bbsg\n\nsys.path.append('storage/shared/diagnostics')\ntry:\n    from lam_autoselect2 import choose_lambda_from_r2_mean\n    _HAS_AUTO = True\nexcept Exception:\n    _HAS_AUTO = False\n\n# --- Config (consensus defaults) ---\nAUTO_LAMBDA = True\nTARGET_S = 0.04           # mean-target Auto-λ v2 (lands λ≈0.6 on Heart)\nLAM_FIXED = 0.60          # fallback if auto selector unavailable\nKDENSITY = 20\nDELTA = 0.10              # switched default from 0.15 -> 0.10 (consensus)\nK_TOTAL = 48\nGAMMA_MAX = 0.74\nL2 = 1e-3\nPCA_EMB = 60\nPCA_GRAPH = 50\nALPHA_VAR = 0.5\nMETRIC = 'cosine'\nEMB_N_NEIGHBORS = 15\n\ndef _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n    if 'counts' in adata.layers:\n        adata.X = adata.layers['counts'].copy()\n    sc.pp.normalize_total(adata,\
    \ target_sum=target_sum, inplace=True)\n    sc.pp.log1p(adata)\n\ndef _pca_array(X, n_comps=50, random_state=0):\n    Xd = X.A if issparse(X) else X\n    ad_tmp = ad.AnnData(Xd)\n    sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n    return ad_tmp.obsm['X_pca']\n\ndef _one_hot_batches(batches: np.ndarray):\n    cats = np.unique(batches)\n    n = batches.shape[0]\n    B = np.zeros((n, cats.size), dtype=float)\n    for j, c in enumerate(cats):\n        B[:, j] = (batches == c).astype(float)\n    return B\n\ndef _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n    BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n    W = np.linalg.solve(BTB, B.T @ Z)\n    return B @ W\n\ndef eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n    assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n    _normalize_log1p_inplace(adata, 1e4)\n    sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch',\
    \ n_top_genes=2000, inplace=True)\n    hv = adata.var['highly_variable'].to_numpy()\n    batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n    # EtC embedding (QC only) + neighbors side-effect\n    Xh = adata.X[:, hv]\n    Xd = (Xh.A if issparse(Xh) else Xh).astype(np.float32, copy=False)\n    var_g = Xd.var(axis=0, ddof=1) + 1e-8\n    wv = np.power(var_g, -0.5 * ALPHA_VAR).astype(np.float32)\n    Xw = Xd * wv\n    ad_emb = ad.AnnData(Xw, obs=adata.obs[['batch']].copy())\n    sc.pp.pca(ad_emb, n_comps=PCA_EMB, svd_solver='arpack', random_state=0)\n    ad_pc = ad.AnnData(ad_emb.obsm['X_pca'].copy(), obs=adata.obs[['batch']].copy())\n    sc.pp.combat(ad_pc, key='batch')\n    adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n    sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=EMB_N_NEIGHBORS, metric=METRIC)\n\n    # Graph PCs\n    Zg = _pca_array(Xd, n_comps=PCA_GRAPH, random_state=0)\n\n    # Auto-λ v2 (mean-target) or fixed λ\n    lam = LAM_FIXED\n \
    \   if AUTO_LAMBDA and _HAS_AUTO:\n        try:\n            lam = float(choose_lambda_from_r2_mean(Zg, batches, gamma_max=GAMMA_MAX, target_s=TARGET_S, lam_min=0.2, lam_max=1.0, l2=L2))\n            print(f\"[daqb_recommended] auto_lambda_v2: target_s={TARGET_S:.4f} -> lam={lam:.4f}\")\n        except Exception as e:\n            print(f\"[daqb_recommended] auto_lambda_v2 failed ({e}); falling back to fixed lam={LAM_FIXED:.2f}\")\n\n    # Residualization\n    B = _one_hot_batches(batches)\n    Zhat = _ridge_batch_fit_predict(B, Zg, l2=L2)\n    var_total = Zg.var(axis=0, ddof=1) + 1e-8\n    var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n    R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n    gamma = np.minimum(GAMMA_MAX, lam * R2)\n    Zcorr = Zg - (Zhat * gamma)\n\n    # DAQB graph (module-parity builder): binary connectivities + true distances\n    Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                         k_total=K_TOTAL,\
    \ metric=METRIC,\n                                         delta=DELTA, k_density=KDENSITY, rng_seed=0)\n    adata.obsp['connectivities'] = Cg\n    adata.obsp['distances'] = Dg\n    return adata\n\n```\n---\n**shared/algorithms/daqb_mpb_graphfwpca.py:**\n```\nimport sys\nimport numpy as np\nimport scanpy as sc\nimport anndata as ad\nfrom scipy import sparse as sp\nfrom sklearn.neighbors import NearestNeighbors\n\n# Optional import for Auto-λ v2 mean-target selection\ntry:\n    from shared.diagnostics.lam_autoselect2 import autoselect_lambda_mean_target\nexcept Exception:\n    # Fallback shim: fixed λ if import unavailable\n    def autoselect_lambda_mean_target(R2, gamma_max=0.74, target_mean=0.04, **_):\n        return 0.60\n\n# ------------ Utilities ------------\ndef _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n    if 'counts' in adata.layers:\n        adata.X = adata.layers['counts'].copy()\n    sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n\
    \    sc.pp.log1p(adata)\n\ndef _pca_on_dense(Xd: np.ndarray, n_comps: int, random_state: int = 0) -> np.ndarray:\n    ad_tmp = ad.AnnData(Xd)\n    sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n    return ad_tmp.obsm['X_pca']\n\ndef _one_hot_batches(batches: np.ndarray) -> np.ndarray:\n    cats = np.unique(batches)\n    B = np.zeros((batches.shape[0], cats.size), dtype=np.float32)\n    for j, c in enumerate(cats):\n        B[:, j] = (batches == c).astype(np.float32)\n    return B\n\ndef _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3) -> np.ndarray:\n    # Solve W = (B^T B + l2 I)^{-1} B^T Z\n    BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=np.float32)\n    W = np.linalg.solve(BTB, B.T @ Z)\n    return B @ W\n\ndef _symmetrize_binary_with_distances(rows, cols, dists, n):\n    A = sp.coo_matrix((np.ones_like(dists, dtype=np.float32), (rows, cols)), shape=(n, n)).tocsr()\n    D = sp.coo_matrix((np.asarray(dists, dtype=np.float32),\
    \ (rows, cols)), shape=(n, n)).tocsr()\n    A = A.maximum(A.T); D = D.maximum(D.T)\n    A.eliminate_zeros(); D.eliminate_zeros()\n    return A, D\n\n# ------------ DAQB (density-adaptive quotas with column balancing) ------------\ndef _build_daqb(Zcorr: np.ndarray, batches, k_total=48, metric='cosine',\n                delta=0.10, k_density=20, cap=2.0, rng_seed=0):\n    \"\"\"\n    Density-adaptive quota-balanced graph on Zcorr:\n      - f_cross per cell from distance to k_density-th NN across all batches.\n      - Even per-batch quotas with remainder to closest batches.\n      - Hard inbound cap (cap*k_total); binary edges; store true distances; symmetric.\n    \"\"\"\n    rng = np.random.default_rng(rng_seed)\n    Z = np.asarray(Zcorr, dtype=np.float32, order='C')\n    n = Z.shape[0]\n    batches = np.asarray(batches)\n    cats = np.unique(batches)\n    nB = len(cats)\n    base_cross = (nB - 1) / float(nB)\n    L, U = 0.60, 0.90\n\n    # All-batch density proxy\n    nn_all = NearestNeighbors(n_neighbors=k_density\
    \ + 1, metric=metric, algorithm='brute')\n    nn_all.fit(Z)\n    d_all, _ = nn_all.kneighbors(Z, return_distance=True)\n    d_k = d_all[:, -1]\n    d_min, d_max = float(np.min(d_k)), float(np.max(d_k) + 1e-8)\n    inv_dense = 1.0 - (d_k - d_min) / (d_max - d_min + 1e-8)\n    f_cross = np.clip(base_cross + (inv_dense - 0.5) * 2.0 * delta, L, U)\n\n    q_cross_tot = np.rint(f_cross * k_total).astype(int)\n    q_within_tot = k_total - q_cross_tot\n    B_other = max(nB - 1, 1)\n\n    # Neighbor list sizes (upper bounds)\n    k_within_max = int(np.ceil((1.0 - L) * k_total))\n    k_cross_per_max = int(np.ceil(U * k_total / B_other))\n    k_max = max(k_within_max, k_cross_per_max) + 1  # +1 to skip self\n\n    # Fit per-batch neighbor models\n    cat2code = {c: i for i, c in enumerate(cats)}\n    codes = np.array([cat2code[b] for b in batches], dtype=int)\n    nn_models, train_idx = {}, {}\n    for j, c in enumerate(cats):\n        mask = (batches == c)\n        train_idx[j] = np.where(mask)[0]\n\
    \        m = NearestNeighbors(n_neighbors=k_max, metric=metric, algorithm='brute')\n        m.fit(Z[mask])\n        nn_models[j] = m\n\n    # Precompute queries\n    dists, idx_local = {}, {}\n    for j in range(nB):\n        d, ii = nn_models[j].kneighbors(Z, return_distance=True)\n        dists[j] = d; idx_local[j] = ii\n\n    inbound = np.zeros(n, dtype=np.int32)\n    cap_thr = int(np.ceil(cap * k_total))\n    rows, cols, dvals = [], [], []\n\n    for i in range(n):\n        bi = codes[i]\n        q_within = int(q_within_tot[i])\n        q_cross_total = int(q_cross_tot[i])\n        other = [j for j in range(nB) if j != bi]\n\n        # Even per-batch quotas + remainder to closest batches (by first NN distance)\n        if q_cross_total > 0 and len(other) > 0:\n            base = q_cross_total // B_other\n            rem = q_cross_total - base * B_other\n            scores = [(j, dists[j][i][0]) for j in other]\n            scores.sort(key=lambda t: t[1])\n            q_map = {j: base\
    \ for j in other}\n            for k in range(rem):\n                q_map[scores[k % len(other)][0]] += 1\n        else:\n            q_map = {j: 0 for j in other}\n\n        # Within-batch selection (cap-first, then distance)\n        d_w = dists[bi][i]; ii_w = idx_local[bi][i]\n        start_w = 1 if d_w[0] == 0.0 else 0\n        globals_w = train_idx[bi][ii_w[start_w:]]\n        cand_inb = inbound[globals_w]; cand_dst = d_w[start_w:]\n        order = np.lexsort((cand_dst, cand_inb))\n        taken = 0\n        for idx in order:\n            g = int(globals_w[idx])\n            if inbound[g] >= cap_thr:\n                continue\n            rows.append(i); cols.append(g); dvals.append(float(cand_dst[idx]))\n            inbound[g] += 1; taken += 1\n            if taken >= q_within: break\n        if taken < q_within:\n            for idx in order:\n                g = int(globals_w[idx])\n                if inbound[g] < cap_thr:\n                    continue\n                rows.append(i);\
    \ cols.append(g); dvals.append(float(cand_dst[idx]))\n                inbound[g] += 1; taken += 1\n                if taken >= q_within: break\n\n        # Cross-batch selection per other batch\n        for j in other:\n            qj = q_map[j]\n            if qj <= 0: continue\n            d_c = dists[j][i]; ii_c = idx_local[j][i]\n            globals_c = train_idx[j][ii_c]\n            cand_inb = inbound[globals_c]; cand_dst = d_c\n            order = np.lexsort((cand_dst, cand_inb))\n            taken = 0\n            for idx in order:\n                g = int(globals_c[idx])\n                if inbound[g] >= cap_thr:\n                    continue\n                rows.append(i); cols.append(g); dvals.append(float(cand_dst[idx]))\n                inbound[g] += 1; taken += 1\n                if taken >= qj: break\n            if taken < qj:\n                for idx in order:\n                    g = int(globals_c[idx])\n                    if inbound[g] < cap_thr:\n              \
    \          continue\n                    rows.append(i); cols.append(g); dvals.append(float(cand_dst[idx]))\n                    inbound[g] += 1; taken += 1\n                    if taken >= qj: break\n\n    A_sym, D_sym = _symmetrize_binary_with_distances(\n        np.array(rows, np.int32), np.array(cols, np.int32), np.array(dvals, np.float32), n\n    )\n    return A_sym.astype(np.float32), D_sym.astype(np.float32)\n\n# ------------ Main: MPB-GraphFWPCA ------------\ndef eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n    \"\"\"\n    MPB-GraphFWPCA: Feature-weighted PCA on the graph path, then BRBG + DAQB.\n    Default MPB protocol (Human Heart–tested):\n      - GraphFWPCA α_g=0.5; PCA_graph=50.\n      - Auto-λ v2 mean-target (target_mean=0.04) to choose λ; gamma_max=0.74.\n      - DAQB: k=48, cosine, kd=20, δ=0.10, cap=2.0, binary + true distances.\n      - EtC embedding for QC: FWPCA α=0.5 → PCA(60) → ComBat; neighbors(n=15) to set keys.\n    \"\"\"\n    # Config\n   \
    \ alpha_emb = 0.5\n    n_pcs_emb = 60\n    emb_n_neighbors = 15\n    alpha_g = 0.5\n    n_pcs_graph = 50\n    l2 = 1e-3\n    gamma_max = 0.74\n    target_mean_gamma = 0.04   # mean-target for Auto-λ v2\n    k_total = 48\n    kd = 20\n    delta = 0.10\n    metric = 'cosine'\n    cap = 2.0\n\n    assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n    # Normalize + HVGs\n    _normalize_log1p_inplace(adata, 1e4)\n    sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n    hv = adata.var['highly_variable'].to_numpy()\n    batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n    # EtC embedding (QC only; not used for graph)\n    Xh = adata.X[:, hv]\n    Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n    var_g_emb = Xd.var(axis=0, ddof=1) + 1e-8\n    wv_emb = np.power(var_g_emb, -0.5 * alpha_emb).astype(np.float32)\n    Xw_emb = Xd * wv_emb\n    ad_emb = ad.AnnData(Xw_emb,\
    \ obs=adata.obs[['batch']].copy())\n    sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n    Z_emb = ad_emb.obsm['X_pca']\n    ad_pc = ad.AnnData(Z_emb.copy(), obs=adata.obs[['batch']].copy())\n    sc.pp.combat(ad_pc, key='batch')\n    adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n    sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n    # Graph path: GraphFWPCA (feature weights on HVGs) -> PCA -> residualization (Auto-λ v2) -> DAQB\n    var_g = Xd.var(axis=0, ddof=1) + 1e-8\n    wv_graph = np.power(var_g, -0.5 * alpha_g).astype(np.float32)  # α_g=0.5 best on Heart\n    Xw_graph = Xd * wv_graph\n    Zg = _pca_on_dense(Xw_graph, n_comps=n_pcs_graph, random_state=0)\n\n    # Residualize Zg against batches with per-PC shrinkage γ_j\n    B = _one_hot_batches(batches)\n    Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2)\n    var_total = Zg.var(axis=0, ddof=1) + 1e-8\n    var_pred = np.maximum(Zhat.var(axis=0, ddof=1),\
    \ 0.0)\n    R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n\n    lam = autoselect_lambda_mean_target(R2, gamma_max=gamma_max, target_mean=target_mean_gamma)\n    gamma = np.minimum(gamma_max, lam * R2)\n    Zcorr = Zg - (Zhat * gamma)\n\n    # DAQB graph\n    Cg, Dg = _build_daqb(Zcorr.astype(np.float32), batches=batches, k_total=k_total,\n                         metric=metric, delta=delta, k_density=kd, cap=cap, rng_seed=0)\n    adata.obsp['connectivities'] = Cg\n    adata.obsp['distances'] = Dg\n    # Optionally record settings used\n    adata.uns['mpb_graphfwpca'] = dict(alpha_g=float(alpha_g), lambda_selected=float(lam),\n                                       target_mean_gamma=float(target_mean_gamma),\n                                       kd=int(kd), delta=float(delta), k_total=int(k_total))\n    return adata\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help\
    \ room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
