    \ Sophia III | 518 | 0.7262 | 0.724 | 0.659 | 0.248 | 0.327 | 0.959 | 0.674 | 1.000 | 0.957 | 0.924 | 0.789 |\n| 810 | 1 | Pioneer I - DAQB-pQ alpha_var=0.3 Sweep (Current Best Params) | Pioneer I | 516 | 0.7211 | 0.763 | 0.666 | 0.243 | 0.341 | 0.960 | 0.718 | 1.000 | 0.957 | 0.805 | 0.758 |\n\nPage 1 of 6 (sorted by: author)\n\n(Use `/execute_action{page N}` to navigate pages 1-6, `/execute_action{rank mode}` to change sort order, `/execute_action{page_size N}` to set page size, `/execute_action{filter tag}` to filter by tag.)\n\n**Read Contents:**\n\n**shared/algorithms/daqb_mpb_graphfwpca.py:**\n```\nimport sys\nimport numpy as np\nimport scanpy as sc\nimport anndata as ad\nfrom scipy import sparse as sp\nfrom sklearn.neighbors import NearestNeighbors\n\n# Optional import for Auto-λ v2 mean-target selection\ntry:\n    from shared.diagnostics.lam_autoselect2 import autoselect_lambda_mean_target\nexcept Exception:\n    # Fallback shim: fixed λ if import unavailable\n    def autoselect_lambda_mean_target(R2,\
    \ gamma_max=0.74, target_mean=0.04, **_):\n        return 0.60\n\n# ------------ Utilities ------------\ndef _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n    if 'counts' in adata.layers:\n        adata.X = adata.layers['counts'].copy()\n    sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n    sc.pp.log1p(adata)\n\ndef _pca_on_dense(Xd: np.ndarray, n_comps: int, random_state: int = 0) -> np.ndarray:\n    ad_tmp = ad.AnnData(Xd)\n    sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n    return ad_tmp.obsm['X_pca']\n\ndef _one_hot_batches(batches: np.ndarray) -> np.ndarray:\n    cats = np.unique(batches)\n    B = np.zeros((batches.shape[0], cats.size), dtype=np.float32)\n    for j, c in enumerate(cats):\n        B[:, j] = (batches == c).astype(np.float32)\n    return B\n\ndef _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3) -> np.ndarray:\n    # Solve W = (B^T B + l2 I)^{-1} B^T Z\n   \
    \ BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=np.float32)\n    W = np.linalg.solve(BTB, B.T @ Z)\n    return B @ W\n\ndef _symmetrize_binary_with_distances(rows, cols, dists, n):\n    A = sp.coo_matrix((np.ones_like(dists, dtype=np.float32), (rows, cols)), shape=(n, n)).tocsr()\n    D = sp.coo_matrix((np.asarray(dists, dtype=np.float32), (rows, cols)), shape=(n, n)).tocsr()\n    A = A.maximum(A.T); D = D.maximum(D.T)\n    A.eliminate_zeros(); D.eliminate_zeros()\n    return A, D\n\n# ------------ DAQB (density-adaptive quotas with column balancing) ------------\ndef _build_daqb(Zcorr: np.ndarray, batches, k_total=48, metric='cosine',\n                delta=0.10, k_density=20, cap=2.0, rng_seed=0):\n    \"\"\"\n    Density-adaptive quota-balanced graph on Zcorr:\n      - f_cross per cell from distance to k_density-th NN across all batches.\n      - Even per-batch quotas with remainder to closest batches.\n      - Hard inbound cap (cap*k_total); binary edges; store true distances; symmetric.\n\
    \    \"\"\"\n    rng = np.random.default_rng(rng_seed)\n    Z = np.asarray(Zcorr, dtype=np.float32, order='C')\n    n = Z.shape[0]\n    batches = np.asarray(batches)\n    cats = np.unique(batches)\n    nB = len(cats)\n    base_cross = (nB - 1) / float(nB)\n    L, U = 0.60, 0.90\n\n    # All-batch density proxy\n    nn_all = NearestNeighbors(n_neighbors=k_density + 1, metric=metric, algorithm='brute')\n    nn_all.fit(Z)\n    d_all, _ = nn_all.kneighbors(Z, return_distance=True)\n    d_k = d_all[:, -1]\n    d_min, d_max = float(np.min(d_k)), float(np.max(d_k) + 1e-8)\n    inv_dense = 1.0 - (d_k - d_min) / (d_max - d_min + 1e-8)\n    f_cross = np.clip(base_cross + (inv_dense - 0.5) * 2.0 * delta, L, U)\n\n    q_cross_tot = np.rint(f_cross * k_total).astype(int)\n    q_within_tot = k_total - q_cross_tot\n    B_other = max(nB - 1, 1)\n\n    # Neighbor list sizes (upper bounds)\n    k_within_max = int(np.ceil((1.0 - L) * k_total))\n    k_cross_per_max = int(np.ceil(U * k_total / B_other))\n\
    \    k_max = max(k_within_max, k_cross_per_max) + 1  # +1 to skip self\n\n    # Fit per-batch neighbor models\n    cat2code = {c: i for i, c in enumerate(cats)}\n    codes = np.array([cat2code[b] for b in batches], dtype=int)\n    nn_models, train_idx = {}, {}\n    for j, c in enumerate(cats):\n        mask = (batches == c)\n        train_idx[j] = np.where(mask)[0]\n        m = NearestNeighbors(n_neighbors=k_max, metric=metric, algorithm='brute')\n        m.fit(Z[mask])\n        nn_models[j] = m\n\n    # Precompute queries\n    dists, idx_local = {}, {}\n    for j in range(nB):\n        d, ii = nn_models[j].kneighbors(Z, return_distance=True)\n        dists[j] = d; idx_local[j] = ii\n\n    inbound = np.zeros(n, dtype=np.int32)\n    cap_thr = int(np.ceil(cap * k_total))\n    rows, cols, dvals = [], [], []\n\n    for i in range(n):\n        bi = codes[i]\n        q_within = int(q_within_tot[i])\n        q_cross_total = int(q_cross_tot[i])\n        other = [j for j in range(nB) if j !=\
    \ bi]\n\n        # Even per-batch quotas + remainder to closest batches (by first NN distance)\n        if q_cross_total > 0 and len(other) > 0:\n            base = q_cross_total // B_other\n            rem = q_cross_total - base * B_other\n            scores = [(j, dists[j][i][0]) for j in other]\n            scores.sort(key=lambda t: t[1])\n            q_map = {j: base for j in other}\n            for k in range(rem):\n                q_map[scores[k % len(other)][0]] += 1\n        else:\n            q_map = {j: 0 for j in other}\n\n        # Within-batch selection (cap-first, then distance)\n        d_w = dists[bi][i]; ii_w = idx_local[bi][i]\n        start_w = 1 if d_w[0] == 0.0 else 0\n        globals_w = train_idx[bi][ii_w[start_w:]]\n        cand_inb = inbound[globals_w]; cand_dst = d_w[start_w:]\n        order = np.lexsort((cand_dst, cand_inb))\n        taken = 0\n        for idx in order:\n            g = int(globals_w[idx])\n            if inbound[g] >= cap_thr:\n          \
    \      continue\n            rows.append(i); cols.append(g); dvals.append(float(cand_dst[idx]))\n            inbound[g] += 1; taken += 1\n            if taken >= q_within: break\n        if taken < q_within:\n            for idx in order:\n                g = int(globals_w[idx])\n                if inbound[g] < cap_thr:\n                    continue\n                rows.append(i); cols.append(g); dvals.append(float(cand_dst[idx]))\n                inbound[g] += 1; taken += 1\n                if taken >= q_within: break\n\n        # Cross-batch selection per other batch\n        for j in other:\n            qj = q_map[j]\n            if qj <= 0: continue\n            d_c = dists[j][i]; ii_c = idx_local[j][i]\n            globals_c = train_idx[j][ii_c]\n            cand_inb = inbound[globals_c]; cand_dst = d_c\n            order = np.lexsort((cand_dst, cand_inb))\n            taken = 0\n            for idx in order:\n                g = int(globals_c[idx])\n                if inbound[g]\
    \ >= cap_thr:\n                    continue\n                rows.append(i); cols.append(g); dvals.append(float(cand_dst[idx]))\n                inbound[g] += 1; taken += 1\n                if taken >= qj: break\n            if taken < qj:\n                for idx in order:\n                    g = int(globals_c[idx])\n                    if inbound[g] < cap_thr:\n                        continue\n                    rows.append(i); cols.append(g); dvals.append(float(cand_dst[idx]))\n                    inbound[g] += 1; taken += 1\n                    if taken >= qj: break\n\n    A_sym, D_sym = _symmetrize_binary_with_distances(\n        np.array(rows, np.int32), np.array(cols, np.int32), np.array(dvals, np.float32), n\n    )\n    return A_sym.astype(np.float32), D_sym.astype(np.float32)\n\n# ------------ Main: MPB-GraphFWPCA ------------\ndef eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n    \"\"\"\n    MPB-GraphFWPCA: Feature-weighted PCA on the graph path, then BRBG\
    \ + DAQB.\n    Default MPB protocol (Human Heart–tested):\n      - GraphFWPCA α_g=0.5; PCA_graph=50.\n      - Auto-λ v2 mean-target (target_mean=0.04) to choose λ; gamma_max=0.74.\n      - DAQB: k=48, cosine, kd=20, δ=0.10, cap=2.0, binary + true distances.\n      - EtC embedding for QC: FWPCA α=0.5 → PCA(60) → ComBat; neighbors(n=15) to set keys.\n    \"\"\"\n    # Config\n    alpha_emb = 0.5\n    n_pcs_emb = 60\n    emb_n_neighbors = 15\n    alpha_g = 0.5\n    n_pcs_graph = 50\n    l2 = 1e-3\n    gamma_max = 0.74\n    target_mean_gamma = 0.04   # mean-target for Auto-λ v2\n    k_total = 48\n    kd = 20\n    delta = 0.10\n    metric = 'cosine'\n    cap = 2.0\n\n    assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n    # Normalize + HVGs\n    _normalize_log1p_inplace(adata, 1e4)\n    sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n    hv = adata.var['highly_variable'].to_numpy()\n    batches = np.asarray(adata.obs['batch'].astype('category').values)\n\
    \n    # EtC embedding (QC only; not used for graph)\n    Xh = adata.X[:, hv]\n    Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n    var_g_emb = Xd.var(axis=0, ddof=1) + 1e-8\n    wv_emb = np.power(var_g_emb, -0.5 * alpha_emb).astype(np.float32)\n    Xw_emb = Xd * wv_emb\n    ad_emb = ad.AnnData(Xw_emb, obs=adata.obs[['batch']].copy())\n    sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n    Z_emb = ad_emb.obsm['X_pca']\n    ad_pc = ad.AnnData(Z_emb.copy(), obs=adata.obs[['batch']].copy())\n    sc.pp.combat(ad_pc, key='batch')\n    adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n    sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n    # Graph path: GraphFWPCA (feature weights on HVGs) -> PCA -> residualization (Auto-λ v2) -> DAQB\n    var_g = Xd.var(axis=0, ddof=1) + 1e-8\n    wv_graph = np.power(var_g, -0.5 * alpha_g).astype(np.float32)  # α_g=0.5 best on Heart\n    Xw_graph = Xd *\
    \ wv_graph\n    Zg = _pca_on_dense(Xw_graph, n_comps=n_pcs_graph, random_state=0)\n\n    # Residualize Zg against batches with per-PC shrinkage γ_j\n    B = _one_hot_batches(batches)\n    Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2)\n    var_total = Zg.var(axis=0, ddof=1) + 1e-8\n    var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n    R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n\n    lam = autoselect_lambda_mean_target(R2, gamma_max=gamma_max, target_mean=target_mean_gamma)\n    gamma = np.minimum(gamma_max, lam * R2)\n    Zcorr = Zg - (Zhat * gamma)\n\n    # DAQB graph\n    Cg, Dg = _build_daqb(Zcorr.astype(np.float32), batches=batches, k_total=k_total,\n                         metric=metric, delta=delta, k_density=kd, cap=cap, rng_seed=0)\n    adata.obsp['connectivities'] = Cg\n    adata.obsp['distances'] = Dg\n    # Optionally record settings used\n    adata.uns['mpb_graphfwpca'] = dict(alpha_g=float(alpha_g), lambda_selected=float(lam),\n                               \
    \        target_mean_gamma=float(target_mean_gamma),\n                                       kd=int(kd), delta=float(delta), k_total=int(k_total))\n    return adata\n\n```\n---\n**shared/algorithms/daqb_recommended.py:**\n```\n\"\"\"\nDAQB Recommended Pipeline (Heart) with Auto-λ v2 (mean-target) default.\nVersion: v2.1 (delta default set to 0.10 per community consensus)\nNotes:\n  - Heart ridge under module-parity builder + neighbors:\n      λ≈0.5–0.6, δ=0.10, kd=20, k=48, cosine (binary edges + true distances).\n  - References:\n      • Praxis II λ sweep: EIDs 808=0.7361 (λ=0.4), 809=0.7364 (λ=0.6), 801=0.7356 (λ=0.5) at δ=0.10, kd=20.\n      • Auto-λ v2: EID 823=0.7360 (δ=0.10, kd=20, λ=0.6265); EID 828=0.7343 (δ=0.15, kd=20).\n      • Wrapper parity: EID 832=0.7341 (δ=0.15, kd=20).\n      • Sophia III kd sweep: kd=20 @ δ=0.15 best (Public #3).\n      • Pioneer I replication of Logos V: EID 834=0.7418 (lam=0.5, δ=0.10, kd=20).\n  - Critical: run sc.pp.neighbors on X_emb (EtC) before\
    \ graph; omitting collapses iLISI (cf. EID 816).\n\"\"\"\n\nimport sys\nimport numpy as np\nimport scanpy as sc\nimport anndata as ad\nfrom scipy.sparse import issparse\n\nsys.path.append('storage/praxis')\nfrom bbsg_density_adaptive import build_density_adaptive_bbsg\n\nsys.path.append('storage/shared/diagnostics')\ntry:\n    from lam_autoselect2 import choose_lambda_from_r2_mean\n    _HAS_AUTO = True\nexcept Exception:\n    _HAS_AUTO = False\n\n# --- Config (consensus defaults) ---\nAUTO_LAMBDA = True\nTARGET_S = 0.04           # mean-target Auto-λ v2 (lands λ≈0.6 on Heart)\nLAM_FIXED = 0.60          # fallback if auto selector unavailable\nKDENSITY = 20\nDELTA = 0.10              # switched default from 0.15 -> 0.10 (consensus)\nK_TOTAL = 48\nGAMMA_MAX = 0.74\nL2 = 1e-3\nPCA_EMB = 60\nPCA_GRAPH = 50\nALPHA_VAR = 0.5\nMETRIC = 'cosine'\nEMB_N_NEIGHBORS = 15\n\ndef _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n    if 'counts' in adata.layers:\n        adata.X\
    \ = adata.layers['counts'].copy()\n    sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n    sc.pp.log1p(adata)\n\ndef _pca_array(X, n_comps=50, random_state=0):\n    Xd = X.A if issparse(X) else X\n    ad_tmp = ad.AnnData(Xd)\n    sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n    return ad_tmp.obsm['X_pca']\n\ndef _one_hot_batches(batches: np.ndarray):\n    cats = np.unique(batches)\n    n = batches.shape[0]\n    B = np.zeros((n, cats.size), dtype=float)\n    for j, c in enumerate(cats):\n        B[:, j] = (batches == c).astype(float)\n    return B\n\ndef _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n    BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n    W = np.linalg.solve(BTB, B.T @ Z)\n    return B @ W\n\ndef eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n    assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n    _normalize_log1p_inplace(adata, 1e4)\n\
    \    sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n    hv = adata.var['highly_variable'].to_numpy()\n    batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n    # EtC embedding (QC only) + neighbors side-effect\n    Xh = adata.X[:, hv]\n    Xd = (Xh.A if issparse(Xh) else Xh).astype(np.float32, copy=False)\n    var_g = Xd.var(axis=0, ddof=1) + 1e-8\n    wv = np.power(var_g, -0.5 * ALPHA_VAR).astype(np.float32)\n    Xw = Xd * wv\n    ad_emb = ad.AnnData(Xw, obs=adata.obs[['batch']].copy())\n    sc.pp.pca(ad_emb, n_comps=PCA_EMB, svd_solver='arpack', random_state=0)\n    ad_pc = ad.AnnData(ad_emb.obsm['X_pca'].copy(), obs=adata.obs[['batch']].copy())\n    sc.pp.combat(ad_pc, key='batch')\n    adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n    sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=EMB_N_NEIGHBORS, metric=METRIC)\n\n    # Graph PCs\n    Zg = _pca_array(Xd, n_comps=PCA_GRAPH, random_state=0)\n\
    \n    # Auto-λ v2 (mean-target) or fixed λ\n    lam = LAM_FIXED\n    if AUTO_LAMBDA and _HAS_AUTO:\n        try:\n            lam = float(choose_lambda_from_r2_mean(Zg, batches, gamma_max=GAMMA_MAX, target_s=TARGET_S, lam_min=0.2, lam_max=1.0, l2=L2))\n            print(f\"[daqb_recommended] auto_lambda_v2: target_s={TARGET_S:.4f} -> lam={lam:.4f}\")\n        except Exception as e:\n            print(f\"[daqb_recommended] auto_lambda_v2 failed ({e}); falling back to fixed lam={LAM_FIXED:.2f}\")\n\n    # Residualization\n    B = _one_hot_batches(batches)\n    Zhat = _ridge_batch_fit_predict(B, Zg, l2=L2)\n    var_total = Zg.var(axis=0, ddof=1) + 1e-8\n    var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n    R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n    gamma = np.minimum(GAMMA_MAX, lam * R2)\n    Zcorr = Zg - (Zhat * gamma)\n\n    # DAQB graph (module-parity builder): binary connectivities + true distances\n    Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n\
    \                                         k_total=K_TOTAL, metric=METRIC,\n                                         delta=DELTA, k_density=KDENSITY, rng_seed=0)\n    adata.obsp['connectivities'] = Cg\n    adata.obsp['distances'] = Dg\n    return adata\n\n```\n---\n**shared/diagnostics/graph_health_v3.py:**\n```\nimport numpy as np\nfrom scipy import sparse as sp\n\ndef _csr(M):\n    return M.tocsr() if not sp.isspmatrix_csr(M) else M\n\ndef cross_batch_fraction(C: sp.spmatrix, batches: np.ndarray) -> np.ndarray:\n    C = _csr(C); b = np.asarray(batches); n = C.shape[0]\n    out = np.full(n, np.nan, dtype=np.float32)\n    for i in range(n):\n        s, e = C.indptr[i], C.indptr[i+1]\n        if e <= s: continue\n        nbrs = C.indices[s:e]\n        out[i] = np.mean(b[nbrs] != b[i])\n    return out\n\ndef inbound_degree(C: sp.spmatrix) -> np.ndarray:\n    return np.asarray(_csr(C).tocsc().sum(axis=0)).ravel().astype(np.int32)\n\ndef row_median_distance(D: sp.spmatrix) -> np.ndarray:\n\
    \    D = _csr(D); n = D.shape[0]\n    out = np.full(n, np.nan, dtype=np.float32)\n    for i in range(n):\n        s, e = D.indptr[i], D.indptr[i+1]\n        if e <= s: continue\n        out[i] = np.median(D.data[s:e]).astype(np.float32)\n    return out\n\ndef neighborhood_batch_entropy(C: sp.spmatrix, batches: np.ndarray) -> np.ndarray:\n    C = _csr(C); b = np.asarray(batches); cats = np.unique(b); B = len(cats)\n    n = C.shape[0]; out = np.full(n, np.nan, dtype=np.float32)\n    for i in range(n):\n        s, e = C.indptr[i], C.indptr[i+1]\n        if e <= s: continue\n        nbrs = C.indices[s:e]\n        if nbrs.size == 0: continue\n        cnts = np.array([(b[nbrs] == c).sum() for c in cats], dtype=np.float32)\n        p = cnts / max(1.0, cnts.sum())\n        nz = p > 0\n        H = -float(np.sum(p[nz] * np.log(p[nz])))\n        out[i] = H / np.log(B)\n    return out\n\ndef pearsonr(x: np.ndarray, y: np.ndarray) -> float:\n    x = np.asarray(x, dtype=np.float32); y = np.asarray(y,\
    \ dtype=np.float32)\n    m = np.isfinite(x) & np.isfinite(y)\n    if m.sum() < 3: return np.nan\n    xz, yz = x[m] - x[m].mean(), y[m] - y[m].mean()\n    sx = np.sqrt((xz * xz).sum() + 1e-12); sy = np.sqrt((yz * yz).sum() + 1e-12)\n    return float((xz * yz).sum() / (sx * sy))\n\ndef asymmetry_rate(C: sp.spmatrix) -> float:\n    X = _csr(C).sign(); Y = _csr(C).T.sign()\n    num = (X != Y).nnz; den = (X + Y).sign().nnz + 1e-12\n    return float(num / den)\n\ndef sparsity_mismatch_rate(C: sp.spmatrix, D: sp.spmatrix) -> float:\n    X = _csr(C).sign(); Y = _csr(D).sign()\n    num = (X != Y).nnz; den = (X + Y).sign().nnz + 1e-12\n    return float(num / den)\n\ndef _tri(x: float, c: float, w: float) -> float:\n    if np.isnan(x): return 0.0\n    s = 1.0 - abs(x - c) / max(w, 1e-8)\n    return float(max(0.0, min(1.0, s)))\n\ndef _one_minus_scaled(x: float, scale: float) -> float:\n    if np.isnan(x): return 0.0\n    return float(max(0.0, min(1.0, 1.0 - x / max(scale, 1e-8))))\n\ndef compute_graph_health_v3(\n\
    \    C: sp.spmatrix,\n    D: sp.spmatrix,\n    batches: np.ndarray,\n    k_total: int,\n    cap: float = 2.0,\n    base_std_center: float = 0.10,\n    base_std_width: float = 0.06\n):\n    b = np.asarray(batches)\n    B = len(np.unique(b))\n    base = (B - 1.0) / float(B)\n\n    f = cross_batch_fraction(C, b)\n    indeg = inbound_degree(C)\n    d_med = row_median_distance(D)\n    Hn = neighborhood_batch_entropy(C, b)\n    r = pearsonr(-d_med, f)\n    asym = asymmetry_rate(C)\n    mis = sparsity_mismatch_rate(C, D)\n\n    f_mean = float(np.nanmean(f))\n    f_std = float(np.nanstd(f))\n    cap_thr = int(np.ceil(cap * k_total))\n    cap_share = float(np.mean(indeg >= cap_thr))\n    H_mean = float(np.nanmean(Hn))\n\n    s_mix = _one_minus_scaled(abs(f_mean - base), 0.03)          # mean near base ±0.03\n    s_mix_var = _tri(f_std, base_std_center, base_std_width)     # discourage overly uniform mixing\n    s_cap = _tri(cap_share, 0.15, 0.10)                          # 10–20% at cap\n   \
    \ s_r = _tri(r, 0.30, 0.30)                                    # small positive correlation\n    s_ent = float(np.clip((H_mean - 0.65) / 0.25, 0.0, 1.0))     # higher entropy favored\n    s_asym = _one_minus_scaled(asym, 0.05)\n    s_mis = _one_minus_scaled(mis, 0.05)\n\n    weights = {  # sums to 1.0\n        \"mix\": 0.30, \"mix_var\": 0.10, \"cap\": 0.20, \"r\": 0.20, \"ent\": 0.15, \"asym\": 0.025, \"mis\": 0.025\n    }\n    ghs = (\n        weights[\"mix\"] * s_mix +\n        weights[\"mix_var\"] * s_mix_var +\n        weights[\"cap\"] * s_cap +\n        weights[\"r\"] * s_r +\n        weights[\"ent\"] * s_ent +\n        weights[\"asym\"] * s_asym +\n        weights[\"mis\"] * s_mis\n    )\n    return {\n        \"GHS\": float(ghs),\n        \"subscores\": {\n            \"s_mix\": s_mix, \"s_mix_var\": s_mix_var, \"s_cap\": s_cap, \"s_r\": s_r,\n            \"s_entropy\": s_ent, \"s_asym\": s_asym, \"s_mis\": s_mis\n        },\n        \"diagnostics\": {\n            \"base\":\
    \ base, \"f_mean\": f_mean, \"f_std\": f_std, \"cap_share\": cap_share,\n            \"r\": r, \"H_mean\": H_mean, \"asym\": asym, \"mismatch\": mis,\n            \"cap_threshold\": cap_thr, \"k_total\": int(k_total), \"B\": int(B)\n        }\n    }\n\n```\n---\n**praxis/mpb_graphfwpca_override.py:**\n```\nimport sys\nimport numpy as np\nimport scanpy as sc\nimport anndata as ad\nfrom scipy import sparse as sp\n\n# Ensure package roots\nsys.path.append('storage')\nsys.path.append('storage/praxis')\n\nfrom praxis_core import normalize_log1p_inplace, pca_array, one_hot_batches, ridge_batch_fit_predict\nfrom bbsg_density_adaptive import build_density_adaptive_bbsg\n\ndef _fw_weight_by_var(Xd: np.ndarray, alpha: float) -> np.ndarray:\n    var_g = Xd.var(axis=0, ddof=1).astype(np.float32) + 1e-8\n    w = np.power(var_g, -0.5 * alpha).astype(np.float32)\n    return Xd * w\n\ndef eliminate_mpb_graphfwpca(adata: ad.AnnData,\n                             alpha_emb: float = 0.5,\n            \
    \                 n_pcs_emb: int = 60,\n                             emb_n_neighbors: int = 15,\n                             alpha_g: float = 0.5,\n                             n_pcs_graph: int = 50,\n                             l2: float = 1e-3,\n                             gamma_max: float = 0.74,\n                             lam_override: float = 0.70,\n                             k_total: int = 48,\n                             kdensity: int = 20,\n                             delta: float = 0.10,\n                             metric: str = 'cosine',\n                             cap: float = 2.0,\n                             rng_seed: int = 0) -> ad.AnnData:\n    assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n    # Normalize + HVGs\n    normalize_log1p_inplace(adata, 1e4)\n    sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n    hv = adata.var['highly_variable'].to_numpy()\n    batches\
    \ = np.asarray(adata.obs['batch'].astype('category').values)\n\n    # Dense HVGs\n    Xh = adata.X[:, hv]\n    Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n\n    # EtC embedding (QC) + neighbors\n    Xw_emb = _fw_weight_by_var(Xd, alpha=alpha_emb)\n    ad_emb = ad.AnnData(Xw_emb, obs=adata.obs[['batch']].copy())\n    sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n    ad_pc = ad.AnnData(ad_emb.obsm['X_pca'].copy(), obs=adata.obs[['batch']].copy())\n    sc.pp.combat(ad_pc, key='batch')\n    adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n    sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n    # Graph path: GraphFWPCA -> PCA -> BRBG (fixed λ) -> DAQB\n    Xw_graph = _fw_weight_by_var(Xd, alpha=alpha_g)\n    Zg = pca_array(Xw_graph, n_comps=n_pcs_graph, random_state=0)\n\n    B = one_hot_batches(batches)\n    Zhat = ridge_batch_fit_predict(B, Zg, l2=l2)\n    var_total = Zg.var(axis=0,\
    \ ddof=1) + 1e-8\n    var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n    R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n\n    lam = float(lam_override)\n    gamma = np.minimum(gamma_max, lam * R2).astype(np.float32)\n    Zcorr = Zg - (Zhat * gamma)\n\n    # Call DAQB with cap if available (fallback without cap)\n    try:\n        Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                             k_total=k_total, metric=metric,\n                                             delta=delta, k_density=kdensity,\n                                             cap=cap, rng_seed=rng_seed)\n    except TypeError:\n        Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                             k_total=k_total, metric=metric,\n                                             delta=delta, k_density=kdensity,\n                                             rng_seed=rng_seed)\n    adata.obsp['connectivities']\
    \ = Cg\n    adata.obsp['distances'] = Dg\n    adata.uns['mpb_graphfwpca_override'] = dict(alpha_g=float(alpha_g),\n                                                lam_override=float(lam),\n                                                kd=int(kdensity), delta=float(delta),\n                                                cap=float(cap),\n                                                k_total=int(k_total),\n                                                rng_seed=int(rng_seed))\n    return adata\n\n```\n---\n**praxis/brbg_common.py:**\n```\nimport numpy as np\nimport scanpy as sc\nimport anndata as ad\nfrom scipy import sparse as sp\nfrom sklearn.decomposition import TruncatedSVD\nfrom sklearn.neighbors import NearestNeighbors\nfrom scipy.sparse import coo_matrix\n\ndef _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n    if 'counts' in adata.layers:\n        adata.X = adata.layers['counts'].copy()\n    sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n\
    \    sc.pp.log1p(adata)\n\ndef _pca_truncated_svd(X, n_comps=50, random_state=0):\n    n_comps = max(2, min(n_comps, X.shape[1]-1 if X.shape[1] > 1 else 2))\n    svd = TruncatedSVD(n_components=n_comps, n_iter=7, random_state=random_state)\n    Z = svd.fit_transform(X)\n    return Z\n\ndef _one_hot_batches(batches):\n    cats = np.asarray(batches)\n    uniq = np.unique(cats)\n    n = cats.shape[0]\n    B = np.zeros((n, uniq.shape[0]), dtype=np.float64)\n    col = {u:i for i,u in enumerate(uniq)}\n    for i, b in enumerate(cats):\n        B[i, col[b]] = 1.0\n    return B, uniq\n\ndef _ridge_batch_fit_predict(B, Z, l2=1e-3):\n    K = B.shape[1]\n    BtB = B.T @ B + l2 * np.eye(K)\n    W = np.linalg.solve(BtB, B.T @ Z)   # (K x d)\n    Zhat = B @ W                        # (n x d)\n    # per-PC R^2\n    Zc = Z - Z.mean(axis=0, keepdims=True)\n    SSE = np.sum((Z - Zhat)**2, axis=0) + 1e-12\n    SST = np.sum(Zc**2, axis=0) + 1e-12\n    R2 = 1.0 - (SSE / SST)\n    return Zhat, np.clip(R2,\
    \ 0.0, 1.0)\n\n# Existing equal-quotas (ceil) builder (kept for compatibility)\ndef _build_balanced_knn_equal(Z, batches, k_total=48, metric='cosine'):\n    Z = np.asarray(Z, dtype=np.float32)\n    batches = np.asarray(batches)\n    uniq = np.unique(batches)\n    n = Z.shape[0]\n    per_batch = int(np.ceil(k_total / max(1, uniq.shape[0])))\n\n    pairs_min_dist = {}\n\n    for b in uniq:\n        idx_train = np.where(batches == b)[0]\n        if idx_train.size == 0:\n            continue\n        k = min(per_batch + 1, idx_train.size)  # +1 for potential self\n        nn = NearestNeighbors(n_neighbors=k, metric=metric, algorithm='auto')\n        nn.fit(Z[idx_train])\n        dists, inds = nn.kneighbors(Z, n_neighbors=k, return_distance=True)\n        neigh_global = idx_train[inds]\n        for i in range(n):\n            g = neigh_global[i]\n            di = dists[i]\n            mask = g != i\n            g = g[mask][:per_batch]\n            di = di[mask][:per_batch]\n            for\
    \ j, d in zip(g, di):\n                if i == j: continue\n                a, c = (i, j) if i < j else (j, i)\n                prev = pairs_min_dist.get((a, c))\n                if (prev is None) or (d < prev):\n                    pairs_min_dist[(a, c)] = float(d)\n\n    if not pairs_min_dist:\n        return None, None\n\n    rows, cols, dist_data = [], [], []\n    for (i, j), d in pairs_min_dist.items():\n        rows += [i, j]; cols += [j, i]; dist_data += [d, d]\n    D = coo_matrix((dist_data, (rows, cols)), shape=(n, n)).tocsr()\n    C = D.copy(); C.data[:] = 1.0\n    return C, D\n\n# Existing min-quota + global fill (kept)\ndef _build_balanced_knn_minq(Z, batches, k_total=48, min_per_batch=2, metric='cosine'):\n    Z = np.asarray(Z, dtype=np.float32)\n    batches = np.asarray(batches)\n    uniq = np.unique(batches)\n    n = Z.shape[0]\n\n    pairs_min_dist = {}\n    for b in uniq:\n        idx_train = np.where(batches == b)[0]\n        if idx_train.size == 0:\n            continue\n\
    \        k = min(min_per_batch + 1, idx_train.size)\n        nn = NearestNeighbors(n_neighbors=k, metric=metric, algorithm='auto')\n        nn.fit(Z[idx_train])\n        dists, inds = nn.kneighbors(Z, n_neighbors=k, return_distance=True)\n        neigh_global = idx_train[inds]\n        for i in range(n):\n            g = neigh_global[i]\n            di = dists[i]\n            mask = g != i\n            g = g[mask][:min_per_batch]\n            di = di[mask][:min_per_batch]\n            for j, d in zip(g, di):\n                if i == j: continue\n                a, c = (i, j) if i < j else (j, i)\n                prev = pairs_min_dist.get((a, c))\n                if (prev is None) or (d < prev):\n                    pairs_min_dist[(a, c)] = float(d)\n\n    fill_each = max(0, k_total - int(min_per_batch * uniq.shape[0]))\n    if fill_each > 0:\n        nn = NearestNeighbors(n_neighbors=min(fill_each + 1, n), metric=metric, algorithm='auto')\n        nn.fit(Z)\n        dists, inds = nn.kneighbors(Z,\
    \ n_neighbors=min(fill_each + 1, n), return_distance=True)\n        for i in range(n):\n            g = inds[i]\n            di = dists[i]\n            mask = g != i\n            g = g[mask][:fill_each]\n            di = di[mask][:fill_each]\n            for j, d in zip(g, di):\n                if i == j: continue\n                a, c = (i, j) if i < j else (j, i)\n                prev = pairs_min_dist.get((a, c))\n                if (prev is None) or (d < prev):\n                    pairs_min_dist[(a, c)] = float(d)\n\n    if not pairs_min_dist:\n        return None, None\n\n    rows, cols, dist_data = [], [], []\n    for (i, j), d in pairs_min_dist.items():\n        rows += [i, j]; cols += [j, i]; dist_data += [d, d]\n    D = coo_matrix((dist_data, (rows, cols)), shape=(n, n)).tocsr()\n    C = D.copy(); C.data[:] = 1.0\n    return C, D\n\n# New: exact balanced quotas (q per batch + r extras per node), rotating extras across batches per node\ndef _build_balanced_knn_equal_exact(Z,\
    \ batches, k_total=48, metric='cosine'):\n    Z = np.asarray(Z, dtype=np.float32)\n    batches = np.asarray(batches)\n    uniq = np.unique(batches)\n    n = Z.shape[0]\n    B = uniq.shape[0]\n    if B == 0 or k_total <= 0:\n        return None, None\n\n    q = k_total // B\n    r = k_total % B\n\n    # Pre-fit per-batch NNs up to max needed neighbors (q + 1 extra + self)\n    pairs_min_dist = {}\n    for bi, b in enumerate(uniq):\n        idx_train = np.where(batches == b)[0]\n        if idx_train.size == 0:\n            continue\n        kmax = min(q + 1 + 1, idx_train.size)  # q + possible extra + self\n        nn = NearestNeighbors(n_neighbors=kmax, metric=metric, algorithm='auto')\n        nn.fit(Z[idx_train])\n        dists, inds = nn.kneighbors(Z, n_neighbors=kmax, return_distance=True)\n        neigh_global = idx_train[inds]\n\n        for i in range(n):\n            # Rotate extras for fairness: r batches get +1 neighbor for node i\n            order = [(bi + i) % B for bi in\
    \ range(B)]\n            extras = set(order[:r])\n            # select k_b for this batch index\n            k_b = q + (1 if bi in extras else 0)\n\n            g = neigh_global[i]\n            di = dists[i]\n            mask = g != i\n            g = g[mask][:k_b]\n            di = di[mask][:k_b]\n            for j, d in zip(g, di):\n                if i == j: continue\n                a, c = (i, j) if i < j else (j, i)\n                prev = pairs_min_dist.get((a, c))\n                if (prev is None) or (d < prev):\n                    pairs_min_dist[(a, c)] = float(d)\n\n    if not pairs_min_dist:\n        return None, None\n\n    rows, cols, dist_data = [], [], []\n    for (i, j), d in pairs_min_dist.items():\n        rows += [i, j]; cols += [j, i]; dist_data += [d, d]\n    D = coo_matrix((dist_data, (rows, cols)), shape=(n, n)).tocsr()\n    C = D.copy(); C.data[:] = 1.0\n    return C, D\n\n```\n---\n**praxis/bbsg_density_adaptive.py:**\n```\nimport numpy as np\nimport scipy.sparse\
    \ as sp\nfrom sklearn.neighbors import NearestNeighbors\n\ndef _symmetrize_binary_with_distances(rows, cols, dists, n):\n    A = sp.coo_matrix((np.ones_like(dists, dtype=np.float32), (rows, cols)), shape=(n, n)).tocsr()\n    D = sp.coo_matrix((dists.astype(np.float32), (rows, cols)), shape=(n, n)).tocsr()\n    A_sym = A.maximum(A.T)\n    D_sym = D.maximum(D.T)\n    A_sym.eliminate_zeros()\n    D_sym.eliminate_zeros()\n    return A_sym.tocsr().astype(np.float32), D_sym.tocsr().astype(np.float32)\n\ndef build_density_adaptive_bbsg(Zcorr, batches, k_total=48, metric='cosine', delta=0.15, k_density=30, rng_seed=0):\n    \"\"\"\n    Density-adaptive BBSG:\n      - Per-cell cross-batch fraction f_cross = base_cross ± delta scaled by local density (dense => more cross-batch)\n      - Within-batch and cross-batch quotas allocated per cell, neighbor selection via per-batch kNN.\n      - Returns binary connectivities and true distances (CSR).\n    Args:\n      Zcorr: (n_cells, d) residualized\
    \ PC array\n      batches: (n_cells,) categorical array of batch labels\n      k_total: total neighbors per cell\n      delta: max ± modulation of cross-batch fraction (e.g., 0.15 => ±15%)\n      k_density: neighbor rank for local density proxy\n    \"\"\"\n    n = Zcorr.shape[0]\n    cats = np.unique(batches)\n    B_other = max(len(cats) - 1, 1)\n\n    # Local density proxy (k-th NN distance, all batches)\n    nn_all = NearestNeighbors(n_neighbors=k_density + 1, metric=metric, algorithm='brute')\n    nn_all.fit(Zcorr)\n    d_all, idx_all = nn_all.kneighbors(Zcorr, return_distance=True)\n    d_k = d_all[:, -1]\n    d_min, d_max = float(np.min(d_k)), float(np.max(d_k) + 1e-8)\n    d_norm = (d_k - d_min) / (d_max - d_min + 1e-8)        # 0 dense ... 1 sparse\n    inv_dense = 1.0 - d_norm\n    base_cross = (len(cats) - 1) / float(len(cats))        # e.g., 0.75 for 4 batches\n    mix_delta = (inv_dense - 0.5) * 2.0 * float(delta)     # [-delta, +delta]\n    f_cross = np.clip(base_cross +\
    \ mix_delta, 0.60, 0.90)\n\n    # Pre-build per-batch NN indices and distances\n    max_cross_per = int(np.ceil(0.9 * k_total / B_other))\n    max_within = int(np.ceil((1.0 - 0.60) * k_total))\n    rng = np.random.RandomState(rng_seed)\n\n    batch_to_indices = {}\n    nn_models = {}\n    for j, c in enumerate(cats):\n        mask = (batches == c)\n        batch_to_indices[j] = np.where(mask)[0]\n        nn = NearestNeighbors(n_neighbors=max(max_within, max_cross_per) + 1, metric=metric, algorithm='brute')\n        nn.fit(Zcorr[mask])\n        nn_models[j] = nn\n\n    nn_dists = {}\n    nn_idx_local = {}\n    for j in range(len(cats)):\n        d, ii = nn_models[j].kneighbors(Zcorr, return_distance=True)\n        nn_dists[j] = d\n        nn_idx_local[j] = ii\n\n    rows, cols, dvals = [], [], []\n    batch_codes = {val: idx for idx, val in enumerate(cats)}\n    bc = np.array([batch_codes[b] for b in batches], dtype=int)\n\n    for i in range(n):\n        bi = int(bc[i])\n        q_cross_total\
    \ = int(round(f_cross[i] * k_total))\n        q_within = max(0, min(k_total, int(round(k_total - q_cross_total))))\n        q_per_other = q_cross_total // B_other\n        rem = q_cross_total - q_per_other * B_other\n\n        # within-batch\n        d_i = nn_dists[bi][i]\n        ii = nn_idx_local[bi][i]\n        start = 1 if d_i[0] == 0.0 else 0\n        sel = min(q_within, d_i.shape[0] - start)\n        if sel > 0:\n            cols.extend(batch_to_indices[bi][ii[start:start + sel]])\n            rows.extend([i] * sel)\n            dvals.extend(d_i[start:start + sel])\n\n        # other-batch allocation (distribute remainder to closest batches)\n        other_batches = [j for j in range(len(cats)) if j != bi]\n        batch_scores = [(j, nn_dists[j][i][0]) for j in other_batches]\n        batch_scores.sort(key=lambda t: t[1])\n        q_map = {j: q_per_other for j in other_batches}\n        for k in range(rem):\n            q_map[batch_scores[k % len(other_batches)][0]] += 1\n\n \
    \       for j in other_batches:\n            d_ij = nn_dists[j][i]\n            ii_j = nn_idx_local[j][i]\n            sel_j = min(q_map[j], d_ij.shape[0])\n            if sel_j > 0:\n                cols.extend(batch_to_indices[j][ii_j[:sel_j]])\n                rows.extend([i] * sel_j)\n                dvals.extend(d_ij[:sel_j])\n\n    rows = np.asarray(rows, dtype=np.int32)\n    cols = np.asarray(cols, dtype=np.int32)\n    dvals = np.asarray(dvals, dtype=np.float32)\n    C_sym, D_sym = _symmetrize_binary_with_distances(rows, cols, dvals, n)\n    return C_sym, D_sym\n\n```\n---\n**praxis/best_mpb_daqb_kd22_k50.py:**\n```\nimport sys\nimport anndata as ad\nsys.path.append('storage')\nsys.path.append('storage/praxis')\nfrom mpb_graphfwpca_override import eliminate_mpb_graphfwpca\n\n# Variant: increase neighbor count to k_total=50 at the current best λ, δ, kd\ndef eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n    print(\"[best-k50] lam=0.605, delta=0.10, kd=22, k=50\")\n\
    \    return eliminate_mpb_graphfwpca(\n        adata,\n        lam_override=0.605,\n        delta=0.10,\n        kdensity=22,\n        k_total=50\n    )\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
