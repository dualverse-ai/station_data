    \    return ad_tmp.obsm['X_pca']\n\ndef _one_hot_batches(batches):\n    cats = np.unique(batches)\n    B = np.zeros((batches.shape[0], cats.size), dtype=float)\n    for j, c in enumerate(cats):\n        B[:, j] = (batches == c).astype(float)\n    return B\n\ndef _ridge_batch_fit_predict(B, Z, l2=1e-3):\n    BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n    W = np.linalg.solve(BTB, B.T @ Z)\n    return B @ W\n\ndef eliminate_batch_effect_fn(adata):\n    n_pcs_emb = 60\n    alpha_var = 0.5\n    n_pcs_graph = 50\n    l2 = 1e-3\n    gamma_max = 0.74\n    # --- PARAMETERS BEING TESTED ---\n    lam = 0.5 \n    delta = 0.05\n    # -------------------------------\n    k_total = 48\n    metric = 'cosine'\n    k_density = 20\n\n    _normalize_log1p_inplace(adata, 1e4)\n    sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n    hv = adata.var['highly_variable'].to_numpy()\n    batches = np.asarray(adata.obs['batch'].astype('category').values)\n\
    \    Xh = adata.X[:, hv]\n    Xd = (Xh.A if issparse(Xh) else Xh).astype(np.float32, copy=False)\n\n    var_g = Xd.var(axis=0, ddof=1) + 1e-8\n    wv = np.power(var_g, -0.5 * alpha_var).astype(np.float32)\n    Xw = Xd * wv\n    ad_emb = ad.AnnData(Xw, obs=adata.obs[['batch']].copy())\n    sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n    Z_emb = ad_emb.obsm['X_pca']\n    ad_pc = ad.AnnData(Z_emb.copy(), obs=adata.obs[['batch']].copy())\n    sc.pp.combat(ad_pc, key='batch')\n    adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n\n    sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=15, metric=metric)\n\n    Zg = _pca_array(Xd, n_comps=n_pcs_graph, random_state=0)\n    B = _one_hot_batches(batches)\n    Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2)\n    var_total = Zg.var(axis=0, ddof=1) + 1e-8\n    var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n    R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n    gamma = np.minimum(gamma_max, lam * R2)\n\
    \    Zcorr = Zg - (Zhat * gamma)\n    \n    Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches, k_total=k_total,\n                                         metric=metric, delta=delta, k_density=k_density, rng_seed=0)\n    adata.obsp['connectivities'] = Cg\n    adata.obsp['distances'] = Dg\n    \n    return adata\n\n```\n\n**Execution Log:**\n```\nPYTHON SANDBOX EXECUTION:\nSTDOUT:\nExecuting command: python storage/system/main.py\nLoading training dataset...\n  Data shape: (20000, 2000)\n  Batches: 4 batches\nFound eliminate_batch_effect_fn, executing...\n\n=== Running batch integration ===\n  Result shape: (20000, 2000)\n  Has embedding: True\n  Has graph: True\n\nResult saved to: storage/shared/tmp/0ff12254-032c-4b76-8fb0-4a1183b69680/result_human.h5ad\n\nRESULT_UUID: 0ff12254-032c-4b76-8fb0-4a1183b69680\n\n\nSTDERR:\n\n```\n\n\n---\n\n## Actions Detected (Last Turn)\n1. `review 766` (in Research Counter);\n2. `review 767` (in Research Counter);\n3. `review\
    \ 768` (in Research Counter);\n4. `review 769` (in Research Counter);\n5. `review 770` (in Research Counter);\n6. `review 827` (in Research Counter);\n\n\n---\n\n## Room Output History (Last Turn)\n\n### Location: Research Counter\n**Actions Executed:**\n- Evaluation 766 details sent to your System Messages.\n- Evaluation 767 details sent to your System Messages.\n- Evaluation 768 details sent to your System Messages.\n- Evaluation 769 details sent to your System Messages.\n- Evaluation 770 details sent to your System Messages.\n- Evaluation 827 details sent to your System Messages.\n\n**Latest Room Output:**\n**Research Tasks:**\n\n| ID | Task Name |\n|---|---|\n| 1 | Single-cell RNA-seq Batch Integration |\n\n**Running Experiments:**\n\nYou do not have any running experiments. Please submit a new experiment if needed.\n\n**Submitted Evaluations:**\n\n| Evaluation ID | Research Task ID | Title | Author | Submitted Tick | Score | ARI | ASW_batch | ASW_label | Cell_cycle | Graph_conn\
    \ | NMI | PCR | cLISI | iLISI | kBET |\n|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|\n| 828 | 1 | Auto‑λ v2 (mean‑target) at δ=0.15, kd=20: BRBG(λ from mean shrinkage target_s=0.04) + DAQB(k=48) | Praxis II | 527 | 0.7343 | 0.761 | 0.659 | 0.248 | 0.327 | 0.946 | 0.711 | 1.000 | 0.966 | 0.933 | 0.791 |\n| 827 | 1 | Logos V: Probing SOTA Ridge (lam=0.5, delta=0.05) | Logos V | 524 | 0.7316 | 0.740 | 0.659 | 0.248 | 0.317 | 0.946 | 0.696 | 1.000 | 0.967 | 0.952 | 0.790 |\n| 826 | 1 | Pioneer I - Logos V SOTA Replication (lam=0.5, delta=0.1, k_total=40, beta=2.0) | Pioneer I | 524 | 0.7273 | 0.772 | 0.659 | 0.248 | 0.333 | 0.944 | 0.712 | 1.000 | 0.961 | 0.853 | 0.789 |\n| 825 | 1 | Sophia III: DAQB Validation - Reciprocity Probe Run | Sophia III | 523 | n.a. |  |  |  |  |  |  |  |  |  |  |\n| 824 | 1 | Logos V: Adaptive Delta Sweep (lam=0.9, delta=0.15) | Logos V | 523 | 0.7274 | 0.760 | 0.659 | 0.248 | 0.265 | 0.946 | 0.710 | 1.000 | 0.966 | 0.930 | 0.789 |\n| 823\
