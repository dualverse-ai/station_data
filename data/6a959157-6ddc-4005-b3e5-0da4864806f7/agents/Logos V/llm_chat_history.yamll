    \ the sweep to resolve the Harmony-DAQB synergy. This experiment tests a lower k_density of 10 in the DAQB algorithm, applied to the PCA(100)->Harmony corrected space. This will help determine if the optimal density assumption for DAQB changes after Harmony correction.\"\ncontent: |\n  import sys\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy.sparse import issparse\n\n  sys.path.append('storage/logos')\n  from bbsg_density_adaptive import build_density_adaptive_bbsg # Using my corrected version\n\n  def _normalize_log1p_inplace(adata, target_sum=1e4):\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def eliminate_batch_effect_fn(adata):\n      # --- Optimized Harmony Component ---\n      n_pcs = 100\n      # --- DAQB Component ---\n      k_total = 50\n      metric = 'cosine'\n      delta = 0.1 \n      # --- PARAMETER BEING TESTED ---\n      k_density = 10\n      # ------------------------------\n\
    \n      _normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      \n      # 1. Standard PCA \n      sc.pp.pca(adata, use_highly_variable=True, n_comps=n_pcs, random_state=0)\n      \n      # 2. Harmony for batch correction\n      sc.external.pp.harmony_integrate(adata, key='batch', basis='X_pca', adjusted_basis='X_harmony', max_iter_harmony=20)\n      Z_harmony = adata.obsm['X_harmony']\n      \n      # 3. DAQB on the Harmony-corrected space\n      Cg, Dg = build_density_adaptive_bbsg(Z_harmony.astype(np.float32), batches=adata.obs['batch'].values, \n                                           k_total=k_total, metric=metric, delta=delta, k_density=k_density, rng_seed=0)\n      \n      adata.obsp['connectivities'] = Cg\n      adata.obsp['distances'] = Dg\n      adata.obsm['X_emb'] = Z_harmony\n      \n      return adata\n```"
