    \ ad.AnnData, target_sum: float = 1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def pca_array(X, n_comps: int = 50, random_state: int = 0):\n      Xd = X.A if sp.issparse(X) else X\n      ad_tmp = ad.AnnData(Xd)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca']\n\n  def one_hot_batches(batches: np.ndarray):\n      cats = np.unique(batches)\n      n = batches.shape[0]\n      B = np.zeros((n, cats.size), dtype=float)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B\n\n  def ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n```\n\n/execute_action{storage write logos/bbsg_density_adaptive.py}\n\
    ```yaml\ncontent: |\n  import numpy as np\n  import scipy.sparse as sp\n  from sklearn.neighbors import NearestNeighbors\n\n  def _symmetrize_binary_with_distances(rows, cols, dists, n):\n      A = sp.coo_matrix((np.ones_like(dists, dtype=np.float32), (rows, cols)), shape=(n, n)).tocsr()\n      D = sp.coo_matrix((dists.astype(np.float32), (rows, cols)), shape=(n, n)).tocsr()\n      A_sym = A.maximum(A.T)\n      D_sym = D.maximum(D.T)\n      A_sym.eliminate_zeros()\n      D_sym.eliminate_zeros()\n      return A_sym.tocsr().astype(np.float32), D_sym.tocsr().astype(np.float32)\n\n  def build_density_adaptive_bbsg(Zcorr, batches, k_total=48, metric='cosine', delta=0.15, k_density=30, rng_seed=0, cap=2.0):\n      n = Zcorr.shape[0]\n      cats = np.unique(batches)\n      B_other = max(len(cats) - 1, 1)\n\n      nn_all = NearestNeighbors(n_neighbors=k_density + 1, metric=metric, algorithm='brute')\n      nn_all.fit(Zcorr)\n      d_all, idx_all = nn_all.kneighbors(Zcorr, return_distance=True)\n\
    \      d_k = d_all[:, -1]\n      d_min, d_max = float(np.min(d_k)), float(np.max(d_k) + 1e-8)\n      d_norm = (d_k - d_min) / (d_max - d_min + 1e-8)\n      inv_dense = 1.0 - d_norm\n      base_cross = (len(cats) - 1) / float(len(cats))\n      mix_delta = (inv_dense - 0.5) * 2.0 * float(delta)\n      f_cross = np.clip(base_cross + mix_delta, 0.60, 0.90)\n\n      max_cross_per = int(np.ceil(0.9 * k_total / B_other))\n      max_within = int(np.ceil((1.0 - 0.60) * k_total))\n      \n      batch_to_indices = {}\n      nn_models = {}\n      for j, c in enumerate(cats):\n          mask = (batches == c)\n          batch_to_indices[j] = np.where(mask)[0]\n          nn = NearestNeighbors(n_neighbors=max(max_within, max_cross_per) + 1, metric=metric, algorithm='brute')\n          nn.fit(Zcorr[mask])\n          nn_models[j] = nn\n\n      nn_dists = {j: nn_models[j].kneighbors(Zcorr, return_distance=True)[0] for j in range(len(cats))}\n      nn_idx_local = {j: nn_models[j].kneighbors(Zcorr, return_distance=True)[1]\
    \ for j in range(len(cats))}\n\n      rows, cols, dvals = [], [], []\n      batch_codes = {val: idx for idx, val in enumerate(cats)}\n      bc = np.array([batch_codes[b] for b in batches], dtype=int)\n\n      for i in range(n):\n          bi = int(bc[i])\n          q_cross_total = int(round(f_cross[i] * k_total))\n          q_within = max(0, min(k_total, int(round(k_total - q_cross_total))))\n          q_per_other = q_cross_total // B_other\n          rem = q_cross_total - q_per_other * B_other\n          \n          d_i = nn_dists[bi][i]\n          ii = nn_idx_local[bi][i]\n          start = 1 if d_i[0] == 0.0 else 0\n          sel = min(q_within, d_i.shape[0] - start)\n          if sel > 0:\n              cols.extend(batch_to_indices[bi][ii[start:start + sel]])\n              rows.extend([i] * sel)\n              dvals.extend(d_i[start:start + sel])\n\n          other_batches = [j for j in range(len(cats)) if j != bi]\n          batch_scores = sorted([(j, nn_dists[j][i][0]) for j in\
    \ other_batches], key=lambda t: t[1])\n          q_map = {j: q_per_other for j in other_batches}\n          for k in range(rem):\n              q_map[batch_scores[k % len(other_batches)][0]] += 1\n\n          for j in other_batches:\n              d_ij, ii_j = nn_dists[j][i], nn_idx_local[j][i]\n              sel_j = min(q_map[j], d_ij.shape[0])\n              if sel_j > 0:\n                  cols.extend(batch_to_indices[j][ii_j[:sel_j]])\n                  rows.extend([i] * sel_j)\n                  dvals.extend(d_ij[:sel_j])\n\n      C_sym, D_sym = _symmetrize_binary_with_distances(np.array(rows, dtype=np.int32), np.array(cols, dtype=np.int32), np.array(dvals, dtype=np.float32), n)\n      return C_sym, D_sym\n```\n\n/execute_action{storage write logos/community_sota_v1.py}\n```yaml\ncontent: |\n  import sys\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n\n  sys.path.append('storage/logos') # Point to my own storage\n  from praxis_core\
    \ import normalize_log1p_inplace, pca_array, one_hot_batches, ridge_batch_fit_predict\n  from bbsg_density_adaptive import build_density_adaptive_bbsg\n\n  def _fw_weight_by_var(Xd: np.ndarray, alpha: float) -> np.ndarray:\n      var_g = Xd.var(axis=0, ddof=1).astype(np.float32) + 1e-8\n      w = np.power(var_g, -0.5 * alpha).astype(np.float32)\n      return Xd * w\n\n  def eliminate_mpb_graphfwpca(adata: ad.AnnData, alpha_g: float = 0.5, n_pcs_graph: int = 50, l2: float = 1e-3, gamma_max: float = 0.74, lam_override: float = 0.70, k_total: int = 48, kdensity: int = 20, delta: float = 0.10, metric: str = 'cosine', cap: float = 2.0, rng_seed: int = 0) -> ad.AnnData:\n      \n      # Minimal embedding path for QC, as per community SOTA\n      sc.pp.neighbors(adata, n_neighbors=15, use_rep='X')\n\n      # Graph path\n      normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n\
    \      batches = np.asarray(adata.obs['batch'].astype('category').values)\n      Xh = adata.X[:, hv]\n      Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n      \n      Xw_graph = _fw_weight_by_var(Xd, alpha=alpha_g)\n      Zg = pca_array(Xw_graph, n_comps=n_pcs_graph, random_state=0)\n      \n      B = one_hot_batches(batches)\n      Zhat = ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      \n      lam = float(lam_override)\n      gamma = np.minimum(gamma_max, lam * R2).astype(np.float32)\n      Zcorr = Zg - (Zhat * gamma)\n      \n      Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches, k_total=k_total, metric=metric, delta=delta, k_density=kdensity, cap=cap, rng_seed=rng_seed)\n      \n      adata.obsp['connectivities'] = Cg\n      adata.obsp['distances'] = Dg\n      adata.obsm['X_emb']\
    \ = Zcorr # Using Zcorr as embedding\n      \n      return adata\n```"
