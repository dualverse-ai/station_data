parts:
- text: "I am Logos V, and I am in the Research Counter. My age is 220 ticks.\n\nI have successfully retrieved the missing dependency, `graph_bbsg.py`. My forensic analysis and recovery plan are proceeding as expected. I will now save this final file to my local storage and then correct the import path in `praxis_core.py`. This will complete the reconstruction of the community SOTA codebase in my own storage.\n\n/execute_action{storage write logos/graph_bbsg.py}\n```yaml\ncontent: |\n  import numpy as np\n  from sklearn.neighbors import NearestNeighbors\n  from scipy import sparse as sp\n  from scipy.sparse import coo_matrix\n\n  def _build_bbsg(Z, batches, k_total=48, metric='cosine', alpha=1.0, cap=2.0):\n      Z = np.asarray(Z, dtype=np.float32)\n      batches = np.asarray(batches)\n      uniq = np.unique(batches)\n      n = Z.shape[0]\n      if n == 0 or uniq.size == 0:\n          return None, None\n\n      k_pb = max(1, int(np.ceil(k_total / max(1, uniq.size))))\n      pairs_min_dist\
    \ = {}\n\n      for b in uniq:\n          idx_train = np.where(batches == b)[0]\n          if idx_train.size == 0:\n              continue\n\n          k_cand = min(max(k_pb * 2, k_pb + 1), idx_train.size)\n          nn = NearestNeighbors(n_neighbors=k_cand, metric=metric, algorithm='auto')\n          nn.fit(Z[idx_train])\n\n          d_all, ind_local = nn.kneighbors(Z, n_neighbors=k_cand, return_distance=True)\n          neigh_global = idx_train[ind_local]\n\n          prelim_sel = []\n          col_counts = np.zeros(idx_train.size, dtype=np.int32)\n\n          for i in range(n):\n              g = neigh_global[i]\n              di = d_all[i]\n              mask = (g != i)\n              g = g[mask]\n              di = di[mask]\n              if g.size == 0:\n                  prelim_sel.append((np.empty(0, dtype=int), np.empty(0, dtype=float)))\n                  continue\n              take = min(k_pb, g.size)\n              order = np.argpartition(di, take - 1)[:take]\n         \
    \     g_take = g[order]\n              d_take = di[order]\n              prelim_sel.append((g_take, d_take))\n              loc = np.searchsorted(idx_train, g_take)\n              col_counts[loc] += 1\n\n          t_avg = (k_pb * n) / max(1, idx_train.size)\n          med_in = np.median(col_counts) if col_counts.size > 0 else 0.0\n          t = float(alpha) * float(t_avg) + float(1.0 - alpha) * float(med_in)\n          denom = np.maximum(col_counts.astype(np.float64), 1.0)\n          scales_local = np.minimum(cap, t / denom)\n\n          for i in range(n):\n              g = neigh_global[i]\n              di = d_all[i]\n              mask = (g != i)\n              g = g[mask]\n              di = di[mask]\n              if g.size == 0:\n                  continue\n              loc = np.searchsorted(idx_train, g)\n              s = scales_local[loc]\n              sort_idx = np.lexsort((di, -s))\n              take = min(k_pb, g.size)\n              sel = sort_idx[:take]\n           \
    \   g_sel = g[sel]\n              d_sel = di[sel]\n              for j, d in zip(g_sel, d_sel):\n                  if i == j:\n                      continue\n                  a, c = (i, j) if i < j else (j, i)\n                  prev = pairs_min_dist.get((a, c))\n                  if (prev is None) or (d < prev):\n                      pairs_min_dist[(a, c)] = float(d)\n\n      if not pairs_min_dist:\n          return None, None\n\n      rows, cols, dist_data = [], [], []\n      for (i, j), d in pairs_min_dist.items():\n          rows.append(i); cols.append(j); dist_data.append(d)\n          rows.append(j); cols.append(i); dist_data.append(d)\n\n      D = coo_matrix((dist_data, (rows, cols)), shape=(n, n)).tocsr()\n      C = D.copy()\n      C.data[:] = 1.0\n      return C.tocsr(), D.tocsr()\n```\n\n/execute_action{storage write logos/praxis_core.py}\n```yaml\ncontent: |\n  # This is an updated version with the corrected import path\n  import numpy as np\n  import scanpy as sc\n  import\
    \ anndata as ad\n  from scipy import sparse as sp\n  from typing import Tuple, Literal\n  from graph_bbsg import _build_bbsg # Corrected import path\n\n  def normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def pca_array(X, n_comps: int = 50, random_state: int = 0):\n      Xd = X.A if sp.issparse(X) else X\n      ad_tmp = ad.AnnData(Xd)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca']\n\n  def one_hot_batches(batches: np.ndarray):\n      cats = np.unique(batches)\n      n = batches.shape[0]\n      B = np.zeros((n, cats.size), dtype=float)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B\n\n  def ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2:\
    \ float = 1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n```"
