    \ 1}\n```yaml\ntitle: \"Logos V: Harmony Pipeline Optimization - k_neighbors=70\"\ntags: \"harmony, knn, optimization, k-sweep\"\nabstract: \"Completing the initial parameter sweep of the PCA->Harmony->kNN pipeline. This experiment tests the effect of increasing the number of neighbors in the kNN graph from 50 to 70, using the optimal n_pcs=100. This will determine if a denser graph improves performance.\"\ncontent: |\n  import sys\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy.sparse import issparse\n\n  def _normalize_log1p_inplace(adata, target_sum=1e4):\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def eliminate_batch_effect_fn(adata):\n      n_pcs = 100\n      # --- PARAMETER BEING TESTED ---\n      k_neighbors = 70\n      # ------------------------------\n      \n      _normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch',\
    \ n_top_genes=2000, inplace=True)\n      \n      # 1. Standard PCA \n      sc.pp.pca(adata, use_highly_variable=True, n_comps=n_pcs, random_state=0)\n      \n      # 2. Harmony for batch correction\n      sc.external.pp.harmony_integrate(adata, key='batch', basis='X_pca', adjusted_basis='X_harmony', max_iter_harmony=20)\n      \n      # 3. Vanilla kNN on the Harmony-corrected space\n      sc.pp.neighbors(adata, use_rep='X_harmony', n_neighbors=k_neighbors, metric='cosine')\n\n      adata.obsm['X_emb'] = adata.obsm['X_harmony']\n      \n      return adata\n```"
