    \ 1}\n```yaml\ntitle: \"PBAGC-BalancedGraph-cosine-45-noalign-resid0.70: PCA + Batch Residualization + Balanced kNN\"\ntags: \"pca, residualization, balanced-knn, cosine, no-alignment\"\nabstract: \"Increase residualization to gamma=0.70 (l2=1e-3) on PCA, then build a cosine, equal-quotas, 45-neighbor balanced kNN graph. Goal: push PCR/ASW_batch further while preserving ARI/NMI/iLISI/cLISI.\"\ncontent: |\n  import sys\n  sys.path.append('storage/praxis')\n\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n\n  from pbagc import _normalize_log1p_inplace, _get_hvg_mask, _pca_truncated_svd\n  from balanced_graph import build_balanced_knn\n  from residualize import residualize_pcs_against_batch\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      n_pca_components = 50\n      n_neighbors_total = 45\n      metric = 'cosine'\n      l2 = 1e-3\n      gamma = 0.70\n\n      print(f\"[Config] PCs={n_pca_components}, neighbors={n_neighbors_total},\
    \ metric={metric}, residualize(gamma={gamma}, l2={l2})\")\n\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n      _normalize_log1p_inplace(adata, target_sum=1e4)\n      hvg_mask = _get_hvg_mask(adata)\n      if hvg_mask.sum() < 10: hvg_mask = np.ones(adata.n_vars, dtype=bool)\n\n      X = adata.X[:, hvg_mask]\n      if not sp.issparse(X): X = sp.csr_matrix(X)\n      Z = _pca_truncated_svd(X, n_comps=n_pca_components, random_state=0)\n\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n      Z_resid = residualize_pcs_against_batch(Z, batches, l2=l2, gamma=gamma, center=True)\n\n      adata.obsm['X_emb'] = Z_resid\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=n_neighbors_total, method='umap', metric=metric)\n\n      C, D = build_balanced_knn(Z_resid, batches, n_neighbors_total=n_neighbors_total,\n                                metric=metric, weighting='binary', allocation='equal', mutual=False, symmetric=True)\n\
    \      if C is not None and D is not None:\n          adata.obsp['connectivities'] = C.tocsr()\n          adata.obsp['distances'] = D.tocsr()\n      return adata\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"PBAGC-BalancedGraph-cosine-48-noalign-resid0.68: PCA + Batch Residualization + Balanced kNN\"\ntags: \"pca, residualization, balanced-knn, cosine, no-alignment\"\nabstract: \"Keep gamma=0.68 and increase total neighbors to 48 (cosine, equal-quotas, binary) to test whether higher Graph_conn/iLISI raises the composite score under residualization.\"\ncontent: |\n  import sys\n  sys.path.append('storage/praxis')\n\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n\n  from pbagc import _normalize_log1p_inplace, _get_hvg_mask, _pca_truncated_svd\n  from balanced_graph import build_balanced_knn\n  from residualize import residualize_pcs_against_batch\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      n_pca_components\
    \ = 50\n      n_neighbors_total = 48\n      metric = 'cosine'\n      l2 = 1e-3\n      gamma = 0.68\n\n      print(f\"[Config] PCs={n_pca_components}, neighbors={n_neighbors_total}, metric={metric}, residualize(gamma={gamma}, l2={l2})\")\n\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n      _normalize_log1p_inplace(adata, target_sum=1e4)\n      hvg_mask = _get_hvg_mask(adata)\n      if hvg_mask.sum() < 10: hvg_mask = np.ones(adata.n_vars, dtype=bool)\n\n      X = adata.X[:, hvg_mask]\n      if not sp.issparse(X): X = sp.csr_matrix(X)\n      Z = _pca_truncated_svd(X, n_comps=n_pca_components, random_state=0)\n\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n      Z_resid = residualize_pcs_against_batch(Z, batches, l2=l2, gamma=gamma, center=True)\n\n      adata.obsm['X_emb'] = Z_resid\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=n_neighbors_total, method='umap', metric=metric)\n\n      C, D = build_balanced_knn(Z_resid,\
    \ batches, n_neighbors_total=n_neighbors_total,\n                                metric=metric, weighting='binary', allocation='equal', mutual=False, symmetric=True)\n      if C is not None and D is not None:\n          adata.obsp['connectivities'] = C.tocsr()\n          adata.obsp['distances'] = D.tocsr()\n      return adata\n```"
