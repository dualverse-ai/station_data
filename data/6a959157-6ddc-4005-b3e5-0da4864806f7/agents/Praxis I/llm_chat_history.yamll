    \      else:\n          return np.einsum('ij,ij->j', X, X)\n\n  def _ssb_ssw(X, batches):\n      \"\"\"Compute SSB and SSW per gene on normalized/log1p X.\"\"\"\n      n, p = X.shape\n      uniq = np.unique(batches)\n      sum_all = _sum0(X); sumsq_all = _sumsq0(X)\n      mu_all = sum_all / max(1, n)\n      var_all = np.maximum(0.0, sumsq_all / max(1, n) - mu_all**2)\n\n      SSB = np.zeros(p, dtype=np.float64)\n      SSW = np.zeros(p, dtype=np.float64)\n      for b in uniq:\n          idx = np.where(batches == b)[0]\n          nb = int(idx.size)\n          if nb == 0:\n              continue\n          Xb = X[idx, :]\n          sum_b = _sum0(Xb); sumsq_b = _sumsq0(Xb)\n          mu_b = sum_b / max(1, nb)\n          var_b = np.maximum(0.0, sumsq_b / max(1, nb) - mu_b**2)\n          SSB += nb * (mu_b - mu_all)**2\n          SSW += (nb - 1) * var_b\n      return SSB, SSW\n\n  def compute_hvg_meanshift_mask(adata: ad.AnnData, batch_key='batch', base_n=2000, buffer=300, prune_frac=0.03):\n\
    \      \"\"\"\n      Label-free HVG refinement:\n      1) Run Seurat v3 HVG with batch_key to get (base_n + buffer) candidates (ranked by variances_norm).\n      2) Take the top base_n, compute per-gene g = SSB/(SSB+SSW) on normalized/log1p X.\n      3) Drop the top prune_frac fraction by g (most batch-shifted), and refill from the next-ranked candidates to keep base_n genes.\n      Returns boolean mask of length n_vars with exactly base_n True.\n      \"\"\"\n      assert batch_key in adata.obs, \"batch key missing\"\n      n_vars = adata.n_vars\n      # HVG candidates with buffer\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key=batch_key,\n                                  n_top_genes=min(base_n + buffer, n_vars), inplace=True)\n      # Correct column for seurat_v3\n      disp = adata.var['variances_norm'].to_numpy()\n      order = np.argsort(disp)[::-1]\n      cand = order[:min(base_n + buffer, n_vars)]\n\n      # Initial top base_n set\n      top_init = cand[:min(base_n,\
    \ cand.size)]\n\n      # Compute SSB/(SSB+SSW) on normalized/log1p matrix\n      X = adata.X\n      batches = np.asarray(adata.obs[batch_key].astype('category').values)\n      SSB, SSW = _ssb_ssw(X, batches)\n      denom = np.maximum(SSB + SSW, 1e-8)\n      g = SSB / denom\n\n      # Among top_init, identify worst (highest g)\n      drop_k = max(1, int(round(prune_frac * base_n)))\n      worst_idx = np.argsort(g[top_init])[::-1][:drop_k]\n      to_drop = set(top_init[worst_idx].tolist())\n\n      # Refill from remaining candidates beyond the first base_n\n      refill = []\n      for j in cand[base_n:]:\n          if j in to_drop:\n              continue\n          refill.append(j)\n          if len(refill) >= drop_k:\n              break\n\n      # Construct final selection\n      keep_list = [j for j in top_init if j not in to_drop]\n      keep_list += refill\n      if len(keep_list) < min(base_n, cand.size):\n          # Backfill from the rest by normalized variance rank if needed\n\
    \          for j in order:\n              if j in keep_list or j in to_drop:\n                  continue\n              keep_list.append(j)\n              if len(keep_list) >= base_n:\n                  break\n\n      keep_list = keep_list[:base_n]\n      mask = np.zeros(n_vars, dtype=bool)\n      mask[np.array(keep_list, dtype=int)] = True\n      return mask\n```\n\n/execute_action{storage write praxis/research_log.md}\n```yaml\ncontent: |\n  Update (tick 184): HVG mean-shift pruning result and lineage fix\n  - EID 311 (q=3%) = 0.7111 (negative): ARI/NMI collapsed to 0.657/0.667 despite strong mixing; Graph_conn ~0.945. Debugger fixed a column mismatch (variances_norm vs dispersions_norm) in the HVG routine.\n  - Lineage fix applied to storage/praxis/hvg_meanshift_prune.py (uses 'variances_norm' for seurat_v3).\n  - EID 314 (q=2%) running; if neutral/negative, we will retain EID 289 = 0.7314 as frozen default and close the HVG-pruning line as detrimental.\n```\n\n/execute_action{goto\
