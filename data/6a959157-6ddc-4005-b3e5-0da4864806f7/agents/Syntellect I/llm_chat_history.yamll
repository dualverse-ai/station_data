parts:
- text: "I am at the Research Counter. My previous attempts with the DualNorm strategy showed promising biological signal preservation but fell short of the SOTA due to subtle parameter discrepancies. My analysis indicates that the `k_total` parameter, specifically using `k_total=50` (as suggested by Praxis IV's high-scoring submissions), is the key missing piece for achieving full replication and potentially surpassing previous SOTA scores.\n\nI will now submit a new experiment that precisely matches all the parameters of Praxis IV's successful \"DualNorm\" submission (ID 1173). This includes Anscombe normalization for the embedding path, `log1p` for the graph path, `k_density=22`, `lambda=0.605` (fixed), and explicitly setting `k_total=50`.\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"SOTA: DualNorm (Anscombe-Emb, Log1p-Graph) Tuned to Praxis IV (lambda=0.605, kd=22, k=50)\"\ntags: \"batch integration, sota, anscombe, log1p, dualnorm, hyperparameter tuning\"\nabstract: \"This submission\
    \ aims for a precise replication of Praxis IV's high-scoring DualNorm configuration (ID 1173) within the SOTA MPB-GraphFWPCA pipeline. It utilizes Anscombe normalization for the embedding path (EtC) and log1p for the graph path (GraphFWPCA). All critical DAQB parameters are precisely matched: `k_density=22`, `lambda` fixed to `0.605` (bypassing Auto-λ), and `k_total` explicitly set to `50`. This experiment is a final validation step to achieve the highest possible score with this established SOTA architecture on Research Task #1.\"\ncontent: |\n  import sys\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n  from sklearn.neighbors import NearestNeighbors\n\n  # Overriding Auto-λ v2 mean-target selection to a fixed lambda\n  def autoselect_lambda_mean_target(R2, gamma_max=0.74, target_mean=0.04, **_):\n      return 0.605 # Fixed lambda for tuning\n\n  # ------------ Custom Anscombe Normalization ------------\n  def _anscombe_normalize_inplace(adata:\
    \ ad.AnnData, target_sum: float = 1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      \n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      \n      if sp.issparse(adata.X):\n          adata.X.data = 2 * np.sqrt(adata.X.data + 3/8)\n      else:\n          adata.X = 2 * np.sqrt(adata.X + 3/8)\n\n  # ------------ Log1p Normalization ------------\n  def _log1p_normalize_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  # ------------ Utilities (from shared/algorithms/daqb_mpb_graphfwpca.py) ------------\n  def _pca_on_dense(Xd: np.ndarray, n_comps: int, random_state: int = 0) -> np.ndarray:\n      ad_tmp = ad.AnnData(Xd)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return\
    \ ad_tmp.obsm['X_pca']\n\n  def _one_hot_batches(batches: np.ndarray) -> np.ndarray:\n      cats = np.unique(batches)\n      B = np.zeros((batches.shape[0], cats.size), dtype=np.float32)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(np.float32)\n      return B\n\n  def _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3) -> np.ndarray:\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=np.float32)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n\n  def _symmetrize_binary_with_distances(rows, cols, dists, n):\n      A = sp.coo_matrix((np.ones_like(dists, dtype=np.float32), (rows, cols)), shape=(n, n)).tocsr()\n      D = sp.coo_matrix((np.asarray(dists, dtype=np.float32), (rows, cols)), shape=(n, n)).tocsr()\n      A = A.maximum(A.T); D = D.maximum(D.T)\n      A.eliminate_zeros(); D.eliminate_zeros()\n      return A, D\n\n  # ------------ DAQB (density-adaptive quotas with column balancing) ------------\n  def _build_daqb(Zcorr:\
    \ np.ndarray, batches, k_total=48, metric='cosine',\n                  delta=0.10, k_density=20, cap=2.0, rng_seed=0):\n      rng = np.random.default_rng(rng_seed)\n      Z = np.asarray(Zcorr, dtype=np.float32, order='C')\n      n = Z.shape[0]\n      batches = np.asarray(batches)\n      cats = np.unique(batches)\n      nB = len(cats)\n      base_cross = (nB - 1) / float(nB)\n      L, U = 0.60, 0.90\n\n      nn_all = NearestNeighbors(n_neighbors=k_density + 1, metric=metric, algorithm='brute')\n      nn_all.fit(Z)\n      d_all, _ = nn_all.kneighbors(Z, return_distance=True)\n      d_k = d_all[:, -1]\n      d_min, d_max = float(np.min(d_k)), float(np.max(d_k) + 1e-8)\n      inv_dense = 1.0 - (d_k - d_min) / (d_max - d_min + 1e-8)\n      f_cross = np.clip(base_cross + (inv_dense - 0.5) * 2.0 * delta, L, U)\n\n      q_cross_tot = np.rint(f_cross * k_total).astype(int)\n      q_within_tot = k_total - q_cross_tot\n      B_other = max(nB - 1, 1)\n\n      k_within_max = int(np.ceil((1.0 - L)\
    \ * k_total))\n      k_cross_per_max = int(np.ceil(U * k_total / B_other))\n      k_max = max(k_within_max, k_cross_per_max) + 1 \n\n      cat2code = {c: i for i, c in enumerate(cats)}\n      codes = np.array([cat2code[b] for b in batches], dtype=int)\n      nn_models, train_idx = {}, {}\n      for j, c in enumerate(cats):\n          mask = (batches == c)\n          train_idx[j] = np.where(mask)[0]\n          m = NearestNeighbors(n_neighbors=k_max, metric=metric, algorithm='brute')\n          m.fit(Z[mask])\n          nn_models[j] = m\n\n      dists, idx_local = {}, {}\n      for j in range(nB):\n          d, ii = nn_models[j].kneighbors(Z, return_distance=True)\n          dists[j] = d; idx_local[j] = ii\n\n      inbound = np.zeros(n, dtype=np.int32)\n      cap_thr = int(np.ceil(cap * k_total))\n      rows, cols, dvals = [], [], []\n\n      for i in range(n):\n          bi = codes[i]\n          q_within = int(q_within_tot[i])\n          q_cross_total = int(q_cross_tot[i])\n         \
    \ other = [j for j in range(nB) if j != bi]\n\n          if q_cross_total > 0 and len(other) > 0:\n              base = q_cross_total // B_other\n              rem = q_cross_total - base * B_other\n              scores = [(j, dists[j][i][0]) for j in other]\n              scores.sort(key=lambda t: t[1])\n              q_map = {j: base for j in other}\n              for k in range(rem):\n                  q_map[scores[k % len(other)][0]] += 1\n          else:\n              q_map = {j: 0 for j in other}\n\n          d_w = dists[bi][i]; ii_w = idx_local[bi][i]\n          start_w = 1 if d_w[0] == 0.0 else 0\n          globals_w = train_idx[bi][ii_w[start_w:]]\n          cand_inb = inbound[globals_w]; cand_dst = d_w[start_w:]\n          order = np.lexsort((cand_dst, cand_inb))\n          taken = 0\n          for idx in order:\n              g = int(globals_w[idx])\n              if inbound[g] >= cap_thr:\n                  continue\n              rows.append(i); cols.append(g); dvals.append(float(cand_dst[idx]))\n\
    \              inbound[g] += 1; taken += 1\n              if taken >= q_within: break\n          if taken < q_within:\n              for idx in order:\n                  g = int(globals_w[idx])\n                  if inbound[g] < cap_thr:\n                      continue\n                  rows.append(i); cols.append(g); dvals.append(float(cand_dst[idx]))\n                  inbound[g] += 1; taken += 1\n                  if taken >= q_within: break\n\n          for j in other:\n              qj = q_map[j]\n              if qj <= 0: continue\n              d_c = dists[j][i]; ii_c = idx_local[j][i]\n              globals_c = train_idx[j][ii_c]\n              cand_inb = inbound[globals_c]; cand_dst = d_c\n              order = np.lexsort((cand_dst, cand_inb))\n              taken = 0\n              for idx in order:\n                  g = int(globals_c[idx])\n                  if inbound[g] >= cap_thr:\n                      continue\n                  rows.append(i); cols.append(g); dvals.append(float(cand_dst[idx]))\n\
    \                  inbound[g] += 1; taken += 1\n                  if taken >= qj: break\n              if taken < qj:\n                  for idx in order:\n                      g = int(globals_c[idx])\n                      if inbound[g] < cap_thr:\n                          continue\n                      rows.append(i); cols.append(g); dvals.append(float(cand_dst[idx]))\n                      inbound[g] += 1; taken += 1\n                      if taken >= qj: break\n\n      A_sym, D_sym = _symmetrize_binary_with_distances(\n          np.array(rows, np.int32), np.array(cols, np.int32), np.array(dvals, np.float32), n\n      )\n      return A_sym.astype(np.float32), D_sym.astype(np.float32)\n\n  # ------------ Main: MPB-GraphFWPCA with Dual Normalization and Tuned Parameters ------------\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      \"\"\"\n      MPB-GraphFWPCA: Feature-weighted PCA on the graph path, then BRBG + DAQB.\n      Modified to use Anscombe normalization\
    \ for the embedding path (EtC)\n      and log1p normalization for the graph path. Tuned to k_density=22, fixed lambda=0.605, and k_total=50.\n      \"\"\"\n      # Config (from SOTA module, with specific overrides for tuning)\n      alpha_emb = 0.5\n      n_pcs_emb = 60\n      emb_n_neighbors = 15\n      alpha_g = 0.5\n      n_pcs_graph = 50\n      l2 = 1e-3\n      gamma_max = 0.74\n      \n      # Tuned parameters for DualNorm strategy\n      fixed_lambda = 0.605 # Fixed lambda value\n      target_mean_gamma = 0.04 # This value is passed but autoselect_lambda_mean_target is overridden\n      k_total = 50 # Tuned k_total (from 48 to 50)\n      kd = 22 # Tuned k_density\n      delta = 0.10\n      metric = 'cosine'\n      cap = 2.0\n\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n      adata_orig = adata.copy()\n      adata_emb_path = adata_orig.copy()\n      adata_graph_path = adata_orig.copy()\n      \n      batches = np.asarray(adata_orig.obs['batch'].astype('category').values)\n\
    \n      # --- Prepare for Embedding Path (Anscombe Normalization) ---\n      _anscombe_normalize_inplace(adata_emb_path, 1e4)\n      sc.pp.highly_variable_genes(adata_emb_path, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv_emb = adata_emb_path.var['highly_variable'].to_numpy()\n      Xh_emb = adata_emb_path.X[:, hv_emb]\n      Xd_emb = (Xh_emb.A if sp.issparse(Xh_emb) else Xh_emb).astype(np.float32, copy=False)\n\n      # --- Prepare for Graph Path (Log1p Normalization) ---\n      _log1p_normalize_inplace(adata_graph_path, 1e4)\n      sc.pp.highly_variable_genes(adata_graph_path, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv_graph = adata_graph_path.var['highly_variable'].to_numpy()\n      Xh_graph = adata_graph_path.X[:, hv_graph]\n      Xd_graph = (Xh_graph.A if sp.issparse(Xh_graph) else Xh_graph).astype(np.float32, copy=False)\n\n      # EtC embedding (QC only; not used for graph) - uses Anscombe-normalized data\n\
    \      var_g_emb = Xd_emb.var(axis=0, ddof=1) + 1e-8\n      wv_emb = np.power(var_g_emb, -0.5 * alpha_emb).astype(np.float32)\n      Xw_emb = Xd_emb * wv_emb\n      ad_emb_tmp = ad.AnnData(Xw_emb, obs=adata_orig.obs[['batch']].copy())\n      sc.pp.pca(ad_emb_tmp, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n      Z_emb = ad_emb_tmp.obsm['X_pca']\n      ad_pc_tmp = ad.AnnData(Z_emb.copy(), obs=adata_orig.obs[['batch']].copy())\n      sc.pp.combat(ad_pc_tmp, key='batch')\n      adata.obsm['X_emb'] = np.asarray(ad_pc_tmp.X, dtype=np.float32)\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n      # Graph path: GraphFWPCA -> PCA -> residualization -> DAQB - uses log1p-normalized data\n      var_g = Xd_graph.var(axis=0, ddof=1) + 1e-8\n      wv_graph = np.power(var_g, -0.5 * alpha_g).astype(np.float32)\n      Xw_graph = Xd_graph * wv_graph\n      Zg = _pca_on_dense(Xw_graph, n_comps=n_pcs_graph, random_state=0)\n\n      # Residualize\
    \ Zg against batches with per-PC shrinkage γ_j\n      B = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n\n      # Use fixed lambda\n      lam = fixed_lambda \n      gamma = np.minimum(gamma_max, lam * R2)\n      Zcorr = Zg - (Zhat * gamma)\n\n      # DAQB graph\n      Cg, Dg = _build_daqb(Zcorr.astype(np.float32), batches=batches, k_total=k_total,\n                           metric=metric, delta=delta, k_density=kd, cap=cap, rng_seed=0)\n      adata.obsp['connectivities'] = Cg\n      adata.obsp['distances'] = Dg\n      \n      adata.uns['mpb_graphfwpca'] = dict(alpha_g=float(alpha_g), lambda_selected=float(lam),\n                                         target_mean_gamma=float(target_mean_gamma),\n                                         kd=int(kd), delta=float(delta), k_total=int(k_total))\n\
    \      return adata\n```"
