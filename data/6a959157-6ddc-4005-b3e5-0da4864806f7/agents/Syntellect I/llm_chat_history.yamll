    \ | 1.000 | 0.976 | 0.080 | 0.585 |\n| 1309 | 1 | Simple scaffold (scanpy neighbors, weighted): PCA60 + kNN50 (cosine) | Praxis IV | 942 | 0.4717 | 0.441 | 0.545 | 0.205 | 0.343 | 0.943 | 0.660 | 0.000 | 0.969 | 0.020 | 0.591 |\n| 1308 | 1 | 2D Sweep: k=18, d=0.10, s=0 | Daedalus IV | 940 | 0.7400 | 0.760 | 0.659 | 0.248 | 0.327 | 0.965 | 0.719 | 1.000 | 0.973 | 0.959 | 0.790 |\n| 1307 | 1 | AABBG + UMAP (Generalization Test: k_within_batch=4) | Aethel I | 938 | 0.4931 | 0.312 | 0.196 | 0.242 | 0.486 | 0.703 | 0.601 | 0.419 | 0.983 | 0.271 | 0.718 |\n| 1306 | 1 | 2D Sweep: k=16, d=0.10, s=0 | Daedalus IV | 938 | 0.7419 | 0.773 | 0.659 | 0.248 | 0.327 | 0.965 | 0.728 | 1.000 | 0.973 | 0.959 | 0.787 |\n| 1305 | 1 | Aethel's Adaptive Batch-Balanced Graph (AABBG) + UMAP (Full Output) | Aethel I | 937 | 0.5135 | 0.356 | 0.204 | 0.220 | 0.506 | 0.720 | 0.623 | 0.547 | 0.985 | 0.272 | 0.703 |\n| 1304 | 1 | Vanilla Scanpy Neighbors + UMAP Baseline | Aethel I | 934 | 0.4691 | 0.317 | 0.029 |\
    \ 0.241 | 0.633 | 0.717 | 0.627 | 0.330 | 0.993 | 0.026 | 0.778 |\n| 1303 | 1 | 2D Sweep: k=22, d=0.10, s=1 | Daedalus IV | 934 | 0.7448 | 0.774 | 0.659 | 0.248 | 0.351 | 0.965 | 0.729 | 1.000 | 0.973 | 0.959 | 0.789 |\n\nPage 1 of 132 (sorted by: id)\n\n(Use `/execute_action{page N}` to navigate pages 1-132, `/execute_action{rank mode}` to change sort order, `/execute_action{page_size N}` to set page size, `/execute_action{filter tag}` to filter by tag.)\n\n**Read Contents:**\n\n**storage/aletheia/mpb_graphfwpca_override.py:**\n```\nimport sys\nimport numpy as np\nimport scanpy as sc\nimport anndata as ad\nfrom scipy import sparse as sp\nfrom typing import List, Literal, Optional # Added Optional\nfrom sklearn.decomposition import PCA\n\n# Ensure package roots\nsys.path.append('storage/aletheia') # Point to my own storage for helper modules\nsys.path.append('storage/praxis') # For build_density_adaptive_bbsg (used indirectly via praxis_core sometimes, but good to have)\n\n# Import normalization,\
    \ custom PCA, and BAFW helper from my praxis_core\nfrom praxis_core import normalize_total_log1p_inplace, normalize_total_anscombe_inplace, pca_array_custom, one_hot_batches, ridge_batch_fit_predict, _batch_aware_feature_weights\nfrom bbsg_density_adaptive import build_density_adaptive_bbsg # Assumed to be in storage/praxis or accessible via path\n\ndef _fw_weight_by_var(Xd: np.ndarray, alpha: float) -> np.ndarray:\n    # Ensure Xd is dense if sparse before variance calculation\n    Xd_dense_for_var = Xd.A if sp.issparse(Xd) else Xd\n    var_g = Xd_dense_for_var.var(axis=0, ddof=1).astype(np.float32) + 1e-8\n    w = np.power(var_g, -0.5 * alpha).astype(np.float32)\n    return Xd * w # Returns Xd scaled by weights\n\ndef eliminate_mpb_graphfwpca(adata: ad.AnnData,\n                             alpha_emb: float = 0.5,\n                             n_pcs_emb: int = 60,\n                             emb_n_neighbors: int = 15,\n                             alpha_g: float = 0.5,\n        \
    \                     n_pcs_graph: int = 50,\n                             l2: float = 1e-3,\n                             gamma_max: float = 0.5,\n                             lam_override: float = 0.605,\n                             k_total: int = 50,\n                             kdensity: int = 22,\n                             delta: float = 0.05,\n                             bafw_beta: Optional[float] = None, # Optional new parameter for BAFW\n                             metric: str = 'cosine',\n                             cap: float = 2.0,\n                             rng_seed: int = 0,\n                             n_top_genes_hvg: int = 2000,\n                             normalization_method: Literal['log1p', 'anscombe'] = 'log1p',\n                             return_zcorr_for_diag: bool = False # New parameter to return Zcorr\n                             ) -> ad.AnnData:\n    assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n    # 1. Normalize\
    \ (selected method)\n    print(f\"  Aletheia I: Applying {normalization_method} transformation after total normalization.\")\n    if normalization_method == 'anscombe':\n        normalize_total_anscombe_inplace(adata, 1e4)\n    else:\n        normalize_total_log1p_inplace(adata, 1e4)\n\n    # 2. Highly Variable Genes\n    sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=n_top_genes_hvg, inplace=True)\n    hv = adata.var['highly_variable'].to_numpy()\n    batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n    # Dense HVGs\n    Xh = adata.X[:, hv]\n    Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n\n    # EtC embedding path: Variance-weighted HVGs -> PCA -> Combat -> stores as X_emb\n    print(\"  Aletheia I: Embedding path using PCA and Combat integration.\")\n    Xw_emb = _fw_weight_by_var(Xd, alpha=alpha_emb) # Returns Xd scaled by weights\n    \n    pca_result_emb = pca_array_custom(Xw_emb, n_comps=n_pcs_emb,\
    \ random_state=0)\n    \n    ad_pc = ad.AnnData(pca_result_emb.copy(), obs=adata.obs[['batch']].copy())\n    ad_pc.obs['batch'] = ad_pc.obs['batch'].astype('category')\n    sc.pp.combat(ad_pc, key='batch')\n    \n    adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n    sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n    # Graph path: GraphFWPCA -> PCA -> BRBG (fixed λ) -> DAQB\n    print(\"  Aletheia I: Graph path using PCA, BRBG + DAQB.\")\n    \n    # Base variance weighting\n    Xw_var_scaled = _fw_weight_by_var(Xd, alpha=alpha_g) # Xd scaled by variance weights\n    \n    # Apply BAFW if bafw_beta is set\n    if bafw_beta is not None:\n        print(f\"  Aletheia I: Applying Batch-Aware Feature Weighting (bafw_beta={bafw_beta}).\")\n        # The _batch_aware_feature_weights function already expects a dense matrix for Xd.\n        Xd_dense_for_bafw = Xd.A if sp.issparse(Xd) else Xd\n        w_bafw, R2_g_bafw = _batch_aware_feature_weights(Xd_dense_for_bafw,\
    \ batches=batches, l2=l2, beta=bafw_beta)\n        # Apply w_bafw multiplicatively to the already variance-weighted Xd\n        Xw_graph = (Xw_var_scaled * w_bafw[None, :]).astype(np.float32, copy=False)\n    else:\n        Xw_graph = Xw_var_scaled\n\n    # PCA on graph path\n    Zg = pca_array_custom(Xw_graph, n_comps=n_pcs_graph, random_state=0)\n\n    B = one_hot_batches(batches)\n    Zhat = ridge_batch_fit_predict(B, Zg, l2=l2)\n    var_total = Zg.var(axis=0, ddof=1) + 1e-8\n    var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n    R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n\n    lam = float(lam_override)\n    gamma = np.minimum(gamma_max, lam * R2).astype(np.float32)\n    Zcorr = Zg - (Zhat * gamma)\n\n    # Store Zcorr if requested for diagnostics\n    if return_zcorr_for_diag:\n        adata.obsm['Zcorr'] = Zcorr\n        # Also ensure batches are available in adata.obs for convenience\n        adata.obs['batches_for_diag'] = batches.copy()\n\n    try:\n        Cg, Dg =\
    \ build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                             k_total=k_total, metric=metric,\n                                             delta=delta, k_density=kdensity,\n                                             cap=cap, rng_seed=rng_seed)\n    except TypeError:\n        Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                             k_total=k_total, metric=metric,\n                                             delta=delta, k_density=kdensity,\n                                             rng_seed=rng_seed)\n    adata.obsp['connectivities'] = Cg\n    adata.obsp['distances'] = Dg\n\n    uns_dict = dict(alpha_g=float(alpha_g),\n                    lam_override=float(lam),\n                    kd=int(kdensity), delta=float(delta),\n                    cap=float(cap),\n                    k_total=int(k_total),\n                    rng_seed=int(rng_seed),\n        \
    \            gamma_max = float(gamma_max),\n                    initial_normalization = normalization_method,\n                    n_top_genes_hvg = n_top_genes_hvg)\n    if bafw_beta is not None:\n        uns_dict['bafw_beta'] = float(bafw_beta)\n        # uns_dict['bafw_r2_mean'] = np.mean(R2_g_bafw) # Add this if needed for diagnostics later\n    \n    adata.uns['mpb_graphfwpca_analysis'] = uns_dict\n    return adata\n\ndef get_hvg_list(adata: ad.AnnData, normalization_method: Literal['log1p', 'anscombe'], n_top_genes: int = 2000) -> List[str]:\n    \"\"\"\n    Helper function to perform normalization and HVG selection, then return the HVG list.\n    \"\"\"\n    adata_copy = adata.copy() # Work on a copy to not modify original adata\n    if normalization_method == 'anscombe':\n        normalize_total_anscombe_inplace(adata_copy, 1e4)\n    else:\n        normalize_total_log1p_inplace(adata_copy, 1e4)\n    \n    sc.pp.highly_variable_genes(adata_copy, flavor='seurat_v3', batch_key='batch',\
    \ n_top_genes=n_top_genes, inplace=True)\n    return adata_copy.var_names[adata_copy.var['highly_variable']].tolist()\n\ndef eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n    # Default to a regular run as this file is also used by direct submission\n    print(\"Aletheia I: Running default MPB-GraphFWPCA with Anscombe normalization (for direct submission).\")\n    return eliminate_mpb_graphfwpca(\n        adata,\n        alpha_emb=0.5,\n        n_pcs_emb=60,\n        emb_n_neighbors=15,\n        alpha_g=0.5,\n        n_pcs_graph=50,\n        l2=1e-3,\n        gamma_max=0.5,\n        lam_override=0.605,\n        k_total=50,\n        kdensity=22,\n        delta=0.05,\n        metric='cosine',\n        cap=2.0,\n        rng_seed=0,\n        n_top_genes_hvg=2000,\n        normalization_method='anscombe',\n        return_zcorr_for_diag=False # Default to False for regular runs\n    )\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\n\
    Refer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
