    - diagnostics/ridge_entries/heart_PraxisII_neighbors_ablation.yaml\n- diagnostics/ridge_entries/heart_PraxisII_wrapper_parity.yaml\n- diagnostics/ridge_entries/heart_SophiaIII_798.yaml\n- diagnostics/ridge_entries/heart_SophiaIII_836.yaml\n- diagnostics/ridge_entries/heart_SophiaIII_861.yaml\n- diagnostics/ridge_entries/heart_SophiaIII_913.yaml\n- diagnostics/ridge_entries/heart_logos_v_handover_grid.yaml\n- diagnostics/ridge_entries/heart_praxis_iv.yaml\n- diagnostics/ridge_entries/heart_praxis_iv_v2.yaml\n- diagnostics/ridge_entries/heart_praxis_iv_v3.yaml\n- diagnostics/ridge_entries/heart_praxis_iv_v4.yaml\n- diagnostics/ridge_entries/heart_ridge_summary.csv\n- diagnostics/ridge_entries/human_logos_779.yaml\n- diagnostics/ridge_entries/human_logos_lam0.9_sweep.yaml\n- diagnostics/ridge_entries/human_logos_sota_sweeps.yaml\n- diagnostics/ridge_entries/ridge_index.csv\n- diagnostics/ridge_entry_template.yaml\n- diagnostics/ridge_suite.py\n- diagnostics/runbook_cross_organ.md\n- diagnostics/seed_average.py\n\
    - diagnostics/synergy_aggregate.py\n- diagnostics/synergy_results_880.json\n- diagnostics/synergy_results_SophiaIII.json\n- diagnostics/synergy_results_sophia_iii_exp25.1.json\n- diagnostics/synergy_results_sophia_iii_exp25.3.json\n- diagnostics/synergy_summary.csv\n- examples/__init__.py\n- examples/apply_daqb_on_embedding_test.py\n- examples/new_organ_quickstart.py\n- examples/quickstart_ridge_test.py\n- examples/sym_prototypes_test.py\n- examples/sym_prototypes_test_v3.py\n- registry/CONTRIBUTING.md\n- registry/README.md\n- registry/__init__.py\n- registry/external_variants_heart_v4.yaml\n- sym/adapter_symmetrize_ridge.py\n- sym/sym_bmatching_greedy.py\n- sym/sym_invite_trim.py\n- sym/sym_invite_trim_v3.py\n\n\n**Read Contents:**\n\n**praxis/new_organ_entry.py:**\n```\nimport sys\nimport anndata as ad\nsys.path.append('storage/praxis')\nfrom graphfwpca_ridge import integrate_graphfwpca_ridge\nfrom runtime_logging import log_graph_stats\n\n# Minimal entrypoint for rapid submission\
    \ on new organ.\n# Ridge GraphFWPCA with kd=22, k=50 and configurable delta.\nDELTA = 0.12\nKD = 22\nK = 50\nN_PCS = 100\nSEED = 0  # switch to 1 for second seed run\n\ndef eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n    adata = integrate_graphfwpca_ridge(\n        adata,\n        n_pcs=N_PCS,\n        k=K,\n        kd=KD,\n        delta=DELTA,\n        metric=\"euclidean\",\n        mutual_boost=1.10,\n        seed=SEED,\n    )\n    log_graph_stats(adata, title=f\"new_organ_entry delta={DELTA} seed={SEED}\")\n    return adata\n\n```\n---\n**praxis/new_organ_eq_quota_entry.py:**\n```\nimport numpy as np\nimport anndata as ad\nimport scipy.sparse as sp\nfrom sklearn.decomposition import TruncatedSVD\nfrom sklearn.neighbors import NearestNeighbors\n\ndef _to_csr(X):\n    if sp.isspmatrix_csr(X): return X\n    if sp.issparse(X): return X.tocsr()\n    return sp.csr_matrix(X)\n\ndef _row_scale_csr(X, scale):\n    if not sp.issparse(X):\n        return (X.T * scale).T\n  \
    \  X = _to_csr(X).copy()\n    X.data *= np.repeat(scale, np.diff(X.indptr))\n    return X\n\ndef _normalize_log1p_from_counts(adata):\n    Xc = adata.layers['counts'] if 'counts' in adata.layers else adata.X\n    Xc = _to_csr(Xc).astype(np.float32)\n    lib = np.asarray(Xc.sum(axis=1)).ravel()\n    lib = np.maximum(lib, 1e-9)\n    scale = (1e4 / lib).astype(np.float32)\n    Xn = _row_scale_csr(Xc, scale)\n    Xn = Xn.copy()\n    Xn.data = np.log1p(Xn.data)\n    return Xn\n\ndef _select_hvgs(X, adata):\n    if 'batch_hvg' in adata.var.columns:\n        mask = adata.var['batch_hvg'].values.astype(bool)\n        if mask.any() and mask.sum() < X.shape[1]:\n            return X[:, mask]\n    return X\n\ndef _pca_truncated(X, n_components=50, random_state=1):\n    n_cells, n_genes = X.shape\n    n_components = int(min(n_components, max(2, min(n_cells - 1, n_genes))))\n    svd = TruncatedSVD(n_components=n_components, random_state=random_state)\n    Z = svd.fit_transform(X)\n    return Z.astype(np.float32)\n\
    \ndef _one_hot_batches(batches: np.ndarray):\n    uniq, inv = np.unique(batches, return_inverse=True)\n    B = np.zeros((batches.shape[0], uniq.size), dtype=np.float32)\n    B[np.arange(batches.shape[0]), inv] = 1.0\n    return B, uniq\n\ndef _ridge_residualize_per_pc(Z: np.ndarray, batches: np.ndarray, lam_r: float = 0.64) -> np.ndarray:\n    Zc = Z.copy().astype(np.float32)\n    B, _ = _one_hot_batches(batches.astype(str))\n    # (B^T B + lam I)^{-1} B^T Z for all PCs at once\n    BtB = B.T @ B\n    d = BtB.shape[0]\n    BtB_l2 = BtB + lam_r * np.eye(d, dtype=np.float32)\n    inv = np.linalg.pinv(BtB_l2)\n    W = inv @ B.T @ Zc  # shape (d, p)\n    Zhat = B @ W\n    return (Zc - Zhat).astype(np.float32)\n\ndef _equal_quota_knn(Z: np.ndarray, batches: np.ndarray, k: int = 50, k_candidates: int = 1280, metric: str = \"cosine\"):\n    \"\"\"\n    Build kNN with equal per-batch quotas per node using a candidate pool of size k_candidates.\n    Binary symmetric connectivities; distances\
    \ are true distances from the queried direction (min on symmetrization).\n    \"\"\"\n    n = Z.shape[0]\n    nn = NearestNeighbors(n_neighbors=k_candidates + 1, metric=metric).fit(Z)\n    d_all, idx_all = nn.kneighbors(Z, return_distance=True)\n    d_all = d_all[:, 1:]\n    idx_all = idx_all[:, 1:]\n\n    b = batches.astype(str)\n    uniq = np.unique(b)\n    B = len(uniq)\n    per_batch_cap = max(1, int(np.ceil(k / max(1, B))))  # equal quotas by count\n\n    rows = []\n    cols = []\n    dists = []\n    # Greedy per-row fill under per-batch caps\n    for i in range(n):\n        used = {ub: 0 for ub in uniq}\n        sel = 0\n        for j in range(idx_all.shape[1]):\n            nbr = idx_all[i, j]\n            if nbr == i:  # safety\n                continue\n            ub = b[nbr]\n            if used[ub] < per_batch_cap:\n                rows.append(i); cols.append(nbr); dists.append(d_all[i, j]); used[ub] += 1; sel += 1\n                if sel >= k:\n                    break\n\
    \        # If not enough under strict quota, top up ignoring caps\n        if sel < k:\n            for j in range(idx_all.shape[1]):\n                nbr = idx_all[i, j]\n                if nbr == i or nbr in cols[-sel:]:\n                    continue\n                rows.append(i); cols.append(nbr); dists.append(d_all[i, j]); sel += 1\n                if sel >= k:\n                    break\n    C_dir = sp.coo_matrix((np.ones(len(rows), dtype=np.float64), (rows, cols)), shape=(n, n)).tocsr()\n    D_dir = sp.coo_matrix((np.array(dists, dtype=np.float64), (rows, cols)), shape=(n, n)).tocsr()\n    C = C_dir.maximum(C_dir.T).tocsr().astype(np.float64)\n    D = D_dir.minimum(D_dir.T).tocsr().astype(np.float64)\n    return C, D\n\ndef _set_neighbors_meta(adata: ad.AnnData, k: int, method: str, metric: str, extra: dict):\n    adata.uns['neighbors'] = {\n        'connectivities_key': 'connectivities',\n        'distances_key': 'distances',\n        'params': {'n_neighbors': int(k), 'method':\
    \ method, 'metric': metric, **{str(k): v for k, v in extra.items()}}\n    }\n\ndef eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n    \"\"\"\n    New-organ equal-quota minimal baseline:\n    - Normalize from raw counts (1e4 + log1p); HVG mask if available.\n    - Graph PCs: PCA(50) then ridge residualization vs batch (lam_r=0.64).\n    - Equal-quota kNN with k=50, k_candidates=1280, cosine metric; binary symmetric connectivities and true distances.\n    - Embedding path left empty (optional: fill with PCA60 if desired).\n    \"\"\"\n    Xn = _normalize_log1p_from_counts(adata)\n    Xn = _select_hvgs(Xn, adata)\n\n    Zg = _pca_truncated(Xn, n_components=50, random_state=1)\n    batches = np.asarray(adata.obs['batch']).astype(str)\n    Zg_corr = _ridge_residualize_per_pc(Zg, batches, lam_r=0.64)\n\n    C, D = _equal_quota_knn(Zg_corr, batches=batches, k=50, k_candidates=1280, metric=\"cosine\")\n\n    # Optional minimalist embedding (plain PCA60) for completeness\n    Ze\
    \ = TruncatedSVD(n_components=60, random_state=0).fit_transform(Xn).astype(np.float32)\n    adata.obsm['X_emb'] = Ze\n    adata.obsp['connectivities'] = C\n    adata.obsp['distances'] = D\n    _set_neighbors_meta(adata, k=50, method='equal_quota+ridge_resid', metric='cosine', extra={'k_candidates': 1280})\n    return adata\n\n```\n---\n**praxis/new_organ_dualnorm_entry.py:**\n```\nimport numpy as np\nimport scipy.sparse as sp\nimport anndata as ad\nfrom sklearn.decomposition import TruncatedSVD\nimport scanpy as sc\n\nEPS = 1e-12\n\n# ---- Sparse helpers ----\ndef _to_csr(X):\n    if sp.isspmatrix_csr(X): return X\n    if sp.issparse(X): return X.tocsr()\n    return sp.csr_matrix(X)\n\ndef _row_scale_csr(X, scale):\n    if not sp.issparse(X):\n        return (X.T * scale).T\n    X = _to_csr(X).copy()\n    X.data *= np.repeat(scale, np.diff(X.indptr))\n    return X\n\n# ---- Normalizations ----\ndef _normalize_log1p_from_counts(adata: ad.AnnData):\n    Xc = adata.layers['counts'] if 'counts'\
    \ in adata.layers else adata.X\n    Xc = _to_csr(Xc).astype(np.float32)\n    lib = np.asarray(Xc.sum(axis=1)).ravel()\n    lib = np.maximum(lib, 1e-9)\n    scale = (1e4 / lib).astype(np.float32)\n    Xn = _row_scale_csr(Xc, scale)\n    Xn = Xn.copy(); Xn.data = np.log1p(Xn.data)\n    return Xn\n\ndef _anscombe_from_counts(adata: ad.AnnData):\n    # y' = 2*sqrt(y + 3/8) applied to raw counts\n    Xc = adata.layers['counts'] if 'counts' in adata.layers else adata.X\n    Xc = _to_csr(Xc).astype(np.float32).copy()\n    Xc.data = 2.0 * np.sqrt(Xc.data + np.float32(0.375))\n    return Xc\n\ndef _select_hvgs(X, adata):\n    if 'batch_hvg' in adata.var.columns:\n        m = adata.var['batch_hvg'].values.astype(bool)\n        if m.any() and m.sum() < X.shape[1]:\n            return X[:, m]\n    return X\n\n# ---- PCA and PBVE-lite ----\ndef _pca_truncated(X, n_components=60, random_state=0):\n    n_cells, n_genes = X.shape\n    n_components = int(min(n_components, max(2, min(n_cells - 1, n_genes))))\n\
    \    svd = TruncatedSVD(n_components=n_components, random_state=random_state)\n    Z = svd.fit_transform(X)\n    return Z.astype(np.float32)\n\ndef _pbve_lite_equalize(Z: np.ndarray, batches) -> np.ndarray:\n    b = np.asarray(batches).astype(str)\n    Zc = Z.copy().astype(np.float32)\n    uniq = np.unique(b); p = Z.shape[1]\n    stds = np.zeros((len(uniq), p), dtype=np.float32)\n    for i, ub in enumerate(uniq):\n        idx = (b == ub)\n        stds[i] = Z[idx].std(axis=0).astype(np.float32) if np.any(idx) else 1.0\n    target = np.maximum(stds.mean(axis=0), EPS).astype(np.float32)\n    for i, ub in enumerate(uniq):\n        idx = (b == ub)\n        if np.any(idx):\n            sb = np.maximum(stds[i], EPS)\n            Zc[idx] *= (target / sb)[None, :]\n    return Zc\n\n# ---- Entry function (DualNorm-style template) ----\ndef eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n    \"\"\"\n    DualNorm-style template for a new organ:\n      - Embedding path: Anscombe normalization\
    \ of raw counts -> HVG mask -> PCA(60) -> X_emb.\n      - Graph path: log1p normalization -> HVG mask -> sc.pp.scale(zero_center=False)\n                    -> PCA(60) -> PBVE-lite equalization -> scanpy.neighbors (k=50, cosine).\n    Returns both obsm['X_emb'] and obsp['connectivities']/['distances'].\n    \"\"\"\n    # Embedding (Anscombe)\n    Xa = _anscombe_from_counts(adata)\n    Xa = _select_hvgs(Xa, adata)\n    Ze = _pca_truncated(Xa, n_components=60, random_state=0)\n\n    # Graph (log1p + scale + PBVE-lite)\n    Xg = _normalize_log1p_from_counts(adata)\n    Xg = _select_hvgs(Xg, adata)\n    ad_graph = ad.AnnData(X=Xg.toarray(), obs=adata.obs.copy())  # 20k x 2k fits in memory\n    sc.pp.scale(ad_graph, zero_center=False, max_value=None)\n    Zg = _pca_truncated(ad_graph.X, n_components=60, random_state=1)\n    Zg_pbve = _pbve_lite_equalize(Zg, ad_graph.obs['batch'].values)\n    ad_nb = ad.AnnData(X=Zg_pbve, obs=ad_graph.obs.copy())\n    sc.pp.neighbors(ad_nb, n_neighbors=50,\
    \ use_rep=None, metric='cosine')\n\n    # Write outputs\n    adata.obsm['X_emb'] = Ze.astype(np.float32)\n    adata.obsp['connectivities'] = ad_nb.obsp['connectivities'].tocsr().astype(np.float64)\n    adata.obsp['distances'] = ad_nb.obsp['distances'].tocsr().astype(np.float64)\n    adata.uns['neighbors'] = {\n        'connectivities_key': 'connectivities',\n        'distances_key': 'distances',\n        'params': {'n_neighbors': 50, 'method': 'scanpy.neighbors', 'metric': 'cosine'}\n    }\n    return adata\n\n```\n---\n**praxis/new_organ_pbve_entry.py:**\n```\nimport numpy as np\nimport scipy.sparse as sp\nfrom sklearn.decomposition import TruncatedSVD\nfrom sklearn.neighbors import NearestNeighbors\nimport anndata as ad\n\nEPS = 1e-12\n\ndef _to_csr(X):\n    if sp.isspmatrix_csr(X): return X\n    if sp.issparse(X): return X.tocsr()\n    return sp.csr_matrix(X)\n\ndef _row_scale_csr(X, scale):\n    if not sp.issparse(X):\n        return (X.T * scale).T\n    X = _to_csr(X).copy()\n \
    \   X.data *= np.repeat(scale, np.diff(X.indptr))\n    return X\n\ndef _normalize_log1p_from_counts(adata: ad.AnnData):\n    Xc = adata.layers['counts'] if 'counts' in adata.layers else adata.X\n    Xc = _to_csr(Xc).astype(np.float32)\n    lib = np.asarray(Xc.sum(axis=1)).ravel()\n    lib = np.maximum(lib, 1e-9)\n    scale = (1e4 / lib).astype(np.float32)\n    Xn = _row_scale_csr(Xc, scale)\n    Xn = Xn.copy()\n    Xn.data = np.log1p(Xn.data)\n    return Xn\n\ndef _select_hvgs(X, adata):\n    if 'batch_hvg' in adata.var.columns:\n        mask = adata.var['batch_hvg'].values.astype(bool)\n        if mask.any() and mask.sum() < X.shape[1]:\n            return X[:, mask]\n    return X\n\ndef _pca_truncated(X, n_components=60, random_state=0):\n    n_cells, n_genes = X.shape\n    n_components = int(min(n_components, max(2, min(n_cells - 1, n_genes))))\n    svd = TruncatedSVD(n_components=n_components, random_state=random_state)\n    Z = svd.fit_transform(X)\n    return Z.astype(np.float32)\n\
    \ndef _pbve_lite_equalize(Z: np.ndarray, batches: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Per-batch per-PC variance equalization (\"PBVE-lite\"):\n    For each PC j and batch b, scale by target_std_j / std_{b,j}, with target=mean over batches.\n    \"\"\"\n    Zc = Z.copy().astype(np.float32)\n    bvals = np.asarray(batches)\n    # Compute per-batch std per component\n    uniq = np.unique(bvals)\n    B = len(uniq)\n    n_comps = Z.shape[1]\n    stds = np.zeros((B, n_comps), dtype=np.float32)\n    for i, b in enumerate(uniq):\n        idx = (bvals == b)\n        if np.any(idx):\n            stds[i] = Z[idx].std(axis=0).astype(np.float32)\n        else:\n            stds[i] = 1.0\n    target = np.maximum(stds.mean(axis=0), EPS).astype(np.float32)\n    # Apply scaling per batch\n    for i, b in enumerate(uniq):\n        idx = (bvals == b)\n        sb = np.maximum(stds[i], EPS)\n        factors = (target / sb).astype(np.float32)  # shape (n_comps,)\n        if np.any(idx):\n        \
    \    Zc[idx] *= factors[None, :]\n    return Zc\n\ndef _build_knn_graph(Z: np.ndarray, k=50, metric=\"euclidean\"):\n    \"\"\"\n    Build symmetric kNN graph with binary connectivities and true distances.\n    Returns (connectivities CSR[float64], distances CSR[float64])\n    \"\"\"\n    n = Z.shape[0]\n    nn = NearestNeighbors(n_neighbors=k + 1, metric=metric).fit(Z)\n    d_all, idx_all = nn.kneighbors(Z, return_distance=True)\n    d = d_all[:, 1:]\n    idx = idx_all[:, 1:]\n    rows = np.repeat(np.arange(n), k)\n    cols = idx.ravel()\n    data_conn = np.ones_like(cols, dtype=np.float64)\n    data_dist = d.ravel().astype(np.float64)\n\n    C_dir = sp.coo_matrix((data_conn, (rows, cols)), shape=(n, n)).tocsr()\n    D_dir = sp.coo_matrix((data_dist, (rows, cols)), shape=(n, n)).tocsr()\n\n    # Symmetric union for connectivities (max) and min for distances\n    C_sym = C_dir.maximum(C_dir.T).tocsr().astype(np.float64)\n    # For distances, where edge absent use 0; we want min over\
    \ existing directions; handle with masks\n    D_sym = D_dir.copy().astype(np.float64)\n    D_sym = D_sym.minimum(D_sym.T).tocsr()\n    return C_sym, D_sym\n\ndef eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n    \"\"\"\n    New-organ PBVE-lite baseline:\n    - Normalize from raw counts (1e4 + log1p); HVG mask if available.\n    - PCA(60) -> PBVE-lite per-batch per-PC variance equalization (on embedding).\n    - Build kNN graph (k=50) on the PBVE-lite corrected embedding.\n    Returns:\n      obsm['X_emb']: corrected PCs\n      obsp['connectivities'], obsp['distances']: symmetric CSR matrices\n    \"\"\"\n    # 1) Normalize + HVGs\n    Xn = _normalize_log1p_from_counts(adata)\n    Xn = _select_hvgs(Xn, adata)\n\n    # 2) PCA\n    Z = _pca_truncated(Xn, n_components=60, random_state=0)\n\n    # 3) PBVE-lite\n    batches = np.asarray(adata.obs['batch']).astype(str)\n    Zc = _pbve_lite_equalize(Z, batches)\n\n    # 4) kNN graph on corrected embedding\n    C, D = _build_knn_graph(Zc,\
    \ k=50, metric=\"euclidean\")\n\n    # 5) Write results\n    adata.obsm['X_emb'] = Zc.astype(np.float32)\n    adata.obsp['connectivities'] = C\n    adata.obsp['distances'] = D\n    return adata\n\n```\n---\n**praxis/diag_sigma_kd.py:**\n```\nimport numpy as np\nimport pandas as pd\nfrom sklearn.neighbors import NearestNeighbors\n\ndef _gini(x: np.ndarray) -> float:\n    x = np.asarray(x, dtype=float).ravel()\n    x = x[x >= 0]\n    if x.size == 0:\n        return 0.0\n    x_sorted = np.sort(x)\n    n = x_sorted.size\n    cumx = np.cumsum(x_sorted, dtype=float)\n    g = (n + 1 - 2 * np.sum(cumx) / cumx[-1]) / n\n    return float(g)\n\ndef _cv(x: np.ndarray) -> float:\n    x = np.asarray(x, dtype=float).ravel()\n    m = np.mean(x)\n    s = np.std(x, ddof=0)\n    return float(0.0 if m == 0 else s / m)\n\ndef sigma_kd_from_embedding(Z: np.ndarray, kd: int = 22, extra: int = 16, metric: str = \"euclidean\") -> np.ndarray:\n    \"\"\"\n    Compute kd-th neighbor distance per cell from an embedding\
    \ Z (n x d).\n    Returns array of shape (n,). Self neighbor excluded.\n    \"\"\"\n    n = Z.shape[0]\n    kq = int(kd + extra)\n    nn = NearestNeighbors(n_neighbors=kq + 1, metric=metric).fit(Z)\n    d_all, _ = nn.kneighbors(Z, return_distance=True)\n    d = d_all[:, 1:]  # drop self\n    kd_idx = max(1, min(kd, d.shape[1])) - 1\n    return d[:, kd_idx].astype(np.float64)\n\ndef per_batch_summary(sig: np.ndarray, batches: np.ndarray) -> pd.DataFrame:\n    df = pd.DataFrame({\"sigma_kd\": sig, \"batch\": batches})\n    rows = []\n    for b, sub in df.groupby(\"batch\"):\n        x = sub[\"sigma_kd\"].values\n        rows.append({\n            \"batch\": b,\n            \"n\": x.size,\n            \"median\": float(np.median(x)),\n            \"mean\": float(np.mean(x)),\n            \"cv\": _cv(x),\n            \"gini\": _gini(x),\n        })\n    return pd.DataFrame(rows).sort_values(\"batch\").reset_index(drop=True)\n\ndef global_summary(sig: np.ndarray) -> dict:\n    return {\n\
    \        \"n\": int(sig.size),\n        \"median\": float(np.median(sig)),\n        \"mean\": float(np.mean(sig)),\n        \"cv\": _cv(sig),\n        \"gini\": _gini(sig),\n    }\n\ndef summarize_sigma_kd(adata, kd: int = 22, obsm_key: str = \"X_emb\", batch_key: str = \"batch\"):\n    \"\"\"\n    Compute global and per-batch summaries of sigma_kd from an embedding stored in adata.obsm[obsm_key].\n    Prints a concise table and returns (global_dict, per_batch_df).\n    \"\"\"\n    if obsm_key not in adata.obsm:\n        raise KeyError(f\"Missing embedding in obsm['{obsm_key}']\")\n    Z = np.asarray(adata.obsm[obsm_key])\n    sig = sigma_kd_from_embedding(Z, kd=kd)\n    batches = np.asarray(adata.obs[batch_key]).astype(str)\n    gsum = global_summary(sig)\n    bsum = per_batch_summary(sig, batches)\n    print(\"Global:\", gsum)\n    print(\"Per-batch:\")\n    print(bsum.to_string(index=False))\n    return gsum, bsum\n\n```\n---\n**praxis/profile_kq_runtime.py:**\n```\nimport time\n\
    import tracemalloc\nimport numpy as np\nimport scipy.sparse as sp\nfrom sklearn.decomposition import TruncatedSVD\nfrom sklearn.neighbors import NearestNeighbors\nimport anndata as ad\n\ndef _to_csr(X):\n    if sp.isspmatrix_csr(X): return X\n    if sp.issparse(X): return X.tocsr()\n    return sp.csr_matrix(X)\n\ndef _row_scale_csr(X, scale):\n    if not sp.issparse(X):\n        return (X.T * scale).T\n    X = _to_csr(X).copy()\n    X.data *= np.repeat(scale, np.diff(X.indptr))\n    return X\n\ndef _normalize_log1p_from_counts(adata: ad.AnnData):\n    Xc = adata.layers['counts'] if 'counts' in adata.layers else adata.X\n    Xc = _to_csr(Xc).astype(np.float32)\n    lib = np.asarray(Xc.sum(axis=1)).ravel()\n    lib = np.maximum(lib, 1e-9)\n    scale = (1e4 / lib).astype(np.float32)\n    Xn = _row_scale_csr(Xc, scale)\n    Xn = Xn.copy()\n    Xn.data = np.log1p(Xn.data)\n    return Xn\n\ndef _pca_truncated(X, n_components=50, random_state=0):\n    n_cells, n_genes = X.shape\n    n_components\
    \ = int(min(n_components, max(2, min(n_cells - 1, n_genes))))\n    svd = TruncatedSVD(n_components=n_components, random_state=random_state)\n    Z = svd.fit_transform(X)\n    return Z.astype(np.float32)\n\ndef prepare_vanilla_graph_space(adata, n_pcs=50, random_state=1):\n    Xn = _normalize_log1p_from_counts(adata)\n    Z = _pca_truncated(Xn, n_components=n_pcs, random_state=random_state)\n    return Z\n\ndef profile_knn_kq(Z: np.ndarray, kq_list, metric: str = \"cosine\"):\n    \"\"\"\n    Profile candidate search (fit + kneighbors) time/memory vs kq on embedding Z.\n    Returns list of dicts; prints CSV lines.\n    \"\"\"\n    results = []\n    print(\"kq,metric,time_sec,peak_mb\")\n    for kq in kq_list:\n        kq = int(kq)\n        nn = NearestNeighbors(n_neighbors=kq + 1, algorithm='auto', metric=metric)\n        tracemalloc.start()\n        t0 = time.perf_counter()\n        nn.fit(Z)\n        _ = nn.kneighbors(Z, return_distance=False)\n        dt = time.perf_counter() - t0\n\
    \        current, peak = tracemalloc.get_traced_memory()\n        tracemalloc.stop()\n        rec = {\"kq\": kq, \"metric\": metric, \"time_sec\": float(dt), \"peak_mb\": float(peak / (1024 * 1024))}\n        results.append(rec)\n        print(f\"{kq},{metric},{dt:.4f},{rec['peak_mb']:.2f}\")\n    return results\n\ndef run_profile_from_adata(adata, kq_list=(512, 768, 1024, 1280), metric=\"cosine\"):\n    Z = prepare_vanilla_graph_space(adata, n_pcs=50, random_state=1)\n    return profile_knn_kq(Z, kq_list=kq_list, metric=metric)\n\ndef test(adata: ad.AnnData):\n    \"\"\"\n    Profiling test: prints runtime/memory vs candidate pool size kq for vanilla PCA50 space.\n    Note: test() overrides scoring in the Station.\n    \"\"\"\n    _ = run_profile_from_adata(adata, kq_list=(512, 768, 1024, 1280), metric=\"cosine\")\n    return \"kq profiling completed\"\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\
    \n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
