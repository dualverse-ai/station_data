- text: "`/execute_action{storage read system/openproblems_metrics.py}`\n`/execute_action{goto research}`\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"Generalization test (test()): Frozen MPB‑GraphFWPCA+DAQB on human_train.h5ad\"\ntags: \"graphfwpca, daqb, ridge, generalization, metrics\"\nabstract: \"Runs the frozen baseline on a second dataset (system/human_train.h5ad) via test(), printing the full 10-metric panel in task order with normalized and raw values. No score is recorded.\"\ncontent: |\n  import sys, json\n  import numpy as np\n  import anndata as ad\n\n  # Paths for station modules\n  sys.path.extend(['storage/system', 'storage/praxis'])\n\n  # Import our runner and metrics\n  from mpb_graphfwpca_override import eliminate_mpb_graphfwpca as run_frozen\n  import openproblems_metrics as MET\n\n  FROZEN_CFG = dict(\n      lam_override=0.605,\n      delta=0.12,\n      kdensity=22,\n      k_total=50,\n      emb_n_neighbors=17,\n      gamma_max=0.70,\n      cap=2.0,\n      rng_seed=0,\n\
    \  )\n\n  ORDER = [\n      \"ASW_batch\",\n      \"ASW_label\",\n      \"ARI\",\n      \"NMI\",\n      \"Graph_conn\",\n      \"kBET\",\n      \"iLISI\",\n      \"cLISI\",\n      \"PCR\",\n      \"Cell_cycle\",\n  ]\n\n  def _fmt_panel(panel):\n      return \"  \" + \"  \".join([f\"{k}: {panel.get(k, np.nan):.3f}\" for k in ORDER])\n\n  def test(adata: ad.AnnData):\n      # Load second dataset from system storage\n      path = \"storage/system/human_train.h5ad\"\n      A = ad.read_h5ad(path)\n      print(f\"[Generalization] Loaded {path} with shape={A.shape}, batches={len(np.unique(A.obs['batch']))}\")\n\n      # Run frozen baseline\n      A = run_frozen(A, **FROZEN_CFG)\n      print(\"[Generalization] Integration complete. Has X_emb:\", 'X_emb' in A.obsm, \"Has graph:\", ('connectivities' in A.obsp and 'distances' in A.obsp))\n\n      # Compute metrics (raw + normalized) and overall score exactly as in the task\n      # openproblems_metrics provides: compute_raw_metrics, normalize_metrics,\
    \ final_score\n      raw = MET.compute_raw_metrics(A)\n      norm = MET.normalize_metrics(raw)\n      score = MET.final_score(norm)\n\n      # Print panels in the task-specified order\n      print(\"Normalized [0-1] in task order:\")\n      print(_fmt_panel(norm))\n      print(\"Raw values in task order:\")\n      print(_fmt_panel(raw))\n      print(f\"Overall (mean of 10 normalized): {score:.6f}\")\n\n      # Also dump JSON for reproducibility in STDOUT\n      out = dict(\n          dataset=\"human_train.h5ad\",\n          frozen_cfg=FROZEN_CFG,\n          normalized={k: float(norm.get(k, np.nan)) for k in ORDER},\n          raw={k: float(raw.get(k, np.nan)) for k in ORDER},\n          overall=float(score),\n      )\n      print(\"GENERALIZATION_JSON:\", json.dumps(out))\n      return \"Generalization completed\"\n```"
