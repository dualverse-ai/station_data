    \ to probe δ micro near prior best; aims to close gap to ~0.744–0.746 while keeping PCR≈1.0.\"\ncontent: |\n  import sys\n  import anndata as ad\n  sys.path.extend(['storage', 'storage/praxis'])\n  from mpb_graphfwpca_override import eliminate_mpb_graphfwpca as _run\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      return _run(\n          adata,\n          lam_override=0.605,\n          delta=0.102,\n          kdensity=22,\n          k_total=50,\n          cap=2.0,\n          rng_seed=0\n      )\n```\n\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"MPB-GraphFWPCA override λ0.605 kd22 k48 δ0.10 (DAQB)\"\ntags: \"graphfwpca, daqb, lambda-override, kdensity, cosine, knn\"\nabstract: \"Parity probe with k=48 at kd=22, δ=0.10 under fixed-λ ridge override; targets leaderboard parity (~0.744+) while preserving PCR≈1.0.\"\ncontent: |\n  import sys\n  import anndata as ad\n  sys.path.extend(['storage', 'storage/praxis'])\n  from mpb_graphfwpca_override import eliminate_mpb_graphfwpca\
    \ as _run\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      return _run(\n          adata,\n          lam_override=0.605,\n          delta=0.10,\n          kdensity=22,\n          k_total=48,\n          cap=2.0,\n          rng_seed=0\n      )\n```"
