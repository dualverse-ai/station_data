tick: 1341
role: model
parts:
- text: "`/execute_action{goto research}`\n`/execute_action{storage read system/openproblems_metrics.py}`\n`/execute_action{storage read system/main.py}`\n`/execute_action{storage write praxis/cross_organ_harness.py}`\n\n```yaml\ncontent: |\n  import sys, json, csv, io\n  import numpy as np\n  import anndata as ad\n\n  sys.path.extend(['storage/system', 'storage/praxis'])\n  import openproblems_metrics as MET\n  from mpb_graphfwpca_override import eliminate_mpb_graphfwpca as run_praxis\n  from monolithic_log1p_pbve import eliminate_batch_effect_fn as run_mono_pbve\n\n  # Metric order per task spec\n  ORDER = [\n      \"ASW_batch\",\"ASW_label\",\"ARI\",\"NMI\",\"Graph_conn\",\n      \"kBET\",\"iLISI\",\"cLISI\",\"PCR\",\"Cell_cycle\"\n  ]\n\n  PRAXIS_CFG = dict(\n      lam_override=0.605, delta=0.12, kdensity=22, k_total=50,\n      emb_n_neighbors=17, gamma_max=0.70, cap=2.0, rng_seed=0\n  )\n\n  def _safe_float(x):\n      try:\n          return float(x)\n      except Exception:\n      \
    \    return float('nan')\n\n  def safe_eval_metrics(B: ad.AnnData):\n      \"\"\"\n      Robustly evaluate metrics using whatever API is available in openproblems_metrics.\n      Returns (raw_dict, norm_dict, score_float). Never raises.\n      \"\"\"\n      try:\n          if hasattr(MET, \"compute_raw_metrics\") and hasattr(MET, \"normalize_metrics\") and hasattr(MET, \"final_score\"):\n              raw = MET.compute_raw_metrics(B)\n              norm = MET.normalize_metrics(raw)\n              score = MET.final_score(norm)\n              return raw, norm, _safe_float(score)\n          if hasattr(MET, \"evaluate\"):\n              res = MET.evaluate(B)\n              if isinstance(res, dict):\n                  raw = res.get(\"raw\") or res.get(\"raw_metrics\") or {}\n                  norm = res.get(\"normalized\") or res.get(\"norm_metrics\") or {}\n                  score = res.get(\"score\") or res.get(\"overall\") or float('nan')\n                  return raw, norm, _safe_float(score)\n\
    \          if hasattr(MET, \"compute_metrics\"):\n              raw = MET.compute_metrics(B)\n              norm = MET.normalize_metrics(raw) if hasattr(MET, \"normalize_metrics\") else {}\n              score = MET.final_score(norm) if hasattr(MET, \"final_score\") else float('nan')\n              return raw, norm, _safe_float(score)\n      except Exception as e:\n          print(\"SAFE_METRICS_WARNING:\", repr(e))\n      return {}, {}, float('nan')\n\n  def eval_method(adata: ad.AnnData, method_fn, cfg: dict | None):\n      B = method_fn(adata.copy(), **cfg) if cfg else method_fn(adata.copy())\n      raw, norm, score = safe_eval_metrics(B)\n      return raw, norm, score\n\n  def _count_hvg(A: ad.AnnData) -> int:\n      try:\n          if \"batch_hvg\" in A.var.columns:\n              return int(np.asarray(A.var[\"batch_hvg\"].values).astype(bool).sum())\n      except Exception:\n          pass\n      return int(A.n_vars)\n\n  def run_on_h5ad(path: str, organ: str, out_csv: bool = True):\n\
    \      A = ad.read_h5ad(path)\n      rows = []\n\n      # Praxis frozen\n      raw, norm, score = eval_method(A, run_praxis, PRAXIS_CFG)\n      row = {\n          \"organ\": organ, \"method\": \"Praxis_MPB_GraphFWPCA_DAQB\",\n          \"n_hvg\": _count_hvg(A), \"kd\": 22, \"k\": 50, \"delta\": 0.12,\n          \"emb_k\": 17, \"gamma_max\": 0.70, \"lambda\": 0.605, \"degree_cap\": \"none\",\n          \"overall\": _safe_float(score),\n      }\n      for k in ORDER:\n          row[k] = _safe_float((norm or {}).get(k, np.nan))\n      rows.append(row)\n\n      # Monolithic log1p PBVE-lite (1500 and 2000 HVGs)\n      for n_hvg in (1500, 2000):\n          raw, norm, score = eval_method(A, run_mono_pbve, {\"n_hvg\": int(n_hvg), \"n_pcs\": 60})\n          row = {\n              \"organ\": organ, \"method\": f\"Monolithic_log1p_PBVE_lite_n{n_hvg}\",\n              \"n_hvg\": int(n_hvg), \"kd\": \"n/a\", \"k\": 50, \"delta\": \"n/a\",\n              \"emb_k\": \"n/a\", \"gamma_max\": \"n/a\"\
    , \"lambda\": \"n/a\", \"degree_cap\": \"none\",\n              \"overall\": _safe_float(score),\n          }\n          for k in ORDER:\n              row[k] = _safe_float((norm or {}).get(k, np.nan))\n          rows.append(row)\n\n      if out_csv:\n          buf = io.StringIO()\n          fieldnames = [\"organ\",\"method\",\"n_hvg\",\"kd\",\"k\",\"delta\",\"emb_k\",\"gamma_max\",\"lambda\",\"degree_cap\",\"overall\"] + list(ORDER)\n          w = csv.DictWriter(buf, fieldnames=fieldnames)\n          w.writeheader()\n          for r in rows: w.writerow(r)\n          print(\"CROSS_ORGAN_CSV\\n\" + buf.getvalue())\n      return rows\n```\n\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"Cross‑organ harness (test, v2): Robust metrics API with CSV emission\"\ntags: \"generalization, harness, csv, graphfwpca, pbve-lite, robustness\"\nabstract: \"Re‑runs the Heart CSV emission (Praxis baseline + monolithic log1p 1500/2000 HVG) using a robust metrics wrapper that adapts to openproblems_metrics\
    \ API; on failure, logs NaN metrics without raising.\"\ncontent: |\n  import sys, json\n  sys.path.extend(['storage/praxis'])\n  from cross_organ_harness import run_on_h5ad\n\n  def test(adata):\n      rows = run_on_h5ad('storage/system/human_train_solution.h5ad', organ='heart', out_csv=True)\n      print(\"ROWS_JSON:\", json.dumps(rows))\n      return \"Cross-organ Heart CSV emitted (robust)\"\n```"
