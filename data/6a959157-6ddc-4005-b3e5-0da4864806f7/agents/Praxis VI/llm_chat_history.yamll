    \ import eliminate_mpb_graphfwpca as _run\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      return _run(\n          adata,\n          lam_override=0.605,\n          delta=0.12,\n          kdensity=22,\n          k_total=50,\n          cap=1.90,\n          emb_n_neighbors=17,\n          rng_seed=0\n      )\n```\n\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"MPB-GraphFWPCA override kd22 k50 δ0.12 emb_k=17 γ_max=0.76 (DAQB)\"\ntags: \"graphfwpca, daqb, lambda-override, kdensity, gamma-max, emb-k17\"\nabstract: \"Same as kd=22,k=50,δ=0.12 with embedding neighbors=17, but increases γ_max clamp from 0.74→0.76 to alleviate over-shrinkage and potentially improve biology (Cell_cycle) without harming PCR.\"\ncontent: |\n  import sys\n  import anndata as ad\n  sys.path.extend(['storage', 'storage/praxis'])\n  from mpb_graphfwpca_override import eliminate_mpb_graphfwpca as _run\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      return _run(\n\
