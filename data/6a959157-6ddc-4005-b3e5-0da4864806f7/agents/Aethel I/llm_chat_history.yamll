    \ |\n| 1455 | 1 | Diagnostics: σ_kd distributions — FWPCA-only at δ∈{0.10,0.12} (kd=22, k=50) | Praxis V | 1033 | n.a. |  |  |  |  |  |  |  |  |  |  |\n| 1454 | 1 | Diagnostics: σ_kd distributions — Ridge vs FWPCA-only at δ=0.12 (kd=22, k=50) | Praxis V | 1032 | n.a. |  |  |  |  |  |  |  |  |  |  |\n| 1453 | 1 | Synergy Hypothesis: Minimal SOTA Embedding + Adaptive Correction Graph | Nous I | 1032 | 0.7342 | 0.744 | 0.681 | 0.218 | 0.349 | 0.945 | 0.704 | 1.000 | 0.967 | 0.951 | 0.781 |\n| 1452 | 1 | Minimal SOTA v2 + FW-PCA (alpha=0.5) | Aethel I | 1032 | 0.7395 | 0.773 | 0.659 | 0.248 | 0.291 | 0.967 | 0.729 | 1.000 | 0.973 | 0.965 | 0.790 |\n| 1451 | 1 | Replication: Nous I's SOTA ('Adaptive Local Correction') | Daedalus IV | 1031 | 0.7448 | 0.782 | 0.659 | 0.248 | 0.327 | 0.967 | 0.742 | 1.000 | 0.975 | 0.959 | 0.790 |\n\nPage 1 of 146 (sorted by: id)\n\n(Use `/execute_action{page N}` to navigate pages 1-146, `/execute_action{rank mode}` to change sort order, `/execute_action{page_size\
    \ N}` to set page size, `/execute_action{filter tag}` to filter by tag.)\n\n**Read Contents:**\n\n**daedalus/nous_sota_replication.py:**\n```\nimport sys\nimport numpy as np\nimport scanpy as sc\nimport anndata as ad\nfrom scipy import sparse as sp\nfrom sklearn.neighbors import NearestNeighbors\n\nsys.path.append('storage/daedalus')\n\nfrom praxis_core import normalize_log1p_inplace, pca_array, one_hot_batches, ridge_batch_fit_predict\nfrom bbsg_density_adaptive import build_density_adaptive_bbsg\n\ndef _fw_weight_by_var(Xd: np.ndarray, alpha: float) -> np.ndarray:\n    var_g = Xd.var(axis=0, ddof=1).astype(np.float32) + 1e-8\n    w = np.power(var_g, -0.5 * alpha).astype(np.float32)\n    return Xd * w\n\ndef eliminate_local_adaptive_correction(adata: ad.AnnData,\n                             alpha_emb: float = 0.5,\n                             n_pcs_emb: int = 60,\n                             emb_n_neighbors: int = 15,\n                             alpha_g: float = 0.5,\n        \
    \                     n_pcs_graph: int = 50,\n                             l2: float = 1e-3,\n                             gamma_max: float = 0.74,\n                             lam_override: float = 0.70,\n                             k_total: int = 48,\n                             kdensity: int = 20,\n                             delta: float = 0.10,\n                             metric: str = 'cosine',\n                             cap: float = 2.0,\n                             rng_seed: int = 0) -> ad.AnnData:\n    assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n    normalize_log1p_inplace(adata, 1e4)\n    sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n    hv = adata.var['highly_variable'].to_numpy()\n    batches = np.asarray(adata.obs['batch'].astype('category').values)\n    Xh = adata.X[:, hv]\n    Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n\n    Xw_emb = _fw_weight_by_var(Xd,\
    \ alpha=alpha_emb)\n    ad_emb = ad.AnnData(Xw_emb, obs=adata.obs[['batch']].copy())\n    sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n    ad_pc = ad.AnnData(ad_emb.obsm['X_pca'].copy(), obs=adata.obs[['batch']].copy())\n    sc.pp.combat(ad_pc, key='batch')\n    adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n    sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n    Xw_graph = _fw_weight_by_var(Xd, alpha=alpha_g)\n    Zg = pca_array(Xw_graph, n_comps=n_pcs_graph, random_state=0)\n\n    print(\"  Applying novel Adaptive Local Correction...\")\n    B = one_hot_batches(batches)\n    Zhat = ridge_batch_fit_predict(B, Zg, l2=l2)\n    \n    nn_density = NearestNeighbors(n_neighbors=kdensity + 1, metric=metric, algorithm='brute')\n    nn_density.fit(Zg)\n    d_k, _ = nn_density.kneighbors(Zg, return_distance=True)\n    d_k = d_k[:, -1]\n    d_min, d_max = float(np.min(d_k)), float(np.max(d_k))\n    normalized_dist\
    \ = (d_k - d_min) / (d_max - d_min + 1e-8)\n    density_factor = 1.0 - normalized_dist\n    \n    var_total = Zg.var(axis=0, ddof=1) + 1e-8\n    var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n    R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n    gamma_global = np.minimum(gamma_max, float(lam_override) * R2).astype(np.float32)\n    \n    gamma_local = gamma_global[np.newaxis, :] * density_factor[:, np.newaxis]\n    Zcorr = Zg - (Zhat * gamma_local)\n    \n    print(f\"  Correction strength stats: Global_Gamma_Mean={np.mean(gamma_global):.3f}, Local_Gamma_Mean={np.mean(gamma_local):.3f}\")\n\n    try:\n        Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                             k_total=k_total, metric=metric,\n                                             delta=delta, k_density=kdensity,\n                                             cap=cap, rng_seed=rng_seed)\n    except TypeError:\n        Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32),\
    \ batches=batches,\n                                             k_total=k_total, metric=metric,\n                                             delta=delta, k_density=kdensity,\n                                             rng_seed=rng_seed)\n    adata.obsp['connectivities'] = Cg\n    adata.obsp['distances'] = Dg\n    \n    return adata\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
