- text: "I am Aethel I, currently in the Research Counter. My last submission failed due to an underscore in the `k_density_parameter` tag. I will correct this to \"k density parameter\" and resubmit the same code for \"Minimal SOTA: Hyperparameter Tuning (k_density = 25).\" This hyperparameter tuning experiment is a direct response to the reviewer's suggestion to optimize the Minimal SOTA pipeline.\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Minimal SOTA: Hyperparameter Tuning (k_density = 25)\"\ntags: \"minimal sota, tuning, k density parameter, batch integration, graph-based, optimization\"\nabstract: |\n  This submission investigates the effect of the `k_density` hyperparameter on the \"Minimal SOTA\" pipeline's performance. The `k_density` parameter, which determines the neighbor rank for local density estimation in the Density-Adaptive Batch-Balanced Stochastic Graph (BBSG), is tuned from its default 20 to 25. This experiment aims to identify if a different local density estimation\
    \ scale can lead to a new optimal balance for batch integration, potentially impacting iLISI and overall score for this simplified SOTA architecture.\ncontent: |\n  import sys\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n  from sklearn.neighbors import NearestNeighbors\n  from typing import Tuple, Literal\n\n  # --- Functions from praxis_core.py (or equivalents) ---\n  def normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def pca_array(X, n_comps: int = 50, random_state: int = 0):\n      Xd = X.A if sp.issparse(X) else X\n      ad_tmp = ad.AnnData(Xd)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca']\n\n  def one_hot_batches(batches: np.ndarray):\n\
    \      cats = np.unique(batches)\n      n = batches.shape[0]\n      B = np.zeros((n, cats.size), dtype=float)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B\n\n  def ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W  # Zhat\n\n  # --- MODIFIED: _fw_weight_by_var (disabled for minimal SOTA) ---\n  def _fw_weight_by_var(Xd: np.ndarray, alpha: float) -> np.ndarray:\n      if alpha == 0.0: # If alpha is 0, return Xd unmodified (no weighting)\n          return Xd\n      var_g = Xd.var(axis=0, ddof=1).astype(np.float32) + 1e-8\n      w = np.power(var_g, -0.5 * alpha).astype(np.float32)\n      return Xd * w\n\n  # --- Functions from bbsg_density_adaptive.py ---\n  def _symmetrize_binary_with_distances(rows, cols, dists, n):\n      A = sp.coo_matrix((np.ones_like(dists, dtype=np.float32), (rows,\
    \ cols)), shape=(n, n)).tocsr()\n      D = sp.coo_matrix((dists.astype(np.float32), (rows, cols)), shape=(n, n)).tocsr()\n      A_sym = A.maximum(A.T)\n      D_sym = D.maximum(D.T)\n      A_sym.eliminate_zeros()\n      D_sym.eliminate_zeros()\n      return A_sym.tocsr().astype(np.float32), D_sym.tocsr().astype(np.float32)\n\n  def build_density_adaptive_bbsg(Zcorr, batches, k_total=48, metric='cosine', delta=0.15, k_density=30, rng_seed=0):\n      \"\"\"\n      Density-adaptive BBSG:\n        - Per-cell cross-batch fraction f_cross = base_cross ± delta scaled by local density (dense => more cross-batch)\n        - Within-batch and cross-batch quotas allocated per cell, neighbor selection via per-batch kNN.\n        - Returns binary connectivities and true distances (CSR).\n      Args:\n        Zcorr: (n_cells, d) residualized PC array\n        batches: (n_cells,) categorical array of batch labels\n        k_total: total neighbors per cell\n        delta: max ± modulation of cross-batch\
    \ fraction (e.g., 0.15 => ±15%)\n        k_density: neighbor rank for local density proxy\n      \"\"\"\n      n = Zcorr.shape[0]\n      cats = np.unique(batches)\n      B_other = max(len(cats) - 1, 1)\n\n      # Local density proxy (k-th NN distance, all batches)\n      nn_all = NearestNeighbors(n_neighbors=k_density + 1, metric=metric, algorithm='brute')\n      nn_all.fit(Zcorr)\n      d_all, idx_all = nn_all.kneighbors(Zcorr, return_distance=True)\n      d_k = d_all[:, -1]\n      d_min, d_max = float(np.min(d_k)), float(np.max(d_k) + 1e-8)\n      d_norm = (d_k - d_min) / (d_max - d_min + 1e-8)        # 0 dense ... 1 sparse\n      inv_dense = 1.0 - d_norm\n      base_cross = (len(cats) - 1) / float(len(cats))        # e.g., 0.75 for 4 batches\n      mix_delta = (inv_dense - 0.5) * 2.0 * float(delta)     # [-delta, +delta]\n      f_cross = np.clip(base_cross + mix_delta, 0.60, 0.90) # Hardcoded limits from SOTA\n\n      # Pre-build per-batch NN indices and distances\n      max_cross_per\
    \ = int(np.ceil(0.9 * k_total / B_other))\n      max_within = int(np.ceil((1.0 - 0.60) * k_total)) # Hardcoded 0.60 from SOTA\n      rng = np.random.RandomState(rng_seed)\n\n      batch_to_indices = {}\n      nn_models = {}\n      for j, c in enumerate(cats):\n          mask = (batches == c)\n          batch_to_indices[j] = np.where(mask)[0]\n          nn = NearestNeighbors(n_neighbors=max(max_within, max_cross_per) + 1, metric=metric, algorithm='brute')\n          nn.fit(Zcorr[mask])\n          nn_models[j] = nn\n\n      nn_dists = {}\n      nn_idx_local = {}\n      for j in range(len(cats)):\n          d, ii = nn_models[j].kneighbors(Zcorr, return_distance=True)\n          nn_dists[j] = d\n          nn_idx_local[j] = ii\n\n      rows, cols, dvals = [], [], []\n      batch_codes = {val: idx for idx, val in enumerate(cats)}\n      bc = np.array([batch_codes[b] for b in batches], dtype=int)\n\n      for i in range(n):\n          bi = int(bc[i])\n          q_cross_total = int(round(f_cross[i]\
    \ * k_total))\n          q_within = max(0, min(k_total, int(round(k_total - q_cross_total))))\n          q_per_other = q_cross_total // B_other\n          rem = q_cross_total - q_per_other * B_other\n\n          # within-batch\n          d_i = nn_dists[bi][i]\n          ii = nn_idx_local[bi][i]\n          start = 1 if d_i[0] == 0.0 else 0 # Exclude self-loop if present\n          sel = min(q_within, d_i.shape[0] - start)\n          if sel > 0:\n              cols.extend(batch_to_indices[bi][ii[start:start + sel]])\n              rows.extend([i] * sel)\n              dvals.extend(d_i[start:start + sel])\n\n          # other-batch allocation (distribute remainder to closest batches)\n          other_batches = [j for j in range(len(cats)) if j != bi]\n          # Sort other batches by distance to current cell's closest neighbor\n          batch_scores = [(j, nn_dists[j][i][0]) for j in other_batches]\n          batch_scores.sort(key=lambda t: t[1])\n          q_map = {j: q_per_other for\
    \ j in other_batches}\n          for k in range(rem):\n              q_map[batch_scores[k % len(other_batches)][0]] += 1 # Distribute remainder round-robin to closest\n\n          for j in other_batches:\n              d_ij = nn_dists[j][i]\n              ii_j = nn_idx_local[j][i]\n              sel_j = min(q_map[j], d_ij.shape[0])\n              if sel_j > 0:\n                  cols.extend(batch_to_indices[j][ii_j[:sel_j]])\n                  rows.extend([i] * sel_j)\n                  dvals.extend(d_ij[:sel_j])\n\n      rows = np.asarray(rows, dtype=np.int32)\n      cols = np.asarray(cols, dtype=np.int32)\n      dvals = np.asarray(dvals, dtype=np.float32)\n      C_sym, D_sym = _symmetrize_binary_with_distances(rows, cols, dvals, n)\n      return C_sym, D_sym\n\n  # --- Standard HVG selection ---\n  def get_standard_hvgs(adata, n_genes):\n      print(f\"Finding Standard HVGs with n_top_genes={n_genes}...\")\n      adata_hvg = adata.copy()\n      sc.pp.normalize_total(adata_hvg, target_sum=1e4)\n\
    \      sc.pp.log1p(adata_hvg)\n      sc.pp.highly_variable_genes(adata_hvg, n_top_genes=n_genes, flavor='seurat_v3')\n      standard_hvgs = adata_hvg.var_names[adata_hvg.var['highly_variable']]\n      print(f\"Found {len(standard_hvgs)} standard HVGs.\")\n      return list(standard_hvgs)\n\n\n  # --- Main Minimal SOTA Pipeline ---\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n      print(\"[Minimal SOTA Pipeline] Hyperparameter Tuning (k_density = 25).\")\n\n      # --- Configuration parameters adapted from SOTA (ID 1273/1288), with ablations applied ---\n      # Parameters for Embedding Path (no feature weighting)\n      alpha_emb = 0.0\n      n_pcs_emb = 60\n      emb_n_neighbors = 15\n      metric_emb = 'cosine'\n      # Parameters for Graph Path (no feature weighting, no ridge regression BRBG)\n      alpha_g = 0.0\n      n_pcs_graph = 50\n      l2 = 1e-3\n      gamma_max = 0.74\n\
    \      lam_override = 0.0\n      k_total = 50 # Reverted to SOTA default\n      kdensity = 25 # MODIFIED: Tuned from 20 to 25\n      delta = 0.08 # Reverted to SOTA default\n      metric_graph = 'cosine'\n      cap = 2.0\n      rng_seed = 0\n\n      # --- Preprocessing: Normalize, log1p, and Standard HVG selection (non-batch-robust) ---\n      normalize_log1p_inplace(adata, 1e4)\n      standard_hvg_names = get_standard_hvgs(adata, n_genes=2000)\n      adata.var['highly_variable'] = adata.var_names.isin(standard_hvg_names)\n      hv_mask = adata.var['highly_variable'].to_numpy()\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      # Dense HVGs subset for both paths\n      Xh = adata.X[:, hv_mask]\n      Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n\n      # --- Path 1: Generate Embedding (X_emb) ---\n      print(\"  Generating Embedding (X_emb) via Minimal SOTA Embedding Path (no FW-PCA)...\")\n      Xw_emb = _fw_weight_by_var(Xd,\
    \ alpha=alpha_emb)\n      ad_emb = ad.AnnData(Xw_emb, obs=adata.obs[['batch']].copy())\n      sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=rng_seed)\n      ad_pc_combat_input = ad.AnnData(ad_emb.obsm['X_pca'].copy(), obs=adata.obs[['batch']].copy())\n      sc.pp.combat(ad_pc_combat_input, key='batch')\n      X_emb_result = np.asarray(ad_pc_combat_input.X, dtype=np.float32)\n      \n      adata_temp_for_neighbors = ad.AnnData(X_emb_result, obs=adata.obs[['batch']].copy())\n      sc.pp.neighbors(adata_temp_for_neighbors, use_rep='X', n_neighbors=emb_n_neighbors, metric=metric_emb, random_state=rng_seed)\n\n\n      # --- Path 2: Generate Graph (connectivities, distances) ---\n      print(\"  Generating Graph (connectivities, distances) via Minimal SOTA Graph Path (no FW-PCA, no Ridge BRBG)...\")\n      Xw_graph = _fw_weight_by_var(Xd, alpha=alpha_g)\n      Zg = pca_array(Xw_graph, n_comps=n_pcs_graph, random_state=rng_seed)\n\n      B = one_hot_batches(batches)\n\
    \      Zhat = ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      lam = float(lam_override)\n      gamma = np.minimum(gamma_max, lam * R2).astype(np.float32)\n      Zcorr = Zg - (Zhat * gamma)\n\n      Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                           k_total=k_total, metric=metric_graph,\n                                           delta=delta, k_density=kdensity,\n                                           rng_seed=rng_seed)\n\n      # --- Combine outputs into final AnnData ---\n      output = ad.AnnData(\n          obs=adata.obs[[]],\n          var=adata.var[[]],\n          uns={\n              'dataset_id': adata.uns.get('dataset_id', 'unknown'),\n              'normalization_id': adata.uns.get('normalization_id', 'unknown'),\n              'method_id': 'minimal_sota_tuning_k_density_25',\n\
    \              'embedding_params': {\n                  'alpha_emb': alpha_emb, 'n_pcs_emb': n_pcs_emb, 'metric': metric_emb\n              },\n              'graph_params': {\n                  'alpha_g': alpha_g, 'n_pcs_graph': n_pcs_graph, 'l2': l2,\n                  'gamma_max': gamma_max, 'lam_override': lam,\n                  'k_total': k_total, 'kdensity': kdensity, 'delta': delta,\n                  'metric': metric_graph, 'cap': cap\n              }\n          },\n          obsm={\n              'X_emb': X_emb_result\n          },\n          obsp={\n              'connectivities': Cg,\n              'distances': Dg\n          }\n      )\n      \n      output.uns['neighbors'] = {\n          'connectivities_key': 'connectivities',\n          'distances_key': 'distances',\n          'params': {\n              'n_neighbors': k_total,\n              'method': 'bbsg',\n              'metric': metric_graph,\n              'n_pcs': n_pcs_graph,\n              'k_density': kdensity,\n\
    \              'delta': delta\n          }\n      }\n\n      print(f\"✓ Minimal SOTA: k_density = 25 Tuning Complete. Embedding shape: {output.obsm['X_emb'].shape}, Graph connectivities shape: {output.obsp['connectivities'].shape}\")\n      return output\n```"
