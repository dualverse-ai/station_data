    , line 633, in factory\n    return xla_client.make_c_api_client(plugin_name, updated_options, None)\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/ubuntu/miniconda3/envs/batch_integration/lib/python3.11/site-packages/jaxlib/xla_client.py\", line 159, in make_c_api_client\n    return _xla.get_c_api_client(plugin_name, options, distributed_client)\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\njaxlib.xla_extension.XlaRuntimeError: FAILED_PRECONDITION: No visible GPU devices.\n\nDuring handling of the above exception, another exception occurred:\n\nTraceback (most recent call last):\n  File \"/tmp/tmpn4543ucn/storage/system/main.py\", line 52, in main\n    test_result = submission.test(adata_human.copy())\n                  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/tmp/tmpn4543ucn/submission.py\", line 30, in test\n    vae_embedding = generate_daedalus_vae_embedding(adata.copy())\n                    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n\
    \  File \"/tmp/tmpn4543ucn/storage/Daedalus/daedalus_vae_embedder.py\", line 36, in generate_daedalus_vae_embedding\n    rng = jax.random.PRNGKey(0)\n          ^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/ubuntu/miniconda3/envs/batch_integration/lib/python3.11/site-packages/jax/_src/random.py\", line 248, in PRNGKey\n    return _return_prng_keys(True, _key('PRNGKey', seed, impl))\n                                   ^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/ubuntu/miniconda3/envs/batch_integration/lib/python3.11/site-packages/jax/_src/random.py\", line 200, in _key\n    return prng.random_seed(seed, impl=impl)\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/ubuntu/miniconda3/envs/batch_integration/lib/python3.11/site-packages/jax/_src/prng.py\", line 548, in random_seed\n    seeds_arr = jnp.asarray(np.int64(seeds))\n                ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/ubuntu/miniconda3/envs/batch_integration/lib/python3.11/site-packages/jax/_src/numpy/lax_numpy.py\",\
    \ line 5714, in asarray\n    return array(a, dtype=dtype, copy=bool(copy), order=order, device=device)\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/ubuntu/miniconda3/envs/batch_integration/lib/python3.11/site-packages/jax/_src/numpy/lax_numpy.py\", line 5548, in array\n    out_array: Array = lax_internal._convert_element_type(\n                       ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/ubuntu/miniconda3/envs/batch_integration/lib/python3.11/site-packages/jax/_src/lax/lax.py\", line 1727, in _convert_element_type\n    return convert_element_type_p.bind(\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/ubuntu/miniconda3/envs/batch_integration/lib/python3.11/site-packages/jax/_src/core.py\", line 496, in bind\n    return self._true_bind(*args, **params)\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/ubuntu/miniconda3/envs/batch_integration/lib/python3.11/site-packages/jax/_src/core.py\", line 512, in\
    \ _true_bind\n    return self.bind_with_trace(prev_trace, args, params)\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/ubuntu/miniconda3/envs/batch_integration/lib/python3.11/site-packages/jax/_src/lax/lax.py\", line 4875, in _convert_element_type_bind_with_trace\n    operand = core.Primitive.bind_with_trace(convert_element_type_p, trace, args, params)\n              ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/ubuntu/miniconda3/envs/batch_integration/lib/python3.11/site-packages/jax/_src/core.py\", line 517, in bind_with_trace\n    return trace.process_primitive(self, args, params)\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/ubuntu/miniconda3/envs/batch_integration/lib/python3.11/site-packages/jax/_src/core.py\", line 1017, in process_primitive\n    return primitive.impl(*args, **params)\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/ubuntu/miniconda3/envs/batch_integration/lib/python3.11/site-packages/jax/_src/dispatch.py\"\
    , line 89, in apply_primitive\n    outs = fun(*args)\n           ^^^^^^^^^^\nRuntimeError: Unable to initialize backend 'cuda': FAILED_PRECONDITION: No visible GPU devices. (you may need to uninstall the failing plugin package, or set JAX_PLATFORMS=cpu to skip this backend.)\n--------------------\nFor simplicity, JAX has removed its internal frames from the traceback of the following exception. Set JAX_TRACEBACK_FILTERING=off to include these.\n\n```\n\n\n---\n\n## Actions Detected (Last Turn)\n1. `submit 1` (in Research Counter); YAML with fields: title, tags, abstract, content\n\n\n---\n\n## Room Output History (Last Turn)\n\n### Location: Research Counter\n**Actions Executed:**\n- Evaluation 'Analysis: Theoretical Probing of Daedalus I's VAE (v2)' submitted for Research Task #1: Single-cell RNA-seq Batch Integration. Evaluation ID: 427.\n\n**Latest Room Output:**\n**Research Tasks:**\n\n| ID | Task Name |\n|---|---|\n| 1 | Single-cell RNA-seq Batch Integration |\n\n**Running Experiments:**\n\
    \nYou do not have any running experiments. Please submit a new experiment if needed.\n\n**Submitted Evaluations:**\n\n| Evaluation ID | Research Task ID | Title | Author | Submitted Tick | Score | ARI | ASW_batch | ASW_label | Cell_cycle | Graph_conn | NMI | PCR | cLISI | iLISI | kBET |\n|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|\n| 258 | 1 | Dual-BRBG-Whitened: Sublinear Residualization p=0.75 (k=45) | Praxis I | 156 | 0.7243 | 0.730 | 0.843 | 0.157 | 0.054 | 0.963 | 0.693 | 1.000 | 0.972 | 0.941 | 0.891 |\n| 257 | 1 | Synergy Test: Whitened Distilled VAE + SOTA Graph | Daedalus II | 155 | n.a. |  |  |  |  |  |  |  |  |  |  |\n| 256 | 1 | Logos II: Replication of Praxis I's SOTA (ID 220) | Logos II | 154 | 0.7293 | 0.736 | 0.839 | 0.157 | 0.079 | 0.972 | 0.698 | 1.000 | 0.972 | 0.935 | 0.906 |\n| 255 | 1 | Dual-BRBG-Whitened: PCA72 (tau=0.95, k=45, AdaptPC) | Praxis I | 153 | 0.7229 | 0.732 | 0.848 | 0.152 | 0.051 | 0.972 | 0.694 | 1.000 | 0.972 | 0.941 | 0.868\
