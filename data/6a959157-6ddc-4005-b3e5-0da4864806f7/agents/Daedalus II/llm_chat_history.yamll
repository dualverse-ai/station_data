tick: 123
role: model
parts:
- text: "I am back in the Research Counter. I will now overwrite the `distilled_vae_embedder.py` file with the updated `distill_weight`.\n\n/execute_action{storage write Daedalus/distilled_vae_embedder.py}\n```yaml\ncontent: |\n  import os\n  os.environ['JAX_PLATFORMS'] = 'cpu'\n\n  import sys\n  sys.path.append('storage/Daedalus')\n\n  import anndata as ad\n  import scanpy as sc\n  import jax\n  import jax.numpy as jnp\n  from flax.training import train_state\n  import optax\n  import numpy as np\n\n  from vae_model import Encoder, Decoder\n  from discriminator_model import Discriminator\n  from training_logic_distilled import VAETrainState, train_step_distilled\n\n  def generate_distilled_vae_embedding(adata: ad.AnnData):\n      \"\"\"\n      Generates a VAE embedding using knowledge distillation to mimic\n      the global properties of a linear ComBat-PCA embedding.\n      \"\"\"\n      print(\"--- Generating Distilled VAE Embedding ---\")\n      \n      # 1. Preprocessing and Target\
    \ Embedding Generation\n      print(\"Step 1: Preprocessing and creating target ComBat-PCA embedding...\")\n      adata_proc = adata.copy()\n      sc.pp.normalize_total(adata_proc, target_sum=1e4)\n      sc.pp.log1p(adata_proc)\n      \n      # Create the target embedding before applying combat to the training data\n      adata_target = adata_proc.copy()\n      sc.pp.highly_variable_genes(adata_target, n_top_genes=2000, batch_key='batch', subset=True)\n      sc.pp.combat(adata_target, key='batch')\n      sc.pp.pca(adata_target, n_comps=32)\n      target_embedding = adata_target.obsm['X_pca'].copy()\n      \n      # Now apply combat to the training data itself\n      sc.pp.combat(adata_proc, key='batch')\n      \n      data = adata_proc.X.toarray() if hasattr(adata_proc.X, 'toarray') else adata_proc.X\n      batch_labels = adata_proc.obs['batch'].astype('category').cat.codes.to_numpy()\n      num_batches = len(adata_proc.obs['batch'].cat.categories)\n\n      # 2. Model Initialization\n\
    \      print(\"Step 2: Initializing models...\")\n      rng = jax.random.PRNGKey(0)\n      rng, vae_key, disc_key = jax.random.split(rng, 3)\n      input_dim, latent_dim, lr = data.shape[1], 32, 1e-4\n\n      encoder = Encoder(hidden_dims=[512, 256], latent_dim=latent_dim)\n      decoder = Decoder(hidden_dims=[256, 512], output_dim=input_dim)\n      discriminator = Discriminator(hidden_dims=[128, 64], num_batches=num_batches)\n\n      encoder_params = encoder.init(vae_key, jnp.ones((1, input_dim)))['params']\n      decoder_params = decoder.init(vae_key, jnp.ones((1, latent_dim)))['params']\n      disc_params = discriminator.init(disc_key, jnp.ones((1, latent_dim)))['params']\n\n      combined_params = {'encoder_params': encoder_params, 'decoder_params': decoder_params}\n      vae_state = VAETrainState.create(\n          apply_fn={'encoder': encoder.apply, 'decoder': decoder.apply}, params=combined_params,\n          tx=optax.adam(lr), encoder_params=encoder_params, decoder_params=decoder_params\n\
    \      )\n      disc_state = train_state.TrainState.create(\n          apply_fn=discriminator.apply, params=disc_params, tx=optax.adam(lr)\n      )\n\n      # 3. Training\n      print(\"Step 3: Starting training loop...\")\n      num_epochs = 100\n      kl_weight = 0.0001\n      adv_weight = 5.0\n      distill_weight = 0.5 # HYPERPARAMETER TUNING: Increased from 0.1 to 0.5\n      batch_size = 512\n      \n      num_steps = data.shape[0] // batch_size\n      \n      for epoch in range(num_epochs):\n          rng, epoch_rng = jax.random.split(rng)\n          perms = jax.random.permutation(epoch_rng, data.shape[0])\n          \n          for i in range(num_steps):\n              batch_idx = perms[i * batch_size : (i + 1) * batch_size]\n              batch_data = data[batch_idx]\n              batch_lbls = batch_labels[batch_idx]\n              batch_target = target_embedding[batch_idx]\n              \n              rng, step_rng = jax.random.split(rng)\n              vae_state, disc_state,\
    \ _ = train_step_distilled(\n                  step_rng, vae_state, disc_state, batch_data, batch_lbls, batch_target, \n                  kl_weight, adv_weight, distill_weight\n              )\n      \n      # 4. Generate Final Embedding\n      print(\"Step 4: Generating final embedding...\")\n      final_embedding, _ = encoder.apply({'params': vae_state.encoder_params}, data)\n      print(\"--- Distilled VAE Embedding Generated ---\")\n      return jax.device_get(final_embedding)\n```"
