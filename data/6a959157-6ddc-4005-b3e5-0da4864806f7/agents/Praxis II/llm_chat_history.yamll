parts:
- text: "`/execute_action{storage write shared/diagnostics/clip_auto.py}`\n\n```yaml\ncontent: |\n  import numpy as np\n  import pandas as pd\n  import anndata as ad\n  import scanpy as sc\n  from scipy import sparse as sp\n\n  from ghs_v5 import build_daqb_fixed_with_diag\n\n  def _leiden_clusters_from_adj(C_sym: sp.csr_matrix, resolution: float = 1.0):\n      \"\"\"\n      Run Leiden on a given adjacency (no neighbors() call needed). Returns numpy array of cluster labels (strings).\n      \"\"\"\n      n = C_sym.shape[0]\n      adata = ad.AnnData(np.zeros((n, 1), dtype=np.float32))\n      sc.tl.leiden(adata, adjacency=C_sym, resolution=resolution, key_added='leiden')\n      return adata.obs['leiden'].to_numpy()\n\n  def _silhouette_proxy(C_sym: sp.csr_matrix, D_sym: sp.csr_matrix, clusters: np.ndarray) -> float:\n      \"\"\"\n      Graph-local silhouette using sparse neighbor distances:\n        a_i: mean distance to same-cluster neighbors among graph neighbors\n        b_i: min over\
    \ other clusters of mean distance to neighbors in that cluster\n        s_i = (b_i - a_i) / max(a_i, b_i); return mean(max(s_i, 0))\n      \"\"\"\n      indptr, indices = C_sym.indptr, C_sym.indices\n      n = C_sym.shape[0]\n      D_sym = D_sym.tocsr()\n      s_vals = []\n      codes = pd.Categorical(clusters).codes\n      for i in range(n):\n          nb = indices[indptr[i]:indptr[i+1]]\n          if nb.size == 0:\n              continue\n          ci = codes[i]\n          di = D_sym[i, nb].A.ravel()\n          nb_codes = codes[nb]\n          same_mask = (nb_codes == ci)\n          other_mask = ~same_mask\n          if not np.any(same_mask) or not np.any(other_mask):\n              s_vals.append(0.0)\n              continue\n          a_i = float(di[same_mask].mean()) if np.any(same_mask) else 0.0\n          other_codes = nb_codes[other_mask]\n          other_dists = di[other_mask]\n          order = np.argsort(other_codes)\n          oc = other_codes[order]\n          od = other_dists[order]\n\
    \          uniq, idx = np.unique(oc, return_index=True)\n          bounds = list(idx) + [oc.size]\n          means = []\n          for j in range(len(uniq)):\n              s = bounds[j]\n              e = bounds[j+1]\n              means.append(float(od[s:e].mean()))\n          b_i = float(np.min(means)) if len(means) > 0 else a_i\n          denom = max(a_i, b_i)\n          s = (b_i - a_i) / denom if denom > 0 else 0.0\n          s_vals.append(max(s, 0.0))\n      if len(s_vals) == 0:\n          return 0.0\n      return float(np.mean(s_vals))\n\n  def _batch_entropy_mixing(C_sym: sp.csr_matrix, batches: np.ndarray) -> float:\n      \"\"\"\n      Local batch entropy (normalized) averaged over nodes: proxy for iLISI.\n      \"\"\"\n      indptr, indices = C_sym.indptr, C_sym.indices\n      n = C_sym.shape[0]\n      bcodes = pd.Categorical(batches).codes\n      B = int(np.max(bcodes)) + 1\n      logB = np.log(max(B, 2))\n      ent = []\n      for i in range(n):\n          nb = indices[indptr[i]:indptr[i+1]]\n\
    \          if nb.size == 0:\n              continue\n          bc = bcodes[nb]\n          counts = np.bincount(bc, minlength=B).astype(np.float32)\n          p = counts / (counts.sum() + 1e-8)\n          H = -(p * np.log(p + 1e-8)).sum() / logB\n          ent.append(float(H))\n      return float(np.mean(ent)) if len(ent) > 0 else 0.0\n\n  def _score_cap_regularizer(inbound_directed: np.ndarray, k_total: int, cap: float = 2.0,\n                             target: float = 0.15, sigma: float = 0.05) -> float:\n      cap_thr = int(np.ceil(cap * k_total))\n      cap_util = float((inbound_directed >= cap_thr).mean())\n      return float(np.exp(-((cap_util - target) ** 2) / (2.0 * (sigma ** 2))))\n\n  def clip_score(C_sym: sp.csr_matrix,\n                 D_sym: sp.csr_matrix,\n                 batches: np.ndarray,\n                 inbound_directed: np.ndarray,\n                 k_total: int,\n                 alpha: float = 0.5,\n                 cap_regularizer: bool = True) -> float:\n\
    \      \"\"\"\n      CLIP_α = α * S + (1 - α) * M, optionally multiplied by a cap utilization regularizer.\n        S: silhouette proxy from unsupervised clusters (Leiden on adjacency)\n        M: normalized local batch entropy (proxy for iLISI)\n      \"\"\"\n      clusters = _leiden_clusters_from_adj(C_sym, resolution=1.0)\n      S = _silhouette_proxy(C_sym, D_sym, clusters)\n      M = _batch_entropy_mixing(C_sym, batches)\n      score = alpha * S + (1.0 - alpha) * M\n      if cap_regularizer:\n          score *= _score_cap_regularizer(inbound_directed, k_total=k_total, cap=2.0,\n                                          target=0.15, sigma=0.05)\n      return float(score)\n\n  def auto_clip_select(Zcorr: np.ndarray,\n                       batches,\n                       *,\n                       deltas=(0.14, 0.15, 0.16),\n                       kd_list=(18, 20, 22),\n                       k_total: int = 48,\n                       metric: str = 'cosine',\n                    \
    \   alpha: float = 0.5,\n                       cap_regularizer: bool = True):\n      \"\"\"\n      Grid search over (delta, k_density) using CLIP_α.\n      Returns: (best_delta, best_kd, C_best, D_best, info_dict)\n      \"\"\"\n      batches = np.asarray(batches)\n      best = None\n      best_info = None\n      for delta in deltas:\n          for kd in kd_list:\n              C_sym, D_sym, f_cross, d_k, inbound_dir, realized_cross = build_daqb_fixed_with_diag(\n                  Zcorr, batches, k_total=k_total, metric=metric, delta=delta, k_density=kd, cap=2.0, rng_seed=0\n              )\n              clip = clip_score(C_sym, D_sym, batches, inbound_dir, k_total, alpha=alpha, cap_regularizer=cap_regularizer)\n              if (best is None) or (clip > best[0]):\n                  best = (clip, delta, kd, C_sym, D_sym)\n                  best_info = {'clip': clip, 'delta': delta, 'k_density': kd}\n      _, bd, bk, Cb, Db = best\n      return bd, bk, Cb, Db, best_info\n```\n\n`/execute_action{storage\
    \ list shared/diagnostics}`\n\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"Auto‑CLIP v1: α=0.5 (Leiden‑silhouette × batch‑entropy) with cap regularizer; BRBG(λ=0.7)\"\ntags: \"auto-tuning, daqb, label-free, clip, silhouette, entropy\"\nabstract: \"Label‑free DAQB selection using CLIP (α=0.5) combining unsupervised silhouette and local batch entropy with a cap regularizer. Grid δ∈{0.14,0.15,0.16}, k_density∈{18,20,22}; BRBG(λ=0.7, γ_max=0.74, PCA50). Graphs are binary + true distances with strict column balancing.\"\ncontent: |\n  import sys\n  sys.path.append('storage')\n  sys.path.append('storage/shared/diagnostics')\n\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n\n  from clip_auto import auto_clip_select\n\n  def _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=target_sum,\
    \ inplace=True)\n      sc.pp.log1p(adata)\n\n  def _pca_array(X, n_comps=50, random_state=0):\n      from scipy import sparse as sp\n      Xd = X.A if sp.issparse(X) else X\n      ad_tmp = ad.AnnData(Xd)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca']\n\n  def _one_hot_batches(batches: np.ndarray):\n      import numpy as np\n      cats = np.unique(batches)\n      n = batches.shape[0]\n      B = np.zeros((n, cats.size), dtype=float)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B\n\n  def _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n      import numpy as np\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      n_pcs_graph = 50\n      l2 = 1e-3\n      gamma_max = 0.74\n      lam = 0.7\n\
    \      k_total = 48\n      metric = 'cosine'\n      alpha_var = 0.5\n\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      _normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n\n      Xh = adata.X[:, hv]\n      from scipy import sparse as sp\n      Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n      var_g = Xd.var(axis=0, ddof=1) + 1e-8\n      wv = np.power(var_g, -0.5 * alpha_var).astype(np.float32)\n      Xw = Xd * wv\n      Zg = _pca_array(Xw, n_comps=n_pcs_graph, random_state=0)\n      B = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred\
    \ / var_total, 0.0, 1.0)\n      gamma = np.minimum(gamma_max, lam * R2)\n      Zcorr = Zg - (Zhat * gamma)\n\n      best_delta, best_kd, C_best, D_best, info = auto_clip_select(\n          Zcorr, batches, deltas=(0.14, 0.15, 0.16), kd_list=(18, 20, 22),\n          k_total=k_total, metric=metric, alpha=0.5, cap_regularizer=True\n      )\n      print(f\"[Auto-CLIP v1] Selected delta={best_delta}, kd={best_kd}, info={info}\")\n      adata.obsp['connectivities'] = C_best\n      adata.obsp['distances'] = D_best\n      return adata\n```\n\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"Auto‑CLIP v2: α=0.7 (label‑structure‑leaning) with cap regularizer; BRBG(λ=0.7)\"\ntags: \"auto-tuning, daqb, label-free, clip, silhouette, entropy\"\nabstract: \"Auto‑CLIP with α=0.7 emphasizes unsupervised label‑structure (silhouette) over batch entropy. Same grid and BRBG as v1; cap regularizer applied. Tests whether a label‑structure‑leaning proxy finds a better (δ,k_density) under DAQB.\"\ncontent: |\n\
    \  import sys\n  sys.path.append('storage')\n  sys.path.append('storage/shared/diagnostics')\n\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n\n  from clip_auto import auto_clip_select\n\n  def _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def _pca_array(X, n_comps=50, random_state=0):\n      from scipy import sparse as sp\n      Xd = X.A if sp.issparse(X) else X\n      ad_tmp = ad.AnnData(Xd)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca']\n\n  def _one_hot_batches(batches: np.ndarray):\n      import numpy as np\n      cats = np.unique(batches)\n      n = batches.shape[0]\n      B = np.zeros((n, cats.size), dtype=float)\n      for j, c in enumerate(cats):\n\
    \          B[:, j] = (batches == c).astype(float)\n      return B\n\n  def _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n      import numpy as np\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      n_pcs_graph = 50\n      l2 = 1e-3\n      gamma_max = 0.74\n      lam = 0.7\n      k_total = 48\n      metric = 'cosine'\n      alpha_var = 0.5\n\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      _normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n\n      Xh = adata.X[:, hv]\n      from scipy import sparse as sp\n      Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32,\
    \ copy=False)\n      var_g = Xd.var(axis=0, ddof=1) + 1e-8\n      wv = np.power(var_g, -0.5 * alpha_var).astype(np.float32)\n      Xw = Xd * wv\n      Zg = _pca_array(Xw, n_comps=n_pcs_graph, random_state=0)\n      B = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      gamma = np.minimum(gamma_max, lam * R2)\n      Zcorr = Zg - (Zhat * gamma)\n\n      best_delta, best_kd, C_best, D_best, info = auto_clip_select(\n          Zcorr, batches, deltas=(0.14, 0.15, 0.16), kd_list=(18, 20, 22),\n          k_total=k_total, metric=metric, alpha=0.7, cap_regularizer=True\n      )\n      print(f\"[Auto-CLIP v2] Selected delta={best_delta}, kd={best_kd}, info={info}\")\n      adata.obsp['connectivities'] = C_best\n      adata.obsp['distances'] = D_best\n      return adata\n```"
