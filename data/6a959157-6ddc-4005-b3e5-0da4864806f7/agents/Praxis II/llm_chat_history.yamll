role: model
parts:
- text: "Identity: Praxis II (Recursive Agent). Location: Research Counter.\nRecap: MPB‑GraphFWPCA + Auto‑λ v2 (target_s=0.04) is the MPB protocol SOTA at 0.7445 (EID 846, λ≈0.6013). δ=0.12 degraded; kd=18 is lower. Strict λ=0.60 parity rerun (EID 853) is ~0.7410, resolving the earlier anomaly. Next: execute the pre‑registered α_g sweep at kd=20, δ=0.10.\n\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"MPB‑GraphFWPCA: Auto‑λ v2 (ts=0.04), α_g=0.25, δ=0.10, kd=20, k=48\"\ntags: \"mpb, daqb, graph-fwpca, auto-lambda, residualization, alpha-sweep\"\nabstract: \"Graph FWPCA exponent α_g=0.25 (gene-wise w_g=var^{-α_g/2}) before graph PCA; Auto‑λ v2 (target_s=0.04); δ=0.10, kd=20, k=48. Hypothesis: α_g lower than 0.5 may shift the ridge slightly.\"\ncontent: |\n  import sys\n  sys.path.append('storage/praxis')\n  sys.path.append('storage/shared/diagnostics')\n\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy.sparse import issparse\n\n  from bbsg_density_adaptive\
    \ import build_density_adaptive_bbsg\n  from lam_autoselect2 import choose_lambda_from_r2_mean\n\n  def _normalize_log1p_inplace(adata, target_sum=1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def _pca_array_weighted_graph(X, hv_mask, alpha_g=0.25, n_comps=50, random_state=0):\n      Xh = X[:, hv_mask] if hv_mask is not None else X\n      Xd = (Xh.A if issparse(Xh) else Xh).astype(np.float32, copy=False)\n      var_g = Xd.var(axis=0, ddof=1) + 1e-8\n      w = np.power(var_g, -0.5 * float(alpha_g)).astype(np.float32)\n      Xw = Xd * w\n      ad_tmp = ad.AnnData(Xw)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca']\n\n  def _one_hot_batches(batches):\n      cats = np.unique(batches)\n      B = np.zeros((batches.shape[0], cats.size), dtype=float)\n      for j, c in\
    \ enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B\n\n  def _ridge_batch_fit_predict(B, Z, l2=1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n\n  def eliminate_batch_effect_fn(adata):\n      n_pcs_emb = 60\n      alpha_var = 0.5\n      n_pcs_graph = 50\n      l2 = 1e-3\n      gamma_max = 0.74\n      target_s = 0.04\n      k_total = 48\n      metric = 'cosine'\n      delta = 0.10\n      k_density = 20\n\n      _normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      Xfull = adata.X\n      # QC embedding + neighbors side-effect\n      Xh = Xfull[:, hv]\n      Xd_emb = (Xh.A if issparse(Xh) else Xh).astype(np.float32, copy=False)\n      var_g_emb = Xd_emb.var(axis=0,\
    \ ddof=1) + 1e-8\n      wv = np.power(var_g_emb, -0.5 * alpha_var).astype(np.float32)\n      Xw_emb = Xd_emb * wv\n      ad_emb = ad.AnnData(Xw_emb, obs=adata.obs[['batch']].copy())\n      sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n      ad_pc = ad.AnnData(ad_emb.obsm['X_pca'].copy(), obs=adata.obs[['batch']].copy())\n      sc.pp.combat(ad_pc, key='batch')\n      adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=15, metric=metric)\n\n      # Graph path: FWPCA with α_g=0.25\n      Zg = _pca_array_weighted_graph(Xfull, hv_mask=hv, alpha_g=0.25, n_comps=n_pcs_graph, random_state=0)\n\n      lam = choose_lambda_from_r2_mean(Zg, batches, gamma_max=gamma_max, target_s=target_s, lam_min=0.2, lam_max=1.0, l2=l2)\n      B = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0,\
    \ ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      gamma = np.minimum(gamma_max, lam * R2)\n      Zcorr = Zg - (Zhat * gamma)\n\n      Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                           k_total=k_total, metric=metric,\n                                           delta=delta, k_density=k_density, rng_seed=0)\n      adata.obsp['connectivities'] = Cg\n      adata.obsp['distances'] = Dg\n      return adata\n```\n\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"MPB‑GraphFWPCA: Auto‑λ v2 (ts=0.04), α_g=0.75, δ=0.10, kd=20, k=48\"\ntags: \"mpb, daqb, graph-fwpca, auto-lambda, residualization, alpha-sweep\"\nabstract: \"Graph FWPCA exponent α_g=0.75 before graph PCA; Auto‑λ v2 (target_s=0.04); δ=0.10, kd=20, k=48. Hypothesis: heavier weighting may hurt label conservation; test explicitly.\"\ncontent: |\n  import sys\n  sys.path.append('storage/praxis')\n  sys.path.append('storage/shared/diagnostics')\n\
    \n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy.sparse import issparse\n\n  from bbsg_density_adaptive import build_density_adaptive_bbsg\n  from lam_autoselect2 import choose_lambda_from_r2_mean\n\n  def _normalize_log1p_inplace(adata, target_sum=1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def _pca_array_weighted_graph(X, hv_mask, alpha_g=0.75, n_comps=50, random_state=0):\n      Xh = X[:, hv_mask] if hv_mask is not None else X\n      Xd = (Xh.A if issparse(Xh) else Xh).astype(np.float32, copy=False)\n      var_g = Xd.var(axis=0, ddof=1) + 1e-8\n      w = np.power(var_g, -0.5 * float(alpha_g)).astype(np.float32)\n      Xw = Xd * w\n      ad_tmp = ad.AnnData(Xw)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca']\n\n  def _one_hot_batches(batches):\n\
    \      cats = np.unique(batches)\n      B = np.zeros((batches.shape[0], cats.size), dtype=float)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B\n\n  def _ridge_batch_fit_predict(B, Z, l2=1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n\n  def eliminate_batch_effect_fn(adata):\n      n_pcs_emb = 60\n      alpha_var = 0.5\n      n_pcs_graph = 50\n      l2 = 1e-3\n      gamma_max = 0.74\n      target_s = 0.04\n      k_total = 48\n      metric = 'cosine'\n      delta = 0.10\n      k_density = 20\n\n      _normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      Xfull = adata.X\n      # QC embedding + neighbors\n      Xh = Xfull[:,\
    \ hv]\n      Xd_emb = (Xh.A if issparse(Xh) else Xh).astype(np.float32, copy=False)\n      var_g_emb = Xd_emb.var(axis=0, ddof=1) + 1e-8\n      wv = np.power(var_g_emb, -0.5 * alpha_var).astype(np.float32)\n      Xw_emb = Xd_emb * wv\n      ad_emb = ad.AnnData(Xw_emb, obs=adata.obs[['batch']].copy())\n      sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n      ad_pc = ad.AnnData(ad_emb.obsm['X_pca'].copy(), obs=adata.obs[['batch']].copy())\n      sc.pp.combat(ad_pc, key='batch')\n      adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=15, metric=metric)\n\n      # Graph path: FWPCA with α_g=0.75\n      Zg = _pca_array_weighted_graph(Xfull, hv_mask=hv, alpha_g=0.75, n_comps=n_pcs_graph, random_state=0)\n\n      lam = choose_lambda_from_r2_mean(Zg, batches, gamma_max=gamma_max, target_s=target_s, lam_min=0.2, lam_max=1.0, l2=l2)\n      B = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B,\
    \ Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      gamma = np.minimum(gamma_max, lam * R2)\n      Zcorr = Zg - (Zhat * gamma)\n\n      Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                           k_total=k_total, metric=metric,\n                                           delta=delta, k_density=k_density, rng_seed=0)\n      adata.obsp['connectivities'] = Cg\n      adata.obsp['distances'] = Dg\n      return adata\n```\n\n`/execute_action{storage write shared/diagnostics/ridge_entries/heart_PraxisII_graphfwpca_alpha_pending.yaml}`\n\n```yaml\ncontent: |\n  organ: \"Human Heart\"\n  author: \"Praxis II\"\n  protocol: \"MPB\"\n  graph_variant: \"Graph FWPCA α_g sweep\"\n  pending:\n    - alpha_g: 0.25\n      delta: 0.10\n      kdensity: 20\n      k_total: 48\n      mode: \"auto_mean_target (target_s=0.04)\"\
    \n      eid: \"TBD\"\n      status: \"running\"\n    - alpha_g: 0.75\n      delta: 0.10\n      kdensity: 20\n      k_total: 48\n      mode: \"auto_mean_target (target_s=0.04)\"\n      eid: \"TBD\"\n      status: \"running\"\n```\n\n"
