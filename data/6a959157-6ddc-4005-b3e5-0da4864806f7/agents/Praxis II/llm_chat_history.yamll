tick: 369
role: model
parts:
- text: "Identity: Praxis II (Recursive Agent). Location: Archive Room.\nRecap: Paper accepted (9/10). New SOTA: λ=0.7 + density-adaptive BBSG with δ=0.15 and k_density=20 scored 0.7452 (EID 609). I’ll test two alternate “safety” proxies for local mixing: (1) reachability-based (LOF-style) and (2) small-k batch entropy, under the same bounded-quota framework.\n\n`/execute_action{goto research}`\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"EtC–BRBG(λ=0.7) + Quota-Balanced Graph with Reachability Density (δ=0.15)\"\ntags: \"brbg, bbsg, density-adaptive, reachability, residualization\"\nabstract: \"Replace k-NN distance density with a LOF-style reachability proxy: per-cell mean distance over a band (k∈[15,45]) in Zcorr. Map to f_cross via the same bounded linear rule (δ=0.15), then build quota-balanced, binary BBSG with true distances. Best base config retained: λ=0.7, γ_max=0.74, k_total=48.\"\ncontent: |\n  import sys\n  sys.path.append('storage')\n\n  import numpy as np\n  import scanpy\
    \ as sc\n  import anndata as ad\n  from scipy import sparse as sp\n  from sklearn.neighbors import NearestNeighbors\n  from praxis.density_proxies import reachability_proxy\n\n  def _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def _pca_array(X, n_comps=50, random_state=0):\n      Xd = X.A if sp.issparse(X) else X\n      ad_tmp = ad.AnnData(Xd)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca']\n\n  def _one_hot_batches(batches: np.ndarray):\n      cats = np.unique(batches)\n      n = batches.shape[0]\n      B = np.zeros((n, cats.size), dtype=float)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B, cats\n\n  def _ridge_batch_fit_predict(B: np.ndarray,\
    \ Z: np.ndarray, l2: float = 1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n\n  def _symmetrize_binary_with_distances(rows, cols, dists, n):\n      A = sp.coo_matrix((np.ones_like(dists, dtype=np.float32), (rows, cols)), shape=(n, n)).tocsr()\n      D = sp.coo_matrix((dists.astype(np.float32), (rows, cols)), shape=(n, n)).tocsr()\n      A_sym = A.maximum(A.T)\n      D_sym = D.maximum(D.T)\n      A_sym.eliminate_zeros()\n      D_sym.eliminate_zeros()\n      return A_sym.tocsr().astype(np.float32), D_sym.tocsr().astype(np.float32)\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      # Config (best base + reachability proxy)\n      n_pcs_emb = 60\n      n_pcs_graph = 50\n      l2 = 1e-3\n      gamma_max = 0.74\n      lam = 0.7\n      k_total = 48\n      metric = 'cosine'\n      delta = 0.15\n      k_band = (15, 45)\n      alpha_var = 0.5\n      emb_n_neighbors = 15\n\n      assert 'batch'\
    \ in adata.obs.columns and 'feature_name' in adata.var.columns\n\n      # Normalize + HVGs\n      _normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n      batches_cat = adata.obs['batch'].astype('category')\n      batches = np.asarray(batches_cat.values)\n\n      # Embedding (EtC): FWPCA α=0.5 → PCA60 → ComBat (analysis only)\n      Xh = adata.X[:, hv]\n      Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n      var_g = Xd.var(axis=0, ddof=1) + 1e-8\n      wv = np.power(var_g, -0.5 * alpha_var).astype(np.float32)\n      Xw = Xd * wv\n      ad_emb = ad.AnnData(Xw, obs=adata.obs[['batch']].copy())\n      sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n      Z_emb = ad_emb.obsm['X_pca']\n      ad_pc = ad.AnnData(Z_emb.copy(), obs=adata.obs[['batch']].copy())\n      sc.pp.combat(ad_pc, key='batch')\n\
    \      adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n      # Graph: PCA50 → adaptive residualization → Zcorr\n      Zg = _pca_array(Xd, n_comps=n_pcs_graph, random_state=0)\n      B, cats = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      gamma = np.minimum(gamma_max, lam * R2)\n      Zcorr = Zg - (Zhat * gamma)\n\n      # Reachability proxy → f_cross in [0.60, 0.90]\n      s = reachability_proxy(Zcorr, k_low=k_band[0], k_high=k_band[1], metric=metric)  # higher = denser/safer\n      base_cross = (len(cats) - 1) / float(len(cats))\n      f_cross = np.clip(base_cross + (s - 0.5) * 2.0 * delta, 0.60, 0.90)\n\n      # Pre-build per-batch KNN models\n      n = Zcorr.shape[0]\n      B_other\
    \ = max(len(cats) - 1, 1)\n      max_cross_per = int(np.ceil(0.9 * k_total / B_other))\n      max_within = int(np.ceil((1.0 - 0.60) * k_total))\n      nn_models, train_indices = {}, {}\n      for j, c in enumerate(cats):\n          mask = (batches == c)\n          train_indices[j] = np.where(mask)[0]\n          nn = NearestNeighbors(n_neighbors=max(max_within, max_cross_per) + 1, metric=metric, algorithm='brute')\n          nn.fit(Zcorr[mask])\n          nn_models[j] = nn\n\n      nn_dists, nn_idx_local = {}, {}\n      for j in range(len(cats)):\n          d, ii = nn_models[j].kneighbors(Zcorr, return_distance=True)\n          nn_dists[j] = d\n          nn_idx_local[j] = ii\n\n      rows, cols, dvals = [], [], []\n      batch_codes = batches_cat.cat.codes.to_numpy()\n      for i in range(n):\n          bi = int(batch_codes[i])\n          q_cross_total = int(round(f_cross[i] * k_total))\n          q_within = max(0, min(k_total, int(round(k_total - q_cross_total))))\n          q_per_other\
    \ = q_cross_total // B_other\n          rem = q_cross_total - q_per_other * B_other\n\n          # within-batch\n          d_i = nn_dists[bi][i]\n          ii = nn_idx_local[bi][i]\n          start = 1 if d_i[0] == 0.0 else 0\n          sel = min(q_within, d_i.shape[0] - start)\n          if sel > 0:\n              cols.extend(train_indices[bi][ii[start:start + sel]])\n              rows.extend([i] * sel)\n              dvals.extend(d_i[start:start + sel])\n\n          # other-batch distribution: favor closest batches by first-neighbor distance\n          other_batches = [j for j in range(len(cats)) if j != bi]\n          batch_scores = [(j, nn_dists[j][i][0]) for j in other_batches]\n          batch_scores.sort(key=lambda t: t[1])\n          q_map = {j: q_per_other for j in other_batches}\n          for k in range(rem):\n              q_map[batch_scores[k % len(other_batches)][0]] += 1\n\n          for j in other_batches:\n              d_ij = nn_dists[j][i]\n              ii_j = nn_idx_local[j][i]\n\
    \              sel_j = min(q_map[j], d_ij.shape[0])\n              if sel_j > 0:\n                  cols.extend(train_indices[j][ii_j[:sel_j]])\n                  rows.extend([i] * sel_j)\n                  dvals.extend(d_ij[:sel_j])\n\n      C_sym, D_sym = _symmetrize_binary_with_distances(np.asarray(rows, np.int32),\n                                                       np.asarray(cols, np.int32),\n                                                       np.asarray(dvals, np.float32),\n                                                       n)\n      adata.obsp['connectivities'] = C_sym\n      adata.obsp['distances'] = D_sym\n      return adata\n```\n\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"EtC–BRBG(λ=0.7) + Quota-Balanced Graph with Local Batch Entropy (δ=0.15)\"\ntags: \"brbg, bbsg, density-adaptive, entropy, residualization\"\nabstract: \"Replace the density proxy with small-k batch entropy (k=12) in Zcorr: higher entropy (locally well-mixed) → higher cross-batch fraction;\
    \ lower entropy (homogeneous neighborhoods) → lower cross-batch fraction. Same bounded linear mapping (δ=0.15). Base config retained: λ=0.7, γ_max=0.74, k_total=48.\"\ncontent: |\n  import sys\n  sys.path.append('storage')\n\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n  from sklearn.neighbors import NearestNeighbors\n  from praxis.density_proxies import batch_entropy_proxy\n\n  def _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def _pca_array(X, n_comps=50, random_state=0):\n      Xd = X.A if sp.issparse(X) else X\n      ad_tmp = ad.AnnData(Xd)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca']\n\n  def _one_hot_batches(batches: np.ndarray):\n\
    \      cats = np.unique(batches)\n      n = batches.shape[0]\n      B = np.zeros((n, cats.size), dtype=float)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B, cats\n\n  def _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n\n  def _symmetrize_binary_with_distances(rows, cols, dists, n):\n      A = sp.coo_matrix((np.ones_like(dists, dtype=np.float32), (rows, cols)), shape=(n, n)).tocsr()\n      D = sp.coo_matrix((dists.astype(np.float32), (rows, cols)), shape=(n, n)).tocsr()\n      A_sym = A.maximum(A.T)\n      D_sym = D.maximum(D.T)\n      A_sym.eliminate_zeros()\n      D_sym.eliminate_zeros()\n      return A_sym.tocsr().astype(np.float32), D_sym.tocsr().astype(np.float32)\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      # Config (best base + batch entropy proxy)\n\
    \      n_pcs_emb = 60\n      n_pcs_graph = 50\n      l2 = 1e-3\n      gamma_max = 0.74\n      lam = 0.7\n      k_total = 48\n      metric = 'cosine'\n      delta = 0.15\n      k_small = 12\n      alpha_var = 0.5\n      emb_n_neighbors = 15\n\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n      # Normalize + HVGs\n      _normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n      batches_cat = adata.obs['batch'].astype('category')\n      batches = np.asarray(batches_cat.values)\n\n      # Embedding (EtC): FWPCA α=0.5 → PCA60 → ComBat (analysis only)\n      Xh = adata.X[:, hv]\n      Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n      var_g = Xd.var(axis=0, ddof=1) + 1e-8\n      wv = np.power(var_g, -0.5 * alpha_var).astype(np.float32)\n      Xw = Xd * wv\n      ad_emb = ad.AnnData(Xw,\
    \ obs=adata.obs[['batch']].copy())\n      sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n      Z_emb = ad_emb.obsm['X_pca']\n      ad_pc = ad.AnnData(Z_emb.copy(), obs=adata.obs[['batch']].copy())\n      sc.pp.combat(ad_pc, key='batch')\n      adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n      # Graph: PCA50 → adaptive residualization → Zcorr\n      Zg = _pca_array(Xd, n_comps=n_pcs_graph, random_state=0)\n      B, cats = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      gamma = np.minimum(gamma_max, lam * R2)\n      Zcorr = Zg - (Zhat * gamma)\n\n      # Batch entropy proxy → f_cross in [0.60, 0.90]\n      s = batch_entropy_proxy(Zcorr, batches=batches, k=k_small,\
    \ metric=metric)  # higher entropy = safer to mix\n      base_cross = (len(cats) - 1) / float(len(cats))\n      f_cross = np.clip(base_cross + (s - 0.5) * 2.0 * delta, 0.60, 0.90)\n\n      # Pre-build per-batch KNN models\n      n = Zcorr.shape[0]\n      B_other = max(len(cats) - 1, 1)\n      max_cross_per = int(np.ceil(0.9 * k_total / B_other))\n      max_within = int(np.ceil((1.0 - 0.60) * k_total))\n      nn_models, train_indices = {}, {}\n      for j, c in enumerate(cats):\n          mask = (batches == c)\n          train_indices[j] = np.where(mask)[0]\n          nn = NearestNeighbors(n_neighbors=max(max_within, max_cross_per) + 1, metric=metric, algorithm='brute')\n          nn.fit(Zcorr[mask])\n          nn_models[j] = nn\n\n      nn_dists, nn_idx_local = {}, {}\n      for j in range(len(cats)):\n          d, ii = nn_models[j].kneighbors(Zcorr, return_distance=True)\n          nn_dists[j] = d\n          nn_idx_local[j] = ii\n\n      rows, cols, dvals = [], [], []\n      batch_codes\
    \ = batches_cat.cat.codes.to_numpy()\n      for i in range(n):\n          bi = int(batch_codes[i])\n          q_cross_total = int(round(f_cross[i] * k_total))\n          q_within = max(0, min(k_total, int(round(k_total - q_cross_total))))\n          q_per_other = q_cross_total // B_other\n          rem = q_cross_total - q_per_other * B_other\n\n          # within-batch\n          d_i = nn_dists[bi][i]\n          ii = nn_idx_local[bi][i]\n          start = 1 if d_i[0] == 0.0 else 0\n          sel = min(q_within, d_i.shape[0] - start)\n          if sel > 0:\n              cols.extend(train_indices[bi][ii[start:start + sel]])\n              rows.extend([i] * sel)\n              dvals.extend(d_i[start:start + sel])\n\n          # other-batch distribution\n          other_batches = [j for j in range(len(cats)) if j != bi]\n          batch_scores = [(j, nn_dists[j][i][0]) for j in other_batches]\n          batch_scores.sort(key=lambda t: t[1])\n          q_map = {j: q_per_other for j in other_batches}\n\
    \          for k in range(rem):\n              q_map[batch_scores[k % len(other_batches)][0]] += 1\n\n          for j in other_batches:\n              d_ij = nn_dists[j][i]\n              ii_j = nn_idx_local[j][i]\n              sel_j = min(q_map[j], d_ij.shape[0])\n              if sel_j > 0:\n                  cols.extend(train_indices[j][ii_j[:sel_j]])\n                  rows.extend([i] * sel_j)\n                  dvals.extend(d_ij[:sel_j])\n\n      C_sym, D_sym = _symmetrize_binary_with_distances(np.asarray(rows, np.int32),\n                                                       np.asarray(cols, np.int32),\n                                                       np.asarray(dvals, np.float32),\n                                                       n)\n      adata.obsp['connectivities'] = C_sym\n      adata.obsp['distances'] = D_sym\n      return adata\n```"
