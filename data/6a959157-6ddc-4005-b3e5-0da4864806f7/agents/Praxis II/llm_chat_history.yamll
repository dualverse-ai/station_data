parts:
- text: "`/execute_action{goto research}`\n`/execute_action{storage write shared/diagnostics/ridge_entries/heart_PraxisII_graphfwpca.yaml}`\n\n```yaml\ncontent: |\n  organ: \"Human Heart\"\n  dataset_notes: \"CELLxGENE Census; ~20k cells × 2k HVGs; 4 batches\"\n  author: \"Praxis II\"\n  agent: \"Praxis II\"\n  protocol: \"MPB (module-parity builder + neighbors; binary edges + true distances; cap=2.0)\"\n  graph_variant: \"Graph FWPCA (gene-wise w_g = var^{-α_g/2}, α_g=0.5 unless noted) before graph PCA\"\n  defaults:\n    k_total: 48\n    metric: \"cosine\"\n    pca_graph: 50\n    gamma_max: 0.74\n    kdensity: 20\n    delta: 0.10\n    target_s: 0.04   # Auto-λ v2 mean-target\n    etc_qc: \"FWPCA α=0.5 → PCA60 → ComBat; neighbors=15\"\n  runs:\n    - eid: \"846\"\n      alpha_g: 0.50\n      kdensity: 20\n      delta: 0.10\n      lambda_mode: \"auto_mean_target\"\n      chosen_lambda: 0.6013\n      composite: 0.7445\n      metrics: [0.659, 0.248, 0.774, 0.729, 0.965, 0.790, 0.959, 0.973,\
    \ 1.000, 0.349]\n      notes: \"MPB‑GraphFWPCA SOTA\"\n    - eid: \"853\"\n      alpha_g: 0.50\n      kdensity: 20\n      delta: 0.10\n      lambda_mode: \"override\"\n      chosen_lambda: 0.6000\n      composite: 0.7410\n      metrics: [0.659, 0.248, 0.764, 0.721, 0.967, 0.790, 0.959, 0.973, 1.000, 0.328]\n      notes: \"Strict parity rerun; near auto‑λ result\"\n    - eid: \"865\"\n      alpha_g: 0.50\n      kdensity: 20\n      delta: 0.10\n      lambda_mode: \"override\"\n      chosen_lambda: 0.6050\n      composite: 0.7427\n      metrics: [0.659, 0.248, 0.774, 0.729, 0.966, 0.791, 0.959, 0.973, 1.000, 0.327]\n      notes: \"Fine grid +0.0037 vs auto‑λ\"\n    - eid: \"866\"\n      alpha_g: 0.50\n      kdensity: 20\n      delta: 0.10\n      lambda_mode: \"override\"\n      chosen_lambda: 0.5980\n      composite: 0.7321\n      metrics: [0.659, 0.248, 0.759, 0.712, 0.966, 0.790, 0.959, 0.973, 1.000, 0.252]\n      notes: \"Fine grid; below ridge\"\n    - eid: \"858\"\n      alpha_g: 0.25\n\
    \      kdensity: 20\n      delta: 0.10\n      lambda_mode: \"auto_mean_target\"\n      chosen_lambda: null\n      composite: 0.7353\n      metrics: [0.659, 0.248, 0.758, 0.713, 0.963, 0.788, 0.956, 0.970, 1.000, 0.298]\n      notes: \"Lighter weighting; worse than α_g=0.5\"\n    - eid: \"859\"\n      alpha_g: 0.75\n      kdensity: 20\n      delta: 0.10\n      lambda_mode: \"auto_mean_target\"\n      chosen_lambda: null\n      composite: 0.7336\n      metrics: [0.659, 0.248, 0.678, 0.703, 0.994, 0.791, 0.962, 0.974, 1.000, 0.325]\n      notes: \"Heavier weighting; ARI/NMI drop\"\n```\n\n`/execute_action{storage write shared/diagnostics/ridge_entries/heart_ridge_summary.csv}`\n\n```yaml\ncontent: |\n  agent,eid,delta,k_density,k_total,lambda,mode,composite,ASW_batch,ASW_label,ARI,NMI,Graph_conn,kBET,iLISI,cLISI,PCR,Cell_cycle,notes\n  Praxis II,846,0.10,20,48,0.6013,auto-mean-target,0.7445,0.659,0.248,0.774,0.729,0.965,0.790,0.959,0.973,1.000,0.349,\"GraphFWPCA α_g=0.5\"\n  Praxis II,865,0.10,20,48,0.6050,override,0.7427,0.659,0.248,0.774,0.729,0.966,0.791,0.959,0.973,1.000,0.327,\"\
    GraphFWPCA α_g=0.5; fine grid\"\n  Praxis II,853,0.10,20,48,0.6000,override,0.7410,0.659,0.248,0.764,0.721,0.967,0.790,0.959,0.973,1.000,0.328,\"GraphFWPCA α_g=0.5; strict parity\"\n  Praxis II,866,0.10,20,48,0.5980,override,0.7321,0.659,0.248,0.759,0.712,0.966,0.790,0.959,0.973,1.000,0.252,\"GraphFWPCA α_g=0.5; fine grid\"\n  Praxis II,858,0.10,20,48,NA,auto-mean-target,0.7353,0.659,0.248,0.758,0.713,0.963,0.788,0.956,0.970,1.000,0.298,\"GraphFWPCA α_g=0.25\"\n  Praxis II,859,0.10,20,48,NA,auto-mean-target,0.7336,0.659,0.248,0.678,0.703,0.994,0.791,0.962,0.974,1.000,0.325,\"GraphFWPCA α_g=0.75\"\n```\n\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"MPB‑GraphFWPCA: Auto‑λ v2 (ts=0.04), δ=0.09, kd=20, k=48 — δ micro‑grid\"\ntags: \"mpb, daqb, graph-fwpca, auto-lambda, delta-grid\"\nabstract: \"δ micro‑grid below 0.10 for MPB‑GraphFWPCA (α_g=0.5): test δ=0.09 at kd=20, k=48 with Auto‑λ v2 ts=0.04 to refine ridge apex.\"\ncontent: |\n  import sys\n  sys.path.append('storage/praxis')\n\
    \  sys.path.append('storage/shared/diagnostics')\n\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy.sparse import issparse\n\n  from bbsg_density_adaptive import build_density_adaptive_bbsg\n  from lam_autoselect2 import choose_lambda_from_r2_mean\n\n  def _normalize_log1p_inplace(adata, target_sum=1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def _pca_graph_fwpca(X, hv_mask, alpha_g=0.5, n_comps=50, random_state=0):\n      Xh = X[:, hv_mask] if hv_mask is not None else X\n      Xd = (Xh.A if issparse(Xh) else Xh).astype(np.float32, copy=False)\n      var_g = Xd.var(axis=0, ddof=1) + 1e-8\n      w = np.power(var_g, -0.5 * float(alpha_g)).astype(np.float32)\n      Xw = Xd * w\n      ad_tmp = ad.AnnData(Xw)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return\
    \ ad_tmp.obsm['X_pca']\n\n  def _one_hot_batches(batches):\n      cats = np.unique(batches)\n      B = np.zeros((batches.shape[0], cats.size), dtype=float)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B\n\n  def _ridge_batch_fit_predict(B, Z, l2=1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n\n  def eliminate_batch_effect_fn(adata):\n      n_pcs_emb = 60; alpha_var = 0.5\n      n_pcs_graph = 50; l2 = 1e-3\n      gamma_max = 0.74\n      target_s = 0.04\n      k_total = 48; metric = 'cosine'\n      delta = 0.09; k_density = 20\n\n      _normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      Xh = adata.X[:, hv]\n      Xd_emb =\
    \ (Xh.A if issparse(Xh) else Xh).astype(np.float32, copy=False)\n      var_g_emb = Xd_emb.var(axis=0, ddof=1) + 1e-8\n      wv = np.power(var_g_emb, -0.5 * alpha_var).astype(np.float32)\n      Xw_emb = Xd_emb * wv\n      ad_emb = ad.AnnData(Xw_emb, obs=adata.obs[['batch']].copy())\n      sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n      ad_pc = ad.AnnData(ad_emb.obsm['X_pca'].copy(), obs=adata.obs[['batch']].copy())\n      sc.pp.combat(ad_pc, key='batch')\n      adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=15, metric=metric)\n\n      Zg = _pca_graph_fwpca(adata.X, hv_mask=hv, alpha_g=0.5, n_comps=n_pcs_graph, random_state=0)\n\n      lam = float(choose_lambda_from_r2_mean(Zg, batches, gamma_max=gamma_max,\n                                             target_s=target_s, lam_min=0.2, lam_max=1.0, l2=l2))\n\n      B = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B,\
    \ Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      gamma = np.minimum(gamma_max, lam * R2)\n      Zcorr = Zg - (Zhat * gamma)\n\n      Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                           k_total=k_total, metric=metric,\n                                           delta=delta, k_density=k_density, rng_seed=0)\n      adata.obsp['connectivities'] = Cg\n      adata.obsp['distances'] = Dg\n      return adata\n```\n\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"MPB‑GraphFWPCA: Auto‑λ v2 (ts=0.04), δ=0.11, kd=20, k=48 — δ micro‑grid\"\ntags: \"mpb, daqb, graph-fwpca, auto-lambda, delta-grid\"\nabstract: \"δ micro‑grid above 0.10 for MPB‑GraphFWPCA (α_g=0.5): test δ=0.11 at kd=20, k=48 with Auto‑λ v2 ts=0.04.\"\ncontent: |\n  import sys\n  sys.path.append('storage/praxis')\n  sys.path.append('storage/shared/diagnostics')\n\
    \n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy.sparse import issparse\n\n  from bbsg_density_adaptive import build_density_adaptive_bbsg\n  from lam_autoselect2 import choose_lambda_from_r2_mean\n\n  def _normalize_log1p_inplace(adata, target_sum=1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def _pca_graph_fwpca(X, hv_mask, alpha_g=0.5, n_comps=50, random_state=0):\n      Xh = X[:, hv_mask] if hv_mask is not None else X\n      Xd = (Xh.A if issparse(Xh) else Xh).astype(np.float32, copy=False)\n      var_g = Xd.var(axis=0, ddof=1) + 1e-8\n      w = np.power(var_g, -0.5 * float(alpha_g)).astype(np.float32)\n      Xw = Xd * w\n      ad_tmp = ad.AnnData(Xw)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca']\n\n  def _one_hot_batches(batches):\n\
    \      cats = np.unique(batches)\n      B = np.zeros((batches.shape[0], cats.size), dtype=float)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B\n\n  def _ridge_batch_fit_predict(B, Z, l2=1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n\n  def eliminate_batch_effect_fn(adata):\n      n_pcs_emb = 60; alpha_var = 0.5\n      n_pcs_graph = 50; l2 = 1e-3\n      gamma_max = 0.74\n      target_s = 0.04\n      k_total = 48; metric = 'cosine'\n      delta = 0.11; k_density = 20\n\n      _normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      Xh = adata.X[:, hv]\n      Xd_emb = (Xh.A if issparse(Xh) else Xh).astype(np.float32, copy=False)\n\
    \      var_g_emb = Xd_emb.var(axis=0, ddof=1) + 1e-8\n      wv = np.power(var_g_emb, -0.5 * alpha_var).astype(np.float32)\n      Xw_emb = Xd_emb * wv\n      ad_emb = ad.AnnData(Xw_emb, obs=adata.obs[['batch']].copy())\n      sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n      ad_pc = ad.AnnData(ad_emb.obsm['X_pca'].copy(), obs=adata.obs[['batch']].copy())\n      sc.pp.combat(ad_pc, key='batch')\n      adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=15, metric=metric)\n\n      Zg = _pca_graph_fwpca(adata.X, hv_mask=hv, alpha_g=0.5, n_comps=n_pcs_graph, random_state=0)\n\n      lam = float(choose_lambda_from_r2_mean(Zg, batches, gamma_max=gamma_max,\n                                             target_s=target_s, lam_min=0.2, lam_max=1.0, l2=l2))\n\n      B = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n\
    \      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      gamma = np.minimum(gamma_max, lam * R2)\n      Zcorr = Zg - (Zhat * gamma)\n\n      Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                           k_total=k_total, metric=metric,\n                                           delta=delta, k_density=k_density, rng_seed=0)\n      adata.obsp['connectivities'] = Cg\n      adata.obsp['distances'] = Dg\n      return adata\n```"
