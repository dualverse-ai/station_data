parts:
- text: "Acknowledged. Submissions must be made from the Research Counter. I’ll resubmit the two GHS v5 experiments correctly.\n\n`/execute_action{goto research}`\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"Auto‑GHS v5 (w_div=0.35, w_target=0.35, w_cap=0.20, w_inb=0.10; sigma_target=0.05; cap_target=0.15)\"\ntags: \"auto-tuning, daqb, label-free, graph-health-score, diagnostics, residualization\"\nabstract: \"Label‑free DAQB selection on Human Heart using GHS v5 with directed diagnostics and target adherence. Grid δ∈{0.14,0.15,0.16}, k_density∈{18,20,22}; BRBG(λ=0.7, γ_max=0.74, PCA50). Graphs are binary + true distances with strict column balancing (cap=2.0), fixed remainder‑to‑closest split. EtC (FWPCA α=0.5, PCA60→ComBat) is QC‑only.\"\ncontent: |\n  import sys\n  sys.path.append('storage')\n  sys.path.append('storage/shared/diagnostics')\n\n  import numpy as np\n  import pandas as pd\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n\n  from ghs_v5\
    \ import build_daqb_fixed_with_diag, score_ghs_v5\n\n  def _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def _pca_array(X, n_comps=50, random_state=0):\n      from scipy import sparse as sp\n      Xd = X.A if sp.issparse(X) else X\n      ad_tmp = ad.AnnData(Xd)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca']\n\n  def _one_hot_batches(batches: np.ndarray):\n      cats = np.unique(batches)\n      n = batches.shape[0]\n      B = np.zeros((n, cats.size), dtype=float)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B\n\n  def _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n\
    \      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      n_pcs_emb, n_pcs_graph = 60, 50\n      l2, gamma_max, lam = 1e-3, 0.74, 0.7\n      k_total, metric, alpha_var, emb_n_neighbors, cap = 48, 'cosine', 0.5, 15, 2.0\n      deltas, kd_list = [0.14, 0.15, 0.16], [18, 20, 22]\n\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      _normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n\n      Xh = adata.X[:, hv]\n      from scipy import sparse as sp\n      Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n      var_g = Xd.var(axis=0, ddof=1) + 1e-8\n      wv = np.power(var_g, -0.5 * alpha_var).astype(np.float32)\n      Xw = Xd * wv\n\
    \      ad_emb = ad.AnnData(Xw, obs=adata.obs[['batch']].copy())\n      sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n      Z_emb = ad_emb.obsm['X_pca']\n      ad_pc = ad.AnnData(Z_emb.copy(), obs=adata.obs[['batch']].copy())\n      sc.pp.combat(ad_pc, key='batch')\n      adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n      Zg = _pca_array(Xd, n_comps=n_pcs_graph, random_state=0)\n      B = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      gamma = np.minimum(gamma_max, lam * R2)\n      Zcorr = Zg - (Zhat * gamma)\n\n      best = None\n      for delta in deltas:\n          for kd in kd_list:\n              C_sym, D_sym, f_cross, d_k, inbound_dir, realized_cross\
    \ = build_daqb_fixed_with_diag(\n                  Zcorr, batches, k_total=k_total, metric=metric, delta=delta, k_density=kd, cap=cap, rng_seed=0\n              )\n              ghs, info = score_ghs_v5(\n                  C_sym, batches,\n                  inbound_directed=inbound_dir, f_cross=f_cross, realized_cross=realized_cross,\n                  k_total=k_total, cap=cap,\n                  w_div=0.35, w_target=0.35, w_cap=0.20, w_inb=0.10,\n                  sigma_target=0.05, cap_util_target=0.15, cap_util_sigma=0.05\n              )\n              if (best is None) or (ghs > best[0]):\n                  best = (ghs, delta, kd, C_sym, D_sym, info)\n      ghs, best_delta, best_kd, C_best, D_best, info = best\n      print(f\"[Auto-GHS v5] Selected delta={best_delta}, kd={best_kd}, GHS={ghs:.4f}, info={info}\")\n\n      adata.obsp['connectivities'] = C_best\n      adata.obsp['distances'] = D_best\n      return adata\n```\n\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"Auto‑GHS\
    \ v5 (target‑heavy: w_div=0.25, w_target=0.45, w_cap=0.20, w_inb=0.10; sigma_target=0.05; cap_target=0.15)\"\ntags: \"auto-tuning, daqb, label-free, graph-health-score, diagnostics, residualization\"\nabstract: \"Label‑free DAQB selection emphasizing adherence to per‑cell target cross‑batch share. GHS v5 uses directed diagnostics: diversity, target adherence, cap utilization, inbound uniformity. Grid δ∈{0.14,0.15,0.16}, k_density∈{18,20,22}; BRBG(λ=0.7, γ_max=0.74, PCA50); binary + true distances; strict column balancing.\"\ncontent: |\n  import sys\n  sys.path.append('storage')\n  sys.path.append('storage/shared/diagnostics')\n\n  import numpy as np\n  import pandas as pd\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n\n  from ghs_v5 import build_daqb_fixed_with_diag, score_ghs_v5\n\n  def _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n  \
    \    sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def _pca_array(X, n_comps=50, random_state=0):\n      from scipy import sparse as sp\n      Xd = X.A if sp.issparse(X) else X\n      ad_tmp = ad.AnnData(Xd)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca']\n\n  def _one_hot_batches(batches: np.ndarray):\n      cats = np.unique(batches)\n      n = batches.shape[0]\n      B = np.zeros((n, cats.size), dtype=float)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B\n\n  def _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      n_pcs_emb, n_pcs_graph = 60, 50\n      l2, gamma_max, lam = 1e-3, 0.74, 0.7\n\
    \      k_total, metric, alpha_var, emb_n_neighbors, cap = 48, 'cosine', 0.5, 15, 2.0\n      deltas, kd_list = [0.14, 0.15, 0.16], [18, 20, 22]\n\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      _normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n\n      Xh = adata.X[:, hv]\n      from scipy import sparse as sp\n      Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n      var_g = Xd.var(axis=0, ddof=1) + 1e-8\n      wv = np.power(var_g, -0.5 * alpha_var).astype(np.float32)\n      Xw = Xd * wv\n      ad_emb = ad.AnnData(Xw, obs=adata.obs[['batch']].copy())\n      sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n      Z_emb = ad_emb.obsm['X_pca']\n      ad_pc = ad.AnnData(Z_emb.copy(),\
    \ obs=adata.obs[['batch']].copy())\n      sc.pp.combat(ad_pc, key='batch')\n      adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n      Zg = _pca_array(Xd, n_comps=n_pcs_graph, random_state=0)\n      B = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      gamma = np.minimum(gamma_max, lam * R2)\n      Zcorr = Zg - (Zhat * gamma)\n\n      best = None\n      for delta in deltas:\n          for kd in kd_list:\n              C_sym, D_sym, f_cross, d_k, inbound_dir, realized_cross = build_daqb_fixed_with_diag(\n                  Zcorr, batches, k_total=k_total, metric=metric, delta=delta, k_density=kd, cap=cap, rng_seed=0\n              )\n              ghs, info = score_ghs_v5(\n            \
    \      C_sym, batches,\n                  inbound_directed=inbound_dir, f_cross=f_cross, realized_cross=realized_cross,\n                  k_total=k_total, cap=cap,\n                  w_div=0.25, w_target=0.45, w_cap=0.20, w_inb=0.10,\n                  sigma_target=0.05, cap_util_target=0.15, cap_util_sigma=0.05\n              )\n              if (best is None) or (ghs > best[0]):\n                  best = (ghs, delta, kd, C_sym, D_sym, info)\n      ghs, best_delta, best_kd, C_best, D_best, info = best\n      print(f\"[Auto-GHS v5 target] Selected delta={best_delta}, kd={best_kd}, GHS={ghs:.4f}, info={info}\")\n\n      adata.obsp['connectivities'] = C_best\n      adata.obsp['distances'] = D_best\n      return adata\n```"
