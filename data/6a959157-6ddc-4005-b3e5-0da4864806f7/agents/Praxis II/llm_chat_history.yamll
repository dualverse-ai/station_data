tick: 379
role: model
parts:
- text: "Identity: Praxis II (Recursive Agent). Location: Reflection Chamber.\nRecap: Best config is EtC–BRBG (λ=0.7, γ_max=0.74) + density-adaptive BBSG (δ=0.15, k_density=20), 0.7452 (EID 609). Reflection concluded: pursue a parameter-lean, scale-free density proxy with global budget preservation and strict column balancing.\n\n`/execute_action{goto research}`\n`/execute_action{storage write praxis/bbsg_density_lean.py}`\n\n```yaml\ncontent: |\n  import numpy as np\n  from scipy import sparse as sp\n  from sklearn.neighbors import NearestNeighbors\n\n  def _symmetrize_binary_with_distances(rows, cols, dists, n):\n      A = sp.coo_matrix((np.ones_like(dists, dtype=np.float32), (rows, cols)), shape=(n, n)).tocsr()\n      D = sp.coo_matrix((dists.astype(np.float32), (rows, cols)), shape=(n, n)).tocsr()\n      A_sym = A.maximum(A.T)\n      D_sym = D.maximum(D.T)\n      A_sym.eliminate_zeros(); D_sym.eliminate_zeros()\n      return A_sym, D_sym\n\n  def _zscore(x, eps=1e-8):\n      x = np.asarray(x,\
    \ dtype=np.float32)\n      return (x - x.mean()) / (x.std() + eps)\n\n  def _clip(x, lo, hi):\n      return np.minimum(np.maximum(x, lo), hi)\n\n  def _recenter_to_global_budget(f_raw, base_cross, bounds, tol=1e-6, maxit=60):\n      \"\"\"\n      Find offset c such that sum(clip(f_raw + c, L, U)) == n * base_cross.\n      Monotone in c => solve by bisection.\n      \"\"\"\n      L, U = bounds\n      target = float(base_cross * f_raw.size)\n      # Bracket\n      c_lo, c_hi = -1.0, 1.0\n      def total(c):\n          return float(np.clip(f_raw + c, L, U).sum())\n      # Expand if needed\n      for _ in range(20):\n          if total(c_lo) > target: c_lo -= 1.0\n          if total(c_hi) < target: c_hi += 1.0\n          if total(c_lo) <= target <= total(c_hi): break\n      # Bisection\n      for _ in range(maxit):\n          c_mid = 0.5 * (c_lo + c_hi)\n          s_mid = total(c_mid)\n          if abs(s_mid - target) <= tol:\n              return np.clip(f_raw + c_mid, L, U)\n         \
    \ if s_mid < target:\n              c_lo = c_mid\n          else:\n              c_hi = c_mid\n      return np.clip(f_raw + 0.5 * (c_lo + c_hi), L, U)\n\n  def build_density_lean_bbsg(\n      Zcorr: np.ndarray,\n      batches,\n      k_total: int = 48,\n      metric: str = 'cosine',\n      delta: float = 0.15,\n      f_bounds=(0.60, 0.90),\n      band=(0.30, 0.60),\n      cap: float = 2.0,\n      rng_seed: int = 0\n  ):\n      \"\"\"\n      Parameter-lean density-adaptive BBSG:\n        - Density proxy: median distance over a band of the all-batch kNN distances in Zcorr.\n          Band is scale-free relative to k_total (default 30–60% of k_total).\n        - f_cross = base_cross + delta * zscore(−density); then recentered by a constant offset\n          so that sum_i f_cross[i] equals the global base budget (n * base_cross), finally clipped to [L, U].\n        - Per-batch quotas with single-pass column balancing: inbound-first, then distance.\n        - Binary edges; true distances;\
    \ undirected via max symmetrization.\n      \"\"\"\n      rng = np.random.default_rng(rng_seed)\n      Z = np.asarray(Zcorr, dtype=np.float32, order='C')\n      n = Z.shape[0]\n      batches = np.asarray(batches)\n      cats = np.unique(batches)\n      n_batches = len(cats)\n      base_cross = (n_batches - 1) / float(n_batches)\n      L, U = f_bounds\n      eps = 1e-8\n\n      # Scale-free density: median over distance band of all-batch kNN\n      k_hi = max(int(np.ceil(band[1] * k_total)) + 1, 8)   # +1 to allow skipping self\n      nn_all = NearestNeighbors(n_neighbors=k_hi, metric=metric, algorithm='brute')\n      nn_all.fit(Z)\n      d_all, _ = nn_all.kneighbors(Z, return_distance=True)\n      start = 1  # skip self if present\n      lo = start + max(int(np.floor(band[0] * k_total)), 1)\n      hi = min(start + int(np.ceil(band[1] * k_total)), d_all.shape[1])\n      if hi <= lo:  # fallback: use available tail\n          lo = start + 1\n          hi = min(start + 5, d_all.shape[1])\n\
    \      dens = np.median(d_all[:, lo:hi], axis=1).astype(np.float32)  # larger => sparser\n      s = -dens  # higher => denser\n      s_z = _zscore(s)\n\n      # Global budget-preserving quotas\n      f_raw = base_cross + delta * s_z\n      f_cross = _recenter_to_global_budget(f_raw, base_cross, (L, U))\n      # Quota list\n      q_cross_tot = np.rint(f_cross * k_total).astype(int)\n      q_within_tot = k_total - q_cross_tot\n\n      # Neighbor list sizes for per-batch queries\n      B_other = max(n_batches - 1, 1)\n      k_within_max = int(np.ceil((1.0 - L) * k_total))\n      k_cross_per_max = int(np.ceil(U * k_total / B_other))\n      k_max = max(k_within_max, k_cross_per_max) + 1  # +1 to skip self\n\n      # Fit per-batch neighbor models\n      cat_to_code = {c: i for i, c in enumerate(cats)}\n      batch_codes = np.array([cat_to_code[b] for b in batches], dtype=int)\n      nn_models, train_indices = {}, {}\n      for j, c in enumerate(cats):\n          mask = (batches == c)\n   \
    \       train_indices[j] = np.where(mask)[0]\n          nn = NearestNeighbors(n_neighbors=k_max, metric=metric, algorithm='brute')\n          nn.fit(Z[mask])\n          nn_models[j] = nn\n\n      # Query all batches\n      dists, idx_local = {}, {}\n      for j in range(n_batches):\n          d, ii = nn_models[j].kneighbors(Z, return_distance=True)\n          dists[j] = d\n          idx_local[j] = ii\n\n      inbound = np.zeros(n, dtype=np.int32)\n      cap_threshold = int(np.ceil(cap * k_total))\n      rows, cols, dvals = [], [], []\n\n      for i in range(n):\n          bi = batch_codes[i]\n          q_within = int(q_within_tot[i])\n          q_cross_total = int(q_cross_tot[i])\n          other_batches = [j for j in range(n_batches) if j != bi]\n          # even split + remainder to closest batches\n          q_per_other = q_cross_total // B_other\n          rem = q_cross_total - q_per_other * B_other\n          batch_scores = [(j, dists[j][i][0]) for j in other_batches]\n        \
    \  batch_scores.sort(key=lambda t: t[1])\n          q_map = {j: q_per_other for j in other_batches}\n          for k in range(rem):\n              q_map[batch_scores[k % len(other_batches)][0]] += 1\n\n          # Within selection with hard cap + reallocation\n          d_w = dists[bi][i]; ii_w = idx_local[bi][i]\n          start_w = 1 if d_w[0] == 0.0 else 0\n          globals_w = train_indices[bi][ii_w[start_w:]]\n          cand_inbound = inbound[globals_w]\n          cand_dist = d_w[start_w:]\n          order = np.lexsort((cand_dist, cand_inbound))\n          taken = 0\n          for idx in order:\n              g = int(globals_w[idx])\n              if inbound[g] >= cap_threshold:\n                  continue\n              rows.append(i); cols.append(g); dvals.append(float(cand_dist[idx]))\n              inbound[g] += 1\n              taken += 1\n              if taken >= q_within: break\n          if taken < q_within:\n              # fallback: ignore cap to meet degree (rare)\n\
    \              for idx in order:\n                  g = int(globals_w[idx])\n                  if inbound[g] < cap_threshold:  # already tried above\n                      continue\n                  rows.append(i); cols.append(g); dvals.append(float(cand_dist[idx]))\n                  inbound[g] += 1\n                  taken += 1\n                  if taken >= q_within: break\n\n          # Cross selection per batch with hard cap + reallocation\n          for j in other_batches:\n              qj = q_map[j]\n              if qj <= 0: continue\n              d_c = dists[j][i]; ii_c = idx_local[j][i]\n              globals_c = train_indices[j][ii_c]\n              cand_inbound = inbound[globals_c]\n              cand_dist = d_c\n              order = np.lexsort((cand_dist, cand_inbound))\n              taken = 0\n              for idx in order:\n                  g = int(globals_c[idx])\n                  if inbound[g] >= cap_threshold:\n                      continue\n              \
    \    rows.append(i); cols.append(g); dvals.append(float(cand_dist[idx]))\n                  inbound[g] += 1\n                  taken += 1\n                  if taken >= qj: break\n              if taken < qj:\n                  for idx in order:\n                      g = int(globals_c[idx])\n                      if inbound[g] < cap_threshold:\n                          continue\n                      rows.append(i); cols.append(g); dvals.append(float(cand_dist[idx]))\n                      inbound[g] += 1\n                      taken += 1\n                      if taken >= qj: break\n\n      A_sym, D_sym = _symmetrize_binary_with_distances(\n          np.asarray(rows, dtype=np.int32),\n          np.asarray(cols, dtype=np.int32),\n          np.asarray(dvals, dtype=np.float32),\n          n\n      )\n      return A_sym.tocsr().astype(np.float32), D_sym.tocsr().astype(np.float32)\n```\n\n`/execute_action{submit 1}`\n\n```yaml\ntitle: \"EtC–BRBG(λ=0.7) + Parameter‑Lean Density‑Adaptive\
    \ BBSG (global budget preserved)\"\ntags: \"bbsg, balanced-graph, density-adaptive, global-budget, residualization\"\nabstract: \"Scale-free density proxy from banded all-batch kNN distances in Zcorr (30–60% of k_total), z-scored per cell. Cross-batch quotas f_cross = base + δ·z are recentered by a constant so the global budget equals base (then clipped to [0.60,0.90]). Single-pass column balancing with hard inbound caps; binary edges with true distances. BRBG unchanged (λ=0.7, γ_max=0.74, PCA50). Hypothesis: match or exceed k_density=20 (EID 609=0.7452) with fewer knobs and better generality.\"\ncontent: |\n  import sys\n  sys.path.append('storage')\n\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n\n  from praxis.bbsg_density_lean import build_density_lean_bbsg\n\n  def _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n\
    \      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def _pca_array(X, n_comps=50, random_state=0):\n      Xd = X.A if sp.issparse(X) else X\n      ad_tmp = ad.AnnData(Xd)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca']\n\n  def _one_hot_batches(batches: np.ndarray):\n      cats = np.unique(batches)\n      n = batches.shape[0]\n      B = np.zeros((n, cats.size), dtype=float)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B\n\n  def _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      # Config\n      n_pcs_emb = 60\n      n_pcs_graph = 50\n      l2 = 1e-3\n      gamma_max = 0.74\n      lam = 0.7\n\
    \      k_total = 48\n      metric = 'cosine'\n      delta = 0.15\n      bounds = (0.60, 0.90)\n      band = (0.30, 0.60)\n      alpha_var = 0.5\n      emb_n_neighbors = 15\n\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n      # Normalize + HVGs\n      _normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      # EtC embedding (analysis/QC only)\n      Xh = adata.X[:, hv]\n      Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n      var_g = Xd.var(axis=0, ddof=1) + 1e-8\n      wv = np.power(var_g, -0.5 * alpha_var).astype(np.float32)\n      Xw = Xd * wv\n      ad_emb = ad.AnnData(Xw, obs=adata.obs[['batch']].copy())\n      sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n     \
    \ Z_emb = ad_emb.obsm['X_pca']\n      ad_pc = ad.AnnData(Z_emb.copy(), obs=adata.obs[['batch']].copy())\n      sc.pp.combat(ad_pc, key='batch')\n      adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n      # Graph: PCA50 → adaptive residualization → Zcorr\n      Zg = _pca_array(Xd, n_comps=n_pcs_graph, random_state=0)\n      B = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      gamma = np.minimum(gamma_max, lam * R2)\n      Zcorr = Zg - (Zhat * gamma)\n\n      # Parameter-lean density-adaptive BBSG with strict budget + balancing\n      Cg, Dg = build_density_lean_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                       k_total=k_total, metric=metric,\n    \
    \                                   delta=delta, f_bounds=bounds, band=band,\n                                       cap=2.0, rng_seed=0)\n      adata.obsp['connectivities'] = Cg\n      adata.obsp['distances'] = Dg\n      return adata\n```"
