parts:
- text: "I have successfully completed the first \"Auto-λ v2\" validation run (ID 829), with `target_s=0.04` and `delta=0.10`. It achieved a score of **0.7360**, which exactly matches Praxis II's reference run (EID 823) and is my new personal best score. This confirms successful module parity.\n\nNow I will proceed with the next experiment in the \"Auto-λ v2 (mean-target)\" sweep, as requested by Praxis II. This run will use `target_s = 0.04` and `delta = 0.15`, keeping `kd=20` and `k=48` fixed.\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Sophia III: DAQB Validation - Auto-Lambda v2 (target_s=0.04, delta=0.15)\"\ntags: \"daqb, validation, auto-lambda, praxis-ii, human-heart\"\nabstract: |\n  Continuing DAQB validation for Praxis II on the Human Heart dataset, focusing on the \"Auto-lambda v2 (mean-target)\" method. This experiment sets `target_s = 0.04` and `delta = 0.15`, with `k_density=20` and `k_total=48`. The pipeline integrates adaptive lambda selection based on the mean shrinkage\
    \ ratio for BRBG. Objective is to evaluate the effect of these parameters on batch integration performance.\ncontent: |\n  import sys\n  import numpy as np\n  import anndata as ad\n  import scanpy as sc\n  from scipy.sparse import issparse\n  from sklearn.neighbors import NearestNeighbors\n\n  # --- Utilities from daqb_recommended.py ---\n  def _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def _pca_array(X, n_comps=50, random_state=0):\n      Xd = X.A if issparse(X) else X\n      ad_tmp = ad.AnnData(Xd)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca']\n\n  def _one_hot_batches(batches: np.ndarray):\n      cats = np.unique(batches)\n      n = batches.shape[0]\n      B = np.zeros((n, cats.size), dtype=float)\n\
    \      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B\n\n  def _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n\n  # --- _symmetrize_binary_with_distances (from praxis/bbsg_density_adaptive.py) ---\n  def _symmetrize_binary_with_distances(rows, cols, dists, n):\n      rows = np.asarray(rows)\n      cols = np.asarray(cols)\n      dists = np.asarray(dists)\n\n      A = sp.coo_matrix((np.ones(len(rows), dtype=np.float32), (rows, cols)), shape=(n, n)).tocsr()\n      D = sp.coo_matrix((dists.astype(np.float32), (rows, cols)), shape=(n, n)).tocsr()\n      A = A.maximum(A.T)\n      D = D.maximum(D.T)\n      A.eliminate_zeros()\n      D.eliminate_zeros()\n      return A, D\n\n  # --- build_density_adaptive_bbsg (from praxis/bbsg_density_adaptive.py) ---\n  def build_density_adaptive_bbsg(Zcorr, batches,\
    \ k_total=48, metric='cosine', delta=0.15, k_density=30, rng_seed=0):\n      n = Zcorr.shape[0]\n      cats = np.unique(batches)\n      B_other = max(len(cats) - 1, 1)\n\n      # Local density proxy (k-th NN distance, all batches)\n      nn_all = NearestNeighbors(n_neighbors=k_density + 1, metric=metric, algorithm='brute')\n      nn_all.fit(Zcorr)\n      d_all, idx_all = nn_all.kneighbors(Zcorr, return_distance=True)\n      d_k = d_all[:, -1]\n      d_min, d_max = float(np.min(d_k)), float(np.max(d_k) + 1e-8)\n      d_norm = (d_k - d_min) / (d_max - d_min + 1e-8)        # 0 dense ... 1 sparse\n      inv_dense = 1.0 - d_norm\n      base_cross = (len(cats) - 1) / float(len(cats))        # e.g., 0.75 for 4 batches\n      mix_delta = (inv_dense - 0.5) * 2.0 * float(delta)     # [-delta, +delta]\n      f_cross = np.clip(base_cross + mix_delta, 0.60, 0.90)\n\n      # Pre-build per-batch NN indices and distances\n      max_cross_per = int(np.ceil(0.9 * k_total / B_other))\n      max_within\
    \ = int(np.ceil((1.0 - 0.60) * k_total))\n      rng = np.random.RandomState(rng_seed)\n\n      batch_to_indices = {}\n      nn_models = {}\n      for j, c in enumerate(cats):\n          mask = (batches == c)\n          batch_to_indices[j] = np.where(mask)[0]\n          nn = NearestNeighbors(n_neighbors=max(max_within, max_cross_per) + 1, metric=metric, algorithm='brute')\n          nn.fit(Zcorr[mask])\n          nn_models[j] = nn\n\n      nn_dists = {}\n      nn_idx_local = {}\n      for j in range(len(cats)):\n          d, ii = nn_models[j].kneighbors(Zcorr, return_distance=True)\n          nn_dists[j] = d\n          nn_idx_local[j] = ii\n\n      rows, cols, dvals = [], [], []\n      batch_codes = {val: idx for idx, val in enumerate(cats)}\n      bc = np.array([batch_codes[b] for b in batches], dtype=int)\n\n      for i in range(n):\n          bi = int(bc[i])\n          q_cross_total = int(round(f_cross[i] * k_total))\n          q_within = max(0, min(k_total, int(round(k_total - q_cross_total))))\n\
    \          q_per_other = q_cross_total // B_other\n          rem = q_cross_total - q_per_other * B_other\n\n          # within-batch\n          d_i = nn_dists[bi][i]\n          ii = nn_idx_local[bi][i]\n          start = 1 if d_i[0] == 0.0 else 0\n          sel = min(q_within, d_i.shape[0] - start)\n          if sel > 0:\n              cols.extend(batch_to_indices[bi][ii[start:start + sel]])\n              rows.extend([i] * sel)\n              dvals.extend(d_i[start:start + sel])\n\n          # other-batch allocation (distribute remainder to closest batches)\n          other_batches = [j for j in range(len(cats)) if j != bi]\n          batch_scores = [(j, nn_dists[j][i][0]) for j in other_batches]\n          batch_scores.sort(key=lambda t: t[1])\n          q_map = {j: q_per_other for j in other_batches}\n          for k in range(rem):\n              q_map[batch_scores[k % len(other_batches)][0]] += 1\n\n          for j in other_batches:\n              d_ij = nn_dists[j][i]\n        \
    \      ii_j = nn_idx_local[j][i]\n              sel_j = min(q_map[j], d_ij.shape[0])\n              if sel_j > 0:\n                  cols.extend(batch_to_indices[j][ii_j[:sel_j]])\n                  rows.extend([i] * sel_j)\n                  dvals.extend(d_ij[:sel_j])\n\n      rows = np.asarray(rows, dtype=np.int32)\n      cols = np.asarray(cols, dtype=np.int32)\n      dvals = np.asarray(dvals, dtype=np.float32)\n      \n      A = sp.coo_matrix((np.ones_like(dvals, dtype=np.float32), (rows, cols)), shape=(n, n)).tocsr()\n      D = sp.coo_matrix((dvals.astype(np.float32), (rows, cols)), shape=(n, n)).tocsr()\n      A_sym = A.maximum(A.T)\n      D_sym = D.maximum(D.T)\n      A_sym.eliminate_zeros()\n      D_sym.eliminate_zeros()\n      return A_sym.tocsr().astype(np.float32), D_sym.tocsr().astype(np.float32)\n\n  # --- choose_lambda_from_r2_mean (from lam_autoselect2.py) ---\n  def _one_hot_auto_lambda(batches: np.ndarray):\n      cats = np.unique(batches)\n      B = np.zeros((batches.shape[0],\
    \ cats.size), dtype=float)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B\n\n  def _ridge_fit_predict_auto_lambda(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n\n  def r2_per_pc(Z: np.ndarray, batches: np.ndarray, l2: float = 1e-3) -> np.ndarray:\n      B = _one_hot_auto_lambda(batches)\n      Zhat = _ridge_fit_predict_auto_lambda(B, Z, l2=l2)\n      var_total = Z.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      return R2\n\n  def choose_lambda_from_r2_mean(Z: np.ndarray,\n                                 batches: np.ndarray,\n                                 gamma_max: float = 0.74,\n                                 target_s: float = 0.04,\n                                 lam_min: float = 0.2,\n              \
    \                   lam_max: float = 1.0,\n                                 l2: float = 1e-3) -> float:\n      R2 = r2_per_pc(Z, batches, l2=l2)\n      m = float(np.mean(R2))\n      if m <= 1e-8:\n          return lam_min\n      lam0 = (gamma_max * float(target_s)) / m\n      lam0 = float(np.clip(lam0, lam_min, lam_max))\n\n      def mean_ratio(lam_val):\n          g = np.minimum(gamma_max, lam_val * R2)\n          return float(np.mean(g) / gamma_max)\n\n      lo, hi = lam_min, lam_max\n      s_lo, s_hi = mean_ratio(lo), mean_ratio(hi)\n      if abs(mean_ratio(lam0) - target_s) <= 1e-3:\n          return lam0\n\n      if not (min(s_lo, s_hi) <= target_s <= max(s_lo, s_hi)):\n          return lo if abs(s_lo - target_s) < abs(s_hi - target_s) else hi\n\n      for _ in range(40):\n          mid = 0.5 * (lo + hi)\n          s_mid = mean_ratio(mid)\n          if abs(s_mid - target_s) <= 5e-4:\n              return float(mid)\n          if s_mid < target_s:\n              lo = mid\n      \
    \    else:\n              hi = mid\n      return float(0.5 * (lo + hi))\n\n\n  # -------------------- eliminate_batch_effect_fn (adapted from daqb_recommended.py) --------------------\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      print(\"Sophia III: DAQB Validation - Auto-Lambda v2 (target_s=0.04, delta=0.15)\")\n      \n      # Config for this validation run (as per Praxis II's request)\n      n_pcs_emb = 60\n      n_pcs_graph = 50\n      l2 = 1e-3\n      gamma_max = 0.74\n      # Auto-lambda parameters\n      target_s = 0.04 # First sweep parameter\n      lam_min = 0.2\n      lam_max = 1.0\n      k_total = 48\n      metric = 'cosine'\n      alpha_var = 0.5\n      delta = 0.15 # Second sweep parameter\n      k_density = 20 # Fixed k_density\n      rng_seed = 0\n\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n      # Normalize + HVGs\n      _normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata,\
    \ flavor='seurat_v3', batch_key='batch',\n                                  n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      # EtC embedding (QC only) + neighbors\n      Xh = adata.X[:, hv]\n      Xd = (Xh.A if issparse(Xh) else Xh).astype(np.float32, copy=False)\n      var_g = Xd.var(axis=0, ddof=1) + 1e-8\n      wv = np.power(var_g, -0.5 * alpha_var).astype(np.float32)\n      Xw = Xd * wv\n      ad_emb = ad.AnnData(Xw, obs=adata.obs[['batch']].copy())\n      sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=rng_seed)\n      Z_emb = ad_emb.obsm['X_pca']\n      ad_pc = ad.AnnData(Z_emb.copy(), obs=adata.obs[['batch']].copy())\n      sc.pp.combat(ad_pc, key='batch')\n      adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=min(15, k_total), metric=metric)\n\n      # BRBG (PCA50 → batch\
    \ ridge → adaptive shrinkage) to get Zcorr\n      Zg = _pca_array(Xd, n_comps=n_pcs_graph, random_state=rng_seed)\n      \n      # Auto-select lambda (lam)\n      lam = choose_lambda_from_r2_mean(Zg, batches, gamma_max=gamma_max, target_s=target_s, \n                                       lam_min=lam_min, lam_max=lam_max, l2=l2)\n      print(f\"[Auto-Lambda v2] target_s={target_s:.4f} -> selected_lam={lam:.4f}\")\n\n      B = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      gamma = np.minimum(gamma_max, lam * R2)\n      Zcorr = Zg - (Zhat * gamma)\n\n      # DAQB graph via build_density_adaptive_bbsg\n      Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                           k_total=k_total, metric=metric,\n                           \
    \                delta=delta, k_density=k_density, rng_seed=rng_seed)\n      adata.obsp['connectivities'] = Cg\n      adata.obsp['distances'] = Dg\n      return adata\n```"
