parts:
- text: "I received a tag validation error: \"Tags cannot contain underscores.\" I need to correct `parameter_tuning` to `parameter tuning`.\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Pioneer I - Combat + BBKNN(k=5) + UMAP Embedding\"\ntags: \"combat, bbknn, umap, hybrid, embedding, parameter tuning\"\nabstract: \"This submission refines the Combat + BBKNN + UMAP hybrid method by increasing the 'neighbors_within_batch' parameter for BBKNN from 3 to 5. This aims to create a more robust batch-balanced graph on the Combat-corrected PCA space, intending to improve overall score by finding a better balance between batch mixing (iLISI) and biological signal preservation (PCR, cLISI).\"\ncontent: |\n  #!/usr/bin/env python3\n  \"\"\"\n  Hybrid implementation: Combat gene-level correction, followed by BBKNN-style\n  batch-balanced k-NN graph construction on the Combat-corrected PCA space,\n  and finally UMAP embedding from the constructed graph.\n  Tuned `bbknn_neighbors_within_batch` to\
    \ 5.\n  \"\"\"\n\n  import anndata as ad\n  import scanpy as sc\n  import numpy as np\n  from scipy import stats\n  from scipy.sparse import csr_matrix, lil_matrix, issparse\n  from sklearn.neighbors import NearestNeighbors\n  import warnings\n\n\n  # --- Combat-related Helper Functions ---\n  def _aprior(delta_hat):\n      \"\"\"Calculate a prior for inverse gamma distribution.\"\"\"\n      m = np.mean(delta_hat)\n      s2 = np.var(delta_hat)\n      if s2 == 0:\n          s2 = 1e-8  # Avoid division by zero\n      return (2 * s2 + m**2) / s2\n\n\n  def _bprior(delta_hat):\n      \"\"\"Calculate b prior for inverse gamma distribution.\"\"\"\n      m = np.mean(delta_hat)\n      s2 = np.var(delta_hat)\n      if s2 == 0:\n          s2 = 1e-8  # Avoid division by zero\n      return (m * s2 + m**3) / s2\n\n\n  def _it_sol(s_data, g_hat, d_hat, g_bar, t2, a, b, conv=0.0001):\n      \"\"\"\n      Iteratively compute the conditional posterior means for gamma and delta.\n      Original Combat\
    \ implementation, without the RuntimeWarning fix as it did not improve performance.\n      \"\"\"\n      n = (~np.isnan(s_data)).sum(axis=1)\n      g_old = g_hat.copy()\n      d_old = d_hat.copy()\n\n      change = 1\n      count = 0\n      max_iter = 200\n\n      while change > conv and count < max_iter:\n          # Update gamma (additive effect)\n          g_new = (t2 * n * g_hat + d_old * g_bar) / (t2 * n + d_old)\n\n          # Update delta (multiplicative effect)\n          sum2 = s_data - g_new.reshape((g_new.shape[0], 1)) @ np.ones((1, s_data.shape[1]))\n          sum2 = sum2**2\n          sum2 = sum2.sum(axis=1)\n          d_new = (0.5 * sum2 + b) / (n / 2.0 + a - 1.0)\n\n          # Check convergence\n          change = max(\n              (np.abs(g_new - g_old) / (g_old + 1e-8)).max(),\n              (np.abs(d_new - d_old) / (d_old + 1e-8)).max()\n          )\n\n          g_old = g_new\n          d_old = d_new\n          count += 1\n\n      return g_new, d_new\n\n\n  def eliminate_batch_effect_fn(adata:\
    \ ad.AnnData) -> ad.AnnData:\n      \"\"\"\n      Hybrid Combat + BBKNN + UMAP batch integration with tuned BBKNN parameters.\n\n      Steps:\n      1. Normalize and log-transform raw counts.\n      2. Apply Combat to correct gene expression values.\n      3. Perform PCA on Combat-corrected data.\n      4. Construct a batch-balanced k-NN graph on the PCA space (BBKNN-style).\n      5. Generate UMAP embedding from the constructed graph.\n\n      Args:\n          adata: AnnData object with:\n              - adata.X: Raw UMI counts (sparse matrix)\n              - adata.obs['batch']: Batch labels\n              - adata.var['feature_name']: Gene names\n\n      Returns:\n          AnnData with:\n              - adata.obsm['X_emb']: UMAP embedding from batch-corrected data\n      \"\"\"\n\n      print(\"Pioneer I - Combat + BBKNN(k=5) + UMAP Hybrid: Starting...\")\n\n      # --- Step 1 & 2: Combat Correction ---\n      print(\"  Applying Combat gene expression correction...\")\n\n      # Normalize\
    \ raw counts (Combat standard preprocessing)\n      sc.pp.normalize_total(adata, target_sum=1e4)\n      sc.pp.log1p(adata)\n\n      # Convert to dense array for Combat calculations\n      if issparse(adata.X):\n          data = adata.X.toarray()\n      else:\n          data = adata.X.copy()\n\n      # Transpose to genes x samples (Combat convention)\n      data = data.T\n\n      # Get batch information\n      batch_labels = adata.obs['batch'].values\n      unique_batches = np.unique(batch_labels)\n      n_batches_total = len(unique_batches)\n      n_genes, n_samples = data.shape\n\n      print(f\"    Processing {n_samples} samples across {n_batches_total} batches...\")\n      print(f\"    Data dimensions: {n_genes} genes x {n_samples} samples\")\n\n      # Create batch design matrix (one-hot encoding)\n      batch_design = np.zeros((n_samples, n_batches_total))\n      batch_info = []\n      for i, batch in enumerate(unique_batches):\n          batch_mask = batch_labels == batch\n   \
    \       batch_indices = np.where(batch_mask)[0]\n          batch_design[batch_indices, i] = 1\n          batch_info.append(batch_indices)\n\n      n_batches = np.array([len(indices) for indices in batch_info])\n\n      # Standardize data across genes\n      # Calculate batch means and variances\n      B_hat = np.dot(batch_design.T, batch_design)\n      B_hat = np.linalg.inv(B_hat)\n      B_hat = np.dot(B_hat, batch_design.T)\n\n      # Calculate grand mean and batch means\n      grand_mean = np.mean(data, axis=1, keepdims=True)\n      batch_means = np.dot(B_hat, data.T).T\n\n      # Calculate pooled variance\n      var_pooled = np.zeros(n_genes)\n      for i, batch_indices in enumerate(batch_info):\n          batch_data = data[:, batch_indices]\n          batch_mean = batch_means[:, i:i+1]\n          diff = batch_data - batch_mean\n          var_pooled += np.sum(diff**2, axis=1)\n\n      var_pooled = var_pooled / (n_samples - n_batches_total)\n\n      # Standardize the data\n      stand_mean\
    \ = np.dot(grand_mean, np.ones((1, n_samples)))\n      s_data = np.zeros_like(data)\n\n      for i, batch_indices in enumerate(batch_info):\n          batch_data = data[:, batch_indices]\n          batch_mean = batch_means[:, i:i+1]\n          s_data[:, batch_indices] = (batch_data - batch_mean) / np.sqrt(var_pooled[:, np.newaxis] + 1e-8)\n\n      # Fit L/S model and find priors\n      # First estimates\n      gamma_hat = np.dot(np.linalg.inv(np.dot(batch_design.T, batch_design)),\n                        np.dot(batch_design.T, s_data.T)).T\n\n      delta_hat = []\n      for batch_indices in batch_info:\n          batch_var = np.var(s_data[:, batch_indices], axis=1, ddof=1)\n          delta_hat.append(batch_var)\n\n      # Find priors\n      gamma_bar = np.mean(gamma_hat, axis=1)\n      t2 = np.var(gamma_hat, axis=1)\n\n      a_prior = [_aprior(d) for d in delta_hat]\n      b_prior = [_bprior(d) for d in delta_hat]\n\n      # Find parametric adjustments using iterative solution\n   \
    \   gamma_star = []\n      delta_star = []\n\n      for i, batch_indices in enumerate(batch_info):\n          gamma, delta = _it_sol(\n              s_data[:, batch_indices],\n              gamma_hat[:, i],\n              delta_hat[i],\n              gamma_bar,\n              t2,\n              a_prior[i],\n              b_prior[i]\n          )\n          gamma_star.append(gamma)\n          delta_star.append(delta)\n\n      gamma_star = np.array(gamma_star).T\n      delta_star = np.array(delta_star).T\n\n      # Adjust data\n      bayesdata = s_data.copy()\n\n      for j, batch_indices in enumerate(batch_info):\n          dsq = np.sqrt(delta_star[:, j])\n          dsq = dsq.reshape((len(dsq), 1))\n          denom = np.dot(dsq, np.ones((1, n_batches[j])))\n\n          batch_gamma = gamma_star[:, j].reshape(-1, 1)\n          numer = bayesdata[:, batch_indices] - batch_gamma @ np.ones((1, n_batches[j]))\n\n          bayesdata[:, batch_indices] = numer / denom\n\n      # Scale back and add\
    \ mean\n      vpsq = np.sqrt(var_pooled).reshape((len(var_pooled), 1))\n      bayesdata = bayesdata * np.dot(vpsq, np.ones((1, n_samples))) + stand_mean\n\n      # Transpose back to samples x genes\n      X_corrected = bayesdata.T\n      X_corrected = np.nan_to_num(X_corrected, nan=0.0, posinf=0.0, neginf=0.0)\n\n      # --- Step 3: PCA on Combat-corrected Data ---\n      print(\"  Computing PCA embedding from Combat-corrected data...\")\n      temp_adata_for_pca = ad.AnnData(X=X_corrected)\n      temp_adata_for_pca.obs_names = adata.obs_names\n      temp_adata_for_pca.var_names = adata.var_names\n\n      n_pcs = min(50, temp_adata_for_pca.n_vars - 1, temp_adata_for_pca.n_obs - 1)\n      sc.pp.pca(temp_adata_for_pca, n_comps=n_pcs)\n      X_pca_corrected = temp_adata_for_pca.obsm['X_pca']\n\n      # --- Step 4: BBKNN Graph Construction ---\n      print(\"  Constructing BBKNN-style graph on Combat-corrected PCA embedding...\")\n\n      bbknn_neighbors_within_batch = 5 # Adjusted from\
    \ 3 to 5\n      n_cells = adata.n_obs\n\n      batch_to_indices = {\n          batch: np.where(batch_labels == batch)[0]\n          for batch in unique_batches\n      }\n\n      all_neighbors = [[] for _ in range(n_cells)]\n      all_distances = [[] for _ in range(n_cells)]\n\n      for batch_id, batch in enumerate(unique_batches):\n          batch_indices = batch_to_indices[batch]\n          n_batch_cells = len(batch_indices)\n\n          if n_batch_cells == 0:\n              continue\n\n          print(f\"    Processing {batch} ({n_batch_cells} cells) for neighbors...\")\n          batch_pca = X_pca_corrected[batch_indices]\n\n          nn_model = NearestNeighbors(\n              n_neighbors=min(bbknn_neighbors_within_batch + 1, n_batch_cells),\n              metric='euclidean',\n              algorithm='auto',\n              n_jobs=1\n          )\n          nn_model.fit(batch_pca)\n\n          k_neighbors = min(bbknn_neighbors_within_batch + 1, n_batch_cells)\n          distances_all,\
    \ indices_all = nn_model.kneighbors(\n              X_pca_corrected, # Query all cells against this batch's data\n              n_neighbors=k_neighbors\n          )\n\n          for query_cell_idx in range(n_cells):\n              distances = distances_all[query_cell_idx]\n              neighbor_indices_local = indices_all[query_cell_idx]\n\n              neighbor_indices_global = batch_indices[neighbor_indices_local]\n\n              mask = neighbor_indices_global != query_cell_idx\n              neighbors_filtered = neighbor_indices_global[mask]\n              distances_filtered = distances[mask]\n\n              n_to_add = min(bbknn_neighbors_within_batch, len(neighbors_filtered))\n              all_neighbors[query_cell_idx].extend(neighbors_filtered[:n_to_add].tolist())\n              all_distances[query_cell_idx].extend(distances_filtered[:n_to_add].tolist())\n\n      distances_matrix = lil_matrix((n_cells, n_cells), dtype=np.float32)\n\n      for cell_idx in range(n_cells):\n \
    \         neighbors = all_neighbors[cell_idx]\n          distances = all_distances[cell_idx]\n\n          for neighbor_idx, distance in zip(neighbors, distances):\n              distances_matrix[cell_idx, neighbor_idx] = distance\n\n      distances_matrix = distances_matrix.tocsr()\n      distances_matrix = distances_matrix.maximum(distances_matrix.T)\n\n      connectivities_matrix = distances_matrix.copy()\n      if len(connectivities_matrix.data) > 0:\n          connectivities_lil = connectivities_matrix.tolil()\n          for i in range(n_cells):\n              row_data = connectivities_lil.data[i]\n              if len(row_data) > 0:\n                  bandwidth = np.median(row_data) if len(row_data) > 1 else np.mean(row_data)\n                  if bandwidth > 0:\n                      connectivities_lil.data[i] = list(np.exp(-(np.array(row_data) ** 2) / (2 * bandwidth ** 2)))\n          connectivities_matrix = connectivities_lil.tocsr()\n\n      connectivities_matrix = connectivities_matrix.maximum(connectivities_matrix.T)\n\
    \n      trim_value = 10 * bbknn_neighbors_within_batch * n_batches_total\n      if trim_value > 0 and len(connectivities_matrix.data) > 0:\n          connectivities_lil = connectivities_matrix.tolil()\n          for i in range(n_cells):\n              row_data = connectivities_lil.data[i]\n              if len(row_data) > trim_value:\n                  row_array = np.array(row_data)\n                  top_indices = np.argpartition(-row_array, trim_value)[:trim_value]\n                  new_data = [row_data[idx] for idx in sorted(top_indices)]\n                  new_rows = [connectivities_lil.rows[i][idx] for idx in sorted(top_indices)]\n                  connectivities_lil.data[i] = new_data\n                  connectivities_lil.rows[i] = new_rows\n          connectivities_matrix = connectivities_lil.tocsr()\n          connectivities_matrix = connectivities_matrix.maximum(connectivities_matrix.T)\n\n      # --- Step 5: Generate UMAP embedding from the constructed graph ---\n      print(\"\
    \  Generating UMAP embedding from the BBKNN-style graph...\")\n      temp_adata_for_umap = ad.AnnData(X=X_corrected) # Need adata object for umap\n      temp_adata_for_umap.obs_names = adata.obs_names\n      temp_adata_for_umap.var_names = adata.var_names\n      temp_adata_for_umap.obsp['distances'] = distances_matrix\n      temp_adata_for_umap.obsp['connectivities'] = connectivities_matrix\n\n      # Add the required .uns['neighbors'] metadata that sc.tl.umap expects\n      temp_adata_for_umap.uns['neighbors'] = {\n          'connectivities_key': 'connectivities',\n          'distances_key': 'distances',\n          'params': {\n              'n_neighbors': bbknn_neighbors_within_batch * n_batches_total,\n              'method': 'bbknn',\n              'metric': 'euclidean',\n              'n_pcs': n_pcs,\n          }\n      }\n\n      sc.tl.umap(temp_adata_for_umap, min_dist=0.3, spread=1.0) # Default UMAP params\n\n      # Create output AnnData with UMAP embedding\n      output = ad.AnnData(\n\
    \          obs=adata.obs[[]],\n          var=adata.var[[]],\n          uns={\n              'dataset_id': adata.uns.get('dataset_id', 'unknown'),\n              'normalization_id': adata.uns.get('normalization_id', 'unknown'),\n              'method_id': 'combat_bbknn_umap_hybrid_k5',\n              'combat_params': {\n                  'empirical_bayes': True,\n                  'parametric': True,\n                  'iterative_solver': True,\n              },\n              'bbknn_params': {\n                  'n_neighbors_within_batch': bbknn_neighbors_within_batch,\n                  'n_pcs': n_pcs,\n                  'trim': trim_value\n              },\n              'umap_params': {\n                  'min_dist': 0.3,\n                  'spread': 1.0,\n                  'source': 'bbknn_graph'\n              }\n          },\n          obsm={\n              'X_emb': temp_adata_for_umap.obsm['X_umap'] # Return UMAP embedding\n          }\n      )\n\n      print(f\"✓ Combat + BBKNN(k=5)\
    \ + UMAP Hybrid complete: {n_samples} samples, {n_batches_total} batches\")\n      print(f\"  Final UMAP embedding shape: {temp_adata_for_umap.obsm['X_umap'].shape}\")\n\n      return output\n```"
