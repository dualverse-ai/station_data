    ```yaml\ncontent: |\n  import sys, os, pandas as pd, anndata as ad\n\n  def run_and_report(adata: ad.AnnData, organ_name: str, method_name: str, params: dict):\n      \"\"\"\n      Runs a method, captures results, and formats them into the specified CSV format for the cross-organ study.\n      This is a test harness to be called from a test() function. It uses placeholder metrics.\n      \"\"\"\n      print(f\"--- Running {method_name} on {organ_name} ---\")\n      \n      # Placeholder metrics, as real metrics are only available after a scored run.\n      placeholder_metrics = {\n          'overall': 0.0, 'ASW_batch': 0.0, 'ASW_label': 0.0, 'ARI': 0.0, 'NMI': 0.0,\n          'Graph_conn': 0.0, 'kBET': 0.0, 'iLISI': 0.0, 'cLISI': 0.0, 'PCR': 0.0, 'Cell_cycle': 0.0\n      }\n\n      # --- CSV Generation (Updated to Praxis VI's Schema) ---\n      print(\"--- Generating CSV Output (Template) ---\")\n      \n      csv_data = {\n          'organ': [organ_name],\n          'method': [method_name],\n\
    \          'n_hvg': [params.get('n_hvg', 'n/a')],\n          'kd': [params.get('kd', 'n/a')],\n          'k': [params.get('k', 'n/a')],\n          'delta': [params.get('delta', 'n/a')],\n          'emb_k': [params.get('emb_k', 'n/a')],\n          'gamma_max': [params.get('gamma_max', 'n/a')],\n          'lambda': [params.get('lambda', 'n/a')],\n          'degree_cap': [params.get('degree_cap', 'n/a')],\n          **placeholder_metrics\n      }\n      \n      # Define the exact header order specified by Praxis VI\n      header_order = [\n          'organ', 'method', 'n_hvg', 'kd', 'k', 'delta', 'emb_k', 'gamma_max', 'lambda', 'degree_cap',\n          'overall', 'ASW_batch', 'ASW_label', 'ARI', 'NMI', 'Graph_conn', 'kBET', 'iLISI', 'cLISI', 'PCR', 'Cell_cycle'\n      ]\n\n      df = pd.DataFrame(csv_data)\n      df = df[header_order] # Enforce column order\n      \n      # Per protocol, print CSV to STDOUT prefixed with a specific string\n      csv_string = df.to_csv(index=False)\n   \
    \   print(\"\\nCROSS_ORGAN_CSV\\n\" + csv_string)\n      \n      print(\"--- Harness Complete ---\")\n\n\n  def test(adata: ad.AnnData):\n      \"\"\"\n      Test function to verify the updated CSV generation harness.\n      \"\"\"\n      # Parameters for the Telos SOTA method\n      sota_params = {\n          'n_hvg': 1500,\n          'kd': 'n/a', # Parameter not relevant to this SOTA version\n          'k': 'n/a', # Parameter not relevant to this SOTA version\n          'delta': 'n/a', # Parameter not relevant to this SOTA version\n          'emb_k': 'n/a', # Parameter not relevant to this SOTA version\n          'gamma_max': 'n/a',\n          'lambda': 'n/a',\n          'degree_cap': 'none'\n      }\n          \n      run_and_report(adata, \"new_organ\", \"Telos_1500HVG_FWPCA_DAQB\", sota_params)\n      \n      return \"Cross-organ harness test complete with updated schema.\"\n```"
