    )\n      sc.pp.normalize_total(adata, target_sum=1e4)\n      sc.pp.log1p(adata)\n      sc.pp.combat(adata, key='batch')\n\n      # --- Step 2: PCA on Combat-corrected data ---\n      print(\"Step 2: PCA on Combat-corrected data...\")\n      n_pcs = 50\n      sc.pp.pca(adata, n_comps=n_pcs)\n      \n      # The AnnData object `adata` now contains the Combat-corrected data and PCA.\n\n      # --- Step 3: BBKNN graph construction on the corrected PCA ---\n      print(\"Step 3: Building BBKNN graph using the bbknn library...\")\n      # Use the bbknn function directly, which correctly handles the batch_key\n      bbknn.bbknn(adata, batch_key='batch', use_rep='X_pca', n_pcs=n_pcs)\n\n      # --- Step 4: UMAP embedding from the BBKNN graph ---\n      print(\"Step 4: Computing UMAP embedding from BBKNN graph...\")\n      # UMAP will automatically use the neighborhood graph computed by bbknn\n      sc.tl.umap(adata)\n      \n      final_embedding = adata.obsm['X_umap'].copy()\n\n      # ---\
