parts:
- text: "My latest submission (ID 1911) failed due to a `SyntaxError: invalid decimal literal` in the `choose_lambda_from_r2_mean` function. This occurred at line 47: `0lam_max: float = 1.0,`. This is a typo; it should be `lam_max` not `0lam_max`.\n\nI will correct this syntax error and resubmit the code.\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Dual-Path: FWPCA + Combat (Corrected) & Auto-lambda v2 Residualization + BBKNN-Inspired Graph - Syntax Fix\"\ntags: \"fwpca, combat, bbknn, dual-path, embedding, graph, auto_lambda, residualization, fix\"\nabstract: |\n  Resubmission to fix a `SyntaxError` in the `choose_lambda_from_r2_mean` function. This version corrects the typo `0lam_max` to `lam_max` in the function signature. The goal is to integrate Adaptive Residualization (Auto-λ v2) into the graph path to boost iLISI and overall performance, following the successful PCR=1.000 fix in the embedding path.\ncontent: |\n  import anndata as ad\n  import scanpy as sc\n  import numpy as\
    \ np\n  from scipy.sparse import csr_matrix, lil_matrix, issparse\n  from sklearn.neighbors import NearestNeighbors\n  import warnings\n\n  def _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy() if issparse(adata.layers['counts']) else adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def _pca_array(X, n_comps: int = 50, random_state: int = 0):\n      Xd = X.A if issparse(X) else X\n      ad_tmp = ad.AnnData(Xd)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca']\n\n  def _one_hot_batches(batches: np.ndarray):\n      cats = np.unique(batches)\n      n = batches.shape[0]\n      B = np.zeros((n, cats.size), dtype=float)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B\n\n  def\
    \ _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n\n  def r2_per_pc(Z: np.ndarray, batches: np.ndarray, l2: float = 1e-3) -> np.ndarray:\n      \"\"\"Variance-explained by batches per PC, R²_j = var(Zhat_j)/var(Z_j).\"\"\"\n      B = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B, Z, l2=l2)\n      var_total = Z.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      return R2\n\n  def choose_lambda_from_r2_mean(Z: np.ndarray,\n                                 batches: np.ndarray,\n                                 gamma_max: float = 0.74,\n                                 target_s: float = 0.04,\n                                 lam_min: float = 0.2,\n                                 lam_max: float = 1.0, # CORRECTED: was '0lam_max'\n\
    \                                 l2: float = 1e-3) -> float:\n      \"\"\"\n      Auto-λ v2: Pick λ to match mean shrinkage ratio to target_s.\n      E[min(γ_max, λ R²)] / γ_max ≈ target_s.\n      \"\"\"\n      R2 = r2_per_pc(Z, batches, l2=l2)\n      m = float(np.mean(R2))\n      if m <= 1e-8:\n          return lam_min\n      lam0 = (gamma_max * float(target_s)) / m\n      lam0 = float(np.clip(lam0, lam_min, lam_max))\n\n      def mean_ratio(lam):\n          g = np.minimum(gamma_max, lam * R2)\n          return float(np.mean(g) / gamma_max)\n\n      lo, hi = lam_min, lam_max\n      s_lo, s_hi = mean_ratio(lo), mean_ratio(hi)\n      if abs(mean_ratio(lam0) - target_s) <= 1e-3:\n          return lam0\n\n      if not (min(s_lo, s_hi) <= target_s <= max(s_lo, s_hi)):\n          return lo if abs(s_lo - target_s) < abs(s_hi - target_s) else hi\n\n      for _ in range(40):\n          mid = 0.5 * (lo + hi)\n          s_mid = mean_ratio(mid)\n          if abs(s_mid - target_s) <= 5e-4:\n  \
    \            return float(mid)\n          if s_mid < target_s:\n              lo = mid\n          else:\n              hi = mid\n      return float(0.5 * (lo + hi))\n\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      \"\"\"\n      Integrate batches in single-cell RNA-seq data using a dual-path approach with FWPCA:\n      1. Embedding path: FWPCA + PCA + Corrected Combat on PCs for adata.obsm['X_emb'].\n      2. Graph path: FWPCA + PCA + Adaptive Residualization + BBKNN-inspired graph.\n          Includes robust preprocessing steps.\n\n      Args:\n          adata: AnnData object with:\n              - adata.X: Raw UMI counts (sparse matrix)\n              - adata.obs['batch']: Batch labels (categorical)\n              - adata.var['batch_hvg']: Boolean mask for batch-aware highly variable genes\n\n      Returns:\n          AnnData with:\n              - adata.obsm['X_emb']: Integrated embedding (2D array)\n              - adata.obsp['connectivities']: Batch-corrected\
    \ graph (sparse CSR matrix)\n              - adata.obsp['distances']: Distance matrix (sparse CSR matrix)\n      \"\"\"\n      print(\"Starting Dual-Path: FWPCA + Combat (Corrected) & Auto-lambda v2 Residualization + BBKNN-Inspired Graph Integration.\")\n\n      # --- Configuration parameters (inspired by SOTA and my tuning) ---\n      n_pcs_emb = 60              # Number of PCA components for embedding path\n      alpha_var_emb = 0.5         # FWPCA strength for embedding path\n      n_pcs_graph = 50            # Number of PCA components for graph path\n      alpha_var_graph = 0.5       # FWPCA strength for graph path\n      neighbors_within_batch = 4  # Number of neighbors for custom BBKNN-inspired graph\n      trim_value_factor = 10      # Factor for graph trimming\n      emb_n_neighbors = 15        # n_neighbors for the embedding path side-effect\n      nn_metric_graph = 'euclidean' # Metric for NearestNeighbors in graph path\n\n      # Adaptive Residualization (Auto-λ v2) parameters\
    \ from SOTA (ID 1876)\n      gamma_max = 0.74\n      target_s = 0.04\n      l2_ridge = 1e-3\n\n\n      # --- Preprocessing: Normalize, Log1p, HVG selection ---\n      print(\"1. Preprocessing: Normalizing, log1p, FORCING HVG recomputation, NO SCALING, zero-variance filter.\")\n      adata_preprocessed = adata.copy()\n      _normalize_log1p_inplace(adata_preprocessed, 1e4)\n\n      # ALWAYS recompute HVGs as per SOTA.\n      sc.pp.highly_variable_genes(adata_preprocessed, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv_mask = adata_preprocessed.var['highly_variable'].to_numpy()\n      print(f\"  {hv_mask.sum()} HVGs selected (recomputed).\")\n\n      adata_hvg = adata_preprocessed[:, hv_mask].copy()\n      \n      # --- Filter out zero-variance genes ---\n      print(\"  Filtering out zero-variance genes...\")\n      Xd_temp_for_variance = adata_hvg.X.A if issparse(adata_hvg.X) else adata_hvg.X\n      gene_variances = Xd_temp_for_variance.var(axis=0)\n\
    \n      non_zero_variance_genes_mask = gene_variances > 1e-8\n      num_zero_variance = (gene_variances <= 1e-8).sum()\n      if num_zero_variance > 0:\n          print(f\"  Found {num_zero_variance} genes with zero or near-zero variance. Filtering them out.\")\n          adata_hvg = adata_hvg[:, non_zero_variance_genes_mask].copy()\n          print(f\"  Remaining genes: {adata_hvg.n_vars}\")\n      else:\n          print(\"  No zero-variance genes found.\")\n\n      batches = np.asarray(adata_hvg.obs['batch'].astype('category').values)\n      unique_batches = np.unique(batches)\n      n_batches_total = len(unique_batches)\n      n_cells = adata_hvg.n_obs\n\n\n      # --- FWPCA (Feature-Weighted PCA) Implementation ---\n      print(\"2. Applying Feature-Weighted PCA (FWPCA)...\")\n      Xd_hvg_dense = adata_hvg.X.A if issparse(adata_hvg.X) else adata_hvg.X\n      Xd_hvg_dense = Xd_hvg_dense.astype(np.float32, copy=False)\n\n      var_g = Xd_hvg_dense.var(axis=0, ddof=1) + 1e-8\n    \
    \  \n      # FWPCA for Embedding Path\n      wv_emb = np.power(var_g, -0.5 * alpha_var_emb).astype(np.float32)\n      Xw_emb = Xd_hvg_dense * wv_emb\n\n      # FWPCA for Graph Path\n      wv_graph = np.power(var_g, -0.5 * alpha_var_graph).astype(np.float32)\n      Xw_graph = Xd_hvg_dense * wv_graph\n\n\n      # --- PATH 1: Generate Embedding (adata.obsm['X_emb']) ---\n      print(\"3. Generating Embedding Path (FWPCA -> PCA -> Combat on PCs - Corrected Application)...\")\n      ad_emb_pca = ad.AnnData(Xw_emb, obs=adata_hvg.obs[['batch']].copy())\n      sc.pp.pca(ad_emb_pca, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n      \n      # Apply Combat on PCA components using the corrected method (from ID 1908)\n      ad_pcs_temp = ad.AnnData(\n          X=ad_emb_pca.obsm['X_pca'].copy(),\n          obs=ad_emb_pca.obs.copy()\n      )\n      sc.pp.combat(ad_pcs_temp, key='batch')\n      adata.obsm['X_emb'] = np.asarray(ad_pcs_temp.X, dtype=np.float32) \n      \n      # Crucial side-effect:\
    \ Also run sc.pp.neighbors from the embedding (as observed in SOTA)\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric='cosine')\n\n\n      # --- PATH 2: Generate Graph (adata.obsp['connectivities'], adata.obsp['distances']) ---\n      print(\"4. Generating Graph Path (FWPCA -> PCA -> Adaptive Residualization + BBKNN-inspired graph)...\")\n      Zg = _pca_array(Xw_graph, n_comps=n_pcs_graph, random_state=0)\n\n      # --- Adaptive Residualization (Auto-λ v2) ---\n      print(\"  Applying Adaptive Residualization (Auto-λ v2)...\")\n      lam_auto = choose_lambda_from_r2_mean(Zg, batches, gamma_max=gamma_max, target_s=target_s, l2=l2_ridge)\n      \n      B = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2_ridge)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      gamma = np.minimum(gamma_max, lam_auto * R2)\n\
    \      Zcorr_for_graph = Zg - (Zhat * gamma)\n      print(f\"  Auto-λ chosen: {lam_auto:.4f}, mean R2: {np.mean(R2):.4f}, mean gamma: {np.mean(gamma):.4f}\")\n\n\n      # --- Custom BBKNN-inspired graph construction (using Zcorr_for_graph) ---\n      print(f\"  Finding neighbors within each batch for all cells (k={neighbors_within_batch}, metric='{nn_metric_graph}')...\")\n\n      batch_to_indices = {\n          batch: np.where(batches == batch)[0]\n          for batch in unique_batches\n      }\n\n      all_neighbors_global_idx = [[] for _ in range(n_cells)]\n      all_distances = [[] for _ in range(n_cells)]\n\n      # IMPORTANT: Use Zcorr_for_graph for neighbor search\n      for batch_label in unique_batches:\n          batch_global_indices = batch_to_indices[batch_label]\n          n_current_batch_cells = len(batch_global_indices)\n\n          if n_current_batch_cells == 0:\n              continue\n\n          # Get PCA data for cells belonging to this specific batch (from residualized\
    \ data)\n          batch_pca_data = Zcorr_for_graph[batch_global_indices]\n\n          k_neighbors_to_find = min(neighbors_within_batch + 1, n_current_batch_cells)\n          nn_model = NearestNeighbors(n_neighbors=k_neighbors_to_find, metric=nn_metric_graph, n_jobs=1)\n          nn_model.fit(batch_pca_data)\n\n          distances_from_batch, indices_in_batch = nn_model.kneighbors(Zcorr_for_graph) # Query *all* cells against this batch (from residualized data)\n\n          for query_cell_idx in range(n_cells):\n              current_distances = distances_from_batch[query_cell_idx]\n              current_indices_local_to_batch = indices_in_batch[query_cell_idx]\n              neighbors_global = batch_global_indices[current_indices_local_to_batch]\n              \n              combined = sorted(zip(current_distances, neighbors_global), key=lambda x: x[0])\n              \n              added_count = 0\n              for dist, n_idx in combined:\n                  if added_count >= neighbors_within_batch:\n\
    \                      break\n                  if n_idx != query_cell_idx: # Ensure not adding self\n                      all_distances[query_cell_idx].append(dist)\n                      all_neighbors_global_idx[query_cell_idx].append(n_idx)\n                      added_count += 1\n                      \n      # Create sparse connectivities and distances matrices\n      print(\"  Creating connectivity and distance matrices...\")\n      distances_matrix = lil_matrix((n_cells, n_cells), dtype=np.float32)\n\n      for cell_idx in range(n_cells):\n          for neighbor_idx, dist in zip(all_neighbors_global_idx[cell_idx], all_distances[cell_idx]):\n              distances_matrix[cell_idx, neighbor_idx] = dist\n\n      distances_matrix = distances_matrix.tocsr()\n      distances_matrix = distances_matrix.maximum(distances_matrix.T) # Symmetrize\n\n      # Create connectivity matrix using Gaussian kernel weighting\n      connectivities_matrix = distances_matrix.copy()\n      if connectivities_matrix.nnz\
    \ > 0:\n          connectivities_lil = connectivities_matrix.tolil()\n          for i in range(n_cells):\n              row_data = connectivities_lil.data[i]\n              if len(row_data) > 0:\n                  bandwidth = np.median(row_data) if len(row_data) > 1 else np.mean(row_data)\n                  if bandwidth > 0:\n                      connectivities_lil.data[i] = list(np.exp(-(np.array(row_data) ** 2) / (2 * bandwidth ** 2)))\n                  else:\n                      connectivities_lil.data[i] = [1.0] * len(row_data)\n          connectivities_matrix = connectivities_lil.tocsr()\n          connectivities_matrix.eliminate_zeros()\n      connectivities_matrix = connectivities_matrix.maximum(connectivities_matrix.T) # Symmetrize again\n\n      # Trim connections to keep only the strongest\n      trim_value = trim_value_factor * neighbors_within_batch * n_batches_total\n      if trim_value > 0 and connectivities_matrix.nnz > 0:\n          print(f\"  Trimming graph to {trim_value}\
    \ strongest connections per cell...\")\n          connectivities_lil = connectivities_matrix.tolil()\n          for i in range(n_cells):\n              row_data = connectivities_lil.data[i]\n              if len(row_data) > trim_value:\n                  row_array = np.array(row_data)\n                  top_indices = np.argpartition(-row_array, trim_value)[:trim_value]\n                  new_data = [row_data[idx] for idx in sorted(top_indices)]\n                  new_rows = [connectivities_lil.rows[i][idx] for idx in sorted(top_indices)]\n                  connectivities_lil.data[i] = new_data\n                  connectivities_lil.rows[i] = new_rows\n          connectivities_matrix = connectivities_lil.tocsr()\n          connectivities_matrix.eliminate_zeros()\n          connectivities_matrix = connectivities_matrix.maximum(connectivities_matrix.T) # Symmetrize again\n\n      adata.obsp['connectivities'] = connectivities_matrix.astype(np.float32)\n      adata.obsp['distances'] = distances_matrix.astype(np.float32)\n\
    \      \n      # Clean up temporary data\n      del adata_preprocessed\n      del adata_hvg\n\n      print(\"✓ Dual-Path Integration Complete.\")\n      return adata\n```"
