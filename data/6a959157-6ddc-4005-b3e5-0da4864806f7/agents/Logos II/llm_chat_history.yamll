    \ | 0.7256 | 0.736 | 0.837 | 0.165 | 0.091 | 0.972 | 0.698 | 1.000 | 0.972 | 0.935 | 0.852 |\n| 222 | 1 | Aether-Praxis Dual BRBG (Adaptive Residualization + Whitening) | Aether I | 130 | 0.7256 | 0.732 | 0.844 | 0.153 | 0.054 | 0.972 | 0.694 | 1.000 | 0.970 | 0.938 | 0.899 |\n| 185 | 1 | BRBG-Dual-AdaptPC: gamma_max=0.74, lam=0.9 (conservative per-PC adaptive residualization) | Praxis I | 106 | 0.7209 | 0.732 | 0.703 | 0.217 | 0.302 | 0.972 | 0.694 | 1.000 | 0.970 | 0.938 | 0.679 |\n| 195 | 1 | BRBG-Dual-AdaptPC-SoftQuota: τ=0.05 (adaptive residualized PCs + soft balanced kNN) | Praxis I | 112 | 0.7199 | 0.732 | 0.703 | 0.217 | 0.294 | 0.972 | 0.694 | 1.000 | 0.970 | 0.938 | 0.678 |\n\nPage 1 of 24 (sorted by: score)\n\n(Use `/execute_action{page N}` to navigate pages 1-24, `/execute_action{rank mode}` to change sort order, `/execute_action{page_size N}` to set page size, `/execute_action{filter tag}` to filter by tag.)\n\n**Read Contents:**\n\n**praxis/brbg_common.py:**\n```\nimport\
    \ numpy as np\nimport scanpy as sc\nimport anndata as ad\nfrom scipy import sparse as sp\nfrom sklearn.decomposition import TruncatedSVD\nfrom sklearn.neighbors import NearestNeighbors\nfrom scipy.sparse import coo_matrix\n\ndef _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n    if 'counts' in adata.layers:\n        adata.X = adata.layers['counts'].copy()\n    sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n    sc.pp.log1p(adata)\n\ndef _pca_truncated_svd(X, n_comps=50, random_state=0):\n    n_comps = max(2, min(n_comps, X.shape[1]-1 if X.shape[1] > 1 else 2))\n    svd = TruncatedSVD(n_components=n_comps, n_iter=7, random_state=random_state)\n    Z = svd.fit_transform(X)\n    return Z\n\ndef _one_hot_batches(batches):\n    cats = np.asarray(batches)\n    uniq = np.unique(cats)\n    n = cats.shape[0]\n    B = np.zeros((n, uniq.shape[0]), dtype=np.float64)\n    col = {u:i for i,u in enumerate(uniq)}\n    for i, b in enumerate(cats):\n        B[i,\
    \ col[b]] = 1.0\n    return B, uniq\n\ndef _ridge_batch_fit_predict(B, Z, l2=1e-3):\n    K = B.shape[1]\n    BtB = B.T @ B + l2 * np.eye(K)\n    W = np.linalg.solve(BtB, B.T @ Z)   # (K x d)\n    Zhat = B @ W                        # (n x d)\n    # per-PC R^2\n    Zc = Z - Z.mean(axis=0, keepdims=True)\n    SSE = np.sum((Z - Zhat)**2, axis=0) + 1e-12\n    SST = np.sum(Zc**2, axis=0) + 1e-12\n    R2 = 1.0 - (SSE / SST)\n    return Zhat, np.clip(R2, 0.0, 1.0)\n\n# Existing equal-quotas (ceil) builder (kept for compatibility)\ndef _build_balanced_knn_equal(Z, batches, k_total=48, metric='cosine'):\n    Z = np.asarray(Z, dtype=np.float32)\n    batches = np.asarray(batches)\n    uniq = np.unique(batches)\n    n = Z.shape[0]\n    per_batch = int(np.ceil(k_total / max(1, uniq.shape[0])))\n\n    pairs_min_dist = {}\n\n    for b in uniq:\n        idx_train = np.where(batches == b)[0]\n        if idx_train.size == 0:\n            continue\n        k = min(per_batch + 1, idx_train.size)  # +1 for\
    \ potential self\n        nn = NearestNeighbors(n_neighbors=k, metric=metric, algorithm='auto')\n        nn.fit(Z[idx_train])\n        dists, inds = nn.kneighbors(Z, n_neighbors=k, return_distance=True)\n        neigh_global = idx_train[inds]\n        for i in range(n):\n            g = neigh_global[i]\n            di = dists[i]\n            mask = g != i\n            g = g[mask][:per_batch]\n            di = di[mask][:per_batch]\n            for j, d in zip(g, di):\n                if i == j: continue\n                a, c = (i, j) if i < j else (j, i)\n                prev = pairs_min_dist.get((a, c))\n                if (prev is None) or (d < prev):\n                    pairs_min_dist[(a, c)] = float(d)\n\n    if not pairs_min_dist:\n        return None, None\n\n    rows, cols, dist_data = [], [], []\n    for (i, j), d in pairs_min_dist.items():\n        rows += [i, j]; cols += [j, i]; dist_data += [d, d]\n    D = coo_matrix((dist_data, (rows, cols)), shape=(n, n)).tocsr()\n    C\
    \ = D.copy(); C.data[:] = 1.0\n    return C, D\n\n# Existing min-quota + global fill (kept)\ndef _build_balanced_knn_minq(Z, batches, k_total=48, min_per_batch=2, metric='cosine'):\n    Z = np.asarray(Z, dtype=np.float32)\n    batches = np.asarray(batches)\n    uniq = np.unique(batches)\n    n = Z.shape[0]\n\n    pairs_min_dist = {}\n    for b in uniq:\n        idx_train = np.where(batches == b)[0]\n        if idx_train.size == 0:\n            continue\n        k = min(min_per_batch + 1, idx_train.size)\n        nn = NearestNeighbors(n_neighbors=k, metric=metric, algorithm='auto')\n        nn.fit(Z[idx_train])\n        dists, inds = nn.kneighbors(Z, n_neighbors=k, return_distance=True)\n        neigh_global = idx_train[inds]\n        for i in range(n):\n            g = neigh_global[i]\n            di = dists[i]\n            mask = g != i\n            g = g[mask][:min_per_batch]\n            di = di[mask][:min_per_batch]\n            for j, d in zip(g, di):\n                if i == j:\
    \ continue\n                a, c = (i, j) if i < j else (j, i)\n                prev = pairs_min_dist.get((a, c))\n                if (prev is None) or (d < prev):\n                    pairs_min_dist[(a, c)] = float(d)\n\n    fill_each = max(0, k_total - int(min_per_batch * uniq.shape[0]))\n    if fill_each > 0:\n        nn = NearestNeighbors(n_neighbors=min(fill_each + 1, n), metric=metric, algorithm='auto')\n        nn.fit(Z)\n        dists, inds = nn.kneighbors(Z, n_neighbors=min(fill_each + 1, n), return_distance=True)\n        for i in range(n):\n            g = inds[i]\n            di = dists[i]\n            mask = g != i\n            g = g[mask][:fill_each]\n            di = di[mask][:fill_each]\n            for j, d in zip(g, di):\n                if i == j: continue\n                a, c = (i, j) if i < j else (j, i)\n                prev = pairs_min_dist.get((a, c))\n                if (prev is None) or (d < prev):\n                    pairs_min_dist[(a, c)] = float(d)\n\n\
    \    if not pairs_min_dist:\n        return None, None\n\n    rows, cols, dist_data = [], [], []\n    for (i, j), d in pairs_min_dist.items():\n        rows += [i, j]; cols += [j, i]; dist_data += [d, d]\n    D = coo_matrix((dist_data, (rows, cols)), shape=(n, n)).tocsr()\n    C = D.copy(); C.data[:] = 1.0\n    return C, D\n\n# New: exact balanced quotas (q per batch + r extras per node), rotating extras across batches per node\ndef _build_balanced_knn_equal_exact(Z, batches, k_total=48, metric='cosine'):\n    Z = np.asarray(Z, dtype=np.float32)\n    batches = np.asarray(batches)\n    uniq = np.unique(batches)\n    n = Z.shape[0]\n    B = uniq.shape[0]\n    if B == 0 or k_total <= 0:\n        return None, None\n\n    q = k_total // B\n    r = k_total % B\n\n    # Pre-fit per-batch NNs up to max needed neighbors (q + 1 extra + self)\n    pairs_min_dist = {}\n    for bi, b in enumerate(uniq):\n        idx_train = np.where(batches == b)[0]\n        if idx_train.size == 0:\n            continue\n\
    \        kmax = min(q + 1 + 1, idx_train.size)  # q + possible extra + self\n        nn = NearestNeighbors(n_neighbors=kmax, metric=metric, algorithm='auto')\n        nn.fit(Z[idx_train])\n        dists, inds = nn.kneighbors(Z, n_neighbors=kmax, return_distance=True)\n        neigh_global = idx_train[inds]\n\n        for i in range(n):\n            # Rotate extras for fairness: r batches get +1 neighbor for node i\n            order = [(bi + i) % B for bi in range(B)]\n            extras = set(order[:r])\n            # select k_b for this batch index\n            k_b = q + (1 if bi in extras else 0)\n\n            g = neigh_global[i]\n            di = dists[i]\n            mask = g != i\n            g = g[mask][:k_b]\n            di = di[mask][:k_b]\n            for j, d in zip(g, di):\n                if i == j: continue\n                a, c = (i, j) if i < j else (j, i)\n                prev = pairs_min_dist.get((a, c))\n                if (prev is None) or (d < prev):\n         \
    \           pairs_min_dist[(a, c)] = float(d)\n\n    if not pairs_min_dist:\n        return None, None\n\n    rows, cols, dist_data = [], [], []\n    for (i, j), d in pairs_min_dist.items():\n        rows += [i, j]; cols += [j, i]; dist_data += [d, d]\n    D = coo_matrix((dist_data, (rows, cols)), shape=(n, n)).tocsr()\n    C = D.copy(); C.data[:] = 1.0\n    return C, D\n\n```\n---\n**praxis/brbg_dual_adapt_embed_whiten.py:**\n```\nimport numpy as np\nimport scanpy as sc\nimport anndata as ad\nfrom scipy import sparse as sp\n\nfrom praxis.brbg_common import (\n    _normalize_log1p_inplace, _pca_truncated_svd,\n    _one_hot_batches, _ridge_batch_fit_predict,\n    _build_balanced_knn_equal\n)\n\ndef _ensure_dense_X(adata):\n    if sp.issparse(adata.X):\n        adata.X = adata.X.A\n\ndef _whiten_pcs(adata_emb, key='X_pca', tau=0.95, eps=1e-8):\n    Z = adata_emb.obsm[key]\n    # Scanpy stores eigenvalues in adata.uns['pca']['variance']\n    var = adata_emb.uns.get('pca', {}).get('variance',\
    \ None)\n    if var is None:\n        return Z  # fallback: no whitening available\n    scale = np.sqrt(np.clip(var[:Z.shape[1]], eps, None))\n    Zw = (Z / scale) * float(tau)\n    # recentre to mean 0 just in case\n    Zw -= Zw.mean(axis=0, keepdims=True)\n    return Zw\n\ndef eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n    # Config: identical to EID 185 on graph; embedding = ComBat+PCA64 then whiten (+ tiny shrink)\n    n_pcs_emb = 64\n    n_pcs_graph = 50\n    gamma_max = 0.74\n    lam = 0.9\n    l2 = 1e-3\n    k_total = 48\n    metric = 'cosine'\n    tau_whiten = 0.95\n    random_state = 0\n\n    assert 'batch' in adata.obs.columns\n    assert 'feature_name' in adata.var.columns\n\n    # Normalize and HVGs\n    _normalize_log1p_inplace(adata, target_sum=1e4)\n    sc.pp.highly_variable_genes(adata, n_top_genes=2000, flavor='seurat_v3', batch_key='batch', inplace=True)\n    hvg_mask = np.asarray(adata.var['highly_variable'].values, dtype=bool)\n\n    # Graph view\
    \ (same as EID 185)\n    Xg = adata.X[:, hvg_mask]\n    if not sp.issparse(Xg):\n        Xg = sp.csr_matrix(Xg)\n    Zg = _pca_truncated_svd(Xg, n_comps=n_pcs_graph, random_state=random_state)\n    batches = np.asarray(adata.obs['batch'].astype('category').values)\n    B, _ = _one_hot_batches(batches)\n    Zhat, R2 = _ridge_batch_fit_predict(B, Zg, l2=l2)\n    gamma_vec = np.minimum(gamma_max, lam * R2).astype(np.float32)\n    Zcorr = Zg - Zhat * gamma_vec\n    C, D = _build_balanced_knn_equal(Zcorr, batches, k_total=k_total, metric=metric)\n\n    # Embedding view (ComBat + PCA64) then whiten + tiny shrink\n    adata_emb = adata.copy()\n    _ensure_dense_X(adata_emb)\n    sc.pp.combat(adata_emb, key='batch')\n    adata_emb.var['highly_variable'] = hvg_mask\n    sc.pp.pca(adata_emb, n_comps=n_pcs_emb, use_highly_variable=True, svd_solver='arpack', random_state=random_state)\n    Zemb = _whiten_pcs(adata_emb, key='X_pca', tau=tau_whiten, eps=1e-8)\n\n    # Output\n    adata.obsm['X_emb']\
    \ = Zemb\n    sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=min(15, k_total), metric=metric)\n    if C is not None and D is not None:\n        adata.obsp['connectivities'] = C.tocsr()\n        adata.obsp['distances'] = D.tocsr()\n    adata.uns['brbg_dual_adapt_embed_whiten'] = {\n        'gamma_max': float(gamma_max), 'lambda': float(lam), 'l2': float(l2),\n        'k_total': int(k_total), 'metric': metric,\n        'pcs_graph': int(n_pcs_graph), 'pcs_emb': int(n_pcs_emb),\n        'embed_whiten_tau': float(tau_whiten)\n    }\n    return adata\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again.\
    \ Remember to place each `/execute_action{}` on a new line when executing actions."
