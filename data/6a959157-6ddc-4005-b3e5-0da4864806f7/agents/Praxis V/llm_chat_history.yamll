    \ | 0.339 | 0.117 | 0.248 | 0.360 | 0.706 | 0.627 | 0.858 | 0.990 | 0.015 | 0.680 |\n| 1599 | 1 | RINT Experiment C: RINT + ALC on Normalized Data (Hypothesis Test, v2) | Nous I | 1114 | 0.7422 | 0.769 | 0.664 | 0.238 | 0.295 | 0.992 | 0.726 | 1.000 | 0.973 | 0.951 | 0.815 |\n| 1598 | 1 | RINT Experiment A: RINT + ALC on Raw Counts (v2) | Nous I | 1114 | 0.7039 | 0.566 | 0.662 | 0.208 | 0.364 | 0.992 | 0.652 | 1.000 | 0.968 | 0.955 | 0.671 |\n| 1597 | 1 | RINT Experiment B: ALC on Normalized Data (Failure Replication) | Nous I | 1112 | 0.7195 | 0.741 | 0.674 | 0.239 | 0.337 | 0.975 | 0.719 | 1.000 | 0.971 | 0.958 | 0.582 |\n| 1596 | 1 | RINT Experiment A: RINT + ALC on Raw Counts | Nous I | 1112 | n.a. |  |  |  |  |  |  |  |  |  |  |\n| 1595 | 1 | Density-Adaptive Residualization (Nous-inspired) | Fathom I | 1110 | 0.6273 | 0.640 | 0.660 | 0.222 | 0.360 | 0.875 | 0.705 | 1.000 | 0.992 | 0.033 | 0.788 |\n\nPage 1 of 161 (sorted by: id)\n\n(Use `/execute_action{page N}` to navigate pages\
    \ 1-161, `/execute_action{rank mode}` to change sort order, `/execute_action{page_size N}` to set page size, `/execute_action{filter tag}` to filter by tag.)\n\n**Read Contents:**\n\n**praxis/graphfwpca_ridge.py:**\n```\nimport numpy as np\nimport scipy.sparse as sp\nfrom sklearn.decomposition import TruncatedSVD\nfrom sklearn.neighbors import NearestNeighbors\nimport anndata as ad\n\ndef _to_csr(X):\n    if sp.isspmatrix_csr(X): return X\n    if sp.issparse(X): return X.tocsr()\n    return sp.csr_matrix(X)\n\ndef _row_scale_csr(X, scale):\n    if not sp.issparse(X):\n        return (X.T * scale).T\n    X = _to_csr(X).copy()\n    X.data *= np.repeat(scale, np.diff(X.indptr))\n    return X\n\ndef _normalize_log1p_from_counts(adata):\n    Xc = adata.layers['counts'] if 'counts' in adata.layers else adata.X\n    Xc = _to_csr(Xc).astype(np.float32)\n    lib = np.asarray(Xc.sum(axis=1)).ravel()\n    lib = np.maximum(lib, 1e-9)\n    scale = (1e4 / lib).astype(np.float32)\n    Xn = _row_scale_csr(Xc,\
    \ scale)\n    Xn = Xn.copy()\n    Xn.data = np.log1p(Xn.data)\n    return Xn\n\ndef _pca_truncated(X, n_components=100, random_state=0):\n    n_cells, n_genes = X.shape\n    n_components = int(min(n_components, max(2, min(n_cells - 1, n_genes))))\n    svd = TruncatedSVD(n_components=n_components, random_state=random_state)\n    Z = svd.fit_transform(X)\n    return Z.astype(np.float32)\n\ndef _build_graph_knn(\n    Z, k=50, kd=22, delta=0.12, extra=10, metric=\"euclidean\", mutual_boost=1.10\n):\n    \"\"\"\n    Build kNN with kd-th local scaling^delta and soft reciprocal boost.\n    Returns:\n      - connectivities: weighted CSR (float64), row-normalized\n      - distances: CSR (float64) of ACTUAL raw neighbor distances (NOT scaled)\n    \"\"\"\n    n = Z.shape[0]\n    kq = int(max(k, kd) + extra)\n    nn = NearestNeighbors(n_neighbors=kq + 1, metric=metric)\n    nn.fit(Z)\n    d_all, idx_all = nn.kneighbors(Z, return_distance=True)\n    # Drop self\n    d = d_all[:, 1:]      # RAW distances\n\
    \    idx = idx_all[:, 1:]\n\n    # Local scales from RAW distances\n    kd_pos = int(min(kd, d.shape[1])) - 1\n    sigma = np.maximum(d[:, kd_pos], 1e-12)\n    sigma_i = sigma[:, None]\n    sigma_j = sigma[idx]\n    sigma_ij = 0.5 * (sigma_i + sigma_j)\n\n    # Scaled distances for weighting only\n    scaled = d / (np.power(sigma_ij, delta) + 1e-12)\n    w = 1.0 / (scaled + 1e-12)\n\n    # Keep top-k by weight\n    k_keep = int(min(k, w.shape[1]))\n    part = np.argpartition(-w, kth=k_keep - 1, axis=1)[:, :k_keep]\n    rows = np.repeat(np.arange(n), k_keep)\n    cols = idx[np.arange(n)[:, None], part].ravel()\n    data_w = w[np.arange(n)[:, None], part].ravel()\n    # Use RAW distances for 'distances' matrix (spec requirement)\n    data_d_raw = d[np.arange(n)[:, None], part].ravel()\n\n    # Directional sparse\n    W_dir = sp.coo_matrix((data_w, (rows, cols)), shape=(n, n)).tocsr()\n    D_dir = sp.coo_matrix((data_d_raw, (rows, cols)), shape=(n, n)).tocsr()\n\n    # Symmetrize: union\
    \ max for weights; min for raw distances\n    W_sym = W_dir.maximum(W_dir.T)\n    D_sym = D_dir.minimum(D_dir.T)\n\n    # Soft reciprocal boost\n    mutual = W_dir.minimum(W_dir.T)\n    if mutual_boost != 1.0:\n        W_sym = W_sym + (mutual_boost - 1.0) * mutual\n\n    # Types and row-normalize connectivities\n    W_sym = W_sym.tocsr().astype(np.float64)\n    D_sym = D_sym.tocsr().astype(np.float64)\n    row_sum = np.asarray(W_sym.sum(axis=1)).ravel()\n    row_sum[row_sum == 0.0] = 1.0\n    W_sym = _row_scale_csr(W_sym, 1.0 / row_sum)\n    return W_sym, D_sym\n\ndef integrate_graphfwpca_ridge(\n    adata: ad.AnnData,\n    n_pcs=100,\n    k=50,\n    kd=22,\n    delta=0.12,\n    metric=\"euclidean\",\n    mutual_boost=1.10,\n    seed=0,\n) -> ad.AnnData:\n    \"\"\"\n    Minimal GraphFWPCA ridge-style integration:\n    - Normalize from counts (1e4 + log1p)\n    - PCA (TruncatedSVD) to n_pcs for embedding\n    - kNN with kd-th local scaling^delta; weighted symmetric graph with soft mutual\
    \ boost\n    - Row-normalize connectivities; return connectivities (CSR), distances (CSR), and embedding\n    \"\"\"\n    Xn = _normalize_log1p_from_counts(adata)\n    if ('batch_hvg' in adata.var.columns) and adata.var['batch_hvg'].sum() > 0:\n        Xn = Xn[:, adata.var['batch_hvg'].values.astype(bool)]\n    Z = _pca_truncated(Xn, n_components=n_pcs, random_state=seed)\n    C, D = _build_graph_knn(Z, k=k, kd=kd, delta=delta, metric=metric, mutual_boost=mutual_boost)\n    adata.obsm['X_emb'] = Z.astype(np.float32)\n    adata.obsp['connectivities'] = C\n    adata.obsp['distances'] = D\n    return adata\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help\
    \ lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
