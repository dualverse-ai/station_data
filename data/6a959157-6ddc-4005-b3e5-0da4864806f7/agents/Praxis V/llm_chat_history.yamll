- text: "Identity: Praxis V — Recursive Agent. Location: Token Management Room.\nRecap: Heart closed. PBVE-lite log1p baselines (1742/1743) confirmed failure (iLISI≈0.02, PCR=0.000); archived addendum and froze path. Research inactivity notice received; I will not reopen Heart, but I will fix the earlier storage write (failed due to wrong room) to save the DualNorm new-organ entry template so I can act immediately on release.\n\nActions:\n/execute_action{goto research}\n/execute_action{storage write praxis/new_organ_dualnorm_entry.py}\n```yaml\ncontent: |\n  import numpy as np\n  import scipy.sparse as sp\n  import anndata as ad\n  from sklearn.decomposition import TruncatedSVD\n  import scanpy as sc\n\n  EPS = 1e-12\n\n  # ---- Sparse helpers ----\n  def _to_csr(X):\n      if sp.isspmatrix_csr(X): return X\n      if sp.issparse(X): return X.tocsr()\n      return sp.csr_matrix(X)\n\n  def _row_scale_csr(X, scale):\n      if not sp.issparse(X):\n          return (X.T * scale).T\n      X =\
    \ _to_csr(X).copy()\n      X.data *= np.repeat(scale, np.diff(X.indptr))\n      return X\n\n  # ---- Normalizations ----\n  def _normalize_log1p_from_counts(adata: ad.AnnData):\n      Xc = adata.layers['counts'] if 'counts' in adata.layers else adata.X\n      Xc = _to_csr(Xc).astype(np.float32)\n      lib = np.asarray(Xc.sum(axis=1)).ravel()\n      lib = np.maximum(lib, 1e-9)\n      scale = (1e4 / lib).astype(np.float32)\n      Xn = _row_scale_csr(Xc, scale)\n      Xn = Xn.copy(); Xn.data = np.log1p(Xn.data)\n      return Xn\n\n  def _anscombe_from_counts(adata: ad.AnnData):\n      # y' = 2*sqrt(y + 3/8) applied to raw counts\n      Xc = adata.layers['counts'] if 'counts' in adata.layers else adata.X\n      Xc = _to_csr(Xc).astype(np.float32).copy()\n      Xc.data = 2.0 * np.sqrt(Xc.data + np.float32(0.375))\n      return Xc\n\n  def _select_hvgs(X, adata):\n      if 'batch_hvg' in adata.var.columns:\n          m = adata.var['batch_hvg'].values.astype(bool)\n          if m.any() and\
    \ m.sum() < X.shape[1]:\n              return X[:, m]\n      return X\n\n  # ---- PCA and PBVE-lite ----\n  def _pca_truncated(X, n_components=60, random_state=0):\n      n_cells, n_genes = X.shape\n      n_components = int(min(n_components, max(2, min(n_cells - 1, n_genes))))\n      svd = TruncatedSVD(n_components=n_components, random_state=random_state)\n      Z = svd.fit_transform(X)\n      return Z.astype(np.float32)\n\n  def _pbve_lite_equalize(Z: np.ndarray, batches) -> np.ndarray:\n      b = np.asarray(batches).astype(str)\n      Zc = Z.copy().astype(np.float32)\n      uniq = np.unique(b); p = Z.shape[1]\n      stds = np.zeros((len(uniq), p), dtype=np.float32)\n      for i, ub in enumerate(uniq):\n          idx = (b == ub)\n          stds[i] = Z[idx].std(axis=0).astype(np.float32) if np.any(idx) else 1.0\n      target = np.maximum(stds.mean(axis=0), EPS).astype(np.float32)\n      for i, ub in enumerate(uniq):\n          idx = (b == ub)\n          if np.any(idx):\n            \
    \  sb = np.maximum(stds[i], EPS)\n              Zc[idx] *= (target / sb)[None, :]\n      return Zc\n\n  # ---- Entry function (DualNorm-style template) ----\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      \"\"\"\n      DualNorm-style template for a new organ:\n        - Embedding path: Anscombe normalization of raw counts -> HVG mask -> PCA(60) -> X_emb.\n        - Graph path: log1p normalization -> HVG mask -> sc.pp.scale(zero_center=False)\n                      -> PCA(60) -> PBVE-lite equalization -> scanpy.neighbors (k=50, cosine).\n      Returns both obsm['X_emb'] and obsp['connectivities']/['distances'].\n      \"\"\"\n      # Embedding (Anscombe)\n      Xa = _anscombe_from_counts(adata)\n      Xa = _select_hvgs(Xa, adata)\n      Ze = _pca_truncated(Xa, n_components=60, random_state=0)\n\n      # Graph (log1p + scale + PBVE-lite)\n      Xg = _normalize_log1p_from_counts(adata)\n      Xg = _select_hvgs(Xg, adata)\n      ad_graph = ad.AnnData(X=Xg.toarray(),\
    \ obs=adata.obs.copy())  # 20k x 2k fits in memory\n      sc.pp.scale(ad_graph, zero_center=False, max_value=None)\n      Zg = _pca_truncated(ad_graph.X, n_components=60, random_state=1)\n      Zg_pbve = _pbve_lite_equalize(Zg, ad_graph.obs['batch'].values)\n      ad_nb = ad.AnnData(X=Zg_pbve, obs=ad_graph.obs.copy())\n      sc.pp.neighbors(ad_nb, n_neighbors=50, use_rep=None, metric='cosine')\n\n      # Write outputs\n      adata.obsm['X_emb'] = Ze.astype(np.float32)\n      adata.obsp['connectivities'] = ad_nb.obsp['connectivities'].tocsr().astype(np.float64)\n      adata.obsp['distances'] = ad_nb.obsp['distances'].tocsr().astype(np.float64)\n      adata.uns['neighbors'] = {\n          'connectivities_key': 'connectivities',\n          'distances_key': 'distances',\n          'params': {'n_neighbors': 50, 'method': 'scanpy.neighbors', 'metric': 'cosine'}\n      }\n      return adata\n```"
