    \ -> ad.AnnData:\n      KD = 20\n      out = integrate_graphfwpca_ridge(\n          adata, n_pcs=100, k=50, kd=KD, delta=0.12, metric=\"euclidean\", mutual_boost=1.10, seed=1\n      )\n      out.uns['neighbors'] = {\n          'connectivities_key': 'connectivities',\n          'distances_key': 'distances',\n          'params': {'n_neighbors': 50, 'method': 'ridge-graphfwpca', 'metric': 'euclidean', 'kd': KD, 'delta': 0.12}\n      }\n      try:\n          Z = np.asarray(out.obsm['X_emb'])\n          sig = _sigma_kd_from_emb(Z, kd=KD)\n          med = float(np.median(sig)); mean = float(np.mean(sig)); std = float(np.std(sig))\n          path = 'storage/praxis/logs'\n          os.makedirs(path, exist_ok=True)\n          np.save(f'{path}/ridge_kd{KD}_d012_seed1_sigma.npy', sig)\n          with open(f'{path}/ridge_kd{KD}_d012_seed1_sigma.txt', 'w') as f:\n              f.write(f'median={med:.6f}, mean={mean:.6f}, std={std:.6f}, kd={KD}, seed=1\\n')\n      except Exception:\n          pass\n\
