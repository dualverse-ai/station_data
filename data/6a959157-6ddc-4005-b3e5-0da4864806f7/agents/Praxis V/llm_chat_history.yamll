role: model
parts:
- text: "/execute_action{goto research}\n/execute_action{storage write praxis/eq_adaptive.py}\n```yaml\ncontent: |\n  import numpy as np\n  import scipy.sparse as sp\n  from sklearn.neighbors import NearestNeighbors\n\n  def _build_eq_quota_from_candidates(idx_all, d_all, batches, k):\n      n = idx_all.shape[0]\n      b_arr = np.asarray(batches).astype(str)\n      uniq = np.unique(b_arr)\n      B = len(uniq)\n      b2i = {b: i for i, b in enumerate(uniq)}\n      b_idx = np.vectorize(b2i.get)(b_arr)\n\n      rows, cols, dvals = [], [], []\n      base = k // B\n      rem = k - base * B\n\n      for i in range(n):\n          cand_idx = idx_all[i]\n          cand_dist = d_all[i]\n          q = cand_idx.shape[0]\n          cand_batch = b_idx[cand_idx]\n\n          targets = np.full(B, base, dtype=int)\n          if rem > 0:\n              targets[:rem] += 1  # deterministic split of remainder\n\n          chosen = np.zeros(q, dtype=bool)\n          perb = np.zeros(B, dtype=int)\n          #\
    \ Phase 1: fill quotas greedily by nearest\n          for j in range(q):\n              bj = cand_batch[j]\n              if perb[bj] < targets[bj]:\n                  chosen[j] = True\n                  perb[bj] += 1\n                  if chosen.sum() == k:\n                      break\n          # Phase 2: top-up if still short\n          if chosen.sum() < k:\n              for j in range(q):\n                  if not chosen[j]:\n                      chosen[j] = True\n                      if chosen.sum() == k:\n                          break\n\n          sel = np.flatnonzero(chosen)[:k]\n          rows.extend([i] * sel.size)\n          cols.extend(cand_idx[sel].tolist())\n          dvals.extend(cand_dist[sel].tolist())\n\n      n = idx_all.shape[0]\n      W_dir = sp.csr_matrix((np.ones(len(rows), dtype=np.float64), (rows, cols)), shape=(n, n))\n      D_dir = sp.csr_matrix((np.asarray(dvals, dtype=np.float64), (rows, cols)), shape=(n, n))\n      W = W_dir.maximum(W_dir.T).tocsr().astype(np.float64)\n\
    \      W.data[:] = 1.0\n      D = D_dir.minimum(D_dir.T).tocsr()\n      D = D + D.T.multiply(D == 0)\n      return W, D\n\n  def equal_quota_knn_adaptive_kq(Z, batches, k=50, kq_min=256, kq_max=512, kd=18, metric='cosine'):\n      \"\"\"\n      Adaptive-candidate equal-quota kNN (dense regions get larger candidate pools).\n      This is the original mode used in v6a/v6b.\n      \"\"\"\n      n = Z.shape[0]\n      kq_max = int(min(kq_max, n - 1))\n      kq_min = int(min(max(1, kq_min), kq_max))\n      nn = NearestNeighbors(n_neighbors=kq_max + 1, metric=metric, algorithm='auto')\n      nn.fit(Z)\n      d_all, idx_all = nn.kneighbors(Z, return_distance=True)\n      d_all = d_all[:, 1:]\n      idx_all = idx_all[:, 1:]\n\n      kd_pos = max(1, min(kd, d_all.shape[1])) - 1\n      sigma = d_all[:, kd_pos]\n      dens = 1.0 / (sigma + 1e-12)\n      p25, p75 = np.percentile(dens, [25, 75])\n      span = max(1e-12, p75 - p25)\n      alpha = np.clip((dens - p25) / span, 0.0, 1.0)  # higher density\
    \ -> larger kq\n      kq_i = (kq_min + alpha * (kq_max - kq_min)).astype(int)\n      kq_i = np.clip(kq_i, kq_min, kq_max)\n\n      # Slice per-row to variable candidate sizes\n      rows = np.arange(n)[:, None]\n      idx_var = np.take_along_axis(idx_all, np.minimum(kq_i[:, None], idx_all.shape[1]) - 1, axis=1)\n      # Build per-row views efficiently\n      idx_list, dist_list = [], []\n      for i in range(n):\n          q = int(kq_i[i])\n          idx_list.append(idx_all[i, :q])\n          dist_list.append(d_all[i, :q])\n      # Pad to build arrays (use object lists then select in builder)\n      # Build graph\n      # Convert lists back to arrays of varying length inside builder loop\n      # Reuse builder by passing per-row views\n      # Here we reconstruct arrays for builder\n      maxq = int(kq_max)\n      idx_pad = np.zeros((n, maxq), dtype=int)\n      d_pad = np.zeros((n, maxq), dtype=float)\n      for i in range(n):\n          q = len(idx_list[i])\n          idx_pad[i, :q]\
    \ = idx_list[i]\n          d_pad[i, :q] = dist_list[i]\n      return _build_eq_quota_from_candidates(idx_pad, d_pad, batches, k)\n\n  def equal_quota_knn_adaptive_kq2(Z, batches, k=50, kq_min=256, kq_max=512, kd=22, metric='cosine', favor_sparse=True):\n      \"\"\"\n      Adaptive-candidate equal-quota kNN with selectable mapping:\n      - favor_sparse=True: sparse regions (large sigma_kd) get larger candidate pools (reversed mapping).\n      - favor_sparse=False: dense regions get larger pools (same as equal_quota_knn_adaptive_kq).\n      \"\"\"\n      n = Z.shape[0]\n      kq_max = int(min(kq_max, n - 1))\n      kq_min = int(min(max(1, kq_min), kq_max))\n      nn = NearestNeighbors(n_neighbors=kq_max + 1, metric=metric, algorithm='auto')\n      nn.fit(Z)\n      d_all, idx_all = nn.kneighbors(Z, return_distance=True)\n      d_all = d_all[:, 1:]\n      idx_all = idx_all[:, 1:]\n\n      kd_pos = max(1, min(kd, d_all.shape[1])) - 1\n      sigma = d_all[:, kd_pos]  # larger -> sparser\
    \ region\n\n      if favor_sparse:\n          s25, s75 = np.percentile(sigma, [25, 75])\n          span = max(1e-12, s75 - s25)\n          alpha = np.clip((sigma - s25) / span, 0.0, 1.0)  # larger sigma -> larger kq\n      else:\n          dens = 1.0 / (sigma + 1e-12)\n          p25, p75 = np.percentile(dens, [25, 75])\n          span = max(1e-12, p75 - p25)\n          alpha = np.clip((dens - p25) / span, 0.0, 1.0)  # higher density -> larger kq\n\n      kq_i = (kq_min + alpha * (kq_max - kq_min)).astype(int)\n      kq_i = np.clip(kq_i, kq_min, kq_max)\n\n      # Prepare per-row candidate arrays with variable q\n      maxq = int(kq_max)\n      idx_pad = np.zeros((n, maxq), dtype=int)\n      d_pad = np.zeros((n, maxq), dtype=float)\n      for i in range(n):\n          q = int(kq_i[i])\n          idx_pad[i, :q] = idx_all[i, :q]\n          d_pad[i, :q] = d_all[i, :q]\n\n      return _build_eq_quota_from_candidates(idx_pad, d_pad, batches, k)\n```\n/execute_action{submit 1}\n```yaml\ntitle:\
    \ \"EtC+BRBG‑minimal v6c: Adaptive Candidates favor sparse regions (λ_r=0.64, k=50, kd=22, kq 256→512, cosine)\"\ntags: \"embed-then-correct, residualization, balanced-graph, cosine, adaptive-candidates, quotas\"\nabstract: \"Fix to adaptive-candidate mapping: allocate larger candidate pools to sparse regions (large σ_kd) rather than dense regions. Uses λ_r=0.64, k=50, kd=22, cosine equal‑quota selection; compares against fixed kq=512 and prior adaptive (dense‑favored) runs.\"\ncontent: |\n  import sys, numpy as np\n  import anndata as ad\n  import scanpy as sc\n  sys.path.append('storage/praxis')\n  from integration_utils import normalize_log1p_counts, select_features, pca_svd, ridge_residualize_per_pc, set_neighbors_meta\n  from eq_adaptive import equal_quota_knn_adaptive_kq2\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      # Preprocess + HVGs\n      Xn = normalize_log1p_counts(adata)\n      Xn = select_features(Xn, adata)\n\n      # Embedding (EtC)\n   \
    \   Z_emb = pca_svd(Xn, n_components=60, random_state=0)\n      ad_pca = ad.AnnData(X=Z_emb.copy(), obs=adata.obs[['batch']].copy())\n      sc.pp.combat(ad_pca, key='batch')\n      X_emb = np.asarray(ad_pca.X, dtype=np.float32)\n\n      # Graph (cosine; adaptive candidates favoring sparse)\n      Zg = pca_svd(Xn, n_components=50, random_state=1)\n      Zg_corr = ridge_residualize_per_pc(Zg, adata.obs['batch'].values, lam_r=0.64, l2=1e-3)\n      C, D = equal_quota_knn_adaptive_kq2(\n          Zg_corr, batches=adata.obs['batch'].values,\n          k=50, kq_min=256, kq_max=512, kd=22, metric='cosine', favor_sparse=True\n      )\n\n      adata.obsm['X_emb'] = X_emb\n      adata.obsp['connectivities'] = C\n      adata.obsp['distances'] = D\n      set_neighbors_meta(\n          adata, k=50, method='eq_quota_adaptive_kq_sparse+ridge_resid',\n          metric='cosine', extra={'kq_min': 256, 'kq_max': 512, 'kd': 22, 'lam_r': 0.64}\n      )\n      return adata\n```\n/execute_action{submit 1}\n\
    ```yaml\ntitle: \"EtC+BRBG‑minimal v6d: Adaptive Candidates favor sparse regions (λ_r=0.62, k=50, kd=22, kq 256→512, cosine)\"\ntags: \"embed-then-correct, residualization, balanced-graph, cosine, adaptive-candidates, quotas\"\nabstract: \"Same as v6c but λ_r=0.62 to probe residualization strength under the corrected adaptive-candidate strategy. Tests whether slightly softer residualization balances iLISI and ARI/NMI.\"\ncontent: |\n  import sys, numpy as np\n  import anndata as ad\n  import scanpy as sc\n  sys.path.append('storage/praxis')\n  from integration_utils import normalize_log1p_counts, select_features, pca_svd, ridge_residualize_per_pc, set_neighbors_meta\n  from eq_adaptive import equal_quota_knn_adaptive_kq2\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      Xn = normalize_log1p_counts(adata)\n      Xn = select_features(Xn, adata)\n\n      Z_emb = pca_svd(Xn, n_components=60, random_state=0)\n      ad_pca = ad.AnnData(X=Z_emb.copy(), obs=adata.obs[['batch']].copy())\n\
    \      sc.pp.combat(ad_pca, key='batch')\n      X_emb = np.asarray(ad_pca.X, dtype=np.float32)\n\n      Zg = pca_svd(Xn, n_components=50, random_state=1)\n      Zg_corr = ridge_residualize_per_pc(Zg, adata.obs['batch'].values, lam_r=0.62, l2=1e-3)\n      C, D = equal_quota_knn_adaptive_kq2(\n          Zg_corr, batches=adata.obs['batch'].values,\n          k=50, kq_min=256, kq_max=512, kd=22, metric='cosine', favor_sparse=True\n      )\n\n      adata.obsm['X_emb'] = X_emb\n      adata.obsp['connectivities'] = C\n      adata.obsp['distances'] = D\n      set_neighbors_meta(\n          adata, k=50, method='eq_quota_adaptive_kq_sparse+ridge_resid',\n          metric='cosine', extra={'kq_min': 256, 'kq_max': 512, 'kd': 22, 'lam_r': 0.62}\n      )\n      return adata\n```\n"
