tick: 1163
role: model
parts:
- text: "/execute_action{storage write praxis/ridge_unitvar_entry.py}\n```yaml\ncontent: |\n  import sys\n  import anndata as ad\n  sys.path.append('storage/praxis')\n  from runtime_logging import log_graph_stats\n  from util_neighbors import set_neighbors_meta\n\n  import numpy as np\n  import scipy.sparse as sp\n  from sklearn.decomposition import TruncatedSVD\n  from sklearn.neighbors import NearestNeighbors\n\n  def _to_csr(X):\n      if sp.isspmatrix_csr(X): return X\n      if sp.issparse(X): return X.tocsr()\n      return sp.csr_matrix(X)\n\n  def _row_scale_csr(X, scale):\n      if not sp.issparse(X): return (X.T * scale).T\n      X = _to_csr(X).copy()\n      X.data *= np.repeat(scale, np.diff(X.indptr))\n      return X\n\n  def _normalize_log1p_from_counts(adata):\n      Xc = adata.layers['counts'] if 'counts' in adata.layers else adata.X\n      Xc = _to_csr(Xc).astype(np.float32)\n      lib = np.asarray(Xc.sum(axis=1)).ravel()\n      lib = np.maximum(lib, 1e-9)\n      scale = (1e4\
    \ / lib).astype(np.float32)\n      Xn = _row_scale_csr(Xc, scale)\n      Xn = Xn.copy()\n      Xn.data = np.log1p(Xn.data)\n      return Xn\n\n  def _scale_unit_variance_cols(X):\n      X = _to_csr(X).astype(np.float32)\n      n = X.shape[0]\n      sum_ = np.asarray(X.sum(axis=0)).ravel().astype(np.float64)\n      sumsq_ = np.asarray(X.multiply(X).sum(axis=0)).ravel().astype(np.float64)\n      mean = sum_ / max(1, n)\n      m2 = sumsq_ / max(1, n)\n      var = m2 - mean**2\n      var[var <= 1e-8] = 1.0\n      inv_std = (1.0 / np.sqrt(var)).astype(np.float32)\n      D = sp.diags(inv_std, format='csr')\n      return (X @ D).tocsr()\n\n  def _pca_truncated(X, n_components=100, random_state=0):\n      n_cells, n_genes = X.shape\n      n_components = int(min(n_components, max(2, min(n_cells - 1, n_genes))))\n      svd = TruncatedSVD(n_components=n_components, random_state=random_state)\n      return svd.fit_transform(X).astype(np.float32)\n\n  def _build_knn(Z, k=50, kd=22, delta=0.12, extra=10,\
    \ metric='euclidean'):\n      n = Z.shape[0]\n      kq = int(max(k, kd) + extra)\n      nn = NearestNeighbors(n_neighbors=kq + 1, metric=metric).fit(Z)\n      d_all, idx_all = nn.kneighbors(Z, return_distance=True)\n      d = d_all[:, 1:]; idx = idx_all[:, 1:]\n      kd_pos = int(min(kd, d.shape[1])) - 1\n      sigma = np.maximum(d[:, kd_pos], 1e-12)\n      sigma_ij = 0.5 * (sigma[:, None] + sigma[idx])\n      scaled = d / (np.power(sigma_ij, delta) + 1e-12)\n      w = 1.0 / (scaled + 1e-12)\n      k_keep = int(min(k, w.shape[1]))\n      part = np.argpartition(-w, kth=k_keep - 1, axis=1)[:, :k_keep]\n      rows = np.repeat(np.arange(n), k_keep)\n      cols = idx[np.arange(n)[:, None], part].ravel()\n      data_w = w[np.arange(n)[:, None], part].ravel()\n      data_d = scaled[np.arange(n)[:, None], part].ravel()\n      W_dir = sp.coo_matrix((data_w, (rows, cols)), shape=(n, n)).tocsr()\n      D_dir = sp.coo_matrix((data_d, (rows, cols)), shape=(n, n)).tocsr()\n      W_sym = W_dir.maximum(W_dir.T)\n\
    \      D_sym = D_dir.minimum(D_dir.T)\n      mutual = W_dir.minimum(W_dir.T)\n      W_sym = W_sym + 0.10 * mutual\n      W_sym = W_sym.tocsr().astype(np.float64)\n      D_sym = D_sym.tocsr().astype(np.float64)\n      row_sum = np.asarray(W_sym.sum(axis=1)).ravel(); row_sum[row_sum == 0] = 1.0\n      W_sym = _row_scale_csr(W_sym, 1.0 / row_sum)\n      return W_sym, D_sym\n\n  # Entry\n  DELTA, KD, K, N_PCS, SEED = 0.12, 22, 50, 100, 0\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      Xn = _normalize_log1p_from_counts(adata)\n      if 'batch_hvg' in adata.var.columns and adata.var['batch_hvg'].sum() > 0:\n          Xn = Xn[:, adata.var['batch_hvg'].values.astype(bool)]\n      Xs = _scale_unit_variance_cols(Xn)\n      Z = _pca_truncated(Xs, n_components=N_PCS, random_state=SEED)\n      C, D = _build_knn(Z, k=K, kd=KD, delta=DELTA, extra=10, metric='euclidean')\n      adata.obsm['X_emb'] = Z\n      adata.obsp['connectivities'] = C\n      adata.obsp['distances']\
    \ = D\n      set_neighbors_meta(adata, k=K, method='ridge+unitvar', metric='euclidean', extra={'delta': DELTA, 'kd': KD})\n      log_graph_stats(adata, title=f\"ridge_unitvar delta={DELTA} seed={SEED}\")\n      return adata\n```"
