    - sliced_batch_transport.py\n- softpower_daqb_mpb.py\n- todo_at_maturity.md\n- trimqmap_daqb.py\n- winsor_daqb.py\n\n\n**Read Contents:**\n\n**praxis/mpb_graphfwpca_override.py:**\n```\nimport sys\nimport numpy as np\nimport scanpy as sc\nimport anndata as ad\nfrom scipy import sparse as sp\n\n# Ensure package roots\nsys.path.append('storage')\nsys.path.append('storage/praxis')\n\nfrom praxis_core import normalize_log1p_inplace, pca_array, one_hot_batches, ridge_batch_fit_predict\nfrom bbsg_density_adaptive import build_density_adaptive_bbsg\n\ndef _fw_weight_by_var(Xd: np.ndarray, alpha: float) -> np.ndarray:\n    var_g = Xd.var(axis=0, ddof=1).astype(np.float32) + 1e-8\n    w = np.power(var_g, -0.5 * alpha).astype(np.float32)\n    return Xd * w\n\ndef eliminate_mpb_graphfwpca(adata: ad.AnnData,\n                             alpha_emb: float = 0.5,\n                             n_pcs_emb: int = 60,\n                             emb_n_neighbors: int = 15,\n                          \
    \   alpha_g: float = 0.5,\n                             n_pcs_graph: int = 50,\n                             l2: float = 1e-3,\n                             gamma_max: float = 0.74,\n                             lam_override: float = 0.70,\n                             k_total: int = 48,\n                             kdensity: int = 20,\n                             delta: float = 0.10,\n                             metric: str = 'cosine',\n                             cap: float = 2.0,\n                             rng_seed: int = 0) -> ad.AnnData:\n    assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n    # Normalize + HVGs\n    normalize_log1p_inplace(adata, 1e4)\n    sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n    hv = adata.var['highly_variable'].to_numpy()\n    batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n    # Dense HVGs\n    Xh = adata.X[:, hv]\n    Xd = (Xh.A\
    \ if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n\n    # EtC embedding (QC) + neighbors\n    Xw_emb = _fw_weight_by_var(Xd, alpha=alpha_emb)\n    ad_emb = ad.AnnData(Xw_emb, obs=adata.obs[['batch']].copy())\n    sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n    ad_pc = ad.AnnData(ad_emb.obsm['X_pca'].copy(), obs=adata.obs[['batch']].copy())\n    sc.pp.combat(ad_pc, key='batch')\n    adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n    sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n    # Graph path: GraphFWPCA -> PCA -> BRBG (fixed λ) -> DAQB\n    Xw_graph = _fw_weight_by_var(Xd, alpha=alpha_g)\n    Zg = pca_array(Xw_graph, n_comps=n_pcs_graph, random_state=0)\n\n    B = one_hot_batches(batches)\n    Zhat = ridge_batch_fit_predict(B, Zg, l2=l2)\n    var_total = Zg.var(axis=0, ddof=1) + 1e-8\n    var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n    R2 = np.clip(var_pred / var_total, 0.0,\
    \ 1.0)\n\n    lam = float(lam_override)\n    gamma = np.minimum(gamma_max, lam * R2).astype(np.float32)\n    Zcorr = Zg - (Zhat * gamma)\n\n    # Call DAQB with cap if available (fallback without cap)\n    try:\n        Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                             k_total=k_total, metric=metric,\n                                             delta=delta, k_density=kdensity,\n                                             cap=cap, rng_seed=rng_seed)\n    except TypeError:\n        Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                             k_total=k_total, metric=metric,\n                                             delta=delta, k_density=kdensity,\n                                             rng_seed=rng_seed)\n    adata.obsp['connectivities'] = Cg\n    adata.obsp['distances'] = Dg\n    adata.uns['mpb_graphfwpca_override'] = dict(alpha_g=float(alpha_g),\n\
    \                                                lam_override=float(lam),\n                                                kd=int(kdensity), delta=float(delta),\n                                                cap=float(cap),\n                                                k_total=int(k_total),\n                                                rng_seed=int(rng_seed))\n    return adata\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
