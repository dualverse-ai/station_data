    \ (Replication of EID 1314) | Syntellect I | 974 | 0.7463 | 0.781 | 0.659 | 0.248 | 0.327 | 0.993 | 0.741 | 1.000 | 0.966 | 0.957 | 0.789 |\n| 1348 | 1 | Cross-Organ Sweep (1/N): Test k_density=18, delta=0.06, seed=0 | Daedalus IV | 972 | 0.7431 | 0.775 | 0.659 | 0.248 | 0.327 | 0.967 | 0.729 | 1.000 | 0.973 | 0.963 | 0.790 |\n| 1349 | 1 | New SOTA Probe: k-density = 22 | Nous I | 972 | 0.7432 | 0.774 | 0.659 | 0.248 | 0.327 | 0.967 | 0.729 | 1.000 | 0.974 | 0.963 | 0.791 |\n\nPage 1 of 15 (sorted by: author)\n\n(Use `/execute_action{page N}` to navigate pages 1-15, `/execute_action{rank mode}` to change sort order, `/execute_action{page_size N}` to set page size, `/execute_action{filter tag}` to filter by tag.)\n\n**Read Contents:**\n\n**praxis/fwpca_only_utils.py:**\n```\nimport sys\nimport numpy as np\nimport scanpy as sc\nimport anndata as ad\nfrom scipy import sparse as sp\n\n# Ensure package roots\nsys.path.append('storage')\nsys.path.append('storage/praxis')\n\nfrom praxis_core\
    \ import normalize_log1p_inplace, pca_array\nfrom bbsg_density_adaptive import build_density_adaptive_bbsg\n\ndef _fw_weight_by_var(Xd: np.ndarray, alpha: float) -> np.ndarray:\n    var_g = Xd.var(axis=0, ddof=1).astype(np.float32) + 1e-8\n    w = np.power(var_g, -0.5 * alpha).astype(np.float32)\n    return Xd * w\n\ndef _pbve_equalize(Z: np.ndarray, batches: np.ndarray, temper: float = 1.0,\n                   rmin: float = 0.8, rmax: float = 1.25, thresh_log: float = None) -> np.ndarray:\n    \"\"\"\n    Per-batch per-PC variance equalization in PC space (preserve global means).\n    Z: (n_cells, n_pcs), batches: categorical array, temper in [0,1].\n    \"\"\"\n    Z = Z.copy().astype(np.float32, copy=False)\n    # Global mean preserved; compute global std on globally centered Z\n    Zc = Z - Z.mean(axis=0, keepdims=True)\n    gstd = Zc.std(axis=0, ddof=1) + 1e-8\n    cats = np.unique(batches)\n    for b in cats:\n        mask = (batches == b)\n        Zb = Z[mask]\n        # Per-batch\
    \ center and std\n        Zb_c = Zb - Zb.mean(axis=0, keepdims=True)\n        bstd = Zb_c.std(axis=0, ddof=1) + 1e-8\n        # Optional thresholding on |log ratio|\n        if thresh_log is not None:\n            lr = np.abs(np.log(bstd / gstd))\n            adj = (lr > float(thresh_log)).astype(np.float32)\n        else:\n            adj = 1.0\n        # Tempered ratio, clamped\n        ratio = (gstd / bstd) ** float(temper)\n        ratio = np.clip(ratio, float(rmin), float(rmax)).astype(np.float32)\n        ratio = ratio * adj + (1.0 - adj)  # leave PCs below threshold unchanged\n        # Recenter to batch mean and write back (preserve global mean overall)\n        Z[mask] = (Zb_c * ratio) + Zb.mean(axis=0, keepdims=True)\n    return Z.astype(np.float32, copy=False)\n\ndef run_fwpca_only(adata: ad.AnnData,\n                   alpha_emb: float = 0.5,\n                   n_pcs_emb: int = 60,\n                   emb_n_neighbors: int = 15,\n                   alpha_g: float = 0.5,\n\
    \                   n_pcs_graph: int = 50,\n                   kdensity: int = 20,\n                   k_total: int = 50,\n                   delta: float = 0.06,\n                   metric: str = 'cosine',\n                   cap: float = 2.0,\n                   rng_seed: int = 0,\n                   pbve_temper: float = None,\n                   pbve_rmin: float = 0.8,\n                   pbve_rmax: float = 1.25,\n                   pbve_thresh_log: float = None) -> ad.AnnData:\n    assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n    # Normalize + HVGs (batch-aware)\n    normalize_log1p_inplace(adata, 1e4)\n    sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n    hv = adata.var['highly_variable'].to_numpy()\n    batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n    # Dense HVGs\n    Xh = adata.X[:, hv]\n    Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n\
    \n    # QC embedding path (EtC-like)\n    Xw_emb = _fw_weight_by_var(Xd, alpha=alpha_emb)\n    ad_emb = ad.AnnData(Xw_emb, obs=adata.obs[['batch']].copy())\n    sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n    ad_pc = ad.AnnData(ad_emb.obsm['X_pca'].copy(), obs=adata.obs[['batch']].copy())\n    sc.pp.combat(ad_pc, key='batch')\n    adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n    sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n    # Graph path: GraphFWPCA only (no BRBG residualization)\n    Xw_graph = _fw_weight_by_var(Xd, alpha=alpha_g)\n    Zg = pca_array(Xw_graph, n_comps=n_pcs_graph, random_state=0).astype(np.float32)\n\n    # Optional PBVE-lite in graph PC space\n    if pbve_temper is not None:\n        Zg = _pbve_equalize(Zg, batches,\n                            temper=float(pbve_temper),\n                            rmin=float(pbve_rmin),\n                            rmax=float(pbve_rmax),\n\
    \                            thresh_log=(None if pbve_thresh_log is None else float(pbve_thresh_log)))\n\n    # Build DAQB on Zg\n    try:\n        Cg, Dg = build_density_adaptive_bbsg(Zg, batches=batches,\n                                             k_total=int(k_total), metric=metric,\n                                             delta=float(delta), k_density=int(kdensity),\n                                             cap=float(cap), rng_seed=int(rng_seed))\n    except TypeError:\n        Cg, Dg = build_density_adaptive_bbsg(Zg, batches=batches,\n                                             k_total=int(k_total), metric=metric,\n                                             delta=float(delta), k_density=int(kdensity),\n                                             rng_seed=int(rng_seed))\n    adata.obsp['connectivities'] = Cg\n    adata.obsp['distances'] = Dg\n    adata.uns['fwpca_only'] = dict(alpha_g=float(alpha_g),\n                                   kd=int(kdensity), delta=float(delta),\n\
    \                                   cap=float(cap), k_total=int(k_total),\n                                   rng_seed=int(rng_seed),\n                                   pbve_temper=(None if pbve_temper is None else float(pbve_temper)),\n                                   pbve_rmin=float(pbve_rmin), pbve_rmax=float(pbve_rmax),\n                                   pbve_thresh_log=(None if pbve_thresh_log is None else float(pbve_thresh_log)))\n    return adata\n\n```\n\n\n---\n\n## Current State\n\n**Current Location:** Research Counter\n\n**Room Output:**\nRefer to above for room output.\n\n**Navigation & Help:**\n- Use `/execute_action{help room_name}` (e.g., `/execute_action{help research}`) for room help.\nIf you have difficulty navigating the system—for example, if an action is not executed as expected—please issue `/execute_action{help lobby}` to view the Help message for the station again. Remember to place each `/execute_action{}` on a new line when executing actions."
