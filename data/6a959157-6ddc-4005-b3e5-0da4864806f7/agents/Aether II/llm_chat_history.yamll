parts:
- text: "I am Aether II, currently in the Research Counter. I acknowledge the recurring \"Research Inactivity\" critical notices, which I am actively addressing by preparing and submitting a new experiment.\n\nI have reviewed Praxis II's latest updates (Public Capsule #2, messages #2-13 and #2-14) and retrieved the code for their SOTA (EID 609, 0.7452). My previous `storage read` of `aether_utils.py` indicated that my `_batch_specific_quantile_normalization` (BQN) function was missing. To ensure my research continuity and the correctness of my next experiment, I will first re-upload the complete `aether_utils.py` file, including the `_batch_specific_quantile_normalization` function, to my private storage.\n\nAfter ensuring `aether_utils.py` is correctly updated in storage, I will proceed to submit a new experiment. This experiment will integrate my promising BQN method as a preprocessing step into Praxis II's SOTA pipeline. BQN will be applied to the highly variable gene expression matrix\
    \ after log-normalization and before any PCA or FWPCA weighting in both the embedding and graph paths. This will test if BQN can further enhance the overall performance or improve the balance of metrics in this advanced pipeline.\n\n`/execute_action{storage write Aether/aether_utils.py}`\n```yaml\ncontent: |\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n  from sklearn.decomposition import TruncatedSVD\n  from sklearn.neighbors import NearestNeighbors\n  from scipy.stats import f_oneway\n  from scipy.sparse import coo_matrix\n  import warnings\n  from sklearn.exceptions import ConvergenceWarning\n  from sklearn.linear_model import Ridge # Import Ridge explicitly\n\n  # --- Helper functions (from Sophia I's SOTA or general Scanpy practice) ---\n\n  def _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata,\
    \ target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def _get_hvg_mask(adata: ad.AnnData, n_top_genes: int = 2000):\n      sc.pp.highly_variable_genes(adata, n_top_genes=n_top_genes, flavor='seurat_v3', batch_key='batch', inplace=True)\n      mask = np.asarray(adata.var['highly_variable'].values, dtype=bool)\n      if mask.sum() < 10: # Fallback if too few HVGs are found\n          return np.ones(adata.n_vars, dtype=bool)\n      return mask\n\n  def _pca_truncated_svd(X, n_comps=50, random_state=0):\n      n_comps = max(2, min(n_comps, X.shape[1]-1 if X.shape[1] > 1 else 2))\n      svd = TruncatedSVD(n_components=n_comps, n_iter=7, random_state=random_state)\n      Z = svd.fit_transform(X)\n      return Z\n\n  def _one_hot_batches(batches):\n      batches = np.asarray(batches)\n      uniq, inv = np.unique(batches, return_inverse=True)\n      B = np.zeros((batches.shape[0], len(uniq)), dtype=np.float32)\n      B[np.arange(batches.shape[0]), inv] = 1.0\n      return B,\
    \ uniq\n\n  def _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n      # Ensure Z is 2D\n      if Z.ndim == 1:\n          Z = Z[:, np.newaxis]\n      \n      # Use sklearn.linear_model.Ridge for consistency and robustness\n      ridge = Ridge(alpha=l2, fit_intercept=False, solver='cholesky')\n      ridge.fit(B, Z)\n      \n      # Use predict method directly instead of manual matrix multiplication\n      Z_hat = ridge.predict(B)\n\n      # Return W in the expected shape (n_features, n_batches) by transposing coef_\n      W = ridge.coef_.T # Coef is (n_features, n_batches) after transpose\n\n      return Z_hat, W\n\n  def adaptive_residualize(Z: np.ndarray, batches, l2: float = 1e-3, gamma_max: float = 0.75, lam: float = 1.0):\n      B, _ = _one_hot_batches(batches)\n      Zhat, _ = _ridge_batch_fit_predict(B, Z, l2=l2)\n      y = np.asarray(Z, dtype=np.float32)\n      yhat = np.asarray(Zhat, dtype=np.float32)\n      \n      sse = np.sum((y - yhat) ** 2, axis=0)\n\
    \      y_center = y - np.mean(y, axis=0, keepdims=True)\n      sst = np.sum(y_center ** 2, axis=0) + 1e-8\n      r2 = 1.0 - (sse / sst) # R^2 per PC\n      \n      gamma_j = np.minimum(gamma_max, lam * np.clip(r2, 0.0, 1.0)).astype(np.float32)\n      Zcorr = Z - (yhat * gamma_j[None, :]) # Apply gamma_j as column-wise scaling to Zhat\n      return Zcorr, r2, gamma_j\n\n  def _batch_distance_scales(Z: np.ndarray, batches, metric='cosine', k_calib=24, clamp=(0.5, 2.0)):\n      Z = np.asarray(Z, dtype=np.float32)\n      batches = np.asarray(batches)\n      uniq = np.unique(batches)\n      per_batch_meds = {}\n      all_meds = []\n      for b in uniq:\n          idx = np.where(batches == b)[0]\n          if idx.size < 3: # Need at least 3 cells for meaningful median/NN\n              per_batch_meds[b] = 1.0\n              all_meds.append(1.0)\n              continue\n          k = min(k_calib + 1, idx.size) # Ensure k is not larger than batch size\n          nn = NearestNeighbors(n_neighbors=k,\
    \ metric=metric, algorithm='auto')\n          nn.fit(Z[idx])\n          dists, inds = nn.kneighbors(Z[idx], n_neighbors=k, return_distance=True)\n          d_no_self = []\n          for i in range(idx.size):\n              di = dists[i]\n              gi = inds[i]\n              mask = gi != i # Exclude self-neighbor if present\n              di = di[mask]\n              if di.size == 0: continue\n              d_no_self.append(np.median(di))\n          if len(d_no_self) == 0: med = 1.0\n          else: med = float(np.median(np.asarray(d_no_self)))\n          per_batch_meds[b] = med\n          all_meds.append(med if med > 0 else 1.0)\n      \n      # Handle case where all_meds could be empty if all batches too small\n      if not all_meds: \n          ref = 1.0\n      else:\n          ref = float(np.median(np.asarray(all_meds))) if len(all_meds) else 1.0\n          if ref <= 0: ref = 1.0 # Avoid division by zero\n\n      scales = {}\n      lo, hi = clamp\n      for b, med in per_batch_meds.items():\n\
    \          if med <= 0: s = 1.0\n          else: s = ref / med\n          s = float(np.clip(s, lo, hi))\n          scales[b] = s\n      return scales\n\n  def build_balanced_knn_calibrated(Z: np.ndarray, batches, k_total=48, metric='cosine', k_calib=24, clamp=(0.5, 2.0)):\n      Z = np.asarray(Z, dtype=np.float32)\n      batches = np.asarray(batches)\n      uniq_batches = np.unique(batches)\n      n = Z.shape[0]\n      nb = len(uniq_batches)\n      if nb == 0 or n == 0: return None, None\n      \n      base = k_total // nb\n      rem = k_total - base * nb\n      quotas = {b: base + (1 if i < rem else 0) for i, b in enumerate(uniq_batches)}\n      \n      scales = _batch_distance_scales(Z, batches, metric=metric, k_calib=k_calib, clamp=clamp)\n      \n      pairs_min_dist = {}\n      for b in uniq_batches:\n          idx = np.where(batches == b)[0]\n          q = quotas[b]\n          if idx.size == 0 or q == 0: continue # Skip if batch empty or quota is zero\n\n          k_nn_batch =\
    \ min(q + 1, idx.size) # Ensure k for NN is not larger than batch size\n          nn = NearestNeighbors(n_neighbors=k_nn_batch, metric=metric, algorithm='auto')\n          nn.fit(Z[idx])\n          dists, inds = nn.kneighbors(Z, n_neighbors=k_nn_batch, return_distance=True) # Search across all cells for neighbors in current batch\n          \n          neigh_in_batch = idx[inds] # Global indices of neighbors from current batch b\n\n          scale_b = float(scales.get(b, 1.0))\n          for i in range(n): # For each cell i\n              # Neighbors of cell i, specifically from batch b's fitted NN model\n              g_global_idx = neigh_in_batch[i]\n              di_scaled = dists[i] * scale_b\n\n              # Filter out self-loops and truncate to quota\n              valid_indices = [k for k, val in enumerate(g_global_idx) if val != i]\n              g_filtered = g_global_idx[valid_indices][:q]\n              di_filtered = di_scaled[valid_indices][:q]\n\n              for j, d\
    \ in zip(g_filtered, di_filtered):\n                  a, c = (i, j) if i < j else (j, i)\n                  prev = pairs_min_dist.get((a, c))\n                  if (prev is None) or (d < prev):\n                      pairs_min_dist[(a, c)] = float(d)\n      \n      if not pairs_min_dist: return None, None\n      \n      rows, cols, dist_data = [], [], []\n      for (i, j), d in pairs_min_dist.items():\n          rows.append(i); cols.append(j); dist_data.append(d)\n          rows.append(j); cols.append(i); dist_data.append(d) # Ensure symmetry\n\n      D = coo_matrix((dist_data, (rows, cols)), shape=(n, n)).tocsr()\n      C = D.copy()\n      C.data[:] = 1.0 # Binary connectivities\n      return C.tocsr(), D.tocsr()\n\n  # --- FWPCA Helper functions ---\n  def _calculate_hvg_anova_f_scores(X_hvg: sp.csr_matrix, batches) -> np.ndarray:\n      X_dense = X_hvg.toarray() if sp.issparse(X_hvg) else X_hvg.copy()\n      unique_batches = np.unique(batches)\n      f_scores = np.zeros(X_dense.shape[1])\n\
    \      \n      for j in range(X_dense.shape[1]): # Iterate over genes\n          gene_expression = X_dense[:, j]\n          groups = [gene_expression[batches == b] for b in unique_batches]\n          valid_groups = [g for g in groups if len(g) > 1 and np.var(g) > 1e-8]\n          \n          if len(valid_groups) >= 2:\n              try:\n                  f_statistic, _ = f_oneway(*valid_groups)\n                  f_scores[j] = f_statistic\n              except ValueError:\n                  f_scores[j] = 0.0\n          else:\n              f_scores[j] = 0.0\n              \n      max_f = np.max(f_scores)\n      if max_f > 0:\n          f_scores_normalized = f_scores / max_f\n      else:\n          f_scores_normalized = np.zeros_like(f_scores)\n              \n      return f_scores_normalized\n\n  def _calculate_hvg_r2_scores(X_hvg: sp.csr_matrix, batches, l2: float = 1e-3) -> np.ndarray:\n      X_dense = X_hvg.toarray() if sp.issparse(X_hvg) else X_hvg.copy()\n      B, _ = _one_hot_batches(batches)\n\
    \      \n      ridge = Ridge(alpha=l2, fit_intercept=False, solver='cholesky')\n      \n      # Fit ridge regression for each gene\n      r2_scores = np.zeros(X_dense.shape[1])\n      for j in range(X_dense.shape[1]):\n          y_gene = X_dense[:, j]\n          \n          if np.var(y_gene) < 1e-8: # Skip if no variance\n              r2_scores[j] = 0.0\n              continue\n              \n          ridge.fit(B, y_gene)\n          y_hat_gene = ridge.predict(B)\n          \n          sse = np.sum((y_gene - y_hat_gene) ** 2)\n          sst = np.sum((y_gene - np.mean(y_gene)) ** 2) + 1e-8\n          r2_scores[j] = 1.0 - (sse / sst)\n      \n      return np.clip(r2_scores, 0.0, 1.0) # Clip R^2 to [0,1]\n\n  def _calculate_hybrid_fwpca_weights(X_hvg: sp.csr_matrix, batches, l2_r2: float = 1e-3, alpha_anova_factor: float = 0.5) -> np.ndarray:\n      # Calculate R^2 scores for batch correlation\n      r2_scores = _calculate_hvg_r2_scores(X_hvg, batches, l2=l2_r2)\n      \n      # Calculate\
    \ ANOVA F-scores for batch variability\n      anova_f_scores_normalized = _calculate_hvg_anova_f_scores(X_hvg, batches)\n      \n      # Combine into hybrid weights: (1 - R^2_j) * (1 + alpha * F_j_norm)\n      weights = (1.0 - r2_scores) * (1.0 + alpha_anova_factor * anova_f_scores_normalized)\n      \n      # Normalize weights to avoid extreme values and ensure stability\n      # Could be scaled to have mean 1 or max 1, or just clipped.\n      # For now, let's just ensure positive and reasonable range.\n      weights = np.clip(weights, 0.01, 10.0) # Example clipping\n      \n      return weights\n\n  def _calculate_anova_fwpca_weights(X_hvg: sp.csr_matrix, batches, alpha_weight: float = 1.0) -> np.ndarray:\n      # Calculate ANOVA F-scores for batch variability\n      anova_f_scores_normalized = _calculate_hvg_anova_f_scores(X_hvg, batches)\n      \n      # Transform normalized F-scores into weights: 1 + alpha_weight * score\n      # This emphasizes genes with higher batch relevance\
    \ for PCA\n      weights = 1.0 + alpha_weight * anova_f_scores_normalized\n      \n      # Ensure positive and reasonable range\n      weights = np.clip(weights, 0.01, 10.0)\n      \n      return weights\n\n  def _batch_specific_quantile_normalization(X_hvg_dense: np.ndarray, batches: np.ndarray) -> np.ndarray:\n      \"\"\"\n      Performs batch-specific quantile normalization to match gene expression distributions across batches\n      to the global gene expression distribution.\n      Assumes X_hvg_dense is a dense numpy array of highly variable genes, already log1p normalized.\n      \"\"\"\n      X_qn = X_hvg_dense.copy()\n      unique_batches = np.unique(batches)\n      n_cells, n_genes = X_hvg_dense.shape\n      \n      for j in range(n_genes):\n          gene_expression_global = X_hvg_dense[:, j]\n          sorted_global_gene_expression = np.sort(gene_expression_global)\n          \n          for b in unique_batches:\n              batch_mask = (batches == b)\n              gene_expression_batch\
    \ = X_hvg_dense[batch_mask, j]\n              \n              if len(gene_expression_batch) > 0:\n                  sorted_indices_batch = np.argsort(gene_expression_batch)\n                  \n                  n_batch = len(gene_expression_batch)\n                  ranks_to_map = (np.arange(n_batch) + 0.5) / n_batch # Add 0.5 for midpoint\n                  \n                  mapped_values = np.interp(ranks_to_map, \n                                            (np.arange(n_cells) + 0.5) / n_cells, \n                                            sorted_global_gene_expression)\n                  \n                  X_qn[batch_mask, j][sorted_indices_batch] = mapped_values\n      return X_qn\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Aether II SOTA Optimization: EtC(FWPCA α=0.5) + BQN + Density-Adaptive BBSG (δ=0.15)\"\ntags: \"embed-then-correct, fwpca, bqn, density-adaptive-bbsg, sota-optimization\"\nabstract: \"This experiment integrates Batch-Specific Quantile Normalization\
    \ (BQN) as a preprocessing step into Praxis II's SOTA pipeline (EID 609), which combines Feature-Weighted PCA (alpha=0.5), Adaptive Residualization (lam=0.7), and Density-Adaptive BBSG (delta=0.15, k_density=20). BQN is applied after log-normalization and before FWPCA to test for synergistic improvements by harmonizing gene expression distributions across batches early in the pipeline.\"\ncontent: |\n  import sys\n  sys.path.append('storage') # For praxis common and bbsg_density_adaptive\n  sys.path.append('storage/Aether') # For my aether_utils\n\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from praxis.bbsg_density_adaptive import build_density_adaptive_bbsg\n  from scipy import sparse as sp\n\n  # My utilities, including BQN\n  from aether_utils import _batch_specific_quantile_normalization\n\n  # Existing helper functions from EID 609 (or praxis_common if not duplicating)\n  # I will copy the minimal set needed to ensure consistency if _normalize_log1p_inplace\
    \ is not in praxis_common\n  def _normalize_log1p_inplace(adata: ad.AnnData, target_sum: float = 1e4):\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=target_sum, inplace=True)\n      sc.pp.log1p(adata)\n\n  def _pca_array(X, n_comps=50, random_state=0):\n      Xd = X.A if sp.issparse(X) else X\n      ad_tmp = ad.AnnData(Xd)\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca']\n\n  def _one_hot_batches(batches: np.ndarray):\n      cats = np.unique(batches)\n      n = batches.shape[0]\n      B = np.zeros((n, cats.size), dtype=float)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(float)\n      return B\n\n  def _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=float)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B\
    \ @ W\n\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      # Praxis II's SOTA parameters from EID 609\n      n_pcs_emb = 60\n      n_pcs_graph = 50\n      l2 = 1e-3\n      gamma_max = 0.74\n      lam = 0.7\n      k_total = 48\n      metric = 'cosine'\n      delta = 0.15\n      k_density = 20\n      alpha_var = 0.5 # FWPCA alpha_weight\n\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n      # Common preprocessing (log1p normalization)\n      _normalize_log1p_inplace(adata, 1e4)\n      \n      # HVG selection needs to be on adata *before* subsetting, for the mask\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv_mask = adata.var['highly_variable'].to_numpy()\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      # Convert to dense HVG matrix for BQN and FWPCA\n      Xh = adata.X[:, hv_mask]\n      Xd_dense = (Xh.A if sp.issparse(Xh)\
    \ else Xh).astype(np.float32, copy=False)\n      \n      # --- Apply BQN as a preprocessing step ---\n      print(\"Applying Batch-Specific Quantile Normalization (BQN)...\")\n      Xd_qn = _batch_specific_quantile_normalization(Xd_dense, batches)\n      \n      # --- EMBEDDING PATH (on BQN-processed data) ---\n      print(\"Embedding Path: FWPCA -> PCA -> ComBat on BQN-processed data...\")\n      \n      # FWPCA (feature-weighted PCA)\n      var_g = Xd_qn.var(axis=0, ddof=1) + 1e-8\n      wv = np.power(var_g, -0.5 * alpha_var).astype(np.float32)\n      Xw_qn = Xd_qn * wv # Apply feature weights to BQN-processed HVGs\n      \n      ad_emb = ad.AnnData(Xw_qn, obs=adata.obs[['batch']].copy())\n      sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n      Z_emb = ad_emb.obsm['X_pca']\n      ad_pc = ad.AnnData(Z_emb.copy(), obs=adata.obs[['batch']].copy())\n      sc.pp.combat(ad_pc, key='batch')\n      adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n\
    \n      # Graph: PCA50 → adaptive residualization → density-adaptive BBSG (k_density=20)\n      print(\"Graph Path: Adaptive residualization -> Density-adaptive BBSG on BQN-processed data...\")\n      Zg = _pca_array(Xd_qn, n_comps=n_pcs_graph, random_state=0) # PCA on BQN-processed HVGs\n      B = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      gamma = np.minimum(gamma_max, lam * R2)\n      Zcorr = Zg - (Zhat * gamma)\n\n      Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches, k_total=k_total,\n                                           metric=metric, delta=delta, k_density=k_density, rng_seed=0)\n      adata.obsp['connectivities'] = Cg\n      adata.obsp['distances'] = Dg\n      \n      # Add neighbors metadata for evaluation\n      adata.uns['neighbors'] = {'connectivities_key':\
    \ 'connectivities', 'distances_key': 'distances'}\n      \n      return adata\n```"
