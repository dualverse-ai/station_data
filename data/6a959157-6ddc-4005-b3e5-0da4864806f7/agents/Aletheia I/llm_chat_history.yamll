tick: 666
role: model
parts:
- text: "I have updated `aletheia/praxis_core.py` to use `normalize_anscombe_inplace` instead of `normalize_log1p_inplace`. I will now update `aletheia/mpb_graphfwpca_override.py` to call this new normalization function, and then submit the experiment.\n\n`/execute_action{storage write aletheia/mpb_graphfwpca_override.py}`\n```yaml\ncontent: |\n  import sys\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n  from typing import Tuple, Literal\n  from sklearn.decomposition import PCA\n  import pandas as pd # Still needed for `ad.AnnData` if `var` is a DataFrame\n\n  # Ensure package roots\n  sys.path.append('storage/aletheia') # Point to my own storage for helper modules\n\n  # Import the new normalize function\n  from praxis_core import normalize_anscombe_inplace, pca_array_custom, one_hot_batches, ridge_batch_fit_predict\n  from bbsg_density_adaptive import build_density_adaptive_bbsg\n  from graph_bbsg import _build_bbsg\n\n  def _fw_weight_by_var(Xd:\
    \ np.ndarray, alpha: float) -> np.ndarray:\n      var_g = Xd.var(axis=0, ddof=1).astype(np.float32) + 1e-8\n      w = np.power(var_g, -0.5 * alpha).astype(np.float32)\n      return Xd * w\n\n  def eliminate_mpb_graphfwpca(adata: ad.AnnData,\n                               alpha_emb: float = 0.5,\n                               n_pcs_emb: int = 60,\n                               emb_n_neighbors: int = 15,\n                               alpha_g: float = 0.5,\n                               n_pcs_graph: int = 50,\n                               l2: float = 1e-3,\n                               gamma_max: float = 0.5, # Optimized gamma_max\n                               lam_override: float = 0.605,\n                               k_total: int = 50,\n                               kdensity: int = 22,\n                               delta: float = 0.05, # Optimized delta\n                               metric: str = 'cosine',\n                               cap: float = 2.0,\n         \
    \                      rng_seed: int = 0,\n                               n_top_genes_hvg: int = 2000 # Revert to original HVG count\n                               ) -> ad.AnnData:\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n      # 1. Normalize + Anscombe instead of Log1p\n      print(\"  Aletheia I: Applying Anscombe transformation after total normalization.\")\n      normalize_anscombe_inplace(adata, 1e4) # Use the new normalization function\n\n      # 2. Highly Variable Genes\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=n_top_genes_hvg, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      # Dense HVGs\n      Xh = adata.X[:, hv]\n      Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n\n      # EtC embedding path: Variance-weighted HVGs -> PCA -> Combat -> stores as X_emb\n  \
    \    print(\"  Aletheia I: Embedding path using PCA and Combat integration.\")\n      Xw_emb = _fw_weight_by_var(Xd, alpha=alpha_emb)\n      \n      pca_result_emb = pca_array_custom(Xw_emb, n_comps=n_pcs_emb, random_state=0)\n      \n      ad_pc = ad.AnnData(pca_result_emb.copy(), obs=adata.obs[['batch']].copy())\n      ad_pc.obs['batch'] = ad_pc.obs['batch'].astype('category')\n      sc.pp.combat(ad_pc, key='batch')\n      \n      adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32) # Set X_emb to Combat-corrected PCA\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n      # Graph path: GraphFWPCA -> PCA -> BRBG (fixed λ) -> DAQB\n      print(\"  Aletheia I: Graph path using PCA, BRBG + DAQB.\")\n      Xw_graph = _fw_weight_by_var(Xd, alpha=alpha_g)\n      Zg = pca_array_custom(Xw_graph, n_comps=n_pcs_graph, random_state=0)\n\n      B = one_hot_batches(batches)\n      Zhat = ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total =\
    \ Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n\n      lam = float(lam_override)\n      gamma = np.minimum(gamma_max, lam * R2).astype(np.float32)\n      Zcorr = Zg - (Zhat * gamma)\n\n      try: # Call DAQB with cap if available (fallback without cap)\n          Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                               k_total=k_total, metric=metric,\n                                               delta=delta, k_density=kdensity,\n                                               cap=cap, rng_seed=rng_seed)\n      except TypeError:\n          Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                               k_total=k_total, metric=metric,\n                                               delta=delta, k_density=kdensity,\n                                        \
    \       rng_seed=rng_seed)\n      adata.obsp['connectivities'] = Cg\n      adata.obsp['distances'] = Dg\n\n      adata.uns['mpb_graphfwpca_anscombe'] = dict(alpha_g=float(alpha_g),\n                                                  lam_override=float(lam),\n                                                  kd=int(kdensity), delta=float(delta),\n                                                  cap=float(cap),\n                                                  k_total=int(k_total),\n                                                  rng_seed=int(rng_seed),\n                                                  gamma_max = float(gamma_max),\n                                                  initial_normalization = 'Anscombe')\n      return adata\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      print(\"Aletheia I: Testing MPB-GraphFWPCA with Anscombe normalization (gamma_max=0.5, delta=0.05, HVG 2000).\")\n      return eliminate_mpb_graphfwpca(\n          adata,\n\
    \          alpha_emb=0.5,\n          n_pcs_emb=60,\n          emb_n_neighbors=15,\n          alpha_g=0.5,\n          n_pcs_graph=50,\n          l2=1e-3,\n          gamma_max=0.5,\n          lam_override=0.605,\n          k_total=50,\n          kdensity=22,\n          delta=0.05,\n          metric='cosine',\n          cap=2.0,\n          rng_seed=0,\n          n_top_genes_hvg=2000 # Revert to original HVG count\n      )\n```"
