parts:
- text: "/execute_action{goto research}\n/execute_action{storage write praxis/idea_pbve_knn_thresh.py}\n```yaml\ncontent: |\n  import sys\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n  from sklearn.neighbors import NearestNeighbors\n\n  def _build_knn_graph(Z, k=50, metric='cosine'):\n      n = Z.shape[0]\n      nn = NearestNeighbors(n_neighbors=k+1, metric=metric, algorithm='brute')\n      nn.fit(Z)\n      d, idx = nn.kneighbors(Z, return_distance=True)\n      rows, cols, vals = [], [], []\n      for i in range(n):\n          nbrs = idx[i, 1:]\n          rows.extend([i]*k)\n          cols.extend(nbrs.tolist())\n          vals.extend([1.0]*k)\n      A = sp.coo_matrix((vals, (rows, cols)), shape=(n, n)).tocsr()\n      A_sym = A.maximum(A.T); A_sym.eliminate_zeros()\n      # Distances: true distances for present edges (min of directed if both exist)\n      dist_map = {}\n      for i in range(n):\n          for off, j in enumerate(idx[i,\
    \ 1:]):\n              dist_map[(i, int(j))] = float(d[i, 1:][off])\n      Acoo = A_sym.tocoo()\n      data = []\n      for i, j in zip(Acoo.row, Acoo.col):\n          dij = dist_map.get((int(i), int(j)), np.inf)\n          dji = dist_map.get((int(j), int(i)), np.inf)\n          dd = dij if dij < dji else dji\n          if not np.isfinite(dd):\n              dd = 1.0\n          data.append(dd)\n      D = sp.csr_matrix((np.array(data, dtype=np.float32), (Acoo.row, Acoo.col)), shape=A_sym.shape)\n      return A_sym.tocsr(), D.tocsr()\n\n  def _pbve_scale_thresh(Z: np.ndarray, batches: np.ndarray, t: float = 0.5,\n                         clamp: tuple = (0.8, 1.25), tau: float = 0.20) -> np.ndarray:\n      \"\"\"\n      PBVE-lite with thresholding:\n        - For each PC j, compute global std σj and per-batch std σb,j after batchwise centering.\n        - For batches where |log(σb,j/σj)| > tau, scale by r(b,j) = (σj/σb,j)^t; else r=1.\n        - Clamp r to [clamp[0], clamp[1]]. Recenter\
    \ globally at the end.\n      \"\"\"\n      Zg = Z.astype(np.float32, copy=True)\n      # global center for reporting; we will per-batch center before std\n      gmean = Zg.mean(axis=0, keepdims=True)\n      cats = np.unique(batches)\n      # compute global std after global centering\n      Zc = Zg - gmean\n      sigma_g = Zc.std(axis=0, ddof=1) + 1e-8\n\n      # accumulate scaled rows\n      out = Zg.copy()\n      for b in cats:\n          msk = (batches == b)\n          Zb = Zg[msk]\n          Zb_c = Zb - Zb.mean(axis=0, keepdims=True)  # per-batch center\n          sigma_b = Zb_c.std(axis=0, ddof=1) + 1e-8\n          ratio = sigma_b / sigma_g\n          logdev = np.abs(np.log(ratio))\n          r = np.ones_like(ratio, dtype=np.float32)\n          need = (logdev > float(tau))\n          r[need] = np.power((sigma_g[0, need] / sigma_b[need]), float(t))\n          r = np.clip(r, float(clamp[0]), float(clamp[1]))\n          out[msk] = (Zb_c * r).astype(np.float32)\n      # global recenter\n\
    \      out = out - out.mean(axis=0, keepdims=True)\n      return out\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      # Normalize raw counts and PCA\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=1e4, inplace=True)\n      sc.pp.log1p(adata)\n      sc.pp.pca(adata, n_comps=60, svd_solver='arpack', random_state=0)\n      Z = np.asarray(adata.obsm['X_pca'], dtype=np.float32)\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      # PBVE-lite thresholded\n      t = 0.5\n      clamp = (0.8, 1.25)\n      tau = 0.20\n      print(f\"[pbve-thresh] t={t}, clamp={clamp}, tau={tau}\")\n      Z_pbve = _pbve_scale_thresh(Z, batches, t=t, clamp=clamp, tau=tau)\n\n      adata.obsm['X_emb'] = Z_pbve\n      C, D = _build_knn_graph(Z_pbve, k=50, metric='cosine')\n      adata.obsp['connectivities'] = C\n      adata.obsp['distances'] = D\n      return adata\n```\n/execute_action{storage\
    \ write praxis/idea_pca_drop3_knn.py}\n```yaml\ncontent: |\n  import sys\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n  from sklearn.neighbors import NearestNeighbors\n\n  def _build_knn_graph(Z, k=50, metric='cosine'):\n      n = Z.shape[0]\n      nn = NearestNeighbors(n_neighbors=k+1, metric=metric, algorithm='brute')\n      nn.fit(Z)\n      d, idx = nn.kneighbors(Z, return_distance=True)\n      rows, cols, vals = [], [], []\n      for i in range(n):\n          nbrs = idx[i, 1:]\n          rows.extend([i]*k)\n          cols.extend(nbrs.tolist())\n          vals.extend([1.0]*k)\n      A = sp.coo_matrix((vals, (rows, cols)), shape=(n, n)).tocsr()\n      A_sym = A.maximum(A.T); A_sym.eliminate_zeros()\n      # Distances: true distances for present edges (min of directed if both exist)\n      dist_map = {}\n      for i in range(n):\n          for off, j in enumerate(idx[i, 1:]):\n              dist_map[(i, int(j))] = float(d[i,\
    \ 1:][off])\n      Acoo = A_sym.tocoo()\n      data = []\n      for i, j in zip(Acoo.row, Acoo.col):\n          dij = dist_map.get((int(i), int(j)), np.inf)\n          dji = dist_map.get((int(j), int(i)), np.inf)\n          dd = dij if dij < dji else dji\n          if not np.isfinite(dd):\n              dd = 1.0\n          data.append(dd)\n      D = sp.csr_matrix((np.array(data, dtype=np.float32), (Acoo.row, Acoo.col)), shape=A_sym.shape)\n      return A_sym.tocsr(), D.tocsr()\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      # PCA baseline with top-3 PC drop (global components)\n      if 'counts' in adata.layers:\n          adata.X = adata.layers['counts'].copy()\n      sc.pp.normalize_total(adata, target_sum=1e4, inplace=True)\n      sc.pp.log1p(adata)\n      sc.pp.pca(adata, n_comps=63, svd_solver='arpack', random_state=0)\n      Z = np.asarray(adata.obsm['X_pca'], dtype=np.float32)\n      # Drop the first 3 PCs (highest variance directions)\n      if Z.shape[1]\
    \ > 3:\n          Z = Z[:, 3:63]  # keep next 60 components\n      adata.obsm['X_emb'] = Z\n      C, D = _build_knn_graph(Z, k=50, metric='cosine')\n      adata.obsp['connectivities'] = C\n      adata.obsp['distances'] = D\n      return adata\n```\n/execute_action{submit 1}\n```yaml\ntitle: \"Idea 1t: PBVE‑lite with threshold (t=0.5, clamp=[0.8,1.25], τ=0.20) on PCA(60) → kNN(k=50)\"\ntags: \"experiment, pca, variance-equalization, thresholded, knn, baseline\"\nabstract: \"Equalize per-batch per-PC variances only where |log(σ_b/σ_g)|>τ (τ=0.20), with tempered scaling (t=0.5) and clamp [0.8,1.25], then build vanilla kNN (k=50, cosine). Hypothesis: preserve biology-dominant PCs while correcting batch‑anisotropy.\"\ncontent: |\n  import sys\n  import anndata as ad\n  sys.path.append('storage/praxis')\n  from idea_pbve_knn_thresh import eliminate_batch_effect_fn as _run\n  def eliminate_batch_effect_fn(adata: ad.AnnData):\n      return _run(adata)\n```\n/execute_action{submit 1}\n```yaml\n\
    title: \"Idea 5: Drop top-3 PCs (global) before kNN — PCA(63)→keep 60, k=50\"\ntags: \"experiment, pca, pc-drop, knn, baseline\"\nabstract: \"Remove the top-3 highest-variance PCs globally (potential batch-dominated axes), then use the next 60 PCs to build vanilla kNN (k=50, cosine). Hypothesis: suppress batch-dominant directions while preserving biological structure.\"\ncontent: |\n  import sys\n  import anndata as ad\n  sys.path.append('storage/praxis')\n  from idea_pca_drop3_knn import eliminate_batch_effect_fn as _run\n  def eliminate_batch_effect_fn(adata: ad.AnnData):\n      return _run(adata)\n```"
