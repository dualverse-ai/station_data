tick: 953
role: model
parts:
- text: "/execute_action{goto research}\n/execute_action{storage write praxis/fwpca_only_utils.py}\n```yaml\ncontent: |\n  import sys\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n\n  # Ensure package roots\n  sys.path.append('storage')\n  sys.path.append('storage/praxis')\n\n  from praxis_core import normalize_log1p_inplace, pca_array\n  from bbsg_density_adaptive import build_density_adaptive_bbsg\n\n  def _fw_weight_by_var(Xd: np.ndarray, alpha: float) -> np.ndarray:\n      var_g = Xd.var(axis=0, ddof=1).astype(np.float32) + 1e-8\n      w = np.power(var_g, -0.5 * alpha).astype(np.float32)\n      return Xd * w\n\n  def _pbve_equalize(Z: np.ndarray, batches: np.ndarray, temper: float = 1.0,\n                     rmin: float = 0.8, rmax: float = 1.25, thresh_log: float = None) -> np.ndarray:\n      \"\"\"\n      Per-batch per-PC variance equalization in PC space (preserve global means).\n      Z: (n_cells, n_pcs), batches: categorical\
    \ array, temper in [0,1].\n      \"\"\"\n      Z = Z.copy().astype(np.float32, copy=False)\n      # Global mean preserved; compute global std on globally centered Z\n      Zc = Z - Z.mean(axis=0, keepdims=True)\n      gstd = Zc.std(axis=0, ddof=1) + 1e-8\n      cats = np.unique(batches)\n      for b in cats:\n          mask = (batches == b)\n          Zb = Z[mask]\n          # Per-batch center and std\n          Zb_c = Zb - Zb.mean(axis=0, keepdims=True)\n          bstd = Zb_c.std(axis=0, ddof=1) + 1e-8\n          # Optional thresholding on |log ratio|\n          if thresh_log is not None:\n              lr = np.abs(np.log(bstd / gstd))\n              adj = (lr > float(thresh_log)).astype(np.float32)\n          else:\n              adj = 1.0\n          # Tempered ratio, clamped\n          ratio = (gstd / bstd) ** float(temper)\n          ratio = np.clip(ratio, float(rmin), float(rmax)).astype(np.float32)\n          ratio = ratio * adj + (1.0 - adj)  # leave PCs below threshold unchanged\n\
    \          # Recenter to batch mean and write back (preserve global mean overall)\n          Z[mask] = (Zb_c * ratio) + Zb.mean(axis=0, keepdims=True)\n      return Z.astype(np.float32, copy=False)\n\n  def run_fwpca_only(adata: ad.AnnData,\n                     alpha_emb: float = 0.5,\n                     n_pcs_emb: int = 60,\n                     emb_n_neighbors: int = 15,\n                     alpha_g: float = 0.5,\n                     n_pcs_graph: int = 50,\n                     kdensity: int = 20,\n                     k_total: int = 50,\n                     delta: float = 0.06,\n                     metric: str = 'cosine',\n                     cap: float = 2.0,\n                     rng_seed: int = 0,\n                     pbve_temper: float = None,\n                     pbve_rmin: float = 0.8,\n                     pbve_rmax: float = 1.25,\n                     pbve_thresh_log: float = None) -> ad.AnnData:\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\
    \n      # Normalize + HVGs (batch-aware)\n      normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      # Dense HVGs\n      Xh = adata.X[:, hv]\n      Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n\n      # QC embedding path (EtC-like)\n      Xw_emb = _fw_weight_by_var(Xd, alpha=alpha_emb)\n      ad_emb = ad.AnnData(Xw_emb, obs=adata.obs[['batch']].copy())\n      sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n      ad_pc = ad.AnnData(ad_emb.obsm['X_pca'].copy(), obs=adata.obs[['batch']].copy())\n      sc.pp.combat(ad_pc, key='batch')\n      adata.obsm['X_emb'] = np.asarray(ad_pc.X, dtype=np.float32)\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n      # Graph path:\
    \ GraphFWPCA only (no BRBG residualization)\n      Xw_graph = _fw_weight_by_var(Xd, alpha=alpha_g)\n      Zg = pca_array(Xw_graph, n_comps=n_pcs_graph, random_state=0).astype(np.float32)\n\n      # Optional PBVE-lite in graph PC space\n      if pbve_temper is not None:\n          Zg = _pbve_equalize(Zg, batches,\n                              temper=float(pbve_temper),\n                              rmin=float(pbve_rmin),\n                              rmax=float(pbve_rmax),\n                              thresh_log=(None if pbve_thresh_log is None else float(pbve_thresh_log)))\n\n      # Build DAQB on Zg\n      try:\n          Cg, Dg = build_density_adaptive_bbsg(Zg, batches=batches,\n                                               k_total=int(k_total), metric=metric,\n                                               delta=float(delta), k_density=int(kdensity),\n                                               cap=float(cap), rng_seed=int(rng_seed))\n      except TypeError:\n          Cg,\
    \ Dg = build_density_adaptive_bbsg(Zg, batches=batches,\n                                               k_total=int(k_total), metric=metric,\n                                               delta=float(delta), k_density=int(kdensity),\n                                               rng_seed=int(rng_seed))\n      adata.obsp['connectivities'] = Cg\n      adata.obsp['distances'] = Dg\n      adata.uns['fwpca_only'] = dict(alpha_g=float(alpha_g),\n                                     kd=int(kdensity), delta=float(delta),\n                                     cap=float(cap), k_total=int(k_total),\n                                     rng_seed=int(rng_seed),\n                                     pbve_temper=(None if pbve_temper is None else float(pbve_temper)),\n                                     pbve_rmin=float(pbve_rmin), pbve_rmax=float(pbve_rmax),\n                                     pbve_thresh_log=(None if pbve_thresh_log is None else float(pbve_thresh_log)))\n      return adata\n```\n\
    \n/execute_action{storage write praxis/fwpca_only_kd20_d006_seed0.py}\n```yaml\ncontent: |\n  import sys\n  import anndata as ad\n  sys.path.append('storage')\n  sys.path.append('storage/praxis')\n  from fwpca_only_utils import run_fwpca_only\n\n  # FWPCA-only baseline: kdensity=20, delta=0.06, k=50, alpha_g=0.50, seed=0\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      print(\"[fwpca-only] kd=20, d=0.06, k=50, a_g=0.5, seed=0 (no PBVE)\")\n      return run_fwpca_only(adata,\n                            alpha_g=0.50,\n                            kdensity=20, k_total=50, delta=0.06,\n                            metric='cosine', cap=2.0, rng_seed=0,\n                            pbve_temper=None)\n```\n\n/execute_action{storage write praxis/fwpca_only_pbve_t10_kd20_d006_seed0.py}\n```yaml\ncontent: |\n  import sys\n  import anndata as ad\n  sys.path.append('storage')\n  sys.path.append('storage/praxis')\n  from fwpca_only_utils import run_fwpca_only\n\n  # FWPCA-only\
    \ + PBVE-lite(t=1.0, clamp=[0.8,1.25]) in graph PC space, kd=20, d=0.06, k=50, seed=0\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      print(\"[fwpca-only+pbve] kd=20, d=0.06, k=50, a_g=0.5, seed=0, pbve t=1.0 r=[0.8,1.25]\")\n      return run_fwpca_only(adata,\n                            alpha_g=0.50,\n                            kdensity=20, k_total=50, delta=0.06,\n                            metric='cosine', cap=2.0, rng_seed=0,\n                            pbve_temper=1.0, pbve_rmin=0.8, pbve_rmax=1.25, pbve_thresh_log=None)\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"FWPCA-only baseline: kd=20, δ=0.06, k=50 (no BRBG, no PBVE)\"\ntags: \"baseline, fwpca, graph, daqb, kd20, d006\"\nabstract: \"FWPCA-only (BRBG disabled) with DAQB at kdensity=20, delta=0.06, k=50, alpha_g=0.5. This establishes a baseline to test PBVE-lite synergy on the graph path under env v4.1.\"\ncontent: |\n  import sys\n  import anndata as ad\n  sys.path.append('storage/praxis')\n\
    \  from fwpca_only_kd20_d006_seed0 import eliminate_batch_effect_fn as _run\n  def eliminate_batch_effect_fn(adata: ad.AnnData):\n      return _run(adata)\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"FWPCA-only + PBVE-lite(t=1.0, r=[0.8,1.25]) at kd=20, δ=0.06, k=50\"\ntags: \"experiment, fwpca, pbve-lite, graph, daqb, kd20\"\nabstract: \"Apply PBVE-lite (per-batch per-PC variance equalization, t=1.0, clamp=[0.8,1.25]) in the graph PC space of an FWPCA-only pipeline (BRBG disabled) at kdensity=20, delta=0.06, k=50 to test context-dependent synergy reported by Syntellect I.\"\ncontent: |\n  import sys\n  import anndata as ad\n  sys.path.append('storage/praxis')\n  from fwpca_only_pbve_t10_kd20_d006_seed0 import eliminate_batch_effect_fn as _run\n  def eliminate_batch_effect_fn(adata: ad.AnnData):\n      return _run(adata)\n```"
