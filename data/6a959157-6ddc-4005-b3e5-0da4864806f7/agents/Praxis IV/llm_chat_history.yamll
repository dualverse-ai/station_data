parts:
- text: "/execute_action{goto research}\n/execute_action{storage write shared/sym/sym_bmatching_greedy.py}\n```yaml\ncontent: |\n  import sys\n  sys.path.append('storage')\n  sys.path.append('storage/praxis')\n\n  import numpy as np\n  import scipy.sparse as sp\n  from sklearn.neighbors import NearestNeighbors\n\n  # Local b-matching (degree-constrained) greedy symmetrizer\n  # Candidate edges are the union of directed quota proposals; greedily add edges with costs favoring mutual and cross-batch edges\n  # while respecting degree k per node.\n\n  def build_bmatching_greedy(\n      Zcorr, batches, k_total=50, kdensity=22, delta=0.10, metric='cosine'\n  ):\n      n = Zcorr.shape[0]\n      cats, inv = np.unique(batches, return_inverse=True)\n      bc = inv.astype(np.int32)\n      B = len(cats)\n      B_other = max(B - 1, 1)\n\n      # Density proxy\n      nn_d = NearestNeighbors(n_neighbors=kdensity + 1, metric=metric, algorithm='brute').fit(Zcorr)\n      d_all, _ = nn_d.kneighbors(Zcorr,\
    \ return_distance=True)\n      d_k = d_all[:, -1].astype(np.float32)\n      d_min, d_max = float(np.min(d_k)), float(np.max(d_k) + 1e-8)\n      inv_dense = 1.0 - (d_k - d_min) / (d_max - d_min + 1e-8)\n\n      # Directed proposals (as in quotas)\n      batch_to_idx = {}\n      nn_models = {}\n      max_need = int(np.ceil(0.90 * k_total))\n      for j in range(B):\n          idx = np.where(bc == j)[0]\n          batch_to_idx[j] = idx\n          nn = NearestNeighbors(n_neighbors=max_need + 1, metric=metric, algorithm='brute').fit(Zcorr[idx])\n          nn_models[j] = nn\n\n      dir_rows, dir_cols = [], []\n      for i in range(n):\n          bi = int(bc[i])\n          need_cross = int(np.round(((B - 1)/B + (inv_dense[i]-0.5)*2*delta) * k_total))\n          need_cross = int(np.clip(need_cross, int(0.60*k_total), int(0.90*k_total)))\n          need_within = int(k_total - need_cross)\n          # within\n          d_i, ii = nn_models[bi].kneighbors(Zcorr[[i]], return_distance=True)\n   \
    \       d_i = d_i[0]; ii = ii[0]\n          start = 1 if d_i[0] == 0.0 else 0\n          sel_w = min(need_within, ii.shape[0] - start)\n          if sel_w > 0:\n              dir_rows.extend([i]*sel_w)\n              dir_cols.extend(batch_to_idx[bi][ii[start:start+sel_w]].tolist())\n          # cross per other\n          other_batches = [j for j in range(B) if j != bi]\n          q_per = need_cross // B_other\n          rem = need_cross - q_per * B_other\n          # bias closest other batches\n          bscores = []\n          for j in other_batches:\n              d_ij, _ = nn_models[j].kneighbors(Zcorr[[i]], n_neighbors=1, return_distance=True)\n              bscores.append((j, float(d_ij[0,0])))\n          bscores.sort(key=lambda t: t[1])\n          q_map = {j: q_per for j in other_batches}\n          for k in range(rem):\n              q_map[bscores[k % len(other_batches)][0]] += 1\n          for j in other_batches:\n              d_ij, ii_j = nn_models[j].kneighbors(Zcorr[[i]],\
    \ return_distance=True)\n              ii_j = ii_j[0]\n              sel = min(q_map[j], ii_j.shape[0])\n              if sel > 0:\n                  dir_rows.extend([i]*sel)\n                  dir_cols.extend(batch_to_idx[j][ii_j[:sel]].tolist())\n\n      dir_rows = np.asarray(dir_rows, dtype=np.int32)\n      dir_cols = np.asarray(dir_cols, dtype=np.int32)\n      A_dir = sp.coo_matrix((np.ones_like(dir_rows, dtype=np.int32), (dir_rows, dir_cols)), shape=(n, n)).tocsr()\n\n      # mutual bonus and cross-batch bonus costs\n      M = A_dir.minimum(A_dir.T)\n      deg = np.zeros(n, dtype=np.int32)\n      edges = []\n      I, J = A_dir.nonzero()\n      for i, j in zip(I, J):\n          if i == j:\n              continue\n          is_cross = (bc[i] != bc[j])\n          bonus_mutual = 1.0 if M[i, j] else 0.0\n          bonus_cross = (1.0 + float(inv_dense[i])) if is_cross else 0.0\n          # symmetric score (approximate by i's view)\n          score = bonus_mutual + bonus_cross - (0.1 if\
    \ not is_cross else 0.0)\n          # store undirected edge canonicalized (min, max)\n          u, v = (i, j) if i < j else (j, i)\n          edges.append((score, u, v))\n      # deduplicate by (u,v) with max score\n      edge_dict = {}\n      for sc, u, v in edges:\n          key = (u, v)\n          if key not in edge_dict or sc > edge_dict[key]:\n              edge_dict[key] = sc\n      uniq = [(sc, u, v) for (u, v), sc in edge_dict.items()]\n      uniq.sort(key=lambda t: t[0], reverse=True)\n\n      # Greedy add under degree constraints\n      selected = []\n      for sc, u, v in uniq:\n          if deg[u] < k_total and deg[v] < k_total:\n              selected.append((u, v))\n              deg[u] += 1; deg[v] += 1\n      # Build C (binary), D=1.0 placeholder\n      rows = [u for u, v in selected] + [v for u, v in selected]\n      cols = [v for u, v in selected] + [u for u, v in selected]\n      data = np.ones(len(rows), dtype=np.float32)\n      C = sp.coo_matrix((data, (np.asarray(rows),\
    \ np.asarray(cols))), shape=(n, n)).tocsr()\n      C.eliminate_zeros()\n      D = C.copy().astype(np.float32)\n      return C, D\n```\n/execute_action{storage write shared/sym/sym_invite_trim.py}\n```yaml\ncontent: |\n  import sys\n  sys.path.append('storage')\n  sys.path.append('storage/praxis')\n\n  import numpy as np\n  import scipy.sparse as sp\n  from sklearn.neighbors import NearestNeighbors\n\n  # Invite-then-trim (quota-window) undirected symmetrizer\n  # Builds undirected graph from directed quota proposals while trying to preserve per-node cross-batch targets.\n\n  def build_invite_then_trim(\n      Zcorr, batches, k_total=50, kdensity=22, delta=0.10,\n      metric='cosine', window=1\n  ):\n      n = Zcorr.shape[0]\n      cats, inv = np.unique(batches, return_inverse=True)\n      bc = inv.astype(np.int32)\n      B = len(cats)\n      B_other = max(B - 1, 1)\n\n      # Density proxy (k-th NN distance)\n      nn_d = NearestNeighbors(n_neighbors=kdensity + 1, metric=metric, algorithm='brute').fit(Zcorr)\n\
    \      d_all, _ = nn_d.kneighbors(Zcorr, return_distance=True)\n      d_k = d_all[:, -1].astype(np.float32)\n      d_min, d_max = float(np.min(d_k)), float(np.max(d_k) + 1e-8)\n      inv_dense = 1.0 - (d_k - d_min) / (d_max - d_min + 1e-8)\n\n      # Theoretical cross-batch fraction\n      base = (B - 1) / float(B)\n      f_cross = np.clip(base + (inv_dense - 0.5) * 2.0 * float(delta), 0.60, 0.90).astype(np.float32)\n      tgt_cross = np.round(f_cross * k_total).astype(np.int32)\n      lo_cross = np.maximum(0, tgt_cross - int(window)).astype(np.int32)\n      hi_cross = np.minimum(k_total, tgt_cross + int(window)).astype(np.int32)\n\n      # Per-batch neighbor structures (for directed proposals)\n      batch_to_idx = {}\n      nn_models = {}\n      max_need = int(np.ceil(0.90 * k_total))  # upper bound for per-batch neighbors\n      for j in range(B):\n          idx = np.where(bc == j)[0]\n          batch_to_idx[j] = idx\n          nn = NearestNeighbors(n_neighbors=max_need + 1, metric=metric,\
    \ algorithm='brute').fit(Zcorr[idx])\n          nn_models[j] = nn\n\n      # Directed proposals\n      dir_rows, dir_cols = [], []\n      for i in range(n):\n          bi = int(bc[i])\n          need_cross = int(tgt_cross[i])\n          need_within = int(k_total - need_cross)\n          # within (skip self if present)\n          d_i, ii = nn_models[bi].kneighbors(Zcorr[[i]], return_distance=True)\n          d_i = d_i[0]; ii = ii[0]\n          start = 1 if d_i[0] == 0.0 else 0\n          sel_w = min(need_within, ii.shape[0] - start)\n          if sel_w > 0:\n              cols_w = batch_to_idx[bi][ii[start:start+sel_w]]\n              dir_rows.extend([i]*sel_w); dir_cols.extend(cols_w.tolist())\n          # cross per other\n          other_batches = [j for j in range(B) if j != bi]\n          q_per = need_cross // B_other\n          rem = need_cross - q_per * B_other\n          # prefer closest other batches\n          batch_scores = []\n          for j in other_batches:\n           \
    \   d_ij, _ = nn_models[j].kneighbors(Zcorr[[i]], n_neighbors=1, return_distance=True)\n              batch_scores.append((j, float(d_ij[0,0])))\n          batch_scores.sort(key=lambda t: t[1])\n          q_map = {j: q_per for j in other_batches}\n          for k in range(rem):\n              q_map[batch_scores[k % len(other_batches)][0]] += 1\n          for j in other_batches:\n              d_ij, ii_j = nn_models[j].kneighbors(Zcorr[[i]], return_distance=True)\n              ii_j = ii_j[0]\n              sel = min(q_map[j], ii_j.shape[0])\n              if sel > 0:\n                  cols_c = batch_to_idx[j][ii_j[:sel]]\n                  dir_rows.extend([i]*sel); dir_cols.extend(cols_c.tolist())\n\n      dir_rows = np.asarray(dir_rows, dtype=np.int32)\n      dir_cols = np.asarray(dir_cols, dtype=np.int32)\n\n      # Phase 1: accept mutuals first\n      A_dir = sp.coo_matrix((np.ones_like(dir_rows, dtype=np.int32), (dir_rows, dir_cols)), shape=(n, n)).tocsr()\n      M = A_dir.minimum(A_dir.T)\
    \  # mutual mask\n      selected = [set() for _ in range(n)]\n      deg = np.zeros(n, dtype=np.int32)\n      cross_count = np.zeros(n, dtype=np.int32)\n\n      I, J = M.nonzero()\n      for i, j in zip(I, J):\n          if i < j:\n              if j not in selected[i] and i not in selected[j] and deg[i] < k_total and deg[j] < k_total:\n                  selected[i].add(j); selected[j].add(i)\n                  deg[i] += 1; deg[j] += 1\n                  if bc[j] != bc[i]:\n                      cross_count[i] += 1; cross_count[j] += 1\n\n      # Phase 2: fill residual degree with unilateral offers, biasing toward cross in denser zones (respect window)\n      M_bool = (M > 0)\n      A_dir_bool = (A_dir > 0)\n      for i in range(n):\n          if deg[i] >= k_total:\n              continue\n          s, e = A_dir.indptr[i], A_dir.indptr[i+1]\n          cand = A_dir.indices[s:e]\n          scores = []\n          for j in cand:\n              if i == j or j in selected[i] or len(selected[j])\
    \ >= k_total:\n                  continue\n              is_cross = (bc[j] != bc[i])\n              bonus_mutual = 0.3 if M_bool[i, j] else (0.1 if A_dir_bool[j, i] else 0.0)\n              sc = (1.0 if is_cross else 0.0) * (1.0 + float(inv_dense[i])) - (0.5 if not is_cross else 0.0) + bonus_mutual\n              scores.append((sc, j, is_cross))\n          scores.sort(key=lambda t: t[0], reverse=True)\n          for sc, j, is_cross in scores:\n              if deg[i] >= k_total or len(selected[j]) >= k_total:\n                  break\n              new_cc_i = cross_count[i] + (1 if is_cross else 0)\n              if new_cc_i > hi_cross[i]:\n                  continue\n              if j not in selected[i] and i not in selected[j]:\n                  selected[i].add(j); selected[j].add(i)\n                  deg[i] += 1; deg[j] += 1\n                  if is_cross:\n                      cross_count[i] += 1\n                      if bc[i] != bc[j]:\n                          cross_count[j]\
    \ += 1\n\n      # Phase 2b: fallback fill to reach degree k (ignore window; prioritize cross, then within)\n      for i in range(n):\n          if deg[i] >= k_total:\n              continue\n          s, e = A_dir.indptr[i], A_dir.indptr[i+1]\n          cand = A_dir.indices[s:e]\n          scores = []\n          for j in cand:\n              if i == j or j in selected[i] or len(selected[j]) >= k_total:\n                  continue\n              is_cross = (bc[j] != bc[i])\n              sc = (2.0 if is_cross else 1.0) + float(inv_dense[i])\n              scores.append((sc, j, is_cross))\n          scores.sort(key=lambda t: t[0], reverse=True)\n          for sc, j, is_cross in scores:\n              if deg[i] >= k_total or len(selected[j]) >= k_total:\n                  break\n              if j not in selected[i] and i not in selected[j]:\n                  selected[i].add(j); selected[j].add(i)\n                  deg[i] += 1; deg[j] += 1\n                  if is_cross:\n           \
    \           cross_count[i] += 1\n                      if bc[i] != bc[j]:\n                          cross_count[j] += 1\n\n      # Build symmetric C and placeholder D\n      rows, cols = [], []\n      for i in range(n):\n          for j in selected[i]:\n              rows.append(i); cols.append(j)\n      rows = np.asarray(rows, dtype=np.int32)\n      cols = np.asarray(cols, dtype=np.int32)\n      data = np.ones_like(rows, dtype=np.float32)\n      C = sp.coo_matrix((data, (rows, cols)), shape=(n, n)).tocsr()\n      C = C.maximum(C.T); C.eliminate_zeros()\n      D = C.copy().astype(np.float32)\n      return C.tocsr().astype(np.float32), D.tocsr().astype(np.float32)\n```\n/execute_action{submit 1}\n```yaml\ntitle: \"Symmetrization prototypes v2 (test-only): invite-then-trim and b-matching greedy @ ridge\"\ntags: \"symmetrization, diagnostics, quotas, ridge, graph\"\nabstract: \"Fixes indexing bug and adds degree-fill fallback. Runs two undirected symmetrizers on Zcorr to report corr(th,und),\
    \ mean realized cross-batch, and average degree.\"\ncontent: |\n  import sys\n  import anndata as ad\n  sys.path.append('storage/shared')\n  from examples.sym_prototypes_test import test as _test\n\n  def test(adata: ad.AnnData):\n      return _test(adata)\n```\n/execute_action{review 1183}"
