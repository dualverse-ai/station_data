- text: "/execute_action{goto research}\n/execute_action{storage write praxis/ensemble_daqb_multi_seed.py}\n```yaml\ncontent: |\n  import sys\n  sys.path.append('storage')\n  sys.path.append('storage/praxis')\n\n  import numpy as np\n  import anndata as ad\n  import scanpy as sc\n  import scipy.sparse as sp\n\n  from praxis_core import normalize_log1p_inplace, pca_array, one_hot_batches, ridge_batch_fit_predict\n  from bbsg_density_adaptive import build_density_adaptive_bbsg\n\n  def _fw_weight_by_var(Xd: np.ndarray, alpha: float) -> np.ndarray:\n      var_g = Xd.var(axis=0, ddof=1).astype(np.float32) + 1e-8\n      w = np.power(var_g, -0.5 * alpha).astype(np.float32)\n      return Xd * w\n\n  def _symmetrize_binary_with_dist(C: sp.csr_matrix, D: sp.csr_matrix):\n      C = C.tocsr(); D = D.tocsr()\n      C_sym = C.maximum(C.T).tocsr()\n      A = C_sym.tocoo()\n      rows, cols = A.row, A.col\n      dvals = np.empty_like(rows, dtype=np.float32)\n      for k in range(len(rows)):\n         \
    \ i, j = rows[k], cols[k]\n          dij = 1e9\n          si, ei = D.indptr[i], D.indptr[i+1]\n          pos = np.searchsorted(D.indices[si:ei], j)\n          if si+pos < ei and D.indices[si+pos] == j:\n              dij = min(dij, float(D.data[si+pos]))\n          sj, ej = D.indptr[j], D.indptr[j+1]\n          pos2 = np.searchsorted(D.indices[sj:ej], i)\n          if sj+pos2 < ej and D.indices[sj+pos2] == i:\n              dij = min(dij, float(D.data[sj+pos2]))\n          if dij == 1e9:\n              dij = 1.0\n          dvals[k] = dij\n      D_sym = sp.csr_matrix((dvals, (rows, cols)), shape=D.shape)\n      D_sym.eliminate_zeros()\n      return C_sym, D_sym\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      # Config (Ridge + ensemble seeds)\n      alpha_emb = 0.5\n      n_pcs_emb = 60\n      emb_n_neighbors = 15\n      alpha_g = 0.5\n      n_pcs_graph = 50\n      l2 = 1e-3\n      gamma_max = 0.74\n      lam = 0.605\n      k_total = 50\n      kdensity = 22\n\
    \      delta = 0.10\n      metric = 'cosine'\n      seeds = [0, 1, 2]\n\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n      # Normalize + HVGs\n      normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      # Dense HVGs\n      Xh = adata.X[:, hv]\n      Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n\n      # QC embedding for neighbors (not used by DAQB)\n      Xw_emb = _fw_weight_by_var(Xd, alpha=alpha_emb)\n      ad_emb = ad.AnnData(Xw_emb, obs=adata.obs[['batch']].copy())\n      sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n      ad_pc = ad.AnnData(ad_emb.obsm['X_pca'].copy(), obs=adata.obs[['batch']].copy())\n      sc.pp.combat(ad_pc, key='batch')\n      adata.obsm['X_emb']\
    \ = np.asarray(ad_pc.X, dtype=np.float32)\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n      # Graph path + BRBG residualization to Zcorr\n      Xw_graph = _fw_weight_by_var(Xd, alpha=alpha_g)\n      Zg = pca_array(Xw_graph, n_comps=n_pcs_graph, random_state=0)\n      B = one_hot_batches(batches)\n      Zhat = ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n      gamma = np.minimum(gamma_max, lam * R2).astype(np.float32)\n      Zcorr = Zg - (Zhat * gamma)\n\n      # Build DAQB graphs for multiple seeds\n      Cs = []\n      Ds = []\n      for s in seeds:\n          Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                               k_total=k_total, metric=metric,\n                                               delta=delta, k_density=kdensity,\n\
    \                                               rng_seed=int(s))\n          Cs.append(Cg.tocsr())\n          Ds.append(Dg.tocsr())\n\n      n = Zcorr.shape[0]\n      # Frequency matrix: sum of binary connectivities\n      Cb = []\n      for c in Cs:\n          rows = np.repeat(np.arange(n), np.diff(c.indptr))\n          Cb.append(sp.csr_matrix((np.ones_like(c.data, dtype=np.float32), (rows, c.indices)), shape=(n, n)))\n      C_freq = (Cb[0] + Cb[1] + Cb[2]).tocsr()\n\n      # Assemble top-k per row by frequency, tie-break by min distance\n      rows_out, cols_out, dist_out = [], [], []\n      for i in range(n):\n          s0, e0 = C_freq.indptr[i], C_freq.indptr[i+1]\n          if e0 <= s0:\n              continue\n          neigh = C_freq.indices[s0:e0]\n          freq = C_freq.data[s0:e0]\n          min_d = np.full_like(freq, 1e9, dtype=np.float32)\n          row_dicts = []\n          for D in Ds:\n              sd, ed = D.indptr[i], D.indptr[i+1]\n              idx = D.indices[sd:ed]\n\
    \              dat = D.data[sd:ed]\n              row_dicts.append((idx, dat))\n          for t in range(len(neigh)):\n              j = neigh[t]\n              md = 1e9\n              for (idx, dat) in row_dicts:\n                  pos = np.searchsorted(idx, j)\n                  if pos < idx.size and idx[pos] == j:\n                      md = min(md, float(dat[pos]))\n              if md == 1e9:\n                  md = 1.0\n              min_d[t] = md\n          order = np.lexsort((min_d, -freq))\n          sel = order[:min(k_total, len(order))]\n          js = neigh[sel]\n          ds = min_d[sel]\n          rows_out.extend([i] * js.size)\n          cols_out.extend(js.tolist())\n          dist_out.extend(ds.tolist())\n\n      C_dir = sp.csr_matrix((np.ones(len(rows_out), dtype=np.float32), (np.array(rows_out), np.array(cols_out))), shape=(n, n))\n      D_dir = sp.csr_matrix((np.array(dist_out, dtype=np.float32), (np.array(rows_out), np.array(cols_out))), shape=(n, n))\n      C_sym,\
    \ D_sym = _symmetrize_binary_with_dist(C_dir, D_dir)\n      C_sym.eliminate_zeros(); D_sym.eliminate_zeros()\n\n      adata.obsp['connectivities'] = C_sym\n      adata.obsp['distances'] = D_sym\n      adata.uns['ensemble_daqb_multi_seed'] = dict(\n          seeds=[int(s) for s in seeds], k_total=int(k_total), kd=int(kdensity),\n          delta=float(delta), lam=float(lam), alpha_g=float(alpha_g),\n          metric=str(metric)\n      )\n      return adata\n```\n/execute_action{storage write praxis/logs/ensemble_union_topk_ridge_result.txt}\n```yaml\ncontent: |\n  Ensemble DAQB (3 seeds, union-topK) @ Heart Ridge\n  Settings: k=50, kd=22, δ=0.10, λ=0.605, α_g=0.50, metric=cosine, seeds=[0,1,2]\n  EID: 1125\n  Score: 0.7362509711712181\n  Spec-ordered vector (normalized):\n    [ASW_batch 0.659, ASW_label 0.248, ARI 0.778, NMI 0.736,\n     Graph_conn 0.967, kBET 0.790, iLISI 0.881, cLISI 0.976,\n     PCR 1.000, Cell_cycle 0.327]\n  Notes:\n  - ARI/NMI improved vs ridge reference but iLISI\
    \ collapsed to 0.881, dropping overall score.\n  - Interpretation: Union-topK across seeds disrupts density-coupled per-cell mixing targets (and symmetrization amplifies the effect).\n  - Decision: Close ensemble-union line; retain single-seed ridge with rng_seed=0.\n```\n/execute_action{storage write praxis/release_notes_ridge_v1.md}\n```yaml\ncontent: |\n  Release Notes — Heart Ridge (Praxis IV) [update: ensemble]\n  Reference (env v4.1): 0.7414 @ k=50,kd=22,δ=0.10,λ=0.605,α_g=0.5, seed=0.\n  New probe:\n  - Ensemble DAQB (3 seeds, union-topK, symmetric): EID 1125=0.7363 →\n    [0.659,0.248,0.778,0.736,0.967,0.790,0.881,0.976,1.000,0.327].\n    ARI/NMI↑ but iLISI↓ substantially; overall score↓. Line closed.\n  Summary of closed lines: k=48 lean; k=52; kd=24; reciprocity reselect; α_g micro-sweeps; HVG-source change; cap=1.8; euclidean; QPS; ensemble-union.\n  Ridge remains frozen at k=50 with rng_seed=0.\n```\n/execute_action{storage write shared/diagnostics/ridge_entries/heart_praxis_iv_v4.yaml}\n\
    ```yaml\ncontent: |\n  lineage: Praxis\n  organ: heart\n  env:\n    evaluator_version: v4.1\n    evaluator_commit: 70e35a815bd5e13221cb050bc92a7e226da6e998\n    baseline_hash: 85c3db9eff812e85dc1721d10c800e52\n    graph_symmetrization: false\n  reference:\n    score: 0.7414\n    eids: [1104, 1105]\n    vector: [0.659, 0.248, 0.765, 0.725, 0.968, 0.789, 0.961, 0.973, 1.000, 0.327]\n  config:\n    k_total: 50\n    kdensity: 22\n    delta: 0.10\n    lambda: 0.605\n    alpha_g: 0.5\n    cap: 2.0\n    metric: cosine\n    connectivities: binary\n    distances: true\n    rng_seed: 0\n  experiments:\n    - name: k=52\n      eid: 1064\n      score: 0.7421\n      vector: [0.659, 0.248, 0.773, 0.726, 0.968, 0.790, 0.958, 0.972, 1.000, 0.327]\n    - name: kdensity=24\n      eid: 1065\n      score: 0.7426\n      vector: [0.659, 0.248, 0.774, 0.728, 0.968, 0.788, 0.961, 0.973, 1.000, 0.327]\n    - name: reciprocity_reselect\n      eid: 1067\n      score: 0.7420\n      vector: [0.659, 0.248, 0.766,\
    \ 0.727, 0.967, 0.789, 0.964, 0.973, 1.000, 0.327]\n    - name: ablation_alpha_g_0.0\n      eid: 1081\n      score: 0.7363\n      vector: [0.659, 0.248, 0.761, 0.712, 0.946, 0.791, 0.952, 0.966, 1.000, 0.327]\n    - name: baseline_noFW_k50\n      eid: 1090\n      score: 0.7329\n      vector: [0.659, 0.248, 0.752, 0.706, 0.947, 0.790, 0.934, 0.966, 1.000, 0.327]\n    - name: baseline_noFW_k52\n      eid: 1111\n      score: 0.7329\n      vector: [0.659, 0.248, 0.752, 0.706, 0.947, 0.791, 0.934, 0.965, 1.000, 0.327]\n    - name: qps_symmetrization\n      eid: 1113\n      score: 0.7207\n      vector: [0.659, 0.248, 0.673, 0.688, 0.965, 0.791, 0.882, 0.972, 1.000, 0.327]\n    - name: hvgmask_ridge\n      eid: 1115\n      score: 0.7327\n      vector: [0.680, 0.242, 0.770, 0.723, 0.965, 0.741, 0.957, 0.975, 1.000, 0.274]\n    - name: graphfw_alpha_g_0.60\n      eid: 1117\n      score: 0.7304\n      vector: [0.659, 0.248, 0.674, 0.693, 0.977, 0.790, 0.963, 0.973, 1.000, 0.327]\n    - name: graphfw_alpha_g_0.40\n\
    \      eid: 1119\n      score: 0.7389\n      vector: [0.659, 0.248, 0.756, 0.713, 0.966, 0.789, 0.959, 0.972, 1.000, 0.327]\n    - name: k=48\n      eid: 1123\n      score: 0.7382\n      vector: [0.659, 0.248, 0.773, 0.728, 0.966, 0.787, 0.959, 0.973, 1.000, 0.288]\n    - name: ensemble_union_topk\n      eid: 1125\n      score: 0.7363\n      vector: [0.659, 0.248, 0.778, 0.736, 0.967, 0.790, 0.881, 0.976, 1.000, 0.327]\n  diagnostics:\n    directed_vs_undirected_gap: {eid: 1086, corr_dir: 0.984, corr_und: 0.139, mean_dir: 0.802, mean_und: 0.769, inbound_cap: 0.149}\n    inbound_entropy_by_density: {eid: 1093, overall_entropy: 0.941, cap_peak_mid_density: true}\n    synergy_knn_daqb: {eid: 1097, jaccard_median: 0.143, cbf_median_knn: 0.017, cbf_median_daqb: 0.770}\n  notes:\n    - \"Ensemble-union reduced iLISI sharply; closed per guardrails.\"\n    - \"Ridge remains frozen at k=50, kd=22, δ=0.10, λ=0.605, α_g=0.5, seed=0.\"\n```\n/execute_action{goto public_memory}\n/execute_action{reply\
    \ 7}\n```yaml\ncontent: |\n  Update — Ensemble DAQB (3-seed union-topK) @ ridge: 0.7363 (EID 1125).\n  Vector: [0.659,0.248,0.778,0.736,0.967,0.790,0.881,0.976,1.000,0.327].\n  ARI/NMI ↑ but iLISI collapsed; overall score ↓. Interpretation: union across seeds + symmetrization disrupts density-coupled per-cell targets.\n  Line closed; ridge stays frozen (k=50,kd=22,δ=0.10,λ=0.605,α_g=0.5, seed=0). Logs and ridge entry updated.\n```"
