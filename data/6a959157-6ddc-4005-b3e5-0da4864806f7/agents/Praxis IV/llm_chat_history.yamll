    \ copy=False))\n      sc.pp.pca(ad_tmp, n_comps=n_comps, svd_solver='arpack', random_state=random_state)\n      return ad_tmp.obsm['X_pca'].astype(np.float32)\n\n  def _fw_weight_by_var(Xd: np.ndarray, alpha: float) -> np.ndarray:\n      var_g = Xd.var(axis=0, ddof=1).astype(np.float32) + 1e-8\n      w = np.power(var_g, -0.5 * alpha).astype(np.float32)\n      return Xd * w\n\n  def _one_hot_batches(batches: np.ndarray):\n      cats = np.unique(batches)\n      n = batches.shape[0]\n      B = np.zeros((n, cats.size), dtype=np.float32)\n      for j, c in enumerate(cats):\n          B[:, j] = (batches == c).astype(np.float32)\n      return B, cats\n\n  def _ridge_batch_fit_predict(B: np.ndarray, Z: np.ndarray, l2: float = 1e-3):\n      BTB = B.T @ B + l2 * np.eye(B.shape[1], dtype=np.float32)\n      W = np.linalg.solve(BTB, B.T @ Z)\n      return B @ W\n\n  def _density_proxy(Zcorr: np.ndarray, k_density: int = 22, metric: str = 'cosine'):\n      nn = NearestNeighbors(n_neighbors=k_density\
    \ + 1, metric=metric, algorithm='brute')\n      nn.fit(Zcorr)\n      d_all, _ = nn.kneighbors(Zcorr, return_distance=True)\n      d_k = d_all[:, -1].astype(np.float32)\n      d_min, d_max = float(np.min(d_k)), float(np.max(d_k) + 1e-8)\n      inv_dense = 1.0 - (d_k - d_min) / (d_max - d_min + 1e-8)\n      return inv_dense\n\n  def _theoretical_f_cross(inv_dense, delta=0.10, n_batches=4, clip=(0.60,0.90)):\n      base = (n_batches - 1) / float(n_batches)\n      f = base + (inv_dense - 0.5) * 2.0 * float(delta)\n      L, U = clip\n      return np.clip(f, L, U).astype(np.float32)\n\n  def _build_directed_edges(Zcorr: np.ndarray, batches: np.ndarray, k_total=50, kdensity=22, delta=0.10, metric='cosine'):\n      # Directed quota construction (deterministic) at ridge settings\n      n = Zcorr.shape[0]\n      cats = np.unique(batches)\n      # map batch labels -> integer codes deterministically\n      batch_code_map = {val: idx for idx, val in enumerate(cats)}\n      bc_codes = np.array([batch_code_map[b]\
    \ for b in batches], dtype=np.int32)\n\n      B_other = max(len(cats) - 1, 1)\n      inv_dense = _density_proxy(Zcorr, k_density=kdensity, metric=metric)\n      f_th = _theoretical_f_cross(inv_dense, delta=delta, n_batches=len(cats), clip=(0.60,0.90))\n\n      batch_to_indices = {}\n      nn_models = {}\n      # use per-batch k_total+1 to ensure enough neighbors\n      for j, c in enumerate(cats):\n          mask = (batches == c)\n          batch_to_indices[j] = np.where(mask)[0]\n          nn = NearestNeighbors(n_neighbors=k_total + 1, metric=metric, algorithm='brute')\n          nn.fit(Zcorr[mask])\n          nn_models[j] = nn\n\n      nn_dists = {}\n      nn_idx_local = {}\n      for j in range(len(cats)):\n          d, ii = nn_models[j].kneighbors(Zcorr, return_distance=True)\n          nn_dists[j] = d\n          nn_idx_local[j] = ii\n\n      rows, cols = [], []\n\n      for i in range(n):\n          bi = int(bc_codes[i])\n          q_cross_total = int(round(f_th[i] * k_total))\n\
    \          q_within = max(0, min(k_total, int(round(k_total - q_cross_total))))\n          q_per_other = q_cross_total // B_other\n          rem = q_cross_total - q_per_other * B_other\n\n          # sort other batches by nearest distance to batch j centroids (first neighbor distance proxy)\n          other_batches = [j for j in range(len(cats)) if j != bi]\n          batch_scores = [(j, nn_dists[j][i][0]) for j in other_batches]\n          batch_scores.sort(key=lambda t: t[1])\n          q_map = {j: q_per_other for j in other_batches}\n          for k in range(rem):\n              q_map[batch_scores[k % len(other_batches)][0]] += 1\n\n          # within-batch (skip self if distance zero)\n          d_i = nn_dists[bi][i]; ii = nn_idx_local[bi][i]\n          start = 1 if d_i[0] == 0.0 else 0\n          sel = min(q_within, d_i.shape[0] - start)\n          if sel > 0:\n              cols.extend(batch_to_indices[bi][ii[start:start+sel]])\n              rows.extend([i] * sel)\n\n        \
    \  # cross-batch allocations\n          for j in other_batches:\n              d_ij = nn_dists[j][i]; ii_j = nn_idx_local[j][i]\n              sel_j = min(q_map[j], d_ij.shape[0])\n              if sel_j > 0:\n                  cols.extend(batch_to_indices[j][ii_j[:sel_j]])\n                  rows.extend([i] * sel_j)\n\n      rows = np.asarray(rows, dtype=np.int32)\n      cols = np.asarray(cols, dtype=np.int32)\n      return rows, cols\n\n  def _median_jaccard_rows_cols(rc1, rc2, n):\n      r1, c1 = rc1; r2, c2 = rc2\n      A1 = sp.coo_matrix((np.ones_like(c1, dtype=np.float32), (r1, c1)), shape=(n, n)).tocsr()\n      A2 = sp.coo_matrix((np.ones_like(c2, dtype=np.float32), (r2, c2)), shape=(n, n)).tocsr()\n      j = np.zeros(n, dtype=np.float32)\n      for i in range(n):\n          s1, e1 = A1.indptr[i], A1.indptr[i+1]\n          s2, e2 = A2.indptr[i], A2.indptr[i+1]\n          if e1 <= s1 and e2 <= s2:\n              j[i] = 1.0\n              continue\n          set1 = set(A1.indices[s1:e1].tolist())\n\
    \          set2 = set(A2.indices[s2:e2].tolist())\n          inter = len(set1.intersection(set2))\n          union = max(len(set1) + len(set2) - inter, 1)\n          j[i] = inter / union\n      return float(np.median(j)), float(np.mean(j))\n\n  def test(adata: ad.AnnData):\n      print(\"[Variance-source diagnostics] Determinism audit for directed quota construction at ridge\")\n      # Preprocess + HVGs\n      _normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch',\n                                  n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n      Xh = adata.X[:, hv]\n      Xd = (Xh.A if sp.issparse(Xh) else Xh).astype(np.float32, copy=False)\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      # Graph path residualization (α_g=0.5) at ridge\n      Xw_graph = _fw_weight_by_var(Xd, alpha=0.5)\n      Zg = _pca_array(Xw_graph, n_comps=50, random_state=0)\n\
    \      B, _ = _one_hot_batches(batches)\n      Zhat = _ridge_batch_fit_predict(B, Zg, l2=1e-3)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0).astype(np.float32)\n      lam = 0.605\n      gamma = np.minimum(0.74, lam * R2).astype(np.float32)\n      Zcorr = Zg - (Zhat * gamma[None, :])\n\n      # Build directed edges twice with identical inputs\n      rc1 = _build_directed_edges(Zcorr.astype(np.float32), batches, k_total=50, kdensity=22, delta=0.10, metric='cosine')\n      rc2 = _build_directed_edges(Zcorr.astype(np.float32), batches, k_total=50, kdensity=22, delta=0.10, metric='cosine')\n\n      # Compare via per-row Jaccard\n      n = Zcorr.shape[0]\n      j_med, j_mean = _median_jaccard_rows_cols(rc1, rc2, n)\n      print(f\"Per-row directed Jaccard between two identical builds: median={j_med:.6f}, mean={j_mean:.6f}\")\n      return {'directed_jaccard_median': j_med, 'directed_jaccard_mean':\
    \ j_mean}\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Variance-source @ Ridge (test-only): determinism of directed quota construction — fixed batch codes\"\ntags: \"diagnostics, determinism, ridge, quotas\"\nabstract: \"Re-runs the determinism audit using a local batch-label→code map (no anndata.Categorical) and reports per-row Jaccard between two directed builds with identical inputs.\"\ncontent: |\n  import sys\n  import anndata as ad\n  sys.path.append('storage/praxis')\n  from diagnostics_variance_sources_test import test as _test\n\n  def test(adata: ad.AnnData):\n      return _test(adata)\n```"
