parts:
- text: "/execute_action{goto research}\n/execute_action{storage write praxis/mpb_graphfwpca_anscombe.py}\n```yaml\ncontent: |\n  import sys\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n\n  # Ensure package roots\n  sys.path.append('storage')\n  sys.path.append('storage/praxis')\n\n  from praxis_core import normalize_log1p_inplace, pca_array, one_hot_batches, ridge_batch_fit_predict\n  from bbsg_density_adaptive import build_density_adaptive_bbsg\n\n  def _anscombe_transform(X: np.ndarray) -> np.ndarray:\n      # Anscombe VST for Poisson counts: 2*sqrt(x + 3/8)\n      return (2.0 * np.sqrt(X + 0.375)).astype(np.float32, copy=False)\n\n  def _fw_weight_by_var(Xd: np.ndarray, alpha: float) -> np.ndarray:\n      var_g = Xd.var(axis=0, ddof=1).astype(np.float32) + 1e-8\n      w = np.power(var_g, -0.5 * alpha).astype(np.float32)\n      return Xd * w\n\n  def eliminate_mpb_graphfwpca_anscombe(adata: ad.AnnData,\n                      \
    \                  alpha_emb: float = 0.5,\n                                        n_pcs_emb: int = 60,\n                                        emb_n_neighbors: int = 15,\n                                        alpha_g: float = 0.5,\n                                        n_pcs_graph: int = 50,\n                                        l2: float = 1e-3,\n                                        gamma_max: float = 0.74,\n                                        lam_override: float = 0.605,\n                                        k_total: int = 50,\n                                        kdensity: int = 22,\n                                        delta: float = 0.10,\n                                        metric: str = 'cosine',\n                                        cap: float = 2.0,\n                                        rng_seed: int = 0) -> ad.AnnData:\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n      # Normalize counts for HVG selection\
    \ only (uses log1p), per prior ridge practice\n      normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      # Dense HVGs from counts layer if available, else X (already normalized/logged but we re-fetch raw counts if present)\n      if 'counts' in adata.layers:\n          Xraw = adata.layers['counts'][:, hv]\n      else:\n          Xraw = adata.X[:, hv]\n      Xd = (Xraw.A if sp.issparse(Xraw) else Xraw).astype(np.float32, copy=False)\n\n      # Apply Anscombe variance-stabilizing transform for both embedding and graph paths\n      Xa = _anscombe_transform(Xd)\n\n      # Embedding (QC) + neighbors (not used for integration graph)\n      Xw_emb = _fw_weight_by_var(Xa, alpha=alpha_emb)\n      ad_emb = ad.AnnData(Xw_emb, obs=adata.obs[['batch']].copy())\n      sc.pp.pca(ad_emb,\
    \ n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n      # simple per-batch centering to avoid using ComBat here for generalization\n      Zemb = ad_emb.obsm['X_pca'].copy().astype(np.float32)\n      for b in np.unique(batches):\n          msk = (batches == b)\n          Zemb[msk] = Zemb[msk] - Zemb[msk].mean(axis=0, keepdims=True)\n      adata.obsm['X_emb'] = Zemb\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n      # Graph path: GraphFWPCA -> PCA -> BRBG (fixed λ) -> DAQB (binary, true distances)\n      Xw_graph = _fw_weight_by_var(Xa, alpha=alpha_g)\n      Zg = pca_array(Xw_graph, n_comps=n_pcs_graph, random_state=0)\n\n      B = one_hot_batches(batches)\n      Zhat = ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n\n      lam = float(lam_override)\n      gamma = np.minimum(gamma_max,\
    \ lam * R2).astype(np.float32)\n      Zcorr = Zg - (Zhat * gamma)\n\n      try:\n          Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                               k_total=k_total, metric=metric,\n                                               delta=delta, k_density=kdensity,\n                                               cap=cap, rng_seed=rng_seed)\n      except TypeError:\n          Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                               k_total=k_total, metric=metric,\n                                               delta=delta, k_density=kdensity,\n                                               rng_seed=rng_seed)\n      adata.obsp['connectivities'] = Cg\n      adata.obsp['distances'] = Dg\n      adata.uns['mpb_graphfwpca_anscombe'] = dict(alpha_g=float(alpha_g),\n                                                  lam_override=float(lam),\n                \
    \                                  kd=int(kdensity), delta=float(delta),\n                                                  cap=float(cap),\n                                                  k_total=int(k_total),\n                                                  rng_seed=int(rng_seed))\n      return adata\n```\n/execute_action{storage write praxis/best_mpb_daqb_kd22_k52_anscombe.py}\n```yaml\ncontent: |\n  import sys\n  import anndata as ad\n  sys.path.append('storage')\n  sys.path.append('storage/praxis')\n  from mpb_graphfwpca_anscombe import eliminate_mpb_graphfwpca_anscombe as _run\n\n  # Anscombe variant: ridge settings with k_total=52\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      print(\"[anscombe-k52] lam=0.605, delta=0.10, kd=22, k=52, alpha_g=0.5, seed=0\")\n      return _run(adata,\n                  alpha_g=0.50,\n                  lam_override=0.605,\n                  delta=0.10,\n                  kdensity=22,\n                  k_total=52,\n\
    \                  metric='cosine',\n                  cap=2.0,\n                  rng_seed=0)\n```\n/execute_action{storage write praxis/mpb_graphfwpca_anscombe_clip.py}\n```yaml\ncontent: |\n  import sys\n  import numpy as np\n  import scanpy as sc\n  import anndata as ad\n  from scipy import sparse as sp\n\n  sys.path.append('storage')\n  sys.path.append('storage/praxis')\n\n  from praxis_core import normalize_log1p_inplace, pca_array, one_hot_batches, ridge_batch_fit_predict\n  from bbsg_density_adaptive import build_density_adaptive_bbsg\n\n  # Optional clipped builder\n  try:\n      from bbsg_density_adaptive_clip import build_density_adaptive_bbsg_clip\n      HAS_CLIP = True\n  except Exception:\n      HAS_CLIP = False\n\n  def _anscombe_transform(X: np.ndarray) -> np.ndarray:\n      return (2.0 * np.sqrt(X + 0.375)).astype(np.float32, copy=False)\n\n  def _fw_weight_by_var(Xd: np.ndarray, alpha: float) -> np.ndarray:\n      var_g = Xd.var(axis=0, ddof=1).astype(np.float32) +\
    \ 1e-8\n      w = np.power(var_g, -0.5 * alpha).astype(np.float32)\n      return Xd * w\n\n  def eliminate_mpb_graphfwpca_anscombe_clip(adata: ad.AnnData,\n                                             alpha_emb: float = 0.5,\n                                             n_pcs_emb: int = 60,\n                                             emb_n_neighbors: int = 15,\n                                             alpha_g: float = 0.5,\n                                             n_pcs_graph: int = 50,\n                                             l2: float = 1e-3,\n                                             gamma_max: float = 0.74,\n                                             lam_override: float = 0.605,\n                                             k_total: int = 50,\n                                             kdensity: int = 22,\n                                             delta: float = 0.10,\n                                             metric: str = 'cosine',\n                \
    \                             cap: float = 2.0,\n                                             rng_seed: int = 0,\n                                             clip_low: float = 0.62,\n                                             clip_high: float = 0.88) -> ad.AnnData:\n      assert 'batch' in adata.obs.columns and 'feature_name' in adata.var.columns\n\n      normalize_log1p_inplace(adata, 1e4)\n      sc.pp.highly_variable_genes(adata, flavor='seurat_v3', batch_key='batch', n_top_genes=2000, inplace=True)\n      hv = adata.var['highly_variable'].to_numpy()\n      batches = np.asarray(adata.obs['batch'].astype('category').values)\n\n      if 'counts' in adata.layers:\n          Xraw = adata.layers['counts'][:, hv]\n      else:\n          Xraw = adata.X[:, hv]\n      Xd = (Xraw.A if sp.issparse(Xraw) else Xraw).astype(np.float32, copy=False)\n      Xa = _anscombe_transform(Xd)\n\n      # Embedding (QC)\n      Xw_emb = _fw_weight_by_var(Xa, alpha=alpha_emb)\n      ad_emb = ad.AnnData(Xw_emb,\
    \ obs=adata.obs[['batch']].copy())\n      sc.pp.pca(ad_emb, n_comps=n_pcs_emb, svd_solver='arpack', random_state=0)\n      Zemb = ad_emb.obsm['X_pca'].copy().astype(np.float32)\n      for b in np.unique(batches):\n          msk = (batches == b)\n          Zemb[msk] = Zemb[msk] - Zemb[msk].mean(axis=0, keepdims=True)\n      adata.obsm['X_emb'] = Zemb\n      sc.pp.neighbors(adata, use_rep='X_emb', n_neighbors=emb_n_neighbors, metric=metric)\n\n      # Graph path\n      Xw_graph = _fw_weight_by_var(Xa, alpha=alpha_g)\n      Zg = pca_array(Xw_graph, n_comps=n_pcs_graph, random_state=0)\n\n      B = one_hot_batches(batches)\n      Zhat = ridge_batch_fit_predict(B, Zg, l2=l2)\n      var_total = Zg.var(axis=0, ddof=1) + 1e-8\n      var_pred = np.maximum(Zhat.var(axis=0, ddof=1), 0.0)\n      R2 = np.clip(var_pred / var_total, 0.0, 1.0)\n\n      lam = float(lam_override)\n      gamma = np.minimum(gamma_max, lam * R2).astype(np.float32)\n      Zcorr = Zg - (Zhat * gamma)\n\n      if HAS_CLIP:\n\
    \          Cg, Dg = build_density_adaptive_bbsg_clip(Zcorr.astype(np.float32), batches=batches,\n                                                    k_total=k_total, metric=metric,\n                                                    delta=delta, k_density=kdensity,\n                                                    cap=cap, rng_seed=rng_seed,\n                                                    clip_low=clip_low, clip_high=clip_high)\n      else:\n          # Fallback: call standard builder (no-clip) to ensure robustness\n          Cg, Dg = build_density_adaptive_bbsg(Zcorr.astype(np.float32), batches=batches,\n                                               k_total=k_total, metric=metric,\n                                               delta=delta, k_density=kdensity,\n                                               cap=cap, rng_seed=rng_seed)\n      adata.obsp['connectivities'] = Cg\n      adata.obsp['distances'] = Dg\n      adata.uns['mpb_graphfwpca_anscombe_clip'] = dict(alpha_g=float(alpha_g),\n\
    \                                                       lam_override=float(lam),\n                                                       kd=int(kdensity), delta=float(delta),\n                                                       cap=float(cap),\n                                                       k_total=int(k_total),\n                                                       rng_seed=int(rng_seed),\n                                                       clip_low=float(clip_low),\n                                                       clip_high=float(clip_high),\n                                                       has_clip=bool(HAS_CLIP))\n      return adata\n```\n/execute_action{storage write praxis/best_mpb_daqb_kd22_k50_anscombe_clip6288.py}\n```yaml\ncontent: |\n  import sys\n  import anndata as ad\n  sys.path.append('storage')\n  sys.path.append('storage/praxis')\n  from mpb_graphfwpca_anscombe_clip import eliminate_mpb_graphfwpca_anscombe_clip as _run\n\n  # Anscombe variant\
    \ + quota clip [0.62, 0.88] at ridge settings\n  def eliminate_batch_effect_fn(adata: ad.AnnData) -> ad.AnnData:\n      print(\"[anscombe-clip6288] lam=0.605, delta=0.10, kd=22, k=50, alpha_g=0.5, clip=[0.62,0.88], seed=0\")\n      return _run(adata,\n                  alpha_g=0.50,\n                  lam_override=0.605,\n                  delta=0.10,\n                  kdensity=22,\n                  k_total=50,\n                  metric='cosine',\n                  cap=2.0,\n                  rng_seed=0,\n                  clip_low=0.62,\n                  clip_high=0.88)\n```\n/execute_action{submit 1}\n```yaml\ntitle: \"Anscombe variant @ ridge: k=52 (kd=22, δ=0.10, λ=0.605, α_g=0.50, seed=0)\"\ntags: \"anscombe, ridge, robustness, fixed-k, graph\"\nabstract: \"Generalization of fixed-k robustness probe to the Anscombe VST variant of the ridge: increase k_total from 50→52 with all else fixed (kd=22, δ=0.10, λ=0.605, α_g=0.50, cap=2.0). Report full 10-metric vector.\"\ncontent: |\n\
    \  import sys\n  import anndata as ad\n  sys.path.append('storage/praxis')\n  from best_mpb_daqb_kd22_k52_anscombe import eliminate_batch_effect_fn as _run\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData):\n      return _run(adata)\n```\n/execute_action{submit 1}\n```yaml\ntitle: \"Anscombe variant @ ridge: quota-clip [0.62,0.88] (kd=22, δ=0.10, λ=0.605, α_g=0.50, seed=0)\"\ntags: \"anscombe, ridge, robustness, clip, graph\"\nabstract: \"Generalization of quota-clip robustness probe to the Anscombe VST variant of the ridge: adjust clip bounds from [0.60,0.90]→[0.62,0.88] with all else fixed. Report full 10-metric vector.\"\ncontent: |\n  import sys\n  import anndata as ad\n  sys.path.append('storage/praxis')\n  from best_mpb_daqb_kd22_k50_anscombe_clip6288 import eliminate_batch_effect_fn as _run\n\n  def eliminate_batch_effect_fn(adata: ad.AnnData):\n      return _run(adata)\n```"
