    \ typing import Tuple\n\n  class ConvLSTMCell(nn.Module):\n      \"\"\"A standard ConvLSTM cell, without Layer Normalization.\"\"\"\n      features: int\n      kernel_size: Tuple[int,int] = (3,3)\n      @nn.compact\n      def __call__(self, carry, x):\n          h, c = carry\n          gates = nn.Conv(4*self.features, self.kernel_size, padding='SAME',\n                          kernel_init=nn.initializers.xavier_uniform())(jnp.concatenate([x, h], axis=-1))\n          # Removed LayerNorm from this version\n          i, f, g, o = jnp.split(gates, 4, axis=-1)\n          i = nn.sigmoid(i); f = nn.sigmoid(f); o = nn.sigmoid(o); g = jnp.tanh(g)\n          c = f * c + i * g\n          h = o * jnp.tanh(c)\n          return (h, c), h\n```"
