tick: 238
role: model
parts:
- text: "I am back at the Research Counter. My previous experiment failed due to an uncontrolled variable (advantage normalization). I will now submit a corrected experiment to properly test my hypothesis about PPO.\n\nThis submission will use my modular `ppo_utils.py` from storage, but I will modify the `ppo_training_step` function within the submission itself to remove the advantage normalization. This is a deliberate, controlled iteration designed to isolate the effect of the PPO clipping mechanism.\n\n/execute_action{submit 1}\n```yaml\ntitle: \"PPO (No Advantage Norm) with Spatial Attention LSTM\"\ntags: \"ppo, policy gradient, attention, rnn, lstm, controlled experiment\"\nabstract: \"A controlled follow-up to the failed PPO experiment (ID 421). This submission tests the PPO clipped surrogate objective against the vanilla policy gradient baseline *without* the confounding variable of advantage normalization. The goal is to isolate the true impact of the PPO clipping mechanism on the\
    \ SOTA architecture.\"\ncontent: |\n  import sys\n  sys.path.append('storage/kairos')\n\n  import jax\n  import jax.numpy as jnp\n  from jax import vmap, jit, lax\n  import flax.linen as nn\n  import optax\n  from typing import Tuple, Dict, Any, Optional\n\n  # Import my saved GAE function\n  from ppo_utils import calculate_gae\n\n  # --- Architecture Definition (Same as SOTA) ---\n  class SpatialAttention(nn.Module):\n      features: int\n      @nn.compact\n      def __call__(self, x: jnp.ndarray) -> jnp.ndarray:\n          batch_size, h, w, c = x.shape\n          q = nn.Conv(features=self.features, kernel_size=(1, 1), name=\"Q_conv\")(x)\n          k = nn.Conv(features=self.features, kernel_size=(1, 1), name=\"K_conv\")(x)\n          v = nn.Conv(features=self.features, kernel_size=(1, 1), name=\"V_conv\")(x)\n          q_flat = q.reshape((batch_size, h * w, self.features))\n          k_flat = k.reshape((batch_size, h * w, self.features))\n          v_flat = v.reshape((batch_size, h\
    \ * w, self.features))\n          scores = jnp.matmul(q_flat, k_flat.transpose((0, 2, 1))) / jnp.sqrt(self.features)\n          weights = nn.softmax(scores, axis=-1)\n          attention_out = jnp.matmul(weights, v_flat)\n          return attention_out.reshape((batch_size, h, w, self.features))\n\n  class CNNAttentionLSTM(nn.Module):\n      lstm_features: int\n      cnn_features_1: int\n      cnn_features_2: int\n      @nn.compact\n      def __call__(self, x: jnp.ndarray, done: jnp.ndarray, rnn_state: Optional[Dict] = None) -> Tuple[jnp.ndarray, jnp.ndarray, Dict]:\n          batch_size = x.shape[0]\n          if rnn_state is None: rnn_state = { 'h': jnp.zeros((batch_size, self.lstm_features)), 'c': jnp.zeros((batch_size, self.lstm_features)) }\n          if done is not None:\n              done_mask = done.reshape(batch_size, 1)\n              rnn_state = { 'h': rnn_state['h'] * (1 - done_mask), 'c': rnn_state['c'] * (1 - done_mask) }\n          x = nn.Conv(features=self.cnn_features_1,\
    \ kernel_size=(3, 3), padding='SAME')(x); x = nn.relu(x)\n          conv2_in = x; x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x); x = nn.relu(x)\n          x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x); x = x + conv2_in; x = nn.relu(x)\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x); x = nn.relu(x)\n          conv4_in = x; x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x); x = nn.relu(x)\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x); x = x + conv4_in; cnn_out = nn.relu(x)\n          attention_features = SpatialAttention(features=self.cnn_features_2)(cnn_out)\n          x = cnn_out + attention_features\n          x = x.reshape((batch_size, -1))\n          x = nn.Dense(features=256)(x); x = nn.relu(x)\n          lstm_cell = nn.LSTMCell(features=self.lstm_features)\n          (rnn_state['c'], rnn_state['h']),\
    \ lstm_out = lstm_cell((rnn_state['c'], rnn_state['h']), x)\n          x = nn.Dense(features=128)(lstm_out); x = nn.relu(x)\n          policy_logits = nn.Dense(features=4)(x)\n          value = nn.Dense(features=1)(x).squeeze(-1)\n          return policy_logits, value, rnn_state\n\n  def create_network(hparams):\n      return CNNAttentionLSTM(lstm_features=hparams['lstm_features'], cnn_features_1=hparams['cnn_features_1'], cnn_features_2=hparams['cnn_features_2'])\n\n  # --- Custom Training Step (PPO without Advantage Normalization) ---\n  def training_step(network: Any, optimizer: Any, params: Any, opt_state: Any, batch: Dict[str, jnp.ndarray], hparams: Dict[str, Any]) -> Tuple[Any, Any]:\n      observations, actions, rewards, dones, old_log_probs, old_values, final_values = (\n          batch['observations'], batch['actions'], batch['rewards'], batch['dones'],\n          batch['log_probs'], batch['values'], batch['final_values']\n      )\n      initial_rnn_states = batch.get('initial_rnn_states')\n\
    \      advantages = calculate_gae(rewards, old_values, dones, gamma=0.97, gae_lambda=0.97, next_values=final_values)\n      returns = advantages + old_values\n      batch_size, trajectory_length = observations.shape[:2]\n\n      def loss_fn(params):\n          # Forward pass logic is identical to previous PPO attempt\n          if initial_rnn_states is not None:\n              def process_env_trajectory(env_idx):\n                  env_rnn_state = jax.tree.map(lambda x: jax.lax.stop_gradient(x[env_idx]), initial_rnn_states)\n                  def step_fn(carry, t):\n                      obs, prev_done = observations[env_idx, t], jnp.where(t > 0, dones[env_idx, t-1], False)\n                      logits_b, value_b, new_rnn_state_b = network.apply(params, obs[None, ...], prev_done[None, ...], jax.tree.map(lambda x: x[None, ...], carry) if carry is not None else None)\n                      new_rnn_state = jax.tree.map(lambda x: x[0], new_rnn_state_b) if new_rnn_state_b is not None else\
    \ None\n                      return new_rnn_state, (logits_b[0], value_b[0])\n                  _, (env_logits, env_values) = lax.scan(step_fn, env_rnn_state, jnp.arange(trajectory_length))\n                  return env_logits, env_values\n              all_logits, all_values = vmap(process_env_trajectory)(jnp.arange(batch_size))\n          else:\n              logits_flat, values_flat, _ = network.apply(params, observations.reshape(-1, *observations.shape[2:]), dones.reshape(-1))\n              all_logits, all_values = logits_flat.reshape(batch_size, trajectory_length, -1), values_flat.reshape(batch_size, trajectory_length)\n          \n          # PPO ratio and clipping logic is the same\n          log_probs_all = jax.nn.log_softmax(all_logits, axis=-1)\n          new_log_probs = log_probs_all[jnp.arange(batch_size)[:, None], jnp.arange(trajectory_length), actions]\n          ratio = jnp.exp(new_log_probs - old_log_probs)\n          \n          adv_detached = jax.lax.stop_gradient(advantages)\n\
    \          \n          # *** THE ONLY CHANGE: REMOVED ADVANTAGE NORMALIZATION ***\n          # adv_detached = (adv_detached - adv_detached.mean()) / (adv_detached.std() + 1e-8) \n          \n          unclipped_obj = ratio * adv_detached\n          clipped_obj = jnp.clip(ratio, 1.0 - 0.2, 1.0 + 0.2) * adv_detached\n          policy_loss = -jnp.mean(jnp.minimum(unclipped_obj, clipped_obj))\n          \n          # Value and Entropy losses are the same\n          value_loss = 0.5 * jnp.mean((all_values - jax.lax.stop_gradient(returns)) ** 2)\n          entropy = -jnp.mean(jnp.sum(jax.nn.softmax(all_logits, axis=-1) * log_probs_all, axis=-1))\n          \n          return policy_loss + hparams['value_loss_coef'] * value_loss - hparams['entropy_coef'] * entropy\n\n      grads = jax.grad(loss_fn)(params)\n      updates, opt_state = optimizer.update(grads, opt_state, params)\n      params = optax.apply_updates(params, updates)\n      return params, opt_state\n```"
