- text: "My research log is updated. Now, I will execute the next step of my plan: applying hyperparameter tuning to my new SOTA architecture. I'll return to the Research Counter and submit the experiment.\n\n/execute_action{goto research}\n\n/execute_action{submit 1}\n```yaml\ntitle: \"HParam Tuning on Spatial Attention LSTM\"\ntags: \"attention, hyperparameter tuning, rnn, lstm, policy gradient\"\nabstract: \"Following the success of the Spatial Attention LSTM (ID 410), this submission applies hyperparameter tuning to the new SOTA architecture. A Ray Tune search space is defined for learning_rate, entropy_coef, and value_loss_coef to explore if the performance of this more capable model can be further optimized.\"\ncontent: |\n  import jax.numpy as jnp\n  import flax.linen as nn\n  from ray import tune\n  from typing import Tuple, Dict, Any, Optional\n\n  def _define_hyperparameters():\n      \"\"\"Define Ray Tune search space for key hyperparameters.\"\"\"\n      return {\n          'learning_rate':\
    \ tune.loguniform(1e-4, 1e-3),\n          'entropy_coef': tune.uniform(0.005, 0.02),\n          'value_loss_coef': tune.uniform(0.3, 0.7),\n          'cnn_features_1': tune.choice([32]),\n          'cnn_features_2': tune.choice([64]),\n          'lstm_features': tune.choice([256])\n      }\n\n  class SpatialAttention(nn.Module):\n      features: int\n      @nn.compact\n      def __call__(self, x: jnp.ndarray) -> jnp.ndarray:\n          batch_size, h, w, c = x.shape\n          q = nn.Conv(features=self.features, kernel_size=(1, 1), name=\"Q_conv\")(x)\n          k = nn.Conv(features=self.features, kernel_size=(1, 1), name=\"K_conv\")(x)\n          v = nn.Conv(features=self.features, kernel_size=(1, 1), name=\"V_conv\")(x)\n          q_flat = q.reshape((batch_size, h * w, self.features))\n          k_flat = k.reshape((batch_size, h * w, self.features))\n          v_flat = v.reshape((batch_size, h * w, self.features))\n          scores = jnp.matmul(q_flat, k_flat.transpose((0, 2, 1))) /\
    \ jnp.sqrt(self.features)\n          weights = nn.softmax(scores, axis=-1)\n          attention_out = jnp.matmul(weights, v_flat)\n          return attention_out.reshape((batch_size, h, w, self.features))\n\n  class CNNAttentionLSTM(nn.Module):\n      lstm_features: int\n      cnn_features_1: int\n      cnn_features_2: int\n      @nn.compact\n      def __call__(self, x: jnp.ndarray, done: jnp.ndarray, rnn_state: Optional[Dict] = None) -> Tuple[jnp.ndarray, jnp.ndarray, Dict]:\n          batch_size = x.shape[0]\n          if rnn_state is None:\n              rnn_state = { 'h': jnp.zeros((batch_size, self.lstm_features)), 'c': jnp.zeros((batch_size, self.lstm_features)) }\n          if done is not None:\n              done_mask = done.reshape(batch_size, 1)\n              rnn_state = { 'h': rnn_state['h'] * (1 - done_mask), 'c': rnn_state['c'] * (1 - done_mask) }\n          \n          x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n\
    \          conv2_in = x\n          x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n          x = x + conv2_in\n          x = nn.relu(x)\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          conv4_in = x\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n          x = x + conv4_in\n          cnn_out = nn.relu(x)\n\n          attention_features = SpatialAttention(features=self.cnn_features_2)(cnn_out)\n          x = cnn_out + attention_features\n          x = x.reshape((batch_size, -1))\n          x = nn.Dense(features=256)(x)\n          x = nn.relu(x)\n          \n          lstm_cell = nn.LSTMCell(features=self.lstm_features)\n\
    \          (rnn_state['c'], rnn_state['h']), lstm_out = lstm_cell((rnn_state['c'], rnn_state['h']), x)\n          \n          x = nn.Dense(features=128)(lstm_out)\n          x = nn.relu(x)\n          \n          policy_logits = nn.Dense(features=4)(x)\n          value = nn.Dense(features=1)(x).squeeze(-1)\n          \n          return policy_logits, value, rnn_state\n\n  def create_network(hparams):\n      return CNNAttentionLSTM(\n          lstm_features=hparams['lstm_features'],\n          cnn_features_1=hparams['cnn_features_1'],\n          cnn_features_2=hparams['cnn_features_2']\n      )\n```"
