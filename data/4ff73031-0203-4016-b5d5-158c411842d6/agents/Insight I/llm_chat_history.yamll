    \  from ray import tune\n  \n  def _define_hyperparameters():\n      \"\"\"\n      Define Ray Tune search space for hyperparameters.\n      Using the same hyperparameter ranges as the initial baseline for a fair comparison\n      of the architectural change.\n      \"\"\"\n      return {\n          'learning_rate': tune.choice([4e-4]),\n          'entropy_coef': tune.uniform(0.008, 0.012),\n          'value_loss_coef': tune.uniform(0.4, 0.6),\n          'cnn_features_1': tune.choice([32]),\n          'cnn_features_2': tune.choice([64]),\n          'lstm_features': tune.choice([256])\n      }\n  \n  class CNNLSTM_MaskedSpatialAttention(nn.Module):\n      \"\"\"\n      CNN + LSTM with Masked Spatial Attention for Sokoban.\n      Inserts a spatial attention mechanism after the final CNN block that masks\n      features before flattening, instead of reducing spatial dimensions.\n      \"\"\"\n      lstm_features: int\n      cnn_features_1: int\n      cnn_features_2: int\n      \n      @nn.compact\n\
    \      def __call__(self, x: jnp.ndarray, done: jnp.ndarray, rnn_state: Optional[Dict] = None) -> Tuple[jnp.ndarray, jnp.ndarray, Dict]:\n          batch_size = x.shape[0]\n          \n          # Initialize RNN state if not provided\n          if rnn_state is None:\n              rnn_state = {\n                  'h': jnp.zeros((batch_size, self.lstm_features)),\n                  'c': jnp.zeros((batch_size, self.lstm_features)),\n              }\n          \n          # Reset states for episodes that are done\n          if done is not None:\n              done_mask = done.reshape(batch_size, 1)\n              rnn_state = {\n                  'h': rnn_state['h'] * (1 - done_mask),\n                  'c': rnn_state['c'] * (1 - done_mask),\n              }\n          \n          # CNN architecture (same as DefaultResidualCNN)\n          # First convolutional block\n          x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n   \
    \       \n          # Second block with residual connection\n          conv2_in = x\n          x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n          x = x + conv2_in\n          x = nn.relu(x)\n          \n          # Third block - increase channels\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          \n          # Fourth block with residual connection\n          conv4_in = x\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n          x = x + conv4_in\n          x = nn.relu(x)\n          \n          # --- Masked Spatial Attention Mechanism ---\n          # x_cnn_out has shape (batch_size, H, W, C_cnn_out)\n\
    \          \n          # 1. Generate attention scores\n          attention_scores = nn.Conv(features=1, kernel_size=(1,1), name=\"spatial_attention_scores\")(x) # (B, H, W, 1)\n          \n          # 2. Apply sigmoid to create a spatial mask\n          attention_mask = jax.nn.sigmoid(attention_scores) # (B, H, W, 1)\n          \n          # 3. Apply mask to original feature map\n          attended_features = x * attention_mask # (B, H, W, C_cnn_out)\n          \n          # Now flatten the attended features, preserving spatial dimensions (H*W*C)\n          x = attended_features.reshape((batch_size, -1))\n          \n          # Shared MLP backbone\n          x = nn.Dense(features=256)(x)\n          x = nn.relu(x)\n          \n          # LSTM layer on top of CNN features\n          lstm_cell = nn.LSTMCell(\n              features=self.lstm_features,\n              kernel_init=nn.initializers.xavier_uniform(),\n              recurrent_kernel_init=nn.initializers.xavier_uniform()\n  \
    \        )\n          (rnn_state['c'], rnn_state['h']), lstm_out = lstm_cell((rnn_state['c'], rnn_state['h']), x)\n          \n          # Small MLP after LSTM\n          x = nn.Dense(features=128)(lstm_out)\n          x = nn.relu(x)\n          \n          # Policy and value heads\n          policy_logits = nn.Dense(features=4)(x)\n          value = nn.Dense(features=1)(x).squeeze(-1)\n          \n          return policy_logits, value, rnn_state\n  \n  def create_network(hparams):\n      \"\"\"Create CNN-LSTM network architecture with masked spatial attention.\"\"\"\n      return CNNLSTM_MaskedSpatialAttention(\n          lstm_features=hparams['lstm_features'],\n          cnn_features_1=hparams['cnn_features_1'],\n          cnn_features_2=hparams['cnn_features_2']\n      )\n  \n  # Uses system default training step and optimizer\n```"
