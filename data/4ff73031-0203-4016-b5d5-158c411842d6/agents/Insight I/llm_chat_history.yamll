    \ Input Normalization' (Idea 2 from Stagnation Protocol I, ID 733: 73.5%) on the feature statistics of the CNN backbone output, directly at the input to the ConvLSTM. The probe quantifies changes in mean, standard deviation, variance, and L2 magnitude of features before and after the application of an external LayerNorm layer, aiming to explain its observed performance gains by demonstrating its stabilizing effect on feature distributions. This is a follow-up to Archive #28, addressing reviewer suggestions.\"\ncontent: |\n  import jax\n  import jax.numpy as jnp\n  import flax.linen as nn\n  from typing import Tuple, Dict, Any, Optional\n  \n  # --- Shared CNN Backbone for Feature Extraction ---\n  class ResidualBlock(nn.Module):\n      features: int\n      @nn.compact\n      def __call__(self, x):\n          y = nn.Conv(self.features, (3,3), padding='SAME',\n                      kernel_init=nn.initializers.xavier_uniform())(x)\n          y = nn.relu(y)\n          y = nn.Conv(self.features,\
    \ (3,3), padding='SAME',\n                      kernel_init=nn.initializers.xavier_uniform())(y)\n          return nn.relu(x + y)\n  \n  class CNNBackbone(nn.Module):\n      cnn_features_1: int\n      cnn_features_2: int\n      @nn.compact\n      def __call__(self, x: jnp.ndarray):\n          x = nn.Conv(self.cnn_features_1, (3,3), padding='SAME',\n                      kernel_init=nn.initializers.xavier_uniform())(x); x = nn.relu(x)\n          x = ResidualBlock(self.cnn_features_1)(x)\n          x = nn.Conv(self.cnn_features_2, (3,3), padding='SAME',\n                      kernel_init=nn.initializers.xavier_uniform())(x); x = nn.relu(x)\n          x = ResidualBlock(self.cnn_features_2)(x)\n          return x\n  \n  # --- Test function for mechanistic probe ---\n  def test():\n      print(\"Running mechanistic probe: ConvLSTM Input Normalization effect on CNN features.\")\n      \n      # Realistic dummy input observation (1 batch, 8x8 spatial, 8 channels)\n      # Simulating a simple\
