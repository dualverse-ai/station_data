- text: "/execute_action{submit 1}\n```yaml\ntitle: \"PG — 5‑step LN‑ConvLSTM (width=56, vlc=0.55) — grad‑clip=0.8\"\ntags: \"policy gradient, convlstm, recurrent depth, gradient clipping\"\nabstract: \"5‑step with width=56 and value_loss_coef=0.55 (best 5‑step config so far), testing tighter global grad‑clip=0.8 via custom create_optimizer. Other settings: Adam lr=4e‑4, entropy=0.01, GAE 0.97/0.97. Default training_step is used.\"\ncontent: |\n  import sys\n  sys.path.append('storage/zephyr')\n  from submissions.submission_pg_quadstep import PG_Stepped_AttnGap\n  from ray import tune\n  import optax\n\n  BASE_SEED = 42\n  GRAD_CLIP = 0.8  # tighter clip\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': tune.choice([4e-4]),\n          'entropy_coef': tune.choice([0.01]),\n          'value_loss_coef': tune.choice([0.55]),\n          'cnn_features_1': tune.choice([32]),\n          'cnn_features_2': tune.choice([64]),\n          'convlstm_features': tune.choice([56]),\n\
    \          'dilation': tune.choice([6]),\n          'bottleneck_ratio': tune.choice([0.28]),\n          'head_hidden': tune.choice([64]),\n          'steps': tune.choice([5]),\n      }\n\n  def create_network(hparams):\n      return PG_Stepped_AttnGap(\n          cnn_features_1=int(hparams['cnn_features_1']),\n          cnn_features_2=int(hparams['cnn_features_2']),\n          convlstm_features=int(hparams['convlstm_features']),\n          dilation=int(hparams['dilation']),\n          bottleneck_ratio=float(hparams['bottleneck_ratio']),\n          head_hidden=int(hparams['head_hidden']),\n          steps=int(hparams['steps']),\n      )\n\n  def create_optimizer(learning_rate: float = 4e-4):\n      # Use constant grad clip (submission-specific) to avoid modifying training_step signature.\n      return optax.chain(optax.clip_by_global_norm(GRAD_CLIP), optax.adam(learning_rate))\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"PG — 5‑step LN‑ConvLSTM (width=56, vlc=0.55) — grad‑clip=1.2\"\
    \ntags: \"policy gradient, convlstm, recurrent depth, gradient clipping\"\nabstract: \"5‑step with width=56 and value_loss_coef=0.55 (best 5‑step config so far), testing looser global grad‑clip=1.2 via custom create_optimizer. Other settings: Adam lr=4e‑4, entropy=0.01, GAE 0.97/0.97. Default training_step is used.\"\ncontent: |\n  import sys\n  sys.path.append('storage/zephyr')\n  from submissions.submission_pg_quadstep import PG_Stepped_AttnGap\n  from ray import tune\n  import optax\n\n  BASE_SEED = 42\n  GRAD_CLIP = 1.2  # looser clip\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': tune.choice([4e-4]),\n          'entropy_coef': tune.choice([0.01]),\n          'value_loss_coef': tune.choice([0.55]),\n          'cnn_features_1': tune.choice([32]),\n          'cnn_features_2': tune.choice([64]),\n          'convlstm_features': tune.choice([56]),\n          'dilation': tune.choice([6]),\n          'bottleneck_ratio': tune.choice([0.28]),\n          'head_hidden':\
    \ tune.choice([64]),\n          'steps': tune.choice([5]),\n      }\n\n  def create_network(hparams):\n      return PG_Stepped_AttnGap(\n          cnn_features_1=int(hparams['cnn_features_1']),\n          cnn_features_2=int(hparams['cnn_features_2']),\n          convlstm_features=int(hparams['convlstm_features']),\n          dilation=int(hparams['dilation']),\n          bottleneck_ratio=float(hparams['bottleneck_ratio']),\n          head_hidden=int(hparams['head_hidden']),\n          steps=int(hparams['steps']),\n      )\n\n  def create_optimizer(learning_rate: float = 4e-4):\n      # Use constant grad clip (submission-specific) to avoid modifying training_step signature.\n      return optax.chain(optax.clip_by_global_norm(GRAD_CLIP), optax.adam(learning_rate))\n```"
