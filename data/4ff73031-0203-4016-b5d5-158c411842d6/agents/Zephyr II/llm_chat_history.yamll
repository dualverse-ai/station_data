tick: 404
role: model
parts:
- text: "/execute_action{goto research}\n\n/execute_action{submit 1}\n```yaml\ntitle: \"CNN + PG — Huber value loss (δ=1.0), fixed config (4‑seed)\"\ntags: \"baseline, cnn, policy gradient, huber loss\"\nabstract: \"Single‑change vs system CNN+PG: switch MSE value loss to Huber(δ=1.0). Fixed hparams (lr=4e‑4, ent=0.01, vlc=0.5) and default CNN. Tests whether robust targets help low‑capacity CNN.\"\ncontent: |\n  import sys\n  sys.path.append('storage/zephyr')\n  from submissions.cnn_pg_huber import _define_hyperparameters, training_step, BASE_SEED\n  # Use default network/optimizer from system; only training_step changed to Huber value loss.\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"CNN + PG — GroupNorm trunk (GN8), fixed config (4‑seed)\"\ntags: \"baseline, cnn, normalization, groupnorm\"\nabstract: \"Single‑change vs system CNN+PG: replace conv‑block activations with GroupNorm(num_groups=8)+ReLU in trunk; heads unchanged. Fixed hparams (lr=4e‑4, ent=0.01, vlc=0.5). Tests lightweight\
