- text: "/execute_action{goto research}\n/execute_action{submit 1}\n```yaml\ntitle: \"Cosine LR schedule (5% warmup, end 0.1×) — no-time, wd=0.0 (BASE_SEED=42)\"\ntags: \"lr-schedule, warmup, cosine, ablation, double-step, convlstm\"\nabstract: \"Replace constant LR with warmup+cosine decay on the PG default (no-time). Keep wd=0.0 and all other settings fixed to isolate schedule effects. BASE_SEED=42.\"\ncontent: |\n  import sys\n  sys.path.append('storage/zephyr/submissions')\n  from double_step_notime_core import create_network as base_create_network\n  from ray import tune\n  import optax\n\n  BASE_SEED = 42\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': tune.choice([4e-4]),   # match ID 394 baseline (wd=0.0)\n          'entropy_coef': tune.choice([0.01]),\n          'value_loss_coef': tune.choice([0.5]),\n          'cnn_features_1': tune.choice([32]),\n          'cnn_features_2': tune.choice([64]),\n          'conv_lstm_features': tune.choice([64]),\n\
    \          'dilation': tune.choice([6]),\n          'bottleneck_ratio': tune.choice([0.28]),\n      }\n\n  def create_network(hparams):\n      return base_create_network(hparams)\n\n  def create_optimizer(learning_rate: float = 4e-4):\n      total_updates = 39062\n      warmup_steps = int(0.05 * total_updates)        # 5% warmup\n      decay_steps  = max(1, total_updates - warmup_steps)\n      schedule = optax.warmup_cosine_decay_schedule(\n          init_value=0.0,\n          peak_value=learning_rate,\n          warmup_steps=warmup_steps,\n          decay_steps=decay_steps,\n          end_value=learning_rate * 0.1,\n      )\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adamw(learning_rate=schedule, weight_decay=0.0),\n      )\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"Cosine LR schedule (5% warmup, end 0.1×) — time, wd=0.0 (BASE_SEED=42)\"\ntags: \"lr-schedule, warmup, cosine, ablation, double-step, convlstm\"\nabstract: \"Replace constant\
    \ LR with warmup+cosine decay on the PG default (time-injected). Keep wd=0.0 and all other settings fixed to isolate schedule effects. BASE_SEED=42.\"\ncontent: |\n  import sys\n  sys.path.append('storage/zephyr/submissions')\n  from double_step_time_core import create_network as base_create_network\n  from ray import tune\n  import optax\n\n  BASE_SEED = 42\n\n  def _define_hyperparameters():\n      return {\n          'learning_rate': tune.choice([5e-4]),   # match ID 395 baseline (wd=0.0)\n          'entropy_coef': tune.choice([0.01]),\n          'value_loss_coef': tune.choice([0.5]),\n          'cnn_features_1': tune.choice([32]),\n          'cnn_features_2': tune.choice([64]),\n          'conv_lstm_features': tune.choice([64]),\n          'dilation': tune.choice([6]),\n          'bottleneck_ratio': tune.choice([0.28]),\n      }\n\n  def create_network(hparams):\n      return base_create_network(hparams)\n\n  def create_optimizer(learning_rate: float = 5e-4):\n      total_updates\
    \ = 39062\n      warmup_steps = int(0.05 * total_updates)        # 5% warmup\n      decay_steps  = max(1, total_updates - warmup_steps)\n      schedule = optax.warmup_cosine_decay_schedule(\n          init_value=0.0,\n          peak_value=learning_rate,\n          warmup_steps=warmup_steps,\n          decay_steps=decay_steps,\n          end_value=learning_rate * 0.1,\n      )\n      return optax.chain(\n          optax.clip_by_global_norm(1.0),\n          optax.adamw(learning_rate=schedule, weight_decay=0.0),\n      )\n```"
