parts:
- text: "GroupNorm helped (53.6), while stacked GN hurt (38.4). I’ll submit two focused variants: GN + forget-gate bias (to encourage retention) and GN+FB with attention pooling. First, save the network variants to lineage storage.\n\n/execute_action{goto research}\n/execute_action{storage write zephyr/networks/cnn_convlstm_variants.py}\n```yaml\ncontent: |\n  import jax.numpy as jnp\n  import flax.linen as nn\n  from typing import Tuple, Dict, Any, Optional\n\n  class ResidualBlock(nn.Module):\n      features: int\n      @nn.compact\n      def __call__(self, x):\n          y = nn.Conv(self.features, (3, 3), padding='SAME',\n                      kernel_init=nn.initializers.xavier_uniform())(x)\n          y = nn.relu(y)\n          y = nn.Conv(self.features, (3, 3), padding='SAME',\n                      kernel_init=nn.initializers.xavier_uniform())(y)\n          return nn.relu(x + y)\n\n  class ConvLSTMCellGNFB(nn.Module):\n      \"\"\"ConvLSTM cell with GroupNorm on gates and positive forget-gate\
    \ bias.\"\"\"\n      features: int\n      num_groups: int = 8\n      f_bias: float = 1.0\n      kernel_size: Tuple[int, int] = (3, 3)\n\n      @nn.compact\n      def __call__(self, carry, x):\n          h, c = carry  # (B,H,W,C)\n          gates = nn.Conv(\n              features=4 * self.features,\n              kernel_size=self.kernel_size,\n              padding='SAME',\n              kernel_init=nn.initializers.xavier_uniform()\n          )(jnp.concatenate([x, h], axis=-1))\n          gates = nn.GroupNorm(num_groups=self.num_groups)(gates)\n          i, f, g, o = jnp.split(gates, 4, axis=-1)\n          i = nn.sigmoid(i)\n          f = nn.sigmoid(f + self.f_bias)  # forget bias\n          o = nn.sigmoid(o)\n          g = jnp.tanh(g)\n          c = f * c + i * g\n          h = o * jnp.tanh(c)\n          return (h, c), h\n\n  class CNNConvLSTMGNFB(nn.Module):\n      \"\"\"Residual CNN + 1x ConvLSTM (GN + forget-bias) with MLP heads.\"\"\"\n      cnn_features_1: int\n      cnn_features_2:\
    \ int\n      conv_lstm_features: int\n      num_groups: int = 8\n      f_bias: float = 1.0\n\n      @nn.compact\n      def __call__(self, x: jnp.ndarray, done: jnp.ndarray, rnn_state: Optional[Dict] = None):\n          B = x.shape[0]\n          x = nn.Conv(self.cnn_features_1, (3,3), padding='SAME',\n                      kernel_init=nn.initializers.xavier_uniform())(x); x = nn.relu(x)\n          x = ResidualBlock(self.cnn_features_1)(x)\n          x = nn.Conv(self.cnn_features_2, (3,3), padding='SAME',\n                      kernel_init=nn.initializers.xavier_uniform())(x); x = nn.relu(x)\n          x = ResidualBlock(self.cnn_features_2)(x)\n\n          if rnn_state is None:\n              zeros = lambda: jnp.zeros((B, 8, 8, self.conv_lstm_features), dtype=x.dtype)\n              rnn_state = {'h': zeros(), 'c': zeros()}\n          if done is not None:\n              m = (1.0 - done.reshape(B,1,1,1).astype(x.dtype))\n              rnn_state = {'h': rnn_state['h'] * m, 'c': rnn_state['c']\
    \ * m}\n\n          (h_new, c_new), h_out = ConvLSTMCellGNFB(\n              self.conv_lstm_features, num_groups=self.num_groups, f_bias=self.f_bias\n          )((rnn_state['h'], rnn_state['c']), x)\n          rnn_state = {'h': h_new, 'c': c_new}\n\n          z = h_out.reshape((B, -1))\n          z = nn.Dense(256, kernel_init=nn.initializers.xavier_uniform())(z); z = nn.relu(z)\n          pol_h = nn.Dense(64, kernel_init=nn.initializers.xavier_uniform())(z); pol_h = nn.relu(pol_h)\n          policy_logits = nn.Dense(4, kernel_init=nn.initializers.xavier_uniform())(pol_h)\n          val_h = nn.Dense(64, kernel_init=nn.initializers.xavier_uniform())(z); val_h = nn.relu(val_h)\n          value = nn.Dense(1, kernel_init=nn.initializers.xavier_uniform())(val_h).squeeze(-1)\n          return policy_logits, value, rnn_state\n\n  class CNNConvLSTMGNFB_Attn(nn.Module):\n      \"\"\"\n      Residual CNN + 1x ConvLSTM (GN+FB), with spatial attention pooling\n      instead of flattening. Attention\
    \ is general (no Sokoban-specific logic).\n      \"\"\"\n      cnn_features_1: int\n      cnn_features_2: int\n      conv_lstm_features: int\n      num_groups: int = 8\n      f_bias: float = 1.0\n\n      @nn.compact\n      def __call__(self, x: jnp.ndarray, done: jnp.ndarray, rnn_state: Optional[Dict] = None):\n          B = x.shape[0]\n          x = nn.Conv(self.cnn_features_1, (3,3), padding='SAME',\n                      kernel_init=nn.initializers.xavier_uniform())(x); x = nn.relu(x)\n          x = ResidualBlock(self.cnn_features_1)(x)\n          x = nn.Conv(self.cnn_features_2, (3,3), padding='SAME',\n                      kernel_init=nn.initializers.xavier_uniform())(x); x = nn.relu(x)\n          x = ResidualBlock(self.cnn_features_2)(x)\n\n          if rnn_state is None:\n              zeros = lambda: jnp.zeros((B, 8, 8, self.conv_lstm_features), dtype=x.dtype)\n              rnn_state = {'h': zeros(), 'c': zeros()}\n          if done is not None:\n              m = (1.0 - done.reshape(B,1,1,1).astype(x.dtype))\n\
    \              rnn_state = {'h': rnn_state['h'] * m, 'c': rnn_state['c'] * m}\n\n          (h_new, c_new), h_out = ConvLSTMCellGNFB(\n              self.conv_lstm_features, num_groups=self.num_groups, f_bias=self.f_bias\n          )((rnn_state['h'], rnn_state['c']), x)\n          rnn_state = {'h': h_new, 'c': c_new}\n\n          # Spatial attention pooling\n          attn_logits = nn.Conv(1, (1,1), padding='SAME',\n                                kernel_init=nn.initializers.xavier_uniform())(h_out)\n          attn_logits = attn_logits.reshape((B, -1))  # (B, H*W)\n          attn = nn.softmax(attn_logits, axis=-1)\n          H = W = 8\n          h_flat = h_out.reshape((B, H*W, self.conv_lstm_features))  # (B, HW, C)\n          z = jnp.einsum('bij,bi->bj', h_flat, attn)  # (B, C)\n\n          z = nn.Dense(256, kernel_init=nn.initializers.xavier_uniform())(z); z = nn.relu(z)\n          pol_h = nn.Dense(64, kernel_init=nn.initializers.xavier_uniform())(z); pol_h = nn.relu(pol_h)\n      \
    \    policy_logits = nn.Dense(4, kernel_init=nn.initializers.xavier_uniform())(pol_h)\n          val_h = nn.Dense(64, kernel_init=nn.initializers.xavier_uniform())(z); val_h = nn.relu(val_h)\n          value = nn.Dense(1, kernel_init=nn.initializers.xavier_uniform())(val_h).squeeze(-1)\n          return policy_logits, value, rnn_state\n\n  __all__ = [\n      \"ResidualBlock\",\n      \"ConvLSTMCellGNFB\",\n      \"CNNConvLSTMGNFB\",\n      \"CNNConvLSTMGNFB_Attn\",\n  ]\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"ConvLSTM + GroupNorm + ForgetBias (default PG)\"\ntags: \"architecture, convlstm, groupnorm, forget bias, policy gradient\"\nabstract: \"Add GroupNorm on ConvLSTM gates and a positive forget-gate bias to encourage stable memory retention under default PG. Architecture-only change; hyperparameters fixed.\"\ncontent: |\n  import sys\n  sys.path.append('storage/zephyr')\n  from networks.cnn_convlstm_variants import CNNConvLSTMGNFB\n\n  def _define_hyperparameters():\n\
    \      from ray import tune\n      return {\n          'learning_rate': tune.choice([4e-4]),\n          'entropy_coef': tune.choice([0.01]),\n          'value_loss_coef': tune.choice([0.5]),\n          'cnn_features_1': tune.choice([32]),\n          'cnn_features_2': tune.choice([64]),\n          'conv_lstm_features': tune.choice([64]),\n      }\n\n  def create_network(hparams):\n      return CNNConvLSTMGNFB(\n          cnn_features_1=hparams['cnn_features_1'],\n          cnn_features_2=hparams['cnn_features_2'],\n          conv_lstm_features=hparams['conv_lstm_features'],\n          num_groups=8,\n          f_bias=1.0,\n      )\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"ConvLSTM + GN+FB + Attention pooling (default PG)\"\ntags: \"architecture, convlstm, attention, groupnorm, forget bias, policy gradient\"\nabstract: \"Replace flattening with spatial attention pooling over ConvLSTM states to emphasize salient spatial memory, with GroupNorm and forget-gate bias. Algorithm and\
    \ hparams fixed to defaults.\"\ncontent: |\n  import sys\n  sys.path.append('storage/zephyr')\n  from networks.cnn_convlstm_variants import CNNConvLSTMGNFB_Attn\n\n  def _define_hyperparameters():\n      from ray import tune\n      return {\n          'learning_rate': tune.choice([4e-4]),\n          'entropy_coef': tune.choice([0.01]),\n          'value_loss_coef': tune.choice([0.5]),\n          'cnn_features_1': tune.choice([32]),\n          'cnn_features_2': tune.choice([64]),\n          'conv_lstm_features': tune.choice([64]),\n      }\n\n  def create_network(hparams):\n      return CNNConvLSTMGNFB_Attn(\n          cnn_features_1=hparams['cnn_features_1'],\n          cnn_features_2=hparams['cnn_features_2'],\n          conv_lstm_features=hparams['conv_lstm_features'],\n          num_groups=8,\n          f_bias=1.0,\n      )\n```"
