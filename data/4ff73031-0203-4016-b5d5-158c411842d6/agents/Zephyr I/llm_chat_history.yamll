    \ `cnn_features_2=128`, `conv_lstm_features=64`, omits explicit feature engineering, and adopts the `AdamW` optimizer with Xavier initialization. This tests the synergy of efficient spatial feature extraction (Bottleneck CNN) with advanced temporal reasoning (Double-Step ConvLSTM) to push the performance frontier in Sokoban RL.\n**Score:** 82.6\n**Evaluation Details:** Individual seed scores: [0.823, 0.862, 0.821, 0.798]\nMean: 0.826, Std: 0.023\nBest trial: 2 (0.862)\nBest trial hyperparameters:\n  learning_rate: 0.000400\n  entropy_coef: 0.010000\n  value_loss_coef: 0.500000\n  cnn_features_1: 64.000000\n  cnn_features_2: 128.000000\n  conv_lstm_features: 64.000000\n\n**Submission Code:**\n```python\nimport jax\nimport jax.numpy as jnp\nimport flax.linen as nn\nimport optax\nfrom ray import tune\nfrom typing import Tuple, Dict, Any, Optional\nfrom jax import vmap, lax\n\n# Define a base seed for reproducibility.\nBASE_SEED = 42\n\ndef _define_hyperparameters():\n    \"\"\"\n    Define\
    \ hyperparameters for this experiment, adapting Krono I's Double-Step SOTA.\n    \"\"\"\n    return {\n        'learning_rate': tune.choice([4e-4]),\n        'entropy_coef': tune.choice([0.01]),\n        'value_loss_coef': tune.choice([0.5]),\n        'cnn_features_1': tune.choice([64]),  # From Eval ID 196\n        'cnn_features_2': tune.choice([128]), # From Eval ID 196\n        'conv_lstm_features': tune.choice([64]), # From Eval ID 196 / Krono I's SOTA\n    }\n\n# engineer_features is not used in this architecture.\n@jax.jit\ndef engineer_features(obs):\n    \"\"\"\n    (Not used in this specific experiment's `DoubleStepBottleneckSotaNet` class)\n    Implements advanced feature engineering ('push destination' channels).\n    \"\"\"\n    agent_ch = obs[..., 3] + obs[..., 5]\n    box_ch = obs[..., 4] + obs[..., 6]\n    empty_ch = obs[..., 0] + obs[..., 2]\n    \n    agent_left = lax.slice_in_dim(agent_ch, 0, 6, axis=1)\n    box_mid_lr = lax.slice_in_dim(box_ch, 1, 7, axis=1)\n    empty_right\
    \ = lax.slice_in_dim(empty_ch, 2, 8, axis=1)\n    push_right_pattern = agent_left * box_mid_lr * empty_right\n    push_right_ch = jnp.pad(push_right_pattern, ((0,0), (1,1)))\n\n    agent_right = lax.slice_in_dim(agent_ch, 2, 8, axis=1)\n    empty_left = lax.slice_in_dim(empty_ch, 0, 6, axis=1)\n    push_left_pattern = agent_right * box_mid_lr * empty_left\n    push_left_ch = jnp.pad(push_left_pattern, ((0,0), (1,1)))\n\n    agent_below = lax.slice_in_dim(agent_ch, 2, 8, axis=0)\n    box_mid_ud = lax.slice_in_dim(box_ch, 1, 7, axis=0)\n    empty_above = lax.slice_in_dim(empty_ch, 0, 6, axis=0)\n    push_up_pattern = agent_below * box_mid_ud * empty_above\n    push_up_ch = jnp.pad(push_up_pattern, ((1,1), (0,0)))\n\n    agent_above = lax.slice_in_dim(agent_ch, 0, 6, axis=0)\n    empty_below = lax.slice_in_dim(empty_ch, 2, 8, axis=0)\n    push_down_pattern = agent_above * box_mid_ud * empty_below\n    push_down_ch = jnp.pad(push_down_pattern, ((1,1), (0,0)))\n    \n    return jnp.concatenate([obs,\
    \ push_up_ch[...,None], push_right_ch[...,None], push_down_ch[...,None], push_left_ch[...,None]], axis=-1)\n\nclass ConvLSTMCellLN(nn.Module): # Re-defined from Nomos I's Eval ID 102\n    features: int\n    @nn.compact\n    def __call__(self, carry, x):\n        h, c = carry\n        gates = nn.Conv(4*self.features, (3,3), padding='SAME', kernel_init=nn.initializers.xavier_uniform())(jnp.concatenate([x, h], axis=-1))\n        gates = nn.LayerNorm(epsilon=1e-5)(gates)\n        i,f,g,o = jnp.split(gates, 4, axis=-1)\n        i,f,o = nn.sigmoid(i), nn.sigmoid(f), nn.sigmoid(o); g = jnp.tanh(g)\n        new_c = f * c + i * g\n        new_h = o * jnp.tanh(new_c)\n        return (new_h, new_c), new_h\n\nclass BottleneckBlock(nn.Module): # From Krono I's bottleneck_sota.py\n    features: int\n    @nn.compact\n    def __call__(self, x):\n        y = nn.Conv(self.features // 4, (1,1), padding='SAME', kernel_init=nn.initializers.xavier_uniform())(x); y = nn.relu(y)\n        y = nn.Conv(self.features\
    \ // 4, (3,3), padding='SAME', kernel_init=nn.initializers.xavier_uniform())(y); y = nn.relu(y)\n        y = nn.Conv(self.features, (1,1), padding='SAME', kernel_init=nn.initializers.xavier_uniform())(y)\n        return nn.relu(x + y)\n\nclass DoubleStepBottleneckSotaNet(nn.Module): # Adapted from Krono I's UltimateNetV2Fixed\n    cnn_features_1: int; cnn_features_2: int; conv_lstm_features: int\n\n    @nn.compact\n    def __call__(self, x: jnp.ndarray, done: Optional[jnp.ndarray], rnn_state: Optional[Tuple[jnp.ndarray, jnp.ndarray]] = None):\n        B, H, W, _ = x.shape\n        # NO FEATURE ENGINEERING: directly use raw 8-channel observation\n        x_input_cnn = x \n\n        # 1. Wide CNN Backbone with Bottleneck Blocks (with Xavier init)\n        x = nn.Conv(self.cnn_features_1, (3,3), padding='SAME', kernel_init=nn.initializers.xavier_uniform())(x_input_cnn); x = nn.relu(x)\n        x = BottleneckBlock(self.cnn_features_1)(x)\n        x = nn.Conv(self.cnn_features_2, (3,3), padding='SAME',\
    \ kernel_init=nn.initializers.xavier_uniform())(x); x = nn.relu(x)\n        x = BottleneckBlock(self.cnn_features_2)(x)\n        \n        # 2. Double-Step ConvLSTM - Adopted from Krono I's UltimateNetV2Fixed\n        if rnn_state is None:\n            rnn_state = (jnp.zeros((B,H,W,self.conv_lstm_features), dtype=x.dtype), jnp.zeros((B,H,W,self.conv_lstm_features), dtype=x.dtype))\n        if done is not None:\n            m = (1.0 - done.reshape(B,1,1,1).astype(x.dtype)); rnn_state = jax.tree.map(lambda y: y*m, rnn_state)\n        \n        lstm_cell = ConvLSTMCellLN(self.conv_lstm_features)\n        # First step - using original CNN output x\n        rnn_state_1, h_out_1 = lstm_cell(rnn_state, x)\n        # Second step - Fixed by Krono I to still use original x, not h_out_1\n        rnn_state_2, h_out_2 = lstm_cell(rnn_state_1, x)\n        new_rnn_state = rnn_state_2\n\n        # 3. Standard Attention Pooling\n        attn_logits = nn.Conv(1, (1,1), padding='SAME', kernel_init=nn.initializers.xavier_uniform())(h_out_2)\n\
    \        attn_weights = nn.softmax(attn_logits.reshape(B, -1), axis=-1)\n        z = jnp.einsum('bhwc,bhw->bc', h_out_2, attn_weights.reshape(B, H, W))\n        \n        # 4. Final MLP Heads\n        z = nn.Dense(256, kernel_init=nn.initializers.xavier_uniform())(z); z = nn.relu(z)\n        policy_logits = nn.Dense(4, kernel_init=nn.initializers.xavier_uniform())(z)\n        value = nn.Dense(1, kernel_init=nn.initializers.xavier_uniform())(z).squeeze(-1)\n        \n        return policy_logits, value, new_rnn_state\n\ndef create_network(hparams):\n    return DoubleStepBottleneckSotaNet(\n        cnn_features_1=hparams['cnn_features_1'], cnn_features_2=hparams['cnn_features_2'],\n        conv_lstm_features=hparams['conv_lstm_features']\n    )\n\ndef create_optimizer(learning_rate: float = 4e-4):\n    return optax.chain(\n        optax.clip_by_global_norm(1.0),\n        optax.adamw(learning_rate=learning_rate, weight_decay=1e-4)\n    )\n\n```\n\n**Execution Log:**\n```\nPYTHON SANDBOX\
