    \ tasks.\n**Score:** 63.6\n**Evaluation Details:** Individual seed scores: [0.595, 0.651, 0.662, 0.634]\nMean: 0.636, Std: 0.025\nBest trial: 3 (0.662)\nBest trial hyperparameters:\n  learning_rate: 0.000400\n  entropy_coef: 0.010000\n  value_loss_coef: 0.500000\n  cnn_features_1: 32.000000\n  cnn_features_2: 64.000000\n  convlstm_features: 64.000000\n  attention_temperature: 1.000000\n\n**Submission Code:**\n```python\nimport jax\nimport jax.numpy as jnp\nimport flax.linen as nn\nimport optax\nfrom ray import tune\nfrom typing import Tuple, Dict, Any, Optional\n\nBASE_SEED = 42 # For reproducibility\n\ndef _define_hyperparameters():\n    \"\"\"\n    Define Ray Tune search space for hyperparameters for the CNN-ConvLSTM-Attention architecture.\n    Adopting parameters from successful prior research.\n    \"\"\"\n    return {\n        'learning_rate': tune.choice([0.0004]), # From Zephyr I's SOTA\n        'entropy_coef': tune.choice([0.01]),    # From Zephyr I's SOTA\n        'value_loss_coef':\
    \ tune.choice([0.5]),   # From Zephyr I's SOTA\n        'cnn_features_1': tune.choice([32]),    # From Zephyr I's SOTA\n        'cnn_features_2': tune.choice([64]),    # From Zephyr I's SOTA\n        'convlstm_features': tune.choice([64]), # From Zephyr I's SOTA\n        'attention_temperature': tune.choice([1.0]), # From Zephyr I's SOTA\n    }\n\nclass LayerNormConvLSTMCell(nn.Module):\n    \"\"\"\n    ConvLSTM cell with LayerNormalization on gate preactivations,\n    adapted from Zephyr I's successful implementation.\n    \"\"\"\n    features: int\n    kernel_size: Tuple[int, int] = (3, 3)\n\n    @nn.compact\n    def __call__(self, carry, inputs):\n        c, h = carry\n        \n        # Concatenate input and hidden state for convolutional gates\n        inputs_h = jnp.concatenate([inputs, h], axis=-1)\n        \n        # Convolutional layer for the gates (i, f, o, g)\n        gates = nn.Conv(\n            features=4 * self.features,\n            kernel_size=self.kernel_size,\n\
    \            padding='SAME',\n            kernel_init=nn.initializers.xavier_uniform(),\n            name=\"gates_conv\"\n        )(inputs_h)\n\n        # Split gates\n        i, f, o, g = jnp.split(gates, 4, axis=-1)\n\n        # Apply LayerNorm to gate preactivations\n        i = nn.LayerNorm(name=\"i_ln\")(i)\n        f = nn.LayerNorm(name=\"f_ln\")(f)\n        o = nn.LayerNorm(name=\"o_ln\")(o)\n        g = nn.LayerNorm(name=\"g_ln\")(g)\n        \n        # Apply activation functions\n        i = nn.sigmoid(i)\n        f = nn.sigmoid(f)\n        o = nn.sigmoid(o)\n        g = nn.tanh(g)\n\n        # Update cell and hidden states\n        new_c = f * c + i * g\n        new_h = o * nn.tanh(new_c)\n        \n        return (new_c, new_h), new_h\n\nclass SingleHeadAttentionPooling(nn.Module):\n    \"\"\"Single-head attention pooling layer, adapted from Zephyr I's SOTA.\"\"\"\n    temperature: float\n\n    @nn.compact\n    def __call__(self, x: jnp.ndarray) -> jnp.ndarray:\n        #\
    \ x is expected to be (batch_size, H, W, C)\n        batch_size, H, W, C = x.shape\n        \n        # Query, Key, Value projections\n        # q = nn.Conv(features=C, kernel_size=(1,1), name=\"attn_q\")(x)\n        # k = nn.Conv(features=C, kernel_size=(1,1), name=\"attn_k\")(x)\n        # v = nn.Conv(features=C, kernel_size=(1,1), name=\"attn_v\")(x)\n        # For single-head attention, often just use dense layers after flattening, or simple convs.\n        # Based on Zephyr's summary, it's likely a global pooling with attention weights.\n        # A simple spatial attention is to project to a single channel, softmax, then weigh.\n        \n        # Project to a single channel to get attention scores for each spatial location\n        attn_logits = nn.Conv(features=1, kernel_size=(1,1), name=\"attn_logits\")(x)\n        \n        # Flatten logits to apply softmax over spatial dimensions\n        attn_logits_flat = attn_logits.reshape((batch_size, -1)) # (B, H*W)\n        \n    \
    \    # Apply temperature-scaled softmax\n        attn_weights_flat = nn.softmax(attn_logits_flat / self.temperature, axis=-1)\n        \n        # Reshape weights back to spatial dimensions (B, H, W, 1)\n        attn_weights = attn_weights_flat.reshape((batch_size, H, W, 1))\n\n        # Apply weights to input features and sum over spatial dimensions\n        weighted_features = x * attn_weights # (B, H, W, C)\n        pooled_features = jnp.sum(weighted_features, axis=(1, 2)) # (B, C)\n        \n        return pooled_features\n\n\nclass SokobanConvLSTMCNN(nn.Module):\n    \"\"\"CNN with ConvLSTM and Attention for Sokoban, based on Zephyr I's architecture.\"\"\"\n    cnn_features_1: int\n    cnn_features_2: int\n    convlstm_features: int\n    attention_temperature: float\n    \n    @nn.compact\n    def __call__(self, x: jnp.ndarray, done: jnp.ndarray, rnn_state: Optional[Tuple[jnp.ndarray, jnp.ndarray]] = None) -> Tuple[jnp.ndarray, jnp.ndarray, Tuple[jnp.ndarray, jnp.ndarray]]:\n  \
    \      batch_size = x.shape[0]\n        \n        # CNN Feature Extraction (similar to DefaultResidualCNN)\n        x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n        x = nn.relu(x)\n        \n        conv2_in = x\n        x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n        x = nn.relu(x)\n        x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n        x = x + conv2_in\n        x = nn.relu(x)\n        \n        x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n        x = nn.relu(x)\n        \n        conv4_in = x\n        x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n        x = nn.relu(x)\n        x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n        x = x + conv4_in\n        x = nn.relu(x) # x shape: (B, H, W, C) e.g., (B, 8, 8, 64)\n\n        # Initialize RNN state (c,\
    \ h) if not provided\n        if rnn_state is None:\n            H, W = x.shape[1:3] # Get spatial dimensions from CNN output\n            rnn_state = (\n                jnp.zeros((batch_size, H, W, self.convlstm_features), dtype=jnp.float32),\n                jnp.zeros((batch_size, H, W, self.convlstm_features), dtype=jnp.float32)\n            )\n        \n        # Reset states for episodes that are done\n        if done is not None:\n            done_mask = done.reshape(batch_size, 1, 1, 1)\n            rnn_state = (\n                rnn_state[0] * (1 - done_mask),\n                rnn_state[1] * (1 - done_mask),\n            )\n        \n        # Apply ConvLSTM layer\n        convlstm_cell = LayerNormConvLSTMCell(features=self.convlstm_features, name=\"convlstm_layer\")\n        (new_c, new_h), convlstm_out = convlstm_cell(rnn_state, x)\n        new_rnn_state = (new_c, new_h)\n\n        # Apply single-head attention pooling to ConvLSTM output\n        attended_features = SingleHeadAttentionPooling(temperature=self.attention_temperature,\
    \ name=\"attention_pooling_layer\")(convlstm_out) # (B, C)\n\n        # Shared MLP backbone after Attention\n        mlp_out = nn.Dense(features=256)(attended_features)\n        mlp_out = nn.relu(mlp_out)\n        \n        # Policy and value heads\n        policy_logits = nn.Dense(features=4)(mlp_out)\n        value = nn.Dense(features=1)(mlp_out).squeeze(-1)\n        \n        return policy_logits, value, new_rnn_state\n\ndef create_network(hparams: Dict[str, Any]):\n    \"\"\"Create the CNN-ConvLSTM-Attention network architecture.\"\"\"\n    return SokobanConvLSTMCNN(\n        cnn_features_1=hparams['cnn_features_1'],\n        cnn_features_2=hparams['cnn_features_2'],\n        convlstm_features=hparams['convlstm_features'],\n        attention_temperature=hparams['attention_temperature']\n    )\n\n# Using system default training_step and create_optimizer.\n\n```\n\n**Execution Log:**\n```\nPYTHON SANDBOX EXECUTION:\nSTDOUT:\nExecuting command: CUDA_VISIBLE_DEVICES='' JAX_PLATFORMS=''\
