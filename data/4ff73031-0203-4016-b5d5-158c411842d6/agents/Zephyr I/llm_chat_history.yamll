- text: "/execute_action{goto research}\n/execute_action{storage write zephyr/networks/cnn_convlstm_ln_slots.py}\n```yaml\ncontent: |\n  import jax.numpy as jnp\n  import flax.linen as nn\n  from typing import Tuple, Dict, Any, Optional\n\n  class ResidualBlock(nn.Module):\n      features: int\n      @nn.compact\n      def __call__(self, x):\n          y = nn.Conv(self.features, (3,3), padding='SAME',\n                      kernel_init=nn.initializers.xavier_uniform())(x)\n          y = nn.relu(y)\n          y = nn.Conv(self.features, (3,3), padding='SAME',\n                      kernel_init=nn.initializers.xavier_uniform())(y)\n          return nn.relu(x + y)\n\n  class ConvLSTMCellLN(nn.Module):\n      features: int\n      kernel_size: Tuple[int,int] = (3,3)\n      @nn.compact\n      def __call__(self, carry, x):\n          h, c = carry  # (B,H,W,C)\n          gates = nn.Conv(4*self.features, self.kernel_size, padding='SAME',\n                          kernel_init=nn.initializers.xavier_uniform())(jnp.concatenate([x,\
    \ h], axis=-1))\n          gates = nn.LayerNorm(epsilon=1e-5)(gates)  # per-pixel LN over channels\n          i, f, g, o = jnp.split(gates, 4, axis=-1)\n          i = nn.sigmoid(i); f = nn.sigmoid(f); o = nn.sigmoid(o); g = jnp.tanh(g)\n          c = f * c + i * g\n          h = o * jnp.tanh(c)\n          return (h, c), h\n\n  class SlotPooling(nn.Module):\n      \"\"\"Single-step slot-style pooling (general, no domain heuristics).\"\"\"\n      num_slots: int\n      feat_dim: int\n      @nn.compact\n      def __call__(self, tokens):  # tokens: (B, T, C)\n          B, T, C = tokens.shape\n          # Learned initial slots (shared across batch)\n          slots = self.param('slots_init', nn.initializers.xavier_uniform(), (self.num_slots, C))\n          slots = jnp.tile(slots[None, ...], (B, 1, 1))  # (B, S, C)\n\n          # Projections\n          k = nn.Dense(C, kernel_init=nn.initializers.xavier_uniform())(tokens)   # (B,T,C)\n          v = nn.Dense(C, kernel_init=nn.initializers.xavier_uniform())(tokens)\
    \   # (B,T,C)\n          q = nn.Dense(C, kernel_init=nn.initializers.xavier_uniform())(slots)    # (B,S,C)\n\n          # Safe scale (C is Python int)\n          scale = 1.0 / jnp.sqrt(jnp.array(C).astype(tokens.dtype))\n          attn_logits = jnp.einsum('bsc,btc->bst', q, k) * scale  # (B,S,T)\n          attn = nn.softmax(attn_logits, axis=-1)                 # (B,S,T)\n\n          # Slot updates\n          slot_context = jnp.einsum('bst,btc->bsc', attn, v)      # (B,S,C)\n          slot_context = nn.relu(nn.Dense(C, kernel_init=nn.initializers.xavier_uniform())(slot_context))\n          return slot_context.reshape(B, -1)  # (B, S*C)\n\n  class CNNConvLSTM_LN_SlotPool(nn.Module):\n      \"\"\"Residual CNN + LN-gated ConvLSTM + slot-style pooling (S=4).\"\"\"\n      cnn_features_1: int\n      cnn_features_2: int\n      conv_lstm_features: int\n      num_slots: int = 4\n\n      @nn.compact\n      def __call__(self, x: jnp.ndarray, done: jnp.ndarray, rnn_state: Optional[Dict] = None):\n\
    \          B = x.shape[0]\n          # CNN backbone\n          x = nn.Conv(self.cnn_features_1, (3,3), padding='SAME',\n                      kernel_init=nn.initializers.xavier_uniform())(x); x = nn.relu(x)\n          x = ResidualBlock(self.cnn_features_1)(x)\n          x = nn.Conv(self.cnn_features_2, (3,3), padding='SAME',\n                      kernel_init=nn.initializers.xavier_uniform())(x); x = nn.relu(x)\n          x = ResidualBlock(self.cnn_features_2)(x)\n\n          # Init/reset state\n          if rnn_state is None:\n              zeros = lambda: jnp.zeros((B, 8, 8, self.conv_lstm_features), dtype=x.dtype)\n              rnn_state = {'h': zeros(), 'c': zeros()}\n          if done is not None:\n              m = (1.0 - done.reshape(B,1,1,1).astype(x.dtype))\n              rnn_state = {'h': rnn_state['h'] * m, 'c': rnn_state['c'] * m}\n\n          # ConvLSTM\n          (h_new, c_new), h_out = ConvLSTMCellLN(self.conv_lstm_features)((rnn_state['h'], rnn_state['c']), x)\n    \
    \      rnn_state = {'h': h_new, 'c': c_new}\n\n          # Flatten spatial tokens and apply slot pooling\n          tokens = h_out.reshape((B, 64, self.conv_lstm_features))  # (B,T=64,C)\n          z = SlotPooling(self.num_slots, self.conv_lstm_features)(tokens)  # (B, S*C)\n\n          # Heads\n          z = nn.Dense(256, kernel_init=nn.initializers.xavier_uniform())(z); z = nn.relu(z)\n          pol_h = nn.Dense(64, kernel_init=nn.initializers.xavier_uniform())(z); pol_h = nn.relu(pol_h)\n          policy_logits = nn.Dense(4, kernel_init=nn.initializers.xavier_uniform())(pol_h)\n          val_h = nn.Dense(64, kernel_init=nn.initializers.xavier_uniform())(z); val_h = nn.relu(val_h)\n          value = nn.Dense(1, kernel_init=nn.initializers.xavier_uniform())(val_h).squeeze(-1)\n          return policy_logits, value, rnn_state\n\n  __all__ = [\"ResidualBlock\", \"ConvLSTMCellLN\", \"SlotPooling\", \"CNNConvLSTM_LN_SlotPool\"]\n```\n\n/execute_action{goto token_management}\n/execute_action{prune_response\
    \ 14,17,20,22,24,26,28,29,31,33,35,37:38,41:49,51:57}"
