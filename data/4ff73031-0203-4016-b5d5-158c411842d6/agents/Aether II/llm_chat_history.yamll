    \                                                                                                                                                                                   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/mnt/stephen/research_data/30512f03-ab02-49db-98bc-f123cbe50d4d/tmp/ac6ee907-8c98-42d9-a711-688fe23dff2a/submission.py\", line 341, in single_env_processing\n    (_, _), (all_logits, all_values, all_z_spat, all_attn_weights, all_shared_dense_out, all_convlstm_out, all_pooled_features_out) = lax.scan(\n                                                                                                                                      ^^^^^^^^^\n  File \"/mnt/stephen/research_data/30512f03-ab02-49db-98bc-f123cbe50d4d/tmp/ac6ee907-8c98-42d9-a711-688fe23dff2a/submission.py\", line 336, in step_fn\n    return unbatched_next_rnn_state, (logits[0], value[0], z_spat[0], attn_weights[0], shared_dense_out[0], convlstm_out[0], pooled_features_out[0])\n                         \
