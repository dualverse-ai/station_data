role: model
parts:
- text: "I am back in the Research Counter. I will now submit my second experiment: a hyperparameter tuning run for my CNN-GRU agent. This aims to find optimal parameters to improve its performance.\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"CNN-GRU Hyperparameter Tuning for Sokoban\"\ntags: \"architecture, recurrent, gru, policy gradient, hyperparameter search\"\nabstract: \"This submission performs hyperparameter tuning for the CNN-GRU agent developed in Submission ID 910. It explores a search space for learning rate, entropy coefficient, and value loss coefficient, aiming to optimize performance and potentially surpass the CNN-LSTM baseline.\"\ncontent: |\n  import jax.numpy as jnp\n  from jax import lax, vmap\n  import flax.linen as nn\n  from typing import Tuple, Dict, Any, Optional\n  from ray import tune\n\n  # Fixed BASE_SEED for reproducibility\n  BASE_SEED = 42\n\n  def _define_hyperparameters():\n      \"\"\"\n      Define Ray Tune search space for hyperparameters.\n  \
    \    Searching for learning_rate, entropy_coef, and value_loss_coef.\n      CNN and GRU features are fixed as per previous experiment.\n      \"\"\"\n      return {\n          'learning_rate': tune.loguniform(1e-4, 1e-3), # Search around 4e-4\n          'entropy_coef': tune.uniform(0.005, 0.02), # Search around 0.01\n          'value_loss_coef': tune.uniform(0.3, 0.7), # Search around 0.5\n          'cnn_features_1': tune.choice([32]),\n          'cnn_features_2': tune.choice([64]),\n          'gru_features': tune.choice([256]) \n      }\n\n  class CNNGRU(nn.Module):\n      \"\"\"CNN + GRU hybrid architecture for Sokoban.\"\"\"\n      gru_features: int\n      cnn_features_1: int\n      cnn_features_2: int\n      \n      @nn.compact\n      def __call__(self, x: jnp.ndarray, done: jnp.ndarray, rnn_state: Optional[Dict] = None) -> Tuple[jnp.ndarray, jnp.ndarray, Dict]:\n          batch_size = x.shape[0]\n          \n          # Initialize RNN state if not provided\n          if rnn_state\
    \ is None:\n              rnn_state = {\n                  'h': jnp.zeros((batch_size, self.gru_features)),\n              }\n          \n          # Reset states for episodes that are done\n          if done is not None:\n              done_mask = done.reshape(batch_size, 1)\n              rnn_state = {\n                  'h': rnn_state['h'] * (1 - done_mask),\n              }\n          \n          # --- CNN backbone (identical to DefaultResidualCNN / CNNLSTM baseline) ---\n          # First convolutional block\n          x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          \n          # Second block with residual connection\n          conv2_in = x\n          x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n          x = x + conv2_in\n          x = nn.relu(x)\n        \
    \  \n          # Third block - increase channels\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          \n          # Fourth block with residual connection\n          conv4_in = x\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n          x = x + conv4_in\n          x = nn.relu(x)\n          \n          # Flatten spatial dimensions\n          x = x.reshape((batch_size, -1))\n          \n          # Shared MLP backbone\n          x = nn.Dense(features=256)(x)\n          x = nn.relu(x)\n          \n          # --- GRU layer on top of CNN features ---\n          gru_cell = nn.GRUCell(\n              features=self.gru_features,\n              kernel_init=nn.initializers.xavier_uniform(),\n              recurrent_kernel_init=nn.initializers.xavier_uniform()\n\
    \          )\n          rnn_state['h'], gru_out = gru_cell(rnn_state['h'], x)\n          \n          # Small MLP after GRU\n          x = nn.Dense(features=128)(gru_out)\n          x = nn.relu(x)\n          \n          # Policy and value heads\n          policy_logits = nn.Dense(features=4)(x)\n          value = nn.Dense(features=1)(x).squeeze(-1)\n          \n          return policy_logits, value, rnn_state\n\n  def create_network(hparams):\n      \"\"\"Create CNN-GRU network architecture.\"\"\"\n      return CNNGRU(\n          gru_features=hparams['gru_features'],\n          cnn_features_1=hparams['cnn_features_1'],\n          cnn_features_2=hparams['cnn_features_2']\n      )\n\n  # Uses system default training_step and optimizer\n```"
