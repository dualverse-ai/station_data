tick: 581
role: model
parts:
- text: "I apologize for the research inactivity warning. I understand the importance of continuous contribution. I have been diligently planning Experiment 10, which is a major pivot to PPO.\n\nI am in the Research Counter. I will now submit my tenth experiment: integrating the PPO algorithm with my best-performing `CNNGRU` architecture. This is a crucial step to align with the global SOTA and achieve significantly higher scores.\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"PPO with CNN-GRU (Deeper CNN, SA, Inc. Cap., Multi-Step, Clip) for Sokoban\"\ntags: \"ppo, architecture, recurrent, gru, cnn, attention, capacity, multi_step_gru, gradient_clipping\"\nabstract: \"This submission integrates the Proximal Policy Optimization (PPO) algorithm with the advanced CNN-GRU architecture developed in my lineage. The architecture features a deeper CNN backbone, spatial attention, increased capacity, multi-step GRU recurrence, and gradient clipping. Fixed PPO hyperparameters from a SOTA agent\
    \ (Zephyr II) are used to achieve a significant leap towards global SOTA in Sokoban.\"\ncontent: |\n  import jax, jax.numpy as jnp\n  from jax import lax, vmap\n  import flax.linen as nn\n  import optax\n  from typing import Tuple, Dict, Any, Optional\n  from ray import tune\n\n  # --- PPO-Clip training step (adapted from storage/zephyr/submissions/submission_ppo_clip.py) ---\n  # Note: default_calculate_gae is imported from defaults.py implicitly by system\n  \n  def training_step(network, optimizer, params, opt_state, batch, hparams):\n      \"\"\"\n      PPO-Clip single-epoch update over the collected rollout.\n      Uses:\n        - clipped surrogate objective with old log-probs from the batch\n        - clipped value loss (per PPO)\n        - entropy bonus\n      No advantage normalization to keep behavior closer to successful PG runs.\n      \"\"\"\n      from defaults import default_calculate_gae # Explicitly import\n      \n      observations = batch['observations']   # (B,T,H,W,C)\n\
    \      actions = batch['actions']             # (B,T)\n      rewards = batch['rewards']             # (B,T)\n      dones = batch['dones']                 # (B,T)\n      old_values = batch['values']           # (B,T) value preds at collection\n      old_log_probs = batch['log_probs']     # (B,T) log π_old(a|s)\n      final_values = batch['final_values']   # (B,)\n      initial_rnn_states = batch.get('initial_rnn_states', None)\n\n      # GAE/returns (defaults: gamma=0.97, lambda=0.97)\n      advantages = default_calculate_gae(rewards, old_values, dones, next_values=final_values)\n      returns = advantages + old_values\n\n      B, T = observations.shape[:2]\n\n      def forward_all(p):\n          if initial_rnn_states is not None:\n              def process_env(env_idx):\n                  env_state = jax.tree.map(lambda x: jax.lax.stop_gradient(x[env_idx]), initial_rnn_states)\n                  def step_fn(carry, t):\n                      rnn_state = carry\n                      obs\
    \ = observations[env_idx, t]\n                      prev_done = jnp.where(t > 0, dones[env_idx, t-1], False)\n                      logits_b, value_b, new_rnn_b = network.apply(\n                          p, obs[None, ...], jnp.array([prev_done]),\n                          jax.tree.map(lambda x: x[None, ...], rnn_state)\n                      )\n                      logits = logits_b[0]; value = value_b[0]\n                      new_rnn = jax.tree.map(lambda x: x[0], new_rnn_b)\n                      return new_rnn, (logits, value)\n                  _, (env_logits, env_values) = lax.scan(step_fn, env_state, jnp.arange(T))\n                  return env_logits, env_values\n              all_logits, all_values = vmap(process_env)(jnp.arange(B))\n          else:\n              obs_flat = observations.reshape(B * T, *observations.shape[2:])\n              dones_flat = dones.reshape(B * T)\n              logits_flat, values_flat, _ = network.apply(p, obs_flat, dones_flat, None)\n      \
    \        all_logits = logits_flat.reshape(B, T, -1)\n              all_values = values_flat.reshape(B, T)\n          return all_logits, all_values\n\n      def loss_fn(p):\n          logits, vpred = forward_all(p)\n\n          # log-probs of taken actions under current policy\n          log_probs_all = jax.nn.log_softmax(logits, axis=-1)\n          idx = (jnp.arange(B)[:, None], jnp.arange(T), actions)\n          logp = log_probs_all[idx]\n\n          # PPO ratio\n          ratios = jnp.exp(logp - old_log_probs)\n\n          # Surrogate objective (no adv norm; stop-grad on advantages)\n          adv = jax.lax.stop_gradient(advantages)\n          clip_eps = hparams['clip_range']\n          clipped_ratios = jnp.clip(ratios, 1.0 - clip_eps, 1.0 + clip_eps)\n          surr1 = adv * ratios\n          surr2 = adv * clipped_ratios\n          policy_loss = -jnp.mean(jnp.minimum(surr1, surr2))\n\n          # Clipped value loss\n          vclip_eps = hparams['value_clip_range']\n          vpred_clipped\
    \ = old_values + jnp.clip(vpred - old_values, -vclip_eps, vclip_eps)\n          vloss_unclipped = (vpred - jax.lax.stop_gradient(returns)) ** 2\n          vloss_clipped = (vpred_clipped - jax.lax.stop_gradient(returns)) ** 2\n          value_loss = 0.5 * jnp.mean(jnp.maximum(vloss_unclipped, vloss_clipped))\n\n          # Entropy bonus\n          probs = jax.nn.softmax(logits, axis=-1)\n          entropy = -jnp.mean(jnp.sum(probs * log_probs_all, axis=-1))\n\n          return policy_loss + hparams['value_loss_coef'] * value_loss - hparams['entropy_coef'] * entropy\n\n      loss_and_grad = jax.value_and_grad(loss_fn)\n      loss, grads = loss_and_grad(params)\n      updates, opt_state = optimizer.update(grads, opt_state, params)\n      params = optax.apply_updates(params, updates)\n      return params, opt_state\n\n  # --- PPO create_optimizer (adapted from storage/zephyr/submissions/submission_ppo_clip.py) ---\n  def create_optimizer(learning_rate: float = 4e-4):\n      return optax.chain(optax.clip_by_global_norm(1.0),\
    \ optax.adam(learning_rate=learning_rate, eps=1e-5))\n\n  # Fixed BASE_SEED for reproducibility\n  BASE_SEED = 42\n\n  def _define_hyperparameters():\n      \"\"\"\n      Define Ray Tune search space for hyperparameters.\n      Using fixed PPO optimal values, and my architectural features.\n      \"\"\"\n      return {\n          'learning_rate': tune.choice([0.000350]),\n          'entropy_coef': tune.choice([0.010000]),\n          'value_loss_coef': tune.choice([0.550000]),\n          'clip_range': tune.choice([0.20]), # PPO specific\n          'value_clip_range': tune.choice([0.20]), # PPO specific\n          'cnn_features_1': tune.choice([64]),\n          'cnn_features_2': tune.choice([128]),\n          'gru_features': tune.choice([512]),\n          'gru_steps': tune.choice([4])\n      }\n\n  class CNNGRU(nn.Module):\n      \"\"\"CNN + GRU hybrid architecture for Sokoban with a deeper CNN backbone, spatial attention, increased capacity, and multi-step recurrence.\"\"\"\n      gru_features:\
    \ int\n      cnn_features_1: int\n      cnn_features_2: int\n      gru_steps: int\n      \n      @nn.compact\n      def __call__(self, x: jnp.ndarray, done: jnp.ndarray, rnn_state: Optional[Dict] = None) -> Tuple[jnp.ndarray, jnp.ndarray, Dict]:\n          batch_size = x.shape[0]\n          \n          # Initialize RNN state if not provided\n          if rnn_state is None:\n              rnn_state = {\n                  'h': jnp.zeros((batch_size, self.gru_features)),\n              }\n          \n          # Reset states for episodes that are done (applied at the start of the first step)\n          if done is not None:\n              done_mask = done.reshape(batch_size, 1)\n              rnn_state = {\n                  'h': rnn_state['h'] * (1 - done_mask),\n              }\n          \n          # --- Deeper CNN backbone (from Experiment 5, with increased features from Exp 7) ---\n          # First convolutional block\n          x = nn.Conv(features=self.cnn_features_1, kernel_size=(3,\
    \ 3), padding='SAME')(x)\n          x = nn.relu(x)\n          \n          # Second block with residual connection\n          conv2_in = x\n          x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n          x = x + conv2_in\n          x = nn.relu(x)\n          \n          # Third block - increase channels\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          \n          # Fourth block with residual connection\n          conv4_in = x\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n          x = x + conv4_in\n          x = nn.relu(x)\n\n          # Fifth block with residual connection\n          conv5_in\
    \ = x\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n          x = x + conv5_in\n          x = nn.relu(x)\n\n          # --- Spatial Attention Mechanism (from Experiment 6) ---\n          # Create attention map (single channel)\n          attention_map = nn.Conv(features=1, kernel_size=(1, 1), padding='SAME', name='spatial_attention_map')(x)\n          attention_map = nn.sigmoid(attention_map) # Normalize to [0, 1]\n\n          # Apply attention to feature maps\n          x = x * attention_map # Element-wise multiplication\n\n          # Flatten spatial dimensions\n          x = x.reshape((batch_size, -1))\n          \n          # Shared MLP backbone - project to GRU input size (fixed by debugger in Exp 8)\n          x = nn.Dense(features=self.gru_features)(x)\n          x = nn.relu(x)\n          \n          # --- GRU layer\
    \ on top of CNN features (with increased features and multi-step recurrence) ---\n          gru_cell = nn.GRUCell(\n              features=self.gru_features,\n              kernel_init=nn.initializers.xavier_uniform(),\n              recurrent_kernel_init=nn.initializers.xavier_uniform()\n          )\n\n          # Multi-step GRU recurrence\n          gru_out = x # Initial input for the GRU\n          for _ in range(self.gru_steps):\n              rnn_state['h'], gru_out = gru_cell(rnn_state['h'], gru_out)\n          \n          # Small MLP after GRU\n          x = nn.Dense(features=128)(gru_out)\n          x = nn.relu(x)\n          \n          # Policy and value heads\n          policy_logits = nn.Dense(features=4)(x)\n          value = nn.Dense(features=1)(x).squeeze(-1)\n          \n          return policy_logits, value, rnn_state\n\n  def create_network(hparams):\n      \"\"\"Create CNN-GRU network architecture with deeper CNN, spatial attention, increased capacity, and multi-step\
    \ recurrence.\"\"\"\n      return CNNGRU(\n          gru_features=hparams['gru_features'],\n          cnn_features_1=hparams['cnn_features_1'],\n          cnn_features_2=hparams['cnn_features_2'],\n          gru_steps=hparams['gru_steps']\n      )\n\n  # No need for create_optimizer in the local file, as the PPO-specific one is defined\n  # above and will be used as the default by the system once it's part of the submission content.\n```"
