tick: 37
role: model
parts:
- text: "I have created the network architecture for my implicit planning agent. Now, I must write the custom `training_step` function that will train it. This is the second critical piece of the implementation.\n\nThe custom trainer will calculate the standard policy gradient loss (policy loss, value loss, entropy bonus) and add a new, self-supervised **transition loss**. This loss will be the mean squared error between the transition model's prediction of the next latent state and the actual encoded next state from the trajectory. This auxiliary task will force the transition model to learn the rules of Sokoban.\n\nI will now append this custom trainer to the `implicit_planning_agent.py` file. This will complete the code required for my next experiment.\n\n`/execute_action{storage write krono/implicit_planning_agent.py}`\n```yaml\ncontent: |\n  import jax\n  import jax.numpy as jnp\n  from jax import vmap, jit, lax\n  import flax.linen as nn\n  import optax\n  from ray import tune\n  from\
    \ typing import Tuple, Dict, Any, Optional\n\n  class StateEncoder(nn.Module):\n      \"\"\"The proven deep residual CNN from the baseline.\"\"\"\n      cnn_features_1: int\n      cnn_features_2: int\n\n      @nn.compact\n      def __call__(self, x):\n          x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          conv2_in = x\n          x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          x = nn.Conv(features=self.cnn_features_1, kernel_size=(3, 3), padding='SAME')(x)\n          x = x + conv2_in\n          x = nn.relu(x)\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          conv4_in = x\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n          x = nn.relu(x)\n          x = nn.Conv(features=self.cnn_features_2, kernel_size=(3, 3), padding='SAME')(x)\n\
    \          x = x + conv4_in\n          x = nn.relu(x)\n          return x\n\n  class TransitionModel(nn.Module):\n      \"\"\"A small CNN to predict the next latent state.\"\"\"\n      features: int\n      num_actions: int = 4\n\n      @nn.compact\n      def __call__(self, z, a):\n          a_one_hot = jax.nn.one_hot(a, self.num_actions)\n          a_broadcast = jnp.expand_dims(jnp.expand_dims(a_one_hot, 1), 1)\n          a_broadcast = jnp.tile(a_broadcast, (1, z.shape[1], z.shape[2], 1))\n          z_a = jnp.concatenate([z, a_broadcast], axis=-1)\n          \n          z_next = nn.Conv(features=self.features, kernel_size=(3, 3), padding='SAME')(z_a)\n          z_next = nn.relu(z_next)\n          # Add a residual connection to make learning easier (predict the change)\n          z_next = z_next + z\n          return z_next\n\n  class ImplicitPlanningNetwork(nn.Module):\n      \"\"\"Full architecture with Encoder, Planning Module, and LSTM.\"\"\"\n      lstm_features: int\n      cnn_features_1:\
    \ int\n      cnn_features_2: int\n      num_actions: int = 4\n\n      def setup(self):\n          self.encoder = StateEncoder(cnn_features_1=self.cnn_features_1, cnn_features_2=self.cnn_features_2)\n          self.transition_model = TransitionModel(features=self.cnn_features_2)\n          self.value_head_simple = nn.Dense(features=1)\n\n      def __call__(self, x, done, rnn_state=None):\n          batch_size = x.shape[0]\n\n          z_t = self.encoder(x)\n          \n          action_range = jnp.arange(self.num_actions)\n          z_t_tiled = jnp.expand_dims(z_t, axis=1)\n          \n          # vmap transition model over actions\n          imagined_z_next = jax.vmap(self.transition_model, in_axes=(None, 0))(z_t, action_range)\n          # Reshape from (num_actions, batch_size, H, W, C) to (batch_size, num_actions, H, W, C)\n          imagined_z_next = jnp.transpose(imagined_z_next, (1, 0, 2, 3, 4))\n\n          imagined_z_flat = imagined_z_next.reshape(batch_size, self.num_actions,\
    \ -1)\n          imagined_values = self.value_head_simple(imagined_z_flat).squeeze(-1)\n\n          z_t_flat = z_t.reshape(batch_size, -1)\n          augmented_z = jnp.concatenate([z_t_flat, imagined_values], axis=-1)\n\n          if rnn_state is None:\n              rnn_state = nn.LSTMCell.initialize_carry(jax.random.PRNGKey(0), (batch_size,), self.lstm_features)\n          if done is not None:\n              done_mask = done.reshape(-1, 1)\n              rnn_state = jax.tree.map(lambda y: y * (1 - done_mask), rnn_state)\n          \n          lstm_in = nn.Dense(features=256)(augmented_z)\n          lstm_in = nn.relu(lstm_in)\n          rnn_state, lstm_out = nn.LSTMCell(name=\"lstm_cell\")(rnn_state, lstm_in)\n          \n          final_features = nn.Dense(features=128)(lstm_out)\n          final_features = nn.relu(final_features)\n          \n          policy_logits = nn.Dense(features=self.num_actions)(final_features)\n          value = self.value_head_simple(z_t_flat).squeeze(-1)\n\
    \n          return policy_logits, value, rnn_state\n      \n  # From defaults.py, for GAE calculation\n  def calculate_gae(rewards, values, dones, gamma, gae_lambda, next_values):\n      values_t_plus_1 = jnp.concatenate([values[:, 1:], next_values[:, None]], axis=1)\n      not_done_mask = (1.0 - dones.astype(jnp.float32))\n      deltas = rewards + gamma * values_t_plus_1 * not_done_mask - values\n      \n      def scan_fn(advantage_t_plus_1, t):\n          delta_t = deltas[:, t]\n          not_done_t = not_done_mask[:, t]\n          advantage_t = delta_t + gamma * gae_lambda * not_done_t * advantage_t_plus_1\n          return advantage_t, advantage_t\n      \n      _, advantages = lax.scan(scan_fn, jnp.zeros(values.shape[0]), jnp.arange(values.shape[1] - 1, -1, -1))\n      return advantages[::-1].T\n\n  def custom_training_step(network, optimizer, params, opt_state, batch, hparams):\n      \n      advantages = calculate_gae(batch['rewards'], batch['values'], batch['dones'], 0.97, 0.97,\
    \ batch['final_values'])\n      returns = advantages + batch['values']\n      \n      def loss_fn(params):\n          # Encode all observations in the trajectory up front\n          batch_size, traj_len = batch['observations'].shape[:2]\n          obs_flat = batch['observations'].reshape(-1, *batch['observations'].shape[2:])\n          encoded_states = network.apply(params, obs_flat, method=lambda module, x: module.encoder(x))\n          encoded_states = encoded_states.reshape(batch_size, traj_len, *encoded_states.shape[1:])\n\n          # Get actual next states for transition loss\n          z_t = encoded_states[:, :-1]\n          z_t_plus_1_actual = jax.lax.stop_gradient(encoded_states[:, 1:])\n          actions_t = batch['actions'][:, :-1]\n\n          # Predict next states with transition model\n          z_t_flat = z_t.reshape(-1, *z_t.shape[2:])\n          actions_t_flat = actions_t.flatten()\n          z_t_plus_1_predicted = network.apply(params, z_t_flat, actions_t_flat, method=lambda\
    \ module, z, a: module.transition_model(z, a))\n          z_t_plus_1_predicted = z_t_plus_1_predicted.reshape(batch_size, traj_len - 1, *z_t_plus_1_predicted.shape[1:])\n\n          # Transition Loss\n          transition_loss = jnp.mean((z_t_plus_1_predicted - z_t_plus_1_actual)**2)\n\n          # Recurrent pass for policy/value loss (similar to baseline)\n          initial_rnn_states = batch['initial_rnn_states']\n          \n          def step_fn(carry, t):\n              rnn_state = carry\n              obs = batch['observations'][:, t]\n              prev_done = jnp.where(t > 0, batch['dones'][:, t - 1], False)\n              logits, value, new_rnn_state = network.apply(params, obs, prev_done, rnn_state)\n              return new_rnn_state, (logits, value)\n          \n          _, (all_logits, all_values) = lax.scan(step_fn, initial_rnn_states, jnp.arange(traj_len))\n          all_logits = jnp.transpose(all_logits, (1, 0, 2))\n          all_values = jnp.transpose(all_values, (1,\
    \ 0))\n\n          # Policy Gradient Loss\n          log_probs = jax.nn.log_softmax(all_logits, axis=-1)\n          action_log_probs = jnp.take_along_axis(log_probs, batch['actions'][..., None], axis=-1).squeeze(-1)\n          policy_loss = -jnp.mean(jax.lax.stop_gradient(advantages) * action_log_probs)\n          \n          # Value Loss\n          value_loss = 0.5 * jnp.mean((all_values - jax.lax.stop_gradient(returns))**2)\n\n          # Entropy Bonus\n          entropy = -jnp.mean(jnp.sum(jax.nn.softmax(all_logits) * log_probs, axis=-1))\n\n          # Total Loss\n          total_loss = (policy_loss + \n                       hparams['value_loss_coef'] * value_loss - \n                       hparams['entropy_coef'] * entropy +\n                       hparams['transition_loss_coef'] * transition_loss)\n          return total_loss\n\n      grad_fn = jax.value_and_grad(loss_fn)\n      loss, grads = grad_fn(params)\n      updates, opt_state = optimizer.update(grads, opt_state, params)\n\
    \      params = optax.apply_updates(params, updates)\n      \n      return params, opt_state\n```"
