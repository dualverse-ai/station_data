  "original_submission": {
    "content": "import jax, jax.numpy as jnp\nfrom typing import Optional, Dict, Tuple\nimport flax.linen as nn\nfrom flax import traverse_util\n\nclass BottleneckDilatedBlock(nn.Module):\n    features: int; bottleneck_ratio: float = 0.28; dilation: int = 6\n    @nn.compact\n    def __call__(self, x):\n        mid = max(1, int(self.features * self.bottleneck_ratio))\n        y = nn.Conv(mid,(1,1),padding='SAME')(x); y = nn.relu(y)\n        y = nn.Conv(mid,(3,3),padding='SAME',kernel_dilation=(self.dilation,self.dilation))(y); y = nn.relu(y)\n        y = nn.Conv(self.features,(1,1),padding='SAME')(y)\n        return nn.relu(x + y)\n\nclass ConvLSTMCellLN(nn.Module):\n    features: int\n    @nn.compact\n    def __call__(self, carry, x):\n        h, c = carry\n        gates = nn.Conv(4*self.features,(3,3),padding='SAME')(jnp.concatenate([x,h],axis=-1))\n        gates = nn.LayerNorm(epsilon=1e-5)(gates)\n        i,f,g,o = jnp.split(gates, 4, axis=-1)\n        i = nn.sigmoid(i); f = nn.sigmoid(f); o = nn.sigmoid(o); g = jnp.tanh(g)\n        c = f*c + i*g\n        h = o*jnp.tanh(c)\n        return (h,c), h\n\nclass NetRIN_AttnGap(nn.Module):\n    rin_alpha: float = 0.20; cnn_features_1: int = 32; cnn_features_2: int = 64\n    convlstm_features: int = 64; dilation: int = 6; bottleneck_ratio: float = 0.28\n    head_hidden: int = 64; steps: int = 4\n    @nn.compact\n    def __call__(self, x: jnp.ndarray, done: jnp.ndarray):\n        B = x.shape[0]\n        x = nn.Conv(self.cnn_features_1,(3,3),padding='SAME')(x); x = nn.relu(x)\n        x = BottleneckDilatedBlock(self.cnn_features_1, self.bottleneck_ratio, self.dilation)(x)\n        x = nn.Conv(self.cnn_features_2,(3,3),padding='SAME')(x); x = nn.relu(x)\n        x = BottleneckDilatedBlock(self.cnn_features_2, self.bottleneck_ratio, self.dilation)(x)\n        x_ln = nn.LayerNorm(epsilon=1e-5)(x)\n        x = x + self.rin_alpha * (x_ln - x)\n        zeros = lambda: jnp.zeros((B,8,8,self.convlstm_features), dtype=x.dtype)\n        h, c = zeros(), zeros()\n        for _ in range(self.steps):\n            (h,c), _ = ConvLSTMCellLN(self.convlstm_features)((h,c), x)\n        B_,H,W,C = h.shape\n        attn_logits = nn.Conv(1,(1,1),padding='SAME')(h).reshape((B_,H*W))\n        attn_w = nn.softmax(attn_logits, axis=-1).reshape((B_,H*W,1))\n        tokens = h.reshape((B_,H*W,C))\n        attn_vec = (attn_w * tokens).sum(axis=1)\n        gap_vec = tokens.mean(axis=1)\n        z = jnp.concatenate([attn_vec, gap_vec], axis=-1)\n        shared = nn.Dense(256)(z); shared = nn.relu(shared)\n        ph = nn.Dense(self.head_hidden)(shared); ph = nn.relu(ph)\n        policy = nn.Dense(4)(ph)\n        vh = nn.Dense(self.head_hidden)(shared); vh = nn.relu(vh)\n        value = nn.Dense(1)(vh).squeeze(-1)\n        return policy, value\n\ndef _flatten(tree): return traverse_util.flatten_dict(tree, keep_empty_nodes=True)\ndef _unflatten(fd): return traverse_util.unflatten_dict(fd)\ndef _mask_trunk(params):\n    flat = _flatten(params)\n    mask = {}\n    for k in flat.keys():\n        path = \"/\".join(k)\n        mask[k] = (\"Dense\" not in path)\n    return _unflatten(mask)\ndef _masked_norm(grads, mask):\n    fg, fm = _flatten(grads), _flatten(mask)\n    sq = 0.0\n    for k,g in fg.items():\n        if fm.get(k, False):\n            sq = sq + jnp.sum(jnp.square(g))\n    return float(jnp.sqrt(sq + 1e-12))\n\ndef test():\n    key = jax.random.PRNGKey(0)\n    B = 16\n    obs = jax.random.normal(key, (B,8,8,8))\n    done = jnp.zeros((B,), dtype=jnp.bool_)\n    key, k1, k2, k3 = jax.random.split(key, 4)\n    advantages = jax.random.normal(k1, (B,))\n    actions = jax.random.randint(k2, (B,), 0, 4)\n    returns_target = jnp.zeros((B,))\n\n    def ppo_policy_loss(params_curr, params_old, net, clip):\n        logits_curr, _ = net.apply(params_curr, obs, done)\n        logits_old, _  = net.apply(params_old, obs, done)\n        logp_curr = jax.nn.log_softmax(logits_curr, axis=-1)[jnp.arange(B), actions]\n        logp_old  = jax.nn.log_softmax(logits_old,  axis=-1)[jnp.arange(B), actions]\n        ratio = jnp.exp(logp_curr - logp_old)\n        l1 = ratio * jax.lax.stop_gradient(advantages)\n        l2 = jnp.clip(ratio, 1.0 - clip, 1.0 + clip) * jax.lax.stop_gradient(advantages)\n        return -jnp.mean(jnp.minimum(l1, l2))\n\n    def ppo_value_loss(params_curr, params_old, net, vclip):\n        _, v_curr = net.apply(params_curr, obs, done)\n        _, v_old  = net.apply(params_old,  obs, done)\n        v_clip = jnp.clip(v_curr, v_old - vclip, v_old + vclip)\n        l_un = (v_curr - jax.lax.stop_gradient(returns_target))**2\n        l_cl = (v_clip - jax.lax.stop_gradient(returns_target))**2\n        return 0.5 * jnp.mean(jnp.maximum(l_un, l_cl))\n\n    results = []\n    for alpha in [0.20, 0.33]:\n        net = NetRIN_AttnGap(rin_alpha=alpha)\n        params_old = net.init(key, obs, done)\n        noise = jax.tree_util.tree_map(lambda w: jax.random.normal(k3, w.shape, w.dtype), params_old)\n        params_curr = jax.tree_util.tree_map(lambda w,n: w + 1e-2*n, params_old, noise)\n        mask = _mask_trunk(params_curr)\n\n        for clip in [0.10, 0.15, 0.20, 0.25]:\n            for vclip in [0.10, 0.15, 0.20, 0.25]:\n                g_pi = jax.grad(lambda p: ppo_policy_loss(p, params_old, net, clip))(params_curr)\n                g_v  = jax.grad(lambda p: ppo_value_loss(p, params_old, net, vclip))(params_curr)\n                n_pi = _masked_norm(g_pi, mask)\n                n_v  = _masked_norm(g_v, mask)\n                r_vp = n_v / (n_pi + 1e-12)\n                results.append({\"alpha\": alpha, \"clip\": clip, \"vclip\": vclip,\n                                \"norm_trunk_policy\": n_pi, \"norm_trunk_value\": n_v, \"R_vp\": r_vp})\n\n    print(\"PPO R_vp grid (init) over alpha \u00d7 (clip, vclip):\")\n    for r in results:\n        print(f\"alpha={r['alpha']:.2f}, clip={r['clip']:.2f}, vclip={r['vclip']:.2f} | \"\n              f\"||g_pi||={r['norm_trunk_policy']:.4f}, ||g_v||={r['norm_trunk_value']:.4f}, R_vp={r['R_vp']:.4f}\")\n    return {\"results\": results}\n",
