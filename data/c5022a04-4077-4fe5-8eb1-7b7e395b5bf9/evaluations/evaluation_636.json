  "original_submission": {
    "content": "import numpy as np\nimport os\nfrom math import cos, sin\ntry:\n    from scipy.optimize import linprog\nexcept Exception:\n    linprog = None\n\nN = 32\nR_MIN = 1e-8\n\n# ---------- Utilities ----------\ndef _pair_indices(n):\n    return [(i, j) for i in range(n) for j in range(i + 1, n)]\n\nPAIRS = _pair_indices(N)\n\ndef _solve_radii_lp_zero_slack(C):\n    \"\"\"\n    Exact zero-slack LP in radii:\n      maximize sum(r)\n      s.t. r_i >= R_MIN\n           r_i <= x_i, 1-x_i, y_i, 1-y_i\n           r_i + r_j <= ||c_i - c_j||  for all i<j\n    \"\"\"\n    n = C.shape[0]\n    x = C[:, 0]; y = C[:, 1]\n    rows = []; rhs = []\n\n    # Boundaries\n    for i in range(n):\n        a = np.zeros(n); a[i] = 1.0; rows.append(a); rhs.append(max(0.0, float(x[i])))\n    for i in range(n):\n        a = np.zeros(n); a[i] = 1.0; rows.append(a); rhs.append(max(0.0, float(1.0 - x[i])))\n    for i in range(n):\n        a = np.zeros(n); a[i] = 1.0; rows.append(a); rhs.append(max(0.0, float(y[i])))\n    for i in range(n):\n        a = np.zeros(n); a[i] = 1.0; rows.append(a); rhs.append(max(0.0, float(1.0 - y[i])))\n\n    # Pairwise\n    for (i, j) in PAIRS:\n        a = np.zeros(n); a[i] = 1.0; a[j] = 1.0\n        dij = float(np.linalg.norm(C[i] - C[j]))\n        rows.append(a); rhs.append(max(0.0, dij))\n\n    A_ub = np.vstack(rows); b_ub = np.array(rhs)\n    c = -np.ones(n)\n    bounds = [(R_MIN, None) for _ in range(n)]\n\n    if linprog is None:\n        # Safe fallback (boundary-limited equal radii with greedy repair)\n        r = np.minimum.reduce([x, 1.0 - x, y, 1.0 - y]).astype(float)\n        r = np.maximum(R_MIN, r)\n        r = _finalize_iterative(C, r, iters=3)\n        return r, False\n\n    res = linprog(c, A_ub=A_ub, b_ub=b_ub, bounds=bounds, method=\"highs\")\n    if not res.success:\n        # Robust fallback\n        r = np.minimum.reduce([x, 1.0 - x, y, 1.0 - y]).astype(float)\n        r = np.maximum(R_MIN, 0.99 * r)\n        r = _finalize_iterative(C, r, iters=3)\n        return r, False\n    r = np.asarray(res.x, dtype=float)\n    r = np.maximum(R_MIN, r)\n    return r, True\n\ndef _finalize_iterative(C, r, iters=6):\n    \"\"\"\n    Iterative zero-tolerance finalize: enforce boundaries and non-overlap exactly.\n    Never introduces positive slack on purpose; equality allowed. Safe under FP.\n    \"\"\"\n    r = np.asarray(r, dtype=float).copy()\n    x = C[:, 0]; y = C[:, 1]\n    # Boundary caps\n    def cap_bounds(rr):\n        rr = np.minimum(rr, x)\n        rr = np.minimum(rr, 1.0 - x)\n        rr = np.minimum(rr, y)\n        rr = np.minimum(rr, 1.0 - y)\n        return np.maximum(R_MIN, rr)\n\n    r = cap_bounds(r)\n    for _ in range(iters):\n        changed = False\n        # Pairwise repair\n        for (i, j) in PAIRS:\n            dij = float(np.linalg.norm(C[i] - C[j]))\n            s = r[i] + r[j]\n            if s > dij:\n                excess = s - dij  # positive\n                di = min(0.5 * excess, max(0.0, r[i] - R_MIN))\n                dj = min(0.5 * excess, max(0.0, r[j] - R_MIN))\n                rem = excess - (di + dj)\n                if rem > 0:\n                    # take remaining from whichever has headroom\n                    take = min(rem, max(0.0, r[i] - R_MIN - di))\n                    di += take; rem -= take\n                if rem > 0:\n                    take = min(rem, max(0.0, r[j] - R_MIN - dj))\n                    dj += take; rem -= take\n                r[i] = max(R_MIN, r[i] - di)\n                r[j] = max(R_MIN, r[j] - dj)\n                changed = True\n        r = cap_bounds(r)\n        if not changed:\n            break\n    return r\n\n# ---------- Global affine micro-warp ----------\ndef _apply_affine(C, sx=1.0, sy=1.0, shx=0.0, shy=0.0, theta=0.0):\n    \"\"\"\n    Apply small affine transform about center (0.5,0.5):\n      M = R(theta) @ H(shx,shy) @ S(sx,sy)\n      c' = 0.5 + M @ (c - 0.5)\n    Then clip to [0,1]^2.\n    \"\"\"\n    S = np.array([[sx, 0.0], [0.0, sy]], dtype=float)\n    H = np.array([[1.0, shx], [shy, 1.0]], dtype=float)\n    ct, st = cos(theta), sin(theta)\n    Rm = np.array([[ct, -st], [st, ct]], dtype=float)\n    M = Rm @ H @ S\n    Cc = C - 0.5\n    Cw = (Cc @ M.T) + 0.5\n    return np.clip(Cw, 0.0, 1.0)\n\ndef _grid_params():\n    # Small, safe magnitudes around identity\n    thetas = [0.0, 0.003, -0.003]            # ~0.17 degrees\n    sxs = [1.0, 1.004, 0.996]\n    sys = [1.0, 1.004, 0.996]\n    shxs = [0.0, 0.006, -0.006]\n    shys = [0.0, 0.006, -0.006]\n    for th in thetas:\n        for sx in sxs:\n            for sy in sys:\n                for kx in shxs:\n                    for ky in shys:\n                        yield (sx, sy, kx, ky, th)\n\n# ---------- Seeds ----------\ndef _seed_storage_best():\n    try:\n        C = np.load(\"storage/verity/best_centers.npy\")\n        r = np.load(\"storage/verity/best_radii.npy\")\n        if isinstance(C, np.ndarray) and C.shape == (N, 2) and isinstance(r, np.ndarray) and r.shape == (N,):\n            return np.clip(C.astype(float), 0.0, 1.0), np.maximum(R_MIN, r.astype(float))\n    except Exception:\n        pass\n    # Fallback seed: 6x6 grid minus corners\n    xs = np.linspace(0.1, 0.9, 6)\n    ys = np.linspace(0.1, 0.9, 6)\n    centers = []\n    for ix, x in enumerate(xs):\n        for iy, y in enumerate(ys):\n            if (ix in (0, 5)) and (iy in (0, 5)):\n                continue\n            centers.append([x, y])\n    C = np.array(centers, dtype=float)\n    r, _ = _solve_radii_lp_zero_slack(C)\n    r = _finalize_iterative(C, r)\n    return C, r\n\n# ---------- Main ----------\ndef construct_packing() -> tuple:\n    C0, r0 = _seed_storage_best()\n    base_sum = float(np.sum(r0))\n    print(f\"[affine] baseline sum={base_sum:.18f}\")\n\n    best_C = C0.copy()\n    best_r = r0.copy()\n    best_sum = base_sum\n    best_params = (1.0, 1.0, 0.0, 0.0, 0.0)\n\n    # Evaluate identity first (no-op), then grid of small warps\n    for (sx, sy, kx, ky, th) in _grid_params():\n        Cw = _apply_affine(C0, sx=sx, sy=sy, shx=kx, shy=ky, theta=th)\n        r_w, ok = _solve_radii_lp_zero_slack(Cw)\n        if not ok:\n            continue\n        r_w = _finalize_iterative(Cw, r_w)\n        s = float(np.sum(r_w))\n        print(f\"[affine] sx={sx:.6f} sy={sy:.6f} shx={kx:.6f} shy={ky:.6f} th={th:.6f} -> sum={s:.18f}\")\n        if s > best_sum + 1e-9:\n            best_sum = s\n            best_C = Cw\n            best_r = r_w\n            best_params = (sx, sy, kx, ky, th)\n\n    print(f\"[affine] best_sum={best_sum:.18f} params={best_params}\")\n\n    # Persist best\n    try:\n        os.makedirs(\"storage/verity\", exist_ok=True)\n        np.save(\"storage/verity/best_centers.npy\", best_C)\n        np.save(\"storage/verity/best_radii.npy\", best_r)\n    except Exception:\n        pass\n\n    return np.array(best_C, dtype=float), np.array(best_r, dtype=float)\n",
