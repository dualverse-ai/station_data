    \     radii[i] = max(radii[i], 0.0) # Ensure radii are non-negative\n\n    # Iteratively shrink radii to resolve overlaps\n    # Increased iterations for better convergence, and to be robust to complex configurations\n    for _ in range(40): \n      for i in range(n):\n        for j in range(i + 1, n):\n          dist_sq = np.sum((centers[i] - centers[j]) ** 2)\n          dist = np.sqrt(dist_sq) # Compute dist directly\n\n          rad_sum = radii[i] + radii[j]\n          \n          # If circles overlap, or are too close (within overlap_safety_margin)\n          # We need 'dist' to be strictly greater than 'rad_sum' for _evaluate to pass\n          if dist < rad_sum + overlap_safety_margin: \n            if rad_sum > 0: # Avoid division by zero\n              # Scale down radii proportionally. The new sum of radii should be slightly less than dist.\n              scale_factor = (dist - overlap_safety_margin) / rad_sum\n              \n              # Ensure scale_factor is positive\
    \ to prevent negative radii\n              if scale_factor > 0:\n                radii[i] *= scale_factor\n                radii[j] *= scale_factor\n              else: # If dist is too small, effectively force radii to 0 for these two circles\n                  radii[i] = 0.0\n                  radii[j] = 0.0\n\n    return np.maximum(radii, 0.0) # Ensure no negative radii after scaling down\n\n\n  def construct_packing() -> tuple:\n      \"\"\"\n      Construct a packing of 32 circles in the unit square using a hill-climbing\n      optimization approach.\n\n      Returns:\n          tuple: A tuple of (centers, radii) where:\n              - centers: np.ndarray of shape (32, 2) with (x, y) coordinates\n              - radii: np.ndarray of shape (32,) with radius of each circle\n      \"\"\"\n      n = 32\n      \n      # Initialize centers randomly within the unit square\n      best_centers = np.random.rand(n, 2)\n      best_radii = compute_max_radii(best_centers)\n      best_score =\
    \ np.sum(best_radii)\n\n      num_iterations = 5000 # Number of optimization steps\n      perturbation_strength = 0.01 # Standard deviation for Gaussian perturbation\n\n      for _ in range(num_iterations):\n          # Create a perturbed version of the current best centers\n          current_centers = best_centers + np.random.normal(0, perturbation_strength, (n, 2))\n          \n          # Clip centers to stay within the unit square [0,1]\n          current_centers = np.clip(current_centers, 0, 1)\n\n          # Compute radii for the perturbed centers\n          current_radii = compute_max_radii(current_centers)\n          current_score = np.sum(current_radii)\n\n          # If the new configuration is better, update best_centers and best_radii\n          if current_score > best_score:\n              best_score = current_score\n              best_centers = current_centers\n              best_radii = current_radii\n              \n      return best_centers, best_radii\n```"
