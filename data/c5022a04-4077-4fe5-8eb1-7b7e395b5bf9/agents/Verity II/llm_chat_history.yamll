tick: 457
role: model
parts:
- text: "Identity: Verity II (Recursive Agent)\nLocation: Reflection Chamber\n\nRecap: I completed a detailed blueprint for a KKT active-set Newton refiner (Option A null-space QP) integrated with our zero-slack LP pipeline. The station issued an inactivity notice; I will act now by submitting a minimal, deterministic implementation of the Option A refiner as a Stage-B local refinement on top of our storage-best seed. It runs a few safe iterations, logs diagnostics, persists non-destructively, and returns the best packing.\n\nActions:\n/execute_action{goto research}\n/execute_action{submit 1}\n```yaml\ntitle: \"KKT‑OptionA refiner (null‑space QP) + exact zero‑slack radii LP: deterministic Stage‑B local refinement\"\ntags: \"packing, kkt, active-set, linear programming, trust region, deterministic\"\nabstract: \"Implements a deterministic KKT Option‑A refiner: equality‑constrained QP in the linearized active manifold with trust region and backtracking, using exact zero‑slack radii LP + iterative\
    \ zero‑tolerance finalize as the merit. Runs a few safe iterations from storage‑best (fallback grid) and returns the best configuration. Prints concise diagnostics; persists candidates safely.\"\ncontent: |\n  import numpy as np\n  import os, sys\n  from math import sqrt\n\n  try:\n      from scipy.optimize import linprog\n  except Exception:\n      linprog = None\n\n  # ----- Constants -----\n  N = 32\n  R_MIN = 1e-8\n  THR_ACTIVE = 5e-13  # near-equality threshold for building active set\n  FINAL_PAIR_MARGIN = 5e-16  # float-safe margin for pairwise finalize\n  MAX_ITERS = 12\n  ALPHAS = [1.0, 0.7, 0.5, 0.35, 0.2, 0.12, 0.08]\n  TAU_C0 = 0.04\n  TAU_R0 = 0.02\n  EPS_ACCEPT = 1e-9\n\n  # ----- Utilities -----\n  def pair_indices(n=N):\n      return [(i, j) for i in range(n) for j in range(i+1, n)]\n  PAIRS = pair_indices(N)\n\n  def _fallback_grid():\n      xs = np.linspace(0.1, 0.9, 6)\n      ys = np.linspace(0.1, 0.9, 6)\n      centers = []\n      for ix, x in enumerate(xs):\n   \
    \       for iy, y in enumerate(ys):\n              if (ix in (0, 5)) and (iy in (0, 5)):\n                  continue\n              centers.append([x, y])\n      C = np.array(centers, dtype=float)\n      assert C.shape == (32, 2)\n      return C\n\n  def _seed_storage_best():\n      try:\n          C = np.load(\"storage/verity/best_centers.npy\")\n          if isinstance(C, np.ndarray) and C.shape == (N, 2):\n              return np.clip(C.astype(float), 0.0, 1.0)\n      except Exception:\n          pass\n      return None\n\n  # ----- Exact zero-slack radii LP -----\n  def exact_radii_lp(C):\n      x = C[:, 0]; y = C[:, 1]\n      rows = []\n      rhs = []\n\n      # Boundary caps: r_i <= x_i; r_i <= 1-x_i; r_i <= y_i; r_i <= 1-y_i\n      for i in range(N):\n          a = np.zeros(N); a[i] = 1.0; rows.append(a); rhs.append(max(0.0, float(x[i])))\n      for i in range(N):\n          a = np.zeros(N); a[i] = 1.0; rows.append(a); rhs.append(max(0.0, float(1.0 - x[i])))\n      for i in range(N):\n\
    \          a = np.zeros(N); a[i] = 1.0; rows.append(a); rhs.append(max(0.0, float(y[i])))\n      for i in range(N):\n          a = np.zeros(N); a[i] = 1.0; rows.append(a); rhs.append(max(0.0, float(1.0 - y[i])))\n\n      # Pairwise: r_i + r_j <= d_ij\n      for (i, j) in PAIRS:\n          a = np.zeros(N); a[i] = 1.0; a[j] = 1.0\n          dij = float(np.linalg.norm(C[i] - C[j]))\n          rows.append(a); rhs.append(max(0.0, dij))\n\n      A_ub = np.vstack(rows) if rows else None\n      b_ub = np.array(rhs) if rows else None\n      c = -np.ones(N)\n      bounds = [(R_MIN, None) for _ in range(N)]\n\n      if linprog is None:\n          # Fallback: boundary-limited, then greedy repair\n          r = np.minimum.reduce([x, 1.0 - x, y, 1.0 - y])\n          r = np.maximum(R_MIN, r)\n          r = finalize_zero_tol(C, r, max_passes=4)\n          return r, False\n\n      res = linprog(c, A_ub=A_ub, b_ub=b_ub, bounds=bounds, method=\"highs\")\n      if not res.success:\n          r = np.minimum.reduce([x,\
    \ 1.0 - x, y, 1.0 - y])\n          r = np.maximum(R_MIN, 0.99 * r)\n          r = finalize_zero_tol(C, r, max_passes=6)\n          return r, False\n      r = np.maximum(R_MIN, np.array(res.x, dtype=float))\n      return r, True\n\n  # ----- Finalize (iterative zero-tolerance; float-safe) -----\n  def finalize_zero_tol(C, r, max_passes=6, pair_margin=FINAL_PAIR_MARGIN):\n      r = np.array(r, dtype=float).copy()\n      x = C[:, 0]; y = C[:, 1]\n      # Boundary clamp\n      for _ in range(2):\n          r = np.minimum(r, x)\n          r = np.minimum(r, 1.0 - x)\n          r = np.minimum(r, y)\n          r = np.minimum(r, 1.0 - y)\n          r = np.maximum(r, R_MIN)\n      # Pairwise clamp with tiny margin\n      for _ in range(max_passes):\n          changed = False\n          for (i, j) in PAIRS:\n              dij = float(np.linalg.norm(C[i] - C[j]))\n              s = r[i] + r[j] - (dij - pair_margin)\n              if s > 0.0:\n                  cut = 0.5 * s\n                  #\
    \ Respect R_MIN\n                  di = min(cut, max(0.0, r[i] - R_MIN))\n                  dj = min(cut, max(0.0, r[j] - R_MIN))\n                  rem = s - (di + dj)\n                  if rem > 1e-18:\n                      # Try to take the remainder from whichever has room\n                      extra_i = min(rem, max(0.0, r[i] - R_MIN - di))\n                      di += extra_i; rem -= extra_i\n                  if rem > 1e-18:\n                      extra_j = min(rem, max(0.0, r[j] - R_MIN - dj))\n                      dj += extra_j; rem -= extra_j\n                  r[i] = max(R_MIN, r[i] - di)\n                  r[j] = max(R_MIN, r[j] - dj)\n                  changed = True\n          if not changed:\n              break\n      # Final boundary clamp\n      r = np.minimum(r, x); r = np.minimum(r, 1.0 - x)\n      r = np.minimum(r, y); r = np.minimum(r, 1.0 - y)\n      r = np.maximum(r, R_MIN)\n      return r\n\n  # ----- Active set from slacks -----\n  def slacks(C, r):\n   \
    \   x = C[:, 0]; y = C[:, 1]\n      sL = x - r\n      sR = 1.0 - x - r\n      sB = y - r\n      sT = 1.0 - y - r\n      sP = {}\n      for (i, j) in PAIRS:\n          dij = float(np.linalg.norm(C[i] - C[j]))\n          sP[(i, j)] = dij - (r[i] + r[j])\n      return sL, sR, sB, sT, sP\n\n  def build_active_sets(C, r, thr=THR_ACTIVE):\n      sL, sR, sB, sT, sP = slacks(C, r)\n      E = [(i, j) for (i, j), s in sP.items() if abs(s) <= thr]\n      B = []\n      for i in range(N):\n          if abs(sL[i]) <= thr: B.append((i, 'L'))\n          if abs(sR[i]) <= thr: B.append((i, 'R'))\n          if abs(sB[i]) <= thr: B.append((i, 'B'))\n          if abs(sT[i]) <= thr: B.append((i, 'T'))\n      return E, B\n\n  # ----- Jacobian and residuals for active equalities -----\n  def unit_vec(p):\n      n = float(np.linalg.norm(p))\n      if n < 1e-16:\n          return np.array([1.0, 0.0])\n      return p / n\n\n  def build_J_A(C, r, E, B):\n      # Variables ordered as [x_0..x_{N-1}, y_0..y_{N-1},\
    \ r_0..r_{N-1}]\n      rows = []\n      A = []\n      # Pair rows\n      for (i, j) in E:\n          u = unit_vec(C[i] - C[j])\n          row = np.zeros(3 * N)\n          # x block\n          row[i]      += -u[0]\n          row[j]      += +u[0]\n          # y block\n          row[N + i]  += -u[1]\n          row[N + j]  += +u[1]\n          # r block\n          row[2*N + i] += 1.0\n          row[2*N + j] += 1.0\n          rows.append(row)\n          dij = float(np.linalg.norm(C[i] - C[j]))\n          A.append(r[i] + r[j] - dij)\n      # Boundary rows\n      for (i, s) in B:\n          row = np.zeros(3 * N)\n          if s == 'L':\n              row[i]         = -1.0\n              row[2*N + i]   = +1.0\n              A.append(r[i] - C[i, 0])\n          elif s == 'R':\n              row[i]         = +1.0\n              row[2*N + i]   = +1.0\n              A.append(r[i] + C[i, 0] - 1.0)\n          elif s == 'B':\n              row[N + i]     = -1.0\n              row[2*N + i]   = +1.0\n\
    \              A.append(r[i] - C[i, 1])\n          else:  # 'T'\n              row[N + i]     = +1.0\n              row[2*N + i]   = +1.0\n              A.append(r[i] + C[i, 1] - 1.0)\n          rows.append(row)\n      if len(rows) == 0:\n          return np.zeros((0, 3 * N)), np.zeros((0,))\n      J = np.vstack(rows)\n      A = np.array(A, dtype=float)\n      return J, A\n\n  # ----- Option A step via normal equations -----\n  def optionA_step(J, A, tau_c, tau_r, ridge=1e-12):\n      nvars = 3 * N\n      # M^{-1} diagonal (elementwise): centers -> tau_c^2; radii -> tau_r^2\n      Minv = np.empty(nvars, dtype=float)\n      Minv[:2*N] = tau_c * tau_c\n      Minv[2*N:] = tau_r * tau_r\n\n      # e_r vector (zeros except ones on radii block)\n      e_r = np.zeros(nvars, dtype=float)\n      e_r[2*N:] = 1.0\n\n      m = J.shape[0]\n      if m == 0:\n          # No active equalities: projected ascent on radii only (will be rejected unless geometry changes)\n          dz = Minv * e_r\n    \
    \      return dz\n\n      # S = J * diag(Minv) * J^T\n      J_scaled = J * Minv  # column-wise scaling via broadcasting\n      S = J_scaled.dot(J.T)\n      # b = A + J * (Minv * e_r)\n      b = A + J.dot(Minv * e_r)\n\n      # Regularize S slightly to ensure SPD\n      S = S + ridge * np.eye(m)\n      try:\n          nu = np.linalg.solve(S, b)\n      except np.linalg.LinAlgError:\n          # Increase ridge and retry once\n          S = S + (1e-9) * np.eye(m)\n          nu = np.linalg.lstsq(S, b, rcond=1e-12)[0]\n\n      # Δz = Minv * (e_r - J^T nu)\n      JTnu = J.T.dot(nu)\n      dz = Minv * (e_r - JTnu)\n      return dz\n\n  def clip_trust(dz, tau_c, tau_r):\n      dz = dz.copy()\n      # centers\n      dz[:2*N] = np.clip(dz[:2*N], -tau_c, tau_c)\n      # radii\n      dz[2*N:] = np.clip(dz[2*N:], -tau_r, tau_r)\n      return dz\n\n  # ----- Refiner loop (deterministic) -----\n  def kkt_refine(C0, max_iters=MAX_ITERS, tau_c0=TAU_C0, tau_r0=TAU_R0, eps_accept=EPS_ACCEPT):\n      # Initialize\
    \ at seed\n      r0, _ = exact_radii_lp(C0)\n      r0 = finalize_zero_tol(C0, r0)\n      best_C = C0.copy(); best_r = r0.copy()\n      best_sum = float(np.sum(best_r))\n\n      tau_c = tau_c0; tau_r = tau_r0\n      C = C0.copy(); r = r0.copy()\n      print(f\"[kkt] start sum={best_sum:.15f}, tau_c={tau_c:.4f}, tau_r={tau_r:.4f}\")\n\n      for it in range(max_iters):\n          E, B = build_active_sets(C, r, thr=THR_ACTIVE)\n          J, A = build_J_A(C, r, E, B)\n          dz = optionA_step(J, A, tau_c, tau_r)\n          dz = clip_trust(dz, tau_c, tau_r)\n\n          accepted = False\n          for a in ALPHAS:\n              # Trial step\n              z = np.concatenate([C[:,0], C[:,1], r])\n              z_trial = z + a * dz\n              X = z_trial[:N]; Y = z_trial[N:2*N]; R = z_trial[2*N:]\n              C_trial = np.stack([np.clip(X, 0.0, 1.0), np.clip(Y, 0.0, 1.0)], axis=1)\n              r_exact, ok = exact_radii_lp(C_trial)\n              if not ok:\n                  continue\n\
    \              r_fin = finalize_zero_tol(C_trial, r_exact)\n              gain = float(np.sum(r_fin) - np.sum(r))\n              print(f\"[kkt] it={it:02d} alpha={a:.2f} gain={gain:.12e} E={len(E)} B={len(B)}\")\n              if gain >= eps_accept:\n                  C = C_trial; r = r_fin\n                  s = float(np.sum(r))\n                  if s > best_sum + 0.0:\n                      best_sum = s; best_C = C.copy(); best_r = r.copy()\n                  tau_c = min(0.12, 1.2 * tau_c)\n                  tau_r = min(0.06, 1.2 * tau_r)\n                  accepted = True\n                  break\n          if not accepted:\n              tau_c *= 0.6; tau_r *= 0.6\n              print(f\"[kkt] it={it:02d} reject; tau_c={tau_c:.4f}, tau_r={tau_r:.4f}\")\n              if tau_c < 1e-3 or tau_r < 5e-4:\n                  break\n\n      print(f\"[kkt] end   sum={best_sum:.15f}\")\n      return best_C, best_r, best_sum\n\n  # ----- Main entry -----\n  def construct_packing() -> tuple:\n\
    \      # Seed: storage best, else fallback grid\n      C0 = _seed_storage_best()\n      seed_name = \"storage-best\" if C0 is not None else \"grid-36minus4\"\n      if C0 is None:\n          C0 = _fallback_grid()\n\n      # Run KKT Option-A refiner (deterministic, few iterations)\n      C_opt, r_opt, s_opt = kkt_refine(C0, max_iters=MAX_ITERS)\n\n      # Final safety pass\n      r_opt = finalize_zero_tol(C_opt, r_opt)\n\n      # Persist non-destructively\n      try:\n          os.makedirs(\"storage/verity\", exist_ok=True)\n          np.save(\"storage/verity/kkt_last_centers.npy\", C_opt)\n          np.save(\"storage/verity/kkt_last_radii.npy\", r_opt)\n          # Gate best writes conservatively\n          if s_opt >= 2.93:\n              np.save(\"storage/verity/kkt_candidate_centers.npy\", C_opt)\n              np.save(\"storage/verity/kkt_candidate_radii.npy\", r_opt)\n      except Exception:\n          pass\n\n      print(f\"[kkt] seed={seed_name} best_sum={s_opt:.15f}\")\n    \
    \  return np.array(C_opt, dtype=float), np.array(r_opt, dtype=float)\n```"
