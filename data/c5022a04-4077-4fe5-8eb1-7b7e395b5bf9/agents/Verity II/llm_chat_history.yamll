parts:
- text: "Identity: Verity II (Recursive Agent)\nLocation: Research Counter\n\nRecap: SQP v0 dry-run (Eval 808) validated the pipeline but made no gains, reinforcing local rigidity at mid-range baseline. I’ll implement targeted SQP upgrades (central-difference gradient, SVD/QR-style null-space projection, and a trust-region cap) in storage, then run a Phase-1b dry-run with strict accept-if-improve and diagnostics.\n\nActions:\n/execute_action{storage write verity/sqp_core_v1.py}\n```yaml\ncontent: |\n  import numpy as np\n  try:\n      from scipy.optimize import linprog\n  except Exception:\n      linprog = None\n\n  # SQP/Active-Set Newton core v1 (improved): central-diff grad, SVD null-space projection, trust region.\n  # Centers-only refinement; radii via exact zero-slack LP at evaluation.\n\n  N = 32\n  R_MIN = 1e-8\n  PAIR_EPS = 5e-16\n  MAX_FINALIZE_ITERS = 4\n\n  def _pairs(n=N):\n      return [(i, j) for i in range(n) for j in range(i+1, n)]\n  PAIRS = _pairs()\n\n  # ---------- Finalize\
    \ (iterative, zero-tolerance with tiny safety) ----------\n  def finalize_bounds(C, r):\n      x = C[:,0]; y = C[:,1]\n      bnd = np.minimum.reduce([x, 1.0 - x, y, 1.0 - y])\n      return np.minimum(np.maximum(R_MIN, r), np.maximum(R_MIN, bnd))\n\n  def finalize_pairs(C, r, pair_eps=PAIR_EPS, iters=MAX_FINALIZE_ITERS):\n      r = r.copy()\n      for _ in range(iters):\n          changed = False\n          for (i, j) in PAIRS:\n              dij = float(np.linalg.norm(C[i] - C[j]))\n              cap = dij - pair_eps\n              s = r[i] + r[j]\n              if s > cap:\n                  need = s - cap\n                  di = min(0.5*need, max(0.0, r[i] - R_MIN))\n                  dj = min(0.5*need, max(0.0, r[j] - R_MIN))\n                  rem = need - (di + dj)\n                  if rem > 0:\n                      extra = min(rem, max(0.0, r[i] - R_MIN - di)); di += extra; rem -= extra\n                  if rem > 0:\n                      extra = min(rem, max(0.0, r[j] - R_MIN\
    \ - dj)); dj += extra; rem -= extra\n                  r[i] = max(R_MIN, r[i] - di)\n                  r[j] = max(R_MIN, r[j] - dj)\n                  changed = True\n          if not changed:\n              break\n      return r\n\n  def finalize_all(C, r):\n      r = finalize_bounds(C, r)\n      r = finalize_pairs(C, r)\n      r = finalize_bounds(C, r)\n      return r\n\n  # ---------- Exact zero-slack radii LP ----------\n  def solve_radii_lp(C):\n      n = C.shape[0]\n      x = C[:,0]; y = C[:,1]\n      if linprog is None:\n          r = np.maximum(R_MIN, np.minimum.reduce([x, 1.0-x, y, 1.0-y]))\n          return finalize_all(C, r), False\n\n      rows = []; rhs = []\n      for i in range(n):\n          a = np.zeros(n); a[i] = 1.0; rows.append(a); rhs.append(float(x[i]))\n      for i in range(n):\n          a = np.zeros(n); a[i] = 1.0; rows.append(a); rhs.append(float(1.0 - x[i]))\n      for i in range(n):\n          a = np.zeros(n); a[i] = 1.0; rows.append(a); rhs.append(float(y[i]))\n\
    \      for i in range(n):\n          a = np.zeros(n); a[i] = 1.0; rows.append(a); rhs.append(float(1.0 - y[i]))\n      for (i, j) in PAIRS:\n          a = np.zeros(n); a[i] = 1.0; a[j] = 1.0\n          dij = float(np.linalg.norm(C[i] - C[j]))\n          rows.append(a); rhs.append(dij)\n\n      A_ub = np.vstack(rows).astype(float)\n      b_ub = np.array(rhs, dtype=float)\n      c = -np.ones(n, dtype=float)\n      bounds = [(R_MIN, None) for _ in range(n)]\n      res = linprog(c, A_ub=A_ub, b_ub=b_ub, bounds=bounds, method=\"highs\")\n      if not res.success:\n          r = np.maximum(R_MIN, np.minimum.reduce([x, 1.0-x, y, 1.0-y]))\n          return finalize_all(C, r), False\n      r = np.maximum(R_MIN, np.array(res.x, dtype=float))\n      return finalize_all(C, r), True\n\n  def merit_sum_r(C):\n      r, _ = solve_radii_lp(C)\n      return float(np.sum(r)), r\n\n  # ---------- Active set detection ----------\n  def detect_active_set(C, r, tol=5e-16):\n      x = C[:,0]; y = C[:,1]\n \
    \     act = {\n          \"pair\": [],\n          \"left\": [], \"right\": [], \"bottom\": [], \"top\": []\n      }\n      for (i, j) in PAIRS:\n          dij = float(np.linalg.norm(C[i] - C[j]))\n          if dij - (r[i] + r[j]) <= tol:\n              act[\"pair\"].append((i, j))\n      for i in range(N):\n          if x[i] - r[i] <= tol: act[\"left\"].append(i)\n          if (1.0 - x[i]) - r[i] <= tol: act[\"right\"].append(i)\n          if y[i] - r[i] <= tol: act[\"bottom\"].append(i)\n          if (1.0 - y[i]) - r[i] <= tol: act[\"top\"].append(i)\n      return act\n\n  def build_A(C, act):\n      # Linear equalities A δ = 0 to keep actives tight (first order).\n      rows = []\n      for (i, j) in act.get(\"pair\", []):\n          d = C[i] - C[j]\n          nrm = float(np.linalg.norm(d))\n          u = np.array([1.0, 0.0]) if nrm < 1e-16 else d / nrm\n          row = np.zeros(2*N)\n          row[2*i:2*i+2] += u\n          row[2*j:2*j+2] -= u\n          rows.append(row)\n      for\
    \ i in act.get(\"left\", []):\n          row = np.zeros(2*N); row[2*i+0] = 1.0; rows.append(row)\n      for i in act.get(\"right\", []):\n          row = np.zeros(2*N); row[2*i+0] = 1.0; rows.append(row)\n      for i in act.get(\"bottom\", []):\n          row = np.zeros(2*N); row[2*i+1] = 1.0; rows.append(row)\n      for i in act.get(\"top\", []):\n          row = np.zeros(2*N); row[2*i+1] = 1.0; rows.append(row)\n      return np.vstack(rows) if rows else np.zeros((0, 2*N))\n\n  # ---------- Central-difference gradient (thinned basis) ----------\n  def finite_diff_grad_central(C, basis_idx=None, h=1e-5):\n      s0, _ = merit_sum_r(C)\n      G = np.zeros((N,2), dtype=float)\n      if basis_idx is None:\n          basis_idx = list(range(N))\n      for i in basis_idx:\n          for k in (0,1):\n              dC = np.zeros_like(C); dC[i, k] = h\n              Cp = np.clip(C + dC, 0.0, 1.0)\n              Cm = np.clip(C - dC, 0.0, 1.0)\n              sp, _ = merit_sum_r(Cp)\n           \
    \   sm, _ = merit_sum_r(Cm)\n              G[i, k] = (sp - sm) / (2.0 * h)\n      return G\n\n  # ---------- Null-space projection via SVD with trust region ----------\n  def nullspace_project_svd(A, g_flat, tau=0.02, svd_tol=None):\n      d = g_flat.shape[0]\n      if A.shape[0] == 0:\n          delta = g_flat.copy()\n      else:\n          # A is m x d\n          try:\n              U, S, Vh = np.linalg.svd(A, full_matrices=True)\n          except np.linalg.LinAlgError:\n              # fall back to normal-equation style projection\n              M = A @ A.T + 1e-8 * np.eye(A.shape[0])\n              y = np.linalg.solve(M, A @ g_flat)\n              delta = g_flat - A.T @ y\n          else:\n              if svd_tol is None:\n                  svd_tol = (S[0] if S.size > 0 else 1.0) * 1e-10\n              V = Vh.T\n              mask = (S <= svd_tol)\n              # If no strict nullspace due to tol, keep smallest singular vectors as nullspace approx\n              if not np.any(mask)\
    \ and S.size > 0:\n                  # take last r vectors with smallest singular values (at least 1)\n                  r = min(2, V.shape[1])  # conservative\n                  Z = V[:, -r:]\n              else:\n                  Z = V[:, np.where(mask)[0]] if S.size > 0 else np.eye(d)\n              if Z.size == 0:\n                  delta = np.zeros_like(g_flat)\n              else:\n                  delta = Z @ (Z.T @ g_flat)\n      nrm = float(np.linalg.norm(delta))\n      if nrm > tau and nrm > 0:\n          delta = (tau / nrm) * delta\n      return delta\n\n  def line_search(C, delta_flat, alphas=(1e-2, 6e-3, 3e-3, 1e-3, 6e-4, 3e-4, 1e-4), eps_accept=5e-10):\n      s0, r0 = merit_sum_r(C)\n      best_C, best_r, best_s = C, r0, s0\n      delta = delta_flat.reshape(N,2)\n      for a in alphas:\n          C_try = np.clip(C + a * delta, 0.0, 1.0)\n          s_try, r_try = merit_sum_r(C_try)\n          if s_try > best_s + eps_accept:\n              best_C, best_r, best_s = C_try,\
    \ r_try, s_try\n              break\n      return best_C, best_r, best_s\n\n  def step_sqp_v1(C, tol_act=5e-16, basis_idx=None, h=1e-5, tau=0.02):\n      s0, r0 = merit_sum_r(C)\n      act = detect_active_set(C, r0, tol=tol_act)\n      A = build_A(C, act)\n      G = finite_diff_grad_central(C, basis_idx=basis_idx, h=h)\n      g_flat = G.reshape(-1)\n      delta_flat = nullspace_project_svd(A, g_flat, tau=tau)\n      C_new, r_new, s_new = line_search(C, delta_flat)\n      improved = (s_new > s0 + 5e-10)\n      info = {\n          \"s0\": s0, \"s_new\": s_new,\n          \"n_act_pair\": len(act[\"pair\"]), \"A_shape\": A.shape,\n          \"tau\": tau, \"h\": h, \"basis_len\": len(basis_idx) if basis_idx is not None else N\n      }\n      return improved, C_new, r_new, s_new, info\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"SQP v1 Dry‑Run: central‑difference gradient + SVD null‑space projection + trust region (centers‑only)\"\ntags: \"sqp, active-set, second-order, linear programming,\
    \ zero-slack, diagnostics\"\nabstract: \"Phase‑1b validation of improved SQP: central‑difference merit gradient on a thinned basis, SVD‑based null‑space projection with a trust‑region cap, exact zero‑slack radii LP + iterative zero‑tolerance finalize, strict accept‑if‑improve. Runs from storage‑best (~2.93201209); prints diagnostics; persists only if improved.\"\ncontent: |\n  import numpy as np\n  import os, sys\n  sys.path.append('storage/verity')\n  try:\n      import sqp_core_v1 as sqp1\n  except Exception as e:\n      sqp1 = None\n\n  N = 32\n\n  def _seed_grid_minus_corners():\n      xs = np.linspace(0.1, 0.9, 6)\n      ys = np.linspace(0.1, 0.9, 6)\n      centers = []\n      for ix, X in enumerate(xs):\n          for iy, Y in enumerate(ys):\n              if (ix in (0,5)) and (iy in (0,5)):\n                  continue\n              centers.append([X, Y])\n      return np.array(centers, dtype=float)\n\n  def _load_baseline():\n      C = None\n      try:\n          C = np.load(\"\
    storage/verity/best_centers.npy\")\n          if not (isinstance(C, np.ndarray) and C.shape == (N,2)):\n              C = None\n      except Exception:\n          C = None\n      if C is None:\n          C = _seed_grid_minus_corners()\n      return np.clip(C.astype(float), 0.0, 1.0)\n\n  def construct_packing() -> tuple:\n      if sqp1 is None:\n          C = _seed_grid_minus_corners()\n          x, y = C[:,0], C[:,1]\n          r = np.maximum(1e-8, np.minimum.reduce([x, 1.0-x, y, 1.0-y]))\n          print(\"[SQP v1] fallback: module import failed; returning safe baseline.\")\n          return C, r\n\n      C = _load_baseline()\n      s0, r0 = sqp1.merit_sum_r(C)\n      print(f\"[SQP v1] start sum={s0:.15f}\")\n\n      best_C, best_r, best_s = C.copy(), r0.copy(), float(s0)\n      accepts = 0\n      noimp = 0\n      max_outer = 24\n      basis_idx = list(range(0, N, 2))  # thinned deterministic basis\n\n      for it in range(max_outer):\n          improved, C1, R1, S1, info = sqp1.step_sqp_v1(best_C,\
    \ basis_idx=basis_idx, h=8e-6, tau=0.02)\n          print(f\"[SQP v1] it={it:02d} s0={info['s0']:.15f} s1={info['s_new']:.15f} \"\n                f\"act_pairs={info['n_act_pair']} A_shape={info['A_shape']} \"\n                f\"h={info['h']:.1e} tau={info['tau']:.3f} basis_len={info['basis_len']}\")\n          if improved:\n              best_C, best_r, best_s = C1, R1, S1\n              accepts += 1\n              noimp = 0\n              # rotate basis to odd indices\n              basis_idx = list(range(1, N, 2))\n          else:\n              noimp += 1\n              if noimp >= 6:\n                  break\n              # alternate basis anyway\n              basis_idx = list(range((it+1) % 2, N, 2))\n\n          if accepts >= 8:\n              break\n\n      if best_s > s0 + 5e-10:\n          try:\n              os.makedirs(\"storage/verity\", exist_ok=True)\n              np.save(\"storage/verity/best_centers.npy\", best_C)\n              np.save(\"storage/verity/best_radii.npy\"\
    , best_r)\n              print(f\"[SQP v1] persisted improved packing sum={best_s:.15f}\")\n          except Exception:\n              pass\n\n      return np.array(best_C, dtype=float), np.array(best_r, dtype=float)\n```"
