tick: 548
role: model
parts:
- text: "Identity: Verity II (Recursive Agent)\nLocation: Research Counter\n\nRecap: Inactivity notice received. Recent experiments (SQP v2.x, GRH) were substantive but yielded no gains; local rigidity persists. I will run a new, non-placeholder experiment: a Chebyshev-style “Uniform Raise” SCP-LP step that seeks a common increase t in all radii within a trust region, then releases the constraint and verifies with the exact zero-slack radii LP + iterative zero-tolerance finalize. This is distinct from prior methods and can reveal coordinated feasible growth that sum-max steps might miss.\n\nActions:\n/execute_action{submit 1}\n```yaml\ntitle: \"UR‑SCP‑LP: Chebyshev Uniform‑Raise step (maximize common t) + exact zero‑slack radii with iterative zero‑tol finalize\"\ntags: \"linear programming, chebyshev, scp-lp, zero-slack, trust region, analysis\"\nabstract: \"We add a Chebyshev 'uniform raise' variable t to the SCP‑LP step: maximize t subject to linearized non‑overlap, boundary ties, trust‑region\
    \ bounds, and r_i ≥ r_base_i + t. After solving, we release equalities and verify with the exact zero‑slack radii LP + iterative zero‑tolerance finalize; accept only strict improvements. Deterministic seeds (storage‑best, jitter, grid) with adaptive τ; concise diagnostics are printed.\"\ncontent: |\n  import numpy as np\n  import os\n  try:\n      from scipy.optimize import linprog\n  except Exception:\n      linprog = None\n\n  N = 32\n  R_MIN = 1e-8\n  PAIR_EPS = 0.0      # zero-slack modeling in linearized step\n  MAX_FINALIZE_ITERS = 4\n\n  def _pairs(n=N):\n      return [(i, j) for i in range(n) for j in range(i+1, n)]\n  PAIRS = _pairs()\n\n  # ---------- Finalize (iterative, zero-tolerance with tiny safety) ----------\n  def _finalize_bounds(C, r):\n      x = C[:,0]; y = C[:,1]\n      bnd = np.minimum.reduce([x, 1.0 - x, y, 1.0 - y])\n      return np.minimum(np.maximum(R_MIN, r), np.maximum(R_MIN, bnd))\n\n  def _finalize_pairs(C, r, pair_eps=5e-16, iters=MAX_FINALIZE_ITERS):\n\
    \      r = r.copy()\n      for _ in range(iters):\n          changed = False\n          for (i, j) in PAIRS:\n              dij = float(np.linalg.norm(C[i] - C[j]))\n              s = r[i] + r[j]\n              cap = dij - pair_eps\n              if s > cap:\n                  need = s - cap\n                  di = min(0.5*need, max(0.0, r[i] - R_MIN))\n                  dj = min(0.5*need, max(0.0, r[j] - R_MIN))\n                  rem = need - (di + dj)\n                  if rem > 0:\n                      extra = min(rem, max(0.0, r[i] - R_MIN - di)); di += extra; rem -= extra\n                  if rem > 0:\n                      extra = min(rem, max(0.0, r[j] - R_MIN - dj)); dj += extra; rem -= extra\n                  r[i] = max(R_MIN, r[i] - di)\n                  r[j] = max(R_MIN, r[j] - dj)\n                  changed = True\n          if not changed:\n              break\n      return r\n\n  def _finalize_all(C, r):\n      r = _finalize_bounds(C, r)\n      r = _finalize_pairs(C,\
    \ r)\n      r = _finalize_bounds(C, r)\n      return r\n\n  # ---------- Exact zero-slack radii LP ----------\n  def _solve_radii_lp(C):\n      n = C.shape[0]\n      x = C[:,0]; y = C[:,1]\n      if linprog is None:\n          r = np.maximum(R_MIN, np.minimum.reduce([x, 1.0-x, y, 1.0-y]))\n          return _finalize_all(C, r), False\n\n      rows = []; rhs = []\n      # boundaries\n      for i in range(n):\n          a = np.zeros(n); a[i] = 1.0; rows.append(a); rhs.append(float(x[i]))\n      for i in range(n):\n          a = np.zeros(n); a[i] = 1.0; rows.append(a); rhs.append(float(1.0 - x[i]))\n      for i in range(n):\n          a = np.zeros(n); a[i] = 1.0; rows.append(a); rhs.append(float(y[i]))\n      for i in range(n):\n          a = np.zeros(n); a[i] = 1.0; rows.append(a); rhs.append(float(1.0 - y[i]))\n      # pairwise\n      for (i, j) in PAIRS:\n          a = np.zeros(n); a[i] = 1.0; a[j] = 1.0\n          dij = float(np.linalg.norm(C[i] - C[j]))\n          rows.append(a); rhs.append(dij)\n\
    \n      A_ub = np.vstack(rows).astype(float)\n      b_ub = np.array(rhs, dtype=float)\n      c = -np.ones(n, dtype=float)\n      bounds = [(R_MIN, None) for _ in range(n)]\n      res = linprog(c, A_ub=A_ub, b_ub=b_ub, bounds=bounds, method=\"highs\")\n      if not res.success:\n          r = np.maximum(R_MIN, np.minimum.reduce([x, 1.0-x, y, 1.0-y]))\n          return _finalize_all(C, r), False\n      r = np.maximum(R_MIN, np.array(res.x, dtype=float))\n      return _finalize_all(C, r), True\n\n  # ---------- Build UR-SCP-LP (maximize common t) ----------\n  def _build_ur_scp_lp(C0, r_base, tau, eps_pair=PAIR_EPS):\n      \"\"\"\n      Variables v = [x(0..n-1), y(n..2n-1), r(2n..3n-1), t(3n)]\n      Objective: maximize t -> minimize c·v with c_t = -1\n      Constraints:\n        - Pairwise linearized (supporting hyperplane at C0): r_i + r_j - u·((x_i-x_j,y_i-y_j)) <= 0\n        - Boundary ties: r_i - x_i <= 0; r_i + x_i <= 1; r_i - y_i <= 0; r_i + y_i <= 1\n        - Uniform raise: r_i\
    \ - t >= r_base[i]  ->  (-r_i + t) <= -r_base[i]\n        - Trust region via bounds on x,y; r >= R_MIN; t free (lower bound can be None)\n      \"\"\"\n      n = C0.shape[0]\n      m = 3*n + 1\n      rows = []; rhs = []\n\n      # Pairwise linearized constraints\n      for (i, j) in PAIRS:\n          d0 = C0[i] - C0[j]\n          norm0 = float(np.linalg.norm(d0))\n          u = np.array([1.0, 0.0]) if norm0 < 1e-16 else d0 / norm0\n          row = np.zeros(m)\n          row[2*n + i] = 1.0\n          row[2*n + j] = 1.0\n          row[i]       -= u[0]; row[j]       += u[0]\n          row[n + i]   -= u[1]; row[n + j]   += u[1]\n          rows.append(row); rhs.append(-float(eps_pair))\n\n      # Boundary ties\n      for i in range(n):\n          row = np.zeros(m); row[2*n + i] = 1.0; row[i] -= 1.0\n          rows.append(row); rhs.append(0.0)\n          row = np.zeros(m); row[2*n + i] = 1.0; row[i] += 1.0\n          rows.append(row); rhs.append(1.0)\n          row = np.zeros(m); row[2*n +\
    \ i] = 1.0; row[n + i] -= 1.0\n          rows.append(row); rhs.append(0.0)\n          row = np.zeros(m); row[2*n + i] = 1.0; row[n + i] += 1.0\n          rows.append(row); rhs.append(1.0)\n\n      # Uniform raise: -r_i + t <= -r_base[i]\n      for i in range(n):\n          row = np.zeros(m)\n          row[2*n + i] = -1.0\n          row[3*n] = 1.0\n          rows.append(row); rhs.append(-float(r_base[i]))\n\n      A_ub = np.vstack(rows).astype(float)\n      b_ub = np.array(rhs, dtype=float)\n\n      # Objective\n      c = np.zeros(m); c[3*n] = -1.0  # maximize t\n\n      # Bounds with trust region\n      x0 = C0[:,0]; y0 = C0[:,1]\n      x_lb = np.maximum(0.0, x0 - tau); x_ub = np.minimum(1.0, x0 + tau)\n      y_lb = np.maximum(0.0, y0 - tau); y_ub = np.minimum(1.0, y0 + tau)\n      bounds = []\n      for i in range(n): bounds.append((float(x_lb[i]), float(x_ub[i])))\n      for i in range(n): bounds.append((float(y_lb[i]), float(y_ub[i])))\n      for i in range(n): bounds.append((R_MIN,\
    \ None))\n      bounds.append((None, None))  # t is free\n\n      return A_ub, b_ub, bounds, c\n\n  def _step_ur(C0, tau):\n      if linprog is None:\n          return None, None, None\n      r_base, _ = _solve_radii_lp(C0)\n      A_ub, b_ub, bounds, c = _build_ur_scp_lp(C0, r_base, tau)\n      res = linprog(c, A_ub=A_ub, b_ub=b_ub, bounds=bounds, method=\"highs\")\n      if not res.success:\n          return None, None, res\n      n = C0.shape[0]\n      x = res.x\n      X = x[:n]; Y = x[n:2*n]; R_lin = x[2*n:3*n]; t = x[3*n]\n      C_new = np.stack([X, Y], axis=1)\n      return C_new, R_lin, t\n\n  # ---------- Optimize with UR steps ----------\n  def _candidate_optimize(Cinit, max_outer=24, verbose=True):\n      C = Cinit.copy()\n      r0, _ = _solve_radii_lp(C)\n      best_C = C.copy(); best_r = r0.copy()\n      best_s = float(np.sum(best_r))\n      tau = 0.06; min_tau = 1e-3; patience = 8; noimp = 0\n\n      if verbose:\n          print(f\"[UR] start sum={best_s:.15f}\")\n\n    \
    \  for it in range(max_outer):\n          step = _step_ur(C, tau)\n          if step[0] is None:\n              tau *= 0.6\n              if tau < min_tau: break\n              continue\n          C_lin, _, t = step\n          r_exact, ok = _solve_radii_lp(C_lin)\n          if not ok:\n              tau *= 0.6\n              if tau < min_tau: break\n              continue\n          s = float(np.sum(r_exact))\n          if verbose:\n              print(f\"[UR] it={it:02d} tau={tau:.4f} t_hat={t:.3e} sum={s:.15f} best={best_s:.15f}\")\n          if s > best_s + 5e-10:\n              best_s = s; best_C = C_lin; best_r = r_exact; C = C_lin\n              tau = min(0.12, tau * 1.2); noimp = 0\n          else:\n              tau *= 0.6; noimp += 1\n              if tau < min_tau or noimp >= patience:\n                  break\n\n      return best_C, best_r, best_s\n\n  # ---------- Seeds ----------\n  def _seed_grid_minus_corners():\n      xs = np.linspace(0.1, 0.9, 6)\n      ys = np.linspace(0.1,\
    \ 0.9, 6)\n      centers = []\n      for ix, X in enumerate(xs):\n          for iy, Y in enumerate(ys):\n              if (ix in (0,5)) and (iy in (0,5)):\n                  continue\n              centers.append([X, Y])\n      return np.array(centers, dtype=float)\n\n  def _load_storage_best():\n      try:\n          C = np.load(\"storage/verity/best_centers.npy\")\n          if isinstance(C, np.ndarray) and C.shape == (N,2):\n              return np.clip(C.astype(float), 0.0, 1.0)\n      except Exception:\n          pass\n      return None\n\n  def _jitter(C, amp=0.0015, seed=12321):\n      rng = np.random.default_rng(seed)\n      return np.clip(C + rng.uniform(-amp, amp, size=C.shape), 0.0, 1.0)\n\n  # ---------- Main ----------\n  def construct_packing() -> tuple:\n      seeds = []\n      Cb = _load_storage_best()\n      if Cb is not None:\n          seeds.append((\"storage-best\", Cb))\n          seeds.append((\"storage-best-jitter\", _jitter(Cb, amp=0.0015, seed=12321)))\n    \
    \  else:\n          seeds.append((\"grid-36minus4\", _seed_grid_minus_corners()))\n\n      best_sum = -1.0; best_C = None; best_r = None\n\n      for (name, C0) in seeds:\n          C0 = np.clip(C0, 0.0, 1.0)\n          C_opt, r_opt, s_opt = _candidate_optimize(C0, max_outer=24, verbose=False)\n          print(f\"[UR] seed={name} -> sum={s_opt:.15f}\")\n          if s_opt > best_sum:\n              best_sum = s_opt; best_C = C_opt; best_r = r_opt\n\n      # Persist only if strictly improved over storage-best\n      try:\n          if Cb is not None:\n              r_base, _ = _solve_radii_lp(Cb)\n              s_base = float(np.sum(r_base))\n          else:\n              s_base = -1.0\n          if best_sum > s_base + 5e-10:\n              os.makedirs(\"storage/verity\", exist_ok=True)\n              np.save(\"storage/verity/best_centers.npy\", best_C)\n              np.save(\"storage/verity/best_radii.npy\", best_r)\n              print(f\"[UR] persisted improved packing sum={best_sum:.15f}\"\
    )\n      except Exception:\n          pass\n\n      return np.array(best_C, dtype=float), np.array(best_r, dtype=float)\n```"
