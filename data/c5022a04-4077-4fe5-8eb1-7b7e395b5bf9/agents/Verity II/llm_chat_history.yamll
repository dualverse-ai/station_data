tick: 339
role: model
parts:
- text: "Identity: Verity II (Recursive Agent)\nLocation: Reflection Chamber\nPlan: Implement the HRG (feasible-path homotopy) experiment I specified during reflection: propose Δr, solve a minimal-move feasibility LP for center displacements under zero-slack ties, verify with exact zero-slack radii LP, and accept only strictly positive gains. Deterministic seeds, fixed α/τ schedules, thorough logs, and persistence.\n\nExecuting now.\n\n/execute_action{goto research}\n/execute_action{submit 1}\n```yaml\ntitle: \"HRG: Feasible‑path homotopy on radii via minimal‑move feasibility LP (zero‑slack, zero‑tol finalize)\"\ntags: \"packing, linear programming, feasible path, homotopy, sequential convex programming, zero slack\"\nabstract: \"Starting from storage‑best seeds, we propose Δr and solve a minimal‑move feasibility LP for center displacements under zero‑slack pair/boundary ties (trust region), then verify with exact zero‑slack radii LP and zero‑tolerance finalize. Deterministic α/τ schedules,\
    \ strict acceptance (Δ∑r>1e‑6), and logs. This separates ‘grow radii’ from ‘move minimally’ and can discover tiny feasible gains SCP‑LP rejects.\"\ncontent: |\n  import numpy as np\n  import os, sys\n  try:\n      from scipy.optimize import linprog\n  except Exception:\n      linprog = None\n\n  # Import modular zero-slack core if available\n  sys.path.append('storage/verity')\n  try:\n      import scp_lp_core as core\n  except Exception:\n      core = None\n\n  N = 32\n  R_MIN = 1e-8\n\n  # ---------------- Utilities ----------------\n  def _pair_indices(n=N):\n      return [(i, j) for i in range(n) for j in range(i + 1, n)]\n  PAIRS = _pair_indices(N)\n\n  def _safe_unit(vec):\n      nrm = float(np.linalg.norm(vec))\n      if nrm < 1e-16:\n          return np.array([1.0, 0.0])\n      return vec / nrm\n\n  def _solve_radii_zero_slack(C):\n      if core is not None and hasattr(core, \"solve_radii_lp_zero_slack\"):\n          return core.solve_radii_lp_zero_slack(C)\n      # Fallback\
    \ inline zero-slack radii LP\n      if linprog is None:\n          x, y = C[:, 0], C[:, 1]\n          r = np.maximum(R_MIN, np.minimum.reduce([x, 1.0 - x, y, 1.0 - y]))\n          return r, False\n      n = C.shape[0]\n      rows, rhs = [], []\n      x, y = C[:, 0], C[:, 1]\n      # Boundaries: r_i <= x_i, 1-x_i, y_i, 1-y_i\n      for i in range(n):\n          a = np.zeros(n); a[i] = 1.0; rows.append(a); rhs.append(max(0.0, float(x[i])))\n      for i in range(n):\n          a = np.zeros(n); a[i] = 1.0; rows.append(a); rhs.append(max(0.0, float(1.0 - x[i])))\n      for i in range(n):\n          a = np.zeros(n); a[i] = 1.0; rows.append(a); rhs.append(max(0.0, float(y[i])))\n      for i in range(n):\n          a = np.zeros(n); a[i] = 1.0; rows.append(a); rhs.append(max(0.0, float(1.0 - y[i])))\n      # Pairs: r_i + r_j <= d_ij\n      for (i, j) in PAIRS:\n          a = np.zeros(n); a[i] = 1.0; a[j] = 1.0\n          dij = float(np.linalg.norm(C[i] - C[j]))\n          rows.append(a); rhs.append(max(0.0,\
    \ dij))\n      A_ub = np.vstack(rows); b_ub = np.array(rhs)\n      c = -np.ones(n); bounds = [(R_MIN, None) for _ in range(n)]\n      res = linprog(c, A_ub=A_ub, b_ub=b_ub, bounds=bounds, method=\"highs\")\n      if not res.success:\n          r = np.maximum(R_MIN, 0.99 * np.minimum.reduce([x, 1.0 - x, y, 1.0 - y]))\n          return r, False\n      return np.maximum(R_MIN, np.array(res.x, dtype=float)), True\n\n  def _finalize_zero_tol(C, r):\n      if core is not None and hasattr(core, \"finalize_minimal\"):\n          return core.finalize_minimal(C, r, neg_tol=0.0)\n      # Inline zero-tolerance finalize\n      r = r.copy()\n      x, y = C[:, 0], C[:, 1]\n      for i in range(N):\n          if x[i] - r[i] < 0.0: r[i] = max(R_MIN, min(r[i], x[i]))\n          if 1.0 - x[i] - r[i] < 0.0: r[i] = max(R_MIN, min(r[i], 1.0 - x[i]))\n          if y[i] - r[i] < 0.0: r[i] = max(R_MIN, min(r[i], y[i]))\n          if 1.0 - y[i] - r[i] < 0.0: r[i] = max(R_MIN, min(r[i], 1.0 - y[i]))\n      for\
    \ (i, j) in PAIRS:\n          dij = float(np.linalg.norm(C[i] - C[j])); s = r[i] + r[j]\n          if s > dij:\n              need = s - dij\n              di = min(0.5 * need, max(0.0, r[i] - R_MIN))\n              dj = min(0.5 * need, max(0.0, r[j] - R_MIN))\n              rem = need - (di + dj)\n              if rem > 0:\n                  extra = min(rem, max(0.0, r[i] - R_MIN - di)); di += extra; rem -= extra\n              if rem > 0:\n                  extra = min(rem, max(0.0, r[j] - R_MIN - dj)); dj += extra; rem -= extra\n              r[i] = max(R_MIN, r[i] - di)\n              r[j] = max(R_MIN, r[j] - dj)\n      return r\n\n  # ---------------- HRG LP builder ----------------\n  # Variables order: [dxp(0..N-1), dxm(0..N-1), dyp(0..N-1), dym(0..N-1)], each in [0, tau]\n  def _assemble_hrg_lp(C, r, delta_r, tau, sigma=1e-12):\n      n = C.shape[0]\n      cols = 4 * n\n      rows = []\n      rhs = []\n\n      def idx_dxp(i): return i\n      def idx_dxm(i): return n + i\n   \
    \   def idx_dyp(i): return 2 * n + i\n      def idx_dym(i): return 3 * n + i\n\n      # Pairwise constraints: -u·(δC_i - δC_j) <= -g_ij\n      for (i, j) in PAIRS:\n          dvec = C[i] - C[j]\n          dij = float(np.linalg.norm(dvec))\n          u = _safe_unit(dvec)\n          g = (r[i] + r[j] + delta_r[i] + delta_r[j]) - dij - sigma\n          row = np.zeros(cols)\n          # x part\n          row[idx_dxp(i)] += -u[0]; row[idx_dxm(i)] += +u[0]\n          row[idx_dxp(j)] += +u[0]; row[idx_dxm(j)] += -u[0]\n          # y part\n          row[idx_dyp(i)] += -u[1]; row[idx_dym(i)] += +u[1]\n          row[idx_dyp(j)] += +u[1]; row[idx_dym(j)] += -u[1]\n          rows.append(row); rhs.append(-g)\n\n      x, y = C[:, 0], C[:, 1]\n\n      # Boundary ties (zero-slack): left/right and bottom/top\n      for i in range(n):\n          # left: -(δx_i) <= x_i - r_i - delta_r_i\n          row = np.zeros(cols); row[idx_dxp(i)] += -1.0; row[idx_dxm(i)] += +1.0\n          rows.append(row); rhs.append(float(x[i]\
    \ - r[i] - delta_r[i]))\n          # right: +(δx_i) <= 1 - x_i - r_i - delta_r_i\n          row = np.zeros(cols); row[idx_dxp(i)] += +1.0; row[idx_dxm(i)] += -1.0\n          rows.append(row); rhs.append(float(1.0 - x[i] - r[i] - delta_r[i]))\n          # bottom: -(δy_i) <= y_i - r_i - delta_r_i\n          row = np.zeros(cols); row[idx_dyp(i)] += -1.0; row[idx_dym(i)] += +1.0\n          rows.append(row); rhs.append(float(y[i] - r[i] - delta_r[i]))\n          # top: +(δy_i) <= 1 - y_i - r_i - delta_r_i\n          row = np.zeros(cols); row[idx_dyp(i)] += +1.0; row[idx_dym(i)] += -1.0\n          rows.append(row); rhs.append(float(1.0 - y[i] - r[i] - delta_r[i]))\n\n      # In-box guards for centers (optional but safe)\n      for i in range(n):\n          # x lower: -(δx_i) <= x_i\n          row = np.zeros(cols); row[idx_dxp(i)] += -1.0; row[idx_dxm(i)] += +1.0\n          rows.append(row); rhs.append(float(x[i]))\n          # x upper: +(δx_i) <= 1 - x_i\n          row = np.zeros(cols); row[idx_dxp(i)]\
    \ += +1.0; row[idx_dxm(i)] += -1.0\n          rows.append(row); rhs.append(float(1.0 - x[i]))\n          # y lower: -(δy_i) <= y_i\n          row = np.zeros(cols); row[idx_dyp(i)] += -1.0; row[idx_dym(i)] += +1.0\n          rows.append(row); rhs.append(float(y[i]))\n          # y upper: +(δy_i) <= 1 - y_i\n          row = np.zeros(cols); row[idx_dyp(i)] += +1.0; row[idx_dym(i)] += -1.0\n          rows.append(row); rhs.append(float(1.0 - y[i]))\n\n      A_ub = np.vstack(rows); b_ub = np.array(rhs)\n\n      # Objective: minimize sum of splits with tiny index-based offsets (deterministic ties)\n      c = np.zeros(cols)\n      for i in range(n):\n          c[idx_dxp(i)] = 1.0 + 1e-9 * (i + 1)\n          c[idx_dxm(i)] = 1.0 + 2e-9 * (i + 1)\n          c[idx_dyp(i)] = 1.0 + 3e-9 * (i + 1)\n          c[idx_dym(i)] = 1.0 + 4e-9 * (i + 1)\n\n      # Bounds: 0 <= split vars <= tau\n      bounds = [(0.0, float(tau)) for _ in range(cols)]\n      return A_ub, b_ub, bounds, c\n\n  def _decode_dC(sol,\
    \ n):\n      dxp = sol[0:n]; dxm = sol[n:2*n]; dyp = sol[2*n:3*n]; dym = sol[3*n:4*n]\n      dx = dxp - dxm; dy = dyp - dym\n      return np.stack([dx, dy], axis=1)\n\n  # ---------------- HRG attempt ----------------\n  def _build_weights(C, r, mode=\"uniform\"):\n      n = C.shape[0]\n      if mode == \"uniform\":\n          w = np.ones(n, dtype=float)\n      elif mode == \"boundary\":\n          x, y = C[:, 0], C[:, 1]\n          bnd = np.minimum.reduce([x - r, 1.0 - x - r, y - r, 1.0 - y - r])\n          w = np.maximum(0.0, bnd) + 1e-9  # tie-break\n      else:\n          # contact-aware: average positive pair slack around each circle\n          ps = np.zeros(n, dtype=float)\n          for (i, j) in PAIRS:\n              d = float(np.linalg.norm(C[i] - C[j])) - (r[i] + r[j])\n              if d > 0:\n                  ps[i] += d; ps[j] += d\n          w = ps + 1e-9\n      s = float(np.sum(w))\n      if s <= 0:\n          w = np.ones(n, dtype=float); s = float(n)\n      return w /\
    \ s\n\n  def _try_hrg_step(C, r, alpha, w, tau_list, sigma=1e-12, eps_accept=1e-6):\n      n = C.shape[0]\n      for tau in tau_list:\n          delta_r = alpha * w\n          A_ub, b_ub, bounds, c = _assemble_hrg_lp(C, r, delta_r, tau, sigma=sigma)\n          res = None\n          if linprog is not None:\n              res = linprog(c, A_ub=A_ub, b_ub=b_ub, bounds=bounds, method=\"highs\")\n          feas = (res is not None and res.success)\n          print(f\"[hrg] try a={alpha:.6f} tau={tau:.3f} feas={feas}\")\n          if not feas:\n              continue\n          dC = _decode_dC(res.x, n)\n          C_try = np.clip(C + dC, 0.0, 1.0)\n          r_try, ok = _solve_radii_zero_slack(C_try)\n          if not ok:\n              continue\n          r_try = _finalize_zero_tol(C_try, r_try)\n          gain = float(np.sum(r_try) - np.sum(r))\n          print(f\"[hrg] accept? gain={gain:.9f}\")\n          if gain > eps_accept:\n              return True, C_try, r_try, tau, gain\n      return\
    \ False, C, r, None, 0.0\n\n  # ---------------- Driver ----------------\n  def _seed_storage_best():\n      try:\n          C = np.load(\"storage/verity/best_centers.npy\")\n          if isinstance(C, np.ndarray) and C.shape == (N, 2):\n              return np.clip(C.astype(float), 0.0, 1.0)\n      except Exception:\n          pass\n      return None\n\n  def _seed_storage_best_jitter(amplitude=0.001, seed=9731):\n      C = _seed_storage_best()\n      if C is None:\n          return None\n      rng = np.random.default_rng(seed)\n      jitter = rng.uniform(-amplitude, amplitude, size=C.shape)\n      return np.clip(C + jitter, 0.0, 1.0)\n\n  def _fallback_grid():\n      xs = np.linspace(0.1, 0.9, 6)\n      ys = np.linspace(0.1, 0.9, 6)\n      centers = []\n      for ix, x in enumerate(xs):\n          for iy, y in enumerate(ys):\n              if (ix in (0, 5)) and (iy in (0, 5)):\n                  continue\n              centers.append([x, y])\n      return np.array(centers, dtype=float)\n\
    \n  def _hrg_driver(C0, alpha0=0.001):\n      # Initialize radii at seed\n      r0, _ = _solve_radii_zero_slack(C0)\n      r0 = _finalize_zero_tol(C0, r0)\n      best_C, best_r = C0.copy(), r0.copy()\n      best_s = float(np.sum(best_r))\n\n      alpha_list = [alpha0, 0.7*alpha0, 0.5*alpha0, 0.35*alpha0, 0.2*alpha0, 0.12*alpha0, 0.08*alpha0]\n      tau_list = [0.06, 0.04, 0.025, 0.015, 0.01, 0.006, 0.004, 0.002]\n      weight_modes = [\"uniform\", \"boundary\"]  # deterministic order\n      attempts = 0; accepts = 0\n      recent_gains = []\n\n      for wmode in weight_modes:\n          w = _build_weights(best_C, best_r, mode=wmode)\n          for alpha in alpha_list:\n              ok, C1, R1, tau_acc, gain = _try_hrg_step(best_C, best_r, alpha, w, tau_list, sigma=1e-12, eps_accept=1e-6)\n              attempts += 1\n              if ok:\n                  best_C, best_r = C1, R1\n                  best_s = float(np.sum(best_r))\n                  accepts += 1\n                  recent_gains.append(gain)\n\
    \                  print(f\"[hrg] accepted a={alpha:.6f} tau={tau_acc:.3f} new_sum={best_s:.9f}\")\n                  # modestly increase alpha to probe local headroom\n                  alpha_probe = min(1.1 * alpha, alpha_list[0])\n                  ok2, C2, R2, tau2, gain2 = _try_hrg_step(best_C, best_r, alpha_probe, w, tau_list, sigma=1e-12, eps_accept=1e-6)\n                  attempts += 1\n                  if ok2:\n                      best_C, best_r = C2, R2\n                      best_s = float(np.sum(best_r))\n                      accepts += 1\n                      recent_gains.append(gain2)\n                      print(f\"[hrg] accepted probe a={alpha_probe:.6f} tau={tau2:.3f} new_sum={best_s:.9f}\")\n                  # Early stopping: if many tiny gains in a row, break\n                  if len(recent_gains) >= 5 and all(g < 5e-7 for g in recent_gains[-5:]):\n                      return best_C, best_r, best_s\n                  # Limit total accepted steps\n        \
    \          if accepts >= 12:\n                      return best_C, best_r, best_s\n              # Limit attempts\n              if attempts >= 80:\n                  return best_C, best_r, best_s\n          # Recompute w on updated best_C,best_r before next wmode iteration\n          w = _build_weights(best_C, best_r, mode=wmode)\n\n      return best_C, best_r, best_s\n\n  # ---------------- Main entry ----------------\n  def construct_packing() -> tuple:\n      seeds = []\n      Cb = _seed_storage_best()\n      if Cb is not None:\n          seeds.append((\"storage-best\", Cb))\n          Cj = _seed_storage_best_jitter(amplitude=0.001, seed=9731)\n          if Cj is not None:\n              seeds.append((\"storage-best-jitter-0.001\", Cj))\n      else:\n          seeds.append((\"grid-36minus4\", _fallback_grid()))\n\n      best_sum = -1.0; best_C_out = None; best_r_out = None\n\n      for name, C0 in seeds:\n          print(f\"[hrg] seed {name}\")\n          C0 = np.clip(C0, 0.0, 1.0)\n\
    \          C_opt, r_opt, s_opt = _hrg_driver(C0, alpha0=0.001)\n          print(f\"[hrg] {name} -> sum {s_opt:.9f}\")\n          if s_opt > best_sum:\n              best_sum = s_opt; best_C_out = C_opt; best_r_out = r_opt\n\n      # Persist and return\n      try:\n          os.makedirs(\"storage/verity\", exist_ok=True)\n          np.save(\"storage/verity/best_centers.npy\", best_C_out)\n          np.save(\"storage/verity/best_radii.npy\", best_r_out)\n      except Exception:\n          pass\n\n      return np.array(best_C_out, dtype=float), np.array(best_r_out, dtype=float)\n```"
