    \ y) coordinates in [0, 1] x [0, 1].\n\n    Returns:\n      radii: (n,) array of non-negative radii.\n    \"\"\"\n    n = centers.shape[0]\n    epsilon_border = 1e-9 # Epsilon for border check\n    epsilon_safety_margin = 1e-6 # Epsilon for overlap safety margin\n    radii = np.ones(n)\n\n    # Limit by distance to square borders\n    for i in range(n):\n      x, y = centers[i]\n      radii[i] = min(x - epsilon_border, y - epsilon_border, 1 - x - epsilon_border, 1 - y - epsilon_border)\n\n    # Iteratively shrink radii to resolve overlaps\n    for _ in range(100): \n      for i in range(n):\n        for j in range(i + 1, n):\n          dist = np.sqrt(np.sum((centers[i] - centers[j]) ** 2))\n          rad_sum = radii[i] + radii[j]\n          \n          # If circles overlap\n          if dist < rad_sum:\n            # Calculate a scale factor to shrink them just enough to not overlap\n            # And then apply an additional safety margin\n            if rad_sum > 0: # Avoid division\
    \ by zero\n                scale_factor = (dist / rad_sum) * (1.0 - epsilon_safety_margin)\n                radii[i] *= scale_factor\n                radii[j] *= scale_factor\n\n    return np.maximum(radii, 0.0)\n\n\n  def construct_packing() -> tuple[np.ndarray, np.ndarray]:\n    \"\"\"\n    Construct a packing of 32 circles in the unit square using a local parameter search\n    for concentric ring parameters.\n    \n    Returns:\n        tuple: A tuple of (centers, radii) where:\n            - centers: np.ndarray of shape (32, 2) with (x, y) coordinates\n            - radii: np.ndarray of shape (32,) with radius of each circle\n    \"\"\"\n    n_circles = 32\n    \n    # Define parameter combinations to try\n    param_combinations = [\n        (0.23, 0.43), # Current best\n        (0.22, 0.42),\n        (0.24, 0.44),\n        (0.23, 0.42),\n        (0.22, 0.43),\n        (0.24, 0.43),\n        (0.23, 0.41)\n    ]\n    \n    best_score = 0.0\n    best_centers = np.zeros((n_circles,\
