- text: "I am at the Research Counter, and I acknowledge the research inactivity notice. To continue my investigation into optimizing computational budget, I will submit a new experiment with an even lower total computational budget. This experiment will test `PROSPECT_ITER = 4` and `REFINE_ITER = 25`.\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Budget Optimization: MM-LP Adaptive Search (P4, R25)\"\ntags: \"sota, mm-lp, budget optimization, parameter tuning, efficiency\"\nabstract: \"This experiment pushes the limits of computational budget optimization for the MM-LP Adaptive Search. It tests a configuration with `PROSPECT_ITER = 4` and `REFINE_ITER = 25`, resulting in a significantly reduced budget of 4896 `mm_lp_optimize` iterations. `N_PROSPECT` is 1024, `N_ELITE` is 32, and `DELTA0_VAL` is 0.015. The objective is to determine if SOTA performance can be maintained with this even lower prospecting depth, seeking to identify the absolute minimum computational cost.\"\ncontent: |\n\
    \  import numpy as np\n  from scipy.optimize import linprog\n  from multiprocessing import Pool, cpu_count\n  import sys\n\n  # --- START: Copied from storage/praxis/lp_utils.py and Praxis IV's ID 570 ---\n\n  def solve_radii_lp(centers, return_duals=False):\n      N_CIRCLES = centers.shape[0]\n      c = -np.ones(N_CIRCLES)\n      A_ub, b_ub = [], []\n      num_boundary_cons = 4 * N_CIRCLES\n      for i in range(N_CIRCLES):\n          cx, cy = centers[i]\n          row = np.zeros(N_CIRCLES); row[i] = 1; A_ub.append(row); b_ub.append(cx)\n          row = np.zeros(N_CIRCLES); row[i] = 1; A_ub.append(row); b_ub.append(1 - cx)\n          row = np.zeros(N_CIRCLES); row[i] = 1; A_ub.append(row); b_ub.append(cy)\n          row = np.zeros(N_CIRCLES); row[i] = 1; A_ub.append(row); b_ub.append(1 - cy)\n      \n      indices = np.triu_indices(N_CIRCLES, k=1)\n      for i, j in zip(*indices):\n          dist = np.linalg.norm(centers[i] - centers[j])\n          row = np.zeros(N_CIRCLES); row[i] =\
    \ 1; row[j] = 1\n          A_ub.append(row); b_ub.append(dist)\n      \n      res = linprog(c, A_ub=np.array(A_ub), b_ub=np.array(b_ub), bounds=(0, None), method='highs')\n      \n      if not res.success: \n          return (np.zeros(N_CIRCLES), None) if return_duals else np.zeros(N_CIRCLES)\n      \n      if return_duals:\n          duals = res.ineqlin.marginals if hasattr(res, 'ineqlin') else None\n          return res.x, (duals[:num_boundary_cons], duals[num_boundary_cons:]) if duals is not None else (None, None)\n      else:\n          return res.x\n\n  def get_seed(seed_val):\n      rng = np.random.default_rng(seed_val)\n      seed_type = seed_val % 3\n      if seed_type == 0:\n          grid = np.stack(np.meshgrid(np.linspace(0.1,0.9,6),np.linspace(0.1,0.9,6)),-1).reshape(-1,2)[:32]\n          return np.clip(grid + (rng.random((32,2))-0.5)*0.08, 0.05, 0.95)\n      elif seed_type == 1:\n          points = [rng.uniform(0.1, 0.9, 2)]; [points.append(candidates[np.argmax(np.min(np.sum((candidates[:,np.newaxis,:]\
    \ - np.array(points)[np.newaxis,:,:])**2, axis=-1), axis=1))]) for _ in range(31) for candidates in [rng.uniform(0.1,0.9,(200,2))]]; return np.array(points)\n      else:\n          rows=[5,6,5,6,5,5]; points=[]; y=0.95\n          for i,c in enumerate(rows): x_s=(1.0-(c-1)*0.15)/2; [points.append([x_s+j*0.15,y]) for j in range(c)]; y-=0.15\n          return np.array(points)[:32]\n\n  def mm_lp_optimize(C_start: np.ndarray, iters: int, delta0: float = 0.015):\n      best_C = C_start.copy()\n      score_best = np.sum(solve_radii_lp(best_C))\n      delta, C_anchor = delta0, C_start.copy()\n      for _ in range(iters):\n          n = C_anchor.shape[0]\n          I, J = np.array([[i,j] for i in range(n) for j in range(i + 1, n)]).T\n          V0, d0 = C_anchor[I]-C_anchor[J], np.linalg.norm(C_anchor[I]-C_anchor[J], axis=1)\n          d0 = np.maximum(d0, 1e-9); U = (V0.T / d0).T; ux, uy = U[:,0], U[:,1]; x0, y0 = C_anchor[:,0], C_anchor[:,1]\n          rows, cols = 4*n+len(I), 3*n\n       \
    \   A_ub, b_ub = np.zeros((rows,cols)), np.zeros(rows)\n          r_idx, x_idx, y_idx = range(n), range(n,2*n), range(2*n,3*n)\n          row=0\n          for i in range(n):\n              A_ub[row,r_idx[i]]=1; A_ub[row,x_idx[i]]=-1; row+=1\n              A_ub[row,r_idx[i]]=1; A_ub[row,x_idx[i]]=1; b_ub[row]=1.0; row+=1\n              A_ub[row,r_idx[i]]=1; A_ub[row,y_idx[i]]=-1; row+=1\n              A_ub[row,r_idx[i]]=1; A_ub[row,y_idx[i]]=1; b_ub[row]=1.0; row+=1\n          for k in range(len(I)):\n              i,j=I[k],J[k]; A_ub[row,r_idx[i]]=1; A_ub[row,r_idx[j]]=1\n              A_ub[row,x_idx[i]]=-ux[k]; A_ub[row,y_idx[i]]=-uy[k]; A_ub[row,x_idx[j]]=ux[k]; A_ub[row,y_idx[j]]=uy[k]\n              b_ub[row]=d0[k]-ux[k]*x0[i]-uy[k]*y0[i]+ux[k]*x0[j]+uy[k]*y0[j]; row+=1\n          c=np.zeros(cols); c[:n]=-1.0\n          bounds=[(0,0.5)]*n + [(max(1e-6,x0[i]-delta),min(1-1e-6,x0[i]+delta)) for i in range(n)] + [(max(1e-6,y0[i]-delta),min(1-1e-6,y0[i]+delta)) for i in range(n)]\n \
    \         res = linprog(c,A_ub=A_ub,b_ub=b_ub,bounds=bounds,method=\"highs\")\n          if not res.success: delta*=0.6; continue\n          C_lin = np.stack([res.x[n:2*n], res.x[2*n:3*n]], axis=1)\n          score_exact = np.sum(solve_radii_lp(C_lin))\n          if score_exact > score_best:\n              best_C, score_best = C_lin.copy(), score_exact\n              C_anchor = C_lin.copy(); delta=min(0.05, 1.2*delta)\n          else: delta*=0.8\n      final_radii = solve_radii_lp(best_C)\n      return best_C, final_radii, score_best\n\n  # --- END: Copied functions ---\n\n\n  def worker_function(args):\n      seed_val, iters, delta = args\n      initial_centers = get_seed(seed_val)\n      _, _, score = mm_lp_optimize(initial_centers, iters, delta)\n      return score, initial_centers\n\n  def refine_worker(args):\n      centers, iters, delta = args\n      return mm_lp_optimize(centers, iters, delta)\n\n  def construct_packing() -> tuple:\n      N_PROSPECT = 1024 \n      N_ELITE = 32\n\
    \      \n      PROSPECT_ITER = 4 # Adjusted\n      REFINE_ITER = 25 # Maintained\n      DELTA0_VAL = 0.015 \n\n      with Pool(processes=cpu_count()) as pool:\n          prospect_results = pool.map(worker_function, [(i, PROSPECT_ITER, DELTA0_VAL) for i in range(N_PROSPECT)])\n      prospect_results.sort(key=lambda x: x[0], reverse=True)\n          # Only pass N_ELITE centers if prospecting results are available\n      elite_centers = [res[1] for res in prospect_results[:N_ELITE]] if prospect_results else []\n\n      with Pool(processes=cpu_count()) as pool:\n          refine_results = pool.map(refine_worker, [(centers, REFINE_ITER, DELTA0_VAL) for centers in elite_centers])\n      \n      best_centers, best_radii, best_score = None, None, -1.0\n      for centers, radii, score in refine_results:\n          if score > best_score:\n              best_centers, best_radii, best_score = centers, radii, score\n              \n      if best_centers is None: \n          initial_fallback_centers\
    \ = get_seed(0)\n          fallback_radii = solve_radii_lp(initial_fallback_centers)\n          return initial_fallback_centers, fallback_radii * (1.0 - 1e-9)\n          \n      return best_centers, best_radii * (1.0 - 1e-9)\n```"
