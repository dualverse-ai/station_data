tick: 128
role: model
parts:
- text: "Excellent. Step 1 of my SOTA replication plan is complete. My submission (ID 258) ran successfully, and as expected, returned a trivial score of 0.032. The crucial outcome is that the warm-start artifact has been created and saved to `storage/cognito/sota_replication_start.npz`.\n\nNow I proceed to Step 2: the refinement stage. I will submit a modified version of Cognito I's refiner script (ID 229). The key change will be to update the `LOAD_PATH` to point to my newly created artifact. All other parts of the sophisticated ASN algorithm will remain untouched.\n\nThis experiment will serve as the true test of my replication. If successful, the score should be very close to the SOTA score of ~2.9187.\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"SOTA Replication Step 2: ASN Refinement\"\ntags: \"sota replication, active-set newton, refinement\"\nabstract: \"This is the second and final step in replicating the SOTA pipeline. This script is a direct copy of Cognito I's refiner (ID\
    \ 229). It loads the warm-start artifact generated by my own generator (ID 258) from 'storage/cognito/sota_replication_start.npz' and applies the proven ASN refinement algorithm. This experiment will validate my ability to reproduce the SOTA methodology.\"\ncontent: |\n  import numpy as np\n  import os, time\n  from scipy.optimize import linprog\n\n  # --- CRITICAL: Load from the artifact generated in Step 1 ---\n  LOAD_PATH = 'storage/cognito/sota_replication_start.npz'\n  SAVE_PATH = 'storage/cognito/sota_replication_final.npz'\n\n  # All utility and ASN functions are the same as the original SOTA submission (ID 229)\n  def _clip01(C: np.ndarray, eps: float = 1e-6) -> np.ndarray: return np.clip(C, eps, 1.0 - eps)\n  def _boundary_margins(C: np.ndarray) -> np.ndarray: return np.minimum.reduce([C[:,0], 1-C[:,0], C[:,1], 1-C[:,1]])\n  def _validate(C: np.ndarray, r: np.ndarray) -> bool:\n      n=32\n      if C.shape!=(n,2) or r.shape!=(n,): return False\n      if np.any(~np.isfinite(C))\
    \ or np.any(~np.isfinite(r)) or np.any(r<=0): return False\n      if np.any(C[:,0]-r<0) or np.any(C[:,0]+r>1) or np.any(C[:,1]-r<0) or np.any(C[:,1]+r>1): return False\n      D=np.linalg.norm(C[:,None,:]-C[None,:,:], axis=-1); R=r[:,None]+r[None,:]; iu=np.triu_indices(n,1)\n      if np.any(D[iu] < R[iu] - 1e-12): return False\n      return True\n  def _safety_shrink(C: np.ndarray, r: np.ndarray, factor: float = 0.9999) -> np.ndarray:\n      r2=np.minimum(r, _boundary_margins(C))*factor\n      for _ in range(6):\n          if _validate(C,r2): break\n          r2*=0.95\n      return np.maximum(np.minimum(r2, _boundary_margins(C)), 1e-12)\n  def _pair_indices(n: int): return np.triu_indices(n, 1)\n  def exact_lp(C: np.ndarray):\n      n=C.shape[0]; b=_boundary_margins(C)\n      I,J=_pair_indices(n); D=np.linalg.norm(C[I]-C[J],axis=1); m=len(I)\n      A_ub=np.zeros((m,n)); A_ub[np.arange(m),I]=1; A_ub[np.arange(m),J]=1; b_ub=D\n      c=-np.ones(n); bounds=[(0,float(max(0,bi))) for bi in\
    \ b]\n      res=linprog(c,A_ub=A_ub,b_ub=b_ub,bounds=bounds,method='highs')\n      if not res.success: return np.zeros(n),0,False,None,(I,J)\n      r,obj=res.x,-res.fun; y_pairs=None\n      if hasattr(res,\"ineqlin\") and hasattr(res.ineqlin,\"marginals\"): y_pairs=np.maximum(0,res.ineqlin.marginals)\n      return r,obj,True,y_pairs,(I,J)\n  def _baseline_grid_6x6_minus_corners():\n      s=1/6; r0=0.5*s; xs,ys=r0+s*np.arange(6),r0+s*np.arange(6)\n      return np.array([[xs[j],ys[i]] for i in range(6) for j in range(6) if not ((i in [0,5]) and (j in [0,5]))])\n  class ASNParams:\n      def __init__(self):\n          self.t_pair=1e-3; self.t_keep=6e-4; self.t_drop=3e-4; self.t_min=3e-4; self.t_bound=1e-4\n          self.K_pairs=240; self.K_min=60; self.mu=1e-3; self.mu_floor=5e-4; self.mu_cap=1e-1\n          self.gamma_par=0.05; self.y_cap=1e2; self.alpha_list=[1,0.6,0.35,0.2]; self.eps_imp=1e-8\n          self.eps_box=1e-6; self.dmax=0.05; self.ema_beta=0.5; self.max_reject=3; self.steps=15;\
    \ self.time_budget=800\n  def _boundary_proxies(C,r,t):\n      n=C.shape[0]; x,y=C[:,0],C[:,1]; s_l,s_r,s_d,s_u=x-r,1-x-r,y-r,1-y-r; k=1e3\n      w_l,w_r,w_d,w_u=np.maximum(0,k*(1e-3-s_l)),np.maximum(0,k*(1e-3-s_r)),np.maximum(0,k*(1e-3-s_d)),np.maximum(0,k*(1e-3-s_u))\n      idx,w=-np.ones(n,int),np.zeros(n);\n      for i in range(n):\n          vals=np.array([w_l[i],w_r[i],w_d[i],w_u[i]]); j=np.argmax(vals)\n          if vals[j]>=t: idx[i]=j; w[i]=vals[j]\n      return idx,w\n  def _build_active_set(y,I,J,A,C,r,p):\n      c=(A&(y>=p.t_drop))|(~A&(y>=p.t_pair)); i=np.nonzero(c)[0]; t=p.t_pair\n      while i.size<p.K_min and t>p.t_min:\n          t*=0.7; c=(A&(y>=p.t_drop))|(~A&(y>=t)); i=np.nonzero(c)[0]\n      p.t_pair=max(t,p.t_min)\n      if i.size>p.K_pairs: i=i[np.argsort(-y[i])[:p.K_pairs]]\n      fi,wf=_boundary_proxies(C,r,p.t_bound)\n      return I[i],J[i],i,fi,wf\n  def _assemble_grad_hess(C,I,J,idx,y,fi,wf,p):\n      n=C.shape[0]; g=np.zeros_like(C); H=np.zeros((n,2,2));\
    \ I2=np.eye(2)\n      if idx.size>0:\n          V=C[I]-C[J]; d=np.maximum(np.linalg.norm(V,axis=1),1e-9); U=(V.T/d).T\n          yu=np.minimum(y[idx],p.y_cap); np.add.at(g,I,(yu[:,None]*U)); np.add.at(g,J,-(yu[:,None]*U))\n          uuT=U[:,:,None]*U[:,None,:]; M_o=((yu/d)[:,None,None])*(I2-uuT)\n          np.add.at(H,I,M_o); np.add.at(H,J,M_o)\n          M_p=p.gamma_par*((yu/d)[:,None,None])*uuT; np.add.at(H,I,M_p); np.add.at(H,J,M_p)\n      N=np.array([[1,0],[-1,0],[0,1],[0,-1]]);\n      for i in range(n):\n          if fi[i]>=0: g[i]+=wf[i]*N[fi[i]]; H[i]+=1e-4*I2\n      for i in range(n):\n          H[i]+=p.mu*I2\n          if np.linalg.det(H[i])<=1e-12: H[i]+=1e-3*I2\n      return g,H\n  def _solve_blocks(H,g,p):\n      n=g.shape[0]; dC=np.zeros_like(g)\n      for i in range(n):\n          try: dci=np.linalg.solve(H[i],g[i])\n          except: dci=g[i]\n          nrm=np.linalg.norm(dci);\n          if nrm>p.dmax: dci*=(p.dmax/nrm)\n          dC[i]=dci\n      return dC\n  def _adapt(p,rho,acc):\n\
    \      if acc:\n          if rho>0.8: p.mu=max(p.mu_floor,0.8*p.mu); a0=p.alpha_list[0]; p.alpha_list=[min(1.2*a0,1.3)]+p.alpha_list\n          elif rho<0.25: p.mu=min(p.mu_cap,1.2*p.mu)\n      else: p.mu=min(p.mu_cap,1.5*p.mu); p.t_pair=max(p.t_min,0.9*p.t_pair)\n  def _slack_duals_proxy(C,r,I,J):\n      d=np.linalg.norm(C[I]-C[J],axis=1); s=d-(r[I]+r[J]); y=1/(1e-6+np.maximum(s,0))\n      med=np.median(y);\n      if med>0: y*=(1e-3/med)\n      return y\n  def asn_refine(C,r,f,y,I,J,p):\n      n=C.shape[0]; t0=time.time()\n      if y is None: y=_slack_duals_proxy(C,r,I,J)\n      ys=np.clip(y,0,None); A=np.zeros_like(ys,bool); rej=0\n      for t in range(p.steps):\n          if time.time()-t0>p.time_budget: break\n          Ia,Ja,idx,fi,wf=_build_active_set(ys,I,J,A,C,r,p)\n          if idx.size==0: break\n          g,H=_assemble_grad_hess(C,Ia,Ja,idx,ys,fi,wf,p); dC=_solve_blocks(H,g,p)\n          acc=False; f_old=f\n          for alpha in p.alpha_list:\n              Ct=_clip01(C+alpha*dC,p.eps_box);\
    \ rt,ft,ok,yn,_=exact_lp(Ct)\n              if not ok: continue\n              if ft>f+p.eps_imp:\n                  C,r,f=Ct,rt,ft\n                  if yn is not None: ys=p.ema_beta*ys+(1-p.beta_ema)*np.clip(yn,0,None)\n                  pg=max(np.sum(g*dC),1e-10); rho=(f-f_old)/pg; _adapt(p,rho,True)\n                  acc=True; rej=0; break\n          if not acc:\n              _adapt(p,0,False); rej+=1;\n              if rej>=p.max_reject: break\n      return C,r,f\n  def _seed_verity_row():\n      c=[5,4,5,4,5,4,5]; ys=np.linspace(0.11,0.89,len(c))\n      def row(k,m): return np.linspace(m,1-m,k) if k>1 else np.array([0.5])\n      x5,x4=row(5,0.08),np.clip(row(4,0.08)+0.02,1e-6,1-1e-6); C=[]\n      for i,k in enumerate(c):\n          xs=x5 if k==5 else x4\n          for x in xs: C.append([x,ys[i]])\n      return np.array(C,float)[:32]\n\n  def construct_packing() -> tuple:\n      n=32; seeds=[]\n      try:\n          data = np.load(LOAD_PATH)\n          C1, r1 = data['centers'],\
    \ data['radii']\n          seeds.append((np.sum(r1), C1, r1))\n      except (FileNotFoundError, KeyError): pass\n      C2 = _seed_verity_row(); r2, o2, ok2, *_ = exact_lp(C2)\n      if ok2: seeds.append((o2, C2, r2))\n      if not seeds:\n          C_base = _baseline_grid_6x6_minus_corners(); r_base, o_base, ok_base, *_ = exact_lp(C_base)\n          if not ok_base: return C_base, np.full(n, 1/14)\n          seeds.append((o_base, C_base, r_base))\n      \n      seeds.sort(key=lambda t: t[0], reverse=True)\n      best_obj, best_C, best_r = seeds[0]\n\n      I_all, J_all = _pair_indices(n)\n      for i, (obj, C, r) in enumerate(seeds):\n          _, _, ok, y, _ = exact_lp(C)\n          if ok:\n              params = ASNParams()\n              if i > 0: params.steps = max(5, params.steps - 5)\n              C_new, r_new, obj_new = asn_refine(C.copy(), r.copy(), obj, y, I_all, J_all, params)\n              if obj_new > best_obj: best_C, best_r, best_obj = C_new, r_new, obj_new\n      \n \
    \     final_r = _safety_shrink(best_C, best_r, factor=0.99999)\n      if not _validate(best_C, final_r): return _baseline_grid_6x6_minus_corners(), np.full(n, 1/14)\n      \n      try:\n          prev = -1\n          if os.path.exists(SAVE_PATH): prev = float(np.load(SAVE_PATH).get('obj', -1))\n          if np.sum(final_r) > prev:\n              np.savez(SAVE_PATH, centers=best_C, radii=final_r, obj=np.sum(final_r))\n      except Exception: pass\n          \n      return best_C, final_r\n```"
