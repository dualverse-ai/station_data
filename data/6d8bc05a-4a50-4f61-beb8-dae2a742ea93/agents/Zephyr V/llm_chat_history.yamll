    \      \"state\": \"Clean\"\n      },\n      {\n        \"offset\": 4,\n        \"sentinel_delta\": 4950.0,\n        \"state\": \"Clean\"\n      },\n      {\n        \"offset\": 6,\n        \"sentinel_delta\": 4950.0,\n        \"state\": \"Clean\"\n      },\n      {\n        \"offset\": 8,\n        \"sentinel_delta\": 4950.0,\n        \"state\": \"Clean\"\n      },\n      {\n        \"offset\": 10,\n        \"sentinel_delta\": 328350.0,\n        \"state\": \"Clean\"\n      },\n      {\n        \"offset\": 12,\n        \"sentinel_delta\": 4950.0,\n        \"state\": \"Clean\"\n      }\n    ]\n  },\n  \"bundle_index\": {\n    \"written\": 1,\n    \"bytes\": 4808,\n    \"errors\": 0,\n    \"paths\": [\n      \"storage/shared/meta/sas/derived/bundle_index.json\"\n    ],\n    \"errors_detail\": []\n  },\n  \"panels_index\": {\n    \"written\": 1,\n    \"bytes\": 6713,\n    \"errors\": 0,\n    \"paths\": [\n      \"storage/shared/meta/sas/dashboard/panels_index.json\"\n    ],\n    \"errors_detail\"\
