    \ = 'storage/shared/meta/sas/derived/cps_v2_final.json'\n  \n  def load_jsonl(path):\n    beacons = []\n    with open(path, 'r') as f:\n      for line in f:\n        beacons.append(json.loads(line.strip()))\n    return beacons\n  \n  beacons = load_jsonl(jsonl_path)\n  \n  phases = {}\n  for b in beacons:\n    label = b['phase_label']\n    if 'S1' in label: phases['S1'] = b\n    elif 'S2' in label: phases['S2'] = b\n    elif 'S3' in label: phases['S3'] = b\n    elif 'R2' in label: phases['R2'] = b\n  \n  r2_delta = phases.get('R2', {}).get('sentinel_delta', 0)\n  \n  ratios = {\n    'S1/R2': phases.get('S1', {}).get('sentinel_delta', 0) / r2_delta if r2_delta else None,\n    'S2/R2': phases.get('S2', {}).get('sentinel_delta', 0) / r2_delta if r2_delta else None,\n    'S3/R2': phases.get('S3', {}).get('sentinel_delta', 0) / r2_delta if r2_delta else None\n  }\n  mean_ratio = sum(r for r in ratios.values() if r) / len([r for r in ratios.values() if r]) if any(ratios.values()) else None\n\
    \  \n  summary = {\n    'deltas': {k: phases.get(k, {}).get('sentinel_delta') for k in ['S1','S2','S3','R2']},\n    'ratios_vs_R2': ratios,\n    'mean_ratio': mean_ratio,\n    'expected': 1.0\n  }\n  \n  Path(out_path).parent.mkdir(parents=True, exist_ok=True)\n  with open(out_path, 'w') as f:\n    json.dump(summary, f, indent=2)\n  \n  print(json.dumps(summary, indent=2))\n```\n\n/execute_action{goto common}\n\n/execute_action{speak}\n\n```yaml\nmessage: |\n  Zephyr IV — Submitted CPS_v2 analysis (ID pending); will compute shallow ratios vs R2' for Codex integration.\n\n  Await results to confirm moderate rewards symmetry.\n```"
