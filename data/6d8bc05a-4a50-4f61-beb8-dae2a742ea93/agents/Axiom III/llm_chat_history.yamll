    ,\n    \"series_ci_panel\": \"storage/shared/meta/sas/dashboard/xl_transfer_series_ci_zephyr_v.json\",\n    \"gate\": \"storage/shared/meta/sas/derived/xl_gate_zephyr_v.json\",\n    \"schedule_hint\": \"storage/shared/meta/sas/derived/xl_schedule_state.json\",\n    \"waves_panel\": \"storage/shared/meta/sas/dashboard/xl_waves_panel_zephyr_v.json\",\n    \"waves_derived\": \"storage/shared/meta/sas/derived/xl_waves_zephyr_v.json\",\n    \"policy\": \"storage/shared/meta/sas/derived/xl_policy_zephyr_v.json\"\n  },\n  \"css_v\": {\n    \"comparison_panel\": \"storage/shared/meta/sas/dashboard/css_comparison_logos_v.json\",\n    \"scatter_panel\": \"storage/shared/meta/sas/dashboard/css_scatter_panel_logos_v.json\",\n    \"recovery_panel\": \"storage/shared/meta/sas/dashboard/css_recovery_logos_v.json\"\n  },\n  \"surr_gpu\": {\n    \"panel\": \"storage/shared/meta/sas/dashboard/surr_gpu_zephyr_v.json\"\n  },\n  \"synthesis\": {\n    \"overview\": \"storage/shared/meta/sas/dashboard/synthesis_overview.json\"\
    \n  },\n  \"modules\": {\n    \"scheduler_v0_5\": \"storage/shared/meta/sas/scheduler_v0_5.py\",\n    \"scheduler_client_v0_5_adapter\": \"storage/shared/meta/sas/scheduler_client_v0_5_adapter.py\",\n    \"mode_detect\": \"storage/shared/meta/sas/mode_detect.py\",\n    \"readme_scheduler_integration\": \"storage/shared/meta/sas/README_scheduler_v0_5_integration.md\"\n  },\n  \"synthesis_overview\": \"storage/shared/meta/sas/dashboard/synthesis_overview.json\",\n  \"implementation_pack\": {\n    \"readme\": \"storage/shared/meta/sas/IMPLEMENTATION_PACK_v0_5.md\",\n    \"manifest\": \"storage/shared/meta/sas/pack_manifest_v0_5.json\"\n  },\n  \"examples\": {\n    \"hello_scheduler\": {\n      \"script\": \"storage/shared/meta/sas/tools/hello_scheduler.py\",\n      \"readme\": \"storage/shared/meta/sas/tools/README_hello_scheduler.md\",\n      \"output\": \"storage/shared/meta/sas/derived/hello_scheduler_demo.json\"\n    }\n  },\n  \"demo\": {\n    \"snapshot\": \"storage/shared/meta/sas/dashboard/demo_snapshot.json\"\
