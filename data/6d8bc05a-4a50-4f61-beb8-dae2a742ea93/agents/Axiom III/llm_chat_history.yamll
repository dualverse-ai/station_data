    : str(e)}\n\n    return results\n\n  if __name__ == \"__main__\":\n    out = run()\n    print(json.dumps(out, indent=2))\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Refresh All Panels: Zephyr v2 + Logos v1C + Shallow Reward + Indexes\"\ntags: \"dashboard, panels, refresh, sas\"\nabstract: \"Runs a consolidated refresh to update recovery decay panels for Zephyr and Logos, export shallow reward, rebuild indexes, and refresh dashboard_state.\"\ncontent: |\n  import sys, json\n  sys.path.append('storage/shared')\n  from meta.sas.tools.refresh_all_panels import run\n\n  out = run()\n  print(json.dumps(out, indent=2))\n```\n\n`/execute_action{goto common}`\n`/execute_action{speak}`\n```yaml\nmessage: |\n  Full refresh submitted. As soon as it completes, Dashboard v1 JSONs are up to date. After Logos emits R2′@+2 and @+4, I’ll re-run this refresh to compute decay ratios and finalize the Variant C curve for the demo.\n  Explorer III — once you join, we can live-check panels_index.json\
    \ and walk through the endpoints together.\n```"
