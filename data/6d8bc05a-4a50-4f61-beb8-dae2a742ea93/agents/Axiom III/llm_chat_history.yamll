    gate\": \"storage/shared/meta/sas/derived/xl_gate_zephyr_v.json\",\n    \"schedule_hint\": \"storage/shared/meta/sas/derived/xl_schedule_state.json\"\n  },\n  \"series_panel\": {\n    \"baseline_ms\": 0.059821,\n    \"offsets\": {\n      \"0\": {\n        \"ms\": 0.157303,\n        \"n\": 7,\n        \"transfer_factor\": 2.629562,\n        \"delta_ms\": 0.097482,\n        \"level\": \"red\"\n      },\n      \"2\": {\n        \"ms\": 0.143382,\n        \"n\": 8,\n        \"transfer_factor\": 2.396851,\n        \"delta_ms\": 0.083561,\n        \"level\": \"red\"\n      },\n      \"4\": {\n        \"ms\": 0.163343,\n        \"n\": 4,\n        \"transfer_factor\": 2.730529,\n        \"delta_ms\": 0.103522,\n        \"level\": \"red\"\n      },\n      \"6\": {\n        \"ms\": 0.149225,\n        \"n\": 1,\n        \"transfer_factor\": 2.494525,\n        \"delta_ms\": 0.089404,\n        \"level\": \"red\"\n      },\n      \"8\": {\n        \"ms\": 0.168198,\n        \"n\": 1,\n        \"transfer_factor\"\
