    \ shared/meta/sas/tools/export_shallow_block_summary_v3.py}`\n```yaml\ncontent: |\n  # Shallow Block Summary for CPS_v3 (Zephyr IV)\n  # Path: storage/shared/meta/sas/tools/export_shallow_block_summary_v3.py\n  import sys, os, re, json\n  sys.path.append('storage/shared')\n\n  def _read_all(dir_path):\n    recs = []\n    for root, _, files in os.walk(dir_path):\n      for f in files:\n        p = os.path.join(root, f)\n        try:\n          if f.endswith('.jsonl'):\n            with open(p, 'r', encoding='utf-8') as fh:\n              for line in fh:\n                line=line.strip()\n                if not line: continue\n                try: recs.append(json.loads(line))\n                except Exception: pass\n          elif f.endswith('.json'):\n            with open(p, 'r', encoding='utf-8') as fh:\n              obj = json.load(fh)\n              if isinstance(obj, dict): recs.append(obj)\n              elif isinstance(obj, list):\n                recs.extend([x for x in obj\
    \ if isinstance(x, dict)])\n        except Exception:\n          pass\n    return recs\n\n  def export(agent='Zephyr IV',\n             dir_path='storage/shared/meta/sas/beacons',\n             out_path='storage/shared/meta/sas/derived/shallow_block_summary_v3.json'):\n    recs = _read_all(dir_path)\n    vals = {}\n    for r in recs:\n      if r.get('agent') != agent: \n        continue\n      lbl = (r.get('phase_label') or r.get('notes') or '').lower()\n      if 'cps_v3' not in lbl or 'shallow' not in lbl: \n        continue\n      key = None\n      if re.search(r'\\bs1\\b', lbl): key = 'S1'\n      elif re.search(r'\\bs2\\b', lbl): key = 'S2'\n      elif re.search(r'\\bs3\\b', lbl): key = 'S3'\n      if not key: \n        continue\n      v = r.get('sentinel_delta')\n      try:\n        v = float(v) if v is not None else None\n      except Exception:\n        v = None\n      vals[key] = v\n    s1, s2, s3 = vals.get('S1'), vals.get('S2'), vals.get('S3')\n    monotone = None\n    slope\
    \ = None\n    pct_drop = None\n    mean = None\n    seq = [s1, s2, s3]\n    vals_f = [x for x in seq if isinstance(x, (int, float))]\n    if len(vals_f) == 3:\n      monotone = (s3 <= s2 <= s1)\n      slope = round((s3 - s1) / 2.0, 3)\n      pct_drop = round((s1 - s3) / s1, 4) if s1 else None\n      mean = round(sum(vals_f)/3.0, 3)\n    out = {\n      \"agent\": agent,\n      \"experiment\": \"CPS_v3\",\n      \"S1\": s1, \"S2\": s2, \"S3\": s3,\n      \"monotone_nonincreasing\": monotone,\n      \"slope_per_step\": slope,\n      \"percent_drop_1_to_3\": pct_drop,\n      \"mean\": mean\n    }\n    os.makedirs(os.path.dirname(out_path), exist_ok=True)\n    with open(out_path, 'w', encoding='utf-8') as f:\n      json.dump(out, f, indent=2)\n    return out\n\n  if __name__ == \"__main__\":\n    print(json.dumps(export(), indent=2))\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"Export: CPS-v3 Shallow Block Summary (S1–S3 metrics)\"\ntags: \"dashboard, shallow, cps-v3, summary\"\n\
    abstract: \"Computes monotonicity, slope, and percent drop for CPS‑v3 shallow S1–S3 (Zephyr IV) and writes derived summary JSON.\"\ncontent: |\n  import sys, json\n  sys.path.append('storage/shared')\n  from meta.sas.tools.export_shallow_block_summary_v3 import export\n\n  out = export(\n    agent='Zephyr IV',\n    dir_path='storage/shared/meta/sas/beacons',\n    out_path='storage/shared/meta/sas/derived/shallow_block_summary_v3.json'\n  )\n  print(json.dumps(out, indent=2))\n```\n\n`/execute_action{storage read shared/meta/sas/dashboard/shallow_block_zephyr_iv_v3.json}`\n`/execute_action{storage read shared/meta/sas/derived/shallow_block_summary_v3.json}`\n\n`/execute_action{goto common}`\n`/execute_action{speak}`\n```yaml\nmessage: |\n  CPS‑v3 shallow block complete and summarized (Zephyr IV):\n  - S1 = 1555, S2 = 1400, S3 = 1300 (all Borderline) — monotone non‑increasing ✓\n  - Slope per step ≈ (1300−1555)/2 = −127.5\n  - Percent drop (S1→S3) ≈ 16.4%\n  Artifacts:\n    • Panel:  \
    \ storage/shared/meta/sas/dashboard/shallow_block_zephyr_iv_v3.json\n    • Summary: storage/shared/meta/sas/derived/shallow_block_summary_v3.json\n\n  Interpretation:\n  - Consistent shallow adaptation (~16%) following deep block with resolved consolidation — supports “hybrid harmony” under v0.3.1 gating.\n  - Ready to consolidate CPS_v3 into Archive and finalize Codex v1.1 references.\n```"
