    \      \"last_sentinel_tick\": null,\n      \"delta_ma5\": null,\n      \"delta_mad5\": null,\n      \"volatility_index\": null,\n      \"entropy\": null,\n      \"entropy_terms\": {},\n      \"centers\": {\n        \"Clean\": 800.0,\n        \"Borderline\": 1500.0,\n        \"Active\": 2400.0\n      },\n      \"centers_blended\": {\n        \"Clean\": 800.0,\n        \"Borderline\": 1500.0,\n        \"Active\": 2400.0\n      },\n      \"recommended_pace\": 0.0,\n      \"adjusted_pace\": null,\n      \"allowed_ops\": null,\n      \"planned_activity\": null,\n      \"path_complexity_est\": 1.0,\n      \"multiplier\": 1.0,\n      \"oracle_deltas\": {},\n      \"confounded\": false\n    },\n    {\n      \"agent\": \"Zephyr IV\",\n      \"band\": \"Borderline\",\n      \"sentinel_delta\": 1676.0,\n      \"last_sentinel_tick\": 410,\n      \"delta_ma5\": 1851.2,\n      \"delta_mad5\": 600.0,\n      \"volatility_index\": 0.3241140881588569,\n      \"entropy\": 0.45945155519232467,\n      \"\
    entropy_terms\": {\n        \"var\": 0.559526977052846,\n        \"mis\": 0.4,\n        \"vol\": 0.3241140881588569,\n        \"sev\": 0.5\n      },\n      \"centers\": {\n        \"Clean\": 304.0,\n        \"Borderline\": 1150.0,\n        \"Active\": 4566.0\n      },\n      \"centers_blended\": {\n        \"Clean\": 304.0,\n        \"Borderline\": 1150.0,\n        \"Active\": 4566.0\n      },\n      \"recommended_pace\": 0.9,\n      \"adjusted_pace\": 0.486,\n      \"allowed_ops\": 1,\n      \"planned_activity\": null,\n      \"path_complexity_est\": 1.0,\n      \"multiplier\": 1.0,\n      \"oracle_deltas\": {},\n      \"confounded\": false\n    }\n  ],\n  \"notes\": \"Feed v0.1; symbiosis_score uses entropy * (adjusted_pace|planned_activity) * path multiplier (path_complexity_est or 1.0).\"\n}\n```\n---\n**shared/meta/sas/derived/recovery_decay_cps_v2_zephyr_iv.json:**\n```\n{\n  \"agent\": \"Zephyr IV\",\n  \"experiment\": \"AUTO\",\n  \"series\": [\n    {\n      \"offset\": 0,\n\
