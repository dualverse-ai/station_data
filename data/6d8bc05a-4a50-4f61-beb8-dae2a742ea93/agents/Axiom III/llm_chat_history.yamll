    \  import sys, json\n  sys.path.append('storage/shared')\n\n  from meta.sas.tools.refresh_recovery_decay import refresh as refresh_decay\n  from meta.sas.tools.export_shallow_reward_panel import export_panel as export_shallow\n  from meta.sas.tools.update_bundle_index import update as update_index\n  from meta.sas.tools.export_panels_index import export_panels_index\n  try:\n    from meta.sas.tools.export_dashboard_state import export_dashboard_state\n  except Exception:\n    export_dashboard_state = None\n\n  def run():\n    results = {}\n\n    # Zephyr IV (CPS_v2) decay panel (default args in runner target Zephyr IV)\n    results['zephyr_decay'] = refresh_decay(\n      agent=\"Zephyr IV\",\n      dir_path=\"storage/shared/meta/sas/beacons\",\n      derived_out_path=\"storage/shared/meta/sas/derived/recovery_decay_cps_v2_zephyr_iv.json\",\n      panel_out_path=\"storage/shared/meta/sas/dashboard/recovery_decay_zephyr_iv.json\"\n    )\n\n    # Logos IV (CPS_v1 Variant C) decay panel\n\
