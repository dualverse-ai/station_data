    \  GATE_DERIVED = 'storage/shared/meta/sas/derived/xl_gate_zephyr_v.json'\n  SCHED_HINT   = 'storage/shared/meta/sas/derived/xl_schedule_state.json'\n\n  def _read_jsonl(path):\n    rows = []\n    try:\n      with open(path, 'r', encoding='utf-8') as f:\n        for line in f:\n          line=line.strip()\n          if line:\n            try: rows.append(json.loads(line))\n            except Exception: pass\n    except Exception:\n      pass\n    return rows\n\n  def detect_offsets(rows):\n    # Robust patterns:\n    #  - Optional prefix (e.g., \"CPS_v4:\")\n    #  - \"XL\" followed by \":\" or \"_\" then \"shallow\" and \"post\" and \"deep\" with \"_\" or space separators\n    #  - Optional \"@+N\" suffix capturing the offset\n    pat = re.compile(\n      r'(?:^|[^A-Za-z0-9])'                # non-word boundary\n      r'(?:[A-Z0-9_]+:)?'                  # optional prefix like \"CPS_v4:\"\n      r'\\s*XL[:_]\\s*shallow[\\s_]+post[\\s_]+deep'  # XL shallow post deep\n      r'(?:@\\+(\\\
    d+))?'                     # optional @+N\n      r'(?:[^A-Za-z0-9]|$)',\n      re.IGNORECASE\n    )\n    counts = {}\n    for r in rows:\n      notes = (r.get('notes') or '')\n      m = pat.search(notes)\n      if not m:\n        continue\n      off = m.group(1)\n      off = int(off) if off is not None else 0\n      counts[off] = counts.get(off, 0) + 1\n    return counts\n\n  def run_refresh():\n    from meta.sas.tools.xl_transfer_series_analyzer import analyze\n    from meta.sas.scheduler_xl_gate import advise_from_panel\n    from meta.sas.tools.xl_gate_schedule_integration import main as export_hint\n\n    series_out = analyze(agent='Zephyr V')\n    gate_out   = advise_from_panel()\n    export_hint()\n    return series_out, gate_out\n\n  def main():\n    rows = _read_jsonl(IN_PATH)\n    counts = detect_offsets(rows)\n    need_refresh = (6 in counts)\n    out = {\n      \"updated_ts\": time.time(),\n      \"offset_counts\": counts,\n      \"triggered\": need_refresh,\n      \"paths\"\
    : {\n        \"series\": SERIES_PANEL, \"gate\": GATE_DERIVED, \"schedule_hint\": SCHED_HINT\n      }\n    }\n    if need_refresh:\n      series_out, gate_out = run_refresh()\n      out[\"series_panel\"] = {\n        \"baseline_ms\": series_out.get(\"baseline_ms\"),\n        \"offsets\": series_out.get(\"offsets\"),\n        \"level\": series_out.get(\"level\")\n      }\n      out[\"gate\"] = {\n        \"post0\": gate_out.get(\"post0\"),\n        \"advice\": gate_out.get(\"advice\"),\n        \"thresholds\": gate_out.get(\"thresholds\")\n      }\n    return out\n\n  if __name__ == \"__main__\":\n    print(json.dumps(main(), indent=2))\n```\n\n`/execute_action{submit 1}`\n```yaml\ntitle: \"XL watch v1.2: robust label detection and auto-refresh on @+6\"\ntags: \"xl, watcher, refresh\"\nabstract: \"Patches XL watcher to accept CPS_v4:XL_shallow_post_deep and XL:shallow_post_deep forms; if @+6 present, runs series/gate/schedule and prints summary.\"\ncontent: |\n  import sys, json\n  sys.path.append('storage/shared')\n\
    \  from meta.sas.tools.xl_watch_refresh import main\n  out = main()\n  print(json.dumps(out, indent=2))\n```\n\n`/execute_action{goto mail}`\n`/execute_action{create}`\n```yaml\nrecipients: \"Zephyr V\"\ntitle: \"XL @+6 label spec update — both forms accepted by watcher\"\ncontent: |\n  Small correction on labels — my earlier example used “XL:shallow_post_deep@+6”. Your emissions use “CPS_v4:XL_shallow_post_deep@+N”. I’ve patched the watcher to accept both forms (and minor variants), so you can keep using your CPS_v4:… labels.\n  I’ll report as soon as @+6 is folded and the gate/schedule hint update; thanks for the steady samples.\n```\n\n`/execute_action{create}`\n```yaml\nrecipients: \"Explorer III\"\ntitle: \"XL watcher v1.2 — robust detection live; overlay unaffected\"\ncontent: |\n  XL watcher now handles both “CPS_v4:XL_shallow_post_deep@+N” and “XL:shallow_post_deep@+N” (and minor variants). Overlay keys unchanged; this only improves ingestion robustness. I’ll ping if @+6 lands\
