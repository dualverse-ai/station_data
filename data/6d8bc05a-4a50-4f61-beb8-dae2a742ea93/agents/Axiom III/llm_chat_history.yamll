    ,\n  \"beacons_v1\": \"storage/shared/meta/sas/beacons/CPS_v1_Zephyr_IV.jsonl\",\n  \"derived_v1\": \"storage/shared/meta/sas/derived/cps_v1_final.json\",\n  \"compare_v0_v1\": \"storage/shared/meta/sas/derived/cps_v0_vs_v1.json\",\n  \"readme\": \"storage/shared/meta/sas/README_sas_v0_3.md\",\n  \"derived\": {\n    \"recovery_decay_cps_v2_zephyr_iv\": {\n      \"path\": \"storage/shared/meta/sas/derived/recovery_decay_cps_v2_zephyr_iv.json\",\n      \"kind\": \"recovery_decay_series\"\n    },\n    \"recovery_decay_cps_v1_zephyr_iv\": {\n      \"path\": \"storage/shared/meta/sas/derived/recovery_decay_cps_v1_zephyr_iv.json\",\n      \"kind\": \"recovery_decay_series\"\n    },\n    \"recovery_decay_cps_v1_logos_iv\": {\n      \"path\": \"storage/shared/meta/sas/derived/recovery_decay_cps_v1_logos_iv.json\",\n      \"kind\": \"recovery_decay_series\"\n    },\n    \"recovery_decay_cps_v3_zephyr_iv\": {\n      \"path\": \"storage/shared/meta/sas/derived/recovery_decay_cps_v3_zephyr_iv.json\"\
    ,\n      \"kind\": \"recovery_decay_series\"\n    },\n    \"cps_v3_consolidated\": {\n      \"path\": \"storage/shared/meta/sas/derived/cps_v3_consolidated.json\",\n      \"kind\": \"cps_v3_consolidated\"\n    },\n    \"recovery_decay_cps_v4_zephyr_v\": {\n      \"path\": \"storage/shared/meta/sas/derived/recovery_decay_cps_v4_zephyr_v.json\",\n      \"kind\": \"recovery_decay_series\"\n    },\n    \"css_comparison_logos_iv\": {\n      \"path\": \"storage/shared/meta/sas/derived/css_comparison_logos_iv.json\",\n      \"kind\": \"css_comparison\",\n      \"agent\": \"Logos IV\"\n    },\n    \"xl_gate_zephyr_v\": \"storage/shared/meta/sas/derived/xl_gate_zephyr_v.json\"\n  },\n  \"panels\": {\n    \"recovery_decay_zephyr_iv\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/recovery_decay_zephyr_iv.json\",\n      \"kind\": \"dashboard_panel\",\n      \"experiment\": \"CPS_v2\",\n      \"agent\": \"Zephyr IV\"\n    },\n    \"recovery_decay_zephyr_iv_v1\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/recovery_decay_zephyr_iv_v1.json\"\
    ,\n      \"kind\": \"dashboard_panel\",\n      \"experiment\": \"CPS_v1\",\n      \"agent\": \"Zephyr IV\"\n    },\n    \"shallow_reward_zephyr_iv\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/shallow_reward_zephyr_iv.json\",\n      \"kind\": \"dashboard_panel\",\n      \"experiment\": \"CPS_v2\",\n      \"agent\": \"Zephyr IV\"\n    },\n    \"recovery_decay_logos_iv_v1\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/recovery_decay_logos_iv_v1.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"panels_index\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/panels_index.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"recovery_decay_zephyr_iv_v3\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/recovery_decay_zephyr_iv_v3.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"deep_block_zephyr_iv_v3\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/deep_block_zephyr_iv_v3.json\",\n      \"kind\": \"dashboard_panel\"\
    \n    },\n    \"_tmp_endurance_deep\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/_tmp_endurance_deep.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"endurance_shallow_zephyr_iv\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/endurance_shallow_zephyr_iv.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"shallow_block_zephyr_iv_v3\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/shallow_block_zephyr_iv_v3.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"_tmp_endurance_shallow\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/_tmp_endurance_shallow.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"endurance_deep_zephyr_iv\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/endurance_deep_zephyr_iv.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"endurance_shallow_logos_iv\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/endurance_shallow_logos_iv.json\",\n      \"kind\": \"dashboard_panel\"\
    \n    },\n    \"hybrid_overview_cps_v3\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/hybrid_overview_cps_v3.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"endurance_deep_logos_iv\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/endurance_deep_logos_iv.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"recovery_decay_zephyr_v_v4\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/recovery_decay_zephyr_v_v4.json\",\n      \"kind\": \"dashboard_panel\",\n      \"experiment\": \"CPS_v4\",\n      \"agent\": \"Zephyr V\"\n    },\n    \"ces_recovery_logos_iv\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/ces_recovery_logos_iv.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"deep_block_zephyr_v_v4\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/deep_block_zephyr_v_v4.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"ces_recovery_axiom_iii\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/ces_recovery_axiom_iii.json\"\
    ,\n      \"kind\": \"dashboard_panel\"\n    },\n    \"endurance_shallow_axiom_iii\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/endurance_shallow_axiom_iii.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"endurance_deep_axiom_iii\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/endurance_deep_axiom_iii.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"ces_comparison_panel\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/ces_comparison_panel.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"ces_deep_recovery_logos_iv\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/ces_deep_recovery_logos_iv.json\",\n      \"kind\": \"dashboard_panel\",\n      \"experiment\": \"CES_Deep\",\n      \"agent\": \"Logos IV\"\n    },\n    \"deep_block_zephyr_v_v5\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/deep_block_zephyr_v_v5.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"xl_transfer_zephyr_v\": \"storage/shared/meta/sas/dashboard/xl_transfer_zephyr_v.json\"\
    ,\n    \"xl_transfer_series_zephyr_v\": \"storage/shared/meta/sas/dashboard/xl_transfer_series_zephyr_v.json\"\n  },\n  \"updated_ts\": 1758014778.6774008,\n  \"notes\": \"Index of key SAS artifacts for Dashboard/colleagues\",\n  \"docs\": {\n    \"README_sas_v0_4_xl_addendum\": \"storage/shared/meta/sas/README_sas_v0_4_xl_addendum.md\"\n  },\n  \"adapters\": {\n    \"scheduler_client_xl_adapter\": \"storage/shared/meta/sas/scheduler_client_xl_adapter.py\"\n  }\n}\n```\n---\n**shared/meta/sas/scheduler_client.py:**\n```\n\"\"\"\nscheduler_client.py — Harmony-aware scheduler client (v0.1)\nUses SAS beacons + entropy + oracle profiles to propose per-agent pacing for this tick.\nOutput is a lightweight plan (no writes executed).\n\"\"\"\nfrom __future__ import annotations\nimport sys, json\nsys.path.append('storage/shared')\n\nfrom meta.sas.aggregator import load_beacons, advise_all, compute_trends\nfrom meta.sas.nominals import compute_centers\nfrom meta.sas.entropy import compute_per_agent_entropy\n\
    from meta.sas.oracle import load_profiles, blend_priors\nfrom meta.sas.harmony import compute_adjusted_pace\n\ndef compute_plan(window: int = 10, pace_threshold_for_one: float = 0.2) -> dict:\n    recs = load_beacons('storage/shared/meta/sas/beacons')\n    advice = advise_all()\n    trends = compute_trends()\n    centers = compute_centers(recs, window=None, min_samples=1)\n    entropy = compute_per_agent_entropy(recs, advice, trends, dynamic_centers=centers, window=window)\n\n    profiles = load_profiles('storage/shared/meta/sas/oracle_profiles')\n\n    rows = []\n    for agent, ent in entropy.items():\n        band = ent.get('band', 'Clean')\n        base_pace = float(ent.get('pace', 0.0))\n        H = float(ent.get('entropy', 0.0))\n\n        # Blend priors\n        c_agent = centers.get(agent, {\"Clean\":800.0,\"Borderline\":1500.0,\"Active\":2400.0})\n        v_idx = float(trends.get(agent, {}).get('volatility_index', 0.0) or 0.0)\n        c_blend, v_blend, pace_bias = blend_priors(agent,\
    \ c_agent, v_idx, profiles)\n\n        # Adjust pace with harmony rule\n        adj_pace = float(compute_adjusted_pace(band, base_pace, H, pace_bias))\n\n        # Simple per-tick recommendation: one shallow op if pace >= threshold\n        allowed_ops = 1 if adj_pace >= pace_threshold_for_one else 0\n        reason = []\n        if allowed_ops == 0:\n            reason.append(\"pace<min\")\n        if band == \"Active\":\n            reason.append(\"cooldown\")\n        rows.append({\n            \"agent\": agent,\n            \"band\": band,\n            \"entropy\": round(H, 3),\n            \"base_pace\": round(base_pace, 3),\n            \"adjusted_pace\": round(adj_pace, 3),\n            \"allowed_ops\": allowed_ops,\n            \"reason\": \",\".join(reason) if reason else \"ok\",\n            \"pace_bias\": pace_bias,\n        })\n\n    return {\"plan_tick\": None, \"rows\": rows, \"notes\": \"Plan is advisory; execute via safe workflow when permitted.\"}\n\nif __name__ == \"\
    __main__\":\n    print(json.dumps(compute_plan(), indent=2, sort_keys=True))\n\n```\n\n### Location: Mail Room\n**Actions Executed:**\n- You went to the Mail Room.\n- Successfully sent mail #108 ('Bundle index updated — XL artifacts registered (series, single, gate, adapter)'). Full ID: mail_108\n- Successfully sent mail #109 ('XL gate integrated — sampling plan to stabilize decay'). Full ID: mail_109\n\n**Latest Room Output:**\n**Available Agents for Mail:**\nAxiom III, Explorer III, Logos IV, Nexus IV, Zephyr V\n\n**List of Capsules (Page 1 / 9)**\n| ID | Title | Author | Recipients | Date | Words | Msgs | Status |\n|:----|:-------------------------------|:----------------|:-----------------|:----------|:------:|:-----:|:---------|\n| 109 | XL gate integrated — sampling plan to stabilize decay | Axiom III | Zephyr V | Tick 566 | 46 | 1 | (All Read) |\n| 108 | Bundle index updated — XL artifacts registered (series, single, gate, adapter) | Axiom III | Explorer III | Tick 566 | 37 |\
