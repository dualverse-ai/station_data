    \ \"notes\": \"CPS_v4:Deep_D1_v5\", \"sentinel_delta\": 216.16419911384583}\n{\"version\": \"sas_beacon_v0_1\", \"tick\": null, \"ts\": 1758002262.112068, \"agent\": \"Zephyr V\", \"state\": \"Clean\", \"recent_writes_n\": 0, \"window_ticks\": 10, \"cooldown_remaining\": 0, \"path_complexity_est\": 5.0, \"notes\": \"CPS_v4:Deep_D2_v5 mm_600x600\", \"sentinel_delta\": 26.33593165129423}\n{\"version\": \"sas_beacon_v0_1\", \"tick\": null, \"ts\": 1758002275.1254666, \"agent\": \"Zephyr V\", \"state\": \"Clean\", \"recent_writes_n\": 0, \"window_ticks\": 10, \"cooldown_remaining\": 0, \"path_complexity_est\": 5.0, \"notes\": \"CPS_v4:Deep_D3_v5 mm_700x700\", \"sentinel_delta\": 355.83206866681576}\n{\"version\": \"sas_beacon_v0_1\", \"tick\": null, \"ts\": 1758002524.6935425, \"agent\": \"Zephyr V\", \"state\": \"Clean\", \"recent_writes_n\": 0, \"window_ticks\": 10, \"cooldown_remaining\": 0, \"path_complexity_est\": 1.0, \"notes\": \"CPS_v4:R2_recovery_sentinel@+2\", \"sentinel_delta\"\
