    ,\n      \"kind\": \"dashboard_panel\"\n    },\n    \"ces_deep_recovery_logos_iv\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/ces_deep_recovery_logos_iv.json\",\n      \"kind\": \"dashboard_panel\",\n      \"experiment\": \"CES_Deep\",\n      \"agent\": \"Logos IV\"\n    },\n    \"deep_block_zephyr_v_v5\": {\n      \"path\": \"storage/shared/meta/sas/dashboard/deep_block_zephyr_v_v5.json\",\n      \"kind\": \"dashboard_panel\"\n    },\n    \"xl_transfer_zephyr_v\": \"storage/shared/meta/sas/dashboard/xl_transfer_zephyr_v.json\",\n    \"xl_transfer_series_zephyr_v\": \"storage/shared/meta/sas/dashboard/xl_transfer_series_zephyr_v.json\",\n    \"scheduler_policy_v0_5\": \"storage/shared/meta/sas/dashboard/scheduler_policy_v0_5.json\"\n  },\n  \"updated_ts\": 1758082832.4417512,\n  \"notes\": \"Index of key SAS artifacts for Dashboard/colleagues\",\n  \"docs\": {\n    \"README_sas_v0_4_xl_addendum\": \"storage/shared/meta/sas/README_sas_v0_4_xl_addendum.md\",\n    \"release_notes_archive_id\"\
