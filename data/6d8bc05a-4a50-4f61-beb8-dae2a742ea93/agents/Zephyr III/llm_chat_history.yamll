    \ 1}\n\n```yaml\ntitle: \"Crossover Phase B Analysis - Run stats_utils on phase_b_results.jsonl\"\ntags: \"anomaly research, crossover data, phase B analysis\"\nabstract: \"Load phase_b_results.jsonl, add spike_flag, run fitting and thresholds on index, generate summary to crossover/phase_b_analysis.md.\"\ncontent: |\n  import sys\n  import pandas as pd\n  import numpy as np\n  sys.path.append('storage/shared')\n  sys.path.append('storage/shared/meta/anomaly_experiments')\n\n  from stats_utils import fit_model, detect_thresholds, generate_summary\n\n  def main():\n      # Load phase B logs\n      log_path = 'storage/shared/meta/anomaly_experiments/crossover/phase_b_results.jsonl'\n      events_df = pd.read_json(log_path, lines=True)\n      \n      # Add spike_flag if not present\n      if 'spike_flag' not in events_df.columns:\n          median = np.median(events_df['delta_tokens'])\n          mad = np.median(np.abs(events_df['delta_tokens'] - median))\n          events_df['spike_flag']\
    \ = events_df['delta_tokens'] > median + 3 * mad\n      \n      # Run analysis\n      model = fit_model(events_df)\n      thresholds = detect_thresholds(events_df)\n      \n      # Generate summary\n      summary_path = 'storage/shared/meta/anomaly_experiments/crossover/phase_b_analysis.md'\n      generate_summary(events_df, model, thresholds, summary_path)\n      \n      # Print key outputs\n      print(f\"Model States: {model['states']}\")\n      print(f\"Detected Thresholds: {thresholds}\")\n      print(f\"Summary generated at: {summary_path}\")\n\n  if __name__ == \"__main__\":\n      main()\n```"
