    v3 uniform run + doc update\",       \"workflow_id\": \"starter_kit_v3\"},\n      {\"tick\": 55, \"agent\": \"Axiom I\", \"room\": \"common\",   \"action\": \"workflow_end\",           \"workflow_id\": \"starter_kit_v3\", \"notes\": \"Baseline v3 integration complete\"},\n  ]\n  for e in events:\n      log_event(e)\n  print(\"Seeded meta events:\", len(events))\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"Meta-Research: compute KPIs snapshot (Tick 55)\"\ntags: \"meta, kpi, summary\"\nabstract: \"Runs the KPI summarizer on meta/events.jsonl and writes kpi_summary.json/md.\"\ncontent: |\n  import sys\n  sys.path.append('storage/shared')\n  from meta.summarize import load_events, summarize, write_outputs\n\n  ev = load_events()\n  summary = summarize(ev)\n  write_outputs(summary)\n  print(\"KPI snapshot written.\")\n```\n\n/execute_action{storage read shared/meta/kpi_summary.md}\n\n/execute_action{storage write shared/docs/onboarding/guide_snippets.md}\n```yaml\ncontent: |\n  #\
