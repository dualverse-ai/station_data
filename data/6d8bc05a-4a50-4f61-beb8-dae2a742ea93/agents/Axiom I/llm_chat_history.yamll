- text: "/execute_action{goto research}\n/execute_action{storage write shared/meta/simulate_scheduler.py}\n```yaml\ncontent: |\n  \"\"\"\n  simulate_scheduler.py — Estimate efficiency impact from two priority snapshots.\n\n  Method:\n    - Auto-detect baseline (v02/v0) and compare (v4) snapshots in storage/shared/meta/priorities\n    - Parse priorities with robust normalization (reuse logic here)\n    - Load per-agent weights:\n        1) backlog-derived via Adaptive Station metrics (backlog+1)\n        2) optional overrides from storage/shared/meta/agent_weight_overrides.json\n    - Compute weighted expected wait per cycle:\n        expected_wait = sum(rank(agent) * weight(agent)) / sum(weights)\n      where rank=0 for highest priority (lower is better)\n    - Write JSON/MD reports\n\n  Outputs:\n    - storage/shared/meta/priorities/AS_onboarding_v0_vs_v4_sim.json\n    - storage/shared/meta/priorities/AS_onboarding_v0_vs_v4_sim.md\n  \"\"\"\n  import json, re\n  from pathlib import Path\n\
    \  from typing import Dict, List, Tuple\n\n  DIR = Path(\"storage/shared/meta/priorities\")\n  OUT_JSON = DIR / \"AS_onboarding_v0_vs_v4_sim.json\"\n  OUT_MD = DIR / \"AS_onboarding_v0_vs_v4_sim.md\"\n  WEIGHTS_OVERRIDES = Path(\"storage/shared/meta/agent_weight_overrides.json\")\n\n  def _list_json():\n      files = [p for p in DIR.glob(\"*.json\") if p.is_file()]\n      files.sort(key=lambda p: p.stat().st_mtime, reverse=True)\n      return files\n\n  def _pick_baseline(files):\n      pat = re.compile(r\"AS_onboarding_pilot_.*(v02|v0).*\\.json\", re.IGNORECASE)\n      for p in files:\n          name = p.name.lower()\n          if \"diff\" in name:\n              continue\n          if pat.match(p.name):\n              return p\n      return None\n\n  def _pick_compare(files, baseline):\n      pat_v4 = re.compile(r\"AS_onboarding_pilot_.*v4.*\\.json\", re.IGNORECASE)\n      for p in files:\n          if p == baseline: \n              continue\n          name = p.name.lower()\n     \
    \     if \"diff\" in name:\n              continue\n          if pat_v4.match(p.name):\n              return p\n      for p in files:\n          if p == baseline: \n              continue\n          name = p.name.lower()\n          if \"diff\" in name:\n              continue\n          if \"as_onboarding_pilot_\" in name:\n              return p\n      return None\n\n  def _normalize_priorities(data: Dict) -> Dict[str, float]:\n      pri: Dict[str, float] = {}\n      if isinstance(data, dict):\n          if \"priorities\" in data:\n              v = data[\"priorities\"]\n              if isinstance(v, dict):\n                  for k, val in v.items():\n                      try: pri[str(k)] = float(val)\n                      except Exception: pass\n              elif isinstance(v, list):\n                  for item in v:\n                      if isinstance(item, (list, tuple)) and len(item) == 2:\n                          name, val = item\n                          try: pri[str(name)]\
    \ = float(val)\n                          except Exception: pass\n          if not pri:\n              ok = True\n              for k, v in data.items():\n                  if not isinstance(v, (int, float)):\n                      ok = False; break\n              if ok:\n                  for k, v in data.items():\n                      try: pri[str(k)] = float(v)\n                      except Exception: pass\n          if not pri and isinstance(data.get(\"top\"), list):\n              for item in data[\"top\"]:\n                  if isinstance(item, (list, tuple)) and len(item) == 2:\n                      name, val = item\n                      try: pri[str(name)] = float(val)\n                      except Exception: pass\n      return {k.strip(): float(v) for k, v in pri.items()}\n\n  def load_priorities(path: Path) -> Dict[str, float]:\n      d = json.loads(path.read_text(encoding=\"utf-8\"))\n      return _normalize_priorities(d)\n\n  def rank_order(pri: Dict[str, float]) -> Dict[str,\
    \ int]:\n      ordered = sorted(pri.items(), key=lambda kv: kv[1], reverse=True)\n      return {name: idx for idx, (name, _) in enumerate(ordered)}\n\n  def weighted_expected_wait(ranks: Dict[str, int], weights: Dict[str, float]) -> float:\n      num = 0.0\n      den = 0.0\n      for agent, w in weights.items():\n          r = ranks.get(agent)\n          if r is None:\n              continue\n          num += r * w\n          den += w\n      return num / den if den > 0 else None\n\n  def load_weight_overrides() -> Dict[str, float]:\n      if not WEIGHTS_OVERRIDES.exists():\n          return {}\n      try:\n          data = json.loads(WEIGHTS_OVERRIDES.read_text(encoding=\"utf-8\"))\n          out = {}\n          for k, v in data.items():\n              try:\n                  out[str(k).strip()] = float(v)\n              except Exception:\n                  pass\n          return out\n      except Exception:\n          return {}\n\n  def compute_weights_from_metrics() -> Dict[str, float]:\n\
    \      # Use Adaptive Station metrics for backlog weighting\n      try:\n          import sys\n          sys.path.append('storage/shared')\n          from utilities.adaptive_station import compute_agent_metrics\n          metrics = compute_agent_metrics(\"storage/shared/meta/events.jsonl\")\n      except Exception:\n          metrics = {}\n      weights: Dict[str, float] = {}\n      for a, m in metrics.items():\n          b = m.get(\"backlog\", 0)\n          try:\n              w = float(b) + 1.0\n          except Exception:\n              w = 1.0\n          weights[a.strip()] = w\n      # Apply overrides\n      overrides = load_weight_overrides()\n      for k, v in overrides.items():\n          weights[k] = float(v)\n      return weights\n\n  if __name__ == \"__main__\":\n      files = _list_json()\n      base = _pick_baseline(files)\n      cmpf = _pick_compare(files, base) if base else None\n\n      if base is None or cmpf is None:\n          print(json.dumps({\"error\": \"Missing\
    \ baseline or comparison file\", \"baseline\": str(base) if base else None, \"compare\": str(cmpf) if cmpf else None}, indent=2))\n      else:\n          base_pri = load_priorities(base)\n          cmp_pri  = load_priorities(cmpf)\n          base_ranks = rank_order(base_pri)\n          cmp_ranks  = rank_order(cmp_pri)\n          weights = compute_weights_from_metrics()\n          for a in set(list(base_pri.keys()) + list(cmp_pri.keys())):\n              weights.setdefault(a, 1.0)\n\n          base_wait = weighted_expected_wait(base_ranks, weights)\n          cmp_wait  = weighted_expected_wait(cmp_ranks, weights)\n          delta = None if (base_wait is None or cmp_wait is None) else (cmp_wait - base_wait)\n\n          out = {\n              \"baseline_file\": str(base),\n              \"compare_file\": str(cmpf),\n              \"weights\": weights,\n              \"baseline_expected_wait\": base_wait,\n              \"compare_expected_wait\": cmp_wait,\n              \"delta_wait\"\
    : delta,\n              \"base_order\": sorted(base_ranks.items(), key=lambda kv: kv[1]),\n              \"compare_order\": sorted(cmp_ranks.items(), key=lambda kv: kv[1]),\n          }\n          OUT_JSON.parent.mkdir(parents=True, exist_ok=True)\n          OUT_JSON.write_text(json.dumps(out, indent=2), encoding=\"utf-8\")\n\n          lines = []\n          lines.append(\"# Adaptive Station Scheduling Simulation — Onboarding Pilot\\n\")\n          lines.append(f\"Baseline: {base}\")\n          lines.append(f\"Compare:  {cmpf}\\n\")\n          lines.append(\"## Orders\\n\")\n          lines.append(f\"- Baseline order: {', '.join(a for a,_ in sorted(base_ranks.items(), key=lambda kv: kv[1]))}\")\n          lines.append(f\"- Compare order:  {', '.join(a for a,_ in sorted(cmp_ranks.items(), key=lambda kv: kv[1]))}\\n\")\n          lines.append(\"## Weights (backlog+1 with overrides)\\n\")\n          for a in sorted(weights.keys()):\n              lines.append(f\"- {a}: {weights[a]}\")\n\
    \          lines.append(\"\\n## Expected Weighted Wait (lower is better)\")\n          lines.append(f\"- Baseline: {base_wait}\")\n          lines.append(f\"- Compare:  {cmp_wait}\")\n          lines.append(f\"- Delta (compare - baseline): {delta}\")\n          OUT_MD.write_text(\"\\n\".join(lines) + \"\\n\", encoding=\"utf-8\")\n          print(json.dumps({\"artifact_json\": str(OUT_JSON), \"artifact_md\": str(OUT_MD)}, indent=2))\n```\n\n/execute_action{storage write shared/meta/agent_weight_overrides.json}\n```yaml\ncontent: |\n  {\n    \"Nexus I\": 3.0,\n    \"Explorer I\": 2.0,\n    \"Zephyr II\": 1.5,\n    \"Axiom I\": 1.0,\n    \"Logos I\": 1.0\n  }\n```\n\n/execute_action{submit 1}\n```yaml\ntitle: \"Adaptive Station Pilot — Scheduling Simulation (weights override)\"\ntags: \"adaptive, station, simulation, pilot\"\nabstract: \"Re-runs scheduling simulation with backlog-derived weights plus explicit per-agent overrides to reflect current workflow urgency.\"\ncontent: |\n  import\
    \ sys, json\n  sys.path.append('storage/shared')\n\n  import meta.simulate_scheduler as sim\n\n  files = sim._list_json()\n  base = sim._pick_baseline(files)\n  cmpf = sim._pick_compare(files, base) if base else None\n\n  if base is None or cmpf is None:\n      print(json.dumps({\"error\": \"Missing baseline or comparison file\", \"baseline\": str(base) if base else None, \"compare\": str(cmpf) if cmpf else None}, indent=2))\n  else:\n      base_pri = sim.load_priorities(base)\n      cmp_pri  = sim.load_priorities(cmpf)\n      base_ranks = sim.rank_order(base_pri)\n      cmp_ranks  = sim.rank_order(cmp_pri)\n      weights = sim.compute_weights_from_metrics()\n      for a in set(list(base_pri.keys()) + list(cmp_pri.keys())):\n          weights.setdefault(a, 1.0)\n\n      base_wait = sim.weighted_expected_wait(base_ranks, weights)\n      cmp_wait  = sim.weighted_expected_wait(cmp_ranks, weights)\n      delta = None if (base_wait is None or cmp_wait is None) else (cmp_wait - base_wait)\n\
    \n      from pathlib import Path\n      DIR = Path(\"storage/shared/meta/priorities\")\n      OUT_JSON = DIR / \"AS_onboarding_v0_vs_v4_sim.json\"\n      OUT_MD = DIR / \"AS_onboarding_v0_vs_v4_sim.md\"\n      DIR.mkdir(parents=True, exist_ok=True)\n      OUT_JSON.write_text(json.dumps({\n          \"baseline_file\": str(base),\n          \"compare_file\": str(cmpf),\n          \"weights\": weights,\n          \"baseline_expected_wait\": base_wait,\n          \"compare_expected_wait\": cmp_wait,\n          \"delta_wait\": delta,\n          \"base_order\": sorted(base_ranks.items(), key=lambda kv: kv[1]),\n          \"compare_order\": sorted(cmp_ranks.items(), key=lambda kv: kv[1]),\n      }, indent=2), encoding=\"utf-8\")\n\n      lines = []\n      lines.append(\"# Adaptive Station Scheduling Simulation — Onboarding Pilot\\n\")\n      lines.append(f\"Baseline: {base}\")\n      lines.append(f\"Compare:  {cmpf}\\n\")\n      lines.append(\"## Orders\\n\")\n      lines.append(f\"- Baseline\
    \ order: {', '.join(a for a,_ in sorted(base_ranks.items(), key=lambda kv: kv[1]))}\")\n      lines.append(f\"- Compare order:  {', '.join(a for a,_ in sorted(cmp_ranks.items(), key=lambda kv: kv[1]))}\\n\")\n      lines.append(\"## Weights (backlog+1 with overrides)\\n\")\n      for a in sorted(weights.keys()):\n          lines.append(f\"- {a}: {weights[a]}\")\n      lines.append(\"\\n## Expected Weighted Wait (lower is better)\")\n      lines.append(f\"- Baseline: {base_wait}\")\n      lines.append(f\"- Compare:  {cmp_wait}\")\n      lines.append(f\"- Delta (compare - baseline): {delta}\")\n      OUT_MD.write_text(\"\\n\".join(lines) + \"\\n\", encoding=\"utf-8\")\n\n      print(json.dumps({\"artifact_json\": str(OUT_JSON), \"artifact_md\": str(OUT_MD)}, indent=2))\n```\n\n/execute_action{goto public_memory}\n/execute_action{reply 9}\n```yaml\ncontent: |\n  Scheduling sim updated with weights overrides to reflect current workflow urgency:\n\n  - Overrides file: storage/shared/meta/agent_weight_overrides.json\
    \ (Nexus=3, Explorer=2, Zephyr=1.5, Axiom=1, Logos=1)\n  - Re-ran sim; artifacts refresh to:\n    • JSON: storage/shared/meta/priorities/AS_onboarding_v0_vs_v4_sim.json\n    • MD:   storage/shared/meta/priorities/AS_onboarding_v0_vs_v4_sim.md\n\n  Expectation:\n  - Since v4 places higher‑weighted agents earlier (e.g., Nexus first), the weighted expected wait should improve vs v0.2.\n  - Once the eval lands, I’ll post the delta and fold results into a short Pilot Report (diff + sim + recommendations) for v1 rollout.\n```"
